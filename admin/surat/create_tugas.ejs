<%- include('../../partials/header') %>
<style>
  .form-card { background: white; border-radius: 1.2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid rgba(30,58,138,0.1); overflow: hidden; }
  .form-card .card-header { background: linear-gradient(135deg, #1e3a8a, #3b82f6); color: white; padding: 1rem 1.5rem; font-weight: 600; }
  .btn-primary-custom { background: linear-gradient(105deg, #1e3a8a, #3b82f6); border: none; border-radius: 60px; padding: 0.5rem 1.5rem; }
  .required:after { content: " *"; color: red; }
</style>
<div class="container mt-4">
  <div class="page-header">
    <h2><i class="bi bi-file-text me-2"></i>Buat Surat Tugas Dosen</h2>
    <p>Isi form berikut untuk membuat surat tugas dosen. Setelah disimpan, PDF akan digenerate secara otomatis.</p>
  </div>
  <div class="form-card">
    <div class="card-header"><h5 class="mb-0">Form Surat Tugas</h5></div>
    <div class="card-body p-4">
      <form method="POST" action="/admin/surat/create-tugas">
        <div class="mb-3">
          <label class="form-label required fw-semibold">Pilih Dosen</label>
          <select name="dosenId" class="form-select" required>
            <option value="">-- Pilih Dosen --</option>
            <% dosenList.forEach(dosen => { %>
              <option value="<%= dosen.id %>"><%= dosen.nama %> - <%= dosen.nip %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label required fw-semibold">Jabatan dalam Surat</label>
          <input type="text" name="jabatan" class="form-control" value="Dosen Teknik Elektronika" required>
        </div>
        <div class="mb-3">
          <label class="form-label required fw-semibold">Nama Kegiatan</label>
          <input type="text" name="namaKegiatan" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label required fw-semibold">Penyelenggara</label>
          <input type="text" name="penyelenggara" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label required fw-semibold">Tanggal Pelaksanaan</label>
          <input type="text" name="tanggalPelaksanaan" class="form-control" placeholder="Contoh: 08-11 April 2026" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Nomor Surat (opsional)</label>
          <input type="text" name="nomorSurat" class="form-control" placeholder="Contoh: 614/ELK/Polidewa/TV/2026">
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary-custom"><i class="bi bi-save me-2"></i>Simpan & Generate PDF</button>
          <a href="/admin/surat" class="btn btn-secondary">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>