<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 680px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-mortarboard me-2"></i><%= title %></h4>
    <a href="/admin/tracklulusan" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="info-card">
    <div class="card-body">
      <div class="row">
        <div class="col-md-3 text-center mb-3">
          <% if (lulusan.foto) { %>
            <img src="<%= lulusan.foto %>" class="rounded-circle" width="120" height="120" style="object-fit:cover;">
          <% } else { %>
            <div class="rounded-circle bg-primary bg-opacity-10 mx-auto d-flex align-items-center justify-content-center" style="width:120px;height:120px;">
              <i class="bi bi-person fs-1 text-primary"></i>
            </div>
          <% } %>
        </div>
        <div class="col-md-9">
          <div class="row mb-2"><div class="col-4 text-muted">Nama</div><div class="col-8"><%= lulusan.nama %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">NIM</div><div class="col-8"><%= lulusan.nim %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">Tahun Lulus</div><div class="col-8"><%= lulusan.tahunLulus %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">Status</div><div class="col-8"><span class="badge bg-info-subtle text-info-emphasis"><%= lulusan.status %></span></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">Pekerjaan</div><div class="col-8"><%= lulusan.pekerjaan || '-' %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">Tempat Kerja</div><div class="col-8"><%= lulusan.tempatKerja || '-' %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">Alamat Kerja</div><div class="col-8"><%= lulusan.alamatKerja || '-' %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">Gaji</div><div class="col-8"><%= lulusan.gaji || '-' %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">Email</div><div class="col-8"><%= lulusan.email || '-' %></div></div>
          <div class="row mb-2"><div class="col-4 text-muted">No. HP</div><div class="col-8"><%= lulusan.noHp || '-' %></div></div>
        </div>
      </div>
    </div>
    <div class="card-footer">
      <a href="/admin/tracklulusan/<%= lulusan.id %>/edit" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-pencil me-1"></i> Edit
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
