<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-award me-2"></i><%= title %></h4>
    <a href="/admin/sertifikat/kirim" class="btn btn-gradient btn-primary">
      <i class="bi bi-send me-1"></i> Kirim Sertifikat
    </a>
  </div>

  <form method="GET" class="mb-3">
    <select name="dosenId" class="form-select w-auto d-inline-block" onchange="this.form.submit()">
      <option value="">Semua Dosen</option>
      <% dosenList.forEach(function(d) { %>
        <option value="<%= d.id %>" <%= filterDosenId === d.id ? 'selected' : '' %>><%= d.nama %></option>
      <% }); %>
    </select>
  </form>

  <div class="info-card">
    <div class="card-body">
      <% if (sertifikat.length === 0) { %>
        <p class="text-muted mb-0 text-center py-4">Belum ada sertifikat.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Dosen</th>
                <th>Judul</th>
                <th>Penerbit</th>
                <th>Tanggal Terbit</th>
                <th>Sumber</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% sertifikat.forEach(function(s) { %>
                <tr>
                  <td><%= s.dosenNama || '-' %></td>
                  <td><%= s.judul %></td>
                  <td><%= s.penerbit || '-' %></td>
                  <td><%= s.tanggalTerbit ? new Date(s.tanggalTerbit).toLocaleDateString('id-ID') : '-' %></td>
                  <td>
                    <span class="badge bg-<%= s.sumber === 'admin' ? 'primary' : 'secondary' %>">
                      <%= s.sumber === 'admin' ? 'Dikirim Admin' : 'Unggahan Dosen' %>
                    </span>
                  </td>
                  <td class="text-nowrap">
                    <a href="<%= s.fileUrl %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Lihat">
                      <i class="bi bi-eye"></i>
                    </a>
                    <form method="POST" action="/admin/sertifikat/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('Hapus sertifikat ini?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
