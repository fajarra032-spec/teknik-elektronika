<%- include('../../partials/header') %>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
  }
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 2rem;
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .page-header h2 {
    font-weight: 800;
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    opacity: 0.9;
    margin-bottom: 0;
  }
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .menu-card {
    background: white;
    border-radius: 1.2rem;
    padding: 1.8rem 1.5rem;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid rgba(30,58,138,0.1);
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
  }
  .menu-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 30px rgba(30,58,138,0.15);
    border-color: var(--primary-start);
  }
  .menu-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--primary-start);
  }
  .menu-title {
    font-weight: 700;
    font-size: 1.3rem;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }
  .menu-desc {
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  @media (max-width: 768px) {
    .page-header { padding: 1.2rem; }
    .page-header h2 { font-size: 1.4rem; }
    .menu-title { font-size: 1.1rem; }
    .menu-icon { font-size: 2.5rem; }
  }
</style>

<div class="container mt-4">
  <!-- Flash Message (jika ada) -->
  <% if (message) { %>
    <div class="alert alert-<%= message.type === 'success' ? 'success' : (message.type === 'error' ? 'danger' : 'info') %> alert-dismissible fade show" role="alert">
      <i class="bi bi-<%= message.type === 'success' ? 'check-circle-fill' : (message.type === 'error' ? 'exclamation-triangle-fill' : 'info-circle-fill') %> me-2"></i>
      <%= message.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="page-header">
    <h2><i class="bi bi-star-fill me-2"></i>Evaluasi Dosen (EDOM)</h2>
    <p>Kelola evaluasi dosen oleh mahasiswa – periode, kuisioner, dan rekap hasil</p>
  </div>

  <div class="menu-grid">
    <a href="/admin/edom/periods" class="menu-card">
      <div class="menu-icon"><i class="bi bi-calendar-week"></i></div>
      <h5 class="menu-title">Periode Evaluasi</h5>
      <p class="menu-desc">Buat, edit, atau hapus periode penilaian</p>
    </a>
    <a href="/admin/edom/questions" class="menu-card">
      <div class="menu-icon"><i class="bi bi-question-circle"></i></div>
      <h5 class="menu-title">Kuisioner</h5>
      <p class="menu-desc">Atur pertanyaan, bobot, urutan, dan tipe (rating/teks)</p>
    </a>
    <a href="/admin/edom/rekap" class="menu-card">
      <div class="menu-icon"><i class="bi bi-bar-chart-steps"></i></div>
      <h5 class="menu-title">Rekap Hasil</h5>
      <p class="menu-desc">Lihat ringkasan penilaian per dosen dan hapus respon</p>
    </a>
  </div>
</div>

<%- include('../../partials/footer') %>