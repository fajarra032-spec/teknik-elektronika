<%- include('../../partials/header') %>

<div class="container mt-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-calendar-range me-2"></i><%= title %></h4>
    <a href="/admin/edom/periods" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-<%= message.type === 'error' ? 'danger' : 'success' %>"><%= message.text %></div>
  <% } %>

  <div class="info-card">
    <div class="card-body">
      <form method="POST" action="<%= period ? '/admin/edom/periods/' + period.id + '/edit' : '/admin/edom/periods' %>">
        <div class="mb-3">
          <label class="form-label">Nama Periode</label>
          <input type="text" name="nama" class="form-control" value="<%= period ? period.nama : '' %>" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Semester</label>
          <input type="text" name="semester" class="form-control" value="<%= period ? period.semester : defaultSemester %>" required>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Tanggal Mulai</label>
            <input type="date" name="tanggalMulai" class="form-control" value="<%= period ? period.tanggalMulai : '' %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Tanggal Selesai</label>
            <input type="date" name="tanggalSelesai" class="form-control" value="<%= period ? period.tanggalSelesai : '' %>" required>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="active" <%= period && period.status === 'active' ? 'selected' : '' %>>Aktif</option>
            <option value="closed" <%= period && period.status === 'closed' ? 'selected' : '' %>>Ditutup</option>
          </select>
          <div class="form-text">Mengaktifkan periode ini akan otomatis menutup periode aktif lainnya.</div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Simpan</button>
          <a href="/admin/edom/periods" class="btn btn-light">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
