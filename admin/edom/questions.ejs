<%- include('../../partials/header') %>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
  }
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 1.8rem 2rem;
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }
  .page-header h2 {
    font-weight: 800;
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    opacity: 0.9;
    margin-bottom: 0;
  }
  .filter-bar {
    background: white;
    border-radius: 1rem;
    padding: 1rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    border: 1px solid rgba(30,58,138,0.1);
  }
  .btn-primary-custom {
    background: linear-gradient(105deg, var(--primary-start), var(--primary-end));
    border: none;
    border-radius: 60px;
    padding: 0.5rem 1.2rem;
    font-weight: 500;
    transition: all 0.2s;
    color: white;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-primary-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(30,58,138,0.25);
    color: white;
  }
  .table-container {
    background: white;
    border-radius: 1.2rem;
    overflow-x: auto;
    border: 1px solid rgba(30,58,138,0.1);
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  }
  .table th {
    background: #f8fafc;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #e2e8f0;
    padding: 1rem;
  }
  .table td {
    padding: 1rem;
    vertical-align: middle;
    border-bottom: 1px solid #f0f2f5;
  }
  .table tr:hover td {
    background: #fefce8;
  }
  .badge-active {
    background: #d1fae5;
    color: #065f46;
    padding: 0.3rem 0.9rem;
    border-radius: 60px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .badge-inactive {
    background: #e2e8f0;
    color: #475569;
    padding: 0.3rem 0.9rem;
    border-radius: 60px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .badge-rating {
    background: #dbeafe;
    color: #1e40af;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
  }
  .badge-text {
    background: #fef3c7;
    color: #92400e;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 600;
  }
  @media (max-width: 768px) {
    .page-header { padding: 1.2rem; }
    .page-header h2 { font-size: 1.4rem; }
    .table th, .table td { padding: 0.75rem; font-size: 0.85rem; }
    .filter-bar { flex-direction: column; align-items: stretch; }
    .btn-primary-custom { justify-content: center; }
  }
</style>

<div class="container mt-4">
  <!-- Flash Message -->
  <% if (message) { %>
    <div class="alert alert-<%= message.type === 'success' ? 'success' : (message.type === 'error' ? 'danger' : 'info') %> alert-dismissible fade show" role="alert">
      <i class="bi bi-<%= message.type === 'success' ? 'check-circle-fill' : (message.type === 'error' ? 'exclamation-triangle-fill' : 'info-circle-fill') %> me-2"></i>
      <%= message.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="page-header">
    <h2><i class="bi bi-question-circle me-2"></i>Kelola Kuisioner EDOM</h2>
    <p>Atur pertanyaan yang akan ditampilkan saat mahasiswa mengevaluasi dosen</p>
  </div>

  <div class="filter-bar">
    <div>
      <i class="bi bi-info-circle-fill text-primary me-2"></i>
      <span>Pertanyaan hanya akan muncul jika status <strong>Aktif</strong> dan <strong>urutan</strong> menentukan posisi tampil.</span>
    </div>
    <a href="/admin/edom/questions/create" class="btn-primary-custom">
      <i class="bi bi-plus-circle"></i> Tambah Pertanyaan
    </a>
  </div>

  <div class="table-container">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>No</th>
          <th>Pertanyaan</th>
          <th>Tipe</th>
          <th>Skala</th>
          <th>Bobot</th>
          <th>Urutan</th>
          <th>Status</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (questions && questions.length) { %>
          <% questions.forEach((q, idx) => { %>
            <tr>
              <td class="text-center"><%= idx + 1 %></td>
              <td><%= q.pertanyaan %></td>
              <td>
                <span class="<%= q.tipe === 'rating' ? 'badge-rating' : 'badge-text' %>">
                  <%= q.tipe === 'rating' ? 'Rating' : 'Teks' %>
                </span>
              </td>
              <td class="text-center"><%= q.tipe === 'rating' ? (q.skala || 5) : '-' %></td>
              <td class="text-center"><%= q.tipe === 'rating' ? (q.bobot || 1) : '-' %></td>
              <td class="text-center"><%= q.urutan || 0 %></td>
              <td>
                <span class="<%= q.aktif === true ? 'badge-active' : 'badge-inactive' %>">
                  <%= q.aktif === true ? 'Aktif' : 'Tidak Aktif' %>
                </span>
              </td>
              <td>
                <a href="/admin/edom/questions/<%= q.id %>/edit" class="btn btn-sm btn-warning me-1">
                  <i class="bi bi-pencil"></i> Edit
                </a>
                <form method="POST" action="/admin/edom/questions/<%= q.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus pertanyaan ini? Data respon yang sudah ada tetap tersimpan secara historis.')">
                  <button type="submit" class="btn btn-sm btn-danger">
                    <i class="bi bi-trash"></i> Hapus
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-5">
              <i class="bi bi-inbox fs-1 text-muted"></i>
              <p class="mt-2 mb-0">Belum ada pertanyaan. Klik "Tambah Pertanyaan" untuk mulai.</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>