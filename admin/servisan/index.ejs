<%- include('../../partials/header') %>
<style>
  .page-header {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    color: white;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .stat-card {
    background: white;
    border-radius: 1rem;
    padding: 1rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .stat-number { font-size: 2rem; font-weight: 800; color: #1e3a8a; }
  @media (max-width: 768px) {
    .page-header { padding: 1rem; }
    .stat-number { font-size: 1.5rem; }
  }
</style>

<div class="container mt-4 mb-5">
<div class="page-header">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-1">📊 Monitoring Servisan Alat Listrik</h2>
      <p class="mb-0 opacity-75">Seluruh data servisan dari semua mahasiswa</p>
    </div>
    <a href="/admin/servisan/cetak" class="btn btn-light btn-sm" target="_blank">
      <i class="bi bi-printer"></i> Cetak Laporan
    </a>
  </div>
</div>

  <!-- Statistik -->
  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-number"><%= data.length %></div>
        <div class="text-muted small">Total Servisan</div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-number"><%= data.filter(i => i.hasilPerbaikan === 'Berhasil').length %></div>
        <div class="text-muted small">Berhasil</div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-number"><%= data.filter(i => i.hasilPerbaikan === 'Tidak berhasil').length %></div>
        <div class="text-muted small">Tidak Berhasil</div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card">
        <div class="stat-number"><%= data.filter(i => !i.hasilPerbaikan || i.hasilPerbaikan === 'Belum Diperbaiki').length %></div>
        <div class="text-muted small">Belum Diperbaiki</div>
      </div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>No</th>
          <th>No. Kupon</th>
          <th>Tgl Servis</th>
          <th>Pemilik</th>
          <th>Jenis Alat</th>
          <th>Kelompok PJ</th>
          <th>Teknisi</th>
          <th>Hasil</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach((item, idx) => { %>
        <tr>
          <td><%= idx+1 %></td>
          <td><%= item.noKupon %></td>
          <td><%= new Date(item.tanggalServis).toLocaleDateString('id-ID') %></td>
          <td><%= item.namaPemilik %></td>
          <td>
            <% 
              let alat = [];
              if(item.jenisAlat && item.jenisAlat.riceCooker) alat.push('RC');
              if(item.jenisAlat && item.jenisAlat.kipasAngin) alat.push('Kipas');
              if(item.jenisAlat && item.jenisAlat.dispenser) alat.push('Dispenser');
              if(item.jenisAlat && item.jenisAlat.mesinCuci) alat.push('Cuci');
              if(item.jenisAlat && item.jenisAlat.lainnya) alat.push(item.jenisAlat.lainnya);
            %>
            <%= alat.join(', ') || '-' %>
          </td>
          <td><%= item.kelompokPenanggungJawab || '-' %></td>
          <td><%= item.namaMahasiswa %> (<%= item.nim %>)</td>
          <td>
            <span class="badge bg-<%= item.hasilPerbaikan === 'Berhasil' ? 'success' : (item.hasilPerbaikan === 'Tidak berhasil' ? 'danger' : 'secondary') %>">
              <%= item.hasilPerbaikan || 'Belum' %>
            </span>
          </td>
          <td>
            <a href="/admin/servisan/<%= item.id %>" class="btn btn-sm btn-info" title="Detail"><i class="bi bi-eye"></i></a>
            <a href="/admin/servisan/hapus/<%= item.id %>" class="btn btn-sm btn-danger" title="Hapus" onclick="return confirm('Hapus data servisan ini?')"><i class="bi bi-trash"></i></a>
          </td>
        </tr>
        <% }) %>
        <% if(data.length === 0) { %>
          <tr><td colspan="9" class="text-center">Belum ada data servisan.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../../partials/footer') %>