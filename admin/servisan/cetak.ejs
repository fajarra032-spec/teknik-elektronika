<!DOCTYPE html>
<html>
<head><title>Test</title></head>
<body>
<% if (data && data.length) { %>
  <h1>Ada <%= data.length %> data</h1>
  <ul>
    <% data.forEach(d => { %>
      <li><%= d.noKupon %> - <%= d.namaPemilik %></li>
    <% }); %>
  </ul>
<% } else { %>
  <h1 style="color:red">Tidak ada data</h1>
<% } %>
</body>
</html>