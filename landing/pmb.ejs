<%- include('../partials/header-landing') %>

<style>
    /* ===== PMB PAGE STYLES (responsif) ===== */
    .pmb-page-wrapper {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 2rem 0 4rem;
    }

    /* Hero Section */
    .pmb-hero {
        background: linear-gradient(145deg, #0b5ed7, #0a58ca);
        border-radius: var(--border-radius, 1.5rem);
        padding: 3rem 1.5rem;
        text-align: center;
        color: white !important;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.2);
    }
    .pmb-hero::before {
        content: '';
        position: absolute;
        top: -30%;
        left: -30%;
        width: 160%;
        height: 160%;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
        z-index: 1;
        animation: slowRotate 20s infinite linear;
    }
    @keyframes slowRotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .pmb-hero-content {
        position: relative;
        z-index: 2;
    }
    .pmb-hero-content h1 {
        font-size: clamp(1.6rem, 6vw, 2.5rem);
    }
    .pmb-hero-content p.lead {
        font-size: clamp(1rem, 4vw, 1.4rem);
    }

    /* Gelombang Badge */
    .gelombang-badge {
        display: inline-block;
        background: linear-gradient(145deg, #ffc107, #ffb300);
        color: #1e293b;
        font-size: clamp(1rem, 4vw, 1.5rem);
        font-weight: 800;
        padding: 0.5rem 1.5rem;
        border-radius: 60px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        margin-bottom: 1rem;
    }
    .gelombang-badge i {
        margin-right: 0.5rem;
        font-size: 1.2rem;
        vertical-align: middle;
    }

    /* Countdown Box */
    .countdown-box {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: var(--border-radius, 1rem);
        padding: 1rem;
        text-align: center;
        transition: all 0.3s;
    }
    .countdown-number {
        font-size: clamp(1.2rem, 5vw, 2.5rem);
        font-weight: 800;
        color: #ffffff !important;
        line-height: 1.2;
    }
    .countdown-box small {
        font-size: clamp(0.6rem, 2vw, 0.8rem);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Button Umum */
    .btn-pmb {
        background: linear-gradient(145deg, #ffffff, #f8fafc);
        border: none;
        border-radius: 50px;
        padding: 0.7rem 1.5rem;
        font-weight: 700;
        color: #0a58ca;
        transition: all 0.3s;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    .btn-pmb:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        color: #084298;
    }

    /* Section Wrapper */
    .section-wrapper {
        background: #ffffff;
        border-radius: 1.2rem;
        padding: 2rem;
        box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }
    .section-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 1.5rem;
        font-size: clamp(1.3rem, 5vw, 1.85rem);
        position: relative;
        display: inline-block;
    }
    .section-title span {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .section-title:after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 50px;
        height: 3px;
        background: linear-gradient(90deg, #0d6efd, #0dcaf0);
        border-radius: 3px;
    }

    /* Table Biaya Responsif */
    .table-pmb {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    .table-pmb thead th {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        color: white;
        padding: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .table-pmb td, .table-pmb th {
        padding: 0.8rem;
        vertical-align: middle;
        border-bottom: 1px solid #e2e8f0;
    }
    
    /* Info Card */
    .info-card {
        background: #ffffff;
        border-radius: 1.2rem;
        padding: 1.5rem;
        text-align: center;
        height: 100%;
        border: 1px solid #eef2ff;
        transition: all 0.3s;
    }
    .info-card i.main-icon {
        font-size: 2.5rem;
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: 1rem;
        display: inline-block;
    }
    .info-card h4 {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 0.8rem;
        color: #1e293b;
    }
    .info-card p {
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        color: #475569;
    }

    /* Form styling */
    .form-control, .form-select {
        border-radius: 0.75rem;
        padding: 0.7rem 1rem;
        font-size: 0.95rem;
        border: 1px solid #cbd5e1;
    }
    .form-control:focus, .form-select:focus {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        border-color: #0d6efd;
    }
    .input-group-text {
        border-radius: 0.75rem 0 0 0.75rem;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        color: #64748b;
    }
    .wa-link-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }
    .wa-link-group a {
        background: #25D366;
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 500;
        transition: 0.2s;
    }
    .wa-link-group a:hover {
        background: #128C7E;
        transform: translateY(-2px);
    }
    .alert-success-custom {
        background: #d1fae5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        border-radius: 1rem;
        padding: 1.5rem;
    }

    /* ========== MEDIA QUERIES (RESPONSIVENESS) ========== */
    @media (max-width: 768px) {
        .pmb-hero {
            padding: 2.5rem 1rem;
        }
        .section-wrapper {
            padding: 1.5rem;
        }
    }

    @media (max-width: 576px) {
        .pmb-page-wrapper {
            padding: 1rem 0 2rem;
        }
        .section-wrapper {
            padding: 1.2rem;
        }
        
        /* ===== PERBAIKAN TABEL MODE CARD UNTUK HP ===== */
        .table-pmb thead {
            display: none;
        }
        .table-pmb, .table-pmb tbody, .table-pmb tr, .table-pmb td {
            display: block;
            width: 100%;
        }
        .table-pmb tr {
            margin-bottom: 1.5rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.8rem;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.04);
            background: #ffffff;
        }
        .table-pmb td {
            display: flex;
            flex-direction: column; /* Mengubah orientasi menjadi atas-bawah */
            align-items: flex-start; /* Meratakan teks ke kiri */
            text-align: left;
            padding: 0.8rem 1.2rem;
            border-bottom: 1px solid #f1f5f9;
            gap: 0.3rem; /* Jarak antara label dan isi data */
        }
        .table-pmb td:last-child {
            border-bottom: none;
            background: #f8fafc; /* Sedikit beda warna untuk bagian total biaya */
        }
        .table-pmb td::before {
            content: attr(data-label);
            font-weight: 700;
            color: #64748b;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            width: 100%;
        }

        /* Alert WA menyesuaikan susunan di HP */
        .alert-success-custom {
            flex-direction: column;
            text-align: center;
            padding: 1.2rem;
        }
        .alert-success-custom i {
            margin-right: 0 !important;
            margin-bottom: 0.8rem;
        }

        /* Tombol Form di HP menjadi Full Width */
        .form-actions {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }
        .form-actions button {
            width: 100%;
            margin: 0 !important;
        }
    }
</style>

