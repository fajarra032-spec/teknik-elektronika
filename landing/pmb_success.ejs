<%- include('../partials/header-landing') %>

<style>
    .success-wrapper {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        min-height: 70vh;
        display: flex;
        align-items: center;
        padding: 2rem 1rem;
    }
    .success-card {
        background: white;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.1);
        max-width: 600px;
        margin: 0 auto;
    }
    .success-header {
        background: linear-gradient(135deg, #28a745, #20c997);
        padding: 2rem;
        text-align: center;
        color: white;
    }
    .success-header i {
        font-size: 4rem;
    }
    .success-body {
        padding: 2rem;
    }
    .success-footer {
        background: #f8fafc;
        padding: 1rem;
        text-align: center;
        border-top: 1px solid #e2e8f0;
    }
    .btn-pmb-home {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        border: none;
        border-radius: 50px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: white;
        transition: 0.3s;
    }
    .btn-pmb-home:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(13,110,253,0.3);
        color: white;
    }
    .wa-confirm {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #25D366;
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }
    .wa-confirm:hover {
        background: #128C7E;
        color: white;
        transform: translateY(-2px);
    }
    @media (max-width: 576px) {
        .success-header i { font-size: 2.5rem; }
        .success-header h3 { font-size: 1.3rem; }
        .success-body { padding: 1.5rem; }
    }
</style>

<div class="success-wrapper">
    <div class="container">
        <div class="success-card">
            <div class="success-header">
                <i class="bi bi-check-circle-fill"></i>
                <h3 class="mt-3 mb-0">Pendaftaran Berhasil!</h3>
            </div>
            <div class="success-body">
                <p class="lead fw-semibold">Terima kasih, <span class="text-primary"><%= nama %></span></p>
                <p>Data pendaftaran Anda telah kami terima. Berikut ringkasan pendaftaran:</p>
                <ul class="list-unstyled mt-3">
                    <li><i class="bi bi-person me-2 text-primary"></i> <strong>Nama:</strong> <%= nama %></li>
                    <li><i class="bi bi-gender-ambiguous me-2 text-primary"></i> <strong>Jenis Kelamin:</strong> <%= jenis_kelamin %></li>
                    <li><i class="bi bi-card-text me-2 text-primary"></i> <strong>NIS:</strong> <%= nis %></li>
                    <li><i class="bi bi-building me-2 text-primary"></i> <strong>Asal Sekolah:</strong> <%= asal_sekolah %></li>
                    <li><i class="bi bi-whatsapp me-2 text-primary"></i> <strong>WA:</strong> <%= wa %></li>
                    <li><i class="bi bi-book me-2 text-primary"></i> <strong>Jurusan:</strong> <%= jurusan %></li>
                    <li><i class="bi bi-star me-2 text-primary"></i> <strong>Jalur:</strong> <%= jalur %></li>
                </ul>

                <!-- ALERT INFO -->
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle-fill me-2"></i> 
                    Panitia PMB akan segera menghubungi Anda melalui WhatsApp untuk verifikasi data dan NIM.
                </div>

                <!-- TOMBOL KONFIRMASI WHATSAPP -->
                <div class="text-center mt-4">
                    <p class="mb-2 fw-semibold">Silakan hubungi untuk konfirmasi pendaftaran:</p>
                    <a href="https://wa.me/6285242459746" target="_blank" class="wa-confirm">
                        <i class="bi bi-whatsapp fs-5"></i> 0852-4245-9746
                    </a>
                    <p class="text-muted small mt-2">Setelah konfirmasi, data Anda akan segera diproses.</p>
                </div>

                <p class="text-muted small mt-3">Simpan halaman ini sebagai bukti pendaftaran sementara.</p>
            </div>
            <div class="success-footer">
                <a href="/pmb" class="btn-pmb-home"><i class="bi bi-arrow-left me-2"></i> Kembali ke Halaman PMB</a>
                <a href="/" class="btn btn-outline-secondary rounded-pill ms-2">Ke Beranda</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer-landing') %>