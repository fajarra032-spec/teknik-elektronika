<script>
  // ---------- DATA DEFAULT ----------
  const defaultBeban = [
    { jenis: "Lampu LED", jml: 0, daya: 0, mulai: "18:00", selesai: "22:00", ket: "" },
    { jenis: "Lampu pijar / neon", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Kulkas", jml: 0, daya: 0, mulai: "00:00", selesai: "23:59", ket: "" },
    { jenis: "Mesin cuci", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Setrika", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Rice cooker", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Kipas angin", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "TV", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Pompa air", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Dispenser", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Charger HP/Powerbank", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" },
    { jenis: "Komputer / laptop", jml: 0, daya: 0, mulai: "", selesai: "", ket: "" }
  ];

  let bebanList = [...defaultBeban];
  let rekomendasiList = [{ deskripsi: '', prioritas: 'Segera' }];

  // ---------- FUNGSI BANTU ----------
  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
      if (m === '&') return '&amp;';
      if (m === '<') return '&lt;';
      if (m === '>') return '&gt;';
      return m;
    });
  }

  function timeToMinutes(timeStr) {
    if (!timeStr || typeof timeStr !== 'string') return 0;
    const parts = timeStr.split(':');
    if (parts.length < 2) return 0;
    let h = parseInt(parts[0], 10);
    let m = parseInt(parts[1], 10);
    if (isNaN(h)) h = 0;
    if (isNaN(m)) m = 0;
    return h * 60 + m;
  }

  function hitungDurasi(mulai, selesai) {
    if (!mulai || !selesai) return 0;
    let start = timeToMinutes(mulai);
    let end = timeToMinutes(selesai);
    if (end < start) end += 24 * 60;
    let durasiJam = (end - start) / 60;
    return durasiJam > 0 ? durasiJam : 0;
  }

  // ---------- RENDER TABEL BEBAN ----------
  function renderBeban() {
    const container = document.getElementById('bebanContainer');
    const rows = container.querySelectorAll('.beban-row');
    rows.forEach(r => r.remove());

    bebanList.forEach((b, i) => {
      const row = document.createElement('div');
      row.className = 'beban-row';
      row.setAttribute('data-index', i);
      const totalDayaBaris = (b.jml || 0) * (b.daya || 0);
      const durasi = hitungDurasi(b.mulai, b.selesai);
      const energiBaris = totalDayaBaris * durasi;

      row.innerHTML = `
        <div style="flex: 2; min-width: 130px;"><input type="text" class="form-control form-control-sm field-jenis" value="${escapeHtml(b.jenis)}"></div>
        <div style="flex: 0.5; min-width: 60px;"><input type="number" class="form-control form-control-sm field-jml" value="${b.jml}"></div>
        <div style="flex: 1; min-width: 80px;"><input type="number" class="form-control form-control-sm field-daya" value="${b.daya}"></div>
        <div style="flex: 1; min-width: 80px;"><input type="number" class="form-control form-control-sm bg-light fw-bold total-daya-row" value="${totalDayaBaris}" readonly></div>
        <div style="flex: 1.2; min-width: 90px;"><input type="time" class="form-control form-control-sm field-mulai" value="${b.mulai}"></div>
        <div style="flex: 1.2; min-width: 90px;"><input type="time" class="form-control form-control-sm field-selesai" value="${b.selesai}"></div>
        <div style="flex: 0.8; min-width: 60px;"><input type="text" class="form-control form-control-sm bg-light durasi-row" value="${durasi.toFixed(1)}" readonly></div>
        <div style="flex: 1.5; min-width: 100px;"><input type="number" class="form-control form-control-sm bg-light energi-row" value="${energiBaris.toFixed(0)}" readonly></div>
        <div style="flex: 2; min-width: 150px;"><input type="text" class="form-control form-control-sm field-ket" value="${escapeHtml(b.ket)}" placeholder="Kondisi alat"></div>
        <button type="button" class="btn btn-sm text-danger btn-remove">✕</button>
      `;
      container.appendChild(row);
    });

    // Pasang event listener untuk setiap baris (event delegation)
    document.querySelectorAll('.beban-row').forEach(row => {
      const idx = parseInt(row.getAttribute('data-index'));
      // Input jenis
      const inputJenis = row.querySelector('.field-jenis');
      if (inputJenis) inputJenis.addEventListener('change', (e) => { bebanList[idx].jenis = e.target.value; hitungTotal(); });
      // Input jumlah
      const inputJml = row.querySelector('.field-jml');
      if (inputJml) inputJml.addEventListener('input', (e) => { bebanList[idx].jml = parseFloat(e.target.value) || 0; updateRowTotal(idx); });
      // Input daya
      const inputDaya = row.querySelector('.field-daya');
      if (inputDaya) inputDaya.addEventListener('input', (e) => { bebanList[idx].daya = parseFloat(e.target.value) || 0; updateRowTotal(idx); });
      // Input mulai
      const inputMulai = row.querySelector('.field-mulai');
      if (inputMulai) inputMulai.addEventListener('change', (e) => { bebanList[idx].mulai = e.target.value; updateRowDurasiEnergi(idx); });
      // Input selesai
      const inputSelesai = row.querySelector('.field-selesai');
      if (inputSelesai) inputSelesai.addEventListener('change', (e) => { bebanList[idx].selesai = e.target.value; updateRowDurasiEnergi(idx); });
      // Input keterangan
      const inputKet = row.querySelector('.field-ket');
      if (inputKet) inputKet.addEventListener('change', (e) => { bebanList[idx].ket = e.target.value; });
      // Tombol hapus
      const btnRemove = row.querySelector('.btn-remove');
      if (btnRemove) btnRemove.addEventListener('click', () => { bebanList.splice(idx, 1); renderBeban(); });
    });
  }

  function updateRowTotal(index) {
    const b = bebanList[index];
    const totalDayaBaris = (b.jml || 0) * (b.daya || 0);
    const row = document.querySelector(`.beban-row[data-index='${index}']`);
    if (row) {
      const totalDayaCell = row.querySelector('.total-daya-row');
      if (totalDayaCell) totalDayaCell.value = totalDayaBaris;
    }
    updateRowDurasiEnergi(index);
  }

  function updateRowDurasiEnergi(index) {
    const b = bebanList[index];
    const totalDayaBaris = (b.jml || 0) * (b.daya || 0);
    const durasi = hitungDurasi(b.mulai, b.selesai);
    const energiBaris = totalDayaBaris * durasi;
    const row = document.querySelector(`.beban-row[data-index='${index}']`);
    if (row) {
      const durasiCell = row.querySelector('.durasi-row');
      const energiCell = row.querySelector('.energi-row');
      if (durasiCell) durasiCell.value = durasi.toFixed(1);
      if (energiCell) energiCell.value = energiBaris.toFixed(0);
    }
    hitungTotal();
  }
// ---------- REKOMENDASI ----------
function renderRekomendasi() {
  const container = document.getElementById('rekomendasiContainer');
  if (!container) return;
  container.innerHTML = '';
  rekomendasiList.forEach((r, i) => {
    const row = document.createElement('div');
    row.className = 'row g-2 mb-2';
    row.innerHTML = `
      <div class="col-8"><input type="text" class="form-control" placeholder="Rekomendasi perbaikan..." value="${escapeHtml(r.deskripsi)}" onchange="rekomendasiList[${i}].deskripsi = this.value"></div>
      <div class="col-3"><select class="form-select" onchange="rekomendasiList[${i}].prioritas = this.value"><option value="Segera" ${r.prioritas === 'Segera' ? 'selected' : ''}>Segera</option><option value="Berkala" ${r.prioritas === 'Berkala' ? 'selected' : ''}>Berkala</option></select></div>
      <div class="col-1"><button type="button" class="btn text-danger" onclick="rekomendasiList.splice(${i}, 1); renderRekomendasi();">✕</button></div>
    `;
    container.appendChild(row);
  });
}
  function hitungTotal() {
    let totalDaya = 0;
    let totalEnergi = 0;
    for (let b of bebanList) {
      const daya = (b.jml || 0) * (b.daya || 0);
      totalDaya += daya;
      const durasi = hitungDurasi(b.mulai, b.selesai);
      totalEnergi += daya * durasi;
    }
    document.getElementById('totalDayaDisplay').innerText = totalDaya.toLocaleString();
    document.getElementById('totalBeban').value = totalDaya;
    document.getElementById('totalEnergiDisplay').innerText = totalEnergi.toLocaleString();
    const totalKwh = (totalEnergi / 1000).toFixed(1);
    document.getElementById('totalKwhDisplay').innerText = totalKwh;
    hitungBebanPuncak();
  }
  // ---------- GRAFIK BEBAN PUNCAK ----------
let bebanChart = null;

function initChart() {
  const ctx = document.getElementById('bebanChart').getContext('2d');
  bebanChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: Array.from({length: 24}, (_, i) => i.toString().padStart(2,'0') + ':00'),
      datasets: [{
        label: 'Beban (Watt)',
        data: new Array(24).fill(0),
        backgroundColor: 'rgba(54, 162, 235, 0.6)',
        borderColor: 'rgba(54, 162, 235, 1)',
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      scales: {
        y: {
          beginAtZero: true,
          title: { display: true, text: 'Watt' }
        },
        x: {
          title: { display: true, text: 'Jam' },
          ticks: { stepSize: 1, autoSkip: true, maxRotation: 45 }
        }
      },
      plugins: {
        tooltip: { callbacks: { label: (ctx) => `${ctx.raw} Watt` } }
      }
    }
  });
}

function updateChart(bebanPerJam) {
  if (!bebanChart) initChart();
  bebanChart.data.datasets[0].data = bebanPerJam;
  bebanChart.update();
}

// Hitung beban per jam dan update grafik
function hitungBebanPuncak() {
  let bebanPerJam = new Array(24).fill(0);
  
  for (let b of bebanList) {
    if (!b.mulai || !b.selesai) continue;
    if ((b.jml || 0) === 0 || (b.daya || 0) === 0) continue;
    const totalDayaBaris = (b.jml || 0) * (b.daya || 0);
    let start = timeToMinutes(b.mulai);
    let end = timeToMinutes(b.selesai);
    if (end < start) end += 24 * 60;
    
    let startHour = Math.floor(start / 60);
    let endHour = Math.floor(end / 60);
    // Untuk setiap jam dalam rentang, tambahkan beban penuh (estimasi sederhana)
    for (let h = startHour; h <= endHour; h++) {
      let hourMod = h % 24;
      bebanPerJam[hourMod] += totalDayaBaris;
    }
  }
  
  // Update grafik
  updateChart(bebanPerJam);
  
  // Cari jam puncak
  let maxBeban = 0;
  let jamPuncakArray = [];
  for (let i = 0; i < 24; i++) {
    if (bebanPerJam[i] > maxBeban) {
      maxBeban = bebanPerJam[i];
      jamPuncakArray = [i];
    } else if (bebanPerJam[i] === maxBeban && maxBeban > 0) {
      jamPuncakArray.push(i);
    }
  }
  
  document.getElementById('jamPuncak').innerText = jamPuncakArray.length ? jamPuncakArray.map(j => j.toString().padStart(2,'0')+':00').join(', ') : '-';
  document.getElementById('bebanPuncak').innerText = maxBeban;
  
  let rekomTeks = '';
  if (maxBeban > 0) {
    if (maxBeban > 900) rekomTeks = '⚠️ Beban puncak cukup tinggi (>900W). Sebarkan penggunaan alat berat ke jam lain.';
    else if (maxBeban > 450) rekomTeks = '📊 Beban puncak sedang. Hindari menyalakan banyak alat bersamaan.';
    else rekomTeks = '✅ Beban puncak aman. Tetap pantau.';
  } else {
    rekomTeks = '📝 Isi data beban dan jadwal (mulai & selesai) untuk melihat analisis.';
  }
  document.getElementById('rekomendasiBeban').innerText = rekomTeks;
}

  // ---------- PERHITUNGAN TEGANGAN x ARUS ----------
  const teganganInput = document.getElementById('tegangan');
  const arusInput = document.getElementById('arusTotal');
  const bebanTerpasangInput = document.getElementById('bebanTerpasang');

  function hitungBebanTerpasang() {
    const teg = parseFloat(teganganInput.value) || 0;
    const arus = parseFloat(arusInput.value) || 0;
    bebanTerpasangInput.value = Math.round(teg * arus);
  }

  // ---------- EVENT LISTENERS ----------
  document.getElementById('addBeban').addEventListener('click', () => {
    bebanList.push({ jenis: '', jml: 0, daya: 0, mulai: '', selesai: '', ket: '' });
    renderBeban();
    hitungBebanPuncak();
  });

  document.getElementById('addRekomendasi').addEventListener('click', () => {
    rekomendasiList.push({ deskripsi: '', prioritas: 'Segera' });
    renderRekomendasi();
  });

  teganganInput.addEventListener('input', hitungBebanTerpasang);
  arusInput.addEventListener('input', hitungBebanTerpasang);

  // Serialisasi data sebelum submit
  document.getElementById('inspeksiForm').addEventListener('submit', function(e) {
    const oldBeban = document.querySelector('input[name="bebanList"]');
    if (oldBeban) oldBeban.remove();
    const oldRekom = document.querySelector('input[name="rekomendasiList"]');
    if (oldRekom) oldRekom.remove();

    const inputB = document.createElement('input');
    inputB.type = 'hidden';
    inputB.name = 'bebanList';
    inputB.value = JSON.stringify(bebanList);
    this.appendChild(inputB);

    const inputR = document.createElement('input');
    inputR.type = 'hidden';
    inputR.name = 'rekomendasiList';
    inputR.value = JSON.stringify(rekomendasiList);
    this.appendChild(inputR);
  });
  // ---------- DEFAULT BERDASARKAN KELOMPOK ----------
// Mapping kelompok ke daya (VA) dan MCB (Ampere)
const defaultByKelompok = {
  1: { daya: 450, mcb: 2 },
  2: { daya: 900, mcb: 4 },
  3: { daya: 1300, mcb: 6 },
  4: { daya: 2200, mcb: 10 }
};

function setDefaultByKelompok() {
  const kelompok = parseInt(document.getElementById('kelompokSelect').value);
  const defaults = defaultByKelompok[kelompok];
  if (defaults) {
    // Set daya terpasang (jika menggunakan select, pilih value yang sesuai)
    const dayaSelect = document.getElementById('dayaTerpasangSelect');
    if (dayaSelect) dayaSelect.value = defaults.daya.toString();
    // Set MCB utama
    const mcbSelect = document.getElementById('mcbUtamaSelect');
    if (mcbSelect) mcbSelect.value = defaults.mcb.toString();
  }
}

// Event listener saat kelompok berubah
document.getElementById('kelompokSelect').addEventListener('change', setDefaultByKelompok);
// Juga saat desa berubah, jika diperlukan tambahan (misal desa tertentu beda)
// Panggil sekali saat halaman dimuat
setDefaultByKelompok();
// Cetak laporan
document.getElementById('btnCetak').addEventListener('click', function() {
  // Kumpulkan semua data dari form (termasuk bebanList dan rekomendasiList)
  const formData = {
    kelompok: document.getElementById('kelompokSelect').value,
    tanggal: document.querySelector('input[name="tanggal"]').value,
    desa: document.querySelector('input[name="desa"]').value,
    dusunRt: document.getElementById('dusunSelect').value,
    pemilikRumah: document.querySelector('input[name="pemilikRumah"]').value,
    alamat: document.querySelector('input[name="alamat"]').value,
    dayaTerpasang: document.getElementById('dayaTerpasangSelect').value,
    jumlahPenghuni: document.querySelector('input[name="jumlahPenghuni"]').value,
    pernahKorsleting: document.querySelector('select[name="pernahKorsleting"]').value,
    keteranganKorsleting: document.querySelector('input[name="keteranganKorsleting"]').value,
    tegangan: document.getElementById('tegangan').value,
    arusTotal: document.getElementById('arusTotal').value,
    bebanTerpasang: document.getElementById('bebanTerpasang').value,
    totalDaya: document.getElementById('totalDayaDisplay').innerText.replace(/,/g, ''),
    totalEnergi: document.getElementById('totalEnergiDisplay').innerText.replace(/,/g, ''),
    bebanList: bebanList,
    mcbUtamaAda: document.querySelector('select[name="mcbUtamaAda"]').value,
    mcbUtamaUkuran: document.getElementById('mcbUtamaSelect').value,
    mcbUtamaSesuai: document.querySelector('select[name="mcbUtamaSesuai"]').value,
    mcbUtamaRekomendasi: document.querySelector('input[name="mcbUtamaRekomendasi"]').value,
    mcbCabangAda: document.querySelector('select[name="mcbCabangAda"]').value,
    mcbCabangUkuran: document.querySelector('select[name="mcbCabangUkuran"]').value,
    mcbCabangSesuai: document.querySelector('select[name="mcbCabangSesuai"]').value,
    mcbCabangRekomendasi: document.querySelector('input[name="mcbCabangRekomendasi"]').value,
    mcbPernahTrip: document.querySelector('select[name="mcbPernahTrip"]').value,
    kabelUtamaUkuran: document.querySelector('input[name="kabelUtamaUkuran"]').value,
    kabelUtamaSesuai: document.querySelector('select[name="kabelUtamaSesuai"]').value,
    kabelCabangUkuran: document.querySelector('input[name="kabelCabangUkuran"]').value,
    kabelCabangSesuai: document.querySelector('select[name="kabelCabangSesuai"]').value,
    kabelTerbuka: document.querySelector('select[name="kabelTerbuka"]').value,
    sambunganRapi: document.querySelector('select[name="sambunganRapi"]').value,
    stopKontakLonggar: document.querySelector('select[name="stopKontakLonggar"]').value,
    adaGrounding: document.querySelector('select[name="adaGrounding"]').value,
    lembab: document.querySelector('select[name="lembab"]').value,
    kesimpulan: document.querySelector('select[name="kesimpulan"]').value,
    petugasNama: document.querySelector('input[name="petugasNama"]').value,
    pemilikNama: document.querySelector('input[name="pemilikNama"]').value,
    rekomendasiList: rekomendasiList
  };

  // Kirim via POST ke endpoint cetak (buka di tab baru)
  const formCetak = document.createElement('form');
  formCetak.method = 'POST';
  formCetak.action = '/mahasiswa/inspeksi/cetak';
  formCetak.target = '_blank';
  const inputData = document.createElement('input');
  inputData.type = 'hidden';
  inputData.name = 'data';
  inputData.value = JSON.stringify(formData);
  formCetak.appendChild(inputData);
  document.body.appendChild(formCetak);
  formCetak.submit();
  document.body.removeChild(formCetak);
});

  // Inisialisasi
  renderBeban();
  initChart();
  renderRekomendasi();
  hitungBebanPuncak();
</script>
