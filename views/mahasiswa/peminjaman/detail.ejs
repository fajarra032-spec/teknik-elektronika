<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  const tgl = (s) => s ? new Date(s).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-';
  const waktu = (s) => s ? new Date(s).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
%>
<div class="container mt-4 mb-5" style="max-width: 860px;">
  <div class="lab-hero">
    <a href="/mahasiswa/peminjaman-alat" class="btn btn-sm btn-outline-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Riwayat peminjaman</a>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div><h2><%= p.kode %></h2><p class="lab-sub">Diajukan <%= waktu(p.createdAt) %></p></div>
      <div class="fs-6"><%- include('../../partials/peminjaman_status', { status: p.status, terlambat: p.terlambat }) %></div>
    </div>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <div class="lab-panel mb-3"><div class="lab-panel-body pb-3"><%- include('../../partials/peminjaman_stepper', { status: p.status }) %></div></div>

  <% if (p.status === 'diajukan') { %>
    <div class="alert alert-warning"><i class="bi bi-hourglass-split me-1"></i> Menunggu persetujuan admin. Anda akan mendapat notifikasi setelah diproses.</div>
  <% } else if (p.status === 'dipinjam') { %>
    <div class="alert alert-primary"><i class="bi bi-check-circle me-1"></i> Disetujui<% if (p.disetujuiOleh) { %> oleh <%= p.disetujuiOleh %><% } %>. Kembalikan paling lambat <strong><%= tgl(p.tanggalRencanaKembali) %></strong>.
      <% if (p.catatanAdmin) { %><div class="small mt-1">Catatan admin: <%= p.catatanAdmin %></div><% } %></div>
  <% } else if (p.status === 'menunggu_verifikasi_kembali') { %>
    <div class="alert alert-info"><i class="bi bi-box-arrow-in-left me-1"></i> Pengajuan pengembalian terkirim. Serahkan alat ke admin lab untuk diverifikasi.</div>
  <% } else if (p.status === 'ditolak') { %>
    <div class="alert alert-danger"><i class="bi bi-x-circle me-1"></i> Ditolak. Alasan: <%= p.alasanPenolakan %></div>
  <% } else if (p.status === 'dikembalikan') { %>
    <div class="alert alert-success"><i class="bi bi-patch-check me-1"></i> Pengembalian diverifikasi admin pada <%= tgl(p.tanggalKembali) %>.
      <% if (p.hariTerlambat > 0) { %><strong>Terlambat <%= p.hariTerlambat %> hari.</strong><% } %></div>
  <% } %>

  <div class="lab-panel mb-3"><div class="lab-panel-body">
    <div class="lab-sec"><i class="bi bi-info-circle"></i> Informasi peminjaman</div>
    <dl class="lab-dl">
      <dt>Keperluan</dt><dd><%= p.keperluan %></dd>
      <dt>Mata kuliah / kegiatan</dt><dd><%= p.kegiatan || '-' %></dd>
      <dt>Tanggal pinjam</dt><dd><%= tgl(p.tanggalPinjam) %></dd>
      <dt>Rencana kembali</dt><dd><%= tgl(p.tanggalRencanaKembali) %></dd>
    </dl>
  </div></div>

  <div class="lab-panel mb-3"><div class="lab-panel-body">
    <div class="lab-sec"><i class="bi bi-motherboard"></i> Alat</div>
    <div class="lab-table-wrap"><div class="table-responsive">
      <table class="lab-table">
        <thead><tr><th>Alat</th><th class="text-center">Jumlah</th>
          <% if (p.status === 'dikembalikan') { %><th class="text-center">Baik</th><th class="text-center">Rusak</th><th class="text-center">Hilang</th><% } %></tr></thead>
        <tbody>
          <% p.items.forEach(it => { %>
            <tr>
              <td><div class="d-flex align-items-center gap-2">
                <% if (it.fotoUrl) { %><img class="lab-thumb" src="<%= it.fotoUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } else { %><span class="lab-thumb no-photo"></span><% } %>
                <div><div class="fw-semibold"><%= it.nama %></div><% if (it.kode) { %><span class="lab-code"><%= it.kode %></span><% } %></div></div></td>
              <td class="text-center fw-semibold"><%= it.jumlah %></td>
              <% if (p.status === 'dikembalikan') { %>
                <td class="text-center text-success fw-semibold"><%= it.jumlahBaik %></td>
                <td class="text-center <%= it.jumlahRusak ? 'text-warning fw-bold' : 'text-muted' %>"><%= it.jumlahRusak %></td>
                <td class="text-center <%= it.jumlahHilang ? 'text-danger fw-bold' : 'text-muted' %>"><%= it.jumlahHilang %></td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div></div>
    <% if (p.status === 'dikembalikan' && p.catatanVerifikasi) { %><div class="lab-note mt-3"><strong>Catatan admin:</strong> <%= p.catatanVerifikasi %></div><% } %>
  </div></div>

  <% if (p.status === 'diajukan') { %>
    <form method="POST" action="/mahasiswa/peminjaman-alat/<%= p.id %>/batal" class="mb-3" onsubmit="return confirm('Batalkan pengajuan ini?')">
      <button class="btn btn-outline-danger rounded-pill px-4">Batalkan pengajuan</button>
    </form>
  <% } %>

  <% if (p.status === 'dipinjam') { %>
    <div class="lab-panel mb-3"><div class="lab-panel-body lab-form">
      <div class="lab-sec"><i class="bi bi-box-arrow-in-left"></i> Kembalikan alat</div>
      <form method="POST" action="/mahasiswa/peminjaman-alat/<%= p.id %>/kembalikan">
        <p class="small text-muted">Setelah mengajukan, serahkan alat ke admin lab. Stok baru bertambah setelah admin memeriksa kondisi alat.</p>
        <textarea name="catatan" class="form-control mb-3" rows="2" maxlength="500" placeholder="Catatan kondisi alat (opsional), misalnya probe sedikit longgar"></textarea>
        <button class="btn btn-primary rounded-pill px-4" onclick="return confirm('Ajukan pengembalian alat sekarang?')">Ajukan pengembalian</button>
      </form>
    </div></div>
  <% } %>

  <div class="lab-panel"><div class="lab-panel-body">
    <div class="lab-sec"><i class="bi bi-clock-history"></i> Riwayat</div>
    <ul class="lab-timeline">
      <% (p.riwayat || []).forEach(r => { %>
        <li><div class="fw-semibold"><%= statusLabel[r.status] || r.status %></div>
          <div class="who"><%= r.oleh %> &middot; <%= waktu(r.waktu) %></div>
          <% if (r.catatan) { %><div class="note"><%= r.catatan %></div><% } %></li>
      <% }) %>
    </ul>
  </div></div>
</div>
<%- include('../../partials/footer') %>
