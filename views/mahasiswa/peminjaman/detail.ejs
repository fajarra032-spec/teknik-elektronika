<%- include('../../partials/header') %>
<style>
  .detail-card { background: #fff; border-radius: 1.5rem; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0,0,0,.05); }
  .detail-header { background: linear-gradient(135deg, #1e3a8a, #3b82f6); padding: 1.25rem 1.5rem; color: #fff; }
  .sec { border-left: 3px solid #3b82f6; padding-left: .75rem; margin: 1.5rem 0 .75rem; font-weight: 700; color: #1e3a8a; }
  .info-row { display: flex; flex-wrap: wrap; margin-bottom: .4rem; }
  .info-label { width: 35%; font-weight: 600; } .info-value { width: 65%; }
  .timeline { list-style: none; padding-left: 0; margin: 0; }
  .timeline li { border-left: 2px solid #cbd5e1; padding: 0 0 .9rem 1rem; position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -6px; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: #3b82f6; }
  @media (max-width: 768px) { .info-label, .info-value { width: 100%; } }
</style>
<%
  const tgl = (s) => s ? new Date(s).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) : '-';
  const waktu = (s) => s ? new Date(s).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
%>
<div class="container mt-4 mb-5" style="max-width: 900px;">
  <a href="/mahasiswa/peminjaman-alat" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Kembali</a>
  <%- include('../../partials/pesan_flash') %>

  <div class="detail-card">
    <div class="detail-header d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h4 class="fw-bold mb-1">Peminjaman <%= p.kode %></h4>
        <div class="opacity-75 small">Diajukan <%= waktu(p.createdAt) %></div>
      </div>
      <div class="fs-6"><%- include('../../partials/peminjaman_status', { status: p.status, terlambat: p.terlambat }) %></div>
    </div>

    <div class="p-4">
      <% if (p.status === 'diajukan') { %>
        <div class="alert alert-warning"><i class="bi bi-hourglass-split"></i> Pengajuan menunggu persetujuan admin. Anda akan mendapat notifikasi setelah diproses.</div>
      <% } else if (p.status === 'dipinjam') { %>
        <div class="alert alert-primary"><i class="bi bi-check-circle"></i> Disetujui<% if (p.disetujuiOleh) { %> oleh <%= p.disetujuiOleh %><% } %>. Kembalikan paling lambat <strong><%= tgl(p.tanggalRencanaKembali) %></strong>.
          <% if (p.catatanAdmin) { %><div class="small mt-1">Catatan admin: <%= p.catatanAdmin %></div><% } %></div>
      <% } else if (p.status === 'menunggu_verifikasi_kembali') { %>
        <div class="alert alert-info"><i class="bi bi-box-arrow-in-left"></i> Pengajuan pengembalian terkirim. Serahkan alat ke admin lab untuk diverifikasi.</div>
      <% } else if (p.status === 'ditolak') { %>
        <div class="alert alert-danger"><i class="bi bi-x-circle"></i> Ditolak. Alasan: <%= p.alasanPenolakan %></div>
      <% } else if (p.status === 'dikembalikan') { %>
        <div class="alert alert-success"><i class="bi bi-patch-check"></i> Pengembalian sudah diverifikasi admin pada <%= tgl(p.tanggalKembali) %>.
          <% if (p.hariTerlambat > 0) { %><strong>Terlambat <%= p.hariTerlambat %> hari.</strong><% } %></div>
      <% } %>

      <div class="sec">Informasi Peminjaman</div>
      <div class="info-row"><div class="info-label">Keperluan</div><div class="info-value"><%= p.keperluan %></div></div>
      <div class="info-row"><div class="info-label">Mata Kuliah / Kegiatan</div><div class="info-value"><%= p.kegiatan || '-' %></div></div>
      <div class="info-row"><div class="info-label">Tanggal Pinjam</div><div class="info-value"><%= tgl(p.tanggalPinjam) %></div></div>
      <div class="info-row"><div class="info-label">Rencana Kembali</div><div class="info-value"><%= tgl(p.tanggalRencanaKembali) %></div></div>

      <div class="sec">Alat</div>
      <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0">
          <thead class="table-light">
            <tr><th>Kode</th><th>Nama Alat</th><th class="text-center">Jumlah</th>
              <% if (p.status === 'dikembalikan') { %><th class="text-center">Baik</th><th class="text-center">Rusak</th><th class="text-center">Hilang</th><% } %></tr>
          </thead>
          <tbody>
            <% p.items.forEach(it => { %>
              <tr><td><code><%= it.kode || '-' %></code></td><td><%= it.nama %></td><td class="text-center"><%= it.jumlah %></td>
                <% if (p.status === 'dikembalikan') { %>
                  <td class="text-center text-success"><%= it.jumlahBaik %></td>
                  <td class="text-center <%= it.jumlahRusak ? 'text-warning fw-bold' : '' %>"><%= it.jumlahRusak %></td>
                  <td class="text-center <%= it.jumlahHilang ? 'text-danger fw-bold' : '' %>"><%= it.jumlahHilang %></td>
                <% } %></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (p.status === 'dikembalikan' && p.catatanVerifikasi) { %>
        <div class="mt-2 small"><strong>Catatan admin:</strong> <%= p.catatanVerifikasi %></div>
      <% } %>

      <% if (p.status === 'diajukan') { %>
        <form method="POST" action="/mahasiswa/peminjaman-alat/<%= p.id %>/batal" class="mt-4" onsubmit="return confirm('Batalkan pengajuan ini?')">
          <button class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Batalkan Pengajuan</button>
        </form>
      <% } %>

      <% if (p.status === 'dipinjam') { %>
        <div class="sec">Kembalikan Alat</div>
        <form method="POST" action="/mahasiswa/peminjaman-alat/<%= p.id %>/kembalikan">
          <p class="small text-muted">Setelah menekan tombol ini, serahkan alat ke admin lab. Stok baru bertambah setelah admin memverifikasi kondisi alat.</p>
          <textarea name="catatan" class="form-control mb-2" rows="2" maxlength="500" placeholder="Catatan kondisi alat (opsional), mis. probe sedikit longgar"></textarea>
          <button class="btn btn-primary" onclick="return confirm('Ajukan pengembalian alat sekarang?')"><i class="bi bi-box-arrow-in-left"></i> Ajukan Pengembalian</button>
        </form>
      <% } %>

      <div class="sec">Riwayat</div>
      <ul class="timeline">
        <% (p.riwayat || []).forEach(r => { %>
          <li>
            <div><strong><%= statusLabel[r.status] || r.status %></strong> <span class="text-muted small">· <%= r.oleh %> · <%= waktu(r.waktu) %></span></div>
            <% if (r.catatan) { %><div class="small text-muted"><%= r.catatan %></div><% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>
