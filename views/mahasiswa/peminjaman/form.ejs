<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  var _kat = {}; alat.forEach(function (a) { var k = a.kategori || 'Lainnya'; _kat[k] = (_kat[k] || 0) + 1; });
%>
<div class="container mt-4 mb-5" style="max-width: 1080px;">
  <div class="lab-hero">
    <a href="/mahasiswa/peminjaman-alat" class="btn btn-sm btn-outline-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Riwayat peminjaman</a>
    <h2>Pilih alat yang ingin dipinjam</h2>
    <p class="lab-sub">Atur jumlah pada kartu alat, lalu isi jadwal dan keperluan di bagian bawah. Stok berkurang setelah admin menyetujui.</p>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <form method="POST" action="/mahasiswa/peminjaman-alat/ajukan" id="formPinjam" class="lab-form">
    <div class="lab-toolbar">
      <label class="lab-search"><i class="bi bi-search"></i><input type="search" id="cari" placeholder="Cari nama, kode, merk, atau kategori" aria-label="Cari alat"></label>
      <div class="lab-chips" id="chipKat">
        <button type="button" class="lab-chip active" data-kat="">Semua<em><%= alat.length %></em></button>
        <% Object.keys(_kat).sort().forEach(function (k) { %><button type="button" class="lab-chip" data-kat="<%= k %>"><%= k %><em><%= _kat[k] %></em></button><% }) %>
      </div>
    </div>

    <div class="tool-grid" id="etalase">
      <% alat.forEach(function (a) { var habis = (a.jumlahTersedia || 0) < 1; var total = a.jumlahTotal || 0;
           var persen = total ? Math.round(((a.jumlahTersedia || 0) / total) * 100) : 0;
           var gaugeKelas = habis ? 'none' : (persen < 50 ? 'low' : ''); %>
        <div class="tool-card alat-item <%= habis ? 'empty-stock' : '' %>" data-kat="<%= a.kategori || 'Lainnya' %>" data-cari="<%= [a.kode, a.nama, a.merk, a.kategori].join(' ').toLowerCase() %>">
          <div class="tool-photo <%= a.fotoUrl ? '' : 'no-photo' %>" <% if (a.fotoUrl) { %>role="button" tabindex="0" style="cursor:zoom-in" data-foto="<%= a.fotoUrl %>" data-nama="<%= a.nama %>" aria-label="Perbesar foto <%= a.nama %>"<% } %>>
            <% if (a.fotoUrl) { %><img src="<%= a.fotoUrl %>" alt="<%= a.nama %>" loading="lazy" referrerpolicy="no-referrer"><% } %>
            <% if (a.kode) { %><span class="tool-tag"><%= a.kode %></span><% } %>
          </div>
          <div class="tool-body">
            <div class="tool-name"><%= a.nama %></div>
            <div class="tool-meta"><%= a.kategori || 'Lainnya' %><% if (a.merk) { %> &middot; <%= a.merk %><% } %></div>
            <% if (a.lokasi) { %><div class="tool-meta"><i class="bi bi-geo-alt"></i> <%= a.lokasi %></div><% } %>
            <div class="tool-foot">
              <div class="tool-stock"><span><%= habis ? 'Stok habis' : 'Tersedia' %></span><span><b><%= a.jumlahTersedia || 0 %></b> dari <%= total %> unit</span></div>
              <div class="gauge <%= gaugeKelas %>" style="--v: <%= persen %>%"><i></i></div>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="tool-meta">Jumlah pinjam</span>
                <div class="qty-step">
                  <button type="button" class="btn-min" aria-label="Kurangi <%= a.nama %>" <%= habis ? 'disabled' : '' %>>&minus;</button>
                  <input type="number" class="qty" name="jumlah_<%= a.id %>" min="0" max="<%= a.jumlahTersedia || 0 %>" value="0" aria-label="Jumlah <%= a.nama %>" <%= habis ? 'disabled' : '' %>>
                  <button type="button" class="btn-plus" aria-label="Tambah <%= a.nama %>" <%= habis ? 'disabled' : '' %>>+</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <% if (alat.length === 0) { %><div class="lab-empty"><i class="bi bi-motherboard"></i>Belum ada alat terdata di inventaris. Hubungi admin lab.</div><% } %>
    <div id="kosongCari" class="lab-empty" style="display:none;"><i class="bi bi-search"></i>Tidak ada alat yang cocok dengan pencarian.</div>

    <div class="lab-panel mt-4">
      <div class="lab-panel-body">
        <div class="lab-sec"><i class="bi bi-calendar-event"></i> Jadwal peminjaman</div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Tanggal pinjam <span class="text-danger">*</span></label>
            <input type="date" name="tanggalPinjam" id="tglPinjam" class="form-control" min="<%= hariIni %>" value="<%= hariIni %>" required></div>
          <div class="col-md-6"><label class="form-label">Rencana tanggal kembali <span class="text-danger">*</span></label>
            <input type="date" name="tanggalRencanaKembali" id="tglKembali" class="form-control" min="<%= hariIni %>" value="<%= hariIni %>" required></div>
        </div>
        <div class="lab-sec"><i class="bi bi-chat-left-text"></i> Keperluan</div>
        <div class="row g-3">
          <div class="col-12"><label class="form-label">Keperluan <span class="text-danger">*</span></label>
            <textarea name="keperluan" class="form-control" rows="2" maxlength="500" required placeholder="Contoh: Praktikum Rangkaian Listrik modul 3"></textarea></div>
          <div class="col-12"><label class="form-label">Mata kuliah / kegiatan <span class="text-muted fw-normal">(opsional)</span></label>
            <input type="text" name="kegiatan" class="form-control" maxlength="150"></div>
        </div>
        <div class="lab-note mt-4">Anda bertanggung jawab atas alat yang dipinjam dan wajib mengembalikannya tepat waktu dalam kondisi baik. Kerusakan atau kehilangan dicatat admin saat verifikasi pengembalian.</div>
      </div>
    </div>

    <div class="lab-cartbar">
      <div><i class="bi bi-basket2 me-1"></i> Dipilih: <b id="ringkas">0 jenis alat (0 unit)</b></div>
      <button type="submit" class="btn btn-light rounded-pill px-4 fw-semibold">Kirim pengajuan</button>
    </div>
  </form>
</div>

<div class="modal fade" id="modalFoto" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2"><h6 class="modal-title" id="modalFotoNama"></h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
      <div class="modal-body p-0 text-center bg-dark"><img id="modalFotoImg" alt="" referrerpolicy="no-referrer" style="max-width:100%;max-height:75vh;"></div>
    </div>
  </div>
</div>
<script>
  (function () {
    var items = document.querySelectorAll('.alat-item'), cari = document.getElementById('cari');
    var chips = document.querySelectorAll('#chipKat .lab-chip'), kat = '';
    function ringkas() {
      var jenis = 0, unit = 0;
      document.querySelectorAll('.qty').forEach(function (i) {
        var n = parseInt(i.value, 10) || 0;
        i.closest('.tool-card').classList.toggle('selected', n > 0);
        if (n > 0) { jenis++; unit += n; }
      });
      document.getElementById('ringkas').textContent = jenis + ' jenis alat (' + unit + ' unit)';
    }
    function set(i, n) { var max = parseInt(i.max, 10) || 0; i.value = Math.max(0, Math.min(max, n || 0)); ringkas(); }
    document.querySelectorAll('.tool-card').forEach(function (c) {
      var i = c.querySelector('.qty');
      i.addEventListener('input', function () { set(i, parseInt(i.value, 10)); });
      c.querySelector('.btn-min').addEventListener('click', function () { set(i, (parseInt(i.value, 10) || 0) - 1); });
      c.querySelector('.btn-plus').addEventListener('click', function () { set(i, (parseInt(i.value, 10) || 0) + 1); });
    });
    function saring() {
      var q = cari.value.trim().toLowerCase(), tampil = 0;
      items.forEach(function (r) { var ok = (!q || r.dataset.cari.indexOf(q) > -1) && (!kat || r.dataset.kat === kat); r.style.display = ok ? '' : 'none'; if (ok) tampil++; });
      document.getElementById('kosongCari').style.display = (items.length && !tampil) ? '' : 'none';
    }
    cari.addEventListener('input', saring);
    chips.forEach(function (c) { c.addEventListener('click', function () { chips.forEach(function (x) { x.classList.remove('active'); }); c.classList.add('active'); kat = c.dataset.kat; saring(); }); });
    function buka(f) {
      document.getElementById('modalFotoImg').src = f.dataset.foto;
      document.getElementById('modalFotoNama').textContent = f.dataset.nama;
      new bootstrap.Modal(document.getElementById('modalFoto')).show();
    }
    document.querySelectorAll('.tool-photo[data-foto]').forEach(function (f) {
      f.addEventListener('click', function () { buka(f); });
      f.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); buka(f); } });
    });
    var p = document.getElementById('tglPinjam'), k = document.getElementById('tglKembali');
    p.addEventListener('change', function () { k.min = p.value; if (k.value < p.value) k.value = p.value; });
    document.getElementById('formPinjam').addEventListener('submit', function (e) {
      var ada = Array.prototype.some.call(document.querySelectorAll('.qty'), function (i) { return (parseInt(i.value, 10) || 0) > 0; });
      if (!ada) { e.preventDefault(); alert('Pilih minimal satu alat dengan jumlah lebih dari 0.'); window.scrollTo({ top: 0, behavior: 'smooth' }); }
    });
  })();
</script>
<%- include('../../partials/footer') %>
