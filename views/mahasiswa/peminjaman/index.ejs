<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  const tgl = (s) => s ? new Date(s).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
%>
<div class="container mt-4 mb-5" style="max-width: 980px;">
  <div class="lab-hero">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h2>Peminjaman Alat Lab</h2>
        <p class="lab-sub">Ajukan peminjaman, kembalikan alat, dan pantau verifikasi admin di satu tempat.</p>
      </div>
      <a href="/mahasiswa/peminjaman-alat/ajukan" class="btn btn-light rounded-pill px-4 text-nowrap"><i class="bi bi-plus-lg me-1"></i> Ajukan peminjaman</a>
    </div>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <div class="lab-stats">
    <div class="lab-stat"><b><%= stat.total %></b><small>Total pengajuan</small></div>
    <div class="lab-stat warn"><b><%= stat.menunggu %></b><small>Menunggu persetujuan</small></div>
    <div class="lab-stat"><b><%= stat.dipinjam %></b><small>Sedang dipinjam</small></div>
    <div class="lab-stat <%= stat.terlambat ? 'bad' : 'ok' %>"><b><%= stat.terlambat %></b><small>Terlambat</small></div>
  </div>

  <% if (data.length === 0) { %>
    <div class="lab-panel"><div class="lab-empty"><i class="bi bi-box-seam"></i>Belum ada peminjaman.<div class="mt-3"><a href="/mahasiswa/peminjaman-alat/ajukan" class="btn btn-primary rounded-pill px-4">Pilih alat yang ingin dipinjam</a></div></div></div>
  <% } %>

  <div class="d-grid gap-3">
    <% data.forEach(p => { %>
      <a href="/mahasiswa/peminjaman-alat/<%= p.id %>" class="lab-panel text-decoration-none text-reset d-block" style="padding:1rem 1.15rem;">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div>
            <span class="lab-code"><%= p.kode %></span>
            <div class="mt-2"><%- include('../../partials/peminjaman_status', { status: p.status, terlambat: p.terlambat }) %></div>
          </div>
          <div class="text-md-end small text-muted">
            <div>Pinjam <strong class="text-dark"><%= tgl(p.tanggalPinjam) %></strong></div>
            <div>Kembali <strong class="<%= p.terlambat ? 'text-danger' : 'text-dark' %>"><%= tgl(p.tanggalRencanaKembali) %></strong></div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
          <% p.items.slice(0, 4).forEach(it => { %>
            <% if (it.fotoUrl) { %><img class="lab-thumb" style="width:40px;height:40px;" src="<%= it.fotoUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } else { %><span class="lab-thumb no-photo" style="width:40px;height:40px;"></span><% } %>
          <% }) %>
          <span class="small text-muted ms-1"><%= p.items.map(it => it.nama + ' ×' + it.jumlah).join(', ') %></span>
        </div>
      </a>
    <% }) %>
  </div>
</div>
<%- include('../../partials/footer') %>
