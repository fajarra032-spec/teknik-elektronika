<%- include('../../partials/header') %>
<%- include('./_form_style') %>

<div class="container mt-4">
  <div class="form-card">
    <div class="form-header">
      <h3><i class="bi bi-star me-2"></i>Pengajuan Surat Rekomendasi</h3>
    </div>
    <div class="form-body">
      <form method="POST" action="/mahasiswa/persuratan/rekomendasi">
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">NIM</label>
            <input type="text" class="form-control" value="<%= user.nim %>" readonly disabled>
          </div>
          <div class="col-md-6">
            <label class="form-label">Nama</label>
            <input type="text" class="form-control" value="<%= user.nama %>" readonly disabled>
          </div>
        </div>

        <div class="mb-3">
          <label for="namaTujuan" class="form-label">Nama Beasiswa/Organisasi/Instansi Tujuan <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="namaTujuan" name="namaTujuan" placeholder="Contoh: Beasiswa PPA Kemdikbud" required>
        </div>

        <div class="mb-3">
          <label for="keperluan" class="form-label">Keperluan / Konteks Rekomendasi <span class="text-danger">*</span></label>
          <textarea class="form-control" id="keperluan" name="keperluan" rows="3" placeholder="Jelaskan untuk keperluan apa surat rekomendasi ini dibutuhkan." required></textarea>
        </div>

        <div class="row mb-3">
          <div class="col-md-4">
            <label for="ipk" class="form-label">IPK</label>
            <input type="number" step="0.01" min="0" max="4" class="form-control" id="ipk" name="ipk" placeholder="(opsional)">
          </div>
        </div>

        <div class="mb-3">
          <label for="prestasi" class="form-label">Prestasi / Kegiatan Pendukung</label>
          <textarea class="form-control" id="prestasi" name="prestasi" rows="3" placeholder="(opsional) Tuliskan satu prestasi/kegiatan per baris."></textarea>
        </div>

        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i> Surat akan diverifikasi oleh Program Studi sebelum diterbitkan.
        </div>

        <div class="d-flex justify-content-between">
          <a href="/mahasiswa/persuratan" class="btn-outline-gradient">
            <i class="bi bi-arrow-left me-2"></i>Batal
          </a>
          <button type="submit" class="btn-gradient">
            <i class="bi bi-send me-2"></i>Ajukan Surat
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
