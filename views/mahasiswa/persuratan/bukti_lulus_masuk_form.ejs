<%- include('../../partials/header') %>

<style>
.form-card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    overflow: hidden;
    max-width: 700px;
    margin: 0 auto;
  }
  .form-header {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    padding: 1.5rem;
    color: white;
  }
  .form-header h3 {
    margin: 0;
    font-weight: 600;
  }
  .form-body {
    padding: 2rem;
  }
  .btn-gradient {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    border: none;
    color: white;
    font-weight: 500;
    padding: 0.6rem 2rem;
    border-radius: 50px;
    transition: all 0.3s;
  }
  .btn-gradient:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(30,58,138,0.3);
    color: white;
  }
  .btn-outline-gradient {
    background: transparent;
    border: 2px solid #1e3a8a;
    color: #1e3a8a;
    font-weight: 500;
    padding: 0.6rem 2rem;
    border-radius: 50px;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-outline-gradient:hover {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    border-color: transparent;
    color: white;
  }
  .form-label {
    font-weight: 600;
    color: #1e293b;
  }
  .form-control, .form-select {
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid #cbd5e1;
    transition: all 0.3s;
  }
  .form-control:focus, .form-select:focus {
    border-color: #1e3a8a;
    box-shadow: 0 0 0 0.2rem rgba(30,58,138,0.25);
  }

  /* ===== RESPONSIF ===== */
  @media (max-width: 768px) {
    html { font-size: 15px; }
    .form-body { padding: 1.2rem; }
    .form-header { padding: 1.2rem; }
  }
  @media (max-width: 576px) {
    html { font-size: 14px; }
    .form-header h3 { font-size: 1.15rem; }
    .d-flex.justify-content-between { flex-direction: column; gap: 0.75rem; }
    .btn-gradient, .btn-outline-gradient { width: 100%; justify-content: center; text-align: center; }
  }
</style>

<div class="container mt-4">
  <div class="form-card">
    <div class="form-header">
      <h3><i class="bi bi-mortarboard me-2"></i>Pengajuan Surat Bukti Lulus Masuk Perguruan Tinggi</h3>
    </div>
    <div class="form-body">
      <form method="POST" action="/mahasiswa/persuratan/bukti-lulus-masuk">
        <!-- Data Mahasiswa (readonly) -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">NIM</label>
            <input type="text" class="form-control" value="<%= user.nim %>" readonly disabled>
          </div>
          <div class="col-md-6">
            <label class="form-label">Nama</label>
            <input type="text" class="form-control" value="<%= user.nama %>" readonly disabled>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Program Studi</label>
          <input type="text" class="form-control" value="Teknik Elektronika" readonly disabled>
        </div>

        <!-- Jalur Masuk & Tahun Masuk -->
        <div class="row mb-3">
          <div class="col-md-6">
            <label for="jalurMasuk" class="form-label">Jalur Masuk <span class="text-danger">*</span></label>
            <select class="form-select" id="jalurMasuk" name="jalurMasuk" required>
              <option value="" selected disabled>Pilih jalur masuk</option>
              <option value="SNBP">SNBP</option>
              <option value="SNBT">SNBT</option>
              <option value="Seleksi Mandiri">Seleksi Mandiri</option>
              <option value="Jalur Prestasi">Jalur Prestasi</option>
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="tahunMasuk" class="form-label">Tahun Masuk / Angkatan <span class="text-danger">*</span></label>
            <input type="number" class="form-control" id="tahunMasuk" name="tahunMasuk" min="2000" max="2100" value="<%= tahunMasukDefault %>" required>
          </div>
        </div>

        <div class="mb-3">
          <label for="nomorSkPenerimaan" class="form-label">Nomor SK/Bukti Penerimaan <span class="text-muted">(opsional)</span></label>
          <input type="text" class="form-control" id="nomorSkPenerimaan" name="nomorSkPenerimaan" placeholder="Isi jika Anda memiliki nomor SK/bukti kelulusan seleksi masuk">
        </div>

        <div class="mb-3">
          <label for="keperluan" class="form-label">Keperluan <span class="text-danger">*</span></label>
          <textarea class="form-control" id="keperluan" name="keperluan" rows="3" placeholder="Contoh: Untuk pengajuan KIP Kuliah, Untuk keperluan beasiswa, dll." required></textarea>
        </div>

        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i> Surat akan diproses dalam 1-2 hari kerja. Status pengajuan dapat dilihat di riwayat surat.
        </div>

        <div class="d-flex justify-content-between">
          <a href="/mahasiswa/persuratan" class="btn-outline-gradient">
            <i class="bi bi-arrow-left me-2"></i>Batal
          </a>
          <button type="submit" class="btn-gradient">
            <i class="bi bi-send me-2"></i>Ajukan Surat
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
