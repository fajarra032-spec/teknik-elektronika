<%- include('../../partials/header') %>
<%- include('./_form_style') %>

<div class="container mt-4">
  <div class="form-card">
    <div class="form-header">
      <h3><i class="bi bi-mortarboard me-2"></i>Pengajuan Surat Keterangan Lulus Sementara</h3>
    </div>
    <div class="form-body">
      <form method="POST" action="/mahasiswa/persuratan/skl-sementara">
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label">NIM</label>
            <input type="text" class="form-control" value="<%= user.nim %>" readonly disabled>
          </div>
          <div class="col-md-6">
            <label class="form-label">Nama</label>
            <input type="text" class="form-control" value="<%= user.nama %>" readonly disabled>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-md-4">
            <label for="tanggalLulus" class="form-label">Tanggal Lulus <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="tanggalLulus" name="tanggalLulus" required>
          </div>
          <div class="col-md-4">
            <label for="ipk" class="form-label">IPK <span class="text-danger">*</span></label>
            <input type="number" step="0.01" min="0" max="4" class="form-control" id="ipk" name="ipk" placeholder="Contoh: 3.55" required>
          </div>
          <div class="col-md-4">
            <label for="noSkYudisium" class="form-label">No. SK Yudisium</label>
            <input type="text" class="form-control" id="noSkYudisium" name="noSkYudisium" placeholder="(opsional)">
          </div>
        </div>

        <div class="mb-3">
          <label for="judulTA" class="form-label">Judul Tugas Akhir <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="judulTA" name="judulTA" required>
        </div>

        <div class="mb-3">
          <label for="keperluan" class="form-label">Keperluan <span class="text-danger">*</span></label>
          <textarea class="form-control" id="keperluan" name="keperluan" rows="3" placeholder="Contoh: Untuk melamar pekerjaan, sebelum ijazah asli terbit." required></textarea>
        </div>

        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i> Data kelulusan akan diverifikasi oleh Program Studi sebelum surat diterbitkan.
        </div>

        <div class="d-flex justify-content-between">
          <a href="/mahasiswa/persuratan" class="btn-outline-gradient">
            <i class="bi bi-arrow-left me-2"></i>Batal
          </a>
          <button type="submit" class="btn-gradient">
            <i class="bi bi-send me-2"></i>Ajukan Surat
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
