<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Transkrip Akademik - <%= user.nama %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
  <style>
    /* Kertas F4/Folio (ukuran umum di Indonesia) dengan margin proporsional.
       Isi transkrip dipaksa muat 1 halaman lewat JS (lihat #cetak-scale +
       script di bawah) - bukan cuma mengandalkan ukuran kertas saja, karena
       jumlah mata kuliah/semester tiap mahasiswa beda-beda. */
    @page {
      size: 215mm 330mm;
      margin: 1.2cm;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #000;
      background-color: #fff;
      font-size: 9.5pt;
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
    }

    .print-btn, .back-btn {
      margin: 20px 5px;
      font-family: Arial, sans-serif;
    }

    /* === KOP SURAT === */
    .kop-surat {
      display: flex;
      align-items: center;
      margin-bottom: 10px;
      border-bottom: 3px double #000;
      padding-bottom: 6px;
    }
    .logo-kop {
      width: 85px;
      height: auto;
      margin-right: 18px;
    }
    .teks-kop {
      flex: 1;
    }
    .teks-kop .nama-kampus {
      font-size: 24pt;
      font-weight: bold;
      margin: 0;
      color: #3b60a3;
      letter-spacing: 0.5px;
    }
    .teks-kop .alamat, .teks-kop .kontak {
      font-size: 10pt;
      margin: 2px 0;
      color: #333;
    }

    /* === JUDUL DOKUMEN === */
    .judul-dokumen {
      text-align: center;
      margin: 12px 0 12px 0;
    }
    .judul-dokumen h3 {
      font-size: 15pt;
      font-weight: bold;
      text-decoration: underline;
      margin: 0;
    }
    .judul-dokumen .subjudul {
      font-size: 10.5pt;
      font-style: italic;
      margin-top: 2px;
    }

    /* === INFO MAHASISWA (1 kolom, seperti Surat Tugas/Undangan) === */
    .info-mahasiswa {
      margin-bottom: 10px;
    }
    .info-mahasiswa table {
      border-collapse: collapse;
    }
    .info-mahasiswa td {
      padding: 2px 8px 2px 0;
      vertical-align: top;
    }
    .info-mahasiswa .label {
      width: 195px;
      font-weight: bold;
      white-space: nowrap;
    }
    .info-mahasiswa .titik-dua {
      width: 15px;
    }

    /* === TABEL NILAI === */
    .table-transkrip {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      font-size: 9pt;
    }
    .table-transkrip th, .table-transkrip td {
      border: 1px solid #000;
      padding: 4px 6px;
      vertical-align: middle;
    }
    .table-transkrip th {
      text-align: center;
      font-weight: bold;
      background-color: #f2f2f2;
    }
    .table-transkrip td.center {
      text-align: center;
    }

    tr {
      page-break-inside: avoid;
    }
    thead {
      display: table-header-group;
    }
    tfoot {
      display: table-row-group;
    }

    /* === BARIS IPK (di bawah tabel, gabung dgn baris Jumlah) === */
    .baris-ipk td {
      border: 1px solid #000;
      padding: 5px 8px;
      font-weight: bold;
    }

    /* === TANDA TANGAN === */
    .tanda-tangan-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-top: 20px;
    }
    .tanda-tangan {
      width: 300px;
      text-align: left;
    }
    .area-ttd {
      position: relative;
      height: 45px;
    }
    .img-ttd {
      position: absolute;
      top: -50px;
      left: -15px;
      height: 150px;
      width: auto;
      z-index: 10;
      mix-blend-mode: multiply;
    }
    .nama-ttd {
      font-weight: bold;
      text-decoration: underline;
      margin-bottom: 0;
      position: relative;
      z-index: 1;
    }
    .nip-ttd {
      margin-top: 0;
    }

    /* === PENGATURAN CETAK (PRINT) === */
    @media print {
      body {
        margin: 0;
      }
      .btn, .print-btn, .back-btn {
        display: none !important;
      }
      .table-transkrip th, .baris-ipk td {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .img-ttd {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }

    /* ===== Toolbar layar (tidak ikut tercetak) - konsisten dengan tombol pill di halaman lain ===== */
    .toolbar-cetak {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .btn-pill-outline {
      border: 2px solid #1e3a8a;
      color: #1e3a8a;
      background: transparent;
      border-radius: 50px;
      padding: 0.5rem 1.5rem;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.3s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-pill-outline:hover {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      border-color: transparent;
      color: white;
    }
    .btn-pill-gradient {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      border: none;
      color: white;
      font-weight: 600;
      padding: 0.5rem 1.5rem;
      border-radius: 50px;
      font-size: 0.9rem;
      transition: all 0.3s;
      box-shadow: 0 5px 15px rgba(30,58,138,0.25);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-pill-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(30,58,138,0.35);
      color: white;
    }

    /* Wrapper yang di-scale (zoom) otomatis lewat JS supaya seluruh isi
       transkrip DIPAKSA muat dalam 1 halaman F4, tidak meluber ke halaman
       ke-2, berapa pun jumlah mata kuliah/semesternya. `zoom` dipakai
       (bukan transform:scale) karena `zoom` benar-benar mengubah ukuran
       tata letak (layout box), sehingga ikut mempengaruhi perhitungan
       page-break saat cetak - transform:scale tidak begitu (ruang
       kosongnya tetap tercadang seukuran asli, bisa memicu halaman ke-2
       kosong walau isinya kelihatan sudah mengecil).
       transform-origin dipasang sebagai fallback untuk browser yang
       tidak mendukung `zoom` (mis. Firefox). */
    #cetak-scale {
      transform-origin: top left;
    }
  </style>
</head>
<body>
  <div class="container-fluid px-4 py-3">

    <div class="toolbar-cetak mb-4 border-bottom pb-3 print-btn">
      <a href="/mahasiswa/akademik/transkrip<%= semesterDipilih ? '?semester=' + encodeURIComponent(semesterDipilih) : '' %>" class="btn-pill-outline back-btn">
        <i class="bi bi-arrow-left"></i> Kembali
      </a>
      <button onclick="fitTranskripKeF4(); window.print();" class="btn-pill-gradient print-btn">
        <i class="bi bi-printer-fill"></i> Cetak Ulang
      </button>
    </div>

    <div id="cetak-scale">

    <%- include('../partials/kop_surat') %>

    <div class="judul-dokumen">
      <h3>TRANSKRIP AKADEMIK</h3>
      <div class="subjudul">ACADEMIC TRANSCRIPT</div>
    </div>

    <div class="info-mahasiswa">
      <table>
        <tr>
          <td class="label">NAMA</td>
          <td class="titik-dua">:</td>
          <td><%= user.nama || '-' %></td>
        </tr>
        <tr>
          <td class="label">Tempat, Tanggal Lahir</td>
          <td class="titik-dua">:</td>
          <td><%= user.tempatLahir ? (user.tempatLahir + (user.tanggalLahir ? ', ' + user.tanggalLahir : '')) : '-' %></td>
        </tr>
        <tr>
          <td class="label">Nomor Induk Mahasiswa</td>
          <td class="titik-dua">:</td>
          <td><%= user.nim || '-' %></td>
        </tr>
        <tr>
          <td class="label">Program Studi</td>
          <td class="titik-dua">:</td>
          <td>D3 Teknik Elektronika</td>
        </tr>
        <tr>
          <td class="label">Angkatan</td>
          <td class="titik-dua">:</td>
          <td><%= angkatan || '-' %></td>
        </tr>
      </table>
    </div>

    <table class="table-transkrip">
      <thead>
        <tr>
          <th rowspan="2" width="4%">No</th>
          <th rowspan="2" width="10%">Kode MK</th>
          <th rowspan="2" width="30%">Mata Kuliah</th>
          <th rowspan="2" width="8%">Bobot<br>SKS</th>
          <th colspan="3">Nilai</th>
          <th rowspan="2" width="9%">SKS<br>Indeks</th>
        </tr>
        <tr>
          <th width="9%">Angka</th>
          <th width="8%">Huruf</th>
          <th width="8%">Indeks</th>
        </tr>
      </thead>
      <tbody>
        <% if (grades && grades.length > 0) { %>
          <% grades.forEach((g, index) => { %>
          <tr>
            <td class="center"><%= index + 1 %></td>
            <td class="center"><%= g.kodeMk || '-' %></td>
            <td><%= g.namaMk || '-' %></td>
            <td class="center"><%= typeof g.sks === 'number' ? g.sks.toFixed(2) : '-' %></td>
            <% if (g.belumAdaNilai) { %>
              <td class="center" colspan="4" style="font-style: italic; color: #666;">Belum Ada Nilai</td>
            <% } else { %>
              <td class="center"><%= g.nilai ?? '-' %></td>
              <td class="center"><%= g.huruf || '-' %></td>
              <td class="center"><%= typeof g.indeks === 'number' ? g.indeks.toFixed(1) : '-' %></td>
              <td class="center"><%= typeof g.sksIndeks === 'number' ? g.sksIndeks.toFixed(2) : '-' %></td>
            <% } %>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; font-style: italic; padding: 15px;">Belum ada nilai yang tercatat.</td>
          </tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="text-align: right; font-weight: bold;">Jumlah</td>
          <td class="center" style="font-weight: bold;"><%= totalSKS !== undefined ? totalSKS.toFixed(2) : '-' %></td>
          <td colspan="3"></td>
          <td class="center" style="font-weight: bold;"><%= totalSksIndeks !== undefined ? totalSksIndeks.toFixed(2) : '-' %></td>
        </tr>
        <tr class="baris-ipk">
          <td colspan="7" style="text-align: right;">IPK ( Indeks Prestasi Komulatif )</td>
          <td class="center"><%= ipk !== undefined ? ipk : '-' %></td>
        </tr>
      </tfoot>
    </table>

    <div class="tanda-tangan-wrapper">
      <div class="tanda-tangan">
        <p style="position: relative; z-index: 1; margin: 0;">Palopo, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %><br>Ketua Program Studi Teknik Elektronika</p>
        <div class="area-ttd">
          <img src="/images/ttd.png" alt="Tanda Tangan Kaprodi" class="img-ttd">
        </div>
        <p class="nama-ttd">Fajar Ramadhan, S.Pd., M.T.</p>
        <p class="nip-ttd">NUPTK. 8559777678130153</p>
      </div>
    </div>

    </div><!-- /#cetak-scale -->

  </div>

  <script>
    /**
     * Paksa isi transkrip (#cetak-scale) muat dalam SATU halaman F4 dengan
     * mengecilkan `zoom` secara proporsional kalau kontennya lebih tinggi
     * dari area cetak - supaya tidak pernah meluber ke halaman ke-2,
     * berapa pun jumlah mata kuliah/semester yang dimuat.
     */
    function fitTranskripKeF4() {
      var wrapper = document.getElementById('cetak-scale');
      if (!wrapper) return;

      // Reset dulu supaya pengukuran scrollHeight selalu dari ukuran asli
      // (100%), bukan dari hasil zoom sebelumnya (penting kalau fungsi ini
      // dipanggil ulang, mis. tombol "Cetak Ulang" ditekan lagi).
      wrapper.style.zoom = 1;
      wrapper.style.transform = 'none';

      // Ukur tinggi area cetak F4 yang sebenarnya (330mm dikurangi margin
      // atas+bawah @page 1.2cm x2) dengan elemen referensi tersembunyi,
      // supaya konversi mm->px SELALU akurat di device/browser mana pun
      // (tidak menebak 96dpi secara manual yang bisa meleset).
      var ref = document.createElement('div');
      ref.style.position = 'absolute';
      ref.style.visibility = 'hidden';
      ref.style.height = '305.6mm'; // 330mm - (1.2cm margin atas + bawah)
      ref.style.width = '0';
      document.body.appendChild(ref);
      var tinggiHalamanPx = ref.offsetHeight;
      document.body.removeChild(ref);

      var tinggiKontenPx = wrapper.scrollHeight;

      if (tinggiKontenPx > tinggiHalamanPx) {
        // Beri sedikit ruang aman (2%) supaya tidak pas-pasan/terpotong
        // akibat pembulatan render browser.
        var skala = (tinggiHalamanPx / tinggiKontenPx) * 0.98;
        if (typeof wrapper.style.zoom !== 'undefined') {
          wrapper.style.zoom = skala;
        } else {
          // Fallback untuk browser yang tidak kenal `zoom` (mis. Firefox):
          // transform:scale tidak seideal `zoom` untuk print, tapi lebih
          // baik daripada terpotong sama sekali.
          wrapper.style.transform = 'scale(' + skala + ')';
        }
      }
    }

    // Langsung buka dialog cetak begitu halaman & gambar (kop/ttd) selesai
    // dimuat, setelah dipaksa fit ke 1 halaman F4 - tanpa perlu klik
    // tombol "Cetak" terlebih dahulu.
    window.addEventListener('load', function () {
      setTimeout(function () {
        fitTranskripKeF4();
        window.print();
      }, 250);
    });
  </script>
</body>
</html>
