<%- include('../partials/header') %>

<style>
  /* ===== VARIABEL WARNA (sesuai navbar & halaman akademik lain) ===== */
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
    --success-text: #198754;
    --danger-text: #dc3545;
    --font-base: 16px;
  }

  html {
    font-size: 16px;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background-color: #f8fafc;
  }

  /* ===== PAGE HEADER ===== */
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 1.5rem 2rem;
    color: white;
    margin-bottom: 1.5rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .page-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    transform: rotate(25deg);
  }
  .page-header h2 {
    font-weight: 700;
    margin: 0;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 2rem;
  }
  .page-header p {
    margin: 0.3rem 0 0 0;
    position: relative;
    z-index: 1;
    opacity: 0.9;
    font-size: 0.9rem;
  }
  .page-header .semester-badge {
    background: white;
    color: var(--primary-start);
    border-radius: 50px;
    padding: 0.5rem 1.2rem;
    font-weight: 600;
    font-size: 0.9rem;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    white-space: nowrap;
  }

  /* ===== KARTU INFO / FORM ===== */
  .form-card {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    padding: 1.8rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(30,58,138,0.1);
  }
  .form-card label.form-label {
    font-weight: 600;
    color: #1e293b;
  }

  .info-semester {
    background: var(--primary-light);
    border-left: 4px solid var(--primary-start);
    color: var(--primary-dark);
    padding: 1rem 1.2rem;
    margin-bottom: 1.5rem;
    border-radius: 0.8rem;
    font-size: 0.9rem;
  }

  .recommended-badge {
    background: #16a34a;
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
    margin-left: 0.5rem;
    white-space: nowrap;
  }

  /* ===== PENCARIAN ===== */
  .search-box {
    border-radius: 50px;
    border: 1px solid #dee2e6;
    padding: 0.6rem 1.2rem;
    transition: all 0.2s;
  }
  .search-box:focus {
    border-color: var(--primary-end);
    box-shadow: 0 0 0 0.25rem rgba(30,58,138,0.15);
  }

  /* ===== DAFTAR MATA KULIAH ===== */
  #courseList {
    max-height: 480px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }
  .course-item {
    border: 1px solid #e5e7eb;
    border-radius: 0.9rem;
    padding: 0.85rem 1.1rem;
    margin-bottom: 0.6rem;
    transition: all 0.2s;
    position: relative;
    cursor: pointer;
  }
  .course-item:hover {
    background-color: #f2f6ff;
    border-color: var(--primary-end);
  }
  .course-item.selected {
    background-color: rgba(59,130,246,0.08);
    border-color: var(--primary-start);
    box-shadow: 0 4px 10px rgba(30,58,138,0.1);
  }
  .course-item .kode-mk {
    color: var(--primary-start);
    font-weight: 700;
  }
  .course-item .badge-sks {
    background: var(--primary-light);
    color: var(--primary-start);
    font-weight: 600;
    border-radius: 50px;
    padding: 0.25rem 0.7rem;
    font-size: 0.75rem;
    margin-left: 0.5rem;
  }
  .form-check-input:checked {
    background-color: var(--primary-start);
    border-color: var(--primary-start);
  }
  .form-check-input:focus {
    box-shadow: 0 0 0 0.2rem rgba(30,58,138,0.2);
  }

  /* ===== RINGKASAN SKS (sticky di bawah daftar) ===== */
  .sks-summary {
    background: #f8fafc;
    border-radius: 1rem;
    padding: 1rem 1.3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 1px solid rgba(30,58,138,0.1);
  }
  .sks-summary .sks-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--primary-start);
    transition: color 0.2s;
  }
  .sks-summary .sks-value.over-limit {
    color: var(--danger-text);
  }
  .sks-summary .sks-max {
    color: #64748b;
    font-size: 0.85rem;
  }

  /* ===== TOMBOL ===== */
  .btn-gradient {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border: none;
    color: white;
    font-weight: 600;
    padding: 0.65rem 2rem;
    border-radius: 50px;
    transition: all 0.3s;
    box-shadow: 0 5px 15px rgba(30,58,138,0.2);
  }
  .btn-gradient:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(30,58,138,0.4);
    color: white;
  }
  .btn-gradient:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    box-shadow: none;
  }
  .btn-batal {
    border-radius: 50px;
    padding: 0.65rem 2rem;
    font-weight: 600;
    border: 2px solid #dee2e6;
    color: #64748b;
    background: white;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-batal:hover {
    border-color: #94a3b8;
    color: #1e293b;
  }

  /* ===== EMPTY STATE ===== */
  .empty-state {
    padding: 3rem 2rem;
    text-align: center;
    background: #f8f9fa;
    border-radius: 1.2rem;
  }
  .empty-state i {
    font-size: 3.5rem;
    color: #adb5bd;
    margin-bottom: 1rem;
  }

  /* ===== RESPONSIF ===== */
  @media (max-width: 768px) {
    html { font-size: 15px; }
    .page-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .page-header h2 { font-size: 1.6rem; }
    .form-card { padding: 1.2rem; }
    #courseList { max-height: 380px; }
    .course-item { padding: 0.7rem 0.9rem; }
  }

  @media (max-width: 576px) {
    html { font-size: 14px; }
    .page-header h2 { font-size: 1.4rem; }
    .btn-gradient, .btn-batal { padding: 0.55rem 1.4rem; font-size: 0.85rem; width: 100%; text-align: center; }
    .d-flex.gap-3 { flex-direction: column; }
    .sks-summary { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 400px) {
    html { font-size: 13px; }
    .page-header h2 { font-size: 1.2rem; }
  }
</style>

<div class="container mt-4">
  <!-- Page Header -->
  <div class="page-header">
    <div>
      <h2><i class="bi bi-file-earmark-plus"></i> Buat KRS Baru</h2>
      <p>Semester aktif: <strong><%= academicLabel %></strong></p>
    </div>
    <div class="semester-badge">
      <i class="bi bi-calendar3"></i> Semester <%= currentSemester %>
    </div>
  </div>

  <div class="form-card">
    <!-- Informasi tambahan -->
    <div class="info-semester">
      <i class="bi bi-info-circle me-2"></i>
      Berdasarkan angkatan Anda, saat ini Anda berada di semester <strong><%= currentSemester %></strong><% if (kelasMahasiswa) { %> - Kelas <strong><%= kelasMahasiswa %></strong><% } %>.
      Mata kuliah yang diberi label <span class="recommended-badge">Rekomendasi</span> adalah paket semester ini.
      <% if (kelasMahasiswa) { %>
        Untuk mata kuliah yang dipecah per kelas paralel, daftar di bawah hanya menampilkan yang sesuai dengan kelas Anda.
      <% } %>
    </div>

    <% if (!kelasMahasiswa) { %>
      <div class="info-semester" style="background:#fef3c7;border-left-color:#d97706;color:#92400e;">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Data "Kelas" pada profil Anda belum diisi, sehingga mata kuliah yang dipecah per kelas paralel
        (mis. dosen/jadwal berbeda per kelas) belum bisa ditampilkan. Hubungi admin/Program Studi untuk
        melengkapi data kelas Anda.
      </div>
    <% } %>

    <form id="krsForm" method="POST" action="/mahasiswa/akademik/krs">
      <!-- Semester sudah ditentukan, dikirim sebagai hidden -->
      <input type="hidden" name="semester" value="<%= academicLabel %>">

      <div class="mb-4">
        <label class="form-label" for="searchCourse"><i class="bi bi-search me-1"></i>Cari Mata Kuliah</label>
        <input type="text" class="form-control search-box" id="searchCourse" placeholder="Ketik kode atau nama mata kuliah...">
      </div>

      <div class="mb-4">
        <label class="form-label"><i class="bi bi-list-check me-1"></i>Daftar Mata Kuliah</label>
        <div id="courseList">
          <% if (courses && courses.length > 0) { %>
            <% courses.forEach(course => { %>
              <label class="course-item d-block" data-id="<%= course.id %>" data-kode="<%= course.kode %>" data-nama="<%= course.nama %>" data-sks="<%= course.sks %>">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <span class="kode-mk"><%= course.kode %></span> - <%= course.nama %>
                    <span class="badge-sks"><%= course.sks %> SKS</span>
                    <% if (course.kelas) { %>
                      <span class="badge-sks" style="background:#eef2ff;color:#4338ca;">Kelas <%= course.kelas %></span>
                    <% } %>
                    <% if (course.isRecommended) { %>
                      <span class="recommended-badge">Rekomendasi</span>
                    <% } %>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input course-checkbox" type="checkbox" value="<%= course.id %>">
                  </div>
                </div>
              </label>
            <% }) %>
          <% } else { %>
            <div class="empty-state">
              <i class="bi bi-inbox"></i>
              <p class="text-muted mb-0">Tidak ada mata kuliah tersedia.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="mb-4">
        <div class="sks-summary">
          <span class="fw-semibold text-dark">Total SKS Dipilih: <span class="sks-value" id="totalSks">0</span></span>
          <span class="sks-max">Maksimal 24 SKS</span>
        </div>
      </div>

      <input type="hidden" name="courses" id="selectedCourses" required>

      <div class="d-flex gap-3">
        <button type="submit" class="btn-gradient" id="submitBtn" disabled>
          <i class="bi bi-save me-2"></i>Simpan KRS
        </button>
        <a href="/mahasiswa/akademik/krs" class="btn-batal">Batal</a>
      </div>
    </form>
  </div>
</div>

<script>
  // Pencarian mata kuliah
  const searchInput = document.getElementById('searchCourse');
  const courseItems = document.querySelectorAll('.course-item');
  searchInput.addEventListener('keyup', function () {
    const keyword = this.value.toLowerCase();
    courseItems.forEach(item => {
      const kode = item.dataset.kode.toLowerCase();
      const nama = item.dataset.nama.toLowerCase();
      item.style.display = (kode.includes(keyword) || nama.includes(keyword)) ? 'block' : 'none';
    });
  });

  // Hitung total SKS
  const checkboxes = document.querySelectorAll('.course-checkbox');
  const totalSpan = document.getElementById('totalSks');
  const selectedCoursesInput = document.getElementById('selectedCourses');
  const submitBtn = document.getElementById('submitBtn');
  const MAKS_SKS = 24;

  function updateTotal() {
    let total = 0;
    const selected = [];
    checkboxes.forEach(cb => {
      if (cb.checked) {
        const sks = parseInt(cb.closest('.course-item').dataset.sks);
        total += sks;
        selected.push(cb.value);
      }
    });
    totalSpan.textContent = total;
    totalSpan.classList.toggle('over-limit', total > MAKS_SKS);
    selectedCoursesInput.value = JSON.stringify(selected);

    // Aktifkan tombol jika ada mata kuliah dipilih (semester sudah otomatis terisi)
    submitBtn.disabled = selected.length === 0;
  }

  checkboxes.forEach(cb => cb.addEventListener('change', updateTotal));

  // Styling item yang dipilih
  checkboxes.forEach(cb => {
    cb.addEventListener('change', function () {
      const item = this.closest('.course-item');
      item.classList.toggle('selected', this.checked);
    });
  });
</script>

<%- include('../partials/footer') %>
