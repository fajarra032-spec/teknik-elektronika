<%- include('../../partials/header') %>

<style>
  :root { --primary-start:#1e3a8a; --primary-end:#3b82f6; }
  .edm-wrap{max-width:980px;margin:0 auto}
  .edm-head{background:linear-gradient(135deg,var(--primary-start),var(--primary-end));color:#fff;border-radius:1.2rem;padding:1.3rem 1.5rem;margin-bottom:1rem;box-shadow:0 8px 22px rgba(30,58,138,.18)}
  .edm-head h4{font-weight:800;margin:0 0 .25rem;font-size:1.35rem}
  .edm-head p{margin:0;opacity:.92;font-size:.9rem}
  .edm-info{background:#fef9e3;border-left:5px solid #eab308;border-radius:.9rem;padding:.7rem 1rem;margin-bottom:1rem;font-size:.85rem;color:#854d0e;display:flex;gap:.6rem;align-items:flex-start}
  .edm-info i{font-size:1.15rem;line-height:1.2}
  .edm-guide{background:#eef2ff;border-radius:.9rem;padding:.7rem 1rem;margin-bottom:1rem;font-size:.85rem;color:#1e3a8a;display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:center}
  .edm-guide b.n{display:inline-flex;width:1.5rem;height:1.5rem;border-radius:50%;background:#fff;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(0,0,0,.12);margin-right:.3rem}
  .edm-dosen{background:#fff;border:1px solid #e2e8f0;border-radius:.9rem;padding:.9rem 1rem;margin-bottom:1rem}
  .edm-card{background:#fff;border:1px solid #e2e8f0;border-radius:1rem;overflow:hidden;margin-bottom:1rem}
  .edm-group{background:#1e3a8a;color:#fff;font-weight:700;font-size:.82rem;letter-spacing:.6px;text-transform:uppercase;padding:.5rem 1rem}
  .edm-row{display:grid;grid-template-columns:1fr auto;gap:.5rem 1rem;align-items:center;padding:.65rem 1rem;border-bottom:1px solid #f1f5f9;border-left:4px solid transparent;transition:background .15s}
  .edm-row:last-child{border-bottom:none}
  .edm-row:hover{background:#f8fbff}
  .edm-row.done{border-left-color:#16a34a}
  .edm-row.missing{border-left-color:#dc2626;background:#fef2f2}
  .edm-q{display:flex;gap:.6rem;align-items:flex-start;color:#1e293b;font-weight:500}
  .edm-no{flex:none;min-width:1.6rem;height:1.6rem;border-radius:50%;background:#e0e7ff;color:#1e3a8a;font-size:.78rem;font-weight:800;display:inline-flex;align-items:center;justify-content:center}
  .edm-opts{display:flex;gap:.45rem}
  .edm-opt{position:relative;margin:0;cursor:pointer}
  .edm-opt input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer;margin:0}
  .edm-dot{display:inline-flex;width:2.6rem;height:2.6rem;border-radius:50%;border:2px solid #cbd5e1;background:#fff;color:#64748b;font-weight:700;align-items:center;justify-content:center;transition:all .12s}
  .edm-opt:hover .edm-dot{border-color:#3b82f6;color:#1e3a8a}
  .edm-opt input:checked + .edm-dot{background:linear-gradient(135deg,var(--primary-start),var(--primary-end));border-color:transparent;color:#fff;transform:scale(1.08);box-shadow:0 3px 8px rgba(30,58,138,.3)}
  .edm-opt input:focus-visible + .edm-dot{outline:3px solid #93c5fd;outline-offset:2px}
  .edm-text{padding:1rem}
  .edm-text label{font-weight:700;color:#1e293b;margin-bottom:.4rem;display:block}
  .edm-bar{position:sticky;bottom:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);border-top:1px solid #e2e8f0;border-radius:1rem 1rem 0 0;padding:.7rem 1rem;display:flex;gap:1rem;align-items:center;justify-content:space-between;box-shadow:0 -6px 18px rgba(0,0,0,.06);margin-top:1rem}
  .edm-prog{flex:1;min-width:0}
  .edm-prog .t{font-size:.82rem;color:#475569;margin-bottom:.25rem;font-weight:600}
  .edm-prog .b{height:.5rem;background:#e2e8f0;border-radius:1rem;overflow:hidden}
  .edm-prog .b span{display:block;height:100%;width:0;background:linear-gradient(90deg,#3b82f6,#16a34a);border-radius:1rem;transition:width .2s}
  .btn-submit{background:linear-gradient(105deg,var(--primary-start),var(--primary-end));border:none;border-radius:60px;padding:.6rem 1.8rem;font-weight:700;color:#fff;white-space:nowrap}
  .btn-submit:hover{color:#fff;filter:brightness(1.08)}
  @media(max-width:640px){
    .edm-row{grid-template-columns:1fr}
    .edm-opts{justify-content:space-between;padding-left:2.2rem}
    .edm-dot{width:2.5rem;height:2.5rem}
    .edm-head{padding:1rem}
    .edm-bar{flex-wrap:wrap}
    .btn-submit{width:100%}
  }
</style>

<div class="container mt-4 edm-wrap">
  <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-<%= message.type === 'success' ? 'success' : (message.type === 'error' ? 'danger' : 'info') %> alert-dismissible fade show">
      <%= message.text %><button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <%
    const ratingQuestions = questions.filter(q => q.tipe === 'rating');
    const textQuestions = questions.filter(q => q.tipe === 'text');
    const skala = ratingQuestions.length ? (ratingQuestions[0].skala || 5) : 5;
    const labelSkala = { 1: 'Sangat Tidak Sesuai', 2: 'Tidak Sesuai', 3: 'Kurang Sesuai', 4: 'Sesuai', 5: 'Sangat Sesuai' };
  %>

  <div class="edm-head">
    <h4><i class="bi bi-pencil-square me-2"></i>Evaluasi Dosen: <%= mk.kode %> - <%= mk.nama %></h4>
    <p>Periode: <%= activePeriod.nama %> (sampai <%= activePeriod.tanggalSelesai %>)</p>
  </div>

  <div class="edm-info">
    <i class="bi bi-shield-lock-fill"></i>
    <span><strong>Identitas Anda dirahasiakan.</strong> Isilah sesuai dosen yang mengajar Anda, dengan jujur sesuai pengalaman selama perkuliahan.</span>
  </div>

  <div class="edm-guide">
    <span><i class="bi bi-info-circle-fill"></i> <strong>Skala:</strong></span>
    <% for (let i = 1; i <= skala; i++) { %>
      <span><b class="n"><%= i %></b><%= labelSkala[i] || '' %></span>
    <% } %>
  </div>

  <form method="POST" action="/mahasiswa/edom/mk/<%= mkId %>" id="edomForm" novalidate>
    <div class="edm-dosen">
      <label class="form-label fw-bold mb-1">Dosen yang dievaluasi <span class="text-danger">*</span></label>
      <select name="dosenId" id="dosenId" class="form-select" required>
        <% if (dosenList.length !== 1) { %><option value="">-- Pilih Dosen --</option><% } %>
        <% dosenList.forEach(d => { %>
          <option value="<%= d.id %>" <%= dosenList.length === 1 ? 'selected' : '' %>><%= d.nama %></option>
        <% }) %>
      </select>
      <% if (dosenList.length > 1) { %><small class="text-muted">Mata kuliah ini diampu lebih dari satu dosen, pilih dosen yang akan dievaluasi.</small><% } %>
    </div>

    <% if (ratingQuestions.length) { let no = 0; let grupSebelumnya = null; %>
      <div class="edm-card">
        <% ratingQuestions.forEach(q => { no++;
             const grup = q.indikator || null;
             if (grup && grup !== grupSebelumnya) { grupSebelumnya = grup; %>
          <div class="edm-group"><%= grup %></div>
        <% } %>
          <div class="edm-row" data-row="<%= q.id %>">
            <div class="edm-q"><span class="edm-no"><%= no %></span><span><%= q.pertanyaan %></span></div>
            <div class="edm-opts" role="radiogroup" aria-label="Nilai untuk pernyataan <%= no %>">
              <% for (let i = 1; i <= skala; i++) { %>
                <label class="edm-opt" title="<%= i %> - <%= labelSkala[i] || '' %>">
                  <input type="radio" name="nilai_<%= q.id %>" value="<%= i %>">
                  <span class="edm-dot"><%= i %></span>
                </label>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (textQuestions.length) { %>
      <div class="edm-card">
        <div class="edm-group">Umpan Balik Mahasiswa</div>
        <div class="edm-text row g-3">
          <% textQuestions.forEach(q => { %>
            <div class="col-md-6">
              <label for="t_<%= q.id %>"><%= q.pertanyaan %> <span class="text-danger">*</span></label>
              <textarea id="t_<%= q.id %>" name="jawaban_teks_<%= q.id %>" class="form-control" rows="4" placeholder="Tulis jawaban Anda di sini..."></textarea>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="edm-bar">
      <div class="edm-prog">
        <div class="t"><span id="terisi">0</span> dari <span id="total"><%= ratingQuestions.length %></span> pernyataan terisi</div>
        <div class="b"><span id="progBar"></span></div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/mahasiswa/edom" class="btn btn-outline-secondary rounded-pill px-4">Batal</a>
        <button type="submit" class="btn btn-submit px-4">Kirim Evaluasi</button>
      </div>
    </div>
  </form>
</div>

<script>
  (function () {
    const form = document.getElementById('edomForm');
    const rows = Array.from(document.querySelectorAll('.edm-row'));
    const total = rows.length;

    function terisi(row) { return !!row.querySelector('input[type=radio]:checked'); }
    function perbarui() {
      let n = 0;
      rows.forEach(r => { const ok = terisi(r); r.classList.toggle('done', ok); if (ok) { n++; r.classList.remove('missing'); } });
      document.getElementById('terisi').textContent = n;
      document.getElementById('progBar').style.width = (total ? n / total * 100 : 0) + '%';
    }
    form.addEventListener('change', perbarui);
    perbarui();

    form.addEventListener('submit', function (e) {
      const dosen = document.getElementById('dosenId');
      if (!dosen.value) { e.preventDefault(); alert('Silakan pilih dosen yang akan dievaluasi.'); dosen.focus(); return; }

      const kosong = rows.filter(r => !terisi(r));
      rows.forEach(r => r.classList.toggle('missing', kosong.includes(r)));
      if (kosong.length) {
        e.preventDefault();
        kosong[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
        alert('Masih ada ' + kosong.length + ' pernyataan yang belum dinilai (ditandai merah).');
        return;
      }

      const tas = Array.from(form.querySelectorAll('textarea'));
      const tKosong = tas.find(t => !t.value.trim());
      if (tKosong) { e.preventDefault(); alert('Harap isi semua jawaban umpan balik (bertanda *).'); tKosong.focus(); return; }

      if (!confirm('Pastikan semua penilaian sudah sesuai. Kirim evaluasi?')) e.preventDefault();
    });
  })();
</script>

<%- include('../../partials/footer') %>
