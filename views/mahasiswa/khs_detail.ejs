<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>KHS <%= khs.semester %> - <%= user.nama %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
  <style>
    /* =========================================================
       KERTAS A4 — atas-bawah 1cm, kiri-kanan 2cm
       ========================================================= */
    @page {
      size: A4;
      margin: 1cm 2cm;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Times New Roman', Times, serif;
      color: #111;
      background-color: #fff;
      font-size: 10pt;
      line-height: 1.4;
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
    }

    /* ================= KOP SURAT ================= */
    .kop-surat {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 3px double #000;
    }
    .logo-kop { width: 74px; height: auto; flex: 0 0 auto; }
    .teks-kop {
      flex: 1;
      font-family: Arial, Helvetica, sans-serif;
      text-align: left;
      line-height: 1.28;
      padding-left: 4px;
    }
    .teks-kop .nama-kampus {
      font-size: 17pt;
      font-weight: bold;
      margin: 0 0 3px;
      color: #2b4d8f;
      letter-spacing: .5px;
      text-transform: uppercase;
    }
    .teks-kop .alamat,
    .teks-kop .kontak { font-size: 9pt; margin: 0; color: #333; }
    .teks-kop .kontak { margin-top: 2px; }

    /* ================= JUDUL DOKUMEN ================= */
    .judul-dokumen {
      text-align: center;
      margin: 12px 0 14px;
      font-size: 13pt;
      font-weight: bold;
      text-decoration: underline;
      letter-spacing: .8px;
    }
    .judul-dokumen .subjudul {
      display: block;
      font-size: 9.5pt;
      font-style: italic;
      font-weight: normal;
      text-decoration: none;
      letter-spacing: .5px;
      margin-top: 2px;
      color: #444;
    }

    /* ================= INFO MAHASISWA ================= */
    .info-container {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
    }
    .info-table {
      font-size: 9.5pt;
      border-collapse: collapse;
      table-layout: auto;
    }
    .info-table td {
      padding: 2px 6px 2px 0;
      vertical-align: top;
      text-transform: uppercase;
    }
    .info-table td.label { white-space: nowrap; }
    .info-table td.titik-dua { width: 12px; text-align: center; }
    .info-table td.nilai { white-space: nowrap; }
    .info-container > table:last-child { flex-shrink: 0; }

    /* garis pemisah tipis antar bagian */
    .garis-pemisah {
      border: 0;
      border-top: 1.2px solid #000;
      margin: 12px 0;
    }

    /* ================= TABEL KHS ================= */
    .table-khs {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 10px;
      font-size: 8.5pt;
    }
    .table-khs th,
    .table-khs td {
      border: 1px solid #000;
      padding: 4px 6px;
      vertical-align: middle;
    }
    .table-khs th {
      text-align: center;
      font-weight: bold;
      background-color: #f2f2f2;
      letter-spacing: .2px;
    }
    .table-khs td.center { text-align: center; }
    .table-khs tfoot td { background-color: #f8fafc; }

    tr { page-break-inside: avoid; }
    thead { display: table-header-group; }
    tfoot { display: table-row-group; }

    /* ================= RINGKASAN IPS ================= */
    .ringkasan-container {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 12px;
    }
    .ringkasan-table {
      font-size: 9.5pt;
      width: 45%;
      border-collapse: collapse;
    }
    .ringkasan-table td {
      padding: 5px 8px;
      border: 1px solid #000;
      background-color: #f8fafc;
    }
    .ringkasan-table td.label { font-weight: bold; }
    .ringkasan-table td.nilai {
      text-align: center;
      font-weight: bold;
      font-size: 11pt;
    }

    /* ================= TANDA TANGAN ================= */
    .tanda-tangan-container {
      display: flex;
      justify-content: flex-end;
      margin-top: 18px;
      font-size: 9.5pt;
      break-inside: avoid;
    }
    .kolom-tanda {
      width: 280px;
      text-align: left;
    }
    .kolom-tanda .info-ttd {
      margin: 0;
      line-height: 1.45;
    }
    .area-ttd { position: relative; height: 42px; }
    .img-ttd {
      position: absolute;
      top: -46px;
      left: -15px;
      height: 130px;
      width: auto;
      z-index: 10;
      mix-blend-mode: multiply;
    }
    .nama-ttd {
      margin: 0;
      font-weight: bold;
      text-decoration: underline;
      letter-spacing: .3px;
      position: relative;
      z-index: 1;
    }
    .nip-ttd { margin: 2px 0 0; }

    /* =========================================================
       FOOTER DOKUMEN RESMI
       ========================================================= */
    .dokumen-footer {
      margin-top: 22px;
      padding-top: 8px;
      border-top: 1px dashed #999;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 7.5pt;
      color: #555;
      line-height: 1.4;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      break-inside: avoid;
    }
    .dokumen-footer .footer-left {
      flex: 1;
      min-width: 0;
    }
    .dokumen-footer .footer-left .baris-1 {
      display: flex;
      align-items: center;
      gap: 5px;
      font-weight: 600;
      color: #1e3a8a;
      margin-bottom: 2px;
    }
    .dokumen-footer .footer-left .baris-1 .check {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #1e3a8a;
      color: #fff;
      font-size: 7pt;
      line-height: 1;
      font-weight: bold;
      flex-shrink: 0;
    }
    .dokumen-footer .footer-left .baris-2 {
      color: #444;
      margin-bottom: 1px;
    }
    .dokumen-footer .footer-left .baris-2 em {
      font-style: italic;
      color: #1e3a8a;
      font-weight: 600;
    }
    .dokumen-footer .footer-left .baris-3 {
      color: #666;
      font-style: italic;
    }
    .dokumen-footer .footer-right {
      text-align: right;
      flex-shrink: 0;
      font-size: 7pt;
      color: #666;
      line-height: 1.45;
    }
    .dokumen-footer .footer-right .kode {
      font-family: 'Courier New', monospace;
      font-weight: bold;
      color: #1e3a8a;
      letter-spacing: .5px;
      font-size: 7.5pt;
    }

    /* =========================================================
       PREVIEW BAR + PAPER
       ========================================================= */
    .preview-section {
      max-width: 21cm;
      margin: 2rem auto 2rem;
    }
    .preview-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: .75rem;
      margin-bottom: 1rem;
      padding-bottom: .75rem;
      border-bottom: 2px solid #e2e8f0;
    }
    .preview-header-bar h5 {
      margin: 0;
      font-weight: 600;
      color: #1e3a8a;
      display: flex;
      align-items: center;
      gap: .5rem;
      font-family: Arial, sans-serif;
    }
    .preview-header-bar .btn-ghost {
      background: transparent;
      border: 2px solid #1e3a8a;
      color: #1e3a8a;
      border-radius: 50px;
      padding: .4rem 1.1rem;
      font-weight: 600;
      font-size: .85rem;
      transition: all .3s;
      font-family: Arial, sans-serif;
      cursor: pointer;
    }
    .preview-header-bar .btn-ghost:hover {
      background: #1e3a8a;
      color: #fff;
    }
    .preview-header-bar .btn-ghost.primary {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      border: none;
      color: #fff;
      box-shadow: 0 5px 15px rgba(30,58,138,0.25);
    }
    .preview-header-bar .btn-ghost.primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(30,58,138,0.35);
    }

    .preview-paper {
      background: #fff;
      max-width: 21cm;
      min-height: 29.7cm;
      margin: 0 auto;
      padding: 1cm 2cm;
      box-shadow: 0 6px 24px rgba(15, 23, 42, 0.12);
      border-radius: 2px;
      position: relative;
    }

    /* ================= PRINT ================= */
    @media print {
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        background: #fff !important;
        height: auto;
      }

      .toolbar-cetak,
      .preview-header-bar,
      .btn, .print-btn, .back-btn,
      header, footer, nav {
        display: none !important;
      }

      .preview-section { margin: 0 !important; max-width: none !important; }
      .preview-paper {
        box-shadow: none !important;
        margin: 0 !important;
        padding: 0 !important;
        max-width: none !important;
        min-height: 0 !important;
        border-radius: 0 !important;
      }

      .table-khs th,
      .table-khs tfoot td,
      .ringkasan-table td,
      .img-ttd,
      .dokumen-footer .footer-left .baris-1 .check {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .tanda-tangan-container,
      #cetak-scale > *:last-child { margin-bottom: 0 !important; }

      #cetak-scale {
        page-break-inside: avoid;
        page-break-after: avoid;
      }
    }

    /* ================= TOOLBAR LAYAR ================= */
    .toolbar-cetak {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .btn-pill-outline {
      border: 2px solid #1e3a8a;
      color: #1e3a8a;
      background: transparent;
      border-radius: 50px;
      padding: 0.5rem 1.5rem;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.3s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-pill-outline:hover {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      border-color: transparent;
      color: white;
    }
    .btn-pill-gradient {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      border: none;
      color: white;
      font-weight: 600;
      padding: 0.5rem 1.5rem;
      border-radius: 50px;
      font-size: 0.9rem;
      transition: all 0.3s;
      box-shadow: 0 5px 15px rgba(30,58,138,0.25);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }
    .btn-pill-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(30,58,138,0.35);
      color: white;
    }

    #cetak-scale { transform-origin: top left; }

    /* responsif */
    @media (max-width: 768px) {
      .preview-paper { padding: 1cm 1.2cm; }
      .preview-header-bar h5 { font-size: 1rem; }
      .dokumen-footer { flex-direction: column; align-items: flex-start; }
      .dokumen-footer .footer-right { text-align: left; }
    }
    @media (max-width: 576px) {
      .preview-paper { padding: .8cm .9cm; }
      .preview-header-bar { flex-direction: column; align-items: stretch; }
      .preview-header-bar .d-flex { flex-direction: column; }
      .preview-header-bar .btn-ghost { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>
  <div class="container-fluid px-4 py-3">

    <!-- ===== TOOLBAR ATAS ===== -->
    <div class="toolbar-cetak mb-4 border-bottom pb-3 print-btn">
      <a href="<%= (typeof backUrl !== 'undefined' && backUrl) ? backUrl : '/mahasiswa/akademik/khs' %>" class="btn-pill-outline back-btn">
        <i class="bi bi-arrow-left"></i> Kembali
      </a>
    </div>

    <!-- ===== PREVIEW SECTION ===== -->
    <div class="preview-section">

      <div class="preview-header-bar">
        <h5><i class="bi bi-file-earmark-text"></i> Pratinjau Kartu Hasil Studi</h5>
        <div class="d-flex gap-2">
          <button type="button" class="btn-ghost" onclick="togglePreview()" id="btnToggle">
            <i class="bi bi-eye-slash me-1"></i> Sembunyikan
          </button>
          <button type="button" class="btn-ghost primary" onclick="cetakKhs()">
            <i class="bi bi-printer me-1"></i> Cetak KHS
          </button>
        </div>
      </div>

      <div id="previewWrapper">
        <div class="preview-paper">
          <div id="cetak-scale">

            <%- include('../partials/kop_surat') %>

            <div class="judul-dokumen">
              KARTU HASIL STUDI (KHS)
              <span class="subjudul">STUDY RESULT CARD</span>
            </div>

            <div class="info-container">
              <table class="info-table" style="width: 58%;">
                <tr>
                  <td class="label" width="30%">NIM</td>
                  <td class="titik-dua">:</td>
                  <td class="nilai"><%= user.nim || '-' %></td>
                </tr>
                <tr>
                  <td class="label">NAMA</td>
                  <td class="titik-dua">:</td>
                  <td class="nilai"><%= user.nama || '-' %></td>
                </tr>
                <tr>
                  <td class="label">PROGRAM STUDI</td>
                  <td class="titik-dua">:</td>
                  <td class="nilai">D3 Teknik Elektronika</td>
                </tr>
              </table>

              <table class="info-table" style="width: 40%;">
                <tr>
                  <td class="label">SEMESTER</td>
                  <td class="titik-dua">:</td>
                  <td class="nilai"><%= khs.semester %></td>
                </tr>
                <tr>
                  <td class="label">IPK S.D. SEMESTER INI</td>
                  <td class="titik-dua">:</td>
                  <td class="nilai"><strong><%= ipkSampaiSemesterIni %></strong></td>
                </tr>
                <tr>
                  <td class="label">SKS KUMULATIF</td>
                  <td class="titik-dua">:</td>
                  <td class="nilai"><%= sksKumulatif %> SKS</td>
                </tr>
              </table>
            </div>

            <hr class="garis-pemisah">

            <table class="table-khs">
              <thead>
                <tr>
                  <th rowspan="2" width="4%">No</th>
                  <th rowspan="2" width="10%">Kode MK</th>
                  <th rowspan="2" width="32%">Mata Kuliah</th>
                  <th rowspan="2" width="8%">Bobot<br>SKS</th>
                  <th colspan="3">Nilai</th>
                  <th rowspan="2" width="10%">SKS<br>Indeks</th>
                </tr>
                <tr>
                  <th width="10%">Angka</th>
                  <th width="8%">Huruf</th>
                  <th width="8%">Indeks</th>
                </tr>
              </thead>
              <tbody>
                <% khs.matkul.forEach((m, i) => { %>
                <tr>
                  <td class="center"><%= i + 1 %></td>
                  <td class="center"><%= m.kodeMk %></td>
                  <td><%= m.namaMk %></td>
                  <td class="center"><%= m.sks %></td>
                  <% if (m.belumAdaNilai) { %>
                    <td class="center" colspan="4" style="font-style: italic; color: #666;">Belum Ada Nilai</td>
                  <% } else { %>
                    <td class="center"><%= m.nilai %></td>
                    <td class="center"><%= m.huruf %></td>
                    <td class="center"><%= m.indeks.toFixed(1) %></td>
                    <td class="center"><%= m.sksIndeks %></td>
                  <% } %>
                </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3" style="text-align: right; font-weight: bold;">Jumlah</td>
                  <td class="center" style="font-weight: bold;"><%= khs.totalSKS %></td>
                  <td colspan="3"></td>
                  <td class="center" style="font-weight: bold;"><%= khs.totalSksIndeks.toFixed(2) %></td>
                </tr>
              </tfoot>
            </table>

            <div class="ringkasan-container">
              <table class="ringkasan-table">
                <tr>
                  <td class="label">IPS (Indeks Prestasi Semester)</td>
                  <td class="nilai"><%= khs.ips %></td>
                </tr>
              </table>
            </div>

            <hr class="garis-pemisah">

            <div class="tanda-tangan-container">
              <div class="kolom-tanda">
                <p class="info-ttd">
                  Palopo, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %><br>
                  Ketua Program Studi Teknik Elektronika
                </p>
                <div class="area-ttd">
                  <img src="/images/ttd.png" alt="Tanda Tangan Kaprodi" class="img-ttd">
                </div>
                <p class="nama-ttd">Fajar Ramadhan, S.Pd., M.T.</p>
                <p class="nip-ttd">NUPTK. 8559777678130153</p>
              </div>
            </div>

            <!-- ===== FOOTER DOKUMEN RESMI ===== -->
            <div class="dokumen-footer">
              <div class="footer-left">
                <div class="baris-1">
                  <span class="check">✓</span>
                  <span>Dokumen ini dicetak &amp; disahkan secara digital oleh Sistem Informasi Elektronika Polidewa</span>
                </div>
                <div class="baris-2">
                  Periksa keaslian dokumen di: <em>https://elektronika.polidewa.ac.id</em>
                </div>
                <div class="baris-3">
                  Jika terdapat kekeliruan data, harap menghubungi Bagian Akademik Program Studi Teknik Elektronika.
                </div>
              </div>
              <div class="footer-right">
                <div>Dicetak pada: <span id="footer-tanggal">-</span></div>
                <div class="kode">KHS/<%= (user.nim || 'NIM') %>/<%= (khs.semester || '').toString().replace(/\s+/g, '-').toUpperCase() %></div>
              </div>
            </div>

          </div><!-- /#cetak-scale -->
        </div><!-- /.preview-paper -->
      </div><!-- /#previewWrapper -->

    </div><!-- /.preview-section -->

  </div>

  <script>
    /* ========== Tanggal cetak ========== */
    (function setFooterDate() {
      var el = document.getElementById('footer-tanggal');
      if (!el) return;
      var now = new Date();
      var tanggal = now.toLocaleDateString('id-ID', {
        day: 'numeric', month: 'long', year: 'numeric'
      });
      var jam = now.toLocaleTimeString('id-ID', {
        hour: '2-digit', minute: '2-digit'
      }).replace('.', ':');
      el.textContent = tanggal + ', ' + jam + ' WITA';
    })();

    /* ========== Toggle tampil/sembunyi preview ========== */
    function togglePreview() {
      var wrapper = document.getElementById('previewWrapper');
      var btn = document.getElementById('btnToggle');
      if (!wrapper || !btn) return;

      if (wrapper.style.display === 'none') {
        wrapper.style.display = '';
        btn.innerHTML = '<i class="bi bi-eye-slash me-1"></i> Sembunyikan';
      } else {
        wrapper.style.display = 'none';
        btn.innerHTML = '<i class="bi bi-eye me-1"></i> Tampilkan';
      }
    }

    /**
     * Paksa isi KHS muat dalam SATU halaman A4.
     * @page: size A4; margin: 1cm 2cm;
     * => area cetak 170mm (lebar) x 277mm (tinggi)
     */
    function fitKhsKeA4() {
      var wrapper = document.getElementById('cetak-scale');
      if (!wrapper) return;

      // reset
      wrapper.style.zoom = '';
      wrapper.style.transform = '';
      wrapper.style.transformOrigin = '';
      wrapper.style.marginBottom = '';
      wrapper.style.width = '';
      void wrapper.offsetHeight;

      var mmToPx = 96 / 25.4;
      var printW = 170 * mmToPx;
      var printH = 277 * mmToPx;

      wrapper.style.width = printW + 'px';
      void wrapper.offsetHeight;

      var contentH = wrapper.scrollHeight;

      if (contentH > printH) {
        var skala = (printH / contentH) * 0.97;
        if (skala < 0.5) skala = 0.5;

        var supportsZoom =
          typeof wrapper.style.zoom !== 'undefined' &&
          wrapper.style.zoom !== undefined;

        if (supportsZoom) {
          wrapper.style.zoom = skala;
        } else {
          wrapper.style.transformOrigin = 'top left';
          wrapper.style.transform = 'scale(' + skala + ')';
          wrapper.style.marginBottom = (contentH * skala - contentH) + 'px';
        }
      }
      wrapper.style.width = '';
    }

    function cetakKhs() {
      fitKhsKeA4();
      setTimeout(function () { window.print(); }, 150);
    }

    window.addEventListener('load', function () {
      setTimeout(function () { fitKhsKeA4(); }, 250);
    });

    window.addEventListener('resize', function () { fitKhsKeA4(); });
  </script>
</body>
</html>