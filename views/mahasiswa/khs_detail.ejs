<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>KHS <%= khs.semester %> - <%= user.nama %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
  <style>
    @page { size: A4; margin: 1.5cm; }
    body { font-family: Arial, Helvetica, sans-serif; color: #000; background-color: #fff; font-size: 9.5pt; -webkit-tap-highlight-color: transparent; -webkit-font-smoothing: antialiased; }
    .print-btn, .back-btn { margin: 20px 5px; font-family: Arial, sans-serif; }

    .kop-surat { display: flex; align-items: center; margin-bottom: 20px; }
    .logo-kop { width: 100px; height: auto; margin-right: 20px; }
    .teks-kop { flex: 1; }
    .teks-kop .nama-kampus { font-size: 26pt; font-weight: bold; margin: 0; color: #3b60a3; letter-spacing: 0.5px; }
    .teks-kop .alamat, .teks-kop .kontak { font-size: 11pt; margin: 2px 0; color: #333; }

    .judul-dokumen { text-align: center; font-size: 12pt; font-weight: bold; margin: 25px 0 20px 0; }

    .info-container { display: flex; justify-content: space-between; margin-bottom: 10px; }
    .info-table { font-size: 9pt; }
    .info-table td { padding: 3px 5px 3px 0; vertical-align: top; text-transform: uppercase; }
    .info-table td.titik-dua { width: 15px; text-align: center; }

    .garis-pemisah { border-top: 1.5px solid #000; margin: 15px 0; }

    .semester-teks { text-align: center; font-weight: bold; font-size: 10.5pt; margin: 20px 0 15px 0; }

    .table-khs { width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 9.5pt; }
    .table-khs th, .table-khs td { border: 1px solid #000; padding: 6px 8px; vertical-align: middle; }
    .table-khs th { text-align: center; font-weight: bold; }
    .table-khs td.center { text-align: center; }

    tr { page-break-inside: avoid; }
    thead { display: table-header-group; }

    .ringkasan-container { display: flex; justify-content: flex-end; margin-bottom: 15px; }
    .ringkasan-table { font-size: 9.5pt; width: 45%; }
    .ringkasan-table td { padding: 4px 8px; border: 1px solid #000; }
    .ringkasan-table td.label { font-weight: bold; }

    .tanda-tangan-container { display: flex; justify-content: flex-end; margin-top: 30px; font-size: 10pt; }
    .kolom-tanda { width: 32%; text-align: center; }
    .area-ttd {
      position: relative;
      height: 45px;
    }
    .img-ttd {
      position: absolute;
      top: -50px;
      left: -15px;
      height: 150px;
      width: auto;
      z-index: 10;
      mix-blend-mode: multiply;
    }
    .nama-ttd { margin-bottom: 0; font-weight: bold; text-decoration: underline; }
    .nip-ttd { margin-top: 0; }

    @media print {
      body { margin: 0; }
      .btn, .print-btn, .back-btn { display: none !important; }
      .table-khs th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .img-ttd { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }

    /* ===== Toolbar layar (tidak ikut tercetak) - konsisten dengan tombol pill di halaman lain ===== */
    .toolbar-cetak {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .btn-pill-outline {
      border: 2px solid #1e3a8a;
      color: #1e3a8a;
      background: transparent;
      border-radius: 50px;
      padding: 0.5rem 1.5rem;
      font-weight: 600;
      font-size: 0.9rem;
      transition: all 0.3s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-pill-outline:hover {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      border-color: transparent;
      color: white;
    }
    .btn-pill-gradient {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      border: none;
      color: white;
      font-weight: 600;
      padding: 0.5rem 1.5rem;
      border-radius: 50px;
      font-size: 0.9rem;
      transition: all 0.3s;
      box-shadow: 0 5px 15px rgba(30,58,138,0.25);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-pill-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(30,58,138,0.35);
      color: white;
    }
  </style>
</head>
<body>
  <div class="container-fluid px-4 py-3">

    <div class="toolbar-cetak mb-4 border-bottom pb-3 print-btn">
      <a href="/mahasiswa/akademik/khs" class="btn-pill-outline back-btn">
        <i class="bi bi-arrow-left"></i> Kembali
      </a>
      <button onclick="window.print()" class="btn-pill-gradient print-btn">
        <i class="bi bi-printer-fill"></i> Cetak Ulang
      </button>
    </div>

    <%- include('../partials/kop_surat') %>

    <div class="judul-dokumen">
      KARTU HASIL STUDI (KHS)
    </div>

    <div class="info-container">
      <table class="info-table" style="width: 60%;">
        <tr>
          <td width="30%">NIM</td>
          <td class="titik-dua">:</td>
          <td><%= user.nim || '-' %></td>
        </tr>
        <tr>
          <td>NAMA</td>
          <td class="titik-dua">:</td>
          <td><%= user.nama || '-' %></td>
        </tr>
        <tr>
          <td>PROGRAM STUDI</td>
          <td class="titik-dua">:</td>
          <td>D3 Teknik Elektronika</td>
        </tr>
      </table>

      <table class="info-table" style="width: 36%;">
        <tr>
          <td width="55%">SEMESTER</td>
          <td class="titik-dua">:</td>
          <td><%= khs.semester %></td>
        </tr>
        <tr>
          <td>IPK S.D. SEMESTER INI</td>
          <td class="titik-dua">:</td>
          <td><strong><%= ipkSampaiSemesterIni %></strong></td>
        </tr>
        <tr>
          <td>SKS KUMULATIF</td>
          <td class="titik-dua">:</td>
          <td><%= sksKumulatif %> SKS</td>
        </tr>
      </table>
    </div>

    <div class="garis-pemisah"></div>

    <table class="table-khs">
      <thead>
        <tr>
          <th rowspan="2" width="4%">No</th>
          <th rowspan="2" width="10%">Kode MK</th>
          <th rowspan="2" width="32%">Mata Kuliah</th>
          <th rowspan="2" width="8%">Bobot SKS</th>
          <th colspan="3">Nilai</th>
          <th rowspan="2" width="10%">SKS Indeks</th>
        </tr>
        <tr>
          <th width="10%">Angka</th>
          <th width="8%">Huruf</th>
          <th width="8%">Indeks</th>
        </tr>
      </thead>
      <tbody>
        <% khs.matkul.forEach((m, i) => { %>
        <tr>
          <td class="center"><%= i + 1 %></td>
          <td class="center"><%= m.kodeMk %></td>
          <td><%= m.namaMk %></td>
          <td class="center"><%= m.sks %></td>
          <% if (m.belumAdaNilai) { %>
            <td class="center" colspan="4" style="font-style: italic; color: #666;">Belum Ada Nilai</td>
          <% } else { %>
            <td class="center"><%= m.nilai %></td>
            <td class="center"><%= m.huruf %></td>
            <td class="center"><%= m.indeks.toFixed(1) %></td>
            <td class="center"><%= m.sksIndeks %></td>
          <% } %>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="text-align: right; font-weight: bold;">Jumlah</td>
          <td class="center" style="font-weight: bold;"><%= khs.totalSKS %></td>
          <td colspan="3"></td>
          <td class="center" style="font-weight: bold;"><%= khs.totalSksIndeks.toFixed(2) %></td>
        </tr>
      </tfoot>
    </table>

    <div class="ringkasan-container">
      <table class="ringkasan-table">
        <tr>
          <td class="label">IPS (Indeks Prestasi Semester)</td>
          <td style="text-align: center; font-weight: bold; font-size: 12pt;"><%= khs.ips %></td>
        </tr>
      </table>
    </div>

    <div class="garis-pemisah"></div>

    <div class="tanda-tangan-container">
      <div class="kolom-tanda">
        <p class="mb-0">Palopo, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <p>Ketua Program Studi Teknik Elektronika</p>
        <div class="area-ttd">
          <img src="/images/ttd.png" alt="Tanda Tangan Kaprodi" class="img-ttd">
        </div>
        <p class="nama-ttd">Fajar Ramadhan, S.Pd., M.T</p>
        <p class="nip-ttd">NUPTK: 8559777678130153</p>
      </div>
    </div>

  </div>

  <script>
    // Langsung buka dialog cetak begitu halaman & gambar (kop/ttd) selesai dimuat,
    // tanpa perlu klik tombol "Cetak" terlebih dahulu.
    window.addEventListener('load', function () {
      setTimeout(function () { window.print(); }, 250);
    });
  </script>
</body>
</html>
