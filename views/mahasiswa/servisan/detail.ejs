<%- include('../../partials/header') %>
<style>
  .detail-card {
    background: white;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
  }
  .detail-header {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    padding: 1.25rem;
    color: white;
  }
  .detail-section {
    border-left: 3px solid #3b82f6;
    padding-left: 0.75rem;
    margin: 1.25rem 0 0.75rem 0;
    font-weight: 700;
    color: #1e3a8a;
  }
  .info-row {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .info-label {
    width: 35%;
    font-weight: 600;
    color: #475569;
  }
  .info-value {
    width: 65%;
  }
  @media (max-width: 768px) {
    .info-label, .info-value {
      width: 100%;
    }
    .info-label {
      margin-bottom: 0.2rem;
    }
  }
  .badge-status {
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
  }
</style>

<div class="container mt-4 mb-5">
  <div class="detail-card">
    <div class="detail-header">
      <h3 class="fw-bold mb-0"><i class="bi bi-wrench"></i> Detail Servisan Alat</h3>
      <p class="mb-0 mt-1 opacity-75">No. Kupon: <strong><%= servisan.noKupon %></strong></p>
      <p class="mb-0 mt-1 small">Kelompok Penanggung Jawab: <strong><%= servisan.kelompokPenanggungJawab || '-' %></strong></p>
    </div>
    <div class="p-4">
      <!-- Identitas Pemilik -->
      <div class="detail-section">👤 Identitas Pemilik</div>
      <div class="info-row">
        <div class="info-label">Nama Pemilik</div>
        <div class="info-value">: <%= servisan.namaPemilik %></div>
      </div>
      <div class="info-row">
        <div class="info-label">Alamat</div>
        <div class="info-value">: <%= servisan.alamat || '-' %></div>
      </div>
      <div class="info-row">
        <div class="info-label">No. HP</div>
        <div class="info-value">: <%= servisan.noHp || '-' %></div>
      </div>
      <div class="info-row">
        <div class="info-label">Tanggal Servis</div>
        <div class="info-value">: <%= new Date(servisan.tanggalServis).toLocaleDateString('id-ID') %></div>
      </div>

      <!-- Informasi Alat -->
      <div class="detail-section">💡 Informasi Alat</div>
      <div class="info-row">
        <div class="info-label">Jenis Alat</div>
        <div class="info-value">: 
          <% 
            let alat = [];
            if(servisan.jenisAlat && servisan.jenisAlat.riceCooker) alat.push('Rice cooker');
            if(servisan.jenisAlat && servisan.jenisAlat.kipasAngin) alat.push('Kipas angin');
            if(servisan.jenisAlat && servisan.jenisAlat.dispenser) alat.push('Dispenser');
            if(servisan.jenisAlat && servisan.jenisAlat.mesinCuci) alat.push('Mesin cuci');
            if(servisan.jenisAlat && servisan.jenisAlat.lainnya) alat.push(servisan.jenisAlat.lainnya);
          %>
          <%= alat.join(', ') || '-' %>
        </div>
      </div>
      <div class="info-row">
        <div class="info-label">Merk & model</div>
        <div class="info-value">: <%= servisan.merkModel || '-' %></div>
      </div>
      <div class="info-row">
        <div class="info-label">Keluhan</div>
        <div class="info-value">: <%= servisan.keluhan || '-' %></div>
      </div>

      <!-- Diagnosis & Tindakan (hanya tampil jika ada data) -->
      <% 
        const hasDiagnosis = servisan.diagnosis && (
          servisan.diagnosis.fusePutus ||
          servisan.diagnosis.kabelPutus ||
          servisan.diagnosis.sakelarRusak ||
          servisan.diagnosis.elemenPemanas ||
          servisan.diagnosis.termostat ||
          servisan.diagnosis.kapasitorKipas ||
          servisan.diagnosis.motor ||
          servisan.diagnosis.pompaAir ||
          servisan.diagnosis.lainnya
        );
        const hasTindakan = servisan.tindakan && (
          servisan.tindakan.gantiKomponen ||
          servisan.tindakan.penyolderan ||
          servisan.tindakan.pembersihan ||
          servisan.tindakan.tidakBisaDiperbaiki
        );
      %>
      <% if(hasDiagnosis || hasTindakan) { %>
        <div class="detail-section">🩺 Diagnosis & Tindakan</div>
        <div class="info-row">
          <div class="info-label">Diagnosis awal</div>
          <div class="info-value">: 
            <% 
              let diag = [];
              if(servisan.diagnosis.fusePutus) diag.push('Fuse putus');
              if(servisan.diagnosis.kabelPutus) diag.push('Kabel putus/dalam');
              if(servisan.diagnosis.sakelarRusak) diag.push('Sakelar rusak');
              if(servisan.diagnosis.elemenPemanas) diag.push('Elemen pemanas');
              if(servisan.diagnosis.termostat) diag.push('Termostat');
              if(servisan.diagnosis.kapasitorKipas) diag.push('Kapasitor kipas');
              if(servisan.diagnosis.motor) diag.push('Motor/dinamo');
              if(servisan.diagnosis.pompaAir) diag.push('Pompa air');
              if(servisan.diagnosis.lainnya) diag.push(servisan.diagnosis.lainnya);
            %>
            <%= diag.join(', ') || '-' %>
          </div>
        </div>
        <div class="info-row">
          <div class="info-label">Tindakan</div>
          <div class="info-value">: 
            <% 
              let tind = [];
              if(servisan.tindakan.gantiKomponen) tind.push('Ganti komponen: ' + (servisan.tindakan.gantiKomponenDetail || ''));
              if(servisan.tindakan.penyolderan) tind.push('Penyolderan / sambung kabel');
              if(servisan.tindakan.pembersihan) tind.push('Pembersihan / pelumasan');
              if(servisan.tindakan.tidakBisaDiperbaiki) tind.push('Tidak bisa diperbaiki: ' + (servisan.tindakan.alasanTidakBisa || ''));
            %>
            <%= tind.join('; ') || '-' %>
          </div>
        </div>
        <div class="info-row">
          <div class="info-label">Suku cadang</div>
          <div class="info-value">: <%= servisan.sukuCadang || '-' %></div>
        </div>
        <div class="info-row">
          <div class="info-label">Biaya komponen</div>
          <div class="info-value">: Rp <%= (servisan.biayaKomponen || 0).toLocaleString('id-ID') %></div>
        </div>
      <% } %>

      <!-- Hasil & Verifikasi -->
      <div class="detail-section">✅ Hasil & Verifikasi</div>
      <div class="info-row">
        <div class="info-label">Hasil perbaikan</div>
        <div class="info-value">: 
          <span class="badge bg-<%= servisan.hasilPerbaikan === 'Berhasil' ? 'success' : (servisan.hasilPerbaikan === 'Tidak berhasil' ? 'danger' : 'secondary') %> badge-status">
            <%= servisan.hasilPerbaikan || 'Belum Diperbaiki' %>
          </span>
        </div>
      </div>
      <div class="info-row">
        <div class="info-label">Alat sudah diuji coba</div>
        <div class="info-value">: <%= servisan.sudahDiuji || '-' %></div>
      </div>
      <div class="info-row">
        <div class="info-label">Waktu selesai</div>
        <div class="info-value">: <%= servisan.waktuSelesai || '-' %></div>
      </div>
      <div class="info-row">
        <div class="info-label">Keterangan tambahan</div>
        <div class="info-value">: <%= servisan.keteranganTambahan || '-' %></div>
      </div>

      <!-- Teknisi pencatat -->
      <div class="detail-section">🧑‍🔧 Petugas & Penanggung Jawab</div>
      <div class="info-row">
        <div class="info-label">Teknisi pencatat</div>
        <div class="info-value">: <%= servisan.namaMahasiswa %> (<%= servisan.nim %>)</div>
      </div>
      <div class="info-row">
        <div class="info-label">Kelompok Penanggung Jawab</div>
        <div class="info-value">: <strong><%= servisan.kelompokPenanggungJawab || '-' %></strong></div>
      </div>
    </div>
    <div class="bg-light p-3 text-end border-top">
      <a href="/mahasiswa/servisan/edit/<%= servisan.id %>" class="btn btn-warning btn-sm me-2"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/mahasiswa/servisan" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>