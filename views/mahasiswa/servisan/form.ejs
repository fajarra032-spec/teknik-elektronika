<%- include('../../partials/header') %>
<style>
  .form-card {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .form-header {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    padding: 1.5rem;
    color: white;
    text-align: center;
  }
  .form-body {
    padding: 1.5rem;
  }
  .section-title {
    font-weight: 700;
    margin: 1.5rem 0 1rem 0;
    border-left: 5px solid #1e3a8a;
    padding-left: 1rem;
    color: #1e3a8a;
    font-size: 1.1rem;
  }
  .checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  @media (max-width: 768px) {
    .form-body {
      padding: 1rem;
    }
    .checkbox-group {
      flex-direction: column;
      gap: 0.5rem;
    }
    .btn {
      width: 100%;
      margin: 0.25rem 0;
    }
  }
</style>

<div class="container mt-4 mb-5">
  <div class="form-card">
    <div class="form-header">
      <h3 class="fw-bold mb-0"><%= servisan ? '✏️ Edit Servisan Alat' : '🔧 Form Perbaikan Alat Listrik' %></h3>
      <p class="mt-2 mb-0 opacity-75">No. Kupon: <%= servisan ? servisan.noKupon : 'Akan digenerate otomatis' %></p>
      <% if(servisan && servisan.kelompokPenanggungJawab) { %>
        <p class="mb-0 mt-1 small">Kelompok Penanggung Jawab: <strong><%= servisan.kelompokPenanggungJawab %></strong></p>
      <% } else if(!servisan) { %>
        <p class="mb-0 mt-1 small">Kelompok Penanggung Jawab akan ditentukan sistem secara bergantian (round-robin)</p>
      <% } %>
    </div>
    <div class="form-body">
      <form method="POST" action="/mahasiswa/servisan<%= servisan ? '/update/' + servisan.id : '' %>">
        <!-- IDENTITAS PEMILIK -->
        <div class="section-title">👤 Identitas Pemilik</div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Nama Pemilik <span class="text-danger">*</span></label>
            <input type="text" name="namaPemilik" class="form-control" value="<%= servisan ? servisan.namaPemilik : '' %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Alamat (RT/Dusun)</label>
            <input type="text" name="alamat" class="form-control" value="<%= servisan ? servisan.alamat : '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">No. HP (opsional)</label>
            <input type="text" name="noHp" class="form-control" value="<%= servisan ? servisan.noHp : '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Tanggal Servis</label>
            <input type="date" name="tanggalServis" class="form-control" value="<%= servisan ? servisan.tanggalServis : new Date().toISOString().slice(0,10) %>" required>
          </div>
        </div>

        <!-- INFORMASI ALAT -->
        <div class="section-title">💡 Informasi Alat</div>
        <div class="mb-2">
          <label class="form-label fw-semibold">Jenis alat :</label>
          <div class="checkbox-group">
            <label><input type="checkbox" name="jenisAlat_riceCooker" <%= servisan && servisan.jenisAlat && servisan.jenisAlat.riceCooker ? 'checked' : '' %>> Rice cooker</label>
            <label><input type="checkbox" name="jenisAlat_kipasAngin" <%= servisan && servisan.jenisAlat && servisan.jenisAlat.kipasAngin ? 'checked' : '' %>> Kipas angin</label>
            <label><input type="checkbox" name="jenisAlat_dispenser" <%= servisan && servisan.jenisAlat && servisan.jenisAlat.dispenser ? 'checked' : '' %>> Dispenser</label>
            <label><input type="checkbox" name="jenisAlat_mesinCuci" <%= servisan && servisan.jenisAlat && servisan.jenisAlat.mesinCuci ? 'checked' : '' %>> Mesin cuci</label>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-md-6">
              <label class="form-label">Lainnya:</label>
              <input type="text" name="jenisAlat_lainnya" class="form-control" value="<%= servisan && servisan.jenisAlat ? servisan.jenisAlat.lainnya : '' %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">Merk & model</label>
              <input type="text" name="merkModel" class="form-control" value="<%= servisan ? servisan.merkModel : '' %>">
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Keluhan warga</label>
          <textarea name="keluhan" class="form-control" rows="2"><%= servisan ? servisan.keluhan : '' %></textarea>
        </div>

        <!-- DIAGNOSA & TINDAKAN (hanya untuk edit dan jika status belum "Belum Diperbaiki", atau bisa ditampilkan semua dengan nilai default) -->
        <!-- Untuk kemudahan, kita tampilkan saja bagian ini, tetapi jika servisan baru, field akan kosong -->
        <div class="section-title">🩺 Diagnosis & Tindakan (diisi teknisi)</div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Diagnosis awal :</label>
            <div class="checkbox-group">
              <label><input type="checkbox" name="diagnosis_fusePutus" <%= servisan && servisan.diagnosis && servisan.diagnosis.fusePutus ? 'checked' : '' %>> Fuse putus</label>
              <label><input type="checkbox" name="diagnosis_kabelPutus" <%= servisan && servisan.diagnosis && servisan.diagnosis.kabelPutus ? 'checked' : '' %>> Kabel putus/dalam</label>
              <label><input type="checkbox" name="diagnosis_sakelarRusak" <%= servisan && servisan.diagnosis && servisan.diagnosis.sakelarRusak ? 'checked' : '' %>> Sakelar rusak/macet</label>
              <label><input type="checkbox" name="diagnosis_elemenPemanas" <%= servisan && servisan.diagnosis && servisan.diagnosis.elemenPemanas ? 'checked' : '' %>> Elemen pemanas</label>
              <label><input type="checkbox" name="diagnosis_termosat" <%= servisan && servisan.diagnosis && servisan.diagnosis.termostat ? 'checked' : '' %>> Termostat</label>
              <label><input type="checkbox" name="diagnosis_kapasitorKipas" <%= servisan && servisan.diagnosis && servisan.diagnosis.kapasitorKipas ? 'checked' : '' %>> Kapasitor kipas</label>
              <label><input type="checkbox" name="diagnosis_motor" <%= servisan && servisan.diagnosis && servisan.diagnosis.motor ? 'checked' : '' %>> Motor / dinamo</label>
              <label><input type="checkbox" name="diagnosis_pompaAir" <%= servisan && servisan.diagnosis && servisan.diagnosis.pompaAir ? 'checked' : '' %>> Pompa air</label>
            </div>
            <div class="mt-2">
              <label class="form-label">Lainnya:</label>
              <input type="text" name="diagnosis_lainnya" class="form-control" value="<%= servisan && servisan.diagnosis ? servisan.diagnosis.lainnya : '' %>">
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Tindakan :</label>
            <div class="checkbox-group">
              <label><input type="checkbox" name="tindakan_gantiKomponen" <%= servisan && servisan.tindakan && servisan.tindakan.gantiKomponen ? 'checked' : '' %>> Ganti komponen – sebutkan:</label>
              <input type="text" name="tindakan_gantiKomponenDetail" class="form-control mt-1 mb-2" placeholder="Komponen apa" value="<%= servisan && servisan.tindakan ? servisan.tindakan.gantiKomponenDetail : '' %>">
              <label><input type="checkbox" name="tindakan_penyolderan" <%= servisan && servisan.tindakan && servisan.tindakan.penyolderan ? 'checked' : '' %>> Penyolderan / sambung kabel</label>
              <label><input type="checkbox" name="tindakan_pembersihan" <%= servisan && servisan.tindakan && servisan.tindakan.pembersihan ? 'checked' : '' %>> Pembersihan / pelumasan</label>
              <label><input type="checkbox" name="tindakan_tidakBisa" <%= servisan && servisan.tindakan && servisan.tindakan.tidakBisaDiperbaiki ? 'checked' : '' %>> Tidak bisa diperbaiki (alasan:)</label>
              <input type="text" name="tindakan_alasanTidakBisa" class="form-control mt-1" placeholder="Alasan" value="<%= servisan && servisan.tindakan ? servisan.tindakan.alasanTidakBisa : '' %>">
            </div>
          </div>
        </div>
        <div class="row g-3 mt-2">
          <div class="col-md-6">
            <label class="form-label">Suku cadang yang digunakan</label>
            <input type="text" name="sukuCadang" class="form-control" value="<%= servisan ? servisan.sukuCadang : '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Biaya komponen (Rp) – opsional</label>
            <input type="number" name="biayaKomponen" class="form-control" value="<%= servisan ? servisan.biayaKomponen : 0 %>" min="0">
          </div>
        </div>

        <!-- HASIL & VERIFIKASI -->
        <div class="section-title">✅ Hasil & Verifikasi</div>
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-semibold">Hasil perbaikan</label>
            <select name="hasilPerbaikan" class="form-select">
              <% if(servisan) { %>
                <option value="Berhasil" <%= servisan.hasilPerbaikan === 'Berhasil' ? 'selected' : '' %>>Berhasil</option>
                <option value="Tidak berhasil" <%= servisan.hasilPerbaikan === 'Tidak berhasil' ? 'selected' : '' %>>Tidak berhasil</option>
                <option value="Belum Diperbaiki" <%= (servisan.hasilPerbaikan === 'Belum Diperbaiki' || !servisan.hasilPerbaikan) ? 'selected' : '' %>>Belum Diperbaiki</option>
              <% } else { %>
                <option value="Belum Diperbaiki" selected>Belum Diperbaiki</option>
                <option value="Berhasil">Berhasil</option>
                <option value="Tidak berhasil">Tidak berhasil</option>
              <% } %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Alat sudah diuji coba?</label>
            <select name="sudahDiuji" class="form-select">
              <option value="Ya" <%= servisan && servisan.sudahDiuji === 'Ya' ? 'selected' : '' %>>Ya</option>
              <option value="Tidak" <%= (!servisan || servisan.sudahDiuji === 'Tidak') ? 'selected' : '' %>>Tidak</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Waktu selesai (jam)</label>
            <input type="time" name="waktuSelesai" class="form-control" value="<%= servisan ? servisan.waktuSelesai : '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Keterangan tambahan</label>
            <textarea name="keteranganTambahan" class="form-control" rows="2"><%= servisan ? servisan.keteranganTambahan : '' %></textarea>
          </div>
        </div>

        <!-- TANDA TANGAN -->
        <div class="section-title">✍️ Tanda Tangan</div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Teknisi (nama & ttd)</label>
            <input type="text" class="form-control bg-light" readonly value="<%= user.nama %> (Mahasiswa)">
          </div>
          <div class="col-md-6">
            <label class="form-label">Pemilik alat (nama)</label>
            <input type="text" name="namaPemilik" class="form-control" value="<%= servisan ? servisan.namaPemilik : '' %>" required>
            <small class="text-muted">Tanda tangan akan dilakukan setelah cetak</small>
          </div>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-center gap-2 mt-4 pt-3 border-top">
          <button type="submit" class="btn btn-primary px-5"><i class="bi bi-save"></i> Simpan Servisan</button>
          <a href="/mahasiswa/servisan" class="btn btn-secondary px-5"><i class="bi bi-x-circle"></i> Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>