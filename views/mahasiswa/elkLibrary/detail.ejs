<%- include('../../partials/header') %>

<style>
  .detail-hero {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    border-radius: 1.5rem;
    padding: 2rem;
    color: white;
    margin-bottom: 2rem;
  }
  .detail-hero h1 { font-weight: 800; font-size: clamp(1.3rem, 4vw, 2rem); margin-bottom: 1rem; }
  .meta-badge {
    background: rgba(255,255,255,0.2);
    padding: 0.4rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: 0.5rem;
  }
  .main-card {
    background: white;
    border-radius: 1.25rem;
    padding: 2rem;
    border: 1px solid rgba(30,58,138,0.1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  .btn-download-buku {
    background: #1e3a8a;
    color: white;
    width: 100%;
    padding: 0.9rem;
    border-radius: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .btn-download-buku:hover { background: #0f2b5c; color: white; }
  .btn-kembali {
    border: 2px solid #1e3a8a;
    color: #1e3a8a;
    border-radius: 50px;
    padding: 0.5rem 1.4rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
  }
  .btn-kembali:hover {
    background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    border-color: transparent;
    color: white;
  }

  /* ===== RESPONSIF ===== */
  @media (max-width: 768px) {
    html { font-size: 15px; }
    .detail-hero { padding: 1.2rem; border-radius: 1.2rem; }
    .main-card { padding: 1.2rem; }
  }
  @media (max-width: 576px) {
    html { font-size: 14px; }
    .detail-hero h1 { font-size: 1.15rem; }
    .meta-badge { font-size: 0.78rem; padding: 0.35rem 0.8rem; }
  }
</style>

<div class="container mt-4 mb-5">
  <nav class="mb-3 small text-muted">
    <a href="/mahasiswa/elk-library" class="text-decoration-none text-muted">ELK Library</a> / <span class="text-dark fw-semibold">Detail Buku</span>
  </nav>

  <div class="detail-hero">
    <h1><%= item.judul %></h1>
    <div class="meta-badge"><i class="bi bi-person-circle"></i> <%= item.penulis || item.dosenNama || 'Anonim' %></div>
    <% if (item.tahun) { %><div class="meta-badge"><i class="bi bi-calendar-check"></i> <%= item.tahun %></div><% } %>
    <% if (item.penerbit) { %><div class="meta-badge"><i class="bi bi-building"></i> <%= item.penerbit %></div><% } %>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="main-card">
        <h6 class="fw-bold text-muted text-uppercase mb-3">Deskripsi</h6>
        <p style="line-height:1.8;"><%= item.deskripsi || 'Deskripsi tidak tersedia untuk buku ini.' %></p>
      </div>
      <a href="/mahasiswa/elk-library" class="btn-kembali mt-3"><i class="bi bi-arrow-left"></i> Kembali ke ELK Library</a>
    </div>
    <div class="col-lg-4">
      <% if (item.fileUrl) { %>
        <div class="main-card mb-3">
          <h6 class="fw-bold mb-3">Buku Lengkap</h6>
          <a href="<%= item.fileUrl %>" target="_blank" class="btn-download-buku">
            <i class="bi bi-file-earmark-pdf fs-4"></i> Baca PDF
          </a>
        </div>
      <% } %>
      <div class="main-card">
        <h6 class="fw-bold mb-3 border-bottom pb-2">Detail</h6>
        <% if (item.isbn) { %>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted small">ISBN</span><span class="fw-medium small"><%= item.isbn %></span></div>
        <% } %>
        <div class="d-flex justify-content-between">
          <span class="text-muted small">ID Arsip</span>
          <span class="fw-medium small">#<%= (item.id || '').substring(0,8).toUpperCase() %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
