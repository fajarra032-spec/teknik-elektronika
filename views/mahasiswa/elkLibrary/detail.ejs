<%- include('../../partials/header') %>

<style>
  .detail-hero {
    background: linear-gradient(135deg, #d97706, #f59e0b);
    border-radius: 1.5rem;
    padding: 2rem;
    color: white;
    margin-bottom: 2rem;
  }
  .detail-hero h1 { font-weight: 800; font-size: clamp(1.3rem, 4vw, 2rem); margin-bottom: 1rem; }
  .meta-badge {
    background: rgba(255,255,255,0.2);
    padding: 0.4rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: 0.5rem;
  }
  .main-card {
    background: white;
    border-radius: 1.25rem;
    padding: 2rem;
    border: 1px solid #f1e4c8;
  }
  .btn-download-buku {
    background: #d97706;
    color: white;
    width: 100%;
    padding: 0.9rem;
    border-radius: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .btn-download-buku:hover { background: #b45309; color: white; }
</style>

<div class="container mt-4 mb-5">
  <nav class="mb-3 small text-muted">
    <a href="/mahasiswa/elk-library" class="text-decoration-none text-muted">ELK Library</a> / <span class="text-dark fw-semibold">Detail Buku</span>
  </nav>

  <div class="detail-hero">
    <h1><%= item.judul %></h1>
    <div class="meta-badge"><i class="bi bi-person-circle"></i> <%= item.penulis || item.dosenNama || 'Anonim' %></div>
    <% if (item.tahun) { %><div class="meta-badge"><i class="bi bi-calendar-check"></i> <%= item.tahun %></div><% } %>
    <% if (item.penerbit) { %><div class="meta-badge"><i class="bi bi-building"></i> <%= item.penerbit %></div><% } %>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="main-card">
        <h6 class="fw-bold text-muted text-uppercase mb-3">Deskripsi</h6>
        <p style="line-height:1.8;"><%= item.deskripsi || 'Deskripsi tidak tersedia untuk buku ini.' %></p>
      </div>
      <a href="/mahasiswa/elk-library" class="btn btn-link mt-3"><i class="bi bi-arrow-left"></i> Kembali ke ELK Library</a>
    </div>
    <div class="col-lg-4">
      <% if (item.fileUrl) { %>
        <div class="main-card mb-3">
          <h6 class="fw-bold mb-3">Buku Lengkap</h6>
          <a href="<%= item.fileUrl %>" target="_blank" class="btn-download-buku">
            <i class="bi bi-file-earmark-pdf fs-4"></i> Baca PDF
          </a>
        </div>
      <% } %>
      <div class="main-card">
        <h6 class="fw-bold mb-3 border-bottom pb-2">Detail</h6>
        <% if (item.isbn) { %>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted small">ISBN</span><span class="fw-medium small"><%= item.isbn %></span></div>
        <% } %>
        <div class="d-flex justify-content-between">
          <span class="text-muted small">ID Arsip</span>
          <span class="fw-medium small">#<%= (item.id || '').substring(0,8).toUpperCase() %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
