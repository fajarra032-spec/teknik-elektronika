<%- include('../../partials/header') %>

<%
  // ========== DEFAULT VALUES UNTUK MENCEGAH ERROR ==========
  if (typeof pdkList === 'undefined') pdkList = [];
  if (typeof logbook === 'undefined') logbook = [];
  if (typeof selectedPeriod === 'undefined') selectedPeriod = null;
  if (typeof canSubmit === 'undefined') canSubmit = false;
  if (typeof selectedPeriodId === 'undefined') selectedPeriodId = null;
  if (typeof pembimbing === 'undefined') pembimbing = null;
  
  // Helper function untuk mendapatkan semester saat ini (fallback)
  const getCurrentSemester = () => {
    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth() + 1;
    const semester = month >= 8 ? 'Ganjil' : 'Genap';
    return `${semester} ${year}/${year + 1}`;
  };
%>

<style>
  /* ===== VARIABEL DARI LANDING + GAYA ASLI ===== */
  :root {
    /* Tambahan dari landing */
    --primary: #0d6efd;
    --primary-dark: #0b5ed7;
    --secondary: #0dcaf0;
    --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    --shadow-sm: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
    --shadow-hover: 0 1rem 2rem rgba(13, 110, 253, 0.12);
    --transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    
    /* Variabel asli */
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
    --warning-bg: #fef3c7;
    --warning-text: #92400e;
    --success-bg: #d1fae5;
    --success-text: #065f46;
    --danger-bg: #fee2e2;
    --danger-text: #991b1b;
  }

  /* ===== BASE FLUID FONT (SAMA PERSIS DENGAN LANDING) ===== */
  html {
    font-size: clamp(14px, 1vw + 10px, 16px);
  }

  body {
    font-family: var(--font-sans);
    background-color: #f8fafc;
  }

  /* ===== HEADER ===== */
  .magang-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
    position: relative;
    overflow: hidden;
  }
  .magang-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    transform: rotate(25deg);
  }
  .magang-header h2 {
    font-weight: 700;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 1;
    font-size: clamp(1.4rem, 5vw, 2.2rem);
  }
  .magang-header p {
    margin-bottom: 0;
    opacity: 0.9;
    position: relative;
    z-index: 1;
    font-size: clamp(0.85rem, 3vw, 1.1rem);
  }
  .magang-header .btn-light {
    border-radius: 50px;
    padding: clamp(0.4rem, 2vw, 0.6rem) clamp(1rem, 4vw, 1.5rem);
    font-weight: 500;
    background: white;
    color: var(--primary-start);
    border: none;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    font-size: clamp(0.8rem, 2.5vw, 0.95rem);
  }
  .magang-header .btn-light:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  /* ===== TAB PDK ===== */
  .pdk-tabs {
    margin-bottom: 1.5rem;
    background: white;
    border-radius: 1rem;
    padding: clamp(0.3rem, 2vw, 0.5rem);
    box-shadow: var(--shadow-sm);
  }
  .nav-tabs {
    border-bottom: none;
    gap: clamp(0.3rem, 2vw, 0.5rem);
    flex-wrap: wrap;
  }
  .nav-tabs .nav-link {
    border: none;
    border-radius: 2rem;
    padding: clamp(0.4rem, 2vw, 0.6rem) clamp(1rem, 3vw, 1.5rem);
    color: #6c757d;
    font-weight: 500;
    transition: var(--transition);
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
  }
  .nav-tabs .nav-link:hover {
    background: var(--primary-light);
    color: var(--primary-start);
  }
  .nav-tabs .nav-link.active {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    box-shadow: 0 5px 15px rgba(30,58,138,0.3);
  }
  .badge-tab {
    margin-left: 0.5rem;
    font-size: clamp(0.6rem, 2vw, 0.7rem);
    padding: clamp(0.1rem, 1vw, 0.2rem) clamp(0.3rem, 1.5vw, 0.5rem);
    border-radius: 50px;
  }

  /* ===== PANDUAN CARD ===== */
  .panduan-card {
    background: white;
    border-left: 4px solid var(--primary-start);
    border-radius: 1.2rem;
    padding: clamp(1rem, 3vw, 1.2rem) clamp(1rem, 4vw, 1.5rem);
    margin-bottom: 2rem;
    box-shadow: 0 8px 20px rgba(0,0,0,0.03);
    display: flex;
    align-items: flex-start;
    gap: clamp(0.8rem, 3vw, 1rem);
  }
  .panduan-icon { 
    font-size: clamp(1.5rem, 5vw, 2rem); 
    color: var(--primary-start); 
    flex-shrink: 0; 
  }
  .panduan-text strong { 
    color: var(--primary-dark); 
    display: block; 
    margin-bottom: 0.3rem; 
    font-size: clamp(0.9rem, 2.5vw, 1rem);
  }
  .panduan-text ul { 
    margin-bottom: 0; 
    padding-left: 1.2rem; 
  }
  .panduan-text li { 
    margin-bottom: 0.3rem; 
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
  }

  /* ===== INFO PEMBIMBING ===== */
  .info-pembimbing {
    background: #f8fafc;
    border-radius: 1rem;
    padding: clamp(0.8rem, 3vw, 1rem) clamp(1rem, 4vw, 1.5rem);
    margin-bottom: 1.5rem;
    border: 1px solid #e2e8f0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .info-pembimbing-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
  }
  .info-pembimbing-item i {
    color: var(--primary-start);
    font-size: clamp(1rem, 3vw, 1.2rem);
  }

  /* ===== TABEL ===== */
  .table-container {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    padding: clamp(1rem, 4vw, 1.5rem);
    margin-bottom: 2rem;
  }
  .logbook-table thead th {
    background: linear-gradient(135deg, var(--primary-light), rgba(59,130,246,0.1));
    color: var(--primary-dark);
    font-weight: 600;
    text-transform: uppercase;
    font-size: clamp(0.7rem, 2vw, 0.85rem);
    letter-spacing: 0.5px;
    border-bottom: 2px solid var(--primary-start);
    padding: clamp(0.7rem, 2.5vw, 1rem) clamp(0.5rem, 2vw, 0.75rem);
  }
  .logbook-table tbody tr {
    transition: var(--transition);
  }
  .logbook-table tbody tr:hover {
    background-color: var(--primary-light);
    transform: scale(1.01);
    box-shadow: 0 5px 15px rgba(30,58,138,0.1);
  }
  .logbook-table td {
    padding: clamp(0.7rem, 2.5vw, 1rem) clamp(0.5rem, 2vw, 0.75rem);
    vertical-align: middle;
    border-bottom: 1px solid #e9ecef;
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
  }

  /* ===== BADGE STATUS ===== */
  .badge-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: clamp(0.3rem, 1.5vw, 0.4rem) clamp(0.6rem, 2vw, 1rem);
    border-radius: 50px;
    font-weight: 500;
    font-size: clamp(0.7rem, 2vw, 0.85rem);
  }
  .badge-pending { background: var(--warning-bg); color: var(--warning-text); border: 1px solid #ffeeba; }
  .badge-approved { background: var(--success-bg); color: var(--success-text); border: 1px solid #c3e6cb; }
  .badge-rejected { background: var(--danger-bg); color: var(--danger-text); border: 1px solid #f5c6cb; }

  /* ===== TOMBOL ===== */
  .btn-gradient {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border: none;
    color: white;
    font-weight: 500;
    padding: clamp(0.4rem, 2vw, 0.6rem) clamp(1rem, 3vw, 1.5rem);
    border-radius: 50px;
    transition: var(--transition);
    box-shadow: 0 5px 15px rgba(30,58,138,0.2);
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
  }
  .btn-gradient:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); color: white; }
  .btn-outline-gradient {
    background: transparent;
    border: 2px solid var(--primary-start);
    color: var(--primary-start);
    font-weight: 500;
    padding: clamp(0.4rem, 2vw, 0.5rem) clamp(1rem, 3vw, 1.5rem);
    border-radius: 50px;
    transition: var(--transition);
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
  }
  .btn-outline-gradient:hover {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-color: transparent;
    color: white;
    transform: translateY(-3px);
  }
  .btn-icon { display: inline-flex; align-items: center; gap: 0.5rem; }
  .btn-sm { padding: clamp(0.2rem, 1.5vw, 0.3rem) clamp(0.5rem, 2vw, 0.8rem); font-size: clamp(0.7rem, 2vw, 0.8rem); }

  /* ===== GALLERY THUMBNAIL ===== */
  .gallery-thumb {
    width: clamp(45px, 10vw, 60px);
    height: clamp(45px, 10vw, 60px);
    object-fit: cover;
    border-radius: 10px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: var(--transition);
  }
  .gallery-thumb:hover { border-color: var(--primary-start); transform: scale(1.05); }

  /* ===== MODAL ===== */
  .modal-content { border: none; border-radius: clamp(1rem, 4vw, 1.5rem); overflow: hidden; }
  .modal-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    border-bottom: none;
    padding: clamp(1rem, 3vw, 1.5rem);
  }
  .modal-header .btn-close { background: rgba(255,255,255,0.8); opacity: 0.8; transition: var(--transition); }
  .modal-header .btn-close:hover { opacity: 1; transform: rotate(90deg); }
  .modal-body { padding: clamp(1rem, 4vw, 2rem); }
  .form-label { font-weight: 600; color: #2c3e50; margin-bottom: 0.5rem; font-size: clamp(0.8rem, 2.5vw, 0.9rem); }
  .form-control, .form-select { border-radius: 1rem; border: 1px solid #dee2e6; padding: clamp(0.5rem, 2vw, 0.6rem) clamp(0.8rem, 2.5vw, 1rem); font-size: clamp(0.85rem, 2.5vw, 1rem); }
  .form-control:focus, .form-select:focus { border-color: var(--primary-start); box-shadow: 0 0 0 0.25rem rgba(30,58,138,0.25); }

  /* ===== LIGHTBOX ===== */
  .lightbox-modal .modal-body { padding: 0; background: #000; }
  .lightbox-modal .carousel-item img { max-height: 80vh; object-fit: contain; width: 100%; }
  .lightbox-modal .carousel-control-prev, .lightbox-modal .carousel-control-next {
    background: rgba(0,0,0,0.3);
    width: clamp(35px, 8vw, 50px);
    height: clamp(35px, 8vw, 50px);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
  }

  /* ===== EMPTY STATE ===== */
  .empty-state { padding: clamp(1.5rem, 8vw, 4rem) clamp(1rem, 5vw, 2rem); text-align: center; background: #f8f9fa; border-radius: 1.5rem; margin: 2rem 0; }
  .empty-state i { font-size: clamp(2.5rem, 10vw, 4rem); color: #adb5bd; margin-bottom: 1rem; }
  .empty-state h4 { font-weight: 600; color: #495057; font-size: clamp(1rem, 4vw, 1.2rem); }
  .print-btn {
    background: #10b981;
    border-radius: 50px;
    padding: clamp(0.4rem, 2vw, 0.6rem) clamp(1rem, 4vw, 1.8rem);
    font-weight: 500;
    color: white;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition);
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
  }
  .print-btn:hover { background: #059669; transform: translateY(-3px); color: white; }

  /* ===== RESPONSIVE LENGKAP (SESUAI LANDING) ===== */
  @media (max-width: 768px) {
    .gallery-thumb { width: 50px; height: 50px; }
    .info-pembimbing { flex-direction: column; gap: 0.8rem; }
  }
  @media (max-width: 576px) {
    .table-container { padding: 1rem; }
    .logbook-table thead th { font-size: 0.7rem; padding: 0.5rem; }
    .logbook-table td { font-size: 0.75rem; padding: 0.5rem; }
    .nav-tabs .nav-link { padding: 0.3rem 0.8rem; font-size: 0.75rem; }
    .badge-tab { font-size: 0.6rem; }
  }
  @media (max-width: 400px) {
    .magang-header h2 { font-size: 1.2rem; }
    .magang-header p { font-size: 0.8rem; }
    .panduan-card { flex-direction: column; }
    .panduan-icon { text-align: center; }
    .logbook-table thead th { white-space: nowrap; }
  }

  /* ===== FORM LOGBOOK (relayout) ===== */
  .chip {
    border: 1px solid #cbd5e1; background: #f8fafc; color: #334155;
    border-radius: 50px; padding: 0.25rem 0.8rem; font-size: 0.8rem; line-height: 1.4;
    cursor: pointer; transition: var(--transition);
  }
  .chip:hover, .chip.active { background: var(--primary-light); border-color: var(--primary-start); color: var(--primary-start); }
  .form-control-date { max-width: 190px; }
  .logbook-form textarea { resize: vertical; }
  .modal-footer .btn { min-width: 110px; }
  /* ===== BAR NAVIGASI PEKAN ===== */
  .week-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    background: var(--primary-light); border-radius: 1rem; padding: 0.7rem 1rem; margin-bottom: 1rem;
  }
  .week-bar .judul { font-weight: 700; color: var(--primary-dark); }
  .kegiatan-cell { white-space: pre-line; min-width: 200px; }
  .hasil-line { display: block; margin-top: 0.3rem; font-size: 0.85em; color: #475569; white-space: pre-line; }
  .hasil-line .lbl { font-weight: 600; color: #0f766e; }
  .hasil-kosong { display: block; margin-top: 0.3rem; font-size: 0.8em; color: #b45309; }
  @media (max-width: 576px) { .week-bar { padding: 0.6rem; } .form-control-date { max-width: 100%; flex: 1 1 100%; } }
</style>

<div class="container mt-4">
  <!-- HEADER -->
  <div class="magang-header d-flex flex-wrap justify-content-between align-items-center">
    <div>
      <h2><i class="bi bi-journal-bookmark-fill me-2"></i>Logbook Magang</h2>
      <p class="mb-0">Catat kegiatan harian magang Anda dan pantau status verifikasi</p>
    </div>
    <% if (canSubmit && selectedPeriod) { %>
      <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#addLogbookModal">
        <i class="bi bi-plus-circle me-2"></i>Tambah Logbook
      </button>
    <% } %>
  </div>

  <!-- TAB PDK (Periode Magang) -->
  <% if (pdkList && pdkList.length > 0) { %>
    <div class="pdk-tabs">
      <ul class="nav nav-tabs">
        <% pdkList.forEach(pdk => { %>
          <li class="nav-item">
            <a class="nav-link <%= selectedPeriodId === pdk.id ? 'active' : '' %>" 
               href="/mahasiswa/magang/logbook?periodId=<%= pdk.id %>">
              <%= pdk.pdkKode %> - <%= pdk.pdkNama %>
              <% if (pdk.status === 'active') { %>
                <span class="badge bg-success badge-tab">Aktif</span>
              <% } else if (pdk.status === 'completed') { %>
                <span class="badge bg-secondary badge-tab">Arsip</span>
              <% } else { %>
                <span class="badge bg-info badge-tab">Locked</span>
              <% } %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } else { %>
    <div class="alert alert-info mb-4">
      <i class="bi bi-info-circle me-2"></i> Belum ada periode magang. Silakan mulai magang dari halaman dashboard.
    </div>
  <% } %>

  <!-- ALERT STATUS (jika tidak bisa submit) -->
  <% if (!canSubmit && selectedPeriod) { %>
    <div class="alert alert-warning mb-4">
      <i class="bi bi-exclamation-triangle me-2"></i>
      <strong>Perhatian:</strong> Periode magang ini sudah selesai (status <strong><%= selectedPeriod.status %></strong>). Logbook hanya dapat dilihat, tidak dapat ditambah/diedit/dihapus.
    </div>
  <% } %>

  <!-- PANDUAN -->
  <div class="panduan-card">
    <div class="panduan-icon"><i class="bi bi-info-circle-fill"></i></div>
    <div class="panduan-text">
      <strong>Informasi Pengisian Logbook:</strong>
      <ul>
        <li>Isi setiap hari magang: kegiatan, hasil pekerjaan, dan durasi.</li>
        <li>Halaman ini hanya menampilkan logbook pekan ini; pekan lain dibuka dengan tombol panah.</li>
        <li>Logbook akan diverifikasi oleh Dosen PA (dosen pembimbing).</li>
      </ul>
    </div>
  </div>

  <!-- INFORMASI PEMBIMBING (tambahan) -->
  <% if (pembimbing && pembimbing.pembimbing) { %>
    <div class="info-pembimbing">
      <div class="info-pembimbing-item">
        <i class="bi bi-person-badge"></i>
        <strong>Dosen Pembimbing (Dosen PA):</strong> <%= pembimbing.pembimbing.nama %>
      </div>
    </div>
  <% } %>

  <!-- TABEL LOGBOOK -->
  <%
    const BLN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
    const fTgl = (iso) => { const q = String(iso || '').split('-'); return q.length === 3 ? parseInt(q[2],10) + ' ' + BLN[parseInt(q[1],10)-1] : ''; };
    const fTglTh = (iso) => { const q = String(iso || '').split('-'); return q.length === 3 ? fTgl(iso) + ' ' + q[0] : ''; };
    const HARI = ['Ahad','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
    const namaHari = (iso) => { const d = new Date(String(iso).substring(0,10) + 'T00:00:00Z'); return isNaN(d) ? '' : HARI[d.getUTCDay()]; };
    const fJam = (n) => String(Number(Number(n || 0).toFixed(2)));
    const base = selectedPeriod ? '/mahasiswa/magang/logbook?periodId=' + selectedPeriod.id : '';
    const mingguVal = minggu && minggu.mingguKe ? minggu.mingguKe : '';
  %>
  <div class="table-container">

    <% if (selectedPeriod && minggu) { %>
      <div class="week-bar">
        <% if (minggu.mingguKe) { %>
          <a class="btn btn-sm btn-outline-secondary <%= minggu.adaSebelumnya ? '' : 'disabled' %>"
             href="<%= minggu.adaSebelumnya ? base + '&minggu=' + (minggu.mingguKe - 1) : '#' %>" aria-label="Minggu sebelumnya">
            <i class="bi bi-chevron-left"></i>
          </a>
        <% } else { %><span></span><% } %>
        <div class="text-center">
          <div class="judul">
            <%= minggu.mingguKe ? 'Minggu ke-' + minggu.mingguKe : '7 hari terakhir' %>
            <% if (minggu.adalahPekanIni) { %><span class="badge bg-success ms-1">Pekan ini</span><% } %>
          </div>
          <small class="text-muted"><%= fTgl(minggu.awal) %> – <%= fTglTh(minggu.akhir) %> · <%= logbook.length %> entri · <%= fJam(totalJamMinggu) %> jam</small>
        </div>
        <% if (minggu.mingguKe) { %>
          <a class="btn btn-sm btn-outline-secondary <%= minggu.adaBerikutnya ? '' : 'disabled' %>"
             href="<%= minggu.adaBerikutnya ? base + '&minggu=' + (minggu.mingguKe + 1) : '#' %>" aria-label="Minggu berikutnya">
            <i class="bi bi-chevron-right"></i>
          </a>
        <% } else { %><span></span><% } %>
      </div>
    <% } else if (selectedPeriod && modeRiwayat) { %>
      <div class="week-bar">
        <div class="judul"><i class="bi bi-clock-history me-1"></i> Riwayat semua logbook</div>
        <a class="btn btn-sm btn-outline-primary" href="<%= base %>"><i class="bi bi-calendar-week"></i> Kembali ke pekan ini</a>
      </div>
    <% } %>

    <div class="table-responsive">
      <table class="table logbook-table">
        <thead>
          <tr>
            <th>Tanggal</th>
            <th>Kegiatan &amp; Hasil</th>
            <th>Durasi</th>
            <th>Foto</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!selectedPeriod) { %>
            <tr><td colspan="6" class="text-center py-5">
              <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h4>Pilih Periode Magang</h4>
                <p>Silakan pilih periode magang dari tab di atas untuk melihat logbook.</p>
              </div>
            </td></tr>
          <% } else if (logbook.length === 0) { %>
            <tr><td colspan="6" class="text-center py-5">
              <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h4><%= modeRiwayat ? 'Belum Ada Catatan' : 'Belum ada catatan di pekan ini' %></h4>
                <p><%= modeRiwayat ? 'Mulai tambahkan logbook pertama Anda untuk periode ' + selectedPeriod.pdkNama + '.' : 'Catat kegiatan magang Anda hari ini.' %></p>
                <% if (canSubmit) { %>
                  <button class="btn btn-gradient mt-3" data-bs-toggle="modal" data-bs-target="#addLogbookModal">
                    <i class="bi bi-plus-circle"></i> Tambah Logbook
                  </button>
                <% } %>
              </div>
            </td></tr>
          <% } else { %>
            <% logbook.forEach(item => { %>
              <tr>
                <td>
                  <span class="fw-semibold"><%= namaHari(item.tanggal) %></span><br>
                  <small class="text-muted"><%= fTglTh(item.tanggal) %></small>
                </td>
                <td class="kegiatan-cell">
                  <%= item.kegiatan || '-' %>
                  <% if (item.hasil) { %>
                    <span class="hasil-line"><span class="lbl">Hasil:</span> <%= item.hasil %></span>
                  <% } else if (canSubmit && item.status === 'pending') { %>
                    <span class="hasil-kosong"><i class="bi bi-info-circle"></i> Hasil pekerjaan belum diisi</span>
                  <% } %>
                  <% if (item.lokasi) { %><small class="d-block text-muted mt-1"><i class="bi bi-geo-alt"></i> <%= item.lokasi %></small><% } %>
                </td>
                <td><%= item.durasi ? item.durasi + ' jam' : '-' %></td>
                <td>
                  <% if (item.imageUrls && item.imageUrls.length > 0) {
                    const firstUrl = item.imageUrls[0];
                    const fileIdMatch = firstUrl.match(/[?&]id=([^&]+)/);
                    const fileId = fileIdMatch ? fileIdMatch[1] : (firstUrl.match(/\/d\/([^\/]+)/) || [])[1];
                    const thumbUrl = fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w100` : firstUrl;
                  %>
                    <img src="<%= thumbUrl %>" loading="lazy" class="gallery-thumb" onclick='lihatGambar(<%= JSON.stringify(item.imageUrls) %>)' alt="dokumentasi" onerror="this.onerror=null; this.src='<%= firstUrl %>';">
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td>
                  <% if (item.status === 'pending') { %>
                    <span class="badge-status badge-pending"><i class="bi bi-hourglass-split"></i> Menunggu</span>
                  <% } else if (item.status === 'approved') { %>
                    <span class="badge-status badge-approved"><i class="bi bi-check-circle"></i> Disetujui</span>
                    <% if (item.approvedByNama) { %>
                      <div class="small text-muted mt-1">Oleh: <%= item.approvedByNama %></div>
                    <% } %>
                    <% if (item.catatan) { %>
                      <div class="small text-muted mt-1"><i class="bi bi-chat-left-text"></i> <%= item.catatan %></div>
                    <% } %>
                  <% } else if (item.status === 'rejected') { %>
                    <span class="badge-status badge-rejected"><i class="bi bi-x-circle"></i> Ditolak</span>
                    <% if (item.rejectedByNama) { %>
                      <div class="small text-muted mt-1">Oleh: <%= item.rejectedByNama %></div>
                    <% } %>
                  <% } %>
                </td>
                <td>
                  <% if (canSubmit && item.status === 'pending') { %>
                    <div class="d-flex gap-2">
                      <button class="btn btn-sm btn-warning btn-icon" onclick="editLogbook('<%= item.id %>')" title="Edit"><i class="bi bi-pencil"></i></button>
                      <form method="POST" action="/mahasiswa/magang/logbook/<%= item.id %>/delete" style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus logbook ini?')">
                        <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
                        <input type="hidden" name="minggu" value="<%= mingguVal %>">
                        <button type="submit" class="btn btn-sm btn-danger btn-icon" title="Hapus"><i class="bi bi-trash"></i></button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <%- include('../../partials/pagination', { pageInfo: typeof pageInfo !== 'undefined' ? pageInfo : null, showAll: typeof showAll !== 'undefined' ? showAll : false, pageListUrl: typeof pageListUrl !== 'undefined' ? pageListUrl : '?' }) %>

    <% if (selectedPeriod && !modeRiwayat && totalLogbook > 0) { %>
      <div class="text-center mt-2">
        <a href="<%= base %>&semua=1" class="small text-decoration-none">
          <i class="bi bi-clock-history"></i> Lihat riwayat semua logbook (<%= totalLogbook %> entri)
        </a>
      </div>
    <% } %>

    <% if (selectedPeriod && totalLogbook > 0) { %>
      <div class="mt-4 text-end">
        <a href="/mahasiswa/magang/logbook-print?periodId=<%= selectedPeriod.id %>" class="print-btn" target="_blank">
          <i class="bi bi-file-earmark-text"></i> Pratinjau &amp; Cetak Logbook
        </a>
      </div>
    <% } %>
    <% if (selectedPeriod) { %>
      <div class="mt-2 text-end">
        <a href="/mahasiswa/magang/form-penilaian?jenis=lapangan&periodId=<%= selectedPeriod.id %>" class="print-btn" target="_blank">
          <i class="bi bi-printer"></i> Cetak Form Penilaian Pendamping Lapangan
        </a>
      </div>
    <% } %>
  </div>
</div>

<!-- MODAL TAMBAH LOGBOOK -->
