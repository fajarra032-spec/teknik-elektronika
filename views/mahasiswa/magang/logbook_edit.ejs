<%- include('../../partials/header') %>

<style>
  .form-label { font-weight: 600; color: #2c3e50; margin-bottom: 0.5rem; }
  .form-control, .form-select { border-radius: 1rem; border: 1px solid #dee2e6; padding: 0.6rem 1rem; }
  .form-control:focus, .form-select:focus { border-color: #1e3a8a; box-shadow: 0 0 0 0.25rem rgba(30,58,138,0.25); }
</style>

<div class="container mt-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-journal-text me-2"></i><%= title %></h4>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">
      <form method="POST" action="/mahasiswa/magang/logbook/<%= logbook.id %>/edit" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="tanggal" class="form-label">Tanggal Kegiatan <span class="text-danger">*</span></label>
          <input type="date" class="form-control" id="tanggal" name="tanggal" value="<%= logbook.tanggal %>" required>
        </div>
        <div class="mb-3">
          <label for="lokasi" class="form-label">Lokasi</label>
          <input type="text" class="form-control" id="lokasi" name="lokasi" value="<%= logbook.lokasi || '' %>">
        </div>
        <div class="mb-3">
          <label for="durasi" class="form-label">Durasi (jam)</label>
          <input type="number" class="form-control" id="durasi" name="durasi" step="0.5" min="0" value="<%= logbook.durasi || '' %>">
        </div>
        <div class="mb-3">
          <label for="kegiatan" class="form-label">Deskripsi Kegiatan <span class="text-danger">*</span></label>
          <textarea class="form-control" id="kegiatan" name="kegiatan" rows="3" required maxlength="1000"><%= logbook.kegiatan || '' %></textarea>
        </div>
        <div class="mb-3">
          <label for="hasil" class="form-label">Hasil pekerjaan</label>
          <textarea class="form-control" id="hasil" name="hasil" rows="2" maxlength="1000" placeholder="Contoh: Panel terpasang dan lolos uji tegangan"><%= logbook.hasil || '' %></textarea>
          <div class="form-text">Ikut tercetak di kolom "Hasil pekerjaan" lembar logbook mingguan.</div>
        </div>

        <% if (logbook.imageUrls && logbook.imageUrls.length > 0) { %>
          <div class="mb-3">
            <label class="form-label">Dokumentasi Saat Ini <span class="text-muted fw-normal">(caption ikut tercetak di Dokumentasi Mingguan)</span></label>
            <div class="d-flex flex-column gap-2">
              <% logbook.imageUrls.forEach(function(url, i) { %>
                <div class="d-flex gap-2 align-items-center">
                  <img src="<%= url %>" width="56" height="56" class="rounded" style="object-fit:cover;flex:0 0 auto;">
                  <input type="text" class="form-control form-control-sm" name="captionsLama" maxlength="200"
                         value="<%= (logbook.imageCaptions && logbook.imageCaptions[i]) || '' %>"
                         placeholder="Caption foto <%= i + 1 %> (kosong = pakai uraian kegiatan)">
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div class="mb-3">
          <label for="images" class="form-label">Tambah Dokumentasi Baru (Maks 5 gambar)</label>
          <input type="file" class="form-control" id="images" name="images" accept="image/*" multiple>
          <div class="form-text">Gambar baru akan ditambahkan ke dokumentasi yang sudah ada.</div>
          <div id="captionsBaru" class="d-flex flex-column gap-2 mt-2"></div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Simpan Perubahan</button>
          <a href="javascript:history.back()" class="btn btn-light">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    var img = document.getElementById('images'), box = document.getElementById('captionsBaru');
    if (!img || !box) return;
    img.addEventListener('change', function () {
      box.innerHTML = '';
      if (img.files.length > 5) { alert('Maksimal 5 foto.'); img.value = ''; return; }
      Array.prototype.forEach.call(img.files, function (f, i) {
        var inp = document.createElement('input');
        inp.type = 'text'; inp.name = 'captions'; inp.maxLength = 200;
        inp.className = 'form-control form-control-sm';
        inp.placeholder = 'Caption foto baru ' + (i + 1) + ' (kosong = pakai uraian kegiatan)';
        box.appendChild(inp);
      });
    });
  })();
</script>

<%- include('../../partials/footer') %>
