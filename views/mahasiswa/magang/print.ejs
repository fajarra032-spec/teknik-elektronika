<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Cetak Logbook' %> - <%= mahasiswa.nama %></title>
  <style>
    /* =====================================================================
       DASAR
       Tanpa framework eksternal supaya hasil PDF (puppeteer) selalu sama
       dengan tampilan layar/cetak, termasuk bila server tanpa internet.
       ===================================================================== */
    :root {
      --brand: #0b66c3;
      --brand-dark: #0a3d7a;
      --gold: #f2b705;
      --soft: #f2f7fd;
      --soft-2: #f8fbff;
      --line: #d3e0ef;
      --ink: #172033;
      --muted: #667085;
      --pv: 1; /* skala pratinjau di layar kecil (diatur skrip) */
    }
    * { box-sizing: border-box; }
    @page { size: A4; margin: 0; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: Calibri, Carlito, 'Segoe UI', 'Liberation Sans', Arial, Helvetica, sans-serif;
      color: var(--ink);
      font-size: 10.5pt;
      line-height: 1.35;
      background: #e9edf3;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      -webkit-font-smoothing: antialiased;
    }
    .text-center { text-align: center; }
    .fst-italic { font-style: italic; }
    .text-muted { color: var(--muted); }
    .fw-bold { font-weight: 700; }
    .py-4 { padding-top: 1.5rem; padding-bottom: 1.5rem; }
    .mb-0 { margin-bottom: 0; }

    /* =====================================================================
       TOOLBAR PRATINJAU (tidak ikut tercetak / masuk PDF)
       ===================================================================== */
    .toolbar {
      position: sticky; top: 0; z-index: 50;
      display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; justify-content: space-between;
      padding: .65rem 1rem; background: #1b2a4a; color: #fff; font-size: 13px;
      font-family: Arial, Helvetica, sans-serif;
    }
    .toolbar a, .toolbar button {
      font: inherit; font-weight: 600; border: 0; border-radius: 8px; padding: .45rem .9rem;
      cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: .4rem;
    }
    .toolbar .kembali { background: rgba(255,255,255,.14); color: #fff; }
    .toolbar .pdf { background: #10b981; color: #fff; }
    .toolbar .cetak { background: #fff; color: #1e3a8a; }
    .toolbar .info { opacity: .85; font-size: 12px; flex: 1 1 260px; text-align: center; }
    .toolbar .aksi { display: flex; gap: .5rem; }
    .toolbar svg { width: 15px; height: 15px; fill: currentColor; }

    /* =====================================================================
       KERTAS A4
       Setiap .sheet = tepat 1 halaman A4. Isi diukur oleh skrip di bawah;
       bila meluber, isi diperkecil otomatis (paksa muat) - tidak pernah
       terpotong dan tidak pernah menjadi 2 halaman.
       ===================================================================== */
    .preview {
      display: flex; flex-direction: column; align-items: center; gap: 18px;
      padding: 18px 0 40px; zoom: var(--pv);
    }
    .sheet {
      width: 210mm; height: 296.4mm; /* sedikit < 297mm agar tidak memicu halaman kosong */
      padding: 11mm 14mm 9mm;
      background: #fff; position: relative; overflow: hidden;
      box-shadow: 0 6px 24px rgba(27,42,74,.18);
      break-after: page; page-break-after: always;
    }
    .sheet:last-child { break-after: auto; page-break-after: auto; }
    .sheet-inner {
      transform-origin: top left;
      display: flex; flex-direction: column;
      width: 100%; height: 100%;
    }

    /* =====================================================================
       LEMBAR LOGBOOK MINGGUAN
       ===================================================================== */
    .kop { display: flex; align-items: center; gap: 12px; }
    .kop img { width: 15mm; height: 15mm; object-fit: contain; flex: 0 0 auto; }
    .kop .nama { margin: 0; font-family: Arial, Helvetica, sans-serif; font-weight: 800; font-size: 21pt; line-height: 1.1; letter-spacing: .2px; color: var(--brand); text-transform: uppercase; }
    .kop .alamat { margin: 3px 0 0; font-family: Arial, Helvetica, sans-serif; font-size: 7.4pt; color: #475467; }
    .kop-bar { height: 3px; border-radius: 3px; margin: 8px 0 10px; background: linear-gradient(90deg, var(--brand) 0%, var(--brand) 70%, var(--gold) 100%); }

    .judul { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .judul h1 { margin: 0; font-size: 14pt; letter-spacing: 1.2px; color: var(--brand-dark); font-weight: 800; }
    .judul .minggu { background: var(--brand); color: #fff; font-weight: 700; font-size: 9.5pt; padding: 3px 12px; border-radius: 50px; }

    .identitas {
      display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 7px 14px;
      background: var(--soft); border: 1px solid var(--line); border-radius: 9px;
      padding: 8px 12px; margin-bottom: 10px;
    }
    .identitas .span2 { grid-column: span 2; }
    .identitas .span3 { grid-column: span 3; }
    .identitas .lbl { display: block; font-size: 7pt; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); font-weight: 700; }
    .identitas .val { display: block; font-size: 10.5pt; font-weight: 700; min-height: 1.35em; overflow-wrap: anywhere; }

    .tabel-bungkus { border: 1px solid var(--line); border-radius: 9px; overflow: hidden; }
    table.minggu { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.minggu th {
      background: var(--brand-dark); color: #fff; text-align: left; font-size: 9pt; letter-spacing: .3px;
      padding: 6px 8px; border-right: 1px solid rgba(255,255,255,.18); vertical-align: middle;
    }
    table.minggu th:last-child, table.minggu td:last-child { border-right: 0; }
    table.minggu th.c, table.minggu td.c { text-align: center; }
    table.minggu td {
      padding: 5px 8px; vertical-align: top; font-size: 9.6pt;
      border-top: 1px solid var(--line); border-right: 1px solid var(--line);
      overflow-wrap: anywhere; word-break: break-word;
    }
    table.minggu tbody tr.hari:nth-child(even) td { background: var(--soft-2); }
    table.minggu tr.hari { height: 12.5mm; }
    table.minggu td.hari-col { font-weight: 700; color: var(--brand-dark); }
    table.minggu tr.akhir-pekan td.hari-col { color: #b45309; }
    table.minggu .tgl { display: block; font-weight: 400; font-size: 7.8pt; color: var(--muted); margin-top: 1px; }
    table.minggu .multi { white-space: pre-line; }
    table.minggu .multi + .multi { margin-top: 3px; }
    table.minggu td.durasi { vertical-align: middle; font-weight: 700; }
    table.minggu tr.total td { background: var(--soft); font-weight: 800; color: var(--brand-dark); vertical-align: middle; padding: 6px 8px; }

    .ringkasan { margin-top: 10px; }
    .ringkasan h2 { margin: 0 0 6px; font-size: 10.5pt; color: var(--brand-dark); letter-spacing: .4px; }
    .kotak-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .kotak {
      border: 1px solid var(--line); border-left: 4px solid var(--brand); border-radius: 8px;
      background: #fff; padding: 6px 10px; min-height: 24mm;
    }
    .kotak.kendala { border-left-color: var(--gold); }
    .kotak.catatan { grid-column: span 2; min-height: 17mm; border-left-color: #10b981; }
    .kotak .jdl { font-size: 8.4pt; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .4px; margin-bottom: 2px; }
    .kotak .isi-teks { font-size: 10pt; white-space: pre-line; overflow-wrap: anywhere; }

    /* Elemen konten tidak boleh menyusut (kalau menyusut, isi terpotong dan
       skrip tidak tahu bahwa isinya meluber). Hanya .spacer yang lentur. */
    .sheet-inner > * { flex-shrink: 0; }
    .spacer { flex: 1 1 0; min-height: 0; flex-shrink: 1 !important; }

    .blok-ttd { display: flex; justify-content: flex-end; margin-top: 10px; break-inside: avoid; }
    .ttd { width: 74mm; font-size: 9.8pt; }
    .ttd .tgl-isi { display: inline-block; min-width: 38mm; height: 1.5em; vertical-align: middle; background: var(--soft); border-radius: 5px; margin-left: 4px; }
    .ttd .area { height: 17mm; }
    .ttd .nama { font-weight: 800; min-height: 1.35em; }
    .ttd .cap { font-size: 8.4pt; color: var(--muted); }

    .footer-cetak {
      margin-top: 8px; padding-top: 5px; border-top: 1px solid var(--line);
      font-size: 7pt; color: #8a94a6; display: flex; justify-content: space-between; align-items: center;
      font-family: Arial, Helvetica, sans-serif;
    }
    .kode-validasi { font-size: 7.5pt; color: #98a2b3; }

    /* ===== DOKUMENTASI MINGGUAN (halaman foto setelah lembar logbook) ===== */
    .foto-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px; margin-top: 2px; }
    .foto-item { border: 1px solid var(--line); border-radius: 9px; overflow: hidden; background: #fff; break-inside: avoid; }
    .foto-item .foto-img { height: 50mm; background: var(--soft); display: flex; align-items: center; justify-content: center; }
    .foto-item .foto-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .foto-item .foto-cap { padding: 5px 8px 6px; border-top: 1px solid var(--line); min-height: 15mm; }
    .foto-item .foto-no { display: inline-block; background: var(--brand); color: #fff; font-weight: 700; font-size: 7.5pt; padding: 1px 7px; border-radius: 50px; margin-right: 5px; }
    .foto-item .foto-tgl { font-size: 7.8pt; font-weight: 700; color: var(--brand-dark); }
    .foto-item .foto-teks { margin-top: 2px; font-size: 9pt; line-height: 1.3; overflow-wrap: anywhere;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .identitas.ringkas { grid-template-columns: 2fr 1fr 1.4fr; }

    /* ===== DAFTAR HADIR (per bulan, tanpa kolom ttd) ===== */
    .hadir-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; margin-bottom: 8px; }
    .hadir-strip .k { border: 1px solid var(--line); border-radius: 8px; background: var(--soft-2); padding: 4px 10px; }
    .hadir-strip .k b { display: block; font-size: 13pt; color: var(--brand-dark); line-height: 1.15; }
    .hadir-strip .k span { font-size: 7pt; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); font-weight: 700; }
    .tabel-hadir-bungkus { border: 1px solid var(--line); border-radius: 9px; overflow: hidden; }
    table.hadir { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.hadir th {
      background: var(--brand-dark); color: #fff; font-size: 8pt; letter-spacing: .3px; text-align: center;
      padding: 4px 6px; border-right: 1px solid rgba(255,255,255,.18);
    }
    table.hadir th:last-child, table.hadir td:last-child { border-right: 0; }
    table.hadir td {
      text-align: center; font-size: 8.4pt; padding: 1.6px 6px; line-height: 1.25;
      border-top: 1px solid var(--line); border-right: 1px solid var(--line);
    }
    table.hadir td.kiri { text-align: left; }
    table.hadir tr.ada td { background: #fff; }
    table.hadir tr.kosong td { color: #b0b8c6; background: var(--soft-2); }
    table.hadir tr.libur td { background: #fff8e6; color: #b45309; }
    table.hadir tr.libur.ada td { background: #fff3d1; color: var(--ink); }
    table.hadir .hdr { display: inline-block; background: #dcfce7; color: #166534; font-weight: 700; font-size: 7.4pt; padding: 0 8px; border-radius: 50px; }
    table.hadir tr.total td { background: var(--soft); font-weight: 800; color: var(--brand-dark); padding: 4px 6px; }
    .catatan-hadir { margin: 5px 2px 0; font-size: 7.4pt; color: var(--muted); }

    /* ===== LEMBAR PENGESAHAN ===== */
    .hero-durasi {
      display: flex; align-items: center; gap: 14px; margin-bottom: 9px;
      background: linear-gradient(120deg, var(--brand-dark), var(--brand)); color: #fff; border-radius: 11px; padding: 10px 16px;
    }
    .hero-durasi .besar { font-size: 24pt; font-weight: 800; line-height: 1.05; letter-spacing: .3px; white-space: nowrap; }
    .hero-durasi .kecil { font-size: 9pt; opacity: .92; line-height: 1.4; }
    .hero-durasi .lbl { font-size: 7.4pt; text-transform: uppercase; letter-spacing: .8px; opacity: .8; font-weight: 700; }
    .narasi { font-size: 9.8pt; line-height: 1.5; text-align: justify; margin: 0 0 9px; }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; margin-bottom: 7px; }
    .kpi { border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: 8px; background: #fff; padding: 5px 9px; }
    .kpi:nth-child(4n+2) { border-top-color: #10b981; }
    .kpi:nth-child(4n+3) { border-top-color: var(--gold); }
    .kpi:nth-child(4n+4) { border-top-color: #8b5cf6; }
    .kpi b { display: block; font-size: 14pt; color: var(--brand-dark); line-height: 1.15; }
    .kpi span { font-size: 7pt; text-transform: uppercase; letter-spacing: .4px; color: var(--muted); font-weight: 700; }
    .kpi small { display: block; font-size: 7.4pt; color: var(--muted); }
    .chart-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 8px; margin: 2px 0 8px; }
    .chart-box { border: 1px solid var(--line); border-radius: 9px; padding: 6px 10px 7px; }
    .chart-box h3 { margin: 0 0 5px; font-size: 8.6pt; color: var(--brand-dark); text-transform: uppercase; letter-spacing: .4px; }
    .vbar { display: flex; align-items: flex-end; gap: 3px; height: 30mm; border-bottom: 1px solid var(--line); }
    .vbar .col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; }
    .vbar .col i { display: block; width: 100%; max-width: 15px; background: var(--brand); border-radius: 3px 3px 0 0; min-height: 1px; }
    .vbar .col i.nol { background: var(--line); }
    .vbar .col em { font-style: normal; font-size: 5.8pt; color: var(--muted); margin-bottom: 1px; }
    .vlabel { display: flex; gap: 3px; margin-top: 2px; }
    .vlabel span { flex: 1 1 0; text-align: center; font-size: 6.2pt; color: var(--muted); min-width: 0; }
    .hbar { margin-bottom: 5px; }
    .hbar .row1 { display: flex; justify-content: space-between; font-size: 8pt; margin-bottom: 1px; }
    .hbar .trek { height: 8px; background: var(--soft); border-radius: 50px; overflow: hidden; }
    .hbar .isi { height: 100%; background: linear-gradient(90deg, #10b981, #34d399); border-radius: 50px; }
    .wawasan { margin: 0 0 8px; padding: 6px 10px 6px 12px; border-left: 4px solid var(--gold); background: #fffbeb; border-radius: 0 8px 8px 0; font-size: 9pt; line-height: 1.45; }
    .wawasan b { color: var(--brand-dark); }
    .pengesahan-teks { font-size: 9.6pt; text-align: justify; margin: 0 0 4px; }
    .blok-ttd2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12mm; margin-top: 6px; break-inside: avoid; }
    .blok-ttd2 .ttd { width: auto; }
    .blok-ttd2 .area { height: 20mm; }

    /* =====================================================================
       CETAK / PDF
       ===================================================================== */

    /* ===== WATERMARK "BELUM KONSULTASI" (lembar mingguan yang belum disetujui dosen) ===== */
    .watermark {
      position: absolute; left: 0; right: 0; top: 50%; z-index: 20; pointer-events: none;
      transform: translateY(-50%) rotate(-30deg); text-align: center;
      font-family: Arial, Helvetica, sans-serif; font-weight: 900; font-size: 60pt; letter-spacing: 4px;
      color: rgba(200, 30, 30, .17); white-space: nowrap; text-transform: uppercase;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }
    .watermark small { display: block; font-size: 15pt; letter-spacing: 2px; font-weight: 700; margin-top: 4px; color: rgba(200, 30, 30, .22); }
    .kotak.dosen { grid-column: span 2; min-height: 17mm; border-left-color: #7c3aed; }
    .kotak .meta-konsul { font-size: 8pt; color: var(--muted); margin-top: 3px; }
    .stempel-ok { display: inline-block; font-size: 7.8pt; font-weight: 800; color: #047857; background: #d1fae5; border-radius: 50px; padding: 1px 9px; margin-left: 6px; letter-spacing: .3px; }
    .stempel-no { display: inline-block; font-size: 7.8pt; font-weight: 800; color: #b91c1c; background: #fee2e2; border-radius: 50px; padding: 1px 9px; margin-left: 6px; letter-spacing: .3px; }

    /* ===== LEMBAR KONSULTASI (halaman kesimpulan) ===== */
    table.konsul { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.konsul th { background: var(--brand-dark); color: #fff; font-size: 8.6pt; padding: 5px 6px; text-align: left; border-right: 1px solid rgba(255,255,255,.18); }
    table.konsul td { font-size: 8.8pt; padding: 4px 6px; vertical-align: top; border-top: 1px solid var(--line); border-right: 1px solid var(--line); overflow-wrap: anywhere; }
    table.konsul th:last-child, table.konsul td:last-child { border-right: 0; }
    table.konsul tbody tr:nth-child(even) td { background: var(--soft-2); }
    table.konsul td.c, table.konsul th.c { text-align: center; }
    table.konsul td.belum { color: #b91c1c; font-weight: 700; }
    table.konsul td.sudah { color: #047857; font-weight: 700; }

    @media print {
      body { background: #fff; }
      .toolbar { display: none !important; }
      .preview { display: block; padding: 0; gap: 0; zoom: 1 !important; }
      .sheet { box-shadow: none; margin: 0; }
    }
    body.pdf-mode { background: #fff; }
    body.pdf-mode .toolbar { display: none !important; }
    body.pdf-mode .preview { display: block; padding: 0; gap: 0; zoom: 1 !important; }
    body.pdf-mode .sheet { box-shadow: none; }
    @media screen and (max-width: 640px) { .toolbar .info { display: none; } }
  </style>
</head>
<body class="<%= (typeof pdfMode !== 'undefined' && pdfMode) ? 'pdf-mode' : '' %>">
<%
  // ---------- Bantu tampilan ----------
  const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  const fmtTgl = (iso) => {           // 2025-11-05 -> 05 Nov 2025
    if (!iso) return '';
    const p = String(iso).substring(0, 10).split('-');
    if (p.length !== 3) return '';
    return p[2] + ' ' + BULAN[parseInt(p[1], 10) - 1].substring(0, 3) + ' ' + p[0];
  };
  const fmtTglPendek = (iso) => {     // 2025-11-05 -> 05-11-2025
    if (!iso) return '';
    const p = String(iso).substring(0, 10).split('-');
    return p.length === 3 ? p[2] + '-' + p[1] + '-' + p[0] : '';
  };
  const fmtJam = (n) => (n ? String(Number(Number(n).toFixed(2))) : '');
  const namaBulan = (iso) => {
    if (!iso) return '';
    const p = String(iso).substring(0, 10).split('-');
    return p.length === 3 ? BULAN[parseInt(p[1], 10) - 1] + ' ' + p[0] : '';
  };

  const namaTempat = (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.nama) ? pdkInfo.perusahaan.nama : '';
  const namaPendamping = (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.pembimbingLapangan) ? pdkInfo.perusahaan.pembimbingLapangan : '';
  const LOGO_URL = 'https://polidewa.ac.id/wp-content/uploads/2025/11/Desain-tanpa-judul-1.png';

  // Belum ada data sama sekali -> tetap cetak 1 lembar kosong (bisa dipakai sebagai formulir)
  const HARI_KOSONG = ['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Ahad'].map(h => ({ hari: h, tanggal: null, entries: [], durasi: 0 }));
  const lembarList = (mingguGroups && mingguGroups.length > 0)
    ? mingguGroups
    : [{ mingguKe: '', bulanKe: '', periodeAwal: '', periodeAkhir: '', rows: HARI_KOSONG, totalDurasi: 0, entries: [] }];
  const totalHadir = (kehadiranGroups && kehadiranGroups.length > 0) ? kehadiranGroups.length : 1;
  const totalHalFoto = lembarList.reduce((n, g) => n + ((g.halamanFoto && g.halamanFoto.length) || 0), 0);
%>

<% if (!(typeof pdfMode !== 'undefined' && pdfMode)) { %>
<div class="toolbar">
  <a class="kembali" href="<%= (typeof urlKembali !== 'undefined' && urlKembali) ? urlKembali : '#' %>" id="btnKembali">
    <svg viewBox="0 0 16 16"><path d="M10 12.5 5.5 8 10 3.5l1 1L7.5 8l3.5 3.5z"/></svg> Kembali
  </a>
  <div class="info">
    <strong>Pratinjau Logbook</strong> &middot; <%= lembarList.length %> lembar mingguan<% if (totalHalFoto) { %> + <%= totalHalFoto %> hal. dokumentasi<% } %> + <%= totalHadir %> daftar hadir + lembar pengesahan + lembar konsultasi &middot; setiap lembar otomatis pas A4
  </div>
  <div class="aksi">
    <a class="pdf" href="<%= (typeof pdfUrl !== 'undefined' && pdfUrl) ? pdfUrl : '#' %>" id="btnPdf">
      <svg viewBox="0 0 16 16"><path d="M8 11.5 4 7.5l1-1 2.3 2.3V2h1.4v6.8L11 6.5l1 1z"/><path d="M3 12h10v1.5H3z"/></svg> Unduh PDF
    </a>
    <button class="cetak" type="button" onclick="window.print()">
      <svg viewBox="0 0 16 16"><path d="M4 2h8v3H4zM3 6h10a1.5 1.5 0 0 1 1.5 1.5V11H12v3H4v-3H1.5V7.5A1.5 1.5 0 0 1 3 6zm2.5 6.5h5v-3h-5z"/></svg> Cetak
    </button>
  </div>
</div>
<% } %>

<div class="preview" id="preview">

<% lembarList.forEach((grup) => {
     const mPendamping = masukanMap ? masukanMap[grup.mingguKe + '_pendamping'] : null;
     const mKompetensi = masukanMap ? masukanMap[grup.mingguKe + '_kompetensi'] : null;
     const mKendala    = masukanMap ? masukanMap[grup.mingguKe + '_kendala'] : null;
%>
  <section class="sheet">
    <% if (grup.mingguKe && !grup.disetujui) { %><div class="watermark">Belum Konsultasi<small>Menunggu persetujuan Dosen Pembimbing</small></div><% } %>
    <div class="sheet-inner">

      <div class="kop">
        <img src="<%= LOGO_URL %>" alt="Logo Politeknik Dewantara">
        <div>
          <h2 class="nama">Politeknik Dewantara</h2>
          <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7 Palopo, Sulawesi Selatan &middot; Website: polidewa.ac.id</p>
        </div>
      </div>
      <div class="kop-bar"></div>

      <div class="judul">
        <h1>LOGBOOK MAGANG</h1>
        <% if (grup.mingguKe) { %><span class="minggu">Minggu ke-<%= grup.mingguKe %></span><% } %>
      </div>

      <div class="identitas">
        <div class="span2"><span class="lbl">Nama mahasiswa</span><span class="val"><%= mahasiswa.nama %></span></div>
        <div><span class="lbl">NIM</span><span class="val"><%= mahasiswa.nim %></span></div>
        <div class="span3"><span class="lbl">Nama tempat magang</span><span class="val"><%= namaTempat %></span></div>
        <div><span class="lbl">Minggu ke</span><span class="val"><%= grup.mingguKe %></span></div>
        <div><span class="lbl">Bulan</span><span class="val"><% if (grup.bulanKe) { %>ke-<%= grup.bulanKe %> (<%= namaBulan(grup.periodeAwal) %>)<% } %></span></div>
        <div><span class="lbl">Periode</span><span class="val"><% if (grup.periodeAwal) { %><%= fmtTgl(grup.periodeAwal) %> s.d. <%= fmtTgl(grup.periodeAkhir) %><% } %></span></div>
      </div>

      <div class="tabel-bungkus">
        <table class="minggu">
          <colgroup><col style="width:15%"><col style="width:34%"><col style="width:36%"><col style="width:15%"></colgroup>
          <thead>
            <tr>
              <th>Hari/Tanggal</th>
              <th>Kegiatan atau pekerjaan utama</th>
              <th>Hasil pekerjaan</th>
              <th class="c">Durasi (jam)</th>
            </tr>
          </thead>
          <tbody>
            <% grup.rows.forEach((row) => { %>
              <tr class="hari <%= (row.hari === 'Sabtu' || row.hari === 'Ahad') ? 'akhir-pekan' : '' %>">
                <td class="hari-col"><%= row.hari %><% if (row.tanggal) { %><span class="tgl"><%= fmtTglPendek(row.tanggal) %></span><% } %></td>
                <td>
                  <% row.entries.forEach((e, i) => { %>
                    <div class="multi"><%= row.entries.length > 1 ? (i + 1) + '. ' : '' %><%= e.kegiatan %></div>
                  <% }) %>
                </td>
                <td>
                  <%
                    // "Hasil pekerjaan": kolom `hasil` bila ada, cadangan `keterangan`
                    const hasilList = row.entries.map(e => e.hasil || e.keterangan || '');
                  %>
                  <% hasilList.forEach((h, i) => { if (!h) return; %>
                    <div class="multi"><%= row.entries.length > 1 ? (i + 1) + '. ' : '' %><%= h %></div>
                  <% }) %>
                </td>
                <td class="c durasi"><%= fmtJam(row.durasi) %></td>
              </tr>
            <% }) %>
            <tr class="total">
              <td colspan="3">Total</td>
              <td class="c"><%= grup.totalDurasi ? fmtJam(grup.totalDurasi) : '...' %> jam</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="ringkasan">
        <h2>Ringkasan Mingguan</h2>
        <div class="kotak-grid">
          <div class="kotak">
            <div class="jdl">Kompetensi/keterampilan yang dipelajari</div>
            <div class="isi-teks"><%= (mKompetensi && mKompetensi.isi) ? mKompetensi.isi : '' %></div>
          </div>
          <div class="kotak kendala">
            <div class="jdl">Kendala dan penyelesaian (jika ada)</div>
            <div class="isi-teks"><%= (mKendala && mKendala.isi) ? mKendala.isi : '' %></div>
          </div>
          <div class="kotak catatan">
            <div class="jdl">Catatan Pendamping Lapangan (jika ada)</div>
            <div class="isi-teks"><%= (mPendamping && mPendamping.isi) ? mPendamping.isi : '' %></div>
          </div>
          <% if (grup.mingguKe) { const kk = grup.konsultasi; %>
          <div class="kotak dosen">
            <div class="jdl">Catatan Dosen Pembimbing
              <% if (grup.disetujui) { %><span class="stempel-ok">SUDAH KONSULTASI &middot; DISETUJUI</span><% } else { %><span class="stempel-no">BELUM KONSULTASI</span><% } %>
            </div>
            <div class="isi-teks"><%= (kk && kk.catatan) ? kk.catatan : '' %></div>
            <% if (kk && kk.status === 'approved') { %>
              <div class="meta-konsul">Konsultasi via WhatsApp<% if (kk.noWa) { %> (<%= kk.noWa %>)<% } %><% if (kk.tanggalKonsultasi) { %> &middot; <%= fmtTgl(kk.tanggalKonsultasi) %><% } %><% if (kk.dosenNama) { %> &middot; <%= kk.dosenNama %><% } %></div>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>

      <div class="spacer"></div>

      <div class="blok-ttd">
        <div class="ttd">
          <div>Tanggal:<span class="tgl-isi"></span></div>
          <div class="area"></div>
          <div class="nama"><%= namaPendamping %></div>
          <div class="cap">Nama dan Tanda Tangan Pendamping Lapangan</div>
        </div>
      </div>

      <div class="footer-cetak">
        <span>Dicetak dari Web Portal Elektronika Polidewa: <%= generatedAt %></span>
        <span class="kode-validasi"><%= kodeValidasi %></span>
      </div>

    </div>
  </section>

  <%# ===== DOKUMENTASI MINGGUAN: halaman khusus tepat setelah lembar logbook minggu ini ===== %>
  <% const halFoto = grup.halamanFoto || [];
     let noFoto = 0;
     halFoto.forEach((hal, hi) => { %>
  <section class="sheet">
    <div class="sheet-inner">

      <div class="kop">
        <img src="<%= LOGO_URL %>" alt="Logo Politeknik Dewantara">
        <div>
          <h2 class="nama">Politeknik Dewantara</h2>
          <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7 Palopo, Sulawesi Selatan &middot; Website: polidewa.ac.id</p>
        </div>
      </div>
      <div class="kop-bar"></div>

      <div class="judul">
        <h1>DOKUMENTASI MINGGUAN</h1>
        <span class="minggu">Minggu ke-<%= grup.mingguKe %><%= halFoto.length > 1 ? ' (' + (hi + 1) + '/' + halFoto.length + ')' : '' %></span>
      </div>

      <div class="identitas ringkas">
        <div><span class="lbl">Nama mahasiswa</span><span class="val"><%= mahasiswa.nama %></span></div>
        <div><span class="lbl">NIM</span><span class="val"><%= mahasiswa.nim %></span></div>
        <div><span class="lbl">Periode</span><span class="val"><% if (grup.periodeAwal) { %><%= fmtTgl(grup.periodeAwal) %> s.d. <%= fmtTgl(grup.periodeAkhir) %><% } %></span></div>
        <div class="span3"><span class="lbl">Nama tempat magang</span><span class="val"><%= namaTempat %></span></div>
      </div>

      <div class="foto-grid">
        <% hal.forEach((f) => { noFoto = (hi * 6) + hal.indexOf(f) + 1; %>
          <div class="foto-item">
            <div class="foto-img">
              <img src="<%= f.url %>" data-fb="<%= f.urlCadangan %>" alt="Dokumentasi <%= noFoto %>" referrerpolicy="no-referrer"
                   onerror="if (this.dataset.fb &amp;&amp; this.src !== this.dataset.fb) { this.src = this.dataset.fb; }">
            </div>
            <div class="foto-cap">
              <span class="foto-no">Foto <%= noFoto %></span><span class="foto-tgl"><%= f.hari %><% if (f.tanggal) { %>, <%= fmtTglPendek(f.tanggal) %><% } %></span>
              <div class="foto-teks"><%= f.caption %></div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="spacer"></div>

      <div class="footer-cetak">
        <span>Dicetak dari Web Portal Elektronika Polidewa: <%= generatedAt %></span>
        <span class="kode-validasi"><%= kodeValidasi %></span>
      </div>

    </div>
  </section>
  <% }) %>
<% }) %>

    <%# ===== DAFTAR HADIR: satu lembar per bulan, tanpa kolom ttd per baris ===== %>
    <%
      const rg = ringkasan || {};
      const NAMA_HARI = ['Minggu','Senin','Selasa','Rabu','Kamis',"Jum'at",'Sabtu'];
      const fmtDesimal = (n) => String(Number(Number(n || 0).toFixed(1))).replace('.', ',');
      const tglCetakPanjang = new Date().toLocaleDateString('id-ID', { day:'numeric', month:'long', year:'numeric' });
      const namaDosen = (pembimbing && pembimbing.pembimbing) ? pembimbing.pembimbing.nama : '';
      const idDosen = (pembimbing && pembimbing.pembimbing) ? (pembimbing.pembimbing.nidn || pembimbing.pembimbing.nuptk || '') : '';
    %>
    <% if (!kehadiranGroups || kehadiranGroups.length === 0) { %>
      <section class="sheet"><div class="sheet-inner">
        <div class="kop">
          <img src="<%= LOGO_URL %>" alt="Logo Politeknik Dewantara">
          <div><h2 class="nama">Politeknik Dewantara</h2>
          <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7 Palopo, Sulawesi Selatan &middot; Website: polidewa.ac.id</p></div>
        </div>
        <div class="kop-bar"></div>
        <div class="judul"><h1>DAFTAR HADIR MAGANG</h1></div>
        <p class="text-center fst-italic text-muted py-4">Belum ada entri logbook, sehingga Daftar Hadir belum dapat dibuat.</p>
      </div></section>
    <% } else { %>
      <% kehadiranGroups.forEach((bulan) => {
           const jumlahHadir = Object.keys(bulan.entriesByTanggal).length;
           const jamBulan = Object.values(bulan.entriesByTanggal).reduce((n, e) => n + e.totalDurasi, 0);
           let hariKerjaBulan = 0;
           for (let t = 1; t <= bulan.daysInMonth; t++) { const w = new Date(bulan.year, bulan.month - 1, t).getDay(); if (w >= 1 && w <= 5) hariKerjaBulan++; }
      %>
        <section class="sheet"><div class="sheet-inner">

          <div class="kop">
            <img src="<%= LOGO_URL %>" alt="Logo Politeknik Dewantara">
            <div>
              <h2 class="nama">Politeknik Dewantara</h2>
              <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7 Palopo, Sulawesi Selatan &middot; Website: polidewa.ac.id</p>
            </div>
          </div>
          <div class="kop-bar"></div>

          <div class="judul">
            <h1>DAFTAR HADIR MAGANG</h1>
            <span class="minggu"><%= bulan.monthLabel %></span>
          </div>

          <div class="identitas">
            <div class="span2"><span class="lbl">Nama mahasiswa</span><span class="val"><%= mahasiswa.nama %></span></div>
            <div><span class="lbl">NIM</span><span class="val"><%= mahasiswa.nim %></span></div>
            <div class="span2"><span class="lbl">Tempat magang</span><span class="val"><%= namaTempat || '-' %></span></div>
            <div><span class="lbl">Tahun akademik</span><span class="val"><%= tahunAjaran %></span></div>
          </div>

          <div class="hadir-strip">
            <div class="k"><b><%= jumlahHadir %> hari</b><span>Hadir bulan ini</span></div>
            <div class="k"><b><%= fmtDesimal(jamBulan) %> jam</b><span>Total jam</span></div>
            <div class="k"><b><%= jumlahHadir ? fmtDesimal(jamBulan / jumlahHadir) : '0' %> jam</b><span>Rata-rata per hari</span></div>
            <div class="k"><b><%= hariKerjaBulan ? Math.min(100, Math.round(jumlahHadir / hariKerjaBulan * 100)) : 0 %>%</b><span>Dari <%= hariKerjaBulan %> hari kerja</span></div>
          </div>

          <div class="tabel-hadir-bungkus">
            <table class="hadir">
              <colgroup><col style="width:7%"><col style="width:13%"><col style="width:17%"><col style="width:15%"><col style="width:15%"><col style="width:13%"><col style="width:20%"></colgroup>
              <thead>
                <tr><th>No.</th><th>Hari</th><th>Tanggal</th><th>Jam datang</th><th>Jam pulang</th><th>Durasi</th><th>Keterangan</th></tr>
              </thead>
              <tbody>
                <% for (let tgl = 1; tgl <= bulan.daysInMonth; tgl++) {
                     const hadir = bulan.entriesByTanggal[tgl];
                     const w = new Date(bulan.year, bulan.month - 1, tgl).getDay();
                     const libur = (w === 0 || w === 6);
                %>
                  <tr class="<%= hadir ? 'ada' : 'kosong' %> <%= libur ? 'libur' : '' %>">
                    <td><%= tgl %></td>
                    <td class="kiri"><%= NAMA_HARI[w] %></td>
                    <td><%= String(tgl).padStart(2,'0') %>-<%= String(bulan.month).padStart(2,'0') %>-<%= bulan.year %></td>
                    <% if (hadir) { %>
                      <td><%= hadir.jamDatang %></td>
                      <td><%= hadir.jamPulang %></td>
                      <td><%= fmtDesimal(hadir.totalDurasi) %> jam</td>
                      <td><span class="hdr">Hadir</span></td>
                    <% } else { %>
                      <td>&ndash;</td><td>&ndash;</td><td>&ndash;</td>
                      <td><%= libur ? 'Akhir pekan' : '' %></td>
                    <% } %>
                  </tr>
                <% } %>
                <tr class="total">
                  <td colspan="3" style="text-align:left;">Jumlah kehadiran</td>
                  <td colspan="2"><%= jumlahHadir %> hari</td>
                  <td><%= fmtDesimal(jamBulan) %> jam</td>
                  <td></td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="catatan-hadir">Jam datang &amp; pulang terisi otomatis dari logbook (jam datang standar <%= jamMasuk %>; jam pulang = jam datang + durasi kegiatan hari itu).</div>

          <div class="spacer"></div>

          <div class="blok-ttd">
            <div class="ttd">
              <div>Palopo, <%= tglCetakPanjang %></div>
              <div>Pendamping Lapangan</div>
              <div class="area"></div>
              <div class="nama"><%= namaPendamping || '( ____________________ )' %></div>
              <% if (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.jabatanPembimbingLapangan) { %><div class="cap"><%= pdkInfo.perusahaan.jabatanPembimbingLapangan %></div><% } %>
            </div>
          </div>

          <div class="footer-cetak">
            <span>Dicetak dari Web Portal Elektronika Polidewa: <%= generatedAt %></span>
            <span class="kode-validasi"><%= kodeValidasi %></span>
          </div>
        </div></section>
      <% }) %>
    <% } %>

    <%# ===== LEMBAR PENGESAHAN LOGBOOK (setelah seluruh daftar hadir) ===== %>
    <% const maksJam = Math.max(1, ...((rg.perMinggu || []).map(m => m.jam))); %>
    <section class="sheet"><div class="sheet-inner">

      <div class="kop">
        <img src="<%= LOGO_URL %>" alt="Logo Politeknik Dewantara">
        <div>
          <h2 class="nama">Politeknik Dewantara</h2>
          <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7 Palopo, Sulawesi Selatan &middot; Website: polidewa.ac.id</p>
        </div>
      </div>
      <div class="kop-bar"></div>

      <div class="judul">
        <h1>LEMBAR PENGESAHAN LOGBOOK MAGANG</h1>
      </div>

      <div class="identitas">
        <div class="span2"><span class="lbl">Nama mahasiswa</span><span class="val"><%= mahasiswa.nama %></span></div>
        <div><span class="lbl">NIM</span><span class="val"><%= mahasiswa.nim %></span></div>
        <div class="span2"><span class="lbl">Nama tempat magang</span><span class="val"><%= namaTempat || '-' %></span></div>
        <div><span class="lbl">Program studi</span><span class="val"><%= typeof prodi !== 'undefined' ? prodi : '' %></span></div>
      </div>

      <div class="hero-durasi">
        <div>
          <div class="lbl">Lama magang</div>
          <div class="besar"><%= rg.durasi ? rg.durasi.teks : '-' %></div>
        </div>
        <div class="kecil">
          <% if (rg.durasi) { %>
            <%= fmtTgl(rg.durasi.awal) %> s.d. <%= fmtTgl(rg.durasi.akhir) %><br>
            <%= rg.durasi.totalHari %> hari kalender &middot; hadir <b><%= rg.hariHadir %> hari</b> &middot; <b><%= fmtDesimal(rg.totalJam) %> jam</b> kerja
          <% } else { %>
            Tanggal periode magang belum tersedia.
          <% } %>
        </div>
      </div>

      <p class="narasi">
        Berdasarkan rekap logbook, mahasiswa tersebut telah melaksanakan magang
        <% if (rg.durasi) { %>selama <b><%= rg.durasi.teks %></b> (<%= fmtTgl(rg.durasi.awal) %> s.d. <%= fmtTgl(rg.durasi.akhir) %>)<% } %>
        dengan kehadiran <b><%= rg.hariHadir %> hari</b> dan total <b><%= fmtDesimal(rg.totalJam) %> jam</b> kegiatan<% if (rg.persenHadir !== null) { %>,
        atau tingkat kehadiran sekitar <b><%= rg.persenHadir %>%</b> dari <%= rg.hariKerja %> hari kerja<% } %>.
        Logbook ini telah diperiksa dan dinyatakan sah sebagai bukti pelaksanaan kegiatan magang.
      </p>

      <div class="kpi-grid">
        <div class="kpi"><span>Hari hadir</span><b><%= rg.hariHadir %></b><small>dari <%= rg.hariKerja || '-' %> hari kerja</small></div>
        <div class="kpi"><span>Total jam</span><b><%= fmtDesimal(rg.totalJam) %></b><small>rata-rata <%= fmtDesimal(rg.rataJamHari) %> jam/hari</small></div>
        <div class="kpi"><span>Tingkat kehadiran</span><b><%= rg.persenHadir !== null ? rg.persenHadir + '%' : '-' %></b><small>terhadap hari kerja</small></div>
        <div class="kpi"><span>Minggu terlaporkan</span><b><%= rg.mingguTerisi %>/<%= rg.totalMinggu %></b><small>minggu berisi logbook</small></div>
        <div class="kpi"><span>Entri logbook</span><b><%= rg.totalEntri %></b><small><%= rg.disetujui %> disetujui dosen</small></div>
        <div class="kpi"><span>Foto dokumentasi</span><b><%= rg.jumlahFoto %></b><small>terlampir per minggu</small></div>
        <div class="kpi"><span>Hadir beruntun</span><b><%= rg.beruntun %> hari</b><small>rekor terpanjang</small></div>
        <div class="kpi"><span>Catatan pendamping</span><b><%= rg.mingguCatatanPendamping %></b><small>minggu bercatatan</small></div>
      </div>

      <div class="chart-grid">
        <div class="chart-box">
          <h3>Jam kerja per minggu</h3>
          <% if (rg.perMinggu && rg.perMinggu.length) { %>
            <div class="vbar">
              <% rg.perMinggu.forEach((m) => { %>
                <div class="col"><% if (m.jam) { %><em><%= fmtDesimal(m.jam) %></em><% } %><i class="<%= m.jam ? '' : 'nol' %>" style="height: <%= m.jam ? Math.max(4, Math.round(m.jam / maksJam * 88)) : 2 %>%"></i></div>
              <% }) %>
            </div>
            <div class="vlabel"><% rg.perMinggu.forEach((m) => { %><span><%= m.minggu %></span><% }) %></div>
            <div class="text-muted" style="font-size:6.6pt;margin-top:2px;">Sumbu bawah = minggu ke-; angka di atas batang = jam.</div>
          <% } else { %>
            <div class="text-muted fst-italic" style="font-size:9pt;">Belum ada data.</div>
          <% } %>
        </div>
        <div class="chart-box">
          <h3>Kehadiran per bulan</h3>
          <% (rg.perBulan || []).forEach((b) => { const pct = Math.min(100, Math.round(b.hari / 23 * 100)); %>
            <div class="hbar">
              <div class="row1"><span><%= b.label %></span><span><b><%= b.hari %></b> hari &middot; <%= fmtDesimal(b.jam) %> jam</span></div>
              <div class="trek"><div class="isi" style="width: <%= pct %>%"></div></div>
            </div>
          <% }) %>
          <% if (!rg.perBulan || !rg.perBulan.length) { %><div class="text-muted fst-italic" style="font-size:9pt;">Belum ada data.</div><% } %>
        </div>
      </div>

      <div class="wawasan">
        <b>Ringkasan analitik.</b>
        <% if (rg.mingguTersibuk && rg.mingguTersibuk.jam) { %>Minggu paling padat: <b>minggu ke-<%= rg.mingguTersibuk.minggu %></b> (<%= fmtDesimal(rg.mingguTersibuk.jam) %> jam, <%= rg.mingguTersibuk.hari %> hari). <% } %>
        <% if (rg.bulanTerbanyak) { %>Kehadiran terbanyak pada <b><%= rg.bulanTerbanyak.label %></b> (<%= rg.bulanTerbanyak.hari %> hari). <% } %>
        <% if (rg.totalMinggu) { %>Ketertiban pengisian logbook: <b><%= Math.round(rg.mingguTerisi / rg.totalMinggu * 100) %>%</b> minggu terisi. <% } %>
        <% if (rg.totalEntri) { %>Persetujuan dosen: <b><%= Math.round(rg.disetujui / rg.totalEntri * 100) %>%</b> entri (<%= rg.disetujui %> dari <%= rg.totalEntri %>).<% } %>
      </div>

      <div class="spacer"></div>

      <div class="blok-ttd2">
        <div class="ttd">
          <div>Palopo, <%= tglCetakPanjang %></div>
          <div>Pendamping Lapangan</div>
          <div class="area"></div>
          <div class="nama"><%= namaPendamping || '( ____________________ )' %></div>
          <% if (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.jabatanPembimbingLapangan) { %><div class="cap"><%= pdkInfo.perusahaan.jabatanPembimbingLapangan %></div><% } %>
        </div>
        <div class="ttd">
          <div>&nbsp;</div>
          <div>Dosen Pembimbing</div>
          <div class="area"></div>
          <div class="nama"><%= namaDosen || '( ____________________ )' %></div>
          <% if (idDosen) { %><div class="cap">NIDN/NUPTK: <%= idDosen %></div><% } %>
        </div>
      </div>

      <div class="footer-cetak">
        <span>Dicetak dari Web Portal Elektronika Polidewa: <%= generatedAt %></span>
        <span class="kode-validasi"><%= kodeValidasi %></span>
      </div>
    </div></section>

    <%# ===== LEMBAR KONSULTASI BIMBINGAN (bagian halaman kesimpulan) ===== %>
    <%
      const rekapK = (typeof rekapKonsultasi !== 'undefined' && rekapKonsultasi) ? rekapKonsultasi : [];
      const jmlSudahK = rekapK.filter(r => r.disetujui).length;
      const noWaMhs = (mahasiswa && mahasiswa.noHp) ? mahasiswa.noHp : '';
    %>
    <section class="sheet"><div class="sheet-inner">

      <div class="kop">
        <img src="<%= LOGO_URL %>" alt="Logo Politeknik Dewantara">
        <div>
          <h2 class="nama">Politeknik Dewantara</h2>
          <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7 Palopo, Sulawesi Selatan &middot; Website: polidewa.ac.id</p>
        </div>
      </div>
      <div class="kop-bar"></div>

      <div class="judul">
        <h1>LEMBAR KONSULTASI BIMBINGAN MAGANG</h1>
        <span class="minggu"><%= jmlSudahK %>/<%= rekapK.length %> minggu</span>
      </div>

      <div class="identitas">
        <div class="span2"><span class="lbl">Nama mahasiswa</span><span class="val"><%= mahasiswa.nama %></span></div>
        <div><span class="lbl">NIM</span><span class="val"><%= mahasiswa.nim %></span></div>
        <div class="span2"><span class="lbl">Dosen Pembimbing</span><span class="val"><%= namaDosen || '-' %></span></div>
        <div><span class="lbl">No. WA mahasiswa</span><span class="val"><%= noWaMhs || '-' %></span></div>
      </div>

      <div class="tabel-bungkus">
        <table class="konsul">
          <colgroup><col style="width:8%"><col style="width:20%"><col style="width:15%"><col style="width:17%"><col style="width:40%"></colgroup>
          <thead>
            <tr>
              <th class="c">Minggu</th>
              <th>Periode</th>
              <th>Status</th>
              <th>Konsultasi (via WA)</th>
              <th>Catatan Dosen Pembimbing</th>
            </tr>
          </thead>
          <tbody>
            <% if (rekapK.length === 0) { %>
              <tr><td colspan="5" class="c" style="padding:14px;">Belum ada data minggu logbook.</td></tr>
            <% } %>
            <% rekapK.forEach((r) => { %>
              <tr>
                <td class="c"><b><%= r.minggu %></b></td>
                <td><%= r.awal ? fmtTglPendek(r.awal) + ' - ' + fmtTglPendek(r.akhir) : '' %></td>
                <td class="<%= r.disetujui ? 'sudah' : 'belum' %>"><%= r.disetujui ? 'Disetujui' : (r.adaLogbook ? 'Belum konsultasi' : 'Belum ada logbook') %></td>
                <td><%= r.tanggalKonsultasi ? fmtTgl(r.tanggalKonsultasi) : '' %><% if (r.noWa) { %><br><span style="color:#667085;"><%= r.noWa %></span><% } %></td>
                <td class="multi"><%= r.catatan %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <p class="narasi" style="margin-top:10px;font-size:9pt;">
        Konsultasi dilakukan melalui WhatsApp antara mahasiswa dan Dosen Pembimbing; setiap minggu yang telah
        dikonsultasikan dicatat dan disetujui oleh Dosen Pembimbing melalui portal. Lembar logbook mingguan yang
        belum dikonsultasikan diberi tanda air &ldquo;Belum Konsultasi&rdquo;.
      </p>

      <div class="spacer"></div>

      <div class="blok-ttd2">
        <div class="ttd" style="grid-column:2;">
          <div>Palopo, <%= tglCetakPanjang %></div>
          <div>Dosen Pembimbing</div>
          <div class="area"></div>
          <div class="nama"><%= namaDosen || '( ____________________ )' %></div>
          <% if (idDosen) { %><div class="cap">NIDN/NUPTK: <%= idDosen %></div><% } %>
        </div>
      </div>

      <div class="footer-cetak">
        <span>Dicetak dari Web Portal Elektronika Polidewa: <%= generatedAt %></span>
        <span class="kode-validasi"><%= kodeValidasi %></span>
      </div>
    </div></section>

</div>

<script>
  /* ======================================================================
     PAKSA MUAT A4
     Untuk tiap lembar: bila isi lebih tinggi dari area kertas, isi diperkecil
     (transform: scale) sedikit demi sedikit sampai PAS. Bila ada ruang sisa,
     baris hari pada tabel mingguan dilebarkan agar lembar terlihat penuh.
     Dipanggil saat load, sebelum cetak, dan oleh generator PDF di server.
     ====================================================================== */
  function fitSheet(sheet) {
    var inner = sheet.querySelector('.sheet-inner');
    if (!inner) return;
    var cs = getComputedStyle(sheet);
    var W = sheet.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    var H = sheet.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
    var rows = sheet.querySelectorAll('table.minggu tr.hari');

    function set(s) {
      inner.style.transform = s === 1 ? '' : 'scale(' + s + ')';
      inner.style.width = (W / s) + 'px';
      inner.style.height = (H / s) + 'px';
    }
    function meluber() { return inner.scrollHeight > inner.clientHeight + 1; }

    // reset
    rows.forEach(function (tr) { tr.style.height = ''; });
    set(1);

    var s = 1;
    while (meluber() && s > 0.35) { s = Math.round((s - 0.02) * 100) / 100; set(s); }

    // ruang sisa -> lebarkan baris hari (sisakan sedikit napas, batasi tinggi baris)
    if (!meluber() && rows.length) {
      var sp = inner.querySelector('.spacer');
      var free = sp ? sp.clientHeight : 0;
      if (free > 12) {
        var tambah = Math.min((free * 0.8) / rows.length, 70 / s);
        rows.forEach(function (tr) { tr.style.height = (tr.offsetHeight + tambah) + 'px'; });
        if (meluber()) rows.forEach(function (tr) { tr.style.height = ''; });
      }
    }
    sheet.setAttribute('data-skala', s);
  }

  function fitAllSheets() {
    var pv = document.getElementById('preview');
    var z = pv.style.zoom;
    pv.style.zoom = 1; // ukur pada ukuran asli, bukan ukuran pratinjau
    document.querySelectorAll('.sheet').forEach(fitSheet);
    pv.style.zoom = z;
  }

  // Pratinjau muat di layar sempit (HP): perkecil tampilan kertas saja
  function skalaPratinjau() {
    var pv = document.getElementById('preview');
    if (document.body.classList.contains('pdf-mode')) return;
    var lebarKertas = 210 * 96 / 25.4; // px
    var s = Math.min(1, (window.innerWidth - 16) / lebarKertas);
    pv.style.zoom = s;
  }

  function mulai() { fitAllSheets(); skalaPratinjau(); }
  if (document.readyState === 'complete') mulai(); else window.addEventListener('load', mulai);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(mulai);
  window.addEventListener('resize', skalaPratinjau);
  window.addEventListener('beforeprint', function () { document.getElementById('preview').style.zoom = 1; fitAllSheets(); });
  window.addEventListener('afterprint', skalaPratinjau);

  // Tombol Kembali: bila halaman dibuka di tab baru, tutup tab / kembali ke daftar
  (function () {
    var b = document.getElementById('btnKembali');
    if (!b) return;
    b.addEventListener('click', function (e) {
      if (history.length > 1) { e.preventDefault(); history.back(); }
      else if (b.getAttribute('href') === '#') { e.preventDefault(); window.close(); }
    });
  })();
</script>
</body>
</html>
