<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Cetak Logbook - <%= mahasiswa.nama %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
  <style>
    /* ===== RESET & BASE ===== */
    * { box-sizing: border-box; }
    @page { size: A4; margin: 1.2cm 1.8cm; }
    body {
      font-family: Calibri, 'Segoe UI', Arial, Helvetica, sans-serif;
      background: #fff;
      color: #000;
      font-size: 11pt;
      line-height: 1.35;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    .container-fluid {
      max-width: 21cm; /* pratinjau di layar selebar kertas A4 */
      margin: 0 auto;
      padding: 0 0.6cm;
    }
    .print-btn { font-family: Arial, sans-serif; margin-bottom: 12px; }

    /* ===== LEMBAR LOGBOOK (1 LEMBAR = 1 MINGGU) ===== */
    .lembar {
      page-break-after: always;
      padding-bottom: 6px;
    }
    .lembar:last-of-type { page-break-after: auto; }
    .lembar + .lembar { margin-top: 24px; }

    /* ===== KOP ===== */
    .kop-surat {
      display: flex;
      align-items: center;
      margin-bottom: 12px;
    }
    .logo-kop {
      width: 62px;
      height: auto;
      margin-right: 14px;
      flex-shrink: 0;
    }
    .teks-kop { flex: 1; font-family: Arial, Helvetica, sans-serif; line-height: 1.2; }
    .teks-kop .nama-kampus {
      font-size: 24pt;
      font-weight: 700;
      margin: 0;
      color: #0070c0;
      text-transform: uppercase;
      letter-spacing: 0;
    }
    .teks-kop .alamat { font-size: 7.5pt; margin: 2px 0 0 0; color: #222; }

    .judul-logbook { font-weight: 700; font-size: 11pt; margin: 0 0 8px 0; }

    /* ===== IDENTITAS (isian bertitik) ===== */
    .identitas { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    .identitas td { padding: 3px 0; vertical-align: bottom; border: none; }
    .identitas td.isi {
      border-bottom: 1px dotted #000;
      padding: 0 4px;
      min-height: 1.2em;
    }

    /* ===== TABEL LOGBOOK MINGGUAN ===== */
    .tabel-minggu {
      width: 100%;
      border-collapse: collapse;
      margin: 8px 0 14px 0;
      table-layout: fixed;
    }
    .tabel-minggu th, .tabel-minggu td {
      border: 1px solid #000;
      padding: 3px 5px;
      vertical-align: top;
      font-size: 10pt;
      word-wrap: break-word;
      overflow-wrap: anywhere;
    }
    .tabel-minggu th { font-weight: 700; text-align: left; vertical-align: middle; }
    .tabel-minggu th.c, .tabel-minggu td.c { text-align: center; }
    .tabel-minggu tbody tr { height: 1.25cm; page-break-inside: avoid; }
    .tabel-minggu tr.baris-total { height: 0.8cm; }
    .tabel-minggu tr.baris-total td { vertical-align: middle; }
    .tabel-minggu .tgl-kecil { display: block; font-size: 8pt; color: #333; }
    .tabel-minggu .multi { white-space: pre-line; }
    .tabel-minggu .multi + .multi { margin-top: 3px; }

    /* ===== RINGKASAN MINGGUAN ===== */
    .ringkasan-judul { margin: 0 0 4px 0; }
    .ringkasan-list { margin: 0 0 8px 0; padding-left: 1.4em; }
    .ringkasan-list li { margin-bottom: 6px; }
    .garis {
      border-bottom: 1px dotted #000;
      min-height: 1.45em;
      white-space: pre-wrap;
      padding: 0 2px;
    }
    .label-garis { display: block; }

    /* ===== TANDA TANGAN ===== */
    .blok-ttd { page-break-inside: avoid; margin-top: 12px; }
    .area-ttd-mingguan { height: 56px; }
    .garis-ttd { width: 8cm; border-bottom: 1px dotted #000; min-height: 1.2em; font-weight: 700; padding: 0 2px; }

    /* ===== DAFTAR HADIR ===== */
    .kehadiran-page {
      page-break-before: always;
      padding-top: 6px;
      font-size: 9pt;      /* ukuran asli Daftar Hadir, tidak ikut font lembar mingguan */
      line-height: 1.3;
    }
    .kehadiran-kop {
      text-align: center;
      margin-bottom: 8px;
    }
    .kehadiran-kop h5 {
      font-size: 11pt;
      font-weight: 700;
      margin-bottom: 2px;
      text-decoration: underline;
    }
    .kehadiran-kop p {
      font-size: 9.5pt;
      font-weight: bold;
      margin-bottom: 2px;
    }
    .kehadiran-info {
      font-size: 8.5pt;
      margin-bottom: 6px;
      border-collapse: collapse;
      width: 100%;
    }
    .kehadiran-info td {
      padding: 1px 6px 1px 0;
      border: none;
    }
    .kehadiran-info td:first-child {
      font-weight: 700;
      width: 18%;
    }
    .kehadiran-info td:nth-child(2) {
      width: 2%;
    }

    .table-kehadiran {
      font-size: 8pt;
      border-collapse: collapse;
      width: 100%;
      border: 1px solid #000;
    }
    .table-kehadiran th,
    .table-kehadiran td {
      border: 1px solid #000;
      text-align: center;
      vertical-align: middle;
      padding: 2px 3px;
    }
    .table-kehadiran thead th {
      background-color: #e9ecef;
      font-weight: 700;
      font-size: 7.5pt;
    }
    .table-kehadiran td.hari-tanggal {
      text-align: left;
      padding-left: 8px;
    }
    .table-kehadiran .baris-kosong {
      color: #bbb;
    }
    /* Kolom TTD hijau jika hadir */
    .table-kehadiran td.ttd-hadir {
      background-color: #c8e6c9 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .table-kehadiran td.ttd-kosong {
      background-color: transparent;
    }
    
    /* Wrapper untuk membuat posisi kanan bawah tapi rata kiri teksnya */
    .kehadiran-ttd-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-top: 16px;
    }
    .kehadiran-ttd {
      text-align: left;
      font-size: 8.5pt;
      width: 230px;
    }
    .kehadiran-ttd .area-ttd-kecil {
      height: 42px;
      margin: 5px 0;
    }

    /* ===== FOOTER ===== */
    .footer-cetak {
      font-size: 7pt;
      color: #666;
      margin: 14px 0 3px 0;
      border-top: 1px solid #ddd;
      padding-top: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .kode-validasi { font-size: 7.5pt; color: #999; }
    .nama-ttd { font-weight: 700; text-decoration: underline; margin-bottom: 0; font-size: 9pt; }
    .nip-ttd { margin-top: 0; font-size: 8pt; }
    .area-ttd { height: 45px; margin: 6px 0; }

    /* ===== PRINT STYLE ===== */
    @media print {
      body { margin: 0; background: #fff; }
      .btn, .print-btn, .no-print { display: none !important; }
      .container-fluid { padding: 0 !important; max-width: 100% !important; }
      .lembar + .lembar { margin-top: 0; }
      .table-kehadiran thead th {
        background-color: #e9ecef !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .table-kehadiran td.ttd-hadir {
        background-color: #c8e6c9 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .teks-kop .nama-kampus { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }

    @media screen and (max-width: 768px) {
      .container-fluid { padding: 0 10px; }
      .teks-kop .nama-kampus { font-size: 16pt; }
      .garis-ttd { width: 100%; }
    }
  </style>
</head>
<body>
<%
  // ---------- Bantu tampilan ----------
  const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  const fmtTgl = (iso) => {           // 2025-11-05 -> 05 Nov 2025
    if (!iso) return '';
    const p = String(iso).substring(0, 10).split('-');
    if (p.length !== 3) return '';
    return p[2] + ' ' + BULAN[parseInt(p[1], 10) - 1].substring(0, 3) + ' ' + p[0];
  };
  const fmtTglPendek = (iso) => {     // 2025-11-05 -> 05-11-2025
    if (!iso) return '';
    const p = String(iso).substring(0, 10).split('-');
    return p.length === 3 ? p[2] + '-' + p[1] + '-' + p[0] : '';
  };
  const fmtJam = (n) => (n ? String(Number(Number(n).toFixed(2))) : '');
  const namaBulan = (iso) => {
    if (!iso) return '';
    const p = String(iso).substring(0, 10).split('-');
    return p.length === 3 ? BULAN[parseInt(p[1], 10) - 1] + ' ' + p[0] : '';
  };

  const namaTempat = (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.nama) ? pdkInfo.perusahaan.nama : '';
  const namaPendamping = (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.pembimbingLapangan) ? pdkInfo.perusahaan.pembimbingLapangan : '';

  // Minggu tanpa entri tetap dicetak sebagai lembar kosong bila belum ada data sama sekali
  const HARI_KOSONG = ['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Ahad'].map(h => ({ hari: h, tanggal: null, entries: [], durasi: 0 }));
  const lembarList = (mingguGroups && mingguGroups.length > 0)
    ? mingguGroups
    : [{ mingguKe: '', bulanKe: '', periodeAwal: '', periodeAkhir: '', rows: HARI_KOSONG, totalDurasi: 0, entries: [] }];
%>
  <div class="container-fluid px-3 py-2">
    <div class="text-end no-print">
      <button onclick="window.print()" class="btn btn-primary btn-sm print-btn shadow-sm">
        <i class="bi bi-printer-fill"></i> Cetak / PDF
      </button>
    </div>

    <% lembarList.forEach((grup) => {
         const mPendamping = masukanMap ? masukanMap[grup.mingguKe + '_pendamping'] : null;
         const mKompetensi = masukanMap ? masukanMap[grup.mingguKe + '_kompetensi'] : null;
         const mKendala    = masukanMap ? masukanMap[grup.mingguKe + '_kendala'] : null;
    %>
    <div class="lembar">
      <div class="kop-surat">
        <img src="https://polidewa.ac.id/wp-content/uploads/2025/11/Desain-tanpa-judul-1.png"
             alt="Logo Politeknik Dewantara" class="logo-kop">
        <div class="teks-kop">
          <h2 class="nama-kampus">Politeknik Dewantara</h2>
          <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7 Palopo, Sulawesi Selatan, Website: polidewa.ac.id</p>
        </div>
      </div>

      <p class="judul-logbook">LOGBOOK MAGANG</p>

      <table class="identitas">
        <tr>
          <td style="width:1%; white-space:nowrap;">Nama mahasiswa:&nbsp;</td>
          <td class="isi"><%= mahasiswa.nama %></td>
          <td style="width:1%; white-space:nowrap; padding-left:10px;">NIM:&nbsp;</td>
          <td class="isi" style="width:32%;"><%= mahasiswa.nim %></td>
        </tr>
      </table>
      <table class="identitas">
        <tr>
          <td style="width:1%; white-space:nowrap;">Nama Tempat Magang:&nbsp;</td>
          <td class="isi"><%= namaTempat %></td>
        </tr>
      </table>
      <table class="identitas">
        <tr>
          <td style="width:1%; white-space:nowrap;">Minggu ke:&nbsp;</td>
          <td class="isi" style="width:12%; text-align:center;"><%= grup.mingguKe %></td>
          <td style="width:1%; white-space:nowrap; padding-left:10px;">Bulan:&nbsp;</td>
          <td class="isi" style="width:22%;"><% if (grup.bulanKe) { %>ke-<%= grup.bulanKe %> (<%= namaBulan(grup.periodeAwal) %>)<% } %></td>
          <td style="width:1%; white-space:nowrap; padding-left:10px;">Periode:&nbsp;</td>
          <td class="isi" style="width:18%; text-align:center;"><%= fmtTgl(grup.periodeAwal) %></td>
          <td style="width:1%; white-space:nowrap; padding:0 6px;">s.d.</td>
          <td class="isi" style="width:18%; text-align:center;"><%= fmtTgl(grup.periodeAkhir) %></td>
        </tr>
      </table>

      <table class="tabel-minggu">
        <colgroup>
          <col style="width:15%"><col style="width:34%"><col style="width:36%"><col style="width:15%">
        </colgroup>
        <thead>
          <tr>
            <th>Hari/Tanggal</th>
            <th>Kegiatan atau pekerjaan utama</th>
            <th>Hasil pekerjaan</th>
            <th>Durasi (jam)</th>
          </tr>
        </thead>
        <tbody>
          <% grup.rows.forEach((row) => { %>
            <tr>
              <td>
                <%= row.hari %>
                <% if (row.tanggal) { %><span class="tgl-kecil"><%= fmtTglPendek(row.tanggal) %></span><% } %>
              </td>
              <td>
                <% row.entries.forEach((e, i) => { %>
                  <div class="multi"><%= row.entries.length > 1 ? (i + 1) + '. ' : '' %><%= e.kegiatan %></div>
                <% }) %>
              </td>
              <td>
                <%
                  // "Hasil pekerjaan": pakai kolom `hasil` bila ada, kalau tidak pakai `keterangan`
                  const hasilList = row.entries.map(e => e.hasil || e.keterangan || '');
                  const adaHasil = hasilList.some(x => x);
                %>
                <% if (adaHasil) { hasilList.forEach((h, i) => { if (!h) return; %>
                  <div class="multi"><%= row.entries.length > 1 ? (i + 1) + '. ' : '' %><%= h %></div>
                <% }) } %>
              </td>
              <td class="c" style="vertical-align:middle;"><%= fmtJam(row.durasi) %></td>
            </tr>
          <% }) %>
          <tr class="baris-total">
            <td>Total</td>
            <td></td>
            <td></td>
            <td class="c"><%= grup.totalDurasi ? fmtJam(grup.totalDurasi) : '...' %> jam</td>
          </tr>
        </tbody>
      </table>

      <p class="ringkasan-judul">Ringkasan Mingguan</p>
      <ul class="ringkasan-list">
        <li>
          Kompetensi/keterampilan yang dipelajari:
          <% if (mKompetensi && mKompetensi.isi) { %>
            <div class="garis"><%= mKompetensi.isi %></div>
          <% } else { %>
            <div class="garis">&nbsp;</div><div class="garis">&nbsp;</div><div class="garis">&nbsp;</div>
          <% } %>
        </li>
        <li>
          Kendala dan penyelesaian (jika ada):
          <% if (mKendala && mKendala.isi) { %>
            <div class="garis"><%= mKendala.isi %></div>
          <% } else { %>
            <div class="garis">&nbsp;</div><div class="garis">&nbsp;</div>
          <% } %>
        </li>
      </ul>

      <div>
        Catatan Pendamping Lapangan (jika ada):
        <% if (mPendamping && mPendamping.isi) { %>
          <div class="garis"><%= mPendamping.isi %></div>
        <% } else { %>
          <div class="garis">&nbsp;</div><div class="garis">&nbsp;</div>
        <% } %>
      </div>

      <div class="blok-ttd">
        <p style="margin:10px 0 0 0;">Tanggal: <span style="display:inline-block; min-width:7cm; border-bottom:1px dotted #000;">&nbsp;</span></p>
        <div class="area-ttd-mingguan"></div>
        <div class="garis-ttd"><%= namaPendamping %></div>
        <div>Nama dan Tanda Tangan Pendamping Lapangan</div>
      </div>

      <div class="footer-cetak">
        <span>Dicetak dari Web Portal Elektronika Polidewa: <%= generatedAt %></span>
        <span class="kode-validasi"><%= kodeValidasi %></span>
      </div>
    </div>
    <% }) %>

    <% if (!kehadiranGroups || kehadiranGroups.length === 0) { %>
      <div class="kehadiran-page">
        <div class="kehadiran-kop">
          <h5>DAFTAR HADIR MAGANG MAHASISWA</h5>
          <p>PROGRAM STUDI TEKNIK ELEKTRONIKA (D3)</p>
          <p>TAHUN AKADEMIK <%= tahunAjaran %></p>
        </div>
        <p class="text-center fst-italic text-muted py-4">
          Belum ada entri logbook, sehingga Daftar Hadir belum dapat dibuat.
        </p>
      </div>
    <% } else { %>
      <% kehadiranGroups.forEach((bulan) => { %>
        <div class="kehadiran-page">
          <div class="kehadiran-kop">
            <h5>DAFTAR HADIR MAGANG MAHASISWA</h5>
            <p>PROGRAM STUDI TEKNIK ELEKTRONIKA (D3)</p>
            <p>TAHUN AKADEMIK <%= tahunAjaran %> &mdash; <%= bulan.monthLabel.toUpperCase() %></p>
          </div>

          <table class="kehadiran-info">
            <tr><td>Nama Mahasiswa</td><td>:</td><td><%= mahasiswa.nama %></td></tr>
            <tr><td>NIM</td><td>:</td><td><%= mahasiswa.nim %></td></tr>
            <tr><td>Tempat Magang</td><td>:</td>
              <td><%= (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.nama) ? pdkInfo.perusahaan.nama : '-' %></td>
            </tr>
          </table>

          <table class="table-kehadiran">
            <thead>
              <tr>
                <th rowspan="2" width="5%">No.</th>
                <th rowspan="2" width="18%">Hari/Tanggal</th>
                <th colspan="2">Datang</th>
                <th colspan="2">Pulang</th>
                <th rowspan="2" width="17%">Keterangan</th>
              </tr>
              <tr>
                <th width="12%">Jam</th>
                <th width="10%">Ttd</th>
                <th width="12%">Jam</th>
                <th width="10%">Ttd</th>
              </tr>
            </thead>
            <tbody>
              <% for (let tgl = 1; tgl <= bulan.daysInMonth; tgl++) {
                   const hadir = bulan.entriesByTanggal[tgl];
                   const tanggalObj = new Date(bulan.year, bulan.month - 1, tgl);
                   const namaHari = ['Minggu','Senin','Selasa','Rabu','Kamis',"Jum'at",'Sabtu'][tanggalObj.getDay()];
              %>
                <tr>
                  <td><%= tgl %>.</td>
                  <td class="hari-tanggal"><%= namaHari %>, <%= String(tgl).padStart(2,'0') %>-<%= String(bulan.month).padStart(2,'0') %>-<%= bulan.year %></td>
                  <% if (hadir) { %>
                    <td><%= hadir.jamDatang %></td>
                    <td class="ttd-hadir"></td>   <td><%= hadir.jamPulang %></td>
                    <td class="ttd-hadir"></td>   <td><%= hadir.keterangan %></td>
                  <% } else { %>
                    <td class="baris-kosong">-</td>
                    <td class="ttd-kosong"></td>
                    <td class="baris-kosong">-</td>
                    <td class="ttd-kosong"></td>
                    <td></td>
                  <% } %>
                </tr>
              <% } %>
              <tr class="fw-bold">
                <td colspan="2">Jumlah Kehadiran</td>
                <td colspan="4"><%= Object.keys(bulan.entriesByTanggal).length %> Hari</td>
                <td></td>
              </tr>
            </tbody>
          </table>

          <div class="kehadiran-ttd-wrapper">
            <div class="kehadiran-ttd">
              <p class="mb-0">Palopo, <%= new Date().toLocaleDateString('id-ID', { day:'numeric', month:'long', year:'numeric' }) %></p>
              <p>Pendamping Lapangan</p>
              <div class="area-ttd-kecil"></div>
              <% if (pdkInfo && pdkInfo.perusahaan && pdkInfo.perusahaan.pembimbingLapangan) { %>
                <p class="nama-ttd"><%= pdkInfo.perusahaan.pembimbingLapangan %></p>
                <% if (pdkInfo.perusahaan.jabatanPembimbingLapangan) { %>
                  <p class="nip-ttd"><%= pdkInfo.perusahaan.jabatanPembimbingLapangan %></p>
                <% } %>
              <% } else { %>
                <p class="nama-ttd">( ____________________ )</p>
              <% } %>
            </div>
          </div>

          <div class="footer-cetak">
            <span>Logbook dicetak dari Web Portal Elektronika Polidewa: <%= generatedAt %></span>
            <span class="kode-validasi">Kode Validasi</span>
          </div>
        </div>
      <% }) %>
    <% } %>

  </div> </body>
</html>
