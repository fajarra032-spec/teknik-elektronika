<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transkrip Nilai - <%= user.nama %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
  <style>
    /* Pengaturan Kertas Default A4 */
    @page {
      size: A4;
      margin: 1.5cm;
    }

    /* Gaya Umum - diselaraskan dengan KRS/KHS supaya seragam */
    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #000;
      background-color: #fff;
      font-size: 10pt;
    }

    .print-btn, .back-btn {
      margin: 20px 5px;
      font-family: Arial, sans-serif;
    }

    /* === KOP SURAT === */
    .kop-surat {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
    }
    .logo-kop {
      width: 100px;
      height: auto;
      margin-right: 20px;
    }
    .teks-kop {
      flex: 1;
    }
    .teks-kop .nama-kampus {
      font-size: 26pt;
      font-weight: bold;
      margin: 0;
      color: #3b60a3;
      letter-spacing: 0.5px;
    }
    .teks-kop .alamat, .teks-kop .kontak {
      font-size: 11pt;
      margin: 2px 0;
      color: #333;
    }

    /* === JUDUL & INFO MAHASISWA === */
    .judul-dokumen {
      text-align: center;
      font-size: 12pt;
      font-weight: bold;
      margin: 25px 0 20px 0;
    }

    .info-container {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .info-table {
      font-size: 9pt;
    }
    .info-table td {
      padding: 3px 5px 3px 0;
      vertical-align: top;
      text-transform: uppercase;
    }
    .info-table td.titik-dua {
      width: 15px;
      text-align: center;
    }

    /* === GARIS PEMISAH === */
    .garis-pemisah {
      border-top: 1.5px solid #000;
      margin: 15px 0;
    }

    /* === TABEL NILAI === */
    .table-transkrip {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
      font-size: 9.5pt;
    }
    .table-transkrip th, .table-transkrip td {
      border: 1px solid #000;
      padding: 6px 8px;
      vertical-align: middle;
    }
    .table-transkrip th {
      text-align: center;
      font-weight: bold;
    }
    .table-transkrip td.center {
      text-align: center;
    }

    tr {
      page-break-inside: avoid;
    }
    thead {
      display: table-header-group;
    }

    /* === RINGKASAN IPK === */
    .ringkasan-container {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 15px;
    }
    .ringkasan-table {
      font-size: 9.5pt;
      width: 45%;
    }
    .ringkasan-table td {
      padding: 4px 8px;
      border: 1px solid #000;
    }
    .ringkasan-table td.label {
      font-weight: bold;
    }

    /* === TANDA TANGAN === */
    .tanda-tangan-container {
      display: flex;
      justify-content: flex-end;
      margin-top: 40px;
      font-size: 10pt;
    }
    .kolom-tanda {
      width: 32%;
      text-align: center;
    }
    .area-ttd {
      height: 80px;
    }
    .nama-ttd {
      margin-bottom: 0;
    }
    .nip-ttd {
      margin-top: 0;
    }

    /* === PENGATURAN CETAK (PRINT) === */
    @media print {
      body {
        margin: 0;
      }
      .btn, .print-btn, .back-btn {
        display: none !important;
      }
      .table-transkrip th {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>
<body>
  <div class="container-fluid px-4 py-3">

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3 print-btn">
      <a href="/mahasiswa/akademik" class="btn btn-outline-secondary btn-sm back-btn">
        <i class="bi bi-arrow-left"></i> Kembali
      </a>
      <form method="GET" class="d-flex align-items-center gap-2 mb-0">
        <label for="semester" class="mb-0 small text-muted">Tampilkan s.d. Semester:</label>
        <select name="semester" id="semester" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
          <% if (semesterList && semesterList.length) { %>
            <% semesterList.forEach(s => { %>
              <option value="<%= s %>" <%= semesterDipilih === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          <% } %>
        </select>
      </form>
      <button onclick="window.print()" class="btn btn-primary btn-sm print-btn shadow-sm">
        <i class="bi bi-printer-fill"></i> Cetak Dokumen
      </button>
    </div>

    <%- include('../partials/kop_surat') %>

    <div class="judul-dokumen">
      TRANSKRIP NILAI AKADEMIK
      <% if (semesterDipilih) { %>
        <div style="font-size: 9pt; font-weight: normal; margin-top: 4px;">(Kumulatif s.d. <%= semesterDipilih %>)</div>
      <% } %>
    </div>

    <div class="info-container">
      <table class="info-table" style="width: 48%;">
        <tr>
          <td width="20%">NIM</td>
          <td class="titik-dua">:</td>
          <td><%= user.nim || '-' %></td>
        </tr>
        <tr>
          <td>NAMA</td>
          <td class="titik-dua">:</td>
          <td><%= user.nama || '-' %></td>
        </tr>
        <tr>
          <td>PRODI</td>
          <td class="titik-dua">:</td>
          <td>TEKNIK ELEKTRONIKA</td>
        </tr>
      </table>

      <table class="info-table" style="width: 48%;">
        <tr>
          <td width="55%">IPK</td>
          <td class="titik-dua">:</td>
          <td><%= ipk !== undefined ? ipk : '-' %></td>
        </tr>
        <tr>
          <td>Total SKS Ditempuh</td>
          <td class="titik-dua">:</td>
          <td><%= totalSKS !== undefined ? totalSKS + ' SKS' : '-' %></td>
        </tr>
        <tr>
          <td>Dicetak Tanggal</td>
          <td class="titik-dua">:</td>
          <td><%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></td>
        </tr>
      </table>
    </div>

    <div class="garis-pemisah"></div>

    <table class="table-transkrip">
      <thead>
        <tr>
          <th width="5%">No</th>
          <th width="10%">Semester</th>
          <th width="12%">Kode MK</th>
          <th width="35%">Nama Mata Kuliah</th>
          <th width="8%">SKS</th>
          <th width="10%">Nilai</th>
          <th width="10%">Huruf</th>
          <th width="10%">Indeks</th>
        </tr>
      </thead>
      <tbody>
        <% if (grades && grades.length > 0) { %>
          <% grades.forEach((g, index) => { %>
          <tr>
            <td class="center"><%= index + 1 %>.</td>
            <td class="center"><%= g.semester || '-' %></td>
            <td class="center"><%= g.kodeMk || '-' %></td>
            <td><%= g.namaMk || '-' %></td>
            <td class="center"><%= g.sks %></td>
            <% if (g.belumAdaNilai) { %>
              <td class="center" colspan="3" style="font-style: italic; color: #666;">Belum Ada Nilai</td>
            <% } else { %>
              <td class="center"><%= g.nilai %></td>
              <td class="center"><%= g.huruf %></td>
              <td class="center"><%= g.indeks.toFixed(1) %></td>
            <% } %>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; font-style: italic; padding: 15px;">Belum ada nilai yang tercatat.</td>
          </tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" style="text-align: center; font-weight: bold;">Total</td>
          <td style="text-align: center; font-weight: bold;"><%= totalSKS !== undefined ? totalSKS : '-' %></td>
          <td colspan="3"></td>
        </tr>
      </tfoot>
    </table>

    <div class="ringkasan-container">
      <table class="ringkasan-table">
        <tr>
          <td class="label">Indeks Prestasi Kumulatif (IPK)</td>
          <td style="text-align: center; font-weight: bold; font-size: 12pt;"><%= ipk !== undefined ? ipk : '-' %></td>
        </tr>
      </table>
    </div>

    <div class="garis-pemisah"></div>

    <p style="font-size: 8.5pt; color: #555;">
      Keterangan skala nilai: A (86&ndash;100, 4.0) &middot; B+ (76&ndash;85, 3.5) &middot; B (60&ndash;75, 3.0) &middot;
      C+ (50&ndash;59, 2.5) &middot; C (25&ndash;49, 2.0) &middot; D (10&ndash;24, 1.0) &middot; E (&lt;10, 0.0)
    </p>

    <div class="tanda-tangan-container">
      <div class="kolom-tanda">
        <p class="mb-0">Palopo, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <p>Ketua Program Studi Teknik Elektronika</p>
        <div class="area-ttd"></div>
        <p class="nama-ttd">Fajar Ramadhan, S.Pd., M.T</p>
        <p class="nip-ttd">NUPTK: 8559777678130153</p>
      </div>
    </div>

  </div>
</body>
</html>
