<%- include('../partials/header') %>

<style>
  /* ===== VARIABEL WARNA (sesuai navbar & halaman akademik lain) ===== */
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
    --warning-bg: #fef3c7;
    --warning-text: #92400e;
    --font-base: 16px;
  }

  html {
    font-size: 16px;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background-color: #f8fafc;
  }

  /* ===== PAGE HEADER ===== */
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 1.5rem 2rem;
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .page-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    transform: rotate(25deg);
  }
  .page-header h2 {
    font-weight: 700;
    margin: 0;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 2rem;
  }
  .page-header .nim-badge {
    background: white;
    color: var(--primary-start);
    border-radius: 50px;
    padding: 0.5rem 1.2rem;
    font-weight: 600;
    font-size: 0.9rem;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 5px 10px rgba(0,0,0,0.1);
  }

  /* ===== INFO CARD (data mahasiswa) ===== */
  .info-card {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    padding: 1.8rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(30,58,138,0.1);
  }
  .avatar-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 2rem;
    text-transform: uppercase;
    box-shadow: 0 4px 10px rgba(30,58,138,0.3);
    flex-shrink: 0;
  }
  .info-card h4 {
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.2rem;
    font-size: 1.2rem;
  }
  .info-card .text-muted { color: #64748b; }

  /* ===== SELECTOR CARD ===== */
  .selector-card {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    padding: 1.5rem 1.8rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(30,58,138,0.1);
  }
  .selector-form .form-select {
    border-radius: 50px;
    border: 1px solid #dee2e6;
    padding: 0.6rem 1rem;
    transition: all 0.2s;
  }
  .selector-form .form-select:focus {
    border-color: var(--primary-end);
    box-shadow: 0 0 0 0.25rem rgba(30,58,138,0.15);
  }

  /* ===== TOMBOL GRADIEN ===== */
  .btn-gradient {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border: none;
    color: white;
    font-weight: 600;
    padding: 0.6rem 1.5rem;
    border-radius: 50px;
    transition: all 0.3s;
    box-shadow: 0 5px 15px rgba(30,58,138,0.2);
  }
  .btn-gradient:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(30,58,138,0.4);
    color: white;
  }

  /* ===== RINGKASAN SEMESTER (SUMMARY) ===== */
  .summary-card {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    padding: 1.5rem 1.8rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(30,58,138,0.1);
  }
  .summary-stat { text-align: center; }
  .summary-stat .value {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--primary-start);
  }
  .summary-stat .label {
    font-size: 0.8rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .badge-ip {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    font-weight: 700;
    padding: 0.5rem 1.1rem;
    border-radius: 50px;
    display: inline-block;
    font-size: 1.1rem;
    box-shadow: 0 4px 10px rgba(30,58,138,0.3);
  }

  /* ===== TABEL MATA KULIAH ===== */
  .table-container {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden;
    border: 1px solid rgba(30,58,138,0.1);
    padding: 1.5rem;
  }
  .table-responsive {
    margin: 0;
    border-radius: 1rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .khs-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 0;
  }
  .khs-table th {
    background: #f8f9fa;
    color: #1e293b;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 1px solid #dee2e6;
    padding: 0.85rem 0.75rem;
    white-space: nowrap;
  }
  .khs-table td {
    vertical-align: middle;
    padding: 0.85rem 0.75rem;
    border: 1px solid #dee2e6;
    font-size: 0.9rem;
  }
  .khs-table tbody tr:hover {
    background-color: #f2f6ff;
  }

  /* ===== EMPTY STATE ===== */
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    background: #f8f9fa;
    border-radius: 1.5rem;
  }
  .empty-state i {
    font-size: 4rem;
    color: #adb5bd;
    margin-bottom: 1rem;
  }
  .empty-state p {
    color: #64748b;
    font-size: 1rem;
    max-width: 480px;
    margin: 0 auto;
  }

  /* ===== RESPONSIF ===== */
  @media (max-width: 768px) {
    html { font-size: 15px; }
    .page-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .page-header h2 { font-size: 1.6rem; }
    .info-card .d-flex { flex-direction: column; text-align: center; }
    .info-card .ms-3 { margin-left: 0 !important; margin-top: 0.5rem; }
    .khs-table th { font-size: 0.8rem; padding: 0.5rem; }
    .khs-table td { font-size: 0.85rem; padding: 0.5rem; }
  }

  @media (max-width: 576px) {
    html { font-size: 14px; }
    .page-header h2 { font-size: 1.4rem; }
    .btn-gradient { padding: 0.5rem 1.5rem; font-size: 0.85rem; }
    .summary-stat .value { font-size: 1.3rem; }
  }

  @media (max-width: 400px) {
    html { font-size: 13px; }
    .page-header h2 { font-size: 1.2rem; }
  }

  @media (max-width: 340px) {
    html { font-size: 12px; }
  }
</style>

<div class="container mt-4">
  <!-- Page Header -->
  <div class="page-header">
    <h2><i class="bi bi-journal-text"></i> Kartu Hasil Studi (KHS)</h2>
    <div class="nim-badge">
      <i class="bi bi-qr-code"></i> <%= user?.nim || '-' %>
    </div>
  </div>

  <!-- Info Mahasiswa -->
  <div class="info-card">
    <div class="d-flex align-items-center">
      <% if (user?.foto) { %>
        <img src="<%= user.foto %>" alt="foto" class="rounded-circle me-3"
             style="width: 60px; height: 60px; object-fit: cover; border: 3px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.1);"
             onerror="this.onerror=null;this.src='/images/default-avatar.png';">
      <% } else { %>
        <div class="avatar-circle me-3"><%= (user?.nama || '?').charAt(0).toUpperCase() %></div>
      <% } %>
      <div class="flex-grow-1 ms-3">
        <h4><%= user?.nama || '-' %></h4>
        <p class="text-muted mb-0">
          <i class="bi bi-person-badge me-2"></i>NIM <%= user?.nim || '-' %>
          <span class="mx-2">&middot;</span>
          <i class="bi bi-building me-2"></i><%= user?.prodi || 'Program Studi Teknik Elektronika' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Pilih Semester -->
  <div class="selector-card">
    <form method="GET" class="row g-3 align-items-end selector-form">
      <div class="col-md-6">
        <label for="semester" class="form-label fw-semibold"><i class="bi bi-calendar3 me-1"></i>Pilih Semester</label>
        <select class="form-select" id="semester" name="semester" onchange="this.form.submit()">
          <% if (semesterList && semesterList.length) { %>
            <% semesterList.forEach(s => { %>
              <option value="<%= s %>" <%= semesterDipilih === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          <% } else { %>
            <option value="">Belum ada semester</option>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-gradient w-100">
          <i class="bi bi-eye me-1"></i> Tampilkan
        </button>
      </div>
    </form>
  </div>

  <% if (!khs) { %>
    <div class="table-container">
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>Belum ada KHS. KHS akan muncul otomatis setelah Program Studi mengunci nilai akhir semester Anda.</p>
      </div>
    </div>
  <% } else { %>

    <!-- Ringkasan Semester Terpilih -->
    <div class="summary-card">
      <div class="row text-center g-3">
        <div class="col-6 col-md-3 summary-stat">
          <div class="badge-ip"><%= khs.ips || '0.00' %></div>
          <div class="label mt-1">IPS</div>
        </div>
        <div class="col-6 col-md-3 summary-stat">
          <div class="value"><%= khs.totalSKSDiprogram ?? khs.totalSKS ?? 0 %></div>
          <div class="label">SKS Diambil</div>
        </div>
        <div class="col-6 col-md-3 summary-stat">
          <div class="value"><%= khs.totalSKS ?? 0 %></div>
          <div class="label">SKS Lulus</div>
        </div>
        <div class="col-6 col-md-3 summary-stat">
          <div class="value"><%= khs.matkul?.length ?? 0 %></div>
          <div class="label">Jumlah MK</div>
        </div>
      </div>
      <% if (khs.jumlahBelumNilai > 0) { %>
        <div class="alert mt-3 mb-0 py-2 px-3" style="border-radius: 0.8rem; font-size: 0.9rem; background: var(--warning-bg); color: var(--warning-text); border: 1px solid #fde68a;">
          <i class="bi bi-hourglass-split me-1"></i>
          <%= khs.jumlahBelumNilai %> dari <%= khs.matkul.length %> mata kuliah yang Anda program semester ini
          <strong>belum keluar nilainya</strong> - IP Semester di atas baru dihitung dari mata kuliah yang sudah ada nilai.
        </div>
      <% } %>
    </div>

    <!-- Tabel Mata Kuliah -->
    <div class="table-container">
      <div class="table-responsive">
        <table class="table khs-table mb-0">
          <thead>
            <tr>
              <th>No</th>
              <th>Kode MK</th>
              <th>Mata Kuliah</th>
              <th>SKS</th>
              <th>Nilai</th>
              <th>Huruf</th>
              <th>Indeks</th>
            </tr>
          </thead>
          <tbody>
            <% (khs.matkul || []).forEach((m, i) => { %>
            <tr<%= m.belumAdaNilai ? ' class="text-muted"' : '' %>>
              <td class="fw-bold"><%= i + 1 %></td>
              <td><%= m.kodeMk || '-' %></td>
              <td><%= m.namaMk || '-' %></td>
              <td><%= m.sks ?? '-' %></td>
              <% if (m.belumAdaNilai) { %>
                <td colspan="3"><em>Belum Ada Nilai</em></td>
              <% } else { %>
                <td><%= m.nilai ?? '-' %></td>
                <td><span class="fw-semibold"><%= m.huruf || '-' %></span></td>
                <td><%= typeof m.indeks === 'number' ? m.indeks.toFixed(1) : '-' %></td>
              <% } %>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="text-end mt-3">
      <a href="/mahasiswa/akademik/khs/<%= encodeURIComponent(khs.semester) %>" class="btn btn-gradient" target="_blank">
        <i class="bi bi-printer-fill me-1"></i> Cetak KHS
      </a>
    </div>

  <% } %>
</div>

<%- include('../partials/footer') %>
