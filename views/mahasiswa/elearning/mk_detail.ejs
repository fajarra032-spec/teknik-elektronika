<%- include('../../partials/header') %>

<%
  const getDriveThumbnail = (url) => {
    if (!url) return null;
    let match = url.match(/[?&]id=([^&]+)/);
    if (match) return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w100-h100`;
    match = url.match(/\/d\/([^\/]+)/);
    if (match) return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w100-h100`;
    return url;
  };
%>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  html { font-size: 16px; }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }

  .mk-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.2rem; padding: 1.5rem; color: white; margin-bottom: 1.2rem;
    box-shadow: 0 10px 20px rgba(30,58,138,0.2); position: relative; overflow: hidden;
  }
  .mk-header h2 { font-weight: 700; font-size: 1.5rem; margin-bottom: 0.3rem; }
  .mk-header p { font-size: 0.85rem; opacity: 0.9; margin-bottom: 0; }
  .btn-back {
    background: rgba(255,255,255,0.2); backdrop-filter: blur(4px); border: none; color: white;
    border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.8rem; text-decoration: none;
    display: inline-flex; align-items: center; gap: 0.4rem; transition: 0.2s;
  }
  .btn-back:hover { background: rgba(255,255,255,0.3); transform: translateY(-2px); color: white; }

  .info-card {
    background: white; border-radius: 1.2rem; box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    padding: 1.2rem; margin-bottom: 1.2rem; border: 1px solid rgba(30,58,138,0.1);
  }
  .info-card h5 { font-weight: 700; color: #1e293b; font-size: 1.05rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
  .info-card h5 i { color: var(--primary-start); }

  .progress-ring-wrap { display: flex; align-items: center; gap: 1rem; }
  .progress-bar-outer { flex: 1; background: #e2e8f0; border-radius: 50px; height: 10px; overflow: hidden; }
  .progress-bar-inner { height: 100%; background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); border-radius: 50px; }
  .progress-percent { font-weight: 700; color: var(--primary-dark); font-size: 1.1rem; min-width: 3.2rem; text-align: right; }

  .stat-mini { text-align: center; padding: 0.5rem; }
  .stat-mini .angka { font-size: 1.4rem; font-weight: 700; color: var(--primary-dark); }
  .stat-mini .label { font-size: 0.72rem; color: #64748b; }

  .nilai-row { display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px solid #f1f5f9; font-size: 0.88rem; }
  .nilai-row:last-child { border-bottom: none; }
  .nilai-akhir-box {
    background: var(--primary-light); border-radius: 0.8rem; padding: 0.8rem 1rem; margin-top: 0.7rem;
    display: flex; justify-content: space-between; align-items: center;
  }
  .nilai-akhir-box .huruf { font-size: 1.5rem; font-weight: 800; color: var(--primary-dark); }

  @media (max-width: 768px) {
    html { font-size: 15px; }
    .mk-header { padding: 1rem; }
    .mk-header h2 { font-size: 1.3rem; }
    .info-card { padding: 1rem; margin-bottom: 1rem; }
  }
  @media (max-width: 576px) {
    .progress-percent { font-size: 1rem; min-width: 2.8rem; }
    .stat-mini .angka { font-size: 1.2rem; }
    .nilai-row { font-size: 0.82rem; }
    .nilai-akhir-box .huruf { font-size: 1.3rem; }
  }
</style>

<div class="container mt-3">
  <div class="mk-header d-flex flex-wrap justify-content-between align-items-center">
    <div>
      <h2><%= mk.kode %> - <%= mk.nama %></h2>
      <p><%= mk.sks %> SKS | Semester <%= mk.semester %></p>
    </div>
    <a href="/mahasiswa/elearning" class="btn-back mt-2 mt-sm-0">
      <i class="bi bi-arrow-left"></i> Kembali
    </a>
    <a href="/mahasiswa/kelas-chat/<%= mk.id %>" class="btn-back mt-2 mt-sm-0" style="margin-left:0.5rem;">
      <i class="bi bi-chat-dots"></i> Chat Kelas
    </a>
  </div>

  <%- include('./partials/mk_tabs', { mk, activeTab: 'ringkasan' }) %>

  <div class="row g-3">
    <!-- Kolom Kiri -->
    <div class="col-lg-4">
      <div class="info-card">
        <h5><i class="bi bi-person-badge"></i> Dosen Pengampu</h5>
        <% if (dosenList && dosenList.length) { %>
          <% dosenList.forEach(d => { %>
            <%
              const fotoDosenUrl = d.foto ? getDriveThumbnail(d.foto) : null;
              const fallbackDosen = `https://ui-avatars.com/api/?name=${encodeURIComponent(d.nama)}&background=1e3a8a&color=fff&size=40`;
            %>
            <div class="d-flex align-items-center gap-2 mb-2">
              <img src="<%= fotoDosenUrl || fallbackDosen %>" alt="foto <%= d.nama %>"
                style="width:40px; height:40px; border-radius:50%; object-fit:cover; border:2px solid #e2e8f0;"
                onerror="this.onerror=null; this.src='<%= fallbackDosen %>';">
              <div>
                <div><%= d.nama %></div>
                <% if (d.kontak) { %>
                  <div class="text-muted small"><i class="bi bi-telephone me-1"></i><%= d.kontak %></div>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-muted small">Belum ada dosen pengampu.</p>
        <% } %>
      </div>

      <div class="info-card">
        <h5><i class="bi bi-calendar-week"></i> Jadwal</h5>
        <p class="mb-0"><%= jadwal || 'Belum diatur' %></p>
      </div>

      <div class="info-card">
        <h5><i class="bi bi-people"></i> Teman Sekelas</h5>
        <p class="text-muted small mb-2">Jumlah mahasiswa: <strong><%= jumlahMahasiswa || 0 %></strong></p>
        <% if (mahasiswaList && mahasiswaList.length) { %>
          <div style="max-height: 280px; overflow-y: auto;">
            <% mahasiswaList.forEach(m => { %>
              <%
                const fotoMhsUrl = m.foto ? getDriveThumbnail(m.foto) : null;
                const fallbackMhs = `https://ui-avatars.com/api/?name=${encodeURIComponent(m.nama)}&background=3b82f6&color=fff&size=36`;
              %>
              <div class="d-flex align-items-center gap-2 mb-2">
                <img src="<%= fotoMhsUrl || fallbackMhs %>" alt="foto <%= m.nama %>"
                  style="width:36px; height:36px; border-radius:50%; object-fit:cover; border:1.5px solid #e2e8f0;"
                  onerror="this.onerror=null; this.src='<%= fallbackMhs %>';">
                <div>
                  <div style="font-size:0.88rem; font-weight:600; color:#1e293b;"><%= m.nama %></div>
                  <div style="font-size:0.75rem; color:#64748b;"><%= m.nim %></div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0">Belum ada mahasiswa lain terdaftar di kelas ini.</p>
        <% } %>
      </div>
    </div>

    <!-- Kolom Kanan -->
    <div class="col-lg-8">
      <!-- Progress Belajar -->
      <div class="info-card">
        <h5><i class="bi bi-graph-up"></i> Progress Belajar</h5>
        <div class="progress-ring-wrap mb-2">
          <div class="progress-bar-outer"><div class="progress-bar-inner" style="width: <%= persenProgress %>%;"></div></div>
          <div class="progress-percent"><%= persenProgress %>%</div>
        </div>
        <p class="text-muted small mb-0">
          <%= terlaksana %> dari 16 pertemuan sudah dilaksanakan.
          <% if (terlambatDiisi > 0) { %>
            <span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i><%= terlambatDiisi %> pertemuan sudah lewat tanggal tapi belum ditandai selesai dosen.</span>
          <% } %>
        </p>
        <a href="/mahasiswa/elearning/mk/<%= mk.id %>/pertemuan" class="small">Lihat rincian per pertemuan &rarr;</a>
      </div>

      <div class="row g-3">
        <!-- Kehadiran Saya -->
        <div class="col-md-6">
          <div class="info-card h-100">
            <h5><i class="bi bi-clipboard-check"></i> Kehadiran Saya</h5>
            <% if (totalDiambilAbsensi > 0) { %>
              <div class="row text-center mb-2">
                <div class="col-6 stat-mini"><div class="angka"><%= jumlahHadirSaya %>/<%= totalDiambilAbsensi %></div><div class="label">Pertemuan Hadir</div></div>
                <div class="col-6 stat-mini"><div class="angka"><%= persenHadirSaya %>%</div><div class="label">Persentase Hadir</div></div>
              </div>
            <% } else { %>
              <p class="text-muted small mb-0">Dosen belum mengambil absensi.</p>
            <% } %>
            <a href="/mahasiswa/elearning/mk/<%= mk.id %>/pertemuan" class="small">Lihat per pertemuan &rarr;</a>
          </div>
        </div>

        <!-- Nilai Saya -->
        <div class="col-md-6">
          <div class="info-card h-100">
            <h5><i class="bi bi-award"></i> Nilai Saya</h5>
            <div class="nilai-row"><span>Kehadiran</span><span><%= hasilRubrikSaya.kehadiranAkhir !== null ? hasilRubrikSaya.kehadiranAkhir : '-' %></span></div>
            <div class="nilai-row"><span>Sikap</span><span><%= hasilRubrikSaya.sikap !== null ? hasilRubrikSaya.sikap : '-' %></span></div>
            <div class="nilai-row"><span>Keaktifan</span><span><%= hasilRubrikSaya.keaktifan !== null ? hasilRubrikSaya.keaktifan : '-' %></span></div>
            <div class="nilai-row"><span>Rata-rata Tugas</span><span><%= hasilRubrikSaya.rataTugas !== null ? Math.round(hasilRubrikSaya.rataTugas) : '-' %></span></div>
            <div class="nilai-row"><span>Kuis</span><span><%= hasilRubrikSaya.kuis !== null ? hasilRubrikSaya.kuis : '-' %></span></div>
            <div class="nilai-row"><span>UTS</span><span><%= hasilRubrikSaya.uts !== null ? hasilRubrikSaya.uts : '-' %></span></div>
            <div class="nilai-row"><span>UAS</span><span><%= hasilRubrikSaya.uas !== null ? hasilRubrikSaya.uas : '-' %></span></div>
            <% if (hasilRubrikSaya.nilaiAkhir !== null && hasilRubrikSaya.nilaiAkhir !== undefined) { %>
              <div class="nilai-akhir-box">
                <span class="text-muted small">Nilai Akhir</span>
                <span class="huruf"><%= hasilRubrikSaya.huruf %> <span style="font-size:0.9rem; font-weight:600;">(<%= Math.round(hasilRubrikSaya.nilaiAkhir) %>)</span></span>
              </div>
            <% } else { %>
              <p class="text-muted small mt-2 mb-0">Nilai akhir belum lengkap<% if (hasilRubrikSaya.belumLengkap && hasilRubrikSaya.belumLengkap.length) { %>: <%= hasilRubrikSaya.belumLengkap.join(', ') %><% } %>.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
