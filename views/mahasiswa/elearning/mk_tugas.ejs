<%- include('../../partials/header') %>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }

  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.2rem; padding: 1.5rem; color: white; margin-bottom: 1.2rem;
    box-shadow: 0 10px 20px rgba(30,58,138,0.2);
  }
  .page-header h2 { font-weight: 700; margin-bottom: 0.3rem; }
  .page-header p { margin: 0; opacity: 0.9; }
  .btn-back {
    background: rgba(255,255,255,0.2); backdrop-filter: blur(4px); border: none; color: white;
    border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.8rem; text-decoration: none;
    display: inline-flex; align-items: center; gap: 0.4rem;
  }

  .tugas-card {
    background: white; border-radius: 0.8rem; padding: 0.9rem 1.1rem; margin-bottom: 0.8rem;
    border: 1px solid rgba(30,58,138,0.1); transition: all 0.2s;
  }
  .tugas-card:hover { box-shadow: 0 5px 10px rgba(0,0,0,0.05); }
  .tugas-judul { font-weight: 700; font-size: 0.95rem; }
  .tugas-deadline { font-size: 0.75rem; }
  .btn-tugas {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); border: none;
    border-radius: 50px; padding: 0.3rem 0.9rem; color: white; font-size: 0.75rem; text-decoration: none; display: inline-block;
  }
  .btn-tugas-sm { font-size: 0.75rem; padding: 0.25rem 0.7rem; }

  .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
  .empty-state i { font-size: 3rem; color: #adb5bd; margin-bottom: 1rem; display: block; }

  @media (max-width: 576px) {
    .tugas-card { padding: 0.7rem 0.9rem; }
    .tugas-judul { font-size: 0.88rem; }
    .tugas-deadline { font-size: 0.7rem; }
    .btn-tugas { font-size: 0.7rem; padding: 0.25rem 0.7rem; }
  }
</style>

<div class="container mt-3">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h2><i class="bi bi-file-earmark-text me-2"></i>Tugas</h2>
      <p><%= mk.kode %> - <%= mk.nama %></p>
    </div>
    <a href="/mahasiswa/elearning/mk/<%= mk.id %>" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <%- include('./partials/mk_tabs', { mk, activeTab: 'tugas' }) %>

  <% if (tugasList && tugasList.length) { %>
    <% tugasList.forEach(t => {
      const deadline = new Date(t.deadline);
      const now = new Date();
      const isOverdue = deadline < now;
    %>
      <div class="tugas-card">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
          <div class="flex-grow-1">
            <div class="tugas-judul"><%= t.judul %></div>
            <div class="tugas-deadline <%= isOverdue ? 'text-danger' : 'text-warning' %>">
              <i class="bi bi-calendar"></i> Deadline: <%= deadline.toLocaleString('id-ID') %>
            </div>
            <div class="text-muted small mt-1"><%= t.deskripsi ? t.deskripsi.substring(0, 100) + (t.deskripsi.length > 100 ? '...' : '') : '' %></div>
          </div>
          <div class="text-end">
            <% if (t.pengumpulan) { %>
              <span class="badge bg-success mb-1 d-inline-block">Sudah Dikumpul</span><br>
              <a href="/mahasiswa/elearning/tugas/<%= t.id %>" class="btn-tugas btn-tugas-sm">Detail</a>
            <% } else { %>
              <a href="/mahasiswa/elearning/tugas/<%= t.id %>" class="btn-tugas">Kumpul</a>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="tugas-card">
      <div class="empty-state">
        <i class="bi bi-inbox"></i>
        Belum ada tugas untuk mata kuliah ini.
      </div>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
