  // Hitung total mata kuliah (untuk summary) – menggunakan konsentrasi pertama sebagai acuan
  function countCourses(data) {
    let count = 0;
    data.forEach(item => {
      if (item.isConcentration) {
        // ambil konsentrasi pertama
        if (item.concentrations && item.concentrations.length) {
          count += item.concentrations[0].courses.length;
        }
      } else {
        count += item.courses.length;
      }
    });
    return count;
  }
  const totalMk = countCourses(semesterData);

  // Fungsi untuk menghitung total SKS per semester (untuk display)
  function getSemesterTotal(courses) {
    return courses.reduce((sum, c) => sum + c.sks, 0);
  }

