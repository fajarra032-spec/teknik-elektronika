<%- include('../partials/header-landing') %>

<style>
  :root {
    --k-primary: #0d6efd;
    --k-primary-dark: #0b5ed7;
    --k-primary-light: rgba(13,110,253,0.08);
    --k-gradient: linear-gradient(135deg, #0d6efd, #0dcaf0);
    --k-shadow-sm: 0 5px 15px rgba(0,0,0,0.05);
    --k-shadow-hover: 0 15px 30px rgba(13,110,253,0.15);
    --k-radius: 1.5rem;
  }

  .kur-header {
    background: var(--k-gradient);
    border-radius: var(--k-radius);
    padding: 3rem 2rem;
    color: #fff;
    margin-bottom: 2.5rem;
    text-align: center;
    box-shadow: 0 15px 30px rgba(13,110,253,0.25);
  }
  .kur-header h1 { font-weight: 800; font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: .5rem; }
  .kur-header p { opacity: .9; font-size: 1.05rem; margin: 0; }

  .kur-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.2rem;
    margin-bottom: 2.5rem;
  }
  .kur-summary .box {
    background: #fff; border-radius: 1.2rem; padding: 1.4rem; text-align: center;
    box-shadow: var(--k-shadow-sm); border: 1px solid rgba(13,110,253,0.1);
  }
  .kur-summary .box .num { font-size: 1.8rem; font-weight: 800; color: var(--k-primary); }
  .kur-summary .box .lbl { font-size: .85rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }

  .section-title {
    font-size: 1.6rem; font-weight: 700; margin: 2.5rem 0 1.2rem; color: #1e293b;
    display: flex; align-items: center; gap: .7rem;
    border-bottom: 3px solid var(--k-primary); padding-bottom: .7rem;
  }
  .section-title i { color: var(--k-primary); font-size: 1.7rem; }

  .cpl-list, .kompetensi-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; }
  .cpl-list li, .kompetensi-list li {
    background: #fff; border-left: 4px solid var(--k-primary); border-radius: .8rem;
    padding: 1rem 1.2rem; box-shadow: var(--k-shadow-sm); font-size: .95rem; color: #334155;
  }

  .semester-nav {
    display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem;
  }
  .semester-nav button {
    border: 1.5px solid var(--k-primary); background: #fff; color: var(--k-primary);
    font-weight: 600; padding: .5rem 1.1rem; border-radius: 50px; cursor: pointer; transition: .2s;
  }
  .semester-nav button:hover { background: var(--k-primary-light); }
  .semester-nav button.active { background: var(--k-gradient); color: #fff; border-color: transparent; }

  .mk-table-wrap {
    background: #fff; border-radius: 1.2rem; box-shadow: var(--k-shadow-sm);
    overflow: hidden; border: 1px solid rgba(13,110,253,0.1);
  }
  .mk-table {
    width: 100%; border-collapse: collapse; font-size: .92rem;
  }
  .mk-table thead th {
    background: var(--k-primary-light); color: var(--k-primary-dark); font-weight: 700;
    padding: .8rem 1rem; text-align: left; white-space: nowrap;
  }
  .mk-table tbody td { padding: .75rem 1rem; border-top: 1px solid #eef1f8; color: #334155; }
  .mk-table tbody tr:hover { background: #f8faff; }
  .badge-sks {
    background: var(--k-primary-light); color: var(--k-primary-dark); font-weight: 700;
    padding: .2rem .6rem; border-radius: 50px; font-size: .8rem;
  }
  .semester-total {
    text-align: right; padding: .8rem 1rem; font-weight: 700;
    color: var(--k-primary-dark); background: #f8faff;
  }

  .sub-nav {
    display: flex; gap: .5rem; margin: 0 0 1rem 0;
  }
  .sub-nav button {
    border: 1px solid #cbd5e1; background: #f8fafc; color: #475569;
    padding: .3rem 1rem; border-radius: 30px; font-weight: 600; font-size: .85rem;
    cursor: pointer; transition: .2s;
  }
  .sub-nav button:hover { background: var(--k-primary-light); }
  .sub-nav button.active {
    background: var(--k-primary); color: #fff; border-color: var(--k-primary);
  }

  .semester-panel { display: none; }
  .semester-panel.active { display: block; animation: fadeIn .3s ease; }
  .concentration-panel { display: none; }
  .concentration-panel.active { display: block; animation: fadeIn .3s ease; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .info-box {
    background: #fff; border-radius: var(--k-radius); box-shadow: var(--k-shadow-sm);
    border: 1px solid rgba(13,110,253,0.1); padding: 1.8rem; margin-top: 1.5rem;
  }
  .info-box table { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .info-box table td { padding: .5rem .8rem; border-bottom: 1px solid #eef1f8; vertical-align: top; }
  .info-box table tr:last-child td { border-bottom: none; }
  .info-box table .label { font-weight: 700; color: #1e293b; width: 30%; }

  .download-box {
    background: #fff; border-radius: var(--k-radius); box-shadow: var(--k-shadow-sm);
    border: 1px solid rgba(13,110,253,0.1); padding: 1.8rem; margin-top: 2rem;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .download-box .txt h3 { font-weight: 700; font-size: 1.15rem; margin-bottom: .2rem; color: #1e293b; }
  .download-box .txt p { margin: 0; color: #64748b; font-size: .9rem; }
  .btn-download {
    background: var(--k-gradient); color: #fff; border: none; padding: .7rem 1.5rem;
    border-radius: 50px; font-weight: 600; text-decoration: none; white-space: nowrap;
    box-shadow: 0 8px 16px rgba(13,110,253,0.25); transition: .2s;
  }
  .btn-download:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 12px 20px rgba(13,110,253,0.3); }
</style>

<% 
