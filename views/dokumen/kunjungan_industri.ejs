<%- include('../partials/header-landing') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">

<style>
  .doc-hero {
    background: linear-gradient(135deg, #0d6efd, #0dcaf0);
    padding: clamp(2.5rem, 6vw, 4rem) 1rem;
    color: white;
    text-align: center;
  }
  .doc-hero h1 { font-weight: 800; font-size: clamp(1.6rem, 5vw, 2.5rem); margin-bottom: 0.5rem; }
  .doc-hero p { opacity: 0.9; margin: 0; }

  .flow-wrap { max-width: 780px; margin: 3rem auto; padding: 0 1rem; }
  .flow-step { display: flex; gap: 1.2rem; position: relative; padding-bottom: 2.5rem; }
  .flow-step:last-child { padding-bottom: 0; }
  .flow-step::before {
    content: ''; position: absolute; left: 24px; top: 52px; bottom: 0; width: 3px;
    background: linear-gradient(180deg, #0d6efd, #a5f3fc);
  }
  .flow-step:last-child::before { display: none; }
  .flow-num {
    flex-shrink: 0; width: 50px; height: 50px; border-radius: 50%;
    background: linear-gradient(135deg, #0d6efd, #0dcaf0); color: white;
    display: flex; align-items: center; justify-content: center; font-weight: 800;
    font-size: 1.2rem; box-shadow: 0 8px 20px rgba(13,110,253,0.3); z-index: 1;
  }
  .flow-content { background: white; border-radius: 1rem; padding: 1.2rem 1.5rem; box-shadow: 0 8px 20px rgba(0,0,0,0.05); flex: 1; }
  .flow-content h5 { font-weight: 700; margin-bottom: 0.4rem; color: #1e293b; }
  .flow-content p { color: #64748b; font-size: 0.9rem; margin: 0; }
  .flow-content .syarat { margin-top: 0.7rem; padding-top: 0.7rem; border-top: 1px dashed #e2e8f0; font-size: 0.82rem; color: #0d6efd; }

  .info-grid {
    max-width: 780px; margin: 0 auto 3rem; display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;
  }
  .info-item {
    background: white; border-radius: 1rem; padding: 1.2rem; text-align: center;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
  }
  .info-item i { font-size: 1.8rem; color: #0d6efd; margin-bottom: 0.5rem; display: block; }
  .info-item .lbl { font-weight: 600; font-size: 0.9rem; color: #1e293b; }

  .cta-box {
    background: linear-gradient(135deg, #0d6efd, #0dcaf0); border-radius: 1.5rem; padding: 2rem;
    text-align: center; color: white; max-width: 780px; margin: 0 auto 3rem;
  }
  .cta-box .btn-light { border-radius: 50px; font-weight: 600; padding: 0.6rem 1.8rem; }

  .form-card { max-width: 900px; margin: 0 auto 3rem; background: #fff; border-radius: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,.07); overflow: hidden; }
  .form-card .head { background: linear-gradient(135deg, #0d6efd, #0dcaf0); color: #fff; padding: 1.2rem 1.6rem; }
  .form-card .body { padding: 1.6rem; }
  .sec-t { font-weight: 700; color: #0d6efd; border-left: 4px solid #0d6efd; padding-left: .7rem; margin: 1.4rem 0 .8rem; }
  .chip { display: inline-flex; align-items: center; gap: .4rem; background: #e7f1ff; color: #0a58ca; border-radius: 2rem; padding: .3rem .4rem .3rem .8rem; font-size: .85rem; margin: .2rem .3rem .2rem 0; }
  .chip button { border: 0; background: #0d6efd; color: #fff; width: 22px; height: 22px; border-radius: 50%; line-height: 1; font-size: .8rem; cursor: pointer; }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .setuju-card { background: #fff; border-radius: 1rem; padding: 1.1rem 1.3rem; box-shadow: 0 8px 20px rgba(0,0,0,.06); border: 1px solid #e8f0fe; height: 100%; display: flex; flex-direction: column; }
  .setuju-card .no { font-size: .78rem; color: #64748b; }
  .wrap-wide { max-width: 1000px; margin: 0 auto 3rem; padding: 0 1rem; }
</style>

<section class="lab-hero lab-hero--full">
  <div class="lab-inner px-3">
    <h1>Pengajuan Kunjungan Industri</h1>
    <p class="lab-sub">Ajukan kunjungan industri Program Studi Teknik Elektronika secara daring. Surat permohonan terbit otomatis begitu admin menyetujui dan mengisi nomor surat.</p>
    <div class="lab-actions mt-3">
      <a href="#form" class="btn btn-light rounded-pill px-4">Isi formulir</a>
      <a href="#disetujui" class="btn btn-outline-light rounded-pill px-4">Lihat surat yang disetujui</a>
    </div>
  </div>
</section>

<div class="flow-wrap">
  <div class="flow-step">
    <div class="flow-num">1</div>
    <div class="flow-content">
      <h5>Isi Formulir Pengajuan</h5>
      <p>Isi waktu kunjungan, perusahaan tujuan, mata kuliah terkait, dan keterkaitan perusahaan dengan mata kuliah tersebut. Pengajuan terbuka untuk umum, tanpa perlu akun.</p>
      <div class="syarat"><i class="bi bi-clock me-1"></i> Sebaiknya diajukan paling lambat H-14 sebelum tanggal kunjungan.</div>
    </div>
  </div>
  <div class="flow-step">
    <div class="flow-num">2</div>
    <div class="flow-content">
      <h5>Verifikasi Admin</h5>
      <p>Admin prodi meninjau pengajuan dan menyesuaikan dengan jadwal serta ketersediaan dosen pendamping. Simpan <strong>kode pengajuan</strong> Anda untuk memantau status.</p>
    </div>
  </div>
  <div class="flow-step">
    <div class="flow-num">3</div>
    <div class="flow-content">
      <h5>Surat Permohonan Terbit Otomatis</h5>
      <p>Setelah admin mengisi nomor permohonan, surat kunjungan industri langsung dibuat dan muncul di bagian <a href="#disetujui">Pengajuan yang Disetujui</a>.</p>
    </div>
  </div>
  <div class="flow-step">
    <div class="flow-num">4</div>
    <div class="flow-content">
      <h5>Cetak / Unduh &amp; Serahkan ke Perusahaan</h5>
      <p>Unduh PDF atau cetak surat, lalu serahkan kepada perusahaan tujuan sebagai surat permohonan resmi.</p>
    </div>
  </div>
  <div class="flow-step">
    <div class="flow-num">5</div>
    <div class="flow-content">
      <h5>Pelaksanaan &amp; Tindak Lanjut</h5>
      <p>Kunjungan dilaksanakan sesuai jadwal, didokumentasikan, dan dapat ditindaklanjuti dengan kerja sama lebih lanjut, seperti magang.</p>
      <div class="syarat"><i class="bi bi-arrow-right-circle me-1"></i> Lihat juga <a href="/dokumen/kerjasama-perusahaan">halaman kerjasama perusahaan</a></div>
    </div>
  </div>
</div>

<div class="wrap-wide" id="form">
  <% if (terkirim) { %>
    <div class="lab-panel mb-3" style="border-color:#9fdcc2;background:#f0fbf6;">
      <div class="lab-panel-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <div class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Pengajuan berhasil dikirim</div>
          <div class="small text-muted">Simpan kode ini untuk memantau status di kotak &ldquo;Cek status pengajuan&rdquo; di bawah.</div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="lab-code fs-6 user-select-all" id="kodeBaru"><%= terkirim %></span>
          <button type="button" class="btn btn-sm btn-outline-success rounded-pill" id="salinKode">Salin</button>
        </div>
      </div>
    </div>
  <% } %>
  <% if (err) { %>
    <div class="alert alert-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i> <%= err %></div>
  <% } %>

  <div class="lab-panel">
    <div class="lab-panel-head"><span><i class="bi bi-pencil-square me-2"></i>Formulir pengajuan kunjungan industri</span><small class="text-muted fw-normal">Tanda <span class="text-danger">*</span> wajib diisi</small></div>
    <div class="lab-panel-body">
      <form method="POST" action="/dokumen/kunjungan-industri" id="formKI" autocomplete="off" class="lab-form">
        <input type="hidden" name="ts" value="<%= ts %>">
        <div class="hp-field" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>

        <div class="lab-sec"><i class="bi bi-person"></i> Data pengaju</div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label fw-semibold">Nama Lengkap <span class="text-danger">*</span></label>
            <input type="text" name="namaPengaju" class="form-control" maxlength="100" required value="<%= form.namaPengaju || '' %>"></div>
          <div class="col-md-6"><label class="form-label fw-semibold">Jabatan / Asal Pengaju</label>
            <input type="text" name="jabatanPengaju" class="form-control" maxlength="100" placeholder="mis. Dosen pengampu / Ketua Himpunan" value="<%= form.jabatanPengaju || '' %>"></div>
          <div class="col-md-6"><label class="form-label fw-semibold">No. HP / WhatsApp <span class="text-danger">*</span></label>
            <input type="tel" name="noHp" class="form-control" maxlength="20" required value="<%= form.noHp || '' %>"></div>
          <div class="col-md-6"><label class="form-label fw-semibold">Email</label>
            <input type="email" name="email" class="form-control" maxlength="100" value="<%= form.email || '' %>"></div>
        </div>

        <div class="lab-sec"><i class="bi bi-building"></i> Perusahaan tujuan</div>
        <div class="row g-3">
          <div class="col-12"><label class="form-label fw-semibold">Nama Perusahaan / Instansi <span class="text-danger">*</span></label>
            <input type="text" name="namaPerusahaan" class="form-control" maxlength="150" required value="<%= form.namaPerusahaan || '' %>"></div>
          <div class="col-12"><label class="form-label fw-semibold">Alamat Perusahaan <span class="text-danger">*</span></label>
            <textarea name="alamatPerusahaan" class="form-control" rows="2" maxlength="300" required><%= form.alamatPerusahaan || '' %></textarea></div>
        </div>

        <div class="lab-sec"><i class="bi bi-calendar-event"></i> Waktu dan peserta</div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label fw-semibold">Tanggal Kunjungan <span class="text-danger">*</span></label>
            <input type="date" name="tanggalKunjungan" id="tglMulai" class="form-control" min="<%= hariIni %>" required value="<%= form.tanggalKunjungan || '' %>"></div>
          <div class="col-md-6"><label class="form-label fw-semibold">Sampai Tanggal <span class="text-muted fw-normal">(jika lebih dari sehari)</span></label>
            <input type="date" name="tanggalSelesai" id="tglSelesai" class="form-control" min="<%= hariIni %>" value="<%= form.tanggalSelesai || '' %>"></div>
          <div class="col-6 col-md-3"><label class="form-label fw-semibold">Jam Mulai</label>
            <input type="time" name="waktuMulai" class="form-control" value="<%= form.waktuMulai || '' %>"></div>
          <div class="col-6 col-md-3"><label class="form-label fw-semibold">Jam Selesai</label>
            <input type="time" name="waktuSelesai" class="form-control" value="<%= form.waktuSelesai || '' %>"></div>
          <div class="col-6 col-md-3"><label class="form-label fw-semibold">Jumlah Mahasiswa <span class="text-danger">*</span></label>
            <input type="number" name="jumlahMahasiswa" class="form-control" min="1" max="500" required value="<%= form.jumlahMahasiswa || '' %>"></div>
          <div class="col-6 col-md-3"><label class="form-label fw-semibold">Dosen Pendamping</label>
            <input type="number" name="jumlahPendamping" class="form-control" min="0" max="50" value="<%= form.jumlahPendamping || '0' %>"></div>
        </div>

        <div class="lab-sec"><i class="bi bi-book"></i> Mata kuliah terkait</div>
        <label class="form-label fw-semibold">Mata Kuliah Terkait <span class="text-danger">*</span></label>
        <div class="input-group mb-1">
          <select id="pilihMk" class="form-select">
            <option value="">&mdash; Pilih mata kuliah lalu klik Tambah &mdash;</option>
            <% let _sem = null; mkList.forEach(function (m) { if (m.semester !== _sem) { if (_sem !== null) { %></optgroup><% } _sem = m.semester; %><optgroup label="<%= m.semester ? 'Semester ' + m.semester : 'Lainnya' %>"><% } %>
              <option value="<%= m.id %>" data-nama="<%= m.nama %>" data-kode="<%= m.kode %>"><%= m.kode ? m.kode + ' - ' : '' %><%= m.nama %></option>
            <% }) %><% if (_sem !== null) { %></optgroup><% } %>
          </select>
          <button type="button" class="btn btn-outline-primary" id="btnTambahMk"><i class="bi bi-plus-lg"></i> Tambah</button>
        </div>
        <div id="chipMk" class="mb-1"></div>
        <div id="inputMk"></div>
        <div class="form-text mb-3">Boleh lebih dari satu (maks. 10).</div>

        <div class="mb-3"><label class="form-label fw-semibold">Keterkaitan Perusahaan dengan Mata Kuliah <span class="text-danger">*</span></label>
          <textarea name="keterkaitan" class="form-control" rows="4" minlength="20" maxlength="1500" required placeholder="Jelaskan mengapa perusahaan ini relevan dengan mata kuliah di atas, mis. perusahaan memproduksi/menggunakan PLC yang dipelajari pada mata kuliah ..."><%= form.keterkaitan || '' %></textarea></div>
        <div class="mb-3"><label class="form-label fw-semibold">Tujuan / Kegiatan yang Diharapkan <span class="text-muted fw-normal">(opsional)</span></label>
          <textarea name="tujuan" class="form-control" rows="2" maxlength="1000"><%= form.tujuan || '' %></textarea></div>

        <div class="lab-note mb-3">Surat permohonan yang diterbitkan memuat data perusahaan, jadwal, peserta, dan mata kuliah di atas. Nomor HP dan email Anda <strong>tidak</strong> ditampilkan kepada publik.</div>
        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4">Kirim pengajuan</button>
      </form>
    </div>
  </div>
</div>

<div class="wrap-wide">
  <div class="lab-panel">
    <div class="lab-panel-body">
      <div class="lab-sec"><i class="bi bi-search"></i> Cek status pengajuan</div>
      <form method="GET" action="/dokumen/kunjungan-industri#cekStatus" class="d-flex gap-2 flex-wrap" id="cekStatus">
        <input type="text" name="kode" class="form-control" style="max-width:340px" placeholder="Masukkan kode pengajuan, mis. KI-20261101-AB12C" value="<%= cekStatus ? cekStatus.kode : '' %>" maxlength="40" required>
        <button class="btn btn-outline-primary">Cek</button>
      </form>
      <% if (cekStatus) { %>
        <div class="mt-3">
          <% if (cekStatus.tidakDitemukan) { %>
            <div class="alert alert-warning mb-0">Kode <strong><%= cekStatus.kode %></strong> tidak ditemukan. Periksa kembali penulisannya.</div>
          <% } else { %>
            <div class="lab-note">
              <div class="mb-3"><%- include('../partials/kunjungan_stepper', { status: cekStatus.status }) %></div>
              <div><strong><%= cekStatus.label %></strong> &mdash; <%= cekStatus.namaPerusahaan %> (<%= tanggalPanjang(cekStatus.tanggalKunjungan) %>)</div>
              <% if (cekStatus.status === 'disetujui') { %>
                <div class="small mt-1">Nomor permohonan: <strong><%= cekStatus.nomorSurat %></strong> &middot;
                  <a href="/dokumen/kunjungan-industri/surat/<%= cekStatus.suratId %>">Buka surat</a></div>
              <% } else if (cekStatus.status === 'ditolak' && cekStatus.alasanPenolakan) { %>
                <div class="small mt-1">Alasan: <%= cekStatus.alasanPenolakan %></div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="wrap-wide" id="disetujui">
  <h3 class="fw-bold mb-1" style="color:var(--lab-ink);"><i class="bi bi-patch-check-fill text-success me-2"></i>Pengajuan yang Disetujui</h3>
  <p class="text-muted">Surat permohonan kunjungan industri yang sudah diterbitkan. Silakan cetak atau unduh sebagai PDF.</p>
  <% if (disetujui.length === 0) { %>
    <div class="lab-empty"><i class="bi bi-file-earmark-text"></i>Belum ada pengajuan yang disetujui.</div>
  <% } %>
  <div class="doc-grid">
    <% disetujui.forEach(function (d) { %>
      <article class="doc-card">
        <div class="doc-no">No. <%= d.nomorSurat %></div>
        <div class="doc-title"><%= d.namaPerusahaan %></div>
        <div class="small text-muted"><i class="bi bi-calendar-event me-1"></i><%= rentangHari(d.tanggalKunjungan, d.tanggalSelesai) %></div>
        <div class="mt-2"><% d.mataKuliah.forEach(function (m) { %><span class="mk-tag"><%= m.nama %></span><% }) %></div>
        <div class="small text-muted mt-2">Diajukan oleh <%= d.namaPengaju %></div>
        <div class="doc-actions">
          <a href="/dokumen/kunjungan-industri/surat/<%= d.id %>" class="btn btn-sm btn-primary rounded-pill px-3" target="_blank" rel="noopener"><i class="bi bi-printer me-1"></i> Lihat / cetak</a>
          <% if (d.adaPdf) { %><a href="/dokumen/kunjungan-industri/surat/<%= d.id %>/pdf" class="btn btn-sm btn-outline-success rounded-pill px-3"><i class="bi bi-download me-1"></i> Unduh PDF</a><% } %>
        </div>
      </article>
    <% }) %>
  </div>
</div>

<div class="cta-box" style="margin-top:3rem;">
  <h5 class="fw-bold mb-2">Butuh bantuan mengajukan?</h5>
  <p class="mb-3 opacity-90">Hubungi kami untuk informasi lebih lanjut mengenai kunjungan industri.</p>
  <a href="/panduan" class="btn btn-light"><i class="bi bi-question-circle me-1"></i> Lihat Panduan</a>
</div>

<script>
  (function () {
    var pilih = document.getElementById('pilihMk'), chip = document.getElementById('chipMk'), inputs = document.getElementById('inputMk');
    var terpilih = {};
    function gambar() {
      chip.innerHTML = ''; inputs.innerHTML = '';
      Object.keys(terpilih).forEach(function (id) {
        var c = document.createElement('span'); c.className = 'chip'; c.textContent = terpilih[id];
        var x = document.createElement('button'); x.type = 'button'; x.textContent = '×'; x.setAttribute('aria-label', 'Hapus');
        x.onclick = function () { delete terpilih[id]; gambar(); };
        c.appendChild(x); chip.appendChild(c);
        var h = document.createElement('input'); h.type = 'hidden'; h.name = 'mkIds'; h.value = id; inputs.appendChild(h);
      });
    }
    document.getElementById('btnTambahMk').addEventListener('click', function () {
      var o = pilih.options[pilih.selectedIndex];
      if (!o || !o.value) return;
      if (Object.keys(terpilih).length >= 10) { alert('Maksimal 10 mata kuliah.'); return; }
      terpilih[o.value] = o.dataset.nama; pilih.value = ''; gambar();
    });
    document.getElementById('formKI').addEventListener('submit', function (e) {
      if (!Object.keys(terpilih).length) { e.preventDefault(); alert('Pilih minimal satu mata kuliah terkait, lalu klik Tambah.'); pilih.focus(); }
    });
    var sk = document.getElementById('salinKode');
    if (sk) sk.addEventListener('click', function () { var t = document.getElementById('kodeBaru').textContent; if (navigator.clipboard) navigator.clipboard.writeText(t).then(function () { sk.textContent = 'Tersalin'; }); });
    var a = document.getElementById('tglMulai'), b = document.getElementById('tglSelesai');
    a.addEventListener('change', function () { b.min = a.value; if (b.value && b.value < a.value) b.value = a.value; });
    // Pulihkan pilihan MK bila halaman dirender ulang karena error validasi
    var awal = <%- JSON.stringify([].concat(form.mkIds || []).map(String)).replace(/</g, '\\u003c') %>;
    awal.forEach(function (id) { for (var i = 0; i < pilih.options.length; i++) { if (pilih.options[i].value === id) terpilih[id] = pilih.options[i].dataset.nama; } });
    gambar();
  })();
</script>

<%- include('../partials/footer-landing') %>
