<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-award me-2"></i><%= title %></h4>
  </div>

  <div class="info-card">
    <div class="card-header"><h6><i class="bi bi-upload"></i> Unggah Sertifikat Baru</h6></div>
    <div class="card-body">
      <form method="POST" action="/dosen/sertifikat" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Judul Sertifikat</label>
            <input type="text" name="judul" class="form-control" placeholder="Contoh: Sertifikat Pelatihan Kurikulum Merdeka" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Penerbit</label>
            <input type="text" name="penerbit" class="form-control" placeholder="Contoh: Kemendikbudristek">
          </div>
          <div class="col-md-6">
            <label class="form-label">Tanggal Terbit</label>
            <input type="date" name="tanggalTerbit" class="form-control">
          </div>
          <div class="col-md-6">
            <label class="form-label">File Sertifikat (PDF/Gambar)</label>
            <input type="file" name="file" class="form-control" accept=".pdf,image/*" required>
          </div>
        </div>
        <button type="submit" class="btn btn-gradient mt-3">
          <i class="bi bi-check-lg me-1"></i> Unggah
        </button>
      </form>
    </div>
  </div>

  <div class="info-card">
    <div class="card-header"><h6><i class="bi bi-collection"></i> Sertifikat Saya</h6></div>
    <div class="card-body">
      <% if (sertifikat.length === 0) { %>
        <p class="text-muted mb-0 text-center py-4">Belum ada sertifikat.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Judul</th>
                <th>Penerbit</th>
                <th>Tanggal Terbit</th>
                <th>Sumber</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% sertifikat.forEach(function(s) { %>
                <tr>
                  <td><%= s.judul %></td>
                  <td><%= s.penerbit || '-' %></td>
                  <td><%= s.tanggalTerbit ? new Date(s.tanggalTerbit).toLocaleDateString('id-ID') : '-' %></td>
                  <td>
                    <span class="badge bg-<%= s.sumber === 'admin' ? 'primary' : 'secondary' %>">
                      <%= s.sumber === 'admin' ? 'Dikirim Admin' : 'Unggahan Sendiri' %>
                    </span>
                  </td>
                  <td class="text-nowrap">
                    <a href="<%= s.fileUrl %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Lihat">
                      <i class="bi bi-eye"></i>
                    </a>
                    <% if (s.sumber === 'dosen') { %>
                      <form method="POST" action="/dosen/sertifikat/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('Hapus sertifikat ini?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus"><i class="bi bi-trash"></i></button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
