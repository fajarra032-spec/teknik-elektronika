<%- include('../partials/header') %>

<%
  const getImageUrl = (url) => {
    if (!url) return null;
    let match = url.match(/[?&]id=([^&]+)/);
    if (match) return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w100-h100`;
    match = url.match(/\/d\/([^\/]+)/);
    if (match) return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w100-h100`;
    return url;
  };

  const searchLower = (search || '').trim().toLowerCase();
  const filteredList = searchLower
    ? mahasiswaList.filter(m =>
        (m.nama || '').toLowerCase().includes(searchLower) ||
        (m.nim || '').toLowerCase().includes(searchLower))
    : mahasiswaList;
%>

<style>
  :root {
    --primary-start: #2193b0;
    --primary-end: #6dd5ed;
    --primary-light: rgba(33,147,176,0.1);
  }
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 1.5rem 2rem;
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 15px 30px rgba(33,147,176,0.25);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .page-header h2 { margin: 0; font-weight: 700; }
  .page-header .btn-back {
    background: rgba(255,255,255,0.2);
    color: white;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
  }
  .page-header .btn-back:hover { background: rgba(255,255,255,0.35); color: white; }
  .filter-card {
    background: white;
    border-radius: 1.5rem;
    padding: 1.2rem 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    margin-bottom: 1.5rem;
  }
  .btn-filter {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white; border: none; border-radius: 50px; padding: 0.5rem 1.5rem; font-weight: 600;
  }
  .btn-reset {
    background: #f1f3f5; color: #495057; border-radius: 50px; padding: 0.5rem 1.5rem;
    font-weight: 600; text-decoration: none; display: inline-block; text-align: center;
  }
  .table-container {
    background: white; border-radius: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden; border: 1px solid rgba(33,147,176,0.1);
  }
  .mahasiswa-table { margin-bottom: 0; }
  .mahasiswa-table thead th {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white; font-weight: 600; text-transform: uppercase; font-size: 0.85rem;
    letter-spacing: 0.5px; border: none; padding: 1.2rem 1rem; white-space: nowrap;
  }
  .mahasiswa-table tbody td { vertical-align: middle; padding: 1.2rem 1rem; border-bottom: 1px solid #e9ecef; }
  .mahasiswa-table tbody tr:hover td { background-color: #f8f9fa; }
  .avatar-circle {
    width: 45px; height: 45px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white; display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 1.2rem; text-transform: uppercase;
  }
  .foto-mahasiswa {
    width: 45px; height: 45px; object-fit: cover; border-radius: 50%;
    border: 3px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }
  .empty-state { text-align: center; padding: 2rem; color: #868e96; }
  .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
</style>

<div class="container mt-4">
  <div class="page-header">
    <h2><i class="bi bi-person-check-fill"></i> Mahasiswa Bimbingan Akademik (PA)</h2>
    <a href="/dosen/dashboard" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <div class="filter-card">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-8">
        <label for="search" class="form-label fw-semibold">Cari Nama/NIM</label>
        <input type="text" class="form-control" id="search" name="search" placeholder="Ketik nama atau NIM" value="<%= search || '' %>">
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn-filter w-100">
          <i class="bi bi-funnel"></i> Filter
        </button>
      </div>
      <div class="col-md-2">
        <a href="/dosen/mahasiswa-pa" class="btn-reset w-100">
          <i class="bi bi-arrow-counterclockwise"></i> Reset
        </a>
      </div>
    </form>
  </div>

  <p class="text-muted mb-3">
    Total mahasiswa bimbingan akademik: <strong><%= filteredList.length %></strong> dari <strong><%= mahasiswaList.length %></strong>
  </p>

  <div class="table-container">
    <div class="table-responsive">
      <table class="table mahasiswa-table">
        <thead>
          <tr>
            <th>No</th>
            <th>Foto</th>
            <th>NIM</th>
            <th>Nama</th>
            <th>Semester</th>
            <th>Kelas</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (filteredList.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-5">
                <div class="empty-state">
                  <i class="bi bi-inbox"></i>
                  <p><%= mahasiswaList.length === 0 ? 'Belum ada mahasiswa yang ditugaskan ke Anda sebagai Dosen PA.' : 'Tidak ada yang cocok dengan pencarian.' %></p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% filteredList.forEach((m, index) => {
              const imageUrl = m.foto ? getImageUrl(m.foto) : null;
            %>
            <tr>
              <td class="fw-bold"><%= index + 1 %></td>
              <td>
                <% if (imageUrl) { %>
                  <img src="<%= imageUrl %>" alt="foto <%= m.nama %>" class="foto-mahasiswa"
                       onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(m.nama || '?') %>&background=2193b0&color=fff&size=45';">
                <% } else { %>
                  <div class="avatar-circle"><%= (m.nama || '?').charAt(0).toUpperCase() %></div>
                <% } %>
              </td>
              <td><strong><%= m.nim || '-' %></strong></td>
              <td><%= m.nama || '-' %></td>
              <td><%= m.semester || '-' %></td>
              <td><%= m.kelas || '-' %></td>
              <td>
                <span class="badge <%= m.statusMahasiswa === 'Aktif' ? 'bg-success' : 'bg-secondary' %>">
                  <%= m.statusMahasiswa || '-' %>
                </span>
              </td>
            </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
