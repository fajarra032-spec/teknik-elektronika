<%- include('../partials/header') %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }

  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem; padding: 1.8rem 2rem; color: white; margin-bottom: 1.5rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
  }
  .page-header h2 { font-weight: 700; margin-bottom: 0.3rem; }
  .page-header p { margin: 0; opacity: 0.9; }
  .page-header .btn-back {
    background: white; border: none; border-radius: 50px; padding: 0.5rem 1.4rem; font-weight: 600;
    color: var(--primary-start); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }

  .info-card {
    background: white; border-radius: 1.2rem; padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04); border: 1px solid rgba(30,58,138,0.08); margin-bottom: 1.5rem;
  }
  .info-card h5 { font-weight: 700; color: #1e293b; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }

  .btn-toggle-form {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); border: none; color: white;
    font-weight: 600; padding: 0.6rem 1.4rem; border-radius: 50px; box-shadow: 0 8px 20px rgba(30,58,138,0.25);
  }

  #editor-tambah { min-height: 220px; background: white; }

  .modul-card {
    background: white; border-radius: 1.2rem; padding: 1.25rem 1.5rem; margin-bottom: 1rem;
    box-shadow: 0 8px 20px rgba(0,0,0,0.04); border: 1px solid rgba(30,58,138,0.08);
  }
  .modul-urutan {
    display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem;
    background: var(--primary-light); color: var(--primary-dark); border-radius: 50%; font-weight: 700; font-size: 0.85rem;
  }
  .modul-ringkasan { color: #64748b; font-size: 0.9rem; margin: 0.5rem 0; }
  .modul-lampiran { font-size: 0.85rem; }

  .btn-action { border-radius: 50px; padding: 0.35rem 0.9rem; font-size: 0.82rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; border: none; }
  .btn-action-outline { border: 1.5px solid var(--primary-start); color: var(--primary-start); background: transparent; }
  .btn-action-outline:hover { background: var(--primary-light); }
  .btn-action-danger { background: #fee2e2; color: #b91c1c; }
  .btn-action-danger:hover { background: #fecaca; }

  .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
  .empty-state i { font-size: 3rem; color: #adb5bd; margin-bottom: 1rem; display: block; }
</style>

<div class="container mt-4">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h2><i class="bi bi-journal-richtext me-2"></i>Modul</h2>
      <p><%= mk.kode %> - <%= mk.nama %></p>
    </div>
    <a href="/dosen/mk/<%= mk.id %>" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <%- include('./partials/mk_tabs', { mk, activeTab: 'modul' }) %>

  <div class="alert alert-info" style="border-radius: 1rem;">
    <i class="bi bi-info-circle me-1"></i>
    Isi modul sepenuhnya bebas - tulis langsung pakai editor di bawah, <strong>upload file PDF</strong> (akan tampil
    sebagai preview di halaman), atau keduanya sekaligus. Tidak ada format baku, urutan modul juga bisa diatur sendiri.
  </div>

  <!-- Tambah Modul Baru (inline, collapsible) -->
  <div class="info-card">
    <div class="d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#formModulBaru">
      <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Tambah Modul</h5>
      <button type="button" class="btn-toggle-form" data-bs-toggle="collapse" data-bs-target="#formModulBaru">
        <i class="bi bi-plus-lg"></i> Tambah
      </button>
    </div>
    <div class="collapse mt-4" id="formModulBaru">
      <form method="POST" action="/dosen/mk/<%= mk.id %>/modul" enctype="multipart/form-data" id="formTambahModul">
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label small fw-semibold">Judul Modul</label>
            <input type="text" class="form-control" name="judul" placeholder="mis. Modul 1 - Pengantar Rangkaian Listrik" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Urutan</label>
            <input type="number" class="form-control" name="urutan" value="<%= modulList.length + 1 %>">
          </div>
          <div class="col-12">
            <label class="form-label small fw-semibold">Isi Modul</label>
            <div id="editor-tambah"></div>
            <input type="hidden" name="konten" id="konten-tambah">
          </div>
          <div class="col-12">
            <label class="form-label small fw-semibold">Upload Modul (PDF, opsional)</label>
            <input type="file" class="form-control" name="file" accept="application/pdf,.pdf">
            <small class="text-muted">Kalau modul Anda sudah dalam bentuk file PDF, unggah di sini - akan tampil sebagai preview langsung di halaman.</small>
          </div>
        </div>
        <div class="text-end mt-3">
          <button type="submit" class="btn-toggle-form"><i class="bi bi-save me-1"></i> Simpan Modul</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Daftar Modul -->
  <% if (!modulList || modulList.length === 0) { %>
    <div class="info-card">
      <div class="empty-state">
        <i class="bi bi-journal-x"></i>
        Belum ada modul untuk mata kuliah ini. Tambahkan modul pertama di atas.
      </div>
    </div>
  <% } else { %>
    <% modulList.forEach(m => { %>
      <div class="modul-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <span class="modul-urutan"><%= m.urutan %></span>
            <strong style="color:#1e293b; font-size:1.05rem;"><%= m.judul %></strong>
          </div>
          <div class="d-flex gap-2">
            <a href="/dosen/mk/<%= mk.id %>/modul/<%= m.id %>/edit" class="btn-action btn-action-outline">
              <i class="bi bi-pencil"></i> Edit
            </a>
            <form method="POST" action="/dosen/mk/<%= mk.id %>/modul/<%= m.id %>/delete" onsubmit="return confirm('Yakin ingin menghapus modul ini?')">
              <button type="submit" class="btn-action btn-action-danger"><i class="bi bi-trash"></i> Hapus</button>
            </form>
          </div>
        </div>
        <% if (m.fileId) { %>
          <div class="modul-pdf mt-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="modul-lampiran"><i class="bi bi-file-earmark-pdf text-danger me-1"></i><%= m.fileNama || 'Modul.pdf' %></span>
              <a href="<%= m.fileUrl %>" target="_blank" class="btn-action btn-action-outline"><i class="bi bi-box-arrow-up-right"></i> Buka Penuh</a>
            </div>
            <iframe src="https://drive.google.com/file/d/<%= m.fileId %>/preview" style="width:100%; height:480px; border:1px solid #e2e8f0; border-radius:0.75rem;" allow="autoplay"></iframe>
          </div>
        <% } else if (m.fileUrl) { %>
          <div class="modul-lampiran mt-2">
            <a href="<%= m.fileUrl %>" target="_blank"><i class="bi bi-paperclip me-1"></i><%= m.fileNama || 'Lampiran' %></a>
          </div>
        <% } %>
        <% if (m.konten) { %><div class="modul-konten mt-2"><%- m.konten %></div><% } %>
      </div>
    <% }) %>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  const quillTambah = new Quill('#editor-tambah', {
    theme: 'snow',
    placeholder: 'Tulis isi modul di sini...'
  });
  document.getElementById('formTambahModul').addEventListener('submit', function () {
    document.getElementById('konten-tambah').value = quillTambah.root.innerHTML;
  });
</script>

<%- include('../partials/footer') %>
