<%- include('../partials/header') %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }

  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem; padding: 1.8rem 2rem; color: white; margin-bottom: 1.5rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
  }
  .page-header h2 { font-weight: 700; margin-bottom: 0.3rem; }
  .page-header p { margin: 0; opacity: 0.9; }
  .page-header .btn-back {
    background: white; border: none; border-radius: 50px; padding: 0.5rem 1.4rem; font-weight: 600;
    color: var(--primary-start); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }

  .info-card {
    background: white; border-radius: 1.2rem; padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04); border: 1px solid rgba(30,58,138,0.08); margin-bottom: 1.5rem;
  }
  .info-card h5 { font-weight: 700; color: #1e293b; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }

  .btn-toggle-form {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); border: none; color: white;
    font-weight: 600; padding: 0.6rem 1.4rem; border-radius: 50px; box-shadow: 0 8px 20px rgba(30,58,138,0.25);
  }

  #editor-tambah { min-height: 220px; background: white; }

  .modul-card {
    background: white; border-radius: 1.2rem; padding: 1.25rem 1.5rem; margin-bottom: 1rem;
    box-shadow: 0 8px 20px rgba(0,0,0,0.04); border: 1px solid rgba(30,58,138,0.08);
  }
  .modul-urutan {
    display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem;
    background: var(--primary-light); color: var(--primary-dark); border-radius: 50%; font-weight: 700; font-size: 0.85rem;
  }
  .modul-ringkasan { color: #64748b; font-size: 0.9rem; margin: 0.5rem 0; }
  .modul-lampiran { font-size: 0.85rem; }

  .btn-action { border-radius: 50px; padding: 0.35rem 0.9rem; font-size: 0.82rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; border: none; }
  .btn-action-outline { border: 1.5px solid var(--primary-start); color: var(--primary-start); background: transparent; }
  .btn-action-outline:hover { background: var(--primary-light); }
  .btn-action-danger { background: #fee2e2; color: #b91c1c; }
  .btn-action-danger:hover { background: #fecaca; }

  .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
  .empty-state i { font-size: 3rem; color: #adb5bd; margin-bottom: 1rem; display: block; }

  /* ===== Modul Template (job sheet) ===== */
  .section-divider {
    display: flex; align-items: center; gap: 0.75rem; margin: 2rem 0 1rem 0; color: #94a3b8; font-weight: 700;
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .section-divider::before, .section-divider::after { content: ''; flex: 1; height: 1px; background: #e2e8f0; }

  .publish-banner {
    background: white; border: 1px solid rgba(30,58,138,0.12); border-radius: 1.2rem;
    padding: 1.1rem 1.4rem; margin-bottom: 1.2rem; box-shadow: 0 10px 25px rgba(0,0,0,0.03);
    display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center;
  }
  .publish-banner .status-text { font-weight: 600; color: #1e293b; }
  .publish-banner .status-sub { font-size: 0.83rem; color: #64748b; }
  .badge-on { background: #d1fae5; color: #065f46; }
  .badge-off { background: #f1f5f9; color: #64748b; }
  .badge-toggle { padding: 0.3rem 0.8rem; border-radius: 50px; font-weight: 600; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.3rem; }
  .btn-toggle-publish {
    border: none; border-radius: 50px; padding: 0.55rem 1.4rem; font-weight: 600; font-size: 0.85rem;
    color: white; background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    box-shadow: 0 6px 16px rgba(30,58,138,0.25);
  }
  .btn-toggle-publish.off { background: #64748b; box-shadow: none; }

  .tpl-card { background: white; border-radius: 1.2rem; border: 1px solid rgba(30,58,138,0.1); box-shadow: 0 8px 20px rgba(0,0,0,0.04); margin-bottom: 1rem; overflow: hidden; }
  .tpl-card.is-active { border-color: rgba(16,185,129,0.35); }
  .tpl-header { padding: 1rem 1.3rem; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; cursor: pointer; }
  .tpl-header:hover { background: #f8fafc; }
  .tpl-num { width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--primary-light); color: var(--primary-start); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; font-size: 0.85rem; }
  .tpl-title { font-weight: 700; color: #1e293b; font-size: 0.98rem; }
  .tpl-meta { font-size: 0.78rem; color: #64748b; }
  .tpl-body { padding: 0 1.3rem 1.3rem 1.3rem; display: none; border-top: 1px solid #eef1f5; }
  .tpl-body.show { display: block; }
  .tpl-body h6 { font-weight: 700; color: #1e3a8a; margin: 0.9rem 0 0.4rem 0; font-size: 0.85rem; display:flex; align-items:center; gap:0.4rem; }
  .tpl-body ul, .tpl-body ol { margin-bottom: 0; padding-left: 1.2rem; }
  .tpl-body li { margin-bottom: 0.3rem; font-size: 0.88rem; color: #334155; }
  .tpl-body p.teori { font-size: 0.88rem; color: #334155; background: #f8fafc; padding: 0.7rem 0.9rem; border-radius: 0.7rem; border: 1px solid #eef1f5; }
  .k3-box { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; padding: 0.6rem 0.9rem; border-radius: 0.7rem; font-size: 0.82rem; margin-top: 0.6rem; }
  .tpl-form { background: #f8fafc; border-radius: 0.8rem; padding: 0.9rem; margin-top: 0.9rem; border: 1px dashed #cbd5e1; }
  .tpl-form label { font-size: 0.78rem; font-weight: 600; color: #475569; }
  .tpl-form .form-control { font-size: 0.83rem; }
  .switch { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider { position: absolute; cursor: pointer; inset: 0; background-color: #cbd5e1; transition: .2s; border-radius: 34px; }
  .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .2s; border-radius: 50%; }
  input:checked + .slider { background: linear-gradient(135deg, #10b981, #059669); }
  input:checked + .slider:before { transform: translateX(20px); }
  .switch-form { display: inline-flex; align-items: center; gap: 0.45rem; }
  .switch-label { font-size: 0.75rem; font-weight: 600; color: #64748b; }
  .file-chip { display: inline-flex; align-items: center; gap: 0.35rem; background: var(--primary-light); color: var(--primary-start); padding: 0.3rem 0.7rem; border-radius: 50px; font-size: 0.75rem; text-decoration: none; font-weight: 500; }
</style>

<div class="container mt-4">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h2><i class="bi bi-journal-richtext me-2"></i>Modul</h2>
      <p><%= mk.kode %> - <%= mk.nama %></p>
    </div>
    <a href="/dosen/mk/<%= mk.id %>" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <%- include('./partials/mk_tabs', { mk, activeTab: 'modul' }) %>

  <div class="alert alert-info" style="border-radius: 1rem;">
    <i class="bi bi-info-circle me-1"></i>
    Ada dua cara mengisi Modul untuk mahasiswa, <strong>silakan pakai salah satu, keduanya, atau tidak sama sekali</strong>:
    modul <strong>Template (job sheet)</strong> yang sudah disiapkan sistem (khusus MK tertentu, tinggal aktifkan),
    dan modul <strong>Manual</strong> yang isinya bebas Bapak/Ibu tulis sendiri. Semuanya sepenuhnya opsional.
  </div>

  <!-- ============================== -->
  <!-- MODUL TEMPLATE (JOB SHEET)     -->
  <!-- ============================== -->
  <% if (jenisPraktikum) { %>
    <div class="section-divider">Modul Template &mdash; <%= jenisPraktikumLabel %></div>

    <div class="publish-banner">
      <div>
        <div class="status-text">
          <span class="badge-toggle <%= templatePublished ? 'badge-on' : 'badge-off' %>">
            <i class="bi <%= templatePublished ? 'bi-eye' : 'bi-eye-slash' %>"></i>
            <%= templatePublished ? 'Ditampilkan di ELK-Learning' : 'Belum ditampilkan di ELK-Learning' %>
          </span>
        </div>
        <div class="status-sub mt-1">
          <%= jumlahTemplateAktif %> dari <%= templateModulList.length %> modul template sudah diaktifkan untuk mahasiswa.
          Modul manual di bawah tidak terpengaruh oleh saklar ini.
        </div>
      </div>
      <form method="POST" action="/dosen/mk/<%= mk.id %>/modul-template/publish">
        <button type="submit" class="btn-toggle-publish <%= templatePublished ? '' : 'off' %>">
          <i class="bi <%= templatePublished ? 'bi-toggle-on' : 'bi-toggle-off' %> me-1"></i>
          <%= templatePublished ? 'Sembunyikan dari Mahasiswa' : 'Tampilkan ke Mahasiswa' %>
        </button>
      </form>
    </div>

    <% templateModulList.forEach((m, i) => { %>
      <div class="tpl-card <%= m.aktif ? 'is-active' : '' %>">
        <div class="tpl-header" onclick="toggleTplBody('<%= m.id %>')">
          <div class="d-flex align-items-center gap-3">
            <span class="tpl-num">#<%= i + 1 %></span>
            <div>
              <div class="tpl-title"><%= m.judul %></div>
              <div class="tpl-meta">
                <i class="bi bi-clock-history"></i> <%= m.estimasiWaktu %>
                &middot; Saran pertemuan ke-<%= m.pertemuanSaran %>
                <% if (m.tanggal) { %> &middot; <i class="bi bi-calendar-check"></i> <%= new Date(m.tanggal).toLocaleDateString('id-ID') %><% } %>
              </div>
            </div>
          </div>
          <div class="d-flex align-items-center gap-3" onclick="event.stopPropagation()">
            <% if (m.fileUrl) { %>
              <a href="<%= m.fileUrl %>" target="_blank" class="file-chip"><i class="bi bi-file-earmark-pdf"></i> Job Sheet</a>
            <% } %>
            <form method="POST" action="/dosen/mk/<%= mk.id %>/modul-template/<%= m.id %>/toggle" class="switch-form">
              <span class="switch-label"><%= m.aktif ? 'Aktif' : 'Nonaktif' %></span>
              <label class="switch">
                <input type="checkbox" <%= m.aktif ? 'checked' : '' %> onchange="this.form.submit()">
                <span class="slider"></span>
              </label>
            </form>
            <i class="bi bi-chevron-down" id="tpl-chevron-<%= m.id %>"></i>
          </div>
        </div>

        <div class="tpl-body" id="tpl-body-<%= m.id %>">
          <h6><i class="bi bi-bullseye"></i> Tujuan Praktikum</h6>
          <ul><% m.tujuan.forEach(t => { %><li><%= t %></li><% }) %></ul>

          <h6><i class="bi bi-tools"></i> Alat &amp; Bahan</h6>
          <ul><% m.alatBahan.forEach(a => { %><li><%= a %></li><% }) %></ul>

          <h6><i class="bi bi-book"></i> Dasar Teori</h6>
          <p class="teori"><%= m.dasarTeori %></p>

          <h6><i class="bi bi-list-ol"></i> Langkah Kerja</h6>
          <ol><% m.langkahKerja.forEach(l => { %><li><%= l %></li><% }) %></ol>

          <h6><i class="bi bi-journal-check"></i> Tugas / Isi Laporan</h6>
          <ul><% m.tugasLaporan.forEach(t => { %><li><%= t %></li><% }) %></ul>

          <% if (m.k3) { %>
            <div class="k3-box"><i class="bi bi-exclamation-triangle me-1"></i><strong>Keselamatan Kerja:</strong> <%= m.k3 %></div>
          <% } %>

          <% if (m.catatanDosen) { %>
            <div class="mt-3 small text-muted"><i class="bi bi-chat-left-text"></i> <strong>Catatan dosen:</strong> <%= m.catatanDosen %></div>
          <% } %>

          <div class="tpl-form">
            <form method="POST" action="/dosen/mk/<%= mk.id %>/modul-template/<%= m.id %>/catatan" enctype="multipart/form-data">
              <div class="row g-2 align-items-end">
                <div class="col-sm-3">
                  <label class="form-label mb-1">Tanggal pelaksanaan</label>
                  <input type="date" name="tanggal" class="form-control form-control-sm" value="<%= m.tanggal ? m.tanggal.split('T')[0] : '' %>">
                </div>
                <div class="col-sm-5">
                  <label class="form-label mb-1">Catatan dosen (opsional)</label>
                  <input type="text" name="catatanDosen" class="form-control form-control-sm" value="<%= m.catatanDosen %>" placeholder="Mis. kelas dibagi 2 sesi, dst.">
                </div>
                <div class="col-sm-3">
                  <label class="form-label mb-1">Unggah job sheet sendiri (PDF)</label>
                  <input type="file" name="file" class="form-control form-control-sm" accept=".pdf,.doc,.docx">
                </div>
                <div class="col-sm-1">
                  <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-check-lg"></i></button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% }) %>

    <div class="section-divider">Modul Manual</div>
  <% } %>

  <!-- ============================== -->
  <!-- MODUL MANUAL (isi bebas)       -->
  <!-- ============================== -->

  <!-- Tambah Modul Baru (inline, collapsible) -->
  <div class="info-card">
    <div class="d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#formModulBaru">
      <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Tambah Modul Manual</h5>
      <button type="button" class="btn-toggle-form" data-bs-toggle="collapse" data-bs-target="#formModulBaru">
        <i class="bi bi-plus-lg"></i> Tambah
      </button>
    </div>
    <div class="collapse mt-4" id="formModulBaru">
      <form method="POST" action="/dosen/mk/<%= mk.id %>/modul" enctype="multipart/form-data" id="formTambahModul">
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label small fw-semibold">Judul Modul</label>
            <input type="text" class="form-control" name="judul" placeholder="mis. Modul 1 - Pengantar Rangkaian Listrik" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Urutan</label>
            <input type="number" class="form-control" name="urutan" value="<%= modulList.length + 1 %>">
          </div>
          <div class="col-12">
            <label class="form-label small fw-semibold">Isi Modul</label>
            <div id="editor-tambah"></div>
            <input type="hidden" name="konten" id="konten-tambah">
          </div>
          <div class="col-12">
            <label class="form-label small fw-semibold">Upload Modul (PDF, opsional)</label>
            <input type="file" class="form-control" name="file" accept="application/pdf,.pdf">
            <small class="text-muted">Kalau modul Anda sudah dalam bentuk file PDF, unggah di sini - akan tampil sebagai preview langsung di halaman.</small>
          </div>
        </div>
        <div class="text-end mt-3">
          <button type="submit" class="btn-toggle-form"><i class="bi bi-save me-1"></i> Simpan Modul</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Daftar Modul -->
  <% if (!modulList || modulList.length === 0) { %>
    <div class="info-card">
      <div class="empty-state">
        <i class="bi bi-journal-x"></i>
        Belum ada modul untuk mata kuliah ini. Tambahkan modul pertama di atas.
      </div>
    </div>
  <% } else { %>
    <% modulList.forEach(m => { %>
      <div class="modul-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <span class="modul-urutan"><%= m.urutan %></span>
            <strong style="color:#1e293b; font-size:1.05rem;"><%= m.judul %></strong>
          </div>
          <div class="d-flex gap-2">
            <a href="/dosen/mk/<%= mk.id %>/modul/<%= m.id %>/edit" class="btn-action btn-action-outline">
              <i class="bi bi-pencil"></i> Edit
            </a>
            <form method="POST" action="/dosen/mk/<%= mk.id %>/modul/<%= m.id %>/delete" onsubmit="return confirm('Yakin ingin menghapus modul ini?')">
              <button type="submit" class="btn-action btn-action-danger"><i class="bi bi-trash"></i> Hapus</button>
            </form>
          </div>
        </div>
        <% if (m.fileId) { %>
          <div class="modul-pdf mt-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="modul-lampiran"><i class="bi bi-file-earmark-pdf text-danger me-1"></i><%= m.fileNama || 'Modul.pdf' %></span>
              <a href="<%= m.fileUrl %>" target="_blank" class="btn-action btn-action-outline"><i class="bi bi-box-arrow-up-right"></i> Buka Penuh</a>
            </div>
            <iframe src="https://drive.google.com/file/d/<%= m.fileId %>/preview" style="width:100%; height:480px; border:1px solid #e2e8f0; border-radius:0.75rem;" allow="autoplay"></iframe>
          </div>
        <% } else if (m.fileUrl) { %>
          <div class="modul-lampiran mt-2">
            <a href="<%= m.fileUrl %>" target="_blank"><i class="bi bi-paperclip me-1"></i><%= m.fileNama || 'Lampiran' %></a>
          </div>
        <% } %>
        <% if (m.konten) { %><div class="modul-konten mt-2"><%- m.konten %></div><% } %>
      </div>
    <% }) %>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  function toggleTplBody(id) {
    const body = document.getElementById('tpl-body-' + id);
    const chevron = document.getElementById('tpl-chevron-' + id);
    const showing = body.classList.toggle('show');
    chevron.className = showing ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
  }

  const quillTambah = new Quill('#editor-tambah', {
    theme: 'snow',
    placeholder: 'Tulis isi modul di sini...'
  });
  document.getElementById('formTambahModul').addEventListener('submit', function () {
    document.getElementById('konten-tambah').value = quillTambah.root.innerHTML;
  });
</script>

<%- include('../partials/footer') %>
