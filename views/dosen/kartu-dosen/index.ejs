<%- include('../../partials/header') %>
<%
const getDriveImageUrl=(url)=>{if(!url)return null;const raw=String(url).trim();const m=raw.match(/[?&]id=([^&]+)/)||raw.match(/\/d\/([^/]+)/)||raw.match(/\/file\/d\/([^/]+)/);return m&&m[1]?`https://drive.google.com/thumbnail?id=${encodeURIComponent(m[1])}&sz=w1200`:raw};
const fotoUrl=getDriveImageUrl(dosen.foto); const nama=String(dosen.nama||'Dosen').trim(); const nip=String(dosen.nip||'-').trim(); const identitas=String(dosen.nidn||dosen.nuptk||'-').trim();
%>
<style>
:root{--n:#102f5c;--t:#173461;--g:#f4b400;--w:713px}.ktd-page{max-width:1550px;margin:auto;padding:1.5rem 1rem 3rem}.ktd-toolbar{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.25rem}.ktd-toolbar h1{margin:0;color:var(--n);font-weight:800;font-size:clamp(1.4rem,3vw,2rem)}.ktd-toolbar p{margin:.3rem 0;color:#64748b}.ktd-actions{display:flex;gap:.5rem;flex-wrap:wrap}.ktd-shell{background:#fff;border-radius:24px;padding:clamp(.75rem,2.5vw,2rem);box-shadow:0 18px 45px rgba(16,47,92,.12);overflow:auto}.ktd-grid{display:grid;grid-template-columns:repeat(2,minmax(320px,713px));justify-content:center;gap:2rem;min-width:720px}.ktd-title{text-align:center;margin:0 0 .7rem;font-weight:800;color:var(--n);font-size:1rem;text-transform:uppercase}.ktd-card{position:relative;width:100%;max-width:var(--w);aspect-ratio:713/1004;margin:auto;overflow:hidden;background:#fff;box-shadow:0 10px 30px rgba(15,43,92,.2)}.ktd-template{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:fill;z-index:0}.ktd-photo{position:absolute;left:27%;top:24.5%;width:63%;height:29%;overflow:hidden;z-index:2;background:#eef4fb;border:3px solid rgba(16,47,92,.12);border-radius:22px;box-shadow:0 10px 24px rgba(16,47,92,.15)}.ktd-photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:center top}.ktd-empty{height:100%;display:grid;place-items:center;color:rgba(23,52,97,.25);font-size:5rem}.ktd-value{position:absolute;left:38%;width:48%;z-index:3;height:4.3%;display:flex;align-items:center;font-family:'Segoe UI',Arial,sans-serif;color:var(--t);font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ktd-name{top:57.6%;font-size:clamp(12px,1.7vw,18px)}.ktd-nip{top:65%;font-size:clamp(12px,1.65vw,17px)}.ktd-id{top:72.3%;font-size:clamp(11px,1.55vw,16px)}
@media(max-width:1100px){.ktd-grid{grid-template-columns:minmax(320px,713px);min-width:0}}@media(max-width:575px){.ktd-page{padding:.8rem .35rem 2rem}.ktd-shell{padding:.5rem}.ktd-actions .btn{flex:1 1 auto}}
@media print{html,body{width:85.6mm!important;margin:0!important;padding:0!important;background:#fff!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}body *{visibility:hidden!important}.ktd-page,.ktd-page *,.ktd-card,.ktd-card *{visibility:visible!important}.navbar,.ktd-toolbar,.ktd-title,.no-print,footer{display:none!important}.ktd-page{width:85.6mm!important;margin:0!important;padding:0!important;max-width:none!important}.ktd-shell{width:85.6mm!important;margin:0!important;padding:0!important;border:0!important;box-shadow:none!important;overflow:visible!important}.ktd-grid{display:block!important;min-width:0!important}.ktd-wrap{width:85.6mm!important;height:120.6mm!important;break-after:page!important;page-break-after:always!important}.ktd-wrap:last-child{break-after:auto!important;page-break-after:auto!important}.ktd-card{width:85.6mm!important;height:120.6mm!important;max-width:none!important;aspect-ratio:auto!important;box-shadow:none!important}.ktd-template{object-fit:fill!important}@page{size:85.6mm 120.6mm;margin:0}}
</style>
<div class="ktd-page"><div class="ktd-toolbar"><div><h1><i class="bi bi-person-vcard-fill me-2"></i>Kartu Tanda Dosen</h1><p>Foto dan identitas diambil otomatis dari profil dosen.</p></div><div class="ktd-actions no-print"><a href="/dosen/biodata" class="btn btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Perbarui Profil</a><button class="btn btn-outline-primary" onclick="document.getElementById('ktd-belakang').scrollIntoView({behavior:'smooth',block:'center'})">Lihat Belakang</button><button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer-fill me-1"></i>Cetak Depan & Belakang</button></div></div><div class="ktd-shell"><div class="ktd-grid">
<section class="ktd-wrap"><h2 class="ktd-title">Sisi Depan</h2><article class="ktd-card"><img class="ktd-template" src="/images/ktdosen/ktdosen-depan.png" alt="Kartu Tanda Dosen depan"><div class="ktd-photo"><%if(fotoUrl){%><img src="<%=fotoUrl%>" alt="Foto <%=nama%>" onerror="this.onerror=null;this.style.display='none';"><%}else{%><div class="ktd-empty"><i class="bi bi-person-circle"></i></div><%}%></div><div class="ktd-value ktd-name"><%=nama%></div><div class="ktd-value ktd-nip"><%=nip%></div><div class="ktd-value ktd-id"><%=identitas%></div></article></section>
<section class="ktd-wrap" id="ktd-belakang"><h2 class="ktd-title">Sisi Belakang</h2><article class="ktd-card"><img class="ktd-template" src="/images/ktdosen/ktdosen-belakang.png" alt="Kartu Tanda Dosen belakang"></article></section>
</div></div><p class="no-print" style="text-align:center;color:#64748b">Ukuran kartu 85,6 × 120,6 mm. Aktifkan <strong>Background graphics</strong> saat mencetak.</p></div>
<%- include('../../partials/footer') %>
