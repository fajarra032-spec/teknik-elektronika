<%- include('../partials/header') %>

<%
  if (typeof mk === 'undefined') mk = { kode: '', nama: '' };
  if (typeof tugasList === 'undefined') tugasList = [];
  if (typeof data === 'undefined') data = [];
%>

<style>
  :root { --primary-start: #1e3a8a; --primary-end: #3b82f6; }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.2rem; padding: 1.5rem 2rem; color: white; margin-bottom: 1.2rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
  }
  .page-header h2 { font-weight: 700; margin: 0; font-size: 1.6rem; }
  .page-header a { background: white; border-radius: 50px; padding: 0.5rem 1.4rem; font-weight: 600;
    color: var(--primary-start); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; }
  .info-note { background: #eef2ff; border-left: 4px solid var(--primary-start); border-radius: 0.8rem;
    padding: 0.9rem 1.3rem; font-size: 0.9rem; color: #1e293b; margin-bottom: 1.2rem; }
  .table-responsive { border-radius: 1rem; overflow-x: auto; box-shadow: 0 10px 25px rgba(0,0,0,0.05); background: white; }
  .rincian-table { width: 100%; border-collapse: collapse; min-width: 900px; }
  .rincian-table thead th {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); color: white; font-weight: 600;
    font-size: 0.75rem; text-transform: uppercase; padding: 0.7rem 0.5rem; text-align: center; position: sticky; top: 0;
  }
  .rincian-table tbody td { padding: 0.55rem 0.5rem; border-bottom: 1px solid #e9ecef; font-size: 0.85rem; text-align: center; }
  .rincian-table tbody tr:nth-child(even) { background: #f8fafc; }
  .name-cell { text-align: left !important; white-space: nowrap; }
  .rata-cell { background: #d9e1f2; font-weight: 700; border-radius: 0.5rem; padding: 0.25rem 0.5rem; display: inline-block; min-width: 45px; }
  .kosong { color: #94a3b8; }
</style>

<div class="container-fluid mt-4">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h2><i class="bi bi-list-check me-2"></i>Rincian Tugas - <%= mk.kode %> <%= mk.nama %></h2>
    <a href="/dosen/rubrik/<%= mk.id %>?periode=<%= encodeURIComponent(periode) %>"><i class="bi bi-arrow-left"></i> Kembali ke Rubrik</a>
  </div>

  <% if (typeof tugasSalahMk !== 'undefined' && tugasSalahMk.length > 0) { %>
    <div class="alert alert-danger" style="border-radius: 0.8rem;">
      <i class="bi bi-exclamation-triangle-fill me-1"></i>
      <strong>Ditemukan kemungkinan penyebab tidak sinkron!</strong> Ada
      <%= tugasSalahMk.length %> tugas dengan kode MK yang sama
      (<strong><%= mk.kode %></strong>) tapi <strong>tersimpan di data MK yang
      berbeda</strong> dari yang sedang Anda buka sekarang - kemungkinan besar
      ada 2 data MK "<%= mk.kode %>" yang berbeda di sistem (mis. sisa dari
      semester lalu). Tugas ini <strong>tidak akan pernah ikut terhitung</strong>
      di Rubrik/Rincian Tugas MK yang sedang dibuka, walaupun tampil normal di
      Daftar Tugas:
      <ul class="mb-0 mt-2">
        <% tugasSalahMk.forEach(t => { %>
          <li>
            "<%= t.judul %>" — <a href="/dosen/tugas/<%= t.id %>" target="_blank">lihat detail</a>
            <span class="text-muted">(ID Mata Kuliah tugas ini: <code><%= t.mkId %></code>, bukan <code><%= mk.id %></code> yang sedang dibuka)</span>
          </li>
        <% }) %>
      </ul>
      <div class="mt-2">Kabari saya kalau ini terjadi - saya bisa bantu buatkan cara memindahkan tugas ini ke MK yang benar.</div>
    </div>
  <% } %>

  <div class="info-note">
    <i class="bi bi-info-circle me-1"></i>
    Halaman ini menampilkan nilai <strong>setiap tugas satu per satu</strong> (akumulasi Tugas 1, 2, 3, dst),
    diambil dari sumber data yang sama persis dengan <a href="/dosen/tugas" target="_blank">Daftar Tugas</a> dan
    kolom "Tugas (otomatis)" di Rubrik — jadi angka di sini pasti sinkron dengan keduanya. Kolom
    <strong>Rata-rata</strong> adalah nilai yang dipakai di Rubrik. Kolom bertanda <span class="badge-manual">MANUAL</span>
    bisa diisi langsung di sini untuk tugas yang diberikan <strong>tidak lewat web</strong> (kertas, presentasi lisan, dll).
  </div>

  <div class="tambah-manual-box">
    <form method="POST" action="/dosen/rubrik/<%= mk.id %>/tugas-manual" class="d-flex flex-wrap gap-2 align-items-center">
      <input type="hidden" name="periode" value="<%= periode %>">
      <label class="fw-semibold mb-0" style="font-size:0.85rem;"><i class="bi bi-plus-circle"></i> Tambah Tugas Manual:</label>
      <input type="text" name="judul" class="form-control form-control-sm" style="max-width:260px;" placeholder="mis. Presentasi Kelompok" required>
      <button type="submit" class="btn btn-sm btn-primary">Tambah</button>
    </form>
  </div>

  <div class="table-responsive">
    <table class="rincian-table">
      <thead>
        <tr>
          <th>No</th>
          <th>NIM</th>
          <th>Nama Mahasiswa</th>
          <% tugasList.forEach((t, i) => { %>
            <th>
              <%= t.judul || ('Tugas ' + (i + 1)) %>
              <% if (t.manual) { %>
                <br><span class="badge-manual">MANUAL</span>
                <form method="POST" action="/dosen/rubrik/<%= mk.id %>/tugas-manual/<%= t.id %>/hapus"
                      onsubmit="return confirm('Hapus tugas manual ini beserta semua nilainya?');" class="d-inline">
                  <input type="hidden" name="periode" value="<%= periode %>">
                  <button type="submit" class="btn-hapus-manual" title="Hapus tugas manual ini"><i class="bi bi-x-circle"></i></button>
                </form>
              <% } %>
            </th>
          <% }) %>
          <th>Rata-rata</th>
        </tr>
      </thead>
      <tbody>
        <% if (tugasList.length === 0) { %>
          <tr><td colspan="4" class="text-center py-5 text-muted">Belum ada tugas untuk MK ini pada periode <%= periode %>. Buat lewat Daftar Tugas, atau tambah Tugas Manual di atas.</td></tr>
        <% } else if (data.length === 0) { %>
          <tr><td colspan="<%= 3 + tugasList.length + 1 %>" class="text-center py-5 text-muted">Belum ada mahasiswa aktif di MK ini.</td></tr>
        <% } %>
        <% data.forEach((item, idx) => { const n = item.nilai || {}; const mid = item.mahasiswa.id; %>
          <tr>
            <td><%= idx + 1 %></td>
            <td><%= item.mahasiswa.nim %></td>
            <td class="name-cell"><%= item.mahasiswa.nama %></td>
            <% tugasList.forEach(t => { const v = n[t.id]; %>
              <% if (t.manual) { %>
                <td>
                  <input type="number" min="0" max="100" class="manual-input" value="<%= (v === null || v === undefined) ? '' : v %>"
                         oninput="jadwalSimpanManual(this, '<%= mid %>', '<%= t.id %>')">
                </td>
              <% } else { %>
                <td class="<%= (v === null || v === undefined) ? 'kosong' : '' %>"><%= (v === null || v === undefined) ? '-' : v %></td>
              <% } %>
            <% }) %>
            <td><span class="rata-cell" id="rata-<%= mid %>"><%= (n.rata !== null && n.rata !== undefined) ? n.rata.toFixed(2) : '-' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<style>
  .badge-manual { background: #f59e0b; color: white; font-size: 0.6rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 50px; }
  .tambah-manual-box { background: white; border-radius: 0.9rem; padding: 0.9rem 1.2rem; margin-bottom: 1.2rem; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  .manual-input { width: 60px; text-align: center; border: 1px solid #fbbf24; background: #fffbeb; border-radius: 0.4rem; padding: 0.25rem; }
  .manual-input.saved-flash { border-color: #22c55e !important; background: #ecfdf5; }
  .btn-hapus-manual { background: none; border: none; color: #b91c1c; font-size: 0.85rem; padding: 0; line-height: 1; }
</style>

<script>
const timersManual = {};
function jadwalSimpanManual(el, mahasiswaId, tugasManualId) {
  const key = mahasiswaId + '-' + tugasManualId;
  clearTimeout(timersManual[key]);
  timersManual[key] = setTimeout(() => simpanNilaiManual(el, mahasiswaId, tugasManualId), 900);
}

async function simpanNilaiManual(el, mahasiswaId, tugasManualId) {
  const nilai = el.value;
  if (nilai === '') return;
  try {
    const body = new URLSearchParams({
      mkId: '<%= mk.id %>',
      mahasiswaId,
      tugasManualId,
      nilai,
      periode: '<%= periode %>'
    });
    const res = await fetch('/dosen/rubrik/tugas-manual/nilai', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body
    });
    const json = await res.json();
    if (json.success) {
      const rataEl = document.getElementById('rata-' + mahasiswaId);
      if (rataEl) rataEl.textContent = json.rataTugas !== null ? json.rataTugas.toFixed(2) : '-';
      el.classList.add('saved-flash');
      setTimeout(() => el.classList.remove('saved-flash'), 700);
    } else {
      alert('Gagal menyimpan: ' + json.message);
    }
  } catch (err) {
    alert('Gagal menyimpan nilai: ' + err.message);
  }
}
</script>

<%- include('../partials/footer') %>
