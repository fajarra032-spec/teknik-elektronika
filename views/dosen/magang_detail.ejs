<%- include('../partials/header') %>

<%
  // ========== DEFAULT VALUES ==========
  if (typeof mahasiswa === 'undefined') mahasiswa = { nama: '-', nim: '-', email: '-', noHp: '-', foto: null };
  if (typeof logbookList === 'undefined') logbookList = [];
  if (typeof semesterList === 'undefined') semesterList = [];
  if (typeof allPeriods === 'undefined') allPeriods = [];
  if (typeof selectedPeriod === 'undefined') selectedPeriod = null;
  if (typeof pdkStats === 'undefined') pdkStats = [];
  if (typeof selectedSemester === 'undefined') selectedSemester = '';
  if (typeof role === 'undefined') role = null;
  if (typeof isPembimbing === 'undefined') isPembimbing = false; // true = Dosen PA mahasiswa ini (satu-satunya pembimbing)
  if (typeof laporanList === 'undefined') laporanList = [];
  if (typeof adaLaporanYangAcc === 'undefined') adaLaporanYangAcc = false;
  if (typeof ITEM_NILAI_DOSEN === 'undefined') ITEM_NILAI_DOSEN = [];
  if (typeof KATEGORI_NILAI_DOSEN === 'undefined') KATEGORI_NILAI_DOSEN = [];
  if (typeof nilaiDosenEfektif === 'undefined') nilaiDosenEfektif = { nilai: null, sumber: null };
  if (typeof rincianDosen === 'undefined') rincianDosen = null;
  
  // Fungsi untuk mendapatkan URL gambar dari Google Drive
  const getImageUrl = (url, size = 200) => {
    if (!url) return null;
    let match = url.match(/[?&]id=([^&]+)/);
    if (match) return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w${size}`;
    match = url.match(/\/d\/([^\/]+)/);
    if (match) return `https://drive.google.com/thumbnail?id=${match[1]}&sz=w${size}`;
    return url;
  };

  // Fungsi untuk mendapatkan fileId dari URL
  const getFileId = (url) => {
    if (!url) return null;
    let match = url.match(/[?&]id=([^&]+)/);
    if (match) return match[1];
    match = url.match(/\/d\/([^\/]+)/);
    if (match) return match[1];
    match = url.match(/\/file\/d\/([^\/]+)/);
    if (match) return match[1];
    return null;
  };
  
  // Format tanggal
  const formatTanggal = (dateString) => {
    if (!dateString) return '-';
    const date = new Date(dateString);
    return date.toLocaleDateString('id-ID', {
      day: '2-digit',
      month: 'long',
      year: 'numeric'
    });
  };
%>

<style>
  /* ===== VARIABEL WARNA ===== */
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
    --warning-bg: #fef3c7;
    --warning-text: #92400e;
    --success-bg: #d1fae5;
    --success-text: #065f46;
    --danger-bg: #fee2e2;
    --danger-text: #991b1b;
    --info-bg: #dbeafe;
    --info-text: #1e40af;
    --gray-border: #e2e8f0;
  }

  html { font-size: 16px; }
  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background-color: #f8fafc;
  }

  /* Alert Messages */
  .alert-fixed {
    position: fixed;
    top: 80px;
    right: 20px;
    z-index: 9999;
    min-width: 300px;
    animation: slideIn 0.3s ease;
  }
  @keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  /* Profile Card */
  .profile-card {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 2rem;
    color: white;
    margin-bottom: 2rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
    position: relative;
    overflow: hidden;
  }
  .profile-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    transform: rotate(25deg);
  }
  .profile-card .avatar-large {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(255,255,255,0.5);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }
  .avatar-circle-large {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: white;
    color: var(--primary-start);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 600;
    border: 4px solid rgba(255,255,255,0.5);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }
  .profile-card h2 {
    font-weight: 700;
    margin-bottom: 0.3rem;
    font-size: 1.8rem;
  }
  .profile-card p {
    margin-bottom: 0.2rem;
    opacity: 0.9;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.95rem;
  }

  /* Role Badge */
  .role-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .role-pembimbing {
    background: linear-gradient(135deg, #10b981, #34d399);
    color: white;
    box-shadow: 0 5px 15px rgba(16,185,129,0.3);
  }

  /* Filter Cards */
  .filter-card {
    background: white;
    border-radius: 1.2rem;
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    border: 1px solid var(--gray-border);
  }
  .filter-card .form-select, .filter-card .form-control {
    border-radius: 50px;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  /* PDK Stats Cards */
  .pdk-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .stat-card {
    background: white;
    border-radius: 1rem;
    padding: 1rem;
    text-align: center;
    border: 1px solid var(--gray-border);
    transition: all 0.3s;
    cursor: pointer;
    text-decoration: none;
    display: block;
  }
  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .stat-card.active {
    border: 2px solid var(--primary-start);
    background: var(--primary-light);
  }
  .stat-card .pdk-kode {
    font-weight: 700;
    color: var(--primary-start);
    font-size: 0.8rem;
  }
  .stat-card .pdk-nama {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .stat-card .stat-numbers {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .stat-card .stat-item {
    text-align: center;
  }
  .stat-card .stat-value {
    font-weight: 700;
    font-size: 1.2rem;
  }
  .stat-card .stat-label {
    font-size: 0.7rem;
    color: #64748b;
  }
  .stat-card.pending .stat-value { color: #f59e0b; }
  .stat-card.approved .stat-value { color: #10b981; }
  .stat-card.rejected .stat-value { color: #ef4444; }

  /* Page Header */
  .page-header {
    background: white;
    border-radius: 1.2rem;
    padding: 1rem 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    border: 1px solid var(--gray-border);
  }
  .page-header h4 {
    font-weight: 700;
    color: #1e293b;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.3rem;
  }
  .page-header .btn-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .btn-approve-minggu {
    background: #16a34a;
    border: none;
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    color: white;
    font-weight: 600;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 5px 10px rgba(22,163,74,0.3);
  }
  .btn-approve-minggu:hover {
    background: #15803d;
    transform: translateY(-2px);
    box-shadow: 0 8px 15px rgba(22,163,74,0.4);
    color: white;
  }
  .btn-print {
    background: #17a2b8;
    border: none;
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    color: white;
    font-weight: 500;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-print:hover {
    background: #138496;
    transform: translateY(-2px);
    box-shadow: 0 5px 10px rgba(23,162,184,0.3);
    color: white;
  }
  .btn-back {
    background: transparent;
    border: 1.5px solid var(--primary-start);
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    color: var(--primary-start);
    font-weight: 500;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-back:hover {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-color: transparent;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 10px rgba(30,58,138,0.3);
  }

  /* Tabel */
  .table-container {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden;
    border: 1px solid var(--gray-border);
    padding: 0;
  }
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .logbook-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 0;
  }
  .logbook-table thead th {
    background: #f8f9fa;
    color: #1e293b;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    border: 1px solid #dee2e6;
    padding: 0.75rem 1rem;
    white-space: nowrap;
    text-align: center;
  }
  .logbook-table tbody td {
    vertical-align: middle;
    padding: 0.75rem 1rem;
    border: 1px solid #dee2e6;
    font-size: 0.95rem;
  }
  .logbook-table tbody tr:hover {
    background-color: #f2f2f2;
  }

  /* Thumbnail */
  .thumbnail {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 10px;
    cursor: pointer;
    border: 2px solid white;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    transition: transform 0.2s;
  }
  .thumbnail:hover {
    transform: scale(1.1);
    box-shadow: 0 5px 10px rgba(0,0,0,0.2);
  }

  /* Badge Status */
  .badge-status {
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-weight: 500;
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .badge-approved {
    background: var(--success-bg);
    color: var(--success-text);
    border: 1px solid #a7f3d0;
  }
  .badge-rejected {
    background: var(--danger-bg);
    color: var(--danger-text);
    border: 1px solid #fecaca;
  }
  .badge-pending {
    background: var(--warning-bg);
    color: var(--warning-text);
    border: 1px solid #fde68a;
  }

  /* Tombol Aksi */
  .btn-approve {
    background: #10b981;
    border: none;
    color: white;
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .btn-approve:hover {
    background: #059669;
    transform: translateY(-2px);
    box-shadow: 0 5px 10px rgba(16,185,129,0.3);
  }
  .btn-reject {
    background: #ef4444;
    border: none;
    color: white;
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .btn-reject:hover {
    background: #dc2626;
    transform: translateY(-2px);
    box-shadow: 0 5px 10px rgba(239,68,68,0.3);
  }

  /* Modal */
  .modal-content {
    border: none;
    border-radius: 1.5rem;
    overflow: hidden;
  }
  .modal-header-custom {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    border-bottom: none;
    padding: 1.2rem 1.5rem;
  }
  .modal-header-custom .btn-close {
    background: rgba(255,255,255,0.8);
    opacity: 0.8;
  }
  .modal-header-custom .btn-close:hover {
    opacity: 1;
    transform: rotate(90deg);
  }

  /* Lightbox Modal */
  .lightbox-modal .modal-content {
    border: none;
    border-radius: 1.5rem;
    overflow: hidden;
  }
  .lightbox-modal .modal-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    border-bottom: none;
  }
  .lightbox-modal .modal-body {
    padding: 0;
    background: #000;
  }
  .lightbox-modal .carousel-item img {
    max-height: 80vh;
    object-fit: contain;
  }

  /* Empty State */
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    background: #f8f9fa;
    border-radius: 1.5rem;
  }
  .empty-state i {
    font-size: 4rem;
    color: #adb5bd;
    margin-bottom: 1rem;
  }
  .empty-state p {
    color: #6c757d;
    font-size: 1.1rem;
  }

  /* Info Period */
  .nilai-logbook-card {
    background: #fffbeb; border: 1px solid #fde68a; border-radius: 0.9rem;
    padding: 1rem 1.3rem; margin-bottom: 1.2rem;
  }
  .info-period {
    background: var(--info-bg);
    border-left: 4px solid var(--primary-start);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    html { font-size: 15px; }
    .profile-card h2 { font-size: 1.5rem; }
    .profile-card .avatar-large { width: 60px; height: 60px; }
    .avatar-circle-large { width: 60px; height: 60px; font-size: 2rem; }
    .page-header { flex-direction: column; align-items: stretch; }
    .page-header .btn-group { justify-content: center; }
    .pdk-stats { grid-template-columns: repeat(2, 1fr); }
    .logbook-table thead th { font-size: 0.8rem; padding: 0.8rem; }
    .logbook-table tbody td { font-size: 0.9rem; padding: 0.8rem; }
  }

  @media (max-width: 576px) {
    html { font-size: 14px; }
    .profile-card h2 { font-size: 1.3rem; }
    .pdk-stats { grid-template-columns: 1fr; }
    .logbook-table thead th { font-size: 0.75rem; padding: 0.6rem; }
    .logbook-table tbody td { font-size: 0.85rem; padding: 0.6rem; }
    .badge-status { font-size: 0.7rem; padding: 0.3rem 0.8rem; }
    .btn-approve, .btn-reject { padding: 0.2rem 0.8rem; font-size: 0.7rem; }
    .btn-print, .btn-back { padding: 0.4rem 1rem; font-size: 0.8rem; }
  }

  /* ===== RELAYOUT: hero + KPI + tab ===== */
  .hero { background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); border-radius: 1.25rem; padding: 1.1rem 1.4rem; color: #fff; margin-bottom: 1rem; box-shadow: 0 12px 26px rgba(30,58,138,.22); display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; justify-content: space-between; }
  .hero .who { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .hero .avatar-large, .hero .avatar-circle-large { width: 64px; height: 64px; font-size: 1.9rem; flex: 0 0 auto; border-width: 3px; }
  .hero h2 { font-size: 1.35rem; margin: 0 0 .2rem; }
  .hero .meta { font-size: .85rem; opacity: .92; display: flex; flex-wrap: wrap; gap: .15rem 1rem; }
  .hero .meta span { white-space: nowrap; }
  .hero .peran { display: inline-flex; align-items: center; gap: .35rem; margin-top: .45rem; background: rgba(255,255,255,.18); border-radius: 50px; padding: .15rem .75rem; font-size: .75rem; font-weight: 600; }
  .hero .aksi { display: flex; flex-wrap: wrap; gap: .5rem; }
  .hero .aksi a { text-decoration: none; display: inline-flex; align-items: center; gap: .4rem; padding: .45rem 1rem; border-radius: 50px; font-size: .85rem; font-weight: 600; background: rgba(255,255,255,.18); color: #fff; border: 1px solid rgba(255,255,255,.35); transition: background .2s; }
  .hero .aksi a:hover { background: rgba(255,255,255,.32); }
  .hero .aksi a.wa { background: #25d366; border-color: #25d366; }
  .hero .aksi a.print { background: #fff; color: var(--primary-start); border-color: #fff; }

  .pdk-stats { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: .6rem; margin-bottom: 1rem; }
  .pdk-stats .stat-card { padding: .6rem .8rem; }
  .info-period { margin-bottom: 1rem; }

  .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)); gap: .65rem; margin-bottom: 1.1rem; }
  .kpi { background: #fff; border: 1px solid var(--gray-border); border-radius: 1rem; padding: .7rem .9rem; box-shadow: 0 4px 12px rgba(0,0,0,.04); }
  .kpi .v { font-size: 1.45rem; font-weight: 800; line-height: 1.1; color: var(--primary-dark); }
  .kpi .l { font-size: .72rem; text-transform: uppercase; letter-spacing: .4px; color: #64748b; font-weight: 700; }
  .kpi.warn .v { color: #b45309; } .kpi.ok .v { color: #047857; } .kpi.bad .v { color: #b91c1c; }

  .tabs-x { display: flex; gap: .4rem; overflow-x: auto; padding: .35rem; margin-bottom: 1.1rem; background: #fff; border: 1px solid var(--gray-border); border-radius: 1rem; box-shadow: 0 4px 12px rgba(0,0,0,.04); position: sticky; top: 64px; z-index: 50; scrollbar-width: none; }
  .tabs-x::-webkit-scrollbar { display: none; }
  .tabs-x button { flex: 1 0 auto; border: 0; background: transparent; padding: .6rem 1rem; border-radius: .75rem; font-weight: 700; font-size: .88rem; color: #475569; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; cursor: pointer; transition: background .2s, color .2s; }
  .tabs-x button:hover { background: #f1f5f9; }
  .tabs-x button.aktif { background: var(--primary-start); color: #fff; box-shadow: 0 6px 14px rgba(30,58,138,.25); }
  .tabs-x .cnt { font-size: .7rem; font-weight: 800; border-radius: 50px; padding: .05rem .5rem; background: #e2e8f0; color: #334155; }
  .tabs-x .cnt.warn { background: #fee2e2; color: #b91c1c; }
  .tabs-x button.aktif .cnt { background: rgba(255,255,255,.25); color: #fff; }
  .tab-pane-x { display: none; }
  .tab-pane-x.aktif { display: block; }
  .tab-pane-x .filter-card { margin-top: 0; }
  .pane-note { background: #fff; border: 1px dashed #cbd5e1; border-radius: 1rem; padding: 1.4rem; text-align: center; color: #64748b; }
  @media (max-width: 576px) { .hero { padding: 1rem; } .hero .aksi { width: 100%; } .hero .aksi a { flex: 1 1 auto; justify-content: center; } .tabs-x { top: 56px; } }
</style>

<div class="container mt-4">
  <!-- Alert Messages -->
  <% if (session && session.success) { %>
    <div class="alert alert-success alert-dismissible fade show alert-fixed" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i> <%= session.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  
  <% if (session && session.error) { %>
    <div class="alert alert-danger alert-dismissible fade show alert-fixed" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= session.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <%
    // ===== Ringkasan untuk KPI & tab =====
    const _st = selectedPeriod
      ? (pdkStats.find(x => x.id === selectedPeriod.id) || { totalLogbook: 0, pendingCount: 0, approvedCount: 0, rejectedCount: 0 })
      : { totalLogbook: pdkStats.reduce((a, x) => a + (x.totalLogbook || 0), 0), pendingCount: pdkStats.reduce((a, x) => a + (x.pendingCount || 0), 0), approvedCount: pdkStats.reduce((a, x) => a + (x.approvedCount || 0), 0), rejectedCount: pdkStats.reduce((a, x) => a + (x.rejectedCount || 0), 0) };
    const _mgList = (typeof mingguList !== 'undefined' && mingguList) ? mingguList : [];
    const _mgOk = _mgList.filter(m => m.disetujui).length;
    const _mgBelum = _mgList.filter(m => !m.disetujui && m.jumlahEntri > 0).length;
    const _lapAcc = laporanList.filter(l => l.status === 'approved').length;
    const _dikunci = !!(nilaiMagang && nilaiMagang.logbookDikunci);
    const _waUrl = (typeof noWaLink !== 'undefined' && noWaLink) ? 'https://wa.me/' + noWaLink : '';
    const _printUrl = '/dosen/magang/print/' + mahasiswa.id + (selectedPeriod ? '?periodId=' + selectedPeriod.id : '');
  %>

  <!-- Hero: identitas mahasiswa + aksi cepat -->
  <div class="hero">
    <div class="who">
      <% const fotoUrl = mahasiswa.foto ? getImageUrl(mahasiswa.foto, 200) : null; %>
      <% if (fotoUrl) { %>
        <img src="<%= fotoUrl %>" alt="foto <%= mahasiswa.nama %>" class="avatar-large" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(mahasiswa.nama || '?') %>&background=ffffff&color=1e3a8a&size=128'">
      <% } else { %>
        <div class="avatar-circle-large"><%= (mahasiswa.nama || '?').charAt(0).toUpperCase() %></div>
      <% } %>
      <div style="min-width:0;">
        <h2 class="fw-bold"><%= mahasiswa.nama %></h2>
        <div class="meta">
          <span><i class="bi bi-qr-code"></i> <%= mahasiswa.nim %></span>
          <span><i class="bi bi-envelope"></i> <%= mahasiswa.email %></span>
          <span><i class="bi bi-telephone"></i> <%= mahasiswa.noHp || '-' %></span>
        </div>
        <% if (isPembimbing) { %><div class="peran"><i class="bi bi-star-fill"></i> Anda Dosen Pembimbing (Dosen PA) mahasiswa ini</div><% } %>
      </div>
    </div>
    <div class="aksi">
      <% if (_waUrl) { %><a class="wa" href="<%= _waUrl %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> WhatsApp</a><% } %>
      <a class="print" href="<%= _printUrl %>" target="_blank"><i class="bi bi-printer"></i> Print</a>
      <a href="/dosen/magang"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <!-- PDK Stats Cards (Filter Periode) -->
  <% if (allPeriods && allPeriods.length > 0) { %>
    <div class="pdk-stats">
      <a href="/dosen/magang/<%= mahasiswa.id %>" class="stat-card <%= !selectedPeriod ? 'active' : '' %>">
        <div class="pdk-kode">SEMUA</div>
        <div class="pdk-nama">Semua Periode</div>
        <div class="stat-numbers">
          <div class="stat-item pending">
            <div class="stat-value"><%= pdkStats.reduce((sum, s) => sum + s.pendingCount, 0) %></div>
            <div class="stat-label">Pending</div>
          </div>
          <div class="stat-item approved">
            <div class="stat-value"><%= pdkStats.reduce((sum, s) => sum + s.approvedCount, 0) %></div>
            <div class="stat-label">Approved</div>
          </div>
          <div class="stat-item rejected">
            <div class="stat-value"><%= pdkStats.reduce((sum, s) => sum + s.rejectedCount, 0) %></div>
            <div class="stat-label">Rejected</div>
          </div>
        </div>
      </a>
      <% allPeriods.forEach(period => { 
        const stats = pdkStats.find(s => s.id === period.id) || { pendingCount: 0, approvedCount: 0, rejectedCount: 0 };
      %>
        <a href="/dosen/magang/<%= mahasiswa.id %>?periodId=<%= period.id %>" class="stat-card <%= selectedPeriod && selectedPeriod.id === period.id ? 'active' : '' %>">
          <div class="pdk-kode"><%= period.pdkKode %></div>
          <div class="pdk-nama"><%= period.pdkNama %></div>
          <div class="stat-numbers">
            <div class="stat-item pending">
              <div class="stat-value"><%= stats.pendingCount %></div>
              <div class="stat-label">Pending</div>
            </div>
            <div class="stat-item approved">
              <div class="stat-value"><%= stats.approvedCount %></div>
              <div class="stat-label">Approved</div>
            </div>
            <div class="stat-item rejected">
              <div class="stat-value"><%= stats.rejectedCount %></div>
              <div class="stat-label">Rejected</div>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>

  <!-- Info Periode Aktif -->
  <% if (selectedPeriod) { %>
    <div class="info-period">
      <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <strong><i class="bi bi-info-circle"></i> Periode Magang:</strong> 
          <%= selectedPeriod.pdkKode %> - <%= selectedPeriod.pdkNama %>
          (<%= formatTanggal(selectedPeriod.tanggalMulai) %> 
          <%= selectedPeriod.tanggalSelesai ? `s/d ${formatTanggal(selectedPeriod.tanggalSelesai)}` : 'Berlangsung' %>)
        </div>
        <% if (selectedPeriod.perusahaan && selectedPeriod.perusahaan.nama) { %>
          <div class="mt-1 mt-sm-0">
            <i class="bi bi-building"></i> <%= selectedPeriod.perusahaan.nama %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- KPI ringkas -->
  <div class="kpi-grid">
    <div class="kpi"><div class="v"><%= _st.totalLogbook || (_st.pendingCount + _st.approvedCount + _st.rejectedCount) %></div><div class="l">Total logbook</div></div>
    <div class="kpi warn"><div class="v"><%= _st.pendingCount %></div><div class="l">Pending</div></div>
    <div class="kpi ok"><div class="v"><%= _st.approvedCount %></div><div class="l">Disetujui</div></div>
    <div class="kpi bad"><div class="v"><%= _st.rejectedCount %></div><div class="l">Ditolak</div></div>
    <% if (selectedPeriod && _mgList.length) { %>
      <div class="kpi <%= _mgBelum ? 'warn' : 'ok' %>"><div class="v"><%= _mgOk %>/<%= _mgList.length %></div><div class="l">Minggu disetujui</div></div>
    <% } %>
    <div class="kpi <%= _lapAcc ? 'ok' : '' %>"><div class="v"><%= _lapAcc %>/<%= laporanList.length %></div><div class="l">Laporan di-ACC</div></div>
    <div class="kpi <%= _dikunci ? 'ok' : '' %>"><div class="v" style="font-size:1.05rem;padding-top:.3rem;"><i class="bi bi-<%= _dikunci ? 'lock-fill' : 'unlock' %>"></i> <%= _dikunci ? 'Dikunci' : 'Terbuka' %></div><div class="l">Status logbook</div></div>
  </div>

  <!-- Tab -->
  <nav class="tabs-x" id="tabsX">
    <% if (isPembimbing) { %>
      <button type="button" data-tab="mingguan"><i class="bi bi-calendar-check"></i> Persetujuan Mingguan <% if (_mgBelum) { %><span class="cnt warn"><%= _mgBelum %></span><% } %></button>
    <% } %>
    <button type="button" data-tab="harian"><i class="bi bi-list-check"></i> Logbook Harian <% if (_st.pendingCount) { %><span class="cnt"><%= _st.pendingCount %></span><% } %></button>
    <% if (isPembimbing) { %>
      <button type="button" data-tab="laporan"><i class="bi bi-file-earmark-check"></i> Laporan <span class="cnt"><%= laporanList.length %></span></button>
      <button type="button" data-tab="penilaian"><i class="bi bi-pencil-square"></i> Penilaian &amp; Cetak</button>
    <% } %>
  </nav>

  <section class="tab-pane-x" data-pane="mingguan">
    <% if (isPembimbing) { %>
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <span class="small text-muted">Pintasan: setujui sekaligus semua logbook pending 7 hari terakhir.</span>
        <div class="btn-group">
      <% if (isPembimbing) { %>
        <form method="POST" action="/dosen/magang/<%= mahasiswa.id %>/setujui-minggu" style="display:inline;"
              onsubmit="return confirm('Setujui SEMUA logbook pending mahasiswa ini dalam 7 hari terakhir<%= selectedPeriod ? ` untuk periode ${selectedPeriod.pdkKode}` : '' %> sekaligus? Catatan otomatis: \'Mahasiswa telah konsultasi dan logbook disetujui\'.');">
          <% if (selectedPeriod) { %>
            <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
          <% } %>
          <button type="submit" class="btn-approve-minggu">
            <i class="bi bi-check2-all"></i> Setujui 1 Minggu
          </button>
        </form>
      <% } %>
        </div>
      </div>
    <% } %>
  <!-- Persetujuan Logbook PER MINGGU (konsultasi via WA + catatan dosen) -->
  <% if (isPembimbing && selectedPeriod && typeof mingguList !== 'undefined' && mingguList.length > 0) { %>
    <style>
      .minggu-card { background:#fff; border:1px solid var(--gray-border, #e5e7eb); border-radius:1.25rem; box-shadow:0 10px 30px rgba(0,0,0,.05); padding:1.1rem 1.25rem; margin-bottom:1.25rem; }
      .minggu-card h5 { font-weight:800; margin:0 0 .15rem; }
      .minggu-card .sub { color:#667085; font-size:.85rem; margin-bottom:.8rem; }
      .minggu-item { border:1px solid #e5e7eb; border-radius:.9rem; margin-bottom:.55rem; background:#fff; }
      .minggu-item > summary { list-style:none; cursor:pointer; display:flex; flex-wrap:wrap; align-items:center; gap:.5rem .9rem; padding:.7rem .95rem; }
      .minggu-item > summary::-webkit-details-marker { display:none; }
      .minggu-item[open] > summary { border-bottom:1px solid #eef2f7; }
      .minggu-item .no { font-weight:800; color:#0a3d7a; min-width:5.2rem; }
      .minggu-item .rentang { color:#475467; font-size:.88rem; flex:1 1 180px; }
      .minggu-item .info { color:#667085; font-size:.82rem; }
      .badge-mg { font-size:.75rem; font-weight:700; border-radius:50px; padding:.2rem .7rem; }
      .badge-mg.ok { background:#d1fae5; color:#047857; }
      .badge-mg.no { background:#fee2e2; color:#b91c1c; }
      .minggu-body { padding:.9rem 1rem 1rem; }
      .minggu-body .wa-link { font-size:.85rem; }
    </style>
    <div class="minggu-card">
      <h5><i class="bi bi-calendar-check"></i> Persetujuan Logbook per Minggu</h5>
      <div class="sub">
        Setujui satu minggu setelah mahasiswa konsultasi lewat WhatsApp. Lembar logbook minggu yang belum disetujui
        tercetak dengan watermark &ldquo;Belum Konsultasi&rdquo;.
      </div>

      <% mingguList.forEach((m, idx) => { %>
        <details class="minggu-item" <%= (!m.disetujui && m.jumlahEntri > 0 && idx === 0) ? 'open' : '' %>>
          <summary>
            <span class="no">Minggu ke-<%= m.mingguKe %></span>
            <span class="rentang"><%= m.awalFmt %> &ndash; <%= m.akhirFmt %></span>
            <span class="info"><%= m.jumlahEntri %> entri &middot; <%= m.totalJam %> jam<% if (m.pending) { %> &middot; <%= m.pending %> pending<% } %></span>
            <% if (m.disetujui) { %>
              <span class="badge-mg ok"><i class="bi bi-check-circle-fill"></i> Sudah konsultasi &middot; disetujui</span>
            <% } else { %>
              <span class="badge-mg no"><i class="bi bi-hourglass-split"></i> Belum konsultasi</span>
            <% } %>
          </summary>

          <div class="minggu-body">
            <% if (m.disetujui && m.konsultasi) { %>
              <p class="mb-2" style="font-size:.88rem;">
                <b>Konsultasi via WA</b>
                <% if (m.konsultasi.noWa) { %>(<%= m.konsultasi.noWa %>)<% } %>
                <% if (m.konsultasi.tanggalKonsultasi) { %>&middot; <%= m.konsultasi.tanggalKonsultasi %><% } %>
              </p>
              <% if (m.konsultasi.catatan) { %>
                <div class="p-2 mb-2" style="background:#f5f3ff;border-left:4px solid #7c3aed;border-radius:.5rem;white-space:pre-line;font-size:.9rem;"><%= m.konsultasi.catatan %></div>
              <% } %>
            <% } %>

            <form method="POST" action="/dosen/magang/<%= mahasiswa.id %>/minggu/<%= m.mingguKe %>/setujui">
              <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
              <div class="row g-2 mb-2">
                <div class="col-md-5">
                  <label class="form-label fw-semibold mb-1" style="font-size:.85rem;">No. WhatsApp mahasiswa</label>
                  <input type="text" name="noWa" class="form-control" placeholder="08xxxxxxxxxx"
                         value="<%= (m.konsultasi && m.konsultasi.noWa) ? m.konsultasi.noWa : (typeof noWaMahasiswa !== 'undefined' ? noWaMahasiswa : '') %>">
                  <% if (typeof noWaLink !== 'undefined' && noWaLink) { %>
                    <a class="wa-link" href="https://wa.me/<%= noWaLink %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> Buka chat WhatsApp</a>
                  <% } %>
                </div>
                <div class="col-md-3">
                  <label class="form-label fw-semibold mb-1" style="font-size:.85rem;">Tanggal konsultasi</label>
                  <input type="date" name="tanggalKonsultasi" class="form-control"
                         value="<%= (m.konsultasi && m.konsultasi.tanggalKonsultasi) ? m.konsultasi.tanggalKonsultasi : '' %>">
                </div>
              </div>
              <div class="mb-2">
                <label class="form-label fw-semibold mb-1" style="font-size:.85rem;">Catatan Dosen Pembimbing (opsional, tampil di lembar logbook &amp; lembar konsultasi)</label>
                <textarea name="catatan" rows="3" maxlength="1500" class="form-control"
                          placeholder="Ketik catatan/arahan untuk mahasiswa pada minggu ini..."><%= (m.konsultasi && m.konsultasi.catatan) ? m.konsultasi.catatan : '' %></textarea>
              </div>
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="sudahKonsultasi" id="konsul<%= m.mingguKe %>" <%= m.disetujui ? 'checked' : '' %>>
                <label class="form-check-label" for="konsul<%= m.mingguKe %>">Mahasiswa sudah konsultasi via WhatsApp</label>
              </div>
              <button type="submit" class="btn btn-success btn-sm"
                      onclick="return confirm('Setujui logbook minggu ke-<%= m.mingguKe %>? Semua entri pending minggu ini ikut disetujui.')">
                <i class="bi bi-check2-all"></i> <%= m.disetujui ? 'Simpan perubahan' : 'Setujui Minggu Ini' %>
              </button>
            </form>
            <% if (m.disetujui) { %>
              <form method="POST" action="/dosen/magang/<%= mahasiswa.id %>/minggu/<%= m.mingguKe %>/batal" class="mt-2"
                    onsubmit="return confirm('Cabut persetujuan minggu ke-<%= m.mingguKe %>? Entri minggu ini kembali pending dan lembar berwatermark.');">
                <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle"></i> Cabut persetujuan</button>
              </form>
            <% } %>
          </div>
        </details>
      <% }) %>
    </div>
  <% } %>

    <% if (!(isPembimbing && selectedPeriod && _mgList.length > 0)) { %>
      <div class="pane-note"><i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
        <%= selectedPeriod ? 'Belum ada minggu logbook pada periode ini.' : 'Pilih satu periode magang di atas untuk menyetujui logbook per minggu.' %>
      </div>
    <% } %>
  </section>

  <section class="tab-pane-x" data-pane="harian">
  <!-- Filter Semester -->
  <div class="filter-card">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label fw-semibold"><i class="bi bi-funnel"></i> Filter Semester</label>
        <select name="semester" class="form-select" onchange="this.form.submit()">
          <option value="">Semua Semester</option>
          <% if (semesterList && semesterList.length > 0) { %>
            <% semesterList.forEach(s => { %>
              <option value="<%= s %>" <%= selectedSemester === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <% if (selectedPeriod) { %>
        <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
      <% } %>
    </form>
  </div>

  <!-- Tabel Logbook -->
  <div class="table-container">
    <div class="table-responsive">
      <table class="table logbook-table">
        <thead>
          <tr>
            <th style="text-align: center;">No</th>
            <th>Tanggal</th>
            <th>Kegiatan</th>
            <th style="text-align: center;">Durasi</th>
            <th>Lokasi</th>
            <th>Semester</th>
            <th style="text-align: center;">Gambar</th>
            <th style="text-align: center;">Status</th>
            <% if (isPembimbing) { %>
              <th style="text-align: center;">Aksi</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% if (logbookList.length === 0) { %>
            <tr>
              <td colspan="<%= isPembimbing ? 9 : 8 %>" class="text-center py-5">
                <div class="empty-state">
                  <i class="bi bi-inbox"></i>
                  <p>Belum ada logbook untuk periode ini.</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% logbookList.forEach((item, index) => { %>
              <tr>
                <td style="text-align: center; font-weight: 600;"><%= index + 1 %></td>
                <td><%= item.tanggalFormatted %></td>
                <td style="max-width: 300px;"><%= item.kegiatan %></td>
                <td style="text-align: center;"><%= item.durasi ? item.durasi + ' jam' : '-' %></td>
                <td><%= item.lokasi || '-' %></td>
                <td><%= item.semester || '-' %></td>
                <td style="text-align: center;">
                  <% if (item.imageUrls && item.imageUrls.length > 0) { 
                    const firstUrl = item.imageUrls[0];
                    const fileId = getFileId(firstUrl);
                    const thumbUrl = fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w100` : firstUrl;
                    const directUrl = fileId ? `https://drive.google.com/uc?export=view&id=${fileId}` : firstUrl;
                  %>
                    <img src="<%= thumbUrl %>" 
                         class="thumbnail" 
                         alt="dokumentasi"
                         onclick='lihatGambar(<%= JSON.stringify(item.imageUrls) %>)'
                         onerror="this.onerror=null; this.src='<%= directUrl %>';">
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td style="text-align: center;">
                  <% if (item.status === 'approved') { %>
                    <span class="badge-status badge-approved">
                      <i class="bi bi-check-circle"></i> Disetujui
                    </span>
                    <% if (item.approvedByNama) { %>
                      <br><small class="text-muted">oleh: <%= item.approvedByNama %></small>
                    <% } %>
                    <% if (item.catatan) { %>
                      <br><small class="text-muted"><i class="bi bi-chat-left-text"></i> <%= item.catatan %></small>
                    <% } %>
                  <% } else if (item.status === 'rejected') { %>
                    <span class="badge-status badge-rejected">
                      <i class="bi bi-x-circle"></i> Ditolak
                    </span>
                    <% if (item.rejectionReason) { %>
                      <br><small class="text-muted">Alasan: <%= item.rejectionReason %></small>
                    <% } %>
                    <% if (item.rejectedByNama) { %>
                      <br><small class="text-muted">oleh: <%= item.rejectedByNama %></small>
                    <% } %>
                  <% } else { %>
                    <span class="badge-status badge-pending">
                      <i class="bi bi-hourglass-split"></i> Pending
                    </span>
                  <% } %>
                </td>
                <% if (isPembimbing) { %>
                  <td style="text-align: center;">
                    <% if (item.status === 'pending') { %>
                      <div class="d-flex gap-2 justify-content-center">
                        <form method="POST" action="/dosen/magang/logbook/<%= item.id %>/approve" style="display: inline;">
                          <button type="submit" class="btn-approve" onclick="return confirm('Setujui logbook ini?')">
                            <i class="bi bi-check-circle"></i> Setujui
                          </button>
                        </form>
                        <button type="button" class="btn-reject" data-bs-toggle="modal" data-bs-target="#rejectModal" 
                                data-logbook-id="<%= item.id %>" 
                                data-logbook-title="<%= item.kegiatan.substring(0, 50) %>">
                          <i class="bi bi-x-circle"></i> Tolak
                        </button>
                      </div>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination', { pageInfo: typeof pageInfo !== 'undefined' ? pageInfo : null, showAll: typeof showAll !== 'undefined' ? showAll : false, pageListUrl: typeof pageListUrl !== 'undefined' ? pageListUrl : '?' }) %>
  </div>
  </section>

  <section class="tab-pane-x" data-pane="laporan">
  <!-- Panel Laporan Magang & Form Penilaian Dosen Pembimbing (Dosen PA) -->
  <% if (isPembimbing) { %>
    <div class="nilai-logbook-card mb-3">
      <h6 class="fw-bold mb-1"><i class="bi bi-file-earmark-check"></i> Laporan Magang</h6>
      <p class="text-muted small mb-3">Tinjau laporan yang diunggah mahasiswa, ACC atau minta revisi. Setelah minimal satu laporan di-ACC dan logbook dikunci, isi Form Penilaian Dosen Pembimbing di bawah.</p>

      <% if (!laporanList || laporanList.length === 0) { %>
        <div class="text-center text-muted py-3">Mahasiswa ini belum mengunggah laporan.</div>
      <% } else { %>
        <% laporanList.forEach(l => { %>
          <div class="border rounded-3 p-3 mb-2">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
              <div>
                <strong>Laporan ke-<%= l.laporanKe %></strong><% if (l.judulPublik) { %>: <%= l.judulPublik %><% } %>
                <% if (l.catatanPembimbing || l.catatanPembimbing1) { %>
                  <div class="small text-muted mt-1"><i class="bi bi-chat-left-text"></i> Catatan Anda: <%= l.catatanPembimbing || l.catatanPembimbing1 %></div>
                <% } %>
              </div>
              <span class="badge <%= l.status === 'approved' ? 'bg-success' : (l.status === 'revisi' ? 'bg-danger' : 'bg-warning text-dark') %>">
                <%= l.status === 'approved' ? 'Di-ACC' : (l.status === 'revisi' ? 'Perlu Revisi' : 'Menunggu Tinjauan') %>
              </span>
            </div>
            <% if (l.status !== 'approved') { %>
              <form method="POST" action="/dosen/laporan-review/<%= l.id %>/status" class="mt-2 d-flex gap-2 flex-wrap align-items-end">
                <div class="flex-grow-1" style="min-width:200px;">
                  <input type="text" name="catatan" class="form-control form-control-sm" placeholder="Catatan untuk mahasiswa (opsional)...">
                </div>
                <input type="hidden" name="status" value="approved">
                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-circle"></i> ACC</button>
              </form>
              <form method="POST" action="/dosen/laporan-review/<%= l.id %>/status" class="mt-2 d-flex gap-2 flex-wrap align-items-end">
                <div class="flex-grow-1" style="min-width:200px;">
                  <input type="text" name="catatan" class="form-control form-control-sm" placeholder="Alasan revisi...">
                </div>
                <input type="hidden" name="status" value="revisi">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Minta Revisi</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      <% } %>

    </div>
  <% } %>
  </section>

  <section class="tab-pane-x" data-pane="penilaian">
  <!-- Panel Kunci Logbook (Dosen Pembimbing/PA) - prasyarat Form Penilaian Dosen Pembimbing -->
  <% if (isPembimbing && selectedPeriod) { %>
    <div class="nilai-logbook-card">
      <% if (!nilaiMagang || !nilaiMagang.logbookDikunci) { %>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <strong><i class="bi bi-lock"></i> Kunci Logbook untuk Penilaian</strong>
            <p class="mb-0 small text-muted">Setelah semua logbook periode ini selesai ditinjau, kunci (bersama ACC laporan) supaya Form Penilaian Dosen Pembimbing bisa diisi. <strong>Ini beda dari "Kunci Periode"</strong> di halaman Kelola Magang - itu cuma menghentikan mahasiswa isi logbook harian, tidak ada hubungannya dengan penilaian.</p>
          </div>
          <form method="POST" action="/dosen/magang/<%= mahasiswa.id %>/kunci-logbook"
                onsubmit="return confirm('Kunci logbook periode ini? Setelah dikunci dan laporan di-ACC, form penilaian bisa diisi.');">
            <input type="hidden" name="pdkId" value="<%= selectedPeriod.pdkId %>">
            <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
            <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-lock-fill"></i> Kunci Logbook untuk Penilaian</button>
          </form>
        </div>
      <% } else { %>
        <div class="mb-3">
          <strong class="text-success"><i class="bi bi-check-circle"></i> Logbook Sudah Dikunci</strong>
          <p class="mb-0 small text-muted">Terkunci oleh Anda pada <%= new Date(nilaiMagang.logbookDikunciAt).toLocaleDateString('id-ID') %>.</p>
        </div>

        <form method="POST" action="/dosen/magang/<%= mahasiswa.id %>/buka-kunci-logbook" class="mt-2"
              onsubmit="return confirm('Buka kunci logbook lagi? Penilaian yang sudah ada tidak akan hilang.');">
          <input type="hidden" name="pdkId" value="<%= selectedPeriod.pdkId %>">
          <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
          <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-unlock"></i> Buka Kunci Logbook</button>
        </form>
      <% } %>
    </div>
  <% } %>

  <% if (isPembimbing) { %>
    <div class="nilai-logbook-card mb-3">
      <h6 class="fw-bold mb-1"><i class="bi bi-pencil-square"></i> Form Penilaian Dosen Pembimbing</h6>
      <p class="text-muted small mb-2">
        Format baru: <strong>18 indikator</strong> (Laporan 8, Kepribadian 7, Pengetahuan 3). Tiap indikator diisi angka 0-100;
        huruf mengikuti skala A 86-100, B+ 76-85, B 60-75, C+ 50-59, C 25-49, D 10-24, E &lt;10.
      </p>

      <% if (selectedPeriod && nilaiDosenEfektif.sumber === 'lama') { %>
        <div class="alert alert-warning py-2 small">
          Nilai format lama (Laporan &amp; Logbook) tercatat dan dihitung rata-ratanya = <strong><%= nilaiDosenEfektif.nilai %></strong>.
          Mengisi form di bawah akan menggantikannya.
        </div>
      <% } %>

      <% if (!selectedPeriod) { %>
        <div class="text-center text-muted small py-2 border-top mt-2">Pilih periode magang dulu.</div>
      <% } else if (!adaLaporanYangAcc || !nilaiMagang || !nilaiMagang.logbookDikunci) { %>
        <div class="text-center text-muted small py-2 border-top mt-2">
          <i class="bi bi-lock"></i> Form penilaian terbuka setelah
          <strong class="<%= adaLaporanYangAcc ? 'text-success' : '' %>"><%- adaLaporanYangAcc ? '&#10003; ' : '' %>minimal satu laporan di-ACC</strong> dan
          <strong class="<%= (nilaiMagang && nilaiMagang.logbookDikunci) ? 'text-success' : '' %>"><%- (nilaiMagang && nilaiMagang.logbookDikunci) ? '&#10003; ' : '' %>logbook dikunci</strong>.
        </div>
      <% } else { %>
        <form method="POST" action="/dosen/magang/<%= mahasiswa.id %>/nilai-dosen" id="formNilaiDosen">
          <input type="hidden" name="pdkId" value="<%= selectedPeriod.pdkId %>">
          <input type="hidden" name="periodId" value="<%= selectedPeriod.id %>">
          <%
            const itemsDosen = (nilaiMagang && nilaiMagang.nilaiDosenItems) ? nilaiMagang.nilaiDosenItems : {};
          %>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead>
                <tr><th style="width:55%;">Objek Penilaian</th><th style="width:25%;">Nilai (0-100)</th><th style="width:20%;">Huruf</th></tr>
              </thead>
              <tbody>
                <% KATEGORI_NILAI_DOSEN.forEach(kat => { %>
                  <tr class="table-light"><td colspan="3" class="fw-bold small text-uppercase text-muted"><%= kat %></td></tr>
                  <% ITEM_NILAI_DOSEN.filter(it => it.kategori === kat).forEach((it, idx) => { %>
                    <tr>
                      <td><%= idx + 1 %>. <%= it.label %></td>
                      <td>
                        <input type="number" name="item[<%= it.key %>]" data-kat="<%= kat %>" min="0" max="100" step="0.01"
                               class="form-control form-control-sm nilai-dosen-input"
                               value="<%= itemsDosen[it.key] !== undefined ? itemsDosen[it.key] : '' %>" required style="max-width:140px;">
                      </td>
                      <td class="huruf-item fw-semibold">-</td>
                    </tr>
                  <% }) %>
                  <tr>
                    <td class="text-end small text-muted">Nilai rata-rata <%= kat %></td>
                    <td colspan="2" class="fw-bold rata-kat" data-kat="<%= kat %>"><%= (rincianDosen && rincianDosen.perKategori[kat] !== null && rincianDosen.perKategori[kat] !== undefined) ? rincianDosen.perKategori[kat] : '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr class="table-light">
                  <td class="fw-bold text-end">Total</td>
                  <td colspan="2" class="fw-bold" id="totalDosen"><%= (rincianDosen && rincianDosen.total !== null) ? rincianDosen.total : '-' %></td>
                </tr>
                <tr class="table-light">
                  <td class="fw-bold text-end">Rata-rata Nilai Akhir</td>
                  <td colspan="2" class="fw-bold" id="rataDosen"><%= (rincianDosen && rincianDosen.rataAkhir !== null) ? rincianDosen.rataAkhir : '-' %></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Catatan Dosen Pembimbing (opsional)</label>
            <textarea name="catatan" rows="3" maxlength="1000" class="form-control form-control-sm"><%= (nilaiMagang && nilaiMagang.catatanDosen) ? nilaiMagang.catatanDosen : '' %></textarea>
          </div>

          <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-save"></i> Simpan Penilaian</button>
          </div>
        </form>
        <p class="text-muted small mt-2 mb-0">
          Nilai ini (50%) digabung dengan Nilai Pendamping Lapangan yang diinput Admin (50%) menjadi Nilai Akhir Magang.
        </p>
        <script>
          (function () {
            function huruf(n) {
              if (isNaN(n)) return '-';
              if (n >= 86) return 'A'; if (n >= 76) return 'B+'; if (n >= 60) return 'B';
              if (n >= 50) return 'C+'; if (n >= 25) return 'C'; if (n >= 10) return 'D'; return 'E';
            }
            var form = document.getElementById('formNilaiDosen');
            if (!form) return;
            var inputs = [].slice.call(form.querySelectorAll('.nilai-dosen-input'));
            function r2(x) { return Math.round(x * 100) / 100; }
            function hitung() {
              var total = 0, lengkap = true, perKat = {};
              inputs.forEach(function (inp) {
                var n = parseFloat(inp.value);
                inp.closest('tr').querySelector('.huruf-item').textContent = huruf(n);
                var k = inp.getAttribute('data-kat');
                perKat[k] = perKat[k] || { jml: 0, n: 0, ok: true };
                if (isNaN(n)) { perKat[k].ok = false; lengkap = false; } else { perKat[k].jml += n; total += n; }
                perKat[k].n++;
              });
              [].slice.call(form.querySelectorAll('.rata-kat')).forEach(function (td) {
                var d = perKat[td.getAttribute('data-kat')];
                td.textContent = (d && d.ok) ? r2(d.jml / d.n) : '-';
              });
              document.getElementById('totalDosen').textContent = lengkap ? r2(total) : '-';
              document.getElementById('rataDosen').textContent = lengkap ? r2(total / inputs.length) : '-';
            }
            inputs.forEach(function (i) { i.addEventListener('input', hitung); });
            hitung();
          })();
        </script>
      <% } %>

      <% if (selectedPeriod) { %>
        <hr>
        <h6 class="fw-bold mb-1"><i class="bi bi-printer"></i> Cetak Form Penilaian Magang (format resmi)</h6>
        <p class="text-muted small mb-2">Form terisi bila sudah dinilai; form kosong untuk diisi manual.</p>
        <div class="d-flex gap-2 flex-wrap">
          <% const sudahDosen = nilaiMagang && nilaiMagang.nilaiDosen !== null && nilaiMagang.nilaiDosen !== undefined; %>
          <% const sudahLap = nilaiMagang && nilaiMagang.nilaiLapangan !== null && nilaiMagang.nilaiLapangan !== undefined; %>
          <a href="/dosen/magang/print-penilaian/<%= mahasiswa.id %>?periodId=<%= selectedPeriod.id %>&jenis=dosen" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i> Form Dosen Pembimbing<%= sudahDosen ? '' : ' (kosong)' %></a>
          <a href="/dosen/magang/print-penilaian/<%= mahasiswa.id %>?periodId=<%= selectedPeriod.id %>&jenis=lapangan" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i> Form Pendamping Lapangan<%= sudahLap ? '' : ' (kosong)' %></a>
          <a href="/dosen/magang/print-penilaian/<%= mahasiswa.id %>?periodId=<%= selectedPeriod.id %>&jenis=dosen&kosong=1" target="_blank" class="btn btn-link btn-sm">Form Dosen kosong</a>
        </div>
      <% } %>

      <% if (selectedPeriod) { %>
        <hr>
        <h6 class="fw-bold mb-1"><i class="bi bi-journal-check"></i> Kartu Kontrol Bimbingan Magang</h6>
        <p class="text-muted small mb-2">Diambil dari Lembar Konsultasi PA dengan kategori <strong>Magang</strong> (catat di menu Konsultasi pada halaman Mahasiswa PA).</p>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/dosen/magang/print-kartu-kontrol/<%= mahasiswa.id %>?periodId=<%= selectedPeriod.id %>" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i> Cetak Kartu Kontrol</a>
          <a href="/dosen/mahasiswa-pa/<%= mahasiswa.id %>/konsultasi" class="btn btn-outline-primary btn-sm"><i class="bi bi-chat-left-text"></i> Catat Konsultasi</a>
        </div>
      <% } %>
    </div>
  <% } %>

  </section>

  <script>
    // Tab halaman ELK Magang dosen (tanpa dependensi; ingat tab terakhir setelah submit/redirect)
    (function () {
      var nav = document.getElementById('tabsX');
      if (!nav) return;
      var btns = nav.querySelectorAll('button[data-tab]');
      var panes = document.querySelectorAll('.tab-pane-x');
      var KEY = 'magangTab:<%= mahasiswa.id %>';
      function tersedia(n) { return nav.querySelector('button[data-tab="' + n + '"]') !== null; }
      function buka(n, simpan) {
        if (!tersedia(n)) n = btns[0].getAttribute('data-tab');
        btns.forEach(function (b) { b.classList.toggle('aktif', b.getAttribute('data-tab') === n); });
        panes.forEach(function (p) { p.classList.toggle('aktif', p.getAttribute('data-pane') === n); });
        if (simpan) { try { sessionStorage.setItem(KEY, n); } catch (e) {} }
        if (history.replaceState) history.replaceState(null, '', '#' + n);
      }
      btns.forEach(function (b) { b.addEventListener('click', function () { buka(b.getAttribute('data-tab'), true); }); });
      var q = new URLSearchParams(location.search);
      var awal = location.hash.replace('#', '');
      if (!tersedia(awal)) {
        awal = (q.has('after') || q.has('trail') || q.has('all') || q.has('semester')) ? 'harian' : '';
        if (!awal) { try { awal = sessionStorage.getItem(KEY) || ''; } catch (e) {} }
      }
      if (!tersedia(awal)) awal = tersedia('mingguan') ? 'mingguan' : 'harian';
      buka(awal, false);
    })();
  </script>

</div>

<!-- Modal Reject -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header-custom">
        <h5 class="modal-title">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>Tolak Logbook
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" id="rejectForm">
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Perhatian!</strong> Penolakan akan memberitahu mahasiswa beserta alasan yang diberikan.
          </div>
          <div class="mb-3">
            <label for="alasan" class="form-label fw-bold">Alasan Penolakan <span class="text-danger">*</span></label>
            <textarea class="form-control" id="alasan" name="alasan" rows="3" required 
                      placeholder="Masukkan alasan penolakan logbook..."></textarea>
            <small class="text-muted">Alasan akan ditampilkan kepada mahasiswa.</small>
