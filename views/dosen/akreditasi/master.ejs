<%- include('../../partials/header') %>
<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h2 class="mb-0">Master Dokumen Prodi</h2>
      <small class="text-muted">Buku induk administrasi program studi: status kelengkapan &amp; bukti tiap dokumen</small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/dosen/akreditasi" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <% if (!periode) { %>
    <div class="alert alert-info mt-4">Belum ada periode akreditasi yang berjalan.</div>
  <% } else if (!grouped.length) { %>
    <div class="alert alert-info mt-4">Daftar master dokumen belum disiapkan admin.</div>
  <% } else { %>
      <div class="card mt-3">
        <div class="card-body">
          <div class="d-flex flex-wrap gap-3 small mb-2">
            <span><strong><%= total.total %></strong> dokumen</span>
            <span class="text-success"><strong><%= total.disahkan %></strong> lengkap &amp; disahkan</span>
            <span class="text-info"><strong><%= total.ada %></strong> ada</span>
            <span class="text-warning"><strong><%= total.draft %></strong> draft</span>
            <span class="text-secondary"><strong><%= total.belum %></strong> belum ada</span>
            <span><strong><%= total.adaBukti %></strong> sudah ada berkas bukti</span>
          </div>
          <div class="progress" style="height: 22px;">
            <div class="progress-bar bg-success" style="width: <%= total.persen %>%;"><%= total.persen %>% Kesiapan Dokumen</div>
          </div>
          <div class="form-text">"Ada (belum disahkan)" dihitung setengah; hanya "Lengkap &amp; Disahkan" dihitung penuh.</div>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-1 mt-3">
        <% grouped.forEach(g => { %>
          <a href="#kel-<%= g.kode %>" class="btn btn-sm btn-outline-secondary"><%= g.kode %> <span class="badge bg-light text-dark border"><%= g.progres.persen %>%</span></a>
        <% }) %>
      </div>

      <% grouped.forEach(g => { %>
        <div class="card mt-4" id="kel-<%= g.kode %>">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong><%= g.kode %>. <%= g.nama %></strong>
            <span class="small text-muted"><%= g.progres.disahkan %>/<%= g.progres.total %> disahkan &middot; <%= g.progres.persen %>%</span>
          </div>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Dokumen</th><th style="width:190px;">Status</th><th style="width:150px;">Penanggung Jawab</th>
                  <th style="width:190px;">Bukti</th>
                </tr>
              </thead>
              <tbody>
                <% let subTerakhir = null; g.items.forEach(i => { %>
                  <% if (i.sub && i.sub !== subTerakhir) { subTerakhir = i.sub; %>
                    <tr class="table-secondary"><td colspan="4" class="fw-bold small"><%= i.sub %></td></tr>
                  <% } %>
                  <tr>
                    <td>
                      <%= i.nama %>
                      <% if (i.keterangan) { %><div class="text-muted small"><%= i.keterangan %></div><% } %>
                      <% if (i.kurikulumBagian) { %><div class="small text-muted"><i class="bi bi-link-45deg"></i> <%= i.kurikulumKet %> &middot; <a href="/dosen/akreditasi/kurikulum#<%= i.kurikulumBagian %>">Lihat</a><% if (i.statusDariKurikulum) { %> &middot; <span class="text-primary">status awal otomatis, ubah bila perlu</span><% } %></div><% } %>
                      <% if (i.sopKode) { %><div class="small text-muted"><i class="bi bi-link-45deg"></i> <%= i.sopKode %>: <%= i.sopStatus %><% if (i.sopUrl) { %> &middot; <a href="<%= i.sopUrl %>" target="_blank">Buka SOP</a><% } %></div><% } %>
                      <% if (i.catatan) { %><div class="small text-primary"><i class="bi bi-sticky me-1"></i><%= i.catatan %></div><% } %>
                    </td>
                    <td>
                      <% const st = STATUS_MASTER[i.status] || STATUS_MASTER.belum; %>
                      <span class="badge bg-<%= st.badge %>"><%= st.label %></span>
                    </td>
                    <td class="small"><%= i.picNama || '-' %></td>
                    <td>
                      <% if (i.fileUrl) { %>
                        <div class="d-flex gap-1 align-items-center">
                          <a href="/pratinjau?u=<%= encodeURIComponent(i.fileUrl) %>" target="_blank" class="small text-truncate" style="max-width:120px;" title="<%= i.fileName %>"><%= i.fileName %></a>
                        </div>
                      <% } else { %>
                        <form method="POST" action="/dosen/akreditasi/master/item/<%= i.id %>/upload" enctype="multipart/form-data" class="d-flex gap-1">
                          <input type="file" name="file" class="form-control form-control-sm" required style="max-width:150px;">
                          <button class="btn btn-sm btn-primary py-0 px-2"><i class="bi bi-upload"></i></button>
                        </form>
                      <% } %>
                    </td>
                    
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div></div>
      <% }) %>
  <% } %>
</div>
<%- include('../../partials/footer') %>
