<%- include('../../partials/header') %>
<div class="container mt-4 mb-5">
  <a href="/dosen/akreditasi" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Kembali ke Daftar Kriteria</a>

  <div class="card mb-4">
    <div class="card-body">
      <h4 class="card-title">Kriteria <%= kriteria.kode %>: <%= kriteria.nama %></h4>
      <p class="text-muted"><%= kriteria.deskripsi %></p>
      <div class="d-flex gap-3 flex-wrap">
        <% const badge = kriteria.status === 'selesai' ? 'success' : (kriteria.status === 'proses' ? 'warning' : 'secondary'); %>
        <span class="badge bg-<%= badge %>">
          <%= kriteria.status === 'selesai' ? 'Selesai' : (kriteria.status === 'proses' ? 'Sedang Diproses' : 'Belum Dimulai') %>
        </span>
        <% if (picNamaList.length) { %>
          <span class="small text-muted">PIC: <%= picNamaList.join(', ') %></span>
        <% } %>
        <% if (kriteria.targetTanggal) { %>
          <span class="small <%= kriteria.terlambat ? 'text-danger fw-bold' : 'text-muted' %>">
            <i class="bi bi-calendar-event me-1"></i>Target: <%= kriteria.targetTanggal %>
            <% if (kriteria.terlambat) { %> <i class="bi bi-exclamation-triangle-fill"></i><% } %>
          </span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ============== NARASI LED ============== -->
  <div class="card mb-4" id="led">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-pencil-square me-1"></i> Narasi Laporan Evaluasi Diri (LED) - Kriteria <%= kriteria.kode %></span>
      <% const ledSt = kriteria.ledStatus || 'draft'; %>
      <span class="badge bg-<%= ledSt === 'final' ? 'success' : (ledSt === 'review' ? 'info' : 'secondary') %>"><%= ledSt === 'final' ? 'Final' : (ledSt === 'review' ? 'Siap Direview' : 'Draft') %></span>
    </div>
    <div class="card-body">
      <form method="POST" action="/dosen/akreditasi/kriteria/<%= kriteria.id %>/led">
        <textarea name="ledNarasi" class="form-control mb-2" rows="10" <%= ledSt === 'final' ? 'disabled' : '' %>
          placeholder="Tulis narasi LED untuk kriteria ini: kondisi, upaya/program, capaian, evaluasi, dan tindak lanjut (PPEPP). Rujuk bukti dari Workspace/Master Dokumen."><%= kriteria.ledNarasi || '' %></textarea>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <small class="text-muted">
            <% if (kriteria.ledUpdatedAt) { %>Terakhir diubah <%= new Date(kriteria.ledUpdatedAt).toLocaleString('id-ID') %> oleh <%= kriteria.ledUpdatedBy %> &middot; <% } %>
            <%= (kriteria.ledNarasi || '').trim() ? (kriteria.ledNarasi.trim().split(/\s+/).length) : 0 %> kata <% if (ledSt === 'final') { %> &middot; Sudah final (dikunci admin)<% } %>
          </small>
          <div class="d-flex gap-2">
            <select name="ledStatus" class="form-select form-select-sm" style="width:auto;" <%= ledSt === 'final' ? 'disabled' : '' %>>
              <option value="draft" <%= ledSt === 'draft' ? 'selected' : '' %>>Draft</option>
              <option value="review" <%= ledSt === 'review' ? 'selected' : '' %>>Siap Direview</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary" <%= ledSt === 'final' ? 'disabled' : '' %>>Simpan Narasi</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="row">
    <!-- ============== CHECKLIST PROSES ============== -->
    <div class="col-lg-4 mb-4" id="checklist">
      <div class="card h-100">
        <div class="card-header"><i class="bi bi-check2-square me-1"></i> Checklist Proses</div>
        <div class="card-body">
          <% const chkTotal = checklistList.length; const chkSelesai = checklistList.filter(c => c.selesai).length; %>
          <% if (chkTotal) { %>
            <div class="progress mb-3" style="height: 18px;">
              <div class="progress-bar bg-info" style="width: <%= Math.round((chkSelesai/chkTotal)*100) %>%;">
                <%= chkSelesai %>/<%= chkTotal %>
              </div>
            </div>
          <% } else { %>
            <p class="text-muted small">Belum ada checklist untuk kriteria ini.</p>
          <% } %>
          <ul class="list-group list-group-flush">
            <% checklistList.forEach(c => { %>
              <li class="list-group-item px-0">
                <form method="POST" action="/dosen/akreditasi/checklist/<%= c.id %>/toggle" class="d-flex gap-2 align-items-start">
                  <input type="checkbox" class="form-check-input mt-1" onchange="this.form.submit()" <%= c.selesai ? 'checked' : '' %>>
                  <button type="submit" class="btn btn-link btn-sm p-0 text-start <%= c.selesai ? 'text-decoration-line-through text-muted' : '' %>" style="border:none;background:none;">
                    <%= c.item %>
                  </button>
                </form>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>

    <!-- ============== DOKUMEN ============== -->
    <div class="col-lg-4 mb-4">
      <div class="card h-100">
        <div class="card-header"><i class="bi bi-folder2-open me-1"></i> Pengumpulan Dokumen</div>
        <div class="card-body">
          <form method="POST" action="/dosen/akreditasi/kriteria/<%= kriteria.id %>/dokumen" enctype="multipart/form-data" class="mb-3">
            <div class="mb-2">
              <input type="text" name="judul" class="form-control form-control-sm" placeholder="Judul dokumen (contoh: RPS Mata Kuliah X)" required>
            </div>
            <div class="d-flex gap-2">
              <input type="file" name="file" class="form-control form-control-sm" required>
              <button type="submit" class="btn btn-sm btn-primary">Unggah</button>
            </div>
          </form>
          <hr>
          <% if (!dokumenList.length) { %>
            <p class="text-muted small mb-0">Belum ada dokumen diunggah untuk kriteria ini.</p>
          <% } else { %>
            <ul class="list-group list-group-flush">
              <% dokumenList.forEach(doc => { %>
                <li class="list-group-item px-0">
                  <a href="/pratinjau?u=<%= encodeURIComponent(doc.fileUrl) %>" target="_blank"><%= doc.judul %></a>
                  <div class="text-muted small">
                    <%= doc.fileName %> &middot; oleh <%= doc.uploadedBy %> (<%= doc.uploadedByRole %>)
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ============== DISKUSI / PEMBAHASAN ============== -->
    <div class="col-lg-4 mb-4" id="diskusi">
      <div class="card h-100">
        <div class="card-header"><i class="bi bi-chat-dots me-1"></i> Tempat Pembahasan</div>
        <div class="card-body d-flex flex-column" style="max-height: 480px;">
          <div class="flex-grow-1 overflow-auto mb-3" style="max-height: 340px;">
            <% if (!diskusiList.length) { %>
              <p class="text-muted small">Belum ada pembahasan. Mulai diskusi di bawah ini.</p>
            <% } else { %>
              <% diskusiList.forEach(d => { %>
                <div class="mb-2 p-2 rounded <%= d.role === 'admin' ? 'bg-light' : 'bg-white border' %>">
                  <div class="small fw-bold">
                    <%= d.userNama %>
                    <span class="badge bg-secondary bg-opacity-50 text-dark"><%= d.role %></span>
                  </div>
                  <div><%= d.pesan %></div>
                  <div class="text-muted" style="font-size: 0.75rem;">
                    <%= new Date(d.createdAt).toLocaleString('id-ID') %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
          <form method="POST" action="/dosen/akreditasi/kriteria/<%= kriteria.id %>/diskusi" class="mt-auto d-flex gap-2">
            <input type="text" name="pesan" class="form-control" placeholder="Tulis pembahasan / catatan..." required>
            <button type="submit" class="btn btn-primary">Kirim</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>
