<%- include('../partials/header') %>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }

  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem; padding: 1.8rem 2rem; color: white; margin-bottom: 1.5rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
  }
  .page-header h2 { font-weight: 700; margin-bottom: 0.3rem; }
  .page-header p { margin: 0; opacity: 0.9; }
  .page-header .btn-back {
    background: white; border: none; border-radius: 50px; padding: 0.5rem 1.4rem; font-weight: 600;
    color: var(--primary-start); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }

  .info-card {
    background: white; border-radius: 1.2rem; padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04); border: 1px solid rgba(30,58,138,0.08); margin-bottom: 1.5rem;
  }

  #editor-edit { min-height: 300px; background: white; }

  .btn-simpan {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); border: none; color: white;
    font-weight: 600; padding: 0.7rem 2rem; border-radius: 50px; box-shadow: 0 8px 20px rgba(30,58,138,0.3);
  }
</style>

<div class="container mt-4">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h2><i class="bi bi-pencil-square me-2"></i>Edit Modul</h2>
      <p><%= mk.kode %> - <%= mk.nama %></p>
    </div>
    <a href="/dosen/mk/<%= mk.id %>/modul" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <div class="info-card">
    <form method="POST" action="/dosen/mk/<%= mk.id %>/modul/<%= modul.id %>/update" enctype="multipart/form-data" id="formEditModul">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label small fw-semibold">Judul Modul</label>
          <input type="text" class="form-control" name="judul" value="<%= modul.judul %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Urutan</label>
          <input type="number" class="form-control" name="urutan" value="<%= modul.urutan %>">
        </div>
        <div class="col-12">
          <label class="form-label small fw-semibold">Isi Modul</label>
          <div id="editor-edit"></div>
          <input type="hidden" name="konten" id="konten-edit">
        </div>
        <div class="col-12">
          <label class="form-label small fw-semibold">Upload Modul (PDF)</label>
          <% if (modul.fileId) { %>
            <div class="mb-2">
              <div class="d-flex justify-content-between align-items-center mb-1 small">
                <span><i class="bi bi-file-earmark-pdf text-danger me-1"></i>File saat ini: <a href="<%= modul.fileUrl %>" target="_blank"><%= modul.fileNama || 'Modul.pdf' %></a></span>
              </div>
              <iframe src="https://drive.google.com/file/d/<%= modul.fileId %>/preview" style="width:100%; height:400px; border:1px solid #e2e8f0; border-radius:0.75rem;" allow="autoplay"></iframe>
            </div>
          <% } else if (modul.fileUrl) { %>
            <div class="mb-2 small">
              File saat ini: <a href="<%= modul.fileUrl %>" target="_blank"><%= modul.fileNama || 'Lampiran' %></a>
            </div>
          <% } %>
          <input type="file" class="form-control" name="file" accept="application/pdf,.pdf">
          <small class="text-muted">Kosongkan jika tidak ingin mengganti file PDF yang sudah ada.</small>
        </div>
      </div>
      <div class="text-end mt-3">
        <button type="submit" class="btn-simpan"><i class="bi bi-save me-1"></i> Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  const quillEdit = new Quill('#editor-edit', {
    theme: 'snow',
    placeholder: 'Tulis isi modul di sini...'
  });
  // Prefill konten yang sudah ada (dikirim sbg JSON string supaya aman dari
  // karakter kutip/HTML di dalamnya)
  quillEdit.root.innerHTML = <%- JSON.stringify(modul.konten || '') %>;

  document.getElementById('formEditModul').addEventListener('submit', function () {
    document.getElementById('konten-edit').value = quillEdit.root.innerHTML;
  });
</script>

<%- include('../partials/footer') %>
