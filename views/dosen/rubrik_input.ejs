<%- include('../partials/header') %>

<%
  if (typeof mk === 'undefined') mk = { kode: '', nama: '', sks: '', semester: '' };
  if (typeof bobot === 'undefined') bobot = {};
  if (typeof data === 'undefined') data = [];
%>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem; padding: 1.5rem 2rem; color: white; margin-bottom: 1.5rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25); position: relative; overflow: hidden;
  }
  .page-header::before {
    content: ''; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px;
    background: rgba(255,255,255,0.1); border-radius: 50%; transform: rotate(25deg);
  }
  .page-header h2 { font-weight: 700; margin: 0; position: relative; z-index: 1; font-size: 1.8rem; }
  .page-header .btn-back, .page-header .btn-cetak {
    background: white; border: none; border-radius: 50px; padding: 0.5rem 1.4rem; font-weight: 600;
    color: var(--primary-start); box-shadow: 0 5px 15px rgba(0,0,0,0.1); transition: all 0.3s;
    text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .page-header .btn-back:hover, .page-header .btn-cetak:hover { transform: translateY(-3px); color: var(--primary-dark); }

  .bobot-card {
    background: white; border-radius: 1.2rem; padding: 1.3rem 1.5rem; margin-bottom: 1.5rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid rgba(30,58,138,0.1);
  }
  .bobot-card label { font-size: 0.8rem; font-weight: 600; color: #64748b; margin-bottom: 0.2rem; }
  .bobot-card input { text-align: center; }
  .bobot-card .sub-title { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--primary-start); font-weight: 700; margin-bottom: 0.6rem; }
  .kontrak-kuliah-card summary::-webkit-details-marker { display: none; }
  .kontrak-kuliah-card[open] summary { margin-bottom: 0.5rem; }

  .table-responsive { border-radius: 1.2rem; overflow-x: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid rgba(30,58,138,0.1); background: white; }
  .rubrik-table { width: 100%; border-collapse: collapse; margin-bottom: 0; min-width: 1300px; }
  .rubrik-table thead th {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); color: white; font-weight: 600;
    text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.3px; border: none; padding: 0.7rem 0.5rem;
    text-align: center; white-space: normal; position: sticky; top: 0; z-index: 5;
  }
  .rubrik-table tbody td { vertical-align: middle; padding: 0.4rem; border-bottom: 1px solid #e9ecef; font-size: 0.85rem; text-align: center; }
  .rubrik-table tbody tr:nth-child(even) { background: #f8fafc; }
  .rubrik-table input.komponen-input {
    width: 62px; text-align: center; border: 1px solid #cbd5e1; border-radius: 0.5rem; padding: 0.25rem;
  }
  .rubrik-table input.komponen-input:focus { border-color: var(--primary-start); outline: none; box-shadow: 0 0 0 0.15rem rgba(30,58,138,0.2); }
  .readonly-cell { background: #e2efda !important; font-weight: 600; border-radius: 0.5rem; padding: 0.3rem 0.4rem; display: inline-block; min-width: 45px; }
  .final-cell { background: #d9e1f2; font-weight: 700; border-radius: 0.5rem; padding: 0.3rem 0.5rem; display: inline-block; min-width: 45px; }
  .huruf-badge { font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 50px; font-size: 0.8rem; }
  .lulus { color: #15803d; } .tidak-lulus { color: #b91c1c; }
  .name-cell { text-align: left !important; white-space: nowrap; }
  .saving-note { font-size: 0.7rem; color: #64748b; }
  .info-note-pdk { background: #eef2ff; border-left: 4px solid var(--primary-start); border-radius: 0.8rem; padding: 1rem 1.3rem; margin-bottom: 1.2rem; font-size: 0.88rem; color: #1e293b; }
  .info-note-pdk a { color: var(--primary-start); font-weight: 600; }
</style>

<div class="container-fluid mt-4">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h2><i class="bi bi-clipboard-data me-2"></i>Rubrik Penilaian - <%= mk.kode %> <%= mk.nama %></h2>
    <div class="d-flex gap-2">
      <a href="/dosen/rubrik/<%= mk.id %>/rincian-tugas?periode=<%= encodeURIComponent(periode) %>" class="btn-cetak">
        <i class="bi bi-list-check"></i> Rincian Tugas
      </a>
      <a href="/dosen/rubrik/<%= mk.id %>/cetak?periode=<%= encodeURIComponent(periode) %>" target="_blank" class="btn-cetak">
        <i class="bi bi-printer"></i> Cetak
      </a>
      <a href="/dosen/rubrik" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <% if (typeof mkDuplikat !== 'undefined' && mkDuplikat.length > 0) { %>
    <div class="alert alert-danger" style="border-radius: 0.8rem;">
      <i class="bi bi-exclamation-triangle-fill me-1"></i>
      <strong>Ditemukan kemungkinan penyebab nilai tidak tersimpan!</strong>
      Ada <strong><%= mkDuplikat.length %></strong> data Mata Kuliah lain di sistem dengan
      kode yang sama persis (<strong><%= mk.kode %></strong>) tapi <strong>ID Firestore
      berbeda</strong> dari MK yang sedang Anda buka sekarang - kemungkinan besar ada
      duplikat data MK "<%= mk.kode %>" (mis. sisa dari semester lalu, atau input ganda).
      Kalau ada mahasiswa yang nilainya (kehadiran/sikap/kuis/dst) selalu balik ke angka
      semula setelah refresh, kemungkinan besar mahasiswa itu sebenarnya "terdaftar" di
      salah satu MK duplikat berikut, bukan MK yang sedang Anda buka:
      <ul class="mb-0 mt-2">
        <% mkDuplikat.forEach(m => { %>
          <li>
            <code><%= m.id %></code> - <%= m.nama || '(tanpa nama)' %>
            <a href="/dosen/rubrik/<%= m.id %>?periode=<%= encodeURIComponent(periode) %>" target="_blank">buka rubrik MK ini</a>
          </li>
        <% }) %>
      </ul>
      <div class="mt-2">Kabari admin - ini perlu digabungkan/dibersihkan langsung di data MK (Firestore), bukan sekadar diperbaiki lewat halaman ini.</div>
    </div>
  <% } %>

  <!-- Pilih Periode - halaman ini sebelumnya SELALU terkunci ke periode
       aktif sekarang, tidak ada cara pindah lihat periode lain lewat UI.
       Ini bisa bikin tugas/nilai yang diberikan di periode lain terlihat
       "hilang" padahal cuma tidak sedang ditampilkan. -->
  <div class="d-flex align-items-center gap-2 mb-3">
    <label for="periodeSelect" class="mb-0 small text-muted">Periode:</label>
    <select id="periodeSelect" class="form-select form-select-sm" style="width: auto;"
      onchange="window.location.href = '/dosen/rubrik/<%= mk.id %>?periode=' + encodeURIComponent(this.value)">
      <option value="<%= periode %>" selected><%= periode %> (sedang dibuka)</option>
      <% if (typeof periodeLain !== 'undefined') { %>
        <% periodeLain.forEach(p => { %>
          <option value="<%= p %>"><%= p %></option>
        <% }) %>
      <% } %>
    </select>
  </div>

  <% if (typeof periodeLain !== 'undefined' && periodeLain.length > 0) { %>
    <div class="alert alert-warning" style="border-radius: 0.8rem;">
      <i class="bi bi-calendar-x me-1"></i>
      Ada tugas untuk MK ini yang tercatat di periode lain:
      <strong><%= periodeLain.join(', ') %></strong> - bukan di periode
      <strong><%= periode %></strong> yang sedang Anda buka. Coba pilih periode
      itu dari dropdown di atas untuk melihat/menilai tugasnya.
    </div>
  <% } %>

  <% if (typeof jumlahNilaiTugasTanpaTugas !== 'undefined' && jumlahNilaiTugasTanpaTugas > 0) { %>
    <div class="alert alert-warning" style="border-radius: 0.8rem;">
      <i class="bi bi-exclamation-triangle-fill me-1"></i>
      Ditemukan <strong><%= jumlahNilaiTugasTanpaTugas %></strong> nilai tugas tersimpan
      untuk MK ini yang dokumen tugasnya sudah tidak ada lagi (mis. tugasnya sempat
      dihapus setelah dinilai). Nilai ini <strong>tidak akan pernah muncul</strong> di
      Rata Tugas manapun sampai ditangani manual oleh admin langsung di database.
    </div>
  <% } %>

  <!-- Bobot Komponen -->
  <% if (!isPDK) { %>
  <div class="bobot-card">
    <form method="POST" action="/dosen/rubrik/<%= mk.id %>/bobot" class="row g-3 align-items-end">
      <input type="hidden" name="periode" value="<%= periode %>">
      <div class="col-12"><div class="sub-title">Bobot Komponen Nilai Akhir (%, total idealnya 100)</div></div>
      <div class="col-6 col-md-2"><label>Kehadiran</label><input type="number" step="0.01" class="form-control" name="kehadiran" value="<%= bobot.kehadiran %>"></div>
      <div class="col-6 col-md-2"><label>Tugas</label><input type="number" step="0.01" class="form-control" name="tugas" value="<%= bobot.tugas %>"></div>
      <div class="col-6 col-md-2"><label>Kuis</label><input type="number" step="0.01" class="form-control" name="kuis" value="<%= bobot.kuis %>"></div>
      <div class="col-6 col-md-2"><label>UTS</label><input type="number" step="0.01" class="form-control" name="uts" value="<%= bobot.uts %>"></div>
      <div class="col-6 col-md-2"><label>UAS</label><input type="number" step="0.01" class="form-control" name="uas" value="<%= bobot.uas %>"></div>

      <div class="col-12 mt-3"><div class="sub-title">Sub-bobot Nilai Kehadiran (%, dari % hadir + sikap + keaktifan)</div></div>
      <div class="col-6 col-md-2"><label>% Hadir</label><input type="number" step="0.01" class="form-control" name="persenHadir" value="<%= bobot.persenHadir %>"></div>
      <div class="col-6 col-md-2"><label>Sikap</label><input type="number" step="0.01" class="form-control" name="sikap" value="<%= bobot.sikap %>"></div>
      <div class="col-6 col-md-2"><label>Keaktifan</label><input type="number" step="0.01" class="form-control" name="keaktifan" value="<%= bobot.keaktifan %>"></div>

      <div class="col-12 col-md-4">
        <button type="submit" class="btn btn-primary w-100" style="border-radius:50px;"><i class="bi bi-save"></i> Simpan Bobot</button>
      </div>
    </form>
  </div>

  <!-- Isian Kontrak Kuliah (beda-beda tiap dosen/MK, dipakai di halaman cetak) -->
  <details class="bobot-card kontrak-kuliah-card">
    <summary class="sub-title" style="cursor:pointer; list-style:none;">
      <i class="bi bi-file-earmark-text"></i> Isian Kontrak Kuliah (klik untuk buka/tutup)
    </summary>
    <p class="text-muted small mt-2 mb-3">
      Isi bagian ini untuk menyesuaikan halaman cetak "Kontrak Kuliah" sesuai MK Anda. Kalau tidak diisi,
      halaman cetak tetap tampil dengan teks umum bawaan sistem.
    </p>
    <form method="POST" action="/dosen/rubrik/<%= mk.id %>/kontrak-kuliah" class="row g-3">
      <input type="hidden" name="periode" value="<%= periode %>">
      <div class="col-12">
        <label class="form-label fw-semibold">Deskripsi &amp; Capaian Pembelajaran</label>
        <textarea name="deskripsi" class="form-control" rows="3"
                  placeholder="Kosongkan untuk pakai teks umum bawaan sistem."><%= kontrakKuliah ? kontrakKuliah.deskripsi : '' %></textarea>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Kriteria Kelulusan &amp; Konversi Nilai Huruf Mutu</label>
        <textarea name="kriteriaKelulusan" class="form-control" rows="2"
                  placeholder="Kosongkan untuk pakai teks umum bawaan sistem."><%= kontrakKuliah ? kontrakKuliah.kriteriaKelulusan : '' %></textarea>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Tata Tertib Perkuliahan <small class="text-muted">(satu aturan per baris)</small></label>
        <textarea name="tataTertib" class="form-control" rows="5"
                  placeholder="Kosongkan untuk pakai daftar umum bawaan sistem."><%= (kontrakKuliah && kontrakKuliah.tataTertib && kontrakKuliah.tataTertib.length > 0) ? kontrakKuliah.tataTertib.join('\n') : '' %></textarea>
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-primary" style="border-radius:50px;"><i class="bi bi-save"></i> Simpan Kontrak Kuliah</button>
      </div>
    </form>
  </details>

  <%
    const pakaiSikap = (bobot.sikap || 0) > 0;
    const pakaiKeaktifan = (bobot.keaktifan || 0) > 0;
    const pakaiKuis = (bobot.kuis || 0) > 0;
    const kehadiranColspan = 2 + (pakaiSikap ? 1 : 0) + (pakaiKeaktifan ? 1 : 0);
    const totalKolom = 3 + kehadiranColspan + 1 + (pakaiKuis ? 1 : 0) + 2 + 3;
  %>

  <!-- Tabel Rubrik -->
  <div class="table-responsive">
    <table class="rubrik-table">
      <thead>
        <tr>
          <th rowspan="2">No</th>
          <th rowspan="2">NIM</th>
          <th rowspan="2">Nama Mahasiswa</th>
          <th colspan="<%= kehadiranColspan %>">Kehadiran<% if (pakaiSikap || pakaiKeaktifan) { %>, Sikap &amp; Keaktifan<% } %></th>
          <th rowspan="2">Tugas<br><small>(otomatis)</small></th>
          <% if (pakaiKuis) { %><th rowspan="2">Kuis</th><% } %>
          <th rowspan="2">UTS</th>
          <th rowspan="2">UAS</th>
          <th rowspan="2">Nilai<br>Akhir</th>
          <th rowspan="2">Huruf</th>
          <th rowspan="2">Keterangan</th>
        </tr>
        <tr>
          <th>Total<br>Pertemuan</th>
          <th>Jml<br>Hadir</th>
          <% if (pakaiSikap) { %><th>Sikap</th><% } %>
          <% if (pakaiKeaktifan) { %><th>Keaktifan</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% if (data.length === 0) { %>
          <tr><td colspan="<%= totalKolom %>" class="text-center py-5 text-muted">Belum ada mahasiswa aktif di MK ini.</td></tr>
        <% } %>
        <% data.forEach((item, idx) => { %>
          <% const k = item.komponen; const h = item.hasil; const mid = item.mahasiswa.id; %>
          <tr>
            <td><%= idx + 1 %></td>
            <td><%= item.mahasiswa.nim %></td>
            <td class="name-cell"><%= item.mahasiswa.nama %></td>
            <td>
              <input type="number" class="komponen-input" value="<%= k.KEHADIRAN_TOTAL ?? 16 %>"
                     oninput="jadwalSimpan(this, '<%= mid %>', 'KEHADIRAN_TOTAL')">
            </td>
            <td>
              <input type="number" class="komponen-input" value="<%= k.KEHADIRAN_JUMLAH ?? '' %>"
                     oninput="jadwalSimpan(this, '<%= mid %>', 'KEHADIRAN_JUMLAH')">
            </td>
            <% if (pakaiSikap) { %>
            <td>
              <input type="number" min="0" max="100" class="komponen-input" value="<%= k.SIKAP ?? '' %>"
                     oninput="jadwalSimpan(this, '<%= mid %>', 'SIKAP')">
            </td>
            <% } %>
            <% if (pakaiKeaktifan) { %>
            <td>
              <input type="number" min="0" max="100" class="komponen-input" value="<%= k.KEAKTIFAN ?? '' %>"
                     oninput="jadwalSimpan(this, '<%= mid %>', 'KEAKTIFAN')">
            </td>
            <% } %>
            <td><span class="readonly-cell" id="tugas-<%= mid %>"><%= h.rataTugas !== null ? h.rataTugas.toFixed(2) : '-' %></span></td>
            <% if (pakaiKuis) { %>
            <td>
              <input type="number" min="0" max="100" class="komponen-input" value="<%= k.KUIS ?? '' %>"
                     oninput="jadwalSimpan(this, '<%= mid %>', 'KUIS')">
            </td>
            <% } %>
            <td>
              <input type="number" min="0" max="100" class="komponen-input" value="<%= k.UTS ?? '' %>"
                     oninput="jadwalSimpan(this, '<%= mid %>', 'UTS')">
            </td>
            <td>
              <input type="number" min="0" max="100" class="komponen-input" value="<%= k.UAS ?? '' %>"
                     oninput="jadwalSimpan(this, '<%= mid %>', 'UAS')">
            </td>
            <td>
              <span class="final-cell" id="nilai-akhir-<%= mid %>"><%= h.nilaiAkhir !== null ? h.nilaiAkhir.toFixed(2) : '-' %></span>
              <% if (h.nilaiAkhir === null && h.belumLengkap && h.belumLengkap.length > 0) { %>
                <div class="belum-lengkap-hint" id="belum-lengkap-<%= mid %>">Belum: <%= h.belumLengkap.join(', ') %></div>
              <% } else { %>
                <div class="belum-lengkap-hint" id="belum-lengkap-<%= mid %>" style="display:none;"></div>
              <% } %>
            </td>
            <td><span class="huruf-badge" id="huruf-<%= mid %>"><%= h.huruf || '-' %></span></td>
            <td id="keterangan-<%= mid %>" class="<%= h.keterangan === 'LULUS' ? 'lulus' : (h.keterangan === 'TIDAK LULUS' ? 'tidak-lulus' : '') %>">
              <%= h.keterangan || '-' %>
              <% if (item.kunci && item.kunci.terkunci) { %>
                <% if (item.kunci.berbeda) { %>
                  <div class="kunci-hint kunci-berubah" title="Nilai di KHS mahasiswa masih <%= item.kunci.nilaiTerkunci %> - beda dari rubrik sekarang. Minta admin kunci ulang.">
                    <i class="bi bi-exclamation-triangle"></i> KHS belum update
                  </div>
                <% } else { %>
                  <div class="kunci-hint kunci-aman" title="Nilai ini sudah masuk KHS resmi mahasiswa.">
                    <i class="bi bi-lock-fill"></i> Sudah di KHS
                  </div>
                <% } %>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="saving-note mt-2">
    <i class="bi bi-info-circle"></i> Nilai tersimpan otomatis ~1 detik setelah Anda berhenti mengetik (tanpa perlu reload halaman).
    Kolom komponen yang bobotnya diatur 0% di panel Bobot Komponen di atas otomatis <strong>disembunyikan</strong> dari tabel ini (tidak wajib diisi).
    Kalau Nilai Akhir masih tampil "-", lihat catatan kecil <em>"Belum: ..."</em> di bawah angkanya - itu menyebutkan komponen mana saja yang masih kosong.
  </p>
  <% } else { %>
  <!-- ============================================================ -->
  <!-- MK PDK/MAGANG: nilai akhir = rata-rata 3 komponen magang, tidak -->
  <!-- diisi di sini - halaman ini cuma menampilkan ringkasannya.     -->
  <!-- ============================================================ -->
  <div class="info-note-pdk">
    <i class="bi bi-info-circle"></i> Mata kuliah ini adalah <strong>PDK/Magang</strong>.
    Nilai Akhir dihitung otomatis dari rata-rata 3 komponen: <strong>Nilai Laporan</strong>
    (diisi Pembimbing 1 di menu <a href="/dosen/laporan-review">Review Laporan Magang</a>
    setelah laporan di-ACC), <strong>Nilai Logbook</strong> (diisi Pembimbing 2 di halaman
    detail logbook mahasiswa, setelah logbook dikunci), dan <strong>Nilai Lapangan</strong>
    (diisi Admin). Tidak ada yang perlu diisi langsung di halaman ini.
  </div>

  <div class="table-responsive">
    <table class="rubrik-table">
      <thead>
        <tr>
          <th>No</th><th>NIM</th><th>Nama Mahasiswa</th>
          <th>Nilai Laporan<br><small>(Pembimbing 1)</small></th>
          <th>Nilai Logbook<br><small>(Pembimbing 2)</small></th>
          <th>Nilai Lapangan<br><small>(Admin)</small></th>
          <th>Nilai Akhir</th><th>Huruf</th><th>Keterangan</th>
        </tr>
      </thead>
      <tbody>
        <% if (data.length === 0) { %>
          <tr><td colspan="9" class="text-center py-5 text-muted">Belum ada mahasiswa aktif di MK ini.</td></tr>
        <% } %>
        <% data.forEach((item, idx) => { const h = item.hasil; const nm = item.nilaiMagang || {}; %>
          <tr>
            <td><%= idx + 1 %></td>
            <td><%= item.mahasiswa.nim %></td>
            <td class="name-cell"><%= item.mahasiswa.nama %></td>
            <td><%= nm.nilaiLaporan ?? '-' %></td>
            <td>
              <%= nm.nilaiLogbook ?? '-' %>
              <% if (!nm.logbookDikunci) { %><br><small class="text-muted">(belum dikunci)</small><% } %>
            </td>
            <td><%= nm.nilaiLapangan ?? '-' %></td>
            <td><span class="final-cell"><%= h.nilaiAkhir !== null ? h.nilaiAkhir.toFixed(2) : '-' %></span>
              <% if (h.nilaiAkhir === null && h.belumLengkap && h.belumLengkap.length > 0) { %>
                <div class="belum-lengkap-hint">Belum: <%= h.belumLengkap.join(', ') %></div>
              <% } %>
            </td>
            <td><span class="huruf-badge"><%= h.huruf || '-' %></span></td>
            <td class="<%= h.keterangan === 'LULUS' ? 'lulus' : (h.keterangan === 'TIDAK LULUS' ? 'tidak-lulus' : '') %>"><%= h.keterangan || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<style>
  .belum-lengkap-hint { font-size: 0.68rem; color: #b45309; margin-top: 2px; line-height: 1.2; }
  .kunci-hint { font-size: 0.65rem; margin-top: 3px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 3px; }
  .kunci-hint.kunci-aman { color: #065f46; }
  .kunci-hint.kunci-berubah { color: #92400e; }
  .komponen-input.saved-flash { border-color: #22c55e !important; box-shadow: 0 0 0 0.15rem rgba(34,197,94,0.3) !important; }
</style>

<script>
const timers = {};

// Debounce: simpan baru dikirim ~900ms setelah pengguna BERHENTI mengetik,
// supaya mengetik angka 2 digit (mis. 80) tidak pernah terputus/tersimpan
// sebagian, dan tidak perlu reload halaman penuh setiap kali.
function jadwalSimpan(el, mahasiswaId, tipe) {
  const key = mahasiswaId + '-' + tipe;
  clearTimeout(timers[key]);
  timers[key] = setTimeout(() => simpanKomponen(el, mahasiswaId, tipe), 900);
}

async function simpanKomponen(el, mahasiswaId, tipe) {
  const nilai = el.value;
  if (nilai === '') return;
  try {
    const body = new URLSearchParams({
      mkId: '<%= mk.id %>',
      mahasiswaId,
      tipe,
      nilai,
      periode: '<%= periode %>'
    });
    const res = await fetch('/dosen/rubrik/input', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body
    });
    const json = await res.json();
    if (json.success) {
      updateBarisHasil(mahasiswaId, json.hasil);
      el.classList.add('saved-flash');
      setTimeout(() => el.classList.remove('saved-flash'), 700);
    } else {
      alert('Gagal menyimpan: ' + json.message);
    }
  } catch (err) {
    alert('Gagal menyimpan nilai: ' + err.message);
  }
}

// Update sel-sel hasil hitungan (Tugas, Nilai Akhir, Huruf, Keterangan) di
// baris mahasiswa ini secara langsung, tanpa reload halaman.
function updateBarisHasil(mahasiswaId, h) {
  const tugasEl = document.getElementById('tugas-' + mahasiswaId);
  if (tugasEl) tugasEl.textContent = h.rataTugas !== null ? h.rataTugas.toFixed(2) : '-';

  const nilaiEl = document.getElementById('nilai-akhir-' + mahasiswaId);
  if (nilaiEl) nilaiEl.textContent = h.nilaiAkhir !== null ? h.nilaiAkhir.toFixed(2) : '-';

  const hurufEl = document.getElementById('huruf-' + mahasiswaId);
  if (hurufEl) hurufEl.textContent = h.huruf || '-';

  const ketEl = document.getElementById('keterangan-' + mahasiswaId);
  if (ketEl) {
    ketEl.textContent = h.keterangan || '-';
    ketEl.className = h.keterangan === 'LULUS' ? 'lulus' : (h.keterangan === 'TIDAK LULUS' ? 'tidak-lulus' : '');
  }

  const hintEl = document.getElementById('belum-lengkap-' + mahasiswaId);
  if (hintEl) {
    if (h.nilaiAkhir === null && h.belumLengkap && h.belumLengkap.length > 0) {
      hintEl.textContent = 'Belum: ' + h.belumLengkap.join(', ');
      hintEl.style.display = '';
    } else {
      hintEl.textContent = '';
      hintEl.style.display = 'none';
    }
  }
}
</script>

