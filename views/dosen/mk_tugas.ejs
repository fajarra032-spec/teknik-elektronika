<%- include('../partials/header') %>

<%
  const formatDate = (date) => {
    if (!date) return '-';
    return new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  };
%>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }

  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem; padding: 1.8rem 2rem; color: white; margin-bottom: 1.5rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
  }
  .page-header h2 { font-weight: 700; margin-bottom: 0.3rem; }
  .page-header p { margin: 0; opacity: 0.9; }
  .page-header .btn-back {
    background: white; border: none; border-radius: 50px; padding: 0.5rem 1.4rem; font-weight: 600;
    color: var(--primary-start); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;
  }

  .info-card {
    background: white; border-radius: 1.2rem; padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04); border: 1px solid rgba(30,58,138,0.08); margin-bottom: 1.5rem;
  }
  .info-card h5 { font-weight: 700; color: #1e293b; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }

  .btn-toggle-form {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end)); border: none; color: white;
    font-weight: 600; padding: 0.6rem 1.4rem; border-radius: 50px; box-shadow: 0 8px 20px rgba(30,58,138,0.25);
  }

  .table-container { background: white; border-radius: 1.2rem; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.04); border: 1px solid rgba(30,58,138,0.08); }
  .tugas-table thead th { background: #f8f9fa; font-weight: 600; color: #1e293b; border-bottom: 2px solid var(--primary-start); padding: 0.9rem; }
  .tugas-table tbody td { vertical-align: middle; padding: 0.9rem; border-bottom: 1px solid #e9ecef; }
  .badge-tipe { background: var(--primary-light); color: var(--primary-dark); padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.8rem; font-weight: 600; }
  .btn-action { border-radius: 50px; padding: 0.35rem 0.9rem; font-size: 0.82rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; border: none; }
  .btn-action-outline { border: 1.5px solid var(--primary-start); color: var(--primary-start); background: transparent; }
  .btn-action-outline:hover { background: var(--primary-light); }
  .btn-action-danger { background: #fee2e2; color: #b91c1c; }
  .btn-action-danger:hover { background: #fecaca; }

  .empty-state { text-align: center; padding: 3rem 1rem; color: #6c757d; }
  .empty-state i { font-size: 3rem; color: #adb5bd; margin-bottom: 1rem; display: block; }
</style>

<div class="container mt-4">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h2><i class="bi bi-file-earmark-text me-2"></i>Tugas</h2>
      <p><%= mk.kode %> - <%= mk.nama %></p>
    </div>
    <a href="/dosen/mk/<%= mk.id %>" class="btn-back"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <%- include('./partials/mk_tabs', { mk, activeTab: 'tugas' }) %>

  <!-- Buat Tugas Baru (inline, collapsible) -->
  <div class="info-card">
    <div class="d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#formTugasBaru">
      <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Buat Tugas Baru</h5>
      <button type="button" class="btn-toggle-form" data-bs-toggle="collapse" data-bs-target="#formTugasBaru">
        <i class="bi bi-plus-lg"></i> Tambah
      </button>
    </div>
    <div class="collapse mt-4" id="formTugasBaru">
      <form method="POST" action="/dosen/tugas" enctype="multipart/form-data">
        <input type="hidden" name="mkId" value="<%= mk.id %>">
        <input type="hidden" name="redirectTo" value="/dosen/mk/<%= mk.id %>/tugas">
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label small fw-semibold">Judul Tugas</label>
            <input type="text" class="form-control" name="judul" placeholder="mis. Tugas 1 - Rangkaian Seri" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Tipe</label>
            <select class="form-select" name="tipe">
              <option value="tugas">Tugas</option>
              <option value="kuis">Kuis</option>
              <option value="praktikum">Praktikum</option>
              <option value="lainnya">Lainnya</option>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label small fw-semibold">Deskripsi</label>
            <textarea class="form-control" name="deskripsi" rows="3" placeholder="Instruksi/deskripsi tugas (opsional)"></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Deadline</label>
            <input type="datetime-local" class="form-control" name="deadline" required>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-semibold">File Soal (opsional)</label>
            <input type="file" class="form-control" name="file" accept=".pdf,.doc,.docx,.zip">
          </div>
        </div>
        <div class="text-end mt-3">
          <button type="submit" class="btn-toggle-form"><i class="bi bi-save me-1"></i> Simpan Tugas</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Daftar Tugas -->
  <div class="table-container">
    <div class="table-responsive">
      <table class="table tugas-table mb-0">
        <thead>
          <tr>
            <th>Judul</th>
            <th>Tipe</th>
            <th>Deadline</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!tugasList || tugasList.length === 0) { %>
            <tr>
              <td colspan="4">
                <div class="empty-state">
                  <i class="bi bi-inbox"></i>
                  Belum ada tugas untuk mata kuliah ini pada periode aktif.
                </div>
              </td>
            </tr>
          <% } else { %>
            <% tugasList.forEach(t => { %>
              <tr>
                <td><strong style="color: #1e293b;"><%= t.judul %></strong></td>
                <td><span class="badge-tipe"><%= t.tipe || '-' %></span></td>
                <td><i class="bi bi-calendar3 me-1"></i><%= formatDate(t.deadline) %></td>
                <td>
                  <div class="d-flex gap-2 flex-wrap">
                    <a href="/dosen/tugas/<%= t.id %>" class="btn-action btn-action-outline">
                      <i class="bi bi-eye"></i> Detail & Nilai
                    </a>
                    <form method="POST" action="/dosen/tugas/<%= t.id %>/delete" style="display:inline;" onsubmit="return confirm('Yakin ingin menghapus tugas ini?')">
                      <input type="hidden" name="redirectTo" value="/dosen/mk/<%= mk.id %>/tugas">
                      <button type="submit" class="btn-action btn-action-danger"><i class="bi bi-trash"></i> Hapus</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
