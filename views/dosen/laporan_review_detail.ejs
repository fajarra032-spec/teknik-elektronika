<%- include('../partials/header') %>

<style>
  :root { --primary-start: #1e3a8a; --primary-end: #3b82f6; }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.2rem; padding: 1.5rem 2rem; color: white; margin-bottom: 1.5rem;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;
  }
  .card-laporan { background: white; border-radius: 1rem; padding: 1.2rem 1.5rem; margin-bottom: 1rem; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  .badge-status { font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 50px; font-size: 0.75rem; }
  .badge-approved { background: #d1fae5; color: #065f46; }
  .badge-submitted { background: #fef3c7; color: #92400e; }
  .badge-revisi { background: #fee2e2; color: #991b1b; }
  .nilai-card { background: white; border-radius: 1rem; padding: 1.5rem; box-shadow: 0 5px 15px rgba(0,0,0,0.05); margin-top: 1.5rem; }
  .nilai-locked { background: #f1f5f9; border-radius: 1rem; padding: 1.5rem; text-align: center; color: #64748b; margin-top: 1.5rem; }
</style>

<div class="container-fluid mt-4">
  <div class="page-header">
    <div>
      <h2 class="fw-bold mb-1"><%= mahasiswa.nama %></h2>
      <p class="mb-0 opacity-75">NIM: <%= mahasiswa.nim %></p>
    </div>
    <a href="/dosen/laporan-review" class="btn btn-light btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <% if (success) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle"></i>
      <%= success === 'status' ? 'Status laporan berhasil diperbarui.' : 'Nilai berhasil disimpan.' %>
    </div>
  <% } %>

  <h5 class="fw-bold mb-3">Daftar Laporan</h5>
  <% if (laporanList.length === 0) { %>
    <div class="card-laporan text-center text-muted py-4">Mahasiswa ini belum submit laporan.</div>
  <% } %>
  <% laporanList.forEach(l => { %>
    <div class="card-laporan">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <h6 class="fw-bold mb-1">Laporan ke-<%= l.laporanKe %><% if (l.judulPublik) { %>: <%= l.judulPublik %><% } %></h6>
          <% if (l.abstrak) { %><p class="text-muted small mb-1"><%= l.abstrak.substring(0, 200) %><%= l.abstrak.length > 200 ? '...' : '' %></p><% } %>
          <% if (l.catatanPembimbing1) { %>
            <div class="small text-muted"><i class="bi bi-chat-left-text"></i> Catatan Anda: <%= l.catatanPembimbing1 %></div>
          <% } %>
        </div>
        <span class="badge-status badge-<%= l.status === 'approved' ? 'approved' : (l.status === 'revisi' ? 'revisi' : 'submitted') %>">
          <%= l.status === 'approved' ? 'Di-ACC' : (l.status === 'revisi' ? 'Perlu Revisi' : 'Menunggu Tinjauan') %>
        </span>
      </div>

      <% if (l.status !== 'approved') { %>
        <form method="POST" action="/dosen/laporan-review/<%= l.id %>/status" class="mt-3 d-flex gap-2 flex-wrap align-items-end">
          <div class="flex-grow-1" style="min-width:220px;">
            <label class="form-label small fw-semibold mb-1">Catatan (opsional)</label>
            <input type="text" name="catatan" class="form-control form-control-sm" placeholder="Catatan untuk mahasiswa...">
          </div>
          <input type="hidden" name="status" value="approved">
          <button type="submit" class="btn btn-success btn-sm" onclick="this.form.status.value='approved';">
            <i class="bi bi-check-circle"></i> ACC Laporan Ini
          </button>
        </form>
        <form method="POST" action="/dosen/laporan-review/<%= l.id %>/status" class="mt-2 d-flex gap-2 flex-wrap align-items-end">
          <div class="flex-grow-1" style="min-width:220px;">
            <label class="form-label small fw-semibold mb-1">Alasan revisi</label>
            <input type="text" name="catatan" class="form-control form-control-sm" placeholder="Apa yang perlu diperbaiki...">
          </div>
          <input type="hidden" name="status" value="revisi">
          <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Minta Revisi</button>
        </form>
      <% } %>
    </div>
  <% }) %>

  <% if (pdkList.length > 0) { %>
    <% if (adaYangAcc) { %>
      <div class="nilai-card">
        <h5 class="fw-bold mb-1"><i class="bi bi-pencil-square"></i> Nilai Laporan (Pembimbing 1)</h5>
        <p class="text-muted small mb-3">
          Sesuai Pedoman Magang - 13 indikator (Laporan, Pengetahuan, Presentasi Magang), tiap indikator diisi angka 0-100.
        </p>
        <form method="POST" action="/dosen/laporan-review/mahasiswa/<%= mahasiswa.id %>/nilai">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Periode Magang (PDK)</label>
            <select name="pdkId" class="form-select" style="max-width:420px;">
              <% pdkList.forEach(p => { %>
                <option value="<%= p.pdkId %>" <%= p.pdkId === pdkIdDipilih ? 'selected' : '' %>><%= p.pdkKode %> - <%= p.pdkNama %></option>
              <% }) %>
            </select>
          </div>

          <%
            const items = (nilaiMagang && nilaiMagang.nilaiLaporanItems) ? nilaiMagang.nilaiLaporanItems : {};
            let kategoriSaatIni = null;
          %>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead>
                <tr><th style="width:60%;">Indikator</th><th style="width:40%;">Nilai (0-100)</th></tr>
              </thead>
              <tbody>
                <% ITEM_PEMBIMBING1.forEach(it => { %>
                  <% if (it.kategori !== kategoriSaatIni) { kategoriSaatIni = it.kategori; %>
                    <tr class="table-light"><td colspan="2" class="fw-bold small text-uppercase text-muted"><%= it.kategori %></td></tr>
                  <% } %>
                  <tr>
                    <td><%= it.label %></td>
                    <td>
                      <input type="number" name="item[<%= it.key %>]" min="0" max="100" step="0.01" class="form-control form-control-sm"
                             value="<%= items[it.key] !== undefined ? items[it.key] : '' %>" required style="max-width:140px;">
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <% if (nilaiMagang && nilaiMagang.nilaiLaporan !== null && nilaiMagang.nilaiLaporan !== undefined) { %>
            <div class="alert alert-primary d-inline-block px-3 py-2 mb-3">
              Rata-rata saat ini: <strong><%= nilaiMagang.nilaiLaporan %></strong>
            </div>
          <% } %>

          <div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Simpan Nilai Laporan</button>
          </div>
        </form>
        <p class="text-muted small mt-3 mb-0">
          Rata-rata 13 indikator ini akan digabung dengan Nilai Logbook (Pembimbing 2) dan Nilai Pendamping Lapangan (Admin) menjadi Nilai Akhir Magang.
        </p>
      </div>
    <% } else { %>
      <div class="nilai-locked">
        <i class="bi bi-lock fs-3 d-block mb-2"></i>
        Form Nilai Laporan baru muncul setelah minimal satu laporan di-ACC.
      </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/footer') %>
