<%- include('../partials/header') %>

<%
  const formatDate = (date) => {
    if (!date) return '-';
    return new Date(date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  };
%>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }
  body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc; }

  .detail-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    padding: 2rem;
    border-radius: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 15px 30px rgba(30,58,138,0.25);
    position: relative;
    overflow: hidden;
  }
  .detail-header::before {
    content: '';
    position: absolute; top: -50%; right: -10%;
    width: 300px; height: 300px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    transform: rotate(25deg);
  }
  .detail-header h1 { font-size: 1.8rem; font-weight: 700; margin-bottom: 0.4rem; position: relative; z-index: 1; }
  .detail-header p { margin-bottom: 0; opacity: 0.92; position: relative; z-index: 1; }

  .publish-banner {
    background: white;
    border: 1px solid rgba(30,58,138,0.12);
    border-radius: 1.2rem;
    padding: 1.2rem 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.03);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }
  .publish-banner .status-text { font-weight: 600; color: #1e293b; }
  .publish-banner .status-sub { font-size: 0.85rem; color: #64748b; }
  .badge-on { background: #d1fae5; color: #065f46; }
  .badge-off { background: #f1f5f9; color: #64748b; }
  .badge-toggle {
    padding: 0.3rem 0.8rem; border-radius: 50px; font-weight: 600; font-size: 0.75rem;
    display: inline-flex; align-items: center; gap: 0.3rem;
  }
  .btn-toggle-publish {
    border: none; border-radius: 50px; padding: 0.55rem 1.4rem; font-weight: 600; font-size: 0.85rem;
    color: white; background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    box-shadow: 0 6px 16px rgba(30,58,138,0.25);
  }
  .btn-toggle-publish.off { background: #64748b; box-shadow: none; }

  .modul-card {
    background: white;
    border-radius: 1.2rem;
    border: 1px solid rgba(30,58,138,0.1);
    box-shadow: 0 10px 25px rgba(0,0,0,0.03);
    margin-bottom: 1.2rem;
    overflow: hidden;
  }
  .modul-card.is-active { border-color: rgba(16,185,129,0.35); }
  .modul-header {
    padding: 1.1rem 1.4rem;
    display: flex; flex-wrap: wrap; gap: 0.75rem;
    justify-content: space-between; align-items: center;
    cursor: pointer;
  }
  .modul-header:hover { background: #f8fafc; }
  .modul-num {
    width: 2.4rem; height: 2.4rem; border-radius: 50%;
    background: var(--primary-light); color: var(--primary-start);
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 700; flex-shrink: 0;
  }
  .modul-title { font-weight: 700; color: #1e293b; font-size: 1.02rem; }
  .modul-meta { font-size: 0.8rem; color: #64748b; }
  .modul-body { padding: 0 1.4rem 1.4rem 1.4rem; display: none; border-top: 1px solid #eef1f5; }
  .modul-body.show { display: block; }
  .modul-body h6 { font-weight: 700; color: #1e3a8a; margin: 1rem 0 0.4rem 0; font-size: 0.9rem; display:flex; align-items:center; gap:0.4rem; }
  .modul-body ul { margin-bottom: 0; padding-left: 1.2rem; }
  .modul-body li { margin-bottom: 0.3rem; font-size: 0.92rem; color: #334155; }
  .modul-body p.teori { font-size: 0.92rem; color: #334155; background: #f8fafc; padding: 0.8rem 1rem; border-radius: 0.7rem; border: 1px solid #eef1f5; }
  .k3-box { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; padding: 0.7rem 1rem; border-radius: 0.7rem; font-size: 0.85rem; margin-top: 0.7rem; }

  .form-inline-modul { background: #f8fafc; border-radius: 0.8rem; padding: 1rem; margin-top: 1rem; border: 1px dashed #cbd5e1; }
  .form-inline-modul label { font-size: 0.8rem; font-weight: 600; color: #475569; }
  .form-inline-modul .form-control { font-size: 0.85rem; }

  .switch { position: relative; display: inline-block; width: 46px; height: 26px; flex-shrink: 0; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider { position: absolute; cursor: pointer; inset: 0; background-color: #cbd5e1; transition: .2s; border-radius: 34px; }
  .slider:before { position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px; background-color: white; transition: .2s; border-radius: 50%; }
  input:checked + .slider { background: linear-gradient(135deg, #10b981, #059669); }
  input:checked + .slider:before { transform: translateX(20px); }
  .switch-form { display: inline-flex; align-items: center; gap: 0.5rem; }
  .switch-label { font-size: 0.78rem; font-weight: 600; color: #64748b; }

  .file-chip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    background: var(--primary-light); color: var(--primary-start);
    padding: 0.3rem 0.75rem; border-radius: 50px; font-size: 0.78rem; text-decoration: none; font-weight: 500;
  }
</style>

<div class="container mt-4">
  <div class="detail-header">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
      <div>
        <h1><i class="bi bi-tools me-2"></i>Modul Praktikum</h1>
        <p><%= mk.kode %> - <%= mk.nama %> &middot; <%= jenisLabel %></p>
      </div>
      <a href="/dosen/mk/<%= mk.id %>" class="btn btn-light" style="border-radius:50px; font-weight:600;">
        <i class="bi bi-arrow-left"></i> Kembali
      </a>
    </div>
  </div>

  <%- include('./partials/mk_tabs', { mk, activeTab: 'praktikum' }) %>

  <!-- Info konsep singkat -->
  <div class="alert alert-info" style="border-radius: 1rem;">
    <i class="bi bi-info-circle me-1"></i>
    Ini adalah <strong>konsep awal</strong> modul praktikum (job sheet) yang sudah disiapkan berdasarkan topik umum
    RPS mata kuliah ini. Silakan sesuaikan isinya (unggah job sheet versi Bapak/Ibu sendiri bila perlu), lalu
    <strong>pilih modul mana saja</strong> yang ingin ditampilkan ke mahasiswa di ELK-Learning. Menggunakan modul ini
    sepenuhnya opsional dan sepenuhnya menjadi keputusan dosen pengampu.
  </div>

  <!-- Saklar publikasi keseluruhan -->
  <div class="publish-banner">
    <div>
      <div class="status-text">
        <span class="badge-toggle <%= praktikumPublished ? 'badge-on' : 'badge-off' %>">
          <i class="bi <%= praktikumPublished ? 'bi-eye' : 'bi-eye-slash' %>"></i>
          <%= praktikumPublished ? 'Ditampilkan di ELK-Learning' : 'Belum ditampilkan di ELK-Learning' %>
        </span>
      </div>
      <div class="status-sub mt-1">
        <%= jumlahAktif %> dari <%= modulList.length %> modul sudah diaktifkan untuk mahasiswa.
        <% if (!praktikumPublished) { %>Nyalakan saklar ini agar bagian Modul Praktikum muncul di ELK-Learning mahasiswa.<% } %>
      </div>
    </div>
    <form method="POST" action="/dosen/mk/<%= mk.id %>/praktikum/publish">
      <button type="submit" class="btn-toggle-publish <%= praktikumPublished ? '' : 'off' %>">
        <i class="bi <%= praktikumPublished ? 'bi-toggle-on' : 'bi-toggle-off' %> me-1"></i>
        <%= praktikumPublished ? 'Sembunyikan dari Mahasiswa' : 'Tampilkan ke Mahasiswa' %>
      </button>
    </form>
  </div>

  <!-- Daftar modul -->
  <% modulList.forEach((m, i) => { %>
    <div class="modul-card <%= m.aktif ? 'is-active' : '' %>">
      <div class="modul-header" onclick="toggleBody('<%= m.id %>')">
        <div class="d-flex align-items-center gap-3">
          <span class="modul-num">#<%= i + 1 %></span>
          <div>
            <div class="modul-title"><%= m.judul %></div>
            <div class="modul-meta">
              <i class="bi bi-clock-history"></i> <%= m.estimasiWaktu %>
              &middot; Saran pertemuan ke-<%= m.pertemuanSaran %>
              <% if (m.tanggal) { %> &middot; <i class="bi bi-calendar-check"></i> <%= formatDate(m.tanggal) %><% } %>
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-3" onclick="event.stopPropagation()">
          <% if (m.fileUrl) { %>
            <a href="<%= m.fileUrl %>" target="_blank" class="file-chip"><i class="bi bi-file-earmark-pdf"></i> Job Sheet</a>
          <% } %>
          <form method="POST" action="/dosen/mk/<%= mk.id %>/praktikum/<%= m.id %>/toggle" class="switch-form">
            <span class="switch-label"><%= m.aktif ? 'Aktif' : 'Nonaktif' %></span>
            <label class="switch">
              <input type="checkbox" <%= m.aktif ? 'checked' : '' %> onchange="this.form.submit()">
              <span class="slider"></span>
            </label>
          </form>
          <i class="bi bi-chevron-down" id="chevron-<%= m.id %>"></i>
        </div>
      </div>

      <div class="modul-body" id="body-<%= m.id %>">
        <h6><i class="bi bi-bullseye"></i> Tujuan Praktikum</h6>
        <ul><% m.tujuan.forEach(t => { %><li><%= t %></li><% }) %></ul>

        <h6><i class="bi bi-tools"></i> Alat &amp; Bahan</h6>
        <ul><% m.alatBahan.forEach(a => { %><li><%= a %></li><% }) %></ul>

        <h6><i class="bi bi-book"></i> Dasar Teori</h6>
        <p class="teori"><%= m.dasarTeori %></p>

        <h6><i class="bi bi-list-ol"></i> Langkah Kerja</h6>
        <ol><% m.langkahKerja.forEach(l => { %><li style="margin-bottom:0.3rem; font-size:0.92rem; color:#334155;"><%= l %></li><% }) %></ol>

        <h6><i class="bi bi-journal-check"></i> Tugas / Isi Laporan</h6>
        <ul><% m.tugasLaporan.forEach(t => { %><li><%= t %></li><% }) %></ul>

        <% if (m.k3) { %>
          <div class="k3-box"><i class="bi bi-exclamation-triangle me-1"></i><strong>Keselamatan Kerja:</strong> <%= m.k3 %></div>
        <% } %>

        <% if (m.catatanDosen) { %>
          <div class="mt-3 small text-muted"><i class="bi bi-chat-left-text"></i> <strong>Catatan dosen:</strong> <%= m.catatanDosen %></div>
        <% } %>

        <!-- Form edit catatan/tanggal/upload job sheet -->
        <div class="form-inline-modul">
          <form method="POST" action="/dosen/mk/<%= mk.id %>/praktikum/<%= m.id %>/catatan" enctype="multipart/form-data">
            <div class="row g-2 align-items-end">
              <div class="col-sm-3">
                <label class="form-label mb-1">Tanggal pelaksanaan</label>
                <input type="date" name="tanggal" class="form-control form-control-sm" value="<%= m.tanggal ? m.tanggal.split('T')[0] : '' %>">
              </div>
              <div class="col-sm-5">
                <label class="form-label mb-1">Catatan dosen (opsional)</label>
                <input type="text" name="catatanDosen" class="form-control form-control-sm" value="<%= m.catatanDosen %>" placeholder="Mis. kelas dibagi 2 sesi, dst.">
              </div>
              <div class="col-sm-3">
                <label class="form-label mb-1">Unggah job sheet sendiri (PDF)</label>
                <input type="file" name="file" class="form-control form-control-sm" accept=".pdf,.doc,.docx">
              </div>
              <div class="col-sm-1">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-check-lg"></i></button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<script>
  function toggleBody(id) {
    const body = document.getElementById('body-' + id);
    const chevron = document.getElementById('chevron-' + id);
    const showing = body.classList.toggle('show');
    chevron.className = showing ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
  }
</script>

<%- include('../partials/footer') %>
