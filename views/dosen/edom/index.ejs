<%- include('../../partials/header') %>

<style>
  :root { --primary-start:#1e3a8a; --primary-end:#3b82f6; }
  .page-header{background:linear-gradient(135deg,var(--primary-start),var(--primary-end));border-radius:1.5rem;padding:1.8rem 2rem;color:#fff;margin-bottom:1.5rem;box-shadow:0 10px 25px rgba(0,0,0,.1)}
  .page-header h2{font-weight:800;font-size:1.7rem;margin-bottom:.4rem}
  .page-header p{opacity:.9;margin-bottom:0}
  .kartu{background:#fff;border-radius:1.2rem;padding:1.3rem 1.5rem;margin-bottom:1.3rem;border:1px solid rgba(30,58,138,.1);box-shadow:0 4px 14px rgba(0,0,0,.05)}
  .kartu h5{font-weight:800;color:#1e293b;margin-bottom:1rem}
  .filter{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}
  .filter label{font-weight:700;color:#1e293b;margin:0}
  .filter select{border-radius:60px;min-width:240px;max-width:100%}
  .skor-besar{font-size:3.2rem;font-weight:800;line-height:1}
  .bar{height:.7rem;background:#e2e8f0;border-radius:1rem;overflow:hidden}
  .bar>span{display:block;height:100%;border-radius:1rem}
  .ind-box{border:1px solid #e2e8f0;border-radius:1rem;padding:.9rem 1rem;height:100%}
  .ind-box .nm{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#64748b}
  .ind-box .nl{font-size:1.7rem;font-weight:800}
  .mk-card{display:flex;flex-direction:column;height:100%;background:#fff;border:1px solid rgba(30,58,138,.1);border-radius:1.2rem;padding:1.2rem;box-shadow:0 4px 14px rgba(0,0,0,.05);transition:transform .15s,box-shadow .15s}
  .mk-card:hover{transform:translateY(-3px);box-shadow:0 12px 24px rgba(0,0,0,.1)}
  .mk-kode{font-size:.75rem;font-weight:700;color:#64748b;letter-spacing:.5px}
  .mk-nama{font-weight:800;color:#0f172a;font-size:1.02rem;line-height:1.3;word-break:break-word}
  .mk-skor{font-size:2.1rem;font-weight:800;line-height:1}
  .chip{font-size:.72rem;background:#eff6ff;color:#1d4ed8;border-radius:1rem;padding:.15rem .65rem;font-weight:600;display:inline-block}
  .mini-ind{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.8rem}
  .mini-ind span{font-size:.72rem;border-radius:.5rem;padding:.12rem .5rem;font-weight:600}
  .aksi{margin-top:auto;padding-top:1rem;display:flex;gap:.5rem;flex-wrap:wrap}
  .info-tujuan{background:#f0f9ff;border-left:5px solid var(--primary-start);border-radius:1rem;padding:1rem 1.2rem;margin-bottom:1.3rem;color:#334155;font-size:.92rem}
  .info-tujuan strong{color:#0f172a}
  @media(max-width:768px){.page-header{padding:1.2rem}.page-header h2{font-size:1.35rem}.skor-besar{font-size:2.4rem}.filter select{width:100%}}
</style>

<div class="container mt-4">
  <div class="page-header">
    <h2><i class="bi bi-bar-chart-steps me-2"></i>Hasil Evaluasi Dosen (EDOM)</h2>
    <p>Penilaian mahasiswa terhadap pembelajaran Anda, ditampilkan secara anonim</p>
  </div>

  <div class="kartu">
    <form method="GET" class="filter">
      <label for="periode"><i class="bi bi-calendar-week me-1"></i>Periode Evaluasi</label>
      <select id="periode" name="periode" class="form-select" onchange="this.form.submit()">
        <% if (periods.length === 0) { %><option value="">Belum ada periode</option><% } %>
        <% periods.forEach(p => { %>
          <option value="<%= p.id %>" <%= selectedPeriodId === p.id ? 'selected' : '' %>><%= p.nama %></option>
        <% }) %>
      </select>
      <% if (selectedPeriod) { %>
        <span class="chip ms-md-auto"><i class="bi bi-clock me-1"></i><%= selectedPeriod.tanggalMulai %> s/d <%= selectedPeriod.tanggalSelesai %></span>
      <% } %>
    </form>
  </div>

  <% if (!ringkasan) { %>
    <div class="kartu text-center py-5">
      <i class="bi bi-inbox fs-1 text-muted"></i>
      <h5 class="mt-2 mb-1">Belum ada data evaluasi</h5>
      <p class="text-muted mb-0">Belum ada mahasiswa yang menilai Anda pada periode ini.</p>
    </div>
  <% } else { %>

    <!-- Ringkasan keseluruhan -->
    <div class="kartu">
      <div class="row align-items-center g-3">
        <div class="col-md-4 text-center">
          <div class="skor-besar" style="color:<%= ringkasan.pred.hex %>"><%= ringkasan.rataTeks %></div>
          <div class="text-muted">dari 5,00</div>
          <span class="badge text-bg-<%= ringkasan.pred.warna %> mt-2 fs-6"><%= ringkasan.pred.label %></span>
        </div>
        <div class="col-md-8">
          <div class="bar mb-2"><span style="width:<%= Math.min(100, ringkasan.rata / 5 * 100) %>%;background:<%= ringkasan.pred.hex %>"></span></div>
          <div class="text-muted">Berdasarkan <strong><%= ringkasan.count %></strong> evaluasi pada <strong><%= ringkasan.mk.length %></strong> mata kuliah.</div>
          <% if (ringkasan.count < 5) { %>
            <div class="small text-warning mt-2"><i class="bi bi-exclamation-triangle me-1"></i>Jumlah evaluasi masih sedikit (&lt; 5), nilai belum tentu mewakili seluruh kelas.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Per indikator -->
    <% if (ringkasan.indikator.length > 0) { %>
    <div class="kartu">
      <h5><i class="bi bi-grid-3x3-gap me-2"></i>Nilai per Indikator</h5>
      <div class="row g-3">
        <% ringkasan.indikator.forEach(i => { %>
          <div class="col-6 col-md-3">
            <div class="ind-box">
              <div class="nm"><%= i.nama %></div>
              <div class="nl" style="color:<%= i.pred.hex %>"><%= i.rataTeks %></div>
              <div class="bar mt-1"><span style="width:<%= Math.min(100, i.rata / 5 * 100) %>%;background:<%= i.pred.hex %>"></span></div>
              <div class="small text-muted mt-1"><%= i.pred.label %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Per mata kuliah -->
    <h5 class="fw-bold mb-3" style="color:#1e293b"><i class="bi bi-journal-text me-2"></i>Hasil per Mata Kuliah</h5>
    <div class="row g-3 mb-4">
      <% mkList.forEach(m => { %>
        <div class="col-md-6 col-lg-4">
          <div class="mk-card">
            <div class="mk-kode"><%= m.mkKode || 'MATA KULIAH' %></div>
            <div class="mk-nama mb-3"><%= m.mkNama %></div>
            <div class="d-flex align-items-end justify-content-between">
              <div>
                <span class="mk-skor" style="color:<%= m.pred.hex %>"><%= m.rataTeks %></span>
                <span class="text-muted small"> / 5,00</span>
              </div>
              <span class="badge text-bg-<%= m.pred.warna %>"><%= m.pred.label %></span>
            </div>
            <div class="bar mt-2"><span style="width:<%= Math.min(100, m.rata / 5 * 100) %>%;background:<%= m.pred.hex %>"></span></div>
            <div class="d-flex gap-2 flex-wrap mt-3">
              <span class="chip"><i class="bi bi-people-fill me-1"></i><%= m.count %> responden</span>
              <% if (m.jumlahTeks > 0) { %><span class="chip"><i class="bi bi-chat-dots me-1"></i><%= m.jumlahTeks %> komentar</span><% } %>
            </div>
            <% if (m.indikator.length > 1) { %>
              <div class="mini-ind">
                <% m.indikator.forEach(i => { %>
                  <span style="background:<%= i.pred.bg %>;color:<%= i.pred.fg %>" title="<%= i.nama %>: <%= i.pred.label %>"><%= i.nama.substring(0, 4) %>. <%= i.rataTeks %></span>
                <% }) %>
              </div>
            <% } %>
            <div class="aksi">
              <a href="/dosen/edom/detail?mkId=<%= m.mkId %>&periode=<%= selectedPeriodId %>" class="btn btn-primary btn-sm rounded-pill px-3"><i class="bi bi-graph-up me-1"></i>Detail</a>
              <a href="/dosen/edom/print?mkId=<%= m.mkId %>&periode=<%= selectedPeriodId %>" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-printer me-1"></i>Cetak</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="info-tujuan">
    <strong><i class="bi bi-info-circle-fill me-1"></i>Tujuan EDOM.</strong>
    Evaluasi ini mengukur kinerja dosen dalam pembelajaran (kepribadian, pedagogik, profesional, dan sosial) dan dipakai sebagai bahan perbaikan kualitas pengajaran serta pengembangan profesional dosen.
  </div>
</div>

<%- include('../../partials/footer') %>
