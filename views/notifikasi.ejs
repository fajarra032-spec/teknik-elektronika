<%- include('partials/header') %>

<div class="content-wrapper mt-4 mb-5" style="max-width: 720px;">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h5 class="fw-bold mb-0"><i class="bi bi-bell me-2"></i>Notifikasi</h5>
      <small class="text-muted">Kabar terbaru seputar kuliah dan magangmu.</small>
    </div>
    <div class="d-flex align-items-center gap-2" data-nf-scope>
      <div class="nf-filter" role="group" aria-label="Filter notifikasi">
        <button type="button" class="aktif" data-filter="all">Semua</button>
        <button type="button" data-filter="unread">Belum dibaca</button>
      </div>
      <div class="nf-actions">
        <button type="button" class="nf-btn" data-nf-action="read-all" title="Tandai semua sudah dibaca"><i class="bi bi-check2-all"></i> Tandai dibaca</button>
        <button type="button" class="nf-btn" data-nf-action="clear-all" title="Hapus semua notifikasi"><i class="bi bi-trash3"></i> Bersihkan</button>
      </div>
    </div>
  </div>

  <div class="info-card" style="padding:0; overflow:hidden;">
    <div data-nf-scope>
      <ul class="nf-list nf-page-list" id="nfPageList">
        <% (items || []).forEach(function (n) { %><%- include('partials/notif_item', { n: n, penuh: true }) %><% }); %>
      </ul>
      <div class="nf-empty" id="nfPageEmpty" <%= (items && items.length) ? 'hidden' : '' %>>
        <i class="bi bi-bell-slash"></i>
        <strong>Semua sudah bersih ✨</strong>
        <span>Belum ada kabar baru. Santai dulu ya!</span>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
