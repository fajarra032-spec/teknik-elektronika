<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover">
    <meta name="theme-color" content="#1e3a8a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title><%= typeof title !== 'undefined' && title ? title + ' - Teknik Elektronika Politeknik Dewantara' : 'Teknik Elektronika - Politeknik Dewantara' %></title>
    <!-- Halaman internal (admin/mahasiswa/dosen): jangan diindeks Google -->
    <meta name="robots" content="noindex, nofollow">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js (opsional) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            padding-top: 76px;
            overflow-x: hidden;
        }
        /* Ukuran font dasar sekarang diatur secara fluid oleh partials/design-system.ejs */

        /* Navbar */
        .navbar-custom {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            padding: 0.5rem 1rem;
            transition: all 0.3s ease;
        }
        .navbar-custom.scrolled {
            background: rgba(30, 58, 138, 0.9);
            backdrop-filter: blur(8px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: white !important;
            font-weight: 500;
            transition: color 0.3s, transform 0.2s;
        }
        .navbar-custom .nav-link {
            position: relative;
            margin: 0 0.2rem;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: all 0.3s;
        }
        .navbar-custom .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
            color: #fff !important;
        }
        .navbar-custom .nav-link::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%) scaleX(0);
            width: 70%;
            height: 2px;
            background: white;
            border-radius: 2px;
            transition: transform 0.3s;
        }
        .navbar-custom .nav-link:hover::before {
            transform: translateX(-50%) scaleX(1);
        }
        .navbar-toggler {
            border-color: rgba(255,255,255,0.5);
        }
        .navbar-toggler:hover {
            border-color: white;
            background-color: rgba(255,255,255,0.1);
        }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.8)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .navbar-brand img {
            height: 70px;
            width: auto;
            transition: height 0.3s, transform 0.3s;
        }
        .navbar-brand:hover img {
            transform: scale(1.05);
        }
        .separator {
            color: white;
            font-size: 2.5rem;
            font-weight: 200;
            opacity: 0.7;
            line-height: 1;
            margin: 0 5px;
        }
        .brand-text {
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 1.3;
            color: white;
            text-decoration: none;
        }
        .brand-sub {
            font-size: 0.9rem;
            font-weight: 400;
            opacity: 0.9;
            display: block;
        }

        /* Dropdown menu (profil) */
        .dropdown-menu {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 0.5rem;
            margin-top: 0.5rem;
        }
        .dropdown-item {
            border-radius: 0.7rem;
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .dropdown-item:hover {
            background: linear-gradient(135deg, #2193b0, #6dd5ed);
            color: white;
        }

        /* Responsif untuk layar kecil */
        @media (max-width: 991px) {
            .navbar-collapse {
                background: rgba(30, 58, 138, 0.95);
                backdrop-filter: blur(8px);
                border-radius: 1rem;
                padding: 1rem;
                margin-top: 0.5rem;
                border: 1px solid rgba(255,255,255,0.1);
            }
            .navbar-nav .nav-link {
                margin: 0.2rem 0;
                padding: 0.6rem 1rem;
                text-align: left;
            }
            .dropdown-menu {
                background: transparent;
                box-shadow: none;
                padding-left: 1rem;
                margin-top: 0;
                border-left: 2px solid rgba(255,255,255,0.2);
            }
            .dropdown-item {
                color: white !important;
                padding: 0.5rem 1rem;
            }
            .dropdown-item:hover {
                background: rgba(255,255,255,0.1);
                color: white;
            }
        }
        @media (max-width: 768px) {
            body { padding-top: 66px; }
            .navbar-brand img { height: 50px; }
            .separator { font-size: 2rem; }
            .brand-text { font-size: 1rem; }
            .brand-sub { font-size: 0.7rem; }
            .navbar-nav .nav-link { font-size: 0.95rem; }
        }
        @media (max-width: 576px) {
            body { padding-top: 60px; }
            .navbar-brand { gap: 5px; }
            .navbar-brand img { height: 40px; }
            .separator { font-size: 1.5rem; }
            .brand-text { font-size: 0.85rem; }
            .brand-sub { font-size: 0.65rem; }
            .navbar-nav .nav-link { font-size: 0.9rem; padding: 0.5rem 0.8rem; }
            .container { padding-left: 10px; padding-right: 10px; }
        }
        /* ===== KHUSUS IPHONE (lebar CSS kurang lebih 375px-430px: SE, 12/13/14,
           Plus/Pro Max) - dikecilkan lagi supaya tidak terasa "zoom" kebesaran
           di layar iPhone. Tidak ada urusan dengan notch/safe-area. ===== */
        @media (max-width: 430px) {
            body { padding-top: 56px; }
            .navbar-custom { padding: 0.4rem 0.75rem; }
            .navbar-brand { gap: 4px; }
            .navbar-brand img { height: 32px; }
            .separator { font-size: 1.3rem; margin: 0 4px; }
            .brand-text { font-size: 0.78rem; }
            .brand-sub { font-size: 0.6rem; }
            .navbar-nav .nav-link { font-size: 0.85rem; padding: 0.45rem 0.7rem; }
        }
        @media (max-width: 390px) {
            .navbar-brand img { height: 30px; }
            .brand-text { font-size: 0.75rem; }
            .brand-sub { font-size: 0.58rem; }
        }
        @media (max-width: 340px) {
            .navbar-brand img { height: 26px; }
            .separator { font-size: 1.1rem; margin: 0 2px; }
            .brand-text { font-size: 0.68rem; }
            .brand-sub { font-size: 0.5rem; }
            .navbar-brand { gap: 3px; }
        }
        @media (max-height: 500px) and (orientation: landscape) {
            body { padding-top: 56px; }
            .navbar-brand img { height: 35px; }
            .brand-text { font-size: 0.8rem; }
        }

        /* Badge notifikasi & pesan (lonceng / gelembung chat di navbar) */
        .navbar-icon-link {
            position: relative;
            font-size: 1.15rem;
        }
        .navbar-icon-badge {
            position: absolute;
            top: 0.1rem;
            right: 0.1rem;
            font-size: 0.6rem;
            padding: 0.2em 0.4em;
            transform: translate(40%, -40%);
        }
        .navbar-dropdown-panel {
            width: 320px;
            max-width: 90vw;
            max-height: 70vh;
            overflow-y: auto;
            padding: 0;
        }
        .navbar-dropdown-panel .dropdown-item {
            white-space: normal;
        }
        @media (max-width: 991px) {
            /* Di layar kecil dropdown navbar Bootstrap sudah full width di
               dalam .navbar-collapse yang transparan/gelap - panel notifikasi
               dipaksa terang supaya tetap terbaca (beda konteks dgn menu biasa). */
            .navbar-dropdown-panel {
                width: 100%;
                background: #fff;
                border-radius: 0.75rem;
            }
            .navbar-dropdown-panel .dropdown-item,
            .navbar-dropdown-panel .dropdown-item-text,
            .navbar-dropdown-panel span {
                color: #0f172a !important;
            }
        }

        /* Pembungkus konten */
        .content-wrapper {
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 1rem;
            padding-right: 1rem;
            width: 100%;
        }
    </style>
    <%- include('design-system') %>
</head>
<body>
    <!-- Navbar Fixed -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top" id="mainNavbar">
        <div class="container">
            <%
                let dashboardLink = '/';
                if (typeof user !== 'undefined' && user) {
                    if (user.role === 'mahasiswa') {
                        dashboardLink = '/mahasiswa/dashboard';
                    } else if (user.role === 'dosen') {
                        dashboardLink = '/dosen/dashboard';
                    } else if (user.role === 'admin') {
                        dashboardLink = '/admin/dashboard';
                    }
                }
            %>
            <a class="navbar-brand" href="<%= dashboardLink %>">
                <img src="https://polidewa.ac.id/wp-content/uploads/2025/11/Desain-tanpa-judul-1.png" alt="Logo Politeknik Dewantara">
                <span class="separator">|</span>
                <span class="brand-text">
                    TEKNIK ELEKTRONIKA
                    <span class="brand-sub">by Politeknik Dewantara</span>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <!-- Menu umum: Cek Data -->
                    <li class="nav-item">
                        <a class="nav-link" href="/cekmahasiswa"><i class="bi bi-search me-1"></i>Cek Data</a>
                    </li>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <% if (user.role === 'mahasiswa') { %>
                            <li class="nav-item"><a class="nav-link" href="/mahasiswa/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" href="/mahasiswa/akademik"><i class="bi bi-journal-bookmark-fill me-1"></i>Akademik</a></li>
                            <li class="nav-item"><a class="nav-link" href="/mahasiswa/elearning"><i class="bi bi-laptop me-1"></i>ELearning</a></li>
                            <li class="nav-item"><a class="nav-link" href="/mahasiswa/magang"><i class="bi bi-briefcase me-1"></i>EMagang</a></li>
                        <% } else if (user.role === 'dosen') { %>
                            <li class="nav-item"><a class="nav-link" href="/dosen/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" href="/dosen/mk"><i class="bi bi-book me-1"></i>MK</a></li>
                            <li class="nav-item"><a class="nav-link" href="/dosen/mahasiswa"><i class="bi bi-people me-1"></i>Mahasiswa</a></li>
                        <% } else if (user.role === 'admin') { %>
                            <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" href="/admin/users"><i class="bi bi-people me-1"></i>Pengguna</a></li>
                            <li class="nav-item"><a class="nav-link" href="/admin/mahasiswa"><i class="bi bi-mortarboard me-1"></i>Mahasiswa</a></li>
                            <li class="nav-item"><a class="nav-link" href="/admin/dosen"><i class="bi bi-person-badge me-1"></i>Dosen</a></li>
                            <li class="nav-item"><a class="nav-link" href="/admin/matakuliah"><i class="bi bi-book me-1"></i>MK</a></li>
                        <% } %>
                        <%
                            // Shortcut "Chat Kelas" tergantung role - kelas chat itu per mata
                            // kuliah (perlu pilih MK dulu), jadi diarahkan ke halaman daftar MK
                            // masing-masing, bukan langsung ke satu obrolan.
                            let kelasChatLink = null;
                            if (user.role === 'mahasiswa') kelasChatLink = '/mahasiswa/elearning';
                            else if (user.role === 'dosen') kelasChatLink = '/dosen/mk';
                        %>
                        <!-- Notifikasi -->
                        <li class="nav-item dropdown">
                            <a class="nav-link navbar-icon-link" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifikasi">
                                <i class="bi bi-bell"></i>
                                <% if (typeof navNotifikasi !== 'undefined' && navNotifikasi.unreadCount > 0) { %>
                                    <span class="badge bg-danger rounded-pill navbar-icon-badge"><%= navNotifikasi.unreadCount > 9 ? '9+' : navNotifikasi.unreadCount %></span>
                                <% } %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end navbar-dropdown-panel" aria-labelledby="notifDropdown">
                                <li class="px-3 py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small text-dark">Notifikasi</span>
                                    <a href="/notifikasi" class="small">Lihat semua</a>
                                </li>
                                <li><hr class="dropdown-divider m-0"></li>
                                <% if (typeof navNotifikasi === 'undefined' || !navNotifikasi.items || navNotifikasi.items.length === 0) { %>
                                    <li><span class="dropdown-item-text text-muted small">Belum ada notifikasi.</span></li>
                                <% } else { %>
                                    <% navNotifikasi.items.forEach(function(n) { %>
                                        <li>
                                            <form method="POST" action="/notifikasi/<%= n.id %>/baca" class="m-0">
                                                <input type="hidden" name="link" value="<%= n.link || '/notifikasi' %>">
                                                <button type="submit" class="dropdown-item <%= !n.read ? 'fw-semibold' : '' %>">
                                                    <span class="d-block small"><%= n.title %></span>
                                                    <span class="d-block text-muted" style="font-size:0.75rem;"><%= new Date(n.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %></span>
                                                </button>
                                            </form>
                                        </li>
                                    <% }); %>
                                <% } %>
                            </ul>
                        </li>
                        <!-- Pesan (Messenger) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link navbar-icon-link" href="#" id="pesanDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Pesan">
                                <i class="bi bi-chat-dots"></i>
                                <% if (typeof navPesan !== 'undefined' && navPesan.unreadCount > 0) { %>
                                    <span class="badge bg-danger rounded-pill navbar-icon-badge"><%= navPesan.unreadCount > 9 ? '9+' : navPesan.unreadCount %></span>
                                <% } %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end navbar-dropdown-panel" aria-labelledby="pesanDropdown">
                                <li class="px-3 py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small text-dark">Pesan</span>
                                    <a href="/pesan" class="small">Lihat semua</a>
                                </li>
                                <li><hr class="dropdown-divider m-0"></li>
                                <% if (typeof navPesan === 'undefined' || !navPesan.items || navPesan.items.length === 0) { %>
                                    <li><span class="dropdown-item-text text-muted small">Belum ada pesan.</span></li>
                                <% } else { %>
                                    <% navPesan.items.forEach(function(c) { %>
                                        <li>
                                            <a class="dropdown-item <%= c.unreadCount > 0 ? 'fw-semibold' : '' %>" href="/pesan/<%= c.partnerId %>">
                                                <span class="d-block small"><%= c.partnerNama %></span>
                                                <span class="d-block text-muted text-truncate" style="font-size:0.75rem; max-width: 260px;"><%= c.lastMessage.message %></span>
                                            </a>
                                        </li>
                                    <% }); %>
                                <% } %>
                                <% if (kelasChatLink) { %>
                                    <li><hr class="dropdown-divider m-0"></li>
                                    <li><a class="dropdown-item small" href="<%= kelasChatLink %>"><i class="bi bi-people me-1"></i>Chat Kelas</a></li>
                                <% } %>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> <%= user.nama || user.email %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                <li><a class="dropdown-item" href="<%= user.role === 'mahasiswa' ? '/mahasiswa/biodata' : (user.role === 'dosen' ? '/dosen/biodata' : '/admin/biodata') %>"><i class="bi bi-person me-2"></i>Profil</a></li>
                                <% if (user.role === 'dosen') { %>
                                    <li><a class="dropdown-item" href="/dosen/akreditasi"><i class="bi bi-patch-check me-2"></i>Akreditasi</a></li>
                                <% } else if (user.role === 'admin') { %>
                                    <li><a class="dropdown-item" href="/admin/akreditasi"><i class="bi bi-patch-check me-2"></i>Akreditasi</a></li>
                                <% } %>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link" href="/auth/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Bootstrap JS dimuat sekali saja di partials/footer.ejs (akhir <body>).
         JANGAN tambahkan <script bootstrap.bundle.min.js> di sini lagi -
         sebelumnya sempat dimuat dobel (di sini & di footer) dan itu
         menyebabkan komponen dropdown Bootstrap (mis. dropdown "Buat/Kirim
         Surat" di admin) ter-inisialisasi 2x sehingga tabrakan / tidak
         merespons klik dengan benar. -->
    <script>
        // Smooth scroll untuk anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        // Efek scroll untuk navbar
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('mainNavbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>
</body>
</html>