<%# Banner mahasiswa: belum mengisi logbook hari ini (data dari res.locals.navMhsLogbook) %>
<% if (typeof navMhsLogbook !== 'undefined' && navMhsLogbook && navMhsLogbook.perluDiisi) { %>
  <style>
    .notif-logbook { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem 1rem; background:linear-gradient(135deg,#fff7ed,#ffedd5); border:1px solid #fdba74; border-left:6px solid #f97316; border-radius:1rem; padding:.85rem 1.1rem; margin-bottom:1rem; box-shadow:0 6px 16px rgba(249,115,22,.12); }
    .notif-logbook .ikon { font-size:1.6rem; color:#ea580c; line-height:1; }
    .notif-logbook .teks { flex:1 1 240px; min-width:0; color:#7c2d12; }
    .notif-logbook .teks strong { display:block; font-size:1rem; }
    .notif-logbook .teks span { font-size:.85rem; opacity:.9; }
    .notif-logbook a.btn-isi { background:#ea580c; color:#fff; font-weight:700; border-radius:50px; padding:.45rem 1.2rem; text-decoration:none; font-size:.88rem; white-space:nowrap; }
    .notif-logbook a.btn-isi:hover { background:#c2410c; }
  </style>
  <div class="notif-logbook" role="alert">
    <i class="bi bi-exclamation-triangle-fill ikon"></i>
    <div class="teks">
      <strong>Anda belum mengisi logbook hari ini</strong>
      <span><%= navMhsLogbook.tanggalPanjang %> &middot; isi kegiatan magang hari ini supaya progres dan persetujuan dosen tidak tertunda.</span>
    </div>
    <a class="btn-isi" href="<%= navMhsLogbook.link %>"><i class="bi bi-pencil-square me-1"></i> Isi logbook sekarang</a>
  </div>
<% } %>
