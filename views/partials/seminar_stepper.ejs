<%
  var _s = status, _steps, _aktif = 0, _gagal, _selesai = false;
  if (_s === 'rejected')        { _steps = ['Diajukan', 'Ditolak admin']; _gagal = 1; }
  else if (_s === 'dibatalkan') { _steps = ['Diajukan', 'Dibatalkan mahasiswa']; _gagal = 1; }
  else {
    _steps = ['Diajukan', 'Verifikasi admin', 'Jadwal ditetapkan'];
    if (_s === 'approved') _selesai = true; else _aktif = 1;
  }
%><%- include('lab_stepper', { steps: _steps, aktif: _aktif, selesai: _selesai, gagal: _gagal }) %>
