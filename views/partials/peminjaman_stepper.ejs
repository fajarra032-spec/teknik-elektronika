<%
  var _st = status, _steps, _aktif = 0, _gagal, _selesai = false;
  if (_st === 'ditolak')        { _steps = ['Diajukan', 'Ditolak admin']; _gagal = 1; }
  else if (_st === 'dibatalkan') { _steps = ['Diajukan', 'Dibatalkan']; _gagal = 1; }
  else {
    _steps = ['Diajukan', 'Disetujui & dipinjam', 'Pengembalian diajukan', 'Terverifikasi'];
    if (_st === 'diajukan') _aktif = 0;
    else if (_st === 'dipinjam') _aktif = 1;
    else if (_st === 'menunggu_verifikasi_kembali') _aktif = 2;
    else if (_st === 'dikembalikan') _selesai = true;
  }
%><%- include('lab_stepper', { steps: _steps, aktif: _aktif, selesai: _selesai, gagal: _gagal }) %>
