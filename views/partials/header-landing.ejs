<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= typeof title !== 'undefined' && title ? title + ' - Teknik Elektronika Politeknik Dewantara' : 'Teknik Elektronika - Politeknik Dewantara' %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : 'Program Studi Teknik Elektronika Politeknik Dewantara - informasi akademik, berita, dan kegiatan kampus.' %>">
    <!-- Open Graph (pratinjau saat dibagikan ke WhatsApp/Facebook/dll) -->
    <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : 'Teknik Elektronika - Politeknik Dewantara' %>">
    <meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : 'Program Studi Teknik Elektronika Politeknik Dewantara' %>">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
    <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
    <% } %>
    <link rel="icon" type="image/png" href="https://polidewa.ac.id/wp-content/uploads/2025/11/Desain-tanpa-judul-1.png">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            padding-top: 76px;
        }

        /* Navbar dengan gradien */
        .navbar-custom {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            padding: 0.5rem 1rem;
            transition: all 0.3s ease;
        }

        .navbar-custom.scrolled {
            background: rgba(30, 58, 138, 0.9);
            backdrop-filter: blur(8px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }

        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: white !important;
            font-weight: 500;
            transition: color 0.3s, transform 0.2s;
        }

        .navbar-custom .nav-link {
            position: relative;
            margin: 0 0.2rem;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            transition: all 0.3s;
        }

        .navbar-custom .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
            color: #fff !important;
        }

        .navbar-custom .nav-link::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%) scaleX(0);
            width: 70%;
            height: 2px;
            background: white;
            border-radius: 2px;
            transition: transform 0.3s;
        }

        .navbar-custom .nav-link:hover::before {
            transform: translateX(-50%) scaleX(1);
        }

        .navbar-toggler {
            border-color: rgba(255,255,255,0.5);
            transition: all 0.3s;
        }

        .navbar-toggler:hover {
            border-color: white;
            background-color: rgba(255,255,255,0.1);
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.8)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .navbar-brand img {
            height: 70px;
            width: auto;
            transition: height 0.3s, transform 0.3s;
        }

        .navbar-brand:hover img {
            transform: scale(1.05);
        }

        .separator {
            color: white;
            font-size: 2.5rem;
            font-weight: 200;
            opacity: 0.7;
            line-height: 1;
            margin: 0 5px;
            transition: opacity 0.3s;
        }

        .brand-text {
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 1.3;
            color: white;
            text-decoration: none;
        }

        .brand-sub {
            font-size: 0.9rem;
            font-weight: 400;
            opacity: 0.9;
            display: block;
        }

        /* Responsif untuk layar kecil */
        @media (max-width: 768px) {
            body { padding-top: 66px; }
            .navbar-brand img { height: 50px; }
            .separator { font-size: 2rem; }
            .brand-text { font-size: 1rem; }
            .brand-sub { font-size: 0.7rem; }
        }

        @media (max-width: 576px) {
            body { padding-top: 60px; }
            .navbar-brand { gap: 5px; }
            .navbar-brand img { height: 40px; }
            .separator { font-size: 1.5rem; }
            .brand-text { font-size: 0.85rem; }
            .brand-sub { font-size: 0.7rem; }
        }

        /* Tambahan untuk tablet: menu lebih rapat */
        @media (max-width: 991px) {
            .navbar-nav {
                margin-top: 1rem;
            }
            .navbar-nav .nav-item {
                margin: 0.2rem 0;
            }
        }

        /* Dropdown menu navbar */
        .navbar-custom .dropdown-menu {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            padding: 0.5rem;
            margin-top: 0.6rem;
        }

        .navbar-custom .dropdown-item {
            border-radius: 0.6rem;
            padding: 0.6rem 1rem;
            font-weight: 500;
            color: #1e293b;
            transition: all 0.2s;
        }

        .navbar-custom .dropdown-item:hover,
        .navbar-custom .dropdown-item:focus {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            color: #fff;
        }

        .navbar-custom .nav-item.dropdown .nav-link::after {
            vertical-align: 0.15em;
        }

        @media (max-width: 991px) {
            .navbar-custom .dropdown-menu {
                background: rgba(255,255,255,0.97);
            }
        }

        /* Pembungkus konten */
        .content-wrapper {
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 1rem;
            padding-right: 1rem;
            width: 100%;
        }
    </style>
    <%- include('design-system') %>
</head>
<body>
<!-- Navbar Fixed -->
<nav class="navbar navbar-expand-lg navbar-custom fixed-top" id="mainNavbar">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img src="https://polidewa.ac.id/wp-content/uploads/2025/11/Desain-tanpa-judul-1.png" alt="Logo Politeknik Dewantara">
            <span class="separator">|</span>
            <span class="brand-text">
                TEKNIK ELEKTRONIKA
                <span class="brand-sub">by Politeknik Dewantara</span>
            </span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#berita"><i class="bi bi-newspaper me-1"></i>Berita</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/elk-library"><i class="bi bi-book me-1"></i>ELK-Library</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#seminar"><i class="bi bi-calendar-event me-1"></i>Seminar</a>
                </li>

                <!-- Dropdown gabungan: Dokumen, Pengajuan, Kerjasama -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="layananDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-grid-fill me-1"></i>Layanan
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="layananDropdown">
                        <li><h6 class="dropdown-header"><i class="bi bi-file-earmark-text me-1"></i>Dokumen</h6></li>
                        <li><a class="dropdown-item" href="/dokumen/kurikulum"><i class="bi bi-journal-bookmark-fill me-2"></i>Kurikulum</a></li>
                        <li><a class="dropdown-item" href="/dokumen/rps"><i class="bi bi-file-earmark-ruled-fill me-2"></i>RPS (Rencana Pembelajaran Semester)</a></li>
                        <li><a class="dropdown-item" href="/dokumen/kontrak-kuliah"><i class="bi bi-file-earmark-check-fill me-2"></i>Kontrak Kuliah</a></li>
                        <li><a class="dropdown-item" href="/dokumen/sop-pelaporan-nilai"><i class="bi bi-clipboard-check-fill me-2"></i>SOP Pelaporan Nilai</a></li>
                        <li><a class="dropdown-item" href="/dokumen/notulensi"><i class="bi bi-journal-richtext me-2"></i>Agenda &amp; Hasil Rapat</a></li>

                        <li><hr class="dropdown-divider"></li>

                        <li><h6 class="dropdown-header"><i class="bi bi-send-check-fill me-1"></i>Pengajuan</h6></li>
                        <li><a class="dropdown-item" href="/dokumen/pengajuan-seminar"><i class="bi bi-easel2-fill me-2"></i>Pengajuan Seminar</a></li>
                        <li><a class="dropdown-item" href="/dokumen/pengajuan-magang"><i class="bi bi-briefcase-fill me-2"></i>Pengajuan Magang</a></li>
                        <li><a class="dropdown-item" href="/dokumen/pengajuan-cuti"><i class="bi bi-calendar-x-fill me-2"></i>Pengajuan Cuti</a></li>
                        <li><a class="dropdown-item" href="/dokumen/kunjungan-industri"><i class="bi bi-building-fill-gear me-2"></i>Kunjungan Industri</a></li>

                        <li><hr class="dropdown-divider"></li>

                        <li><a class="dropdown-item" href="/dokumen/kerjasama-perusahaan"><i class="bi bi-building-check me-2"></i>Kerjasama Perusahaan</a></li>
                    </ul>
                </li>

                <!-- Tautan langsung Cek Data (tanpa dropdown) -->
                <li class="nav-item">
                    <a class="nav-link" href="/cekmahasiswa"><i class="bi bi-search me-1"></i>Cek Data</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/auth/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/panduan"><i class="bi bi-question-circle me-1"></i>Panduan SI ELK</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Konten Utama dengan pembungkus -->
<!-- PENTING: div ini SENGAJA tidak ditutup di sini - baru ditutup di
     partials/footer-landing.ejs (baris pertama). Semua konten halaman yang
     disisipkan di antara include('header-landing') dan include('footer-landing')
     otomatis berada di dalam wrapper ini (max-width 1200px + padding kiri-kanan). -->
<div class="content-wrapper">