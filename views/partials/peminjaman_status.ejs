<%
  var _kelas = { diajukan: 'wait', ditolak: 'bad', dibatalkan: 'mute', dipinjam: 'run', menunggu_verifikasi_kembali: 'info', dikembalikan: 'ok' };
  var _label = (typeof statusLabel !== 'undefined' && statusLabel && statusLabel[status]) ? statusLabel[status] : status;
%><span class="pill <%= _kelas[status] || 'mute' %>"><%= _label %></span><% if (typeof terlambat !== 'undefined' && terlambat) { %> <span class="pill bad">Terlambat</span><% } %>
