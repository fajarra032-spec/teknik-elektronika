<%
  /*
   * partials/lkm_khusus.ejs
   * Menampilkan bagian tambahan OPSIONAL dari modul praktikum yang sifatnya
   * khusus (lihat data/modulPraktikumData.js):
   *   - tabelReferensi   : tabel rangkaian / pola / daftar perintah
   *   - program          : listing program contoh
   *   - pemecahanMasalah : gejala - penyebab - solusi
   * Modul yang tidak punya field tersebut tidak menampilkan apa-apa.
   * Pemakaian: include partial ini dengan parameter objek { m } (modul yang sedang di-loop).
   */
%>
<% if (m.tabelReferensi && m.tabelReferensi.length) { %>
  <h6 class="mt-3"><i class="bi bi-diagram-3"></i> Rangkaian dan Tabel Referensi</h6>
  <% m.tabelReferensi.forEach(t => { %>
    <div class="fw-semibold small mb-1 mt-2"><%= t.judul %></div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered small text-center align-middle mb-2" style="max-width: 720px;">
        <thead class="table-light"><tr><% t.kolom.forEach(k => { %><th><%= k %></th><% }) %></tr></thead>
        <tbody>
          <% t.baris.forEach(r => { %><tr><% r.forEach(c => { %><td><%= c %></td><% }) %></tr><% }) %>
        </tbody>
      </table>
    </div>
  <% }) %>
<% } %>

<% if (m.program && m.program.length) { %>
  <h6 class="mt-3"><i class="bi bi-code-slash"></i> Program Contoh</h6>
  <% m.program.forEach(p => { %>
    <div class="fw-semibold small mb-1 mt-2"><%= p.judul %></div>
    <pre style="background:#f1f5f9; border:1px solid #e2e8f0; border-radius:0.5rem; padding:0.7rem 0.9rem; font-size:0.78rem; line-height:1.45; overflow-x:auto; white-space:pre; margin-bottom:0.6rem;"><code><%= p.kode %></code></pre>
  <% }) %>
<% } %>

<% if (m.pemecahanMasalah && m.pemecahanMasalah.length) { %>
  <h6 class="mt-3"><i class="bi bi-wrench-adjustable"></i> Panduan Pemecahan Masalah</h6>
  <div class="table-responsive">
    <table class="table table-sm table-bordered small align-middle mb-2">
      <thead class="table-light"><tr><th>Gejala</th><th>Kemungkinan penyebab</th><th>Solusi</th></tr></thead>
      <tbody>
        <% m.pemecahanMasalah.forEach(p => { %>
          <tr><td><%= p.gejala %></td><td><%= p.penyebab %></td><td><%= p.solusi %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
