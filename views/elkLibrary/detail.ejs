<%- include('../partials/header-landing') %>

<style>
  /* ===== VARIABEL DARI LANDING + GAYA ASLI ===== */
  :root {
    /* Tambahan dari landing */
    --primary: #0d6efd;
    --primary-dark: #0b5ed7;
    --secondary: #0dcaf0;
    --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    --shadow-sm: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
    --shadow-hover: 0 1rem 2rem rgba(13, 110, 253, 0.12);
    --transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    
    /* Variabel asli */
    --primary-blue: #1e3a8a;
    --accent-blue: #3b82f6;
    --soft-bg: #f8fafc;
    --text-slate: #1e293b;
    --text-muted: #64748b;
  }

  /* ===== BASE FLUID FONT (SAMA PERSIS DENGAN LANDING) ===== */
  html {
    font-size: clamp(14px, 1vw + 10px, 16px);
  }

  body {
    background-color: var(--soft-bg);
    color: var(--text-slate);
    font-family: var(--font-sans);
  }

  /* ===== GAYA ASLI (DIADAPTASI DENGAN CLAMP) ===== */
  .breadcrumb-nav {
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  .detail-hero {
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    border-radius: 1.5rem;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 4vw, 2rem);
    color: white;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(30, 58, 138, 0.2);
  }

  .detail-hero h1 {
    font-weight: 800;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    max-width: 900px;
  }

  .meta-badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 2vw, 1rem);
  }

  .meta-badge {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(5px);
    padding: clamp(0.35rem, 1.5vw, 0.5rem) clamp(0.8rem, 2vw, 1rem);
    border-radius: 0.75rem;
    font-size: clamp(0.75rem, 2vw, 0.9rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .main-card {
    background: white;
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition: var(--transition);
  }
  .main-card:hover {
    box-shadow: var(--shadow-hover);
  }

  .section-title {
    font-weight: 700;
    font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    color: var(--primary-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e2e8f0;
  }

  .abstract-text {
    line-height: 1.8;
    color: #334155;
    font-size: clamp(0.9rem, 2.5vw, 1.05rem);
    text-align: justify;
  }

  .sidebar-card {
    background: white;
    border-radius: 1.25rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid #e2e8f0;
    margin-bottom: 1.5rem;
    transition: var(--transition);
  }
  .sidebar-card:hover {
    box-shadow: var(--shadow-sm);
  }

  .keyword-pill {
    display: inline-block;
    background: #eff6ff;
    color: #1e40af;
    padding: clamp(0.25rem, 1.5vw, 0.35rem) clamp(0.6rem, 2vw, 0.85rem);
    border-radius: 2rem;
    font-size: clamp(0.7rem, 2vw, 0.85rem);
    font-weight: 600;
    margin: 0.25rem;
    border: 1px solid #dbeafe;
    transition: var(--transition);
  }
  .keyword-pill:hover {
    background: #dbeafe;
    transform: translateY(-2px);
  }

  .btn-download-full {
    background: #10b981;
    color: white;
    width: 100%;
    padding: clamp(0.8rem, 2.5vw, 1rem);
    border-radius: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: var(--transition);
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    font-size: clamp(0.85rem, 2vw, 1rem);
  }

  .btn-download-full:hover {
    background: #059669;
    transform: translateY(-2px);
    color: white;
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
  }

  .btn-back-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    margin-top: 2rem;
    transition: var(--transition);
    font-size: clamp(0.8rem, 2vw, 0.9rem);
  }

  .btn-back-outline:hover { 
    color: var(--primary-blue);
    transform: translateX(-4px);
  }

  /* ===== MEDIA QUERY LENGKAP (SESUAI LANDING) ===== */
  @media (max-width: 768px) {
    .detail-hero h1 {
      font-size: 1.5rem;
    }
    .main-card {
      padding: 1.5rem;
    }
  }

  @media (max-width: 576px) {
    .detail-hero h1 {
      font-size: 1.3rem;
    }
    .meta-badge {
      font-size: 0.75rem;
    }
    .section-title {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 400px) {
    .detail-hero {
      padding: 1.5rem 1rem;
    }
    .detail-hero h1 {
      font-size: 1.1rem;
    }
    .meta-badge-group {
      gap: 0.5rem;
    }
    .meta-badge {
      font-size: 0.7rem;
      padding: 0.25rem 0.6rem;
    }
    .abstract-text {
      font-size: 0.85rem;
    }
  }
</style>

<div class="container mt-4 mb-5">
  <!-- Structured data (JSON-LD) supaya Google mengenali dokumen ini dengan
       tipe yang tepat (laporan magang mahasiswa = Thesis, penelitian dosen =
       ScholarlyArticle, dst) - membantu proses crawling & indexing -->
  <%
    const schemaTypeMap = { laporan: 'Thesis', artikel: 'Article', penelitian: 'ScholarlyArticle', pengabdian: 'CreativeWork', buku: 'Book' };
    const schemaJudul = item.judulPublik || item.title || item.judul || '(Judul tidak tersedia)';
    const schemaPenulis = item.nama || item.penulis || item.dosenNama || 'Anonim';
    const schemaAbstrakPolos = (item.abstrak || item.abstract || item.deskripsi || '').replace(/<[^>]*>?/gm, '').trim();
    const schemaTanggal = item.approvedAt || item.createdAt || item.uploadedAt || '';
  %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": <%- JSON.stringify(schemaTypeMap[item._type] || 'CreativeWork') %>,
    "name": <%- JSON.stringify(schemaJudul) %>,
    "headline": <%- JSON.stringify(schemaJudul) %>,
    "abstract": <%- JSON.stringify(schemaAbstrakPolos) %>,
    "author": {
      "@type": "Person",
      "name": <%- JSON.stringify(schemaPenulis) %>
    },
    <% if (item.pembimbing) { %>
    "creator": {
      "@type": "Person",
      "name": <%- JSON.stringify(item.pembimbing) %>
    },
    <% } %>
    <% if (item.tahun) { %>
    "datePublished": <%- JSON.stringify(String(item.tahun)) %>,
    <% } else if (schemaTanggal) { %>
    "datePublished": <%- JSON.stringify(schemaTanggal) %>,
    <% } %>
    "publisher": {
      "@type": "CollegeOrUniversity",
      "name": "Politeknik Dewantara"
    },
    "isAccessibleForFree": true,
    "inLanguage": "id"
  }
  </script>

  <!-- Breadcrumb -->
  <nav class="breadcrumb-nav">
    <a href="/" class="text-decoration-none text-muted">Home</a> / 
    <a href="/elk-library" class="text-decoration-none text-muted">Library</a> / 
    <span class="text-dark fw-semibold">Detail Karya</span>
  </nav>

  <!-- Hero Header -->
  <header class="detail-hero">
    <% 
      const judul = item.judulPublik || item.title || item.judul || '(Judul tidak tersedia)';
      const penulis = item.nama || item.penulis || item.dosenNama || 'Anonim';
    %>
    <h1><%= judul %></h1>
    
    <div class="meta-badge-group">
      <div class="meta-badge">
        <i class="bi bi-person-circle"></i> <%= penulis %>
      </div>
      <% if (item.tahun) { %>
      <div class="meta-badge">
        <i class="bi bi-calendar-check"></i> <%= item.tahun %>
      </div>
      <% } %>
      <div class="meta-badge">
        <i class="bi bi-file-earmark-lock2"></i> Open Access
      </div>
    </div>
  </header>

  <div class="row">
    <!-- Main Content: Abstract -->
    <div class="col-lg-8">
      <article class="main-card">
        <h5 class="section-title">
          <i class="bi bi-text-paragraph"></i> Abstrak
        </h5>
        <div class="abstract-text">
          <%= item.abstrak || item.abstract || item.deskripsi || 'Deskripsi tidak tersedia untuk dokumen ini.' %>
        </div>

        <hr class="my-5 opacity-50">

        <% if (item.kataKunci) { %>
        <h5 class="section-title">
          <i class="bi bi-tags"></i> Kata Kunci
        </h5>
        <div class="ms-n1">
          <% item.kataKunci.forEach(function(key) { %>
            <span class="keyword-pill"><%= key %></span>
          <% }); %>
        </div>
        <% } %>
      </article>
      
      <a href="/elk-library" class="btn-back-outline">
        <i class="bi bi-arrow-left"></i> Kembali ke Katalog Perpustakaan
      </a>
    </div>

    <!-- Sidebar: Metadata & Download -->
    <div class="col-lg-4">
      <!-- Download Box -->
      <% if (item.fileUrl) { %>
      <div class="sidebar-card border-success bg-light bg-opacity-10">
        <h6 class="fw-bold mb-3">Dokumen Lengkap</h6>
        <a href="<%= item.fileUrl %>" target="_blank" class="btn-download-full">
          <i class="bi bi-file-earmark-pdf fs-4"></i> Lihat PDF Lengkap
        </a>
        <p class="text-muted small text-center mt-3 mb-0">
          <i class="bi bi-info-circle me-1"></i> Klik untuk membuka file di tab baru
        </p>
      </div>
      <% } %>

      <!-- Author/Supervisor Box -->
      <div class="sidebar-card">
        <h6 class="fw-bold mb-3 border-bottom pb-2">Informasi Kontributor</h6>
        
        <div class="mb-3">
          <label class="text-muted small d-block">Penulis Utama</label>
          <span class="fw-semibold"><%= penulis %></span>
        </div>

        <% if (item.pembimbing) { %>
        <div class="mb-0">
          <label class="text-muted small d-block">Dosen Pembimbing</label>
          <span class="fw-semibold"><i class="bi bi-mortarboard me-1"></i> <%= item.pembimbing %></span>
        </div>
        <% } %>
      </div>

      <!-- Type/Category Box -->
      <div class="sidebar-card">
        <h6 class="fw-bold mb-3 border-bottom pb-2">Detail Publikasi</h6>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted small">Tipe Dokumen</span>
          <% const tipeLabelMap = { laporan: 'Laporan Magang', artikel: 'Artikel Ilmiah', penelitian: 'Penelitian', pengabdian: 'Pengabdian', buku: 'Buku' }; %>
          <span class="badge bg-primary rounded-pill small"><%= tipeLabelMap[item._type] || 'Artikel Ilmiah' %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted small">ID Arsip</span>
          <span class="text-dark fw-medium small">#<%= (item.id || '').substring(0,8).toUpperCase() %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer-landing') %>