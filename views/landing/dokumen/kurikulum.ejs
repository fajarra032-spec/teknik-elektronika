  <!-- ===== CPL ===== -->
  <div class="section-wrapper">
    <h2 class="section-title">Capaian Pembelajaran <span>Lulusan</span></h2>
    <ul class="cpl-list">
      <% cpl.forEach(function(item){ %>
        <li><strong><%= item.kode %></strong> – <%= item.deskripsi %></li>
      <% }) %>
    </ul>
  </div>

  <!-- ===== STANDAR KOMPETENSI ===== -->
  <div class="section-wrapper">
    <h2 class="section-title">Standar <span>Kompetensi</span> Lulusan</h2>
    <ul class="kompetensi-list">
      <% standarKompetensi.forEach(function(sk){ %>
        <li><i class="bi bi-check-lg text-success me-2"></i><%= sk %></li>
      <% }) %>
    </ul>
  </div>

  <!-- ===== STRUKTUR KURIKULUM ===== -->
  <div class="section-wrapper">
    <h2 class="section-title">Struktur <span>Mata Kuliah</span></h2>

    <!-- Navigasi Semester -->
    <div class="semester-nav" id="semesterNav">
      <% semesterData.forEach(function(smt, idx){ %>
        <button type="button" data-target="smt-<%= smt.semester %>" class="<%= idx === 0 ? 'active' : '' %>">
          Semester <%= smt.semester %>
        </button>
      <% }) %>
    </div>

    <!-- Panel Semester -->
    <% semesterData.forEach(function(smt, idx){ %>
      <div class="semester-panel <%= idx === 0 ? 'active' : '' %>" id="smt-<%= smt.semester %>">

        <% if (smt.isConcentration) { %>
          <!-- Semester dengan konsentrasi -->
          <div class="sub-nav" id="subNav-<%= smt.semester %>">
            <% smt.concentrations.forEach(function(conc, ci){ %>
              <button type="button" data-target="conc-<%= smt.semester %>-<%= ci %>" class="<%= ci === 0 ? 'active' : '' %>">
                <%= conc.name %>
              </button>
            <% }) %>
          </div>

          <% smt.concentrations.forEach(function(conc, ci){ %>
            <div class="concentration-panel <%= ci === 0 ? 'active' : '' %>" id="conc-<%= smt.semester %>-<%= ci %>">
              <div class="table-responsive table-kurikulum">
                <table class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>No</th>
                      <th>Kode</th>
                      <th>Mata Kuliah</th>
                      <th>SKS</th>
                      <th>Jenis</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% conc.courses.forEach(function(mk, i){ %>
                      <tr>
                        <td><%= i+1 %></td>
                        <td><%= mk.kode %></td>
                        <td><%= mk.nama %></td>
                        <td><span class="badge-sks"><%= mk.sks %> SKS</span></td>
                        <td>
                          <% 
                            let badgeClass = 'badge-jenis';
                            if (mk.jenis === 'Wajib Umum') badgeClass += ' badge-wajib-umum';
                            else if (mk.jenis === 'Penciri Dewantara') badgeClass += ' badge-penciri';
                            else if (mk.jenis === 'Inti Keahlian') badgeClass += ' badge-keahlian';
                            else if (mk.jenis === 'Wajib Polidewa') badgeClass += ' badge-polidewa';
                          %>
                          <span class="<%= badgeClass %>"><%= mk.jenis %></span>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
                <div class="semester-total">
                  Total SKS Semester <%= smt.semester %> (Konsentrasi <%= conc.name %>):
                  <%= getSemesterTotal(conc.courses) %> SKS
                </div>
              </div>
            </div>
          <% }) %>

        <% } else { %>
          <!-- Semester biasa -->
          <div class="table-responsive table-kurikulum">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Kode</th>
                  <th>Mata Kuliah</th>
                  <th>SKS</th>
                  <th>Jenis</th>
                </tr>
              </thead>
              <tbody>
                <% smt.courses.forEach(function(mk, i){ %>
                  <tr>
                    <td><%= i+1 %></td>
                    <td><%= mk.kode %></td>
                    <td><%= mk.nama %></td>
                    <td><span class="badge-sks"><%= mk.sks %> SKS</span></td>
                    <td>
                      <% 
                        let badgeClass = 'badge-jenis';
                        if (mk.jenis === 'Wajib Umum') badgeClass += ' badge-wajib-umum';
                        else if (mk.jenis === 'Penciri Dewantara') badgeClass += ' badge-penciri';
                        else if (mk.jenis === 'Inti Keahlian') badgeClass += ' badge-keahlian';
                        else if (mk.jenis === 'Wajib Polidewa') badgeClass += ' badge-polidewa';
                      %>
                      <span class="<%= badgeClass %>"><%= mk.jenis %></span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <div class="semester-total">
              Total SKS Semester <%= smt.semester %>:
              <%= getSemesterTotal(smt.courses) %> SKS
            </div>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>

  <!-- ===== PELAKSANAAN PEMBELAJARAN ===== -->
  <div class="section-wrapper">
    <h2 class="section-title">Pelaksanaan <span>Proses Pembelajaran</span></h2>
    <div class="row g-4">
      <div class="col-md-6">
        <h5 style="font-weight: 700; color: var(--text-main);"><i class="bi bi-mortarboard text-primary me-2"></i>Metode Pembelajaran</h5>
        <ul style="list-style: none; padding: 0;">
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Ceramah interaktif</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Diskusi kelompok</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Praktikum terbimbing</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Praktikum mandiri</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Project-Based Learning</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Studi kasus</li>
          <li style="padding: 0.3rem 0;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Magang industri</li>
        </ul>
      </div>
      <div class="col-md-6">
        <h5 style="font-weight: 700; color: var(--text-main);"><i class="bi bi-laptop text-primary me-2"></i>Bentuk Pembelajaran</h5>
        <ul style="list-style: none; padding: 0;">
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Kuliah tatap muka</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Praktikum laboratorium</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Seminar dan presentasi</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Magang / praktik kerja</li>
          <li style="padding: 0.3rem 0;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Pembelajaran daring sinkron & asinkron</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ===== PENILAIAN ===== -->
  <div class="section-wrapper">
    <h2 class="section-title">Penilaian & <span>Evaluasi</span></h2>
    <div class="row g-4">
      <div class="col-md-4">
        <h5 style="font-weight: 700; color: var(--text-main);">Prinsip Penilaian</h5>
        <ul style="list-style: none; padding: 0;">
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Valid</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Reliabel</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Transparan</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Akuntabel</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Berkeadilan</li>
          <li style="padding: 0.3rem 0; border-bottom: 1px solid #eef1f8;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Objektif</li>
          <li style="padding: 0.3rem 0;"><i class="bi bi-check-circle-fill text-primary me-2"></i>Edukatif</li>
        </ul>
      </div>
      <div class="col-md-4">
        <h5 style="font-weight: 700; color: var(--text-main);">Komponen & Bobot</h5>
        <div class="table-responsive">
          <table class="table table-sm table-borderless" style="font-size: clamp(0.85rem, 2vw, 0.95rem);">
            <tr><td>Sikap, kehadiran, keaktifan</td><td class="text-end fw-bold">10–20%</td></tr>
            <tr><td>Tugas dan praktikum (formatif)</td><td class="text-end fw-bold">20–30%</td></tr>
            <tr><td>Ujian Tengah Semester (UTS)</td><td class="text-end fw-bold">20–25%</td></tr>
            <tr><td>UAS / Proyek Akhir</td><td class="text-end fw-bold">25–35%</td></tr>
          </table>
        </div>
      </div>
      <div class="col-md-4">
        <h5 style="font-weight: 700; color: var(--text-main);">Penilaian Magang</h5>
        <div class="table-responsive">
          <table class="table table-sm table-borderless" style="font-size: clamp(0.85rem, 2vw, 0.95rem);">
            <tr><td>Laporan Harian</td><td class="text-end fw-bold">15%</td></tr>
            <tr><td>Laporan Akhir Magang</td><td class="text-end fw-bold">25%</td></tr>
            <tr><td>Penilaian Pembimbing Industri</td><td class="text-end fw-bold">30%</td></tr>
            <tr><td>Presentasi Seminar Magang</td><td class="text-end fw-bold">30%</td></tr>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== UNDUH DOKUMEN ===== -->
  <div class="section-wrapper" style="text-align: center;">
    <h2 class="section-title">Unduh <span>Dokumen</span> Kurikulum</h2>
    <p style="color: var(--text-muted); font-size: clamp(0.9rem, 2vw, 1rem); margin-bottom: 1.2rem;">
      Dokumen lengkap kurikulum Program Studi D3 Teknik Elektronika tahun <%= tahunKurikulum %> dalam format PDF.
    </p>
    <a href="<%= fileKurikulum %>" class="btn-download" target="_blank" rel="noopener">
      <i class="bi bi-download"></i> Unduh PDF
    </a>
  </div>

</div> <!-- penutup container -->

<!-- ===== SCRIPT TAB ===== -->
<script>
  (function() {
    // Navigasi semester utama
    const semesterBtns = document.querySelectorAll('#semesterNav button');
    const semesterPanels = document.querySelectorAll('.semester-panel');

    function activateSemester(targetId) {
      semesterBtns.forEach(b => b.classList.remove('active'));
      semesterPanels.forEach(p => p.classList.remove('active'));
      const activeBtn = Array.from(semesterBtns).find(b => b.dataset.target === targetId);
      if (activeBtn) activeBtn.classList.add('active');
      const panel = document.getElementById(targetId);
      if (panel) panel.classList.add('active');

      // Reset sub-nav (aktifkan konsentrasi pertama)
      const subNav = panel ? panel.querySelector('.sub-nav') : null;
      if (subNav) {
        const subBtns = subNav.querySelectorAll('button');
        const subPanels = panel.querySelectorAll('.concentration-panel');
        subBtns.forEach((b, i) => b.classList.toggle('active', i === 0));
        subPanels.forEach((p, i) => p.classList.toggle('active', i === 0));
      }
    }

    semesterBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        activateSemester(this.dataset.target);
      });
    });

    // Sub-navigasi konsentrasi
    document.querySelectorAll('.sub-nav').forEach(subNav => {
      const btns = subNav.querySelectorAll('button');
      const parentPanel = subNav.closest('.semester-panel');
      const concPanels = parentPanel ? parentPanel.querySelectorAll('.concentration-panel') : [];

      btns.forEach((btn, idx) => {
        btn.addEventListener('click', function() {
          btns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          concPanels.forEach(p => p.classList.remove('active'));
          const targetId = this.dataset.target;
          const targetPanel = document.getElementById(targetId);
          if (targetPanel) targetPanel.classList.add('active');
        });
      });
    });

    // Aktifkan semester pertama jika tidak ada yang aktif
    if (!document.querySelector('#semesterNav .active')) {
      const firstBtn = document.querySelector('#semesterNav button');
      if (firstBtn) activateSemester(firstBtn.dataset.target);
    }
  })();
</script>

