<%- include('../../partials/header-landing') %>

<style>
  :root {
    --k-primary: #2147b0;
    --k-primary-dark: #1a3a8f;
    --k-primary-light: rgba(33,71,176,0.08);
    --k-gradient: linear-gradient(135deg, #2147b0, #6d8bed);
    --k-shadow-sm: 0 5px 15px rgba(0,0,0,0.05);
    --k-shadow-hover: 0 15px 30px rgba(33,71,176,0.15);
    --k-radius: 1.5rem;
  }

  .kur-header {
    background: var(--k-gradient); border-radius: var(--k-radius); padding: 3rem 2rem;
    color: #fff; margin-bottom: 1.2rem; text-align: center; box-shadow: 0 15px 30px rgba(33,71,176,0.25);
  }
  .kur-header h1 { font-weight: 800; font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: .5rem; }
  .kur-header p { opacity: .9; font-size: 1.05rem; margin: 0; }

  .status-badge {
    display: inline-flex; align-items: center; gap: .4rem; background: #fffbeb; border: 1px solid #fde68a;
    color: #92400e; font-weight: 700; font-size: .82rem; padding: .4rem 1rem; border-radius: 50px; margin-bottom: 2rem;
  }

  .kur-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.2rem; margin-bottom: 2.5rem; }
  .kur-summary .box { background: #fff; border-radius: 1.2rem; padding: 1.4rem; text-align: center; box-shadow: var(--k-shadow-sm); border: 1px solid rgba(33,71,176,0.1); }
  .kur-summary .box .num { font-size: 1.7rem; font-weight: 800; color: var(--k-primary); }
  .kur-summary .box .lbl { font-size: .8rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }

  .section-title {
    font-size: 1.5rem; font-weight: 700; margin: 2.5rem 0 1.2rem; color: #1e293b;
    display: flex; align-items: center; gap: .7rem; border-bottom: 3px solid var(--k-primary); padding-bottom: .7rem;
  }
  .section-title i { color: var(--k-primary); font-size: 1.6rem; }
  .sub-title { font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 1.5rem 0 .8rem; }

  .id-table { width: 100%; background: #fff; border-radius: 1.2rem; overflow: hidden; box-shadow: var(--k-shadow-sm); border: 1px solid rgba(33,71,176,0.1); border-collapse: collapse; font-size: .9rem; }
  .id-table td { padding: .65rem 1rem; border-top: 1px solid #eef1f8; }
  .id-table td:first-child { font-weight: 600; color: #475569; width: 40%; }
  .id-table tr:first-child td { border-top: none; }

  .info-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .7rem; }
  .info-list.two-col { grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); }
  .info-list li { background: #fff; border-left: 4px solid var(--k-primary); border-radius: .8rem; padding: .9rem 1.1rem; box-shadow: var(--k-shadow-sm); font-size: .9rem; color: #334155; display: flex; gap: .6rem; }
  .info-list li i { color: var(--k-primary); margin-top: .15rem; flex-shrink: 0; }

  .profil-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); }
  .profil-card { background: #fff; border-radius: 1.1rem; padding: 1.3rem; box-shadow: var(--k-shadow-sm); border: 1px solid rgba(33,71,176,0.1); }
  .profil-card .no { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--k-gradient); color: #fff; font-weight: 800; font-size: .85rem; margin-bottom: .6rem; }
  .profil-card h5 { font-weight: 700; color: #1e293b; margin-bottom: .4rem; font-size: 1rem; }
  .profil-card p { font-size: .85rem; color: #64748b; margin: 0; }

  .cpl-table-wrap, .mk-table-wrap, .desk-table-wrap { background: #fff; border-radius: 1.2rem; box-shadow: var(--k-shadow-sm); overflow: hidden; border: 1px solid rgba(33,71,176,0.1); }
  .cpl-table, .mk-table, .desk-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .cpl-table thead th, .mk-table thead th, .desk-table thead th {
    background: var(--k-primary-light); color: var(--k-primary-dark); font-weight: 700; padding: .8rem 1rem; text-align: left; white-space: nowrap;
  }
  .cpl-table tbody td, .mk-table tbody td, .desk-table tbody td { padding: .75rem 1rem; border-top: 1px solid #eef1f8; color: #334155; vertical-align: top; }
  .cpl-table tbody tr:hover, .mk-table tbody tr:hover, .desk-table tbody tr:hover { background: #f8faff; }
  .cpl-kode { font-weight: 700; color: var(--k-primary-dark); white-space: nowrap; }

  .badge-sks { background: var(--k-primary-light); color: var(--k-primary-dark); font-weight: 700; padding: .2rem .6rem; border-radius: 50px; font-size: .78rem; white-space: nowrap; }
  .badge-jenis { background: #f1f5f9; color: #475569; font-weight: 600; padding: .2rem .6rem; border-radius: 50px; font-size: .76rem; white-space: nowrap; }

  .sks-table-wrap { background: #fff; border-radius: 1.2rem; box-shadow: var(--k-shadow-sm); overflow: hidden; border: 1px solid rgba(33,71,176,0.1); margin-bottom: 1rem; }
  .sks-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .sks-table thead th { background: var(--k-primary-light); color: var(--k-primary-dark); font-weight: 700; padding: .8rem 1rem; text-align: left; }
  .sks-table tbody td { padding: .7rem 1rem; border-top: 1px solid #eef1f8; }
  .sks-table tfoot td { padding: .8rem 1rem; font-weight: 700; background: #f8faff; color: var(--k-primary-dark); }

  .semester-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.2rem; }
  .semester-nav button { border: 1.5px solid var(--k-primary); background: #fff; color: var(--k-primary); font-weight: 600; padding: .5rem 1.1rem; border-radius: 50px; cursor: pointer; transition: .2s; }
  .semester-nav button:hover { background: var(--k-primary-light); }
  .semester-nav button.active { background: var(--k-gradient); color: #fff; border-color: transparent; }

  .konsentrasi-nav { display: flex; gap: .5rem; margin-bottom: 1rem; }
  .konsentrasi-nav button { border: 1.5px dashed var(--k-primary); background: #fff; color: var(--k-primary-dark); font-weight: 600; padding: .4rem 1rem; border-radius: 50px; cursor: pointer; font-size: .85rem; transition: .2s; }
  .konsentrasi-nav button.active { background: var(--k-primary-light); border-style: solid; }

  .semester-total { text-align: right; padding: .8rem 1rem; font-weight: 700; color: var(--k-primary-dark); background: #f8faff; }
  .semester-panel { display: none; }
  .semester-panel.active { display: block; animation: fadeIn .3s ease; }
  .konsentrasi-panel { display: none; }
  .konsentrasi-panel.active { display: block; animation: fadeIn .3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .accordion-desk { display: grid; gap: .6rem; }
  .accordion-desk details { background: #fff; border-radius: .9rem; box-shadow: var(--k-shadow-sm); border: 1px solid rgba(33,71,176,0.1); padding: .9rem 1.1rem; }
  .accordion-desk summary { cursor: pointer; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: .6rem; }
  .accordion-desk summary .kode { color: var(--k-primary-dark); font-weight: 700; }
  .accordion-desk p { margin: .6rem 0 0; color: #64748b; font-size: .88rem; }

  .penilaian-table-wrap { background: #fff; border-radius: 1.2rem; box-shadow: var(--k-shadow-sm); overflow: hidden; border: 1px solid rgba(33,71,176,0.1); margin-bottom: 1.5rem; }
  .penilaian-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .penilaian-table thead th { background: var(--k-primary-light); color: var(--k-primary-dark); font-weight: 700; padding: .8rem 1rem; text-align: left; }
  .penilaian-table tbody td { padding: .7rem 1rem; border-top: 1px solid #eef1f8; color: #334155; }

  .ref-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; counter-reset: ref; }
  .ref-list li { counter-increment: ref; background: #fff; border-radius: .8rem; padding: .8rem 1.1rem; box-shadow: var(--k-shadow-sm); border: 1px solid rgba(33,71,176,0.1); font-size: .87rem; color: #475569; display: flex; gap: .7rem; }
  .ref-list li::before { content: counter(ref) "."; font-weight: 700; color: var(--k-primary); flex-shrink: 0; }

  .penetapan-box {
    background: #fff; border-radius: var(--k-radius); box-shadow: var(--k-shadow-sm); border: 1px solid rgba(33,71,176,0.1);
    padding: 1.8rem; margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between;
  }
  .penetapan-box .ttd { text-align: center; min-width: 220px; }
  .penetapan-box .ttd .nama { font-weight: 700; text-decoration: underline; margin-top: 3rem; color: #1e293b; }
  .penetapan-box .ttd .jabatan { color: #64748b; font-size: .85rem; }

  .download-box {
    background: #fff; border-radius: var(--k-radius); box-shadow: var(--k-shadow-sm); border: 1px solid rgba(33,71,176,0.1);
    padding: 1.8rem; margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .download-box .txt h3 { font-weight: 700; font-size: 1.1rem; margin-bottom: .2rem; color: #1e293b; }
  .download-box .txt p { margin: 0; color: #64748b; font-size: .88rem; }
  .btn-download {
    background: var(--k-gradient); color: #fff; border: none; padding: .7rem 1.5rem; border-radius: 50px; font-weight: 600;
    text-decoration: none; white-space: nowrap; box-shadow: 0 8px 16px rgba(33,71,176,0.25); transition: .2s;
  }
  .btn-download:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 12px 20px rgba(33,71,176,0.3); }
</style>

<div class="kur-header">
  <h1><i class="bi bi-journal-bookmark-fill me-2"></i>Kurikulum</h1>
  <p>Program Studi D3 Teknik Elektronika &mdash; Politeknik Dewantara &mdash; Tahun <%= dokumenInfo.tahunKurikulum %></p>
</div>

<div class="text-center">
  <span class="status-badge"><i class="bi bi-exclamation-triangle-fill"></i><%= dokumenInfo.status %> &mdash; <%= dokumenInfo.catatanStatus %></span>
</div>

<!-- Ringkasan -->
<div class="kur-summary">
  <div class="box"><div class="num">6</div><div class="lbl">Semester</div></div>
  <div class="box"><div class="num"><%= totalSks %></div><div class="lbl">Total SKS</div></div>
  <div class="box"><div class="num">2</div><div class="lbl">Konsentrasi</div></div>
  <div class="box"><div class="num"><%= dokumenInfo.tahunKurikulum %></div><div class="lbl">Tahun Kurikulum</div></div>
</div>

<!-- Identitas Program Studi -->
<div class="section-title"><i class="bi bi-card-heading"></i>Identitas Program Studi</div>
<table class="id-table">
  <tr><td>Unit Pengelola Program Studi</td><td><%= identitas.unitPengelola %></td></tr>
  <tr><td>Jenis Program Studi</td><td><%= identitas.jenisProdi %></td></tr>
  <tr><td>Nama Program Studi</td><td><%= identitas.namaProdi %></td></tr>
  <tr><td>Gelar yang Diberikan</td><td><%= identitas.gelar %></td></tr>
  <tr><td>Alamat</td><td><%= identitas.alamat %></td></tr>
  <tr><td>Nomor Telepon</td><td><%= identitas.telepon %></td></tr>
  <tr><td>E-mail</td><td><%= identitas.email %></td></tr>
  <tr><td>Website</td><td><%= identitas.website %></td></tr>
  <tr><td>No. SK Pendirian PT</td><td><%= identitas.noSkPendirian %></td></tr>
  <tr><td>Tanggal SK Pendirian PT</td><td><%= identitas.tglSkPendirian %></td></tr>
  <tr><td>Akreditasi</td><td><%= identitas.akreditasi %></td></tr>
</table>

<!-- Visi Misi Tujuan -->
<div class="section-title"><i class="bi bi-flag-fill"></i>Visi, Misi, Tujuan &amp; Strategi Program Studi</div>
<p class="sub-title">Visi</p>
<p style="color:#475569;"><%= visiMisi.visi %></p>

<p class="sub-title">Misi</p>
<ul class="info-list">
  <% visiMisi.misi.forEach(function(m){ %><li><i class="bi bi-dot"></i><span><%= m %></span></li><% }) %>
</ul>

<p class="sub-title">Tujuan</p>
<ul class="info-list">
  <% visiMisi.tujuan.forEach(function(t){ %><li><i class="bi bi-check-circle-fill"></i><span><%= t %></span></li><% }) %>
</ul>

<p class="sub-title">Strategi</p>
<ul class="info-list">
  <% visiMisi.strategi.forEach(function(s){ %><li><i class="bi bi-arrow-right-circle-fill"></i><span><%= s %></span></li><% }) %>
</ul>

<!-- Profil Lulusan -->
<div class="section-title"><i class="bi bi-mortarboard-fill"></i>Profil Lulusan</div>
<div class="profil-grid">
  <% profilLulusan.forEach(function(p){ %>
    <div class="profil-card">
      <div class="no"><%= p.no %></div>
      <h5><%= p.judul %></h5>
      <p><%= p.deskripsi %></p>
    </div>
  <% }) %>
</div>

<!-- CPL -->
<div class="section-title"><i class="bi bi-check2-circle"></i>Capaian Pembelajaran Lulusan (CPL)</div>
<div class="cpl-table-wrap">
  <table class="cpl-table">
    <thead><tr><th style="width:90px;">Kode</th><th>Deskripsi CPL</th></tr></thead>
    <tbody>
      <% cpl.forEach(function(c){ %>
        <tr><td class="cpl-kode"><%= c.kode %></td><td><%= c.deskripsi %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Standar Kompetensi Lulusan -->
<div class="section-title"><i class="bi bi-award-fill"></i>Standar Kompetensi Lulusan</div>
<ul class="info-list">
  <% standarKompetensi.forEach(function(s, i){ %>
    <li><i class="bi bi-check-lg"></i><span><%= s %></span></li>
  <% }) %>
</ul>

<!-- Jumlah SKS -->
<div class="section-title"><i class="bi bi-calculator-fill"></i>Jumlah SKS</div>
<div class="sks-table-wrap">
  <table class="sks-table">
    <thead><tr><th>Jenis Mata Kuliah</th><th>Jumlah SKS</th><th>Keterangan</th></tr></thead>
    <tbody>
      <% jumlahSks.forEach(function(j){ %>
        <tr><td><%= j.jenis %></td><td><span class="badge-sks"><%= j.sks %> SKS</span></td><td><%= j.keterangan %></td></tr>
      <% }) %>
    </tbody>
    <tfoot><tr><td>Total</td><td><%= totalSks %> SKS</td><td>20 SKS x 6 semester</td></tr></tfoot>
  </table>
</div>

<!-- Struktur Mata Kuliah -->
<div class="section-title"><i class="bi bi-diagram-3-fill"></i>Struktur Mata Kuliah per Semester</div>

<div class="semester-nav" id="semesterNav">
  <% strukturSemester.forEach(function(smt, idx){ %>
    <button type="button" data-target="smt-<%= smt.semester %>" class="<%= idx === 0 ? 'active' : '' %>">Semester <%= smt.semester %></button>
  <% }) %>
</div>

<% strukturSemester.forEach(function(smt, idx){ %>
  <div class="semester-panel <%= idx === 0 ? 'active' : '' %>" id="smt-<%= smt.semester %>">

    <% if (smt.varian) { %>
      <div class="konsentrasi-nav" id="konsNav-<%= smt.semester %>">
        <% smt.varian.forEach(function(v, vIdx){ %>
          <button type="button" data-target="smt-<%= smt.semester %>-kons-<%= vIdx %>" class="<%= vIdx === 0 ? 'active' : '' %>">
            <i class="bi bi-diagram-2 me-1"></i>Konsentrasi <%= v.nama %>
          </button>
        <% }) %>
      </div>

      <% smt.varian.forEach(function(v, vIdx){
           var totalTeori = v.matkul.reduce(function(a,m){return a+m.teori;},0);
           var totalPraktik = v.matkul.reduce(function(a,m){return a+m.praktik;},0);
           var totalSksSmt = v.matkul.reduce(function(a,m){return a+m.sks;},0);
      %>
        <div class="konsentrasi-panel <%= vIdx === 0 ? 'active' : '' %>" id="smt-<%= smt.semester %>-kons-<%= vIdx %>">
          <div class="mk-table-wrap">
            <table class="mk-table">
              <thead><tr><th>No</th><th>Kode</th><th>Mata Kuliah</th><th>Teori</th><th>Praktik</th><th>SKS</th><th>Jenis MK</th></tr></thead>
              <tbody>
                <% v.matkul.forEach(function(mk, i){ %>
                  <tr>
                    <td><%= i + 1 %></td><td><%= mk.kode %></td><td><%= mk.nama %></td>
                    <td><%= mk.teori %></td><td><%= mk.praktik %></td>
                    <td><span class="badge-sks"><%= mk.sks %> SKS</span></td>
                    <td><span class="badge-jenis"><%= mk.jenis %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <div class="semester-total">Total: <%= totalTeori %> Teori + <%= totalPraktik %> Praktik = <%= totalSksSmt %> SKS</div>
          </div>
        </div>
      <% }) %>

    <% } else {
         var totalTeori = smt.matkul.reduce(function(a,m){return a+m.teori;},0);
         var totalPraktik = smt.matkul.reduce(function(a,m){return a+m.praktik;},0);
         var totalSksSmt = smt.matkul.reduce(function(a,m){return a+m.sks;},0);
    %>
      <div class="mk-table-wrap">
        <table class="mk-table">
          <thead><tr><th>No</th><th>Kode</th><th>Mata Kuliah</th><th>Teori</th><th>Praktik</th><th>SKS</th><th>Jenis MK</th></tr></thead>
          <tbody>
            <% smt.matkul.forEach(function(mk, i){ %>
              <tr>
                <td><%= i + 1 %></td><td><%= mk.kode %></td><td><%= mk.nama %></td>
                <td><%= mk.teori %></td><td><%= mk.praktik %></td>
                <td><span class="badge-sks"><%= mk.sks %> SKS</span></td>
                <td><span class="badge-jenis"><%= mk.jenis %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <div class="semester-total">Total: <%= totalTeori %> Teori + <%= totalPraktik %> Praktik = <%= totalSksSmt %> SKS</div>
      </div>
    <% } %>

  </div>
<% }) %>

<!-- Rekognisi Kredit Praktik Dunia Kerja -->
<div class="section-title"><i class="bi bi-briefcase-fill"></i>Rekognisi Kredit Praktik Dunia Kerja (MBKM)</div>
<div class="sks-table-wrap">
  <table class="sks-table">
    <thead><tr><th>Kegiatan</th><th>Semester</th><th>SKS</th><th>Fokus Kegiatan</th></tr></thead>
    <tbody>
      <% rekognisiMagang.forEach(function(r){ %>
        <tr><td><%= r.kegiatan %></td><td><%= r.semester %></td><td><span class="badge-sks"><%= r.sks %> SKS</span></td><td><%= r.fokus %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Deskripsi Mata Kuliah -->
<div class="section-title"><i class="bi bi-card-list"></i>Deskripsi Mata Kuliah</div>
<div class="accordion-desk">
  <% deskripsiMatkul.forEach(function(mk){ %>
    <details>
      <summary><span class="kode"><%= mk.kode %></span> &mdash; <%= mk.nama %></summary>
      <p><%= mk.deskripsi %></p>
    </details>
  <% }) %>
</div>

<!-- Penilaian -->
<div class="section-title"><i class="bi bi-clipboard2-data-fill"></i>Penilaian &amp; Evaluasi Pembelajaran</div>
<p class="sub-title">Prinsip Penilaian</p>
<ul class="info-list two-col">
  <% penilaian.prinsip.forEach(function(p){ %><li><i class="bi bi-dot"></i><span><%= p %></span></li><% }) %>
</ul>

<p class="sub-title">Komponen Penilaian &amp; Bobot</p>
<div class="penilaian-table-wrap">
  <table class="penilaian-table">
    <thead><tr><th>Komponen Penilaian</th><th>Bobot</th></tr></thead>
    <tbody>
      <% penilaian.komponen.forEach(function(k){ %><tr><td><%= k.komponen %></td><td><%= k.bobot %></td></tr><% }) %>
    </tbody>
  </table>
</div>

<p class="sub-title">Penilaian Magang</p>
<div class="penilaian-table-wrap">
  <table class="penilaian-table">
    <thead><tr><th>Komponen</th><th>Bobot</th><th>Indikator</th></tr></thead>
    <tbody>
      <% penilaian.magang.forEach(function(m){ %><tr><td><%= m.komponen %></td><td><%= m.bobot %></td><td><%= m.indikator %></td></tr><% }) %>
    </tbody>
  </table>
</div>

<!-- Referensi -->
<div class="section-title"><i class="bi bi-bookshelf"></i>Daftar Referensi</div>
<ul class="ref-list">
  <% referensi.forEach(function(r){ %><li><span><%= r %></span></li><% }) %>
</ul>

<!-- Penetapan -->
<div class="penetapan-box">
  <div>
    <p style="color:#64748b; font-size:.9rem; max-width:520px;">
      Kurikulum ini merupakan dokumen hidup yang dievaluasi dan diperbaiki secara berkala sesuai perkembangan
      ilmu pengetahuan, teknologi, kebutuhan dunia kerja, dan kebijakan pendidikan tinggi.
    </p>
    <p style="color:#94a3b8; font-size:.82rem;">Palopo, <%= dokumenInfo.tanggalPenetapan %></p>
  </div>
  <div class="ttd">
    <div class="jabatan">Mengetahui,<br>Direktur Politeknik Dewantara</div>
    <div class="nama"><%= dokumenInfo.direktur %></div>
  </div>
  <div class="ttd">
    <div class="jabatan">Ketua Program Studi Teknik Elektronika</div>
    <div class="nama"><%= dokumenInfo.kaprodi %></div>
  </div>
</div>

<!-- Unduh Dokumen -->
<div class="download-box">
  <div class="txt">
    <h3><i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>Dokumen Kurikulum Lengkap (PDF)</h3>
    <p>Unduh dokumen kurikulum resmi untuk referensi lengkap, termasuk matriks CPL dengan mata kuliah.</p>
  </div>
  <a href="<%= fileKurikulum || '#' %>" class="btn-download" target="_blank" rel="noopener">
    <i class="bi bi-download me-1"></i>Unduh PDF
  </a>
</div>

<script>
  document.querySelectorAll('#semesterNav button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('#semesterNav button').forEach(function (b) { b.classList.remove('active'); });
      document.querySelectorAll('.semester-panel').forEach(function (p) { p.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById(btn.dataset.target).classList.add('active');
    });
  });

  document.querySelectorAll('[id^="konsNav-"]').forEach(function (nav) {
    nav.querySelectorAll('button').forEach(function (btn) {
      btn.addEventListener('click', function () {
        nav.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
        nav.parentElement.querySelectorAll('.konsentrasi-panel').forEach(function (p) { p.classList.remove('active'); });
        btn.classList.add('active');
        document.getElementById(btn.dataset.target).classList.add('active');
      });
    });
  });
</script>

