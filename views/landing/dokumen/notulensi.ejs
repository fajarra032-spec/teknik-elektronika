<%- include('../../partials/header-landing') %>

<style>
  :root {
    --n-primary: #7c2d12;
    --n-primary-dark: #5c220d;
    --n-primary-light: rgba(124,45,18,0.08);
    --n-gradient: linear-gradient(135deg, #7c2d12, #ea580c);
    --n-shadow-sm: 0 5px 15px rgba(0,0,0,0.05);
    --n-shadow-hover: 0 15px 30px rgba(124,45,18,0.15);
    --n-radius: 1.5rem;
  }

  .not-header {
    background: var(--n-gradient); border-radius: var(--n-radius); padding: 3rem 2rem;
    color: #fff; margin-bottom: 1.5rem; text-align: center; box-shadow: 0 15px 30px rgba(124,45,18,0.25);
  }
  .not-header h1 { font-weight: 800; font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: .5rem; }
  .not-header p { opacity: .9; font-size: 1.05rem; margin: 0; }

  .note-box {
    background: #fff7ed; border: 1px solid #fed7aa; border-radius: 1rem; padding: 1.1rem 1.3rem;
    color: #7c2d12; font-size: .9rem; margin-bottom: 2rem; display: flex; gap: .7rem;
  }

  .filter-bar { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.8rem; align-items: center; }
  .filter-bar input[type="text"] {
    flex: 1; min-width: 220px; border: 1.5px solid #e2e8f0; border-radius: 50px; padding: .6rem 1.2rem;
    font-size: .9rem; outline: none; transition: .2s;
  }
  .filter-bar input[type="text"]:focus { border-color: var(--n-primary); }
  .filter-bar select {
    border: 1.5px solid #e2e8f0; border-radius: 50px; padding: .6rem 1.2rem; font-size: .9rem; outline: none; background: #fff;
  }

  .timeline { position: relative; padding-left: 2rem; }
  .timeline::before {
    content: ''; position: absolute; left: 8px; top: 8px; bottom: 8px; width: 2px;
    background: linear-gradient(180deg, var(--n-primary), transparent);
  }

  .rapat-card {
    position: relative; background: #fff; border-radius: 1.2rem; padding: 1.4rem 1.5rem; margin-bottom: 1.3rem;
    box-shadow: var(--n-shadow-sm); border: 1px solid rgba(124,45,18,0.1); transition: .2s;
  }
  .rapat-card::before {
    content: ''; position: absolute; left: -2.02rem; top: 1.6rem; width: 14px; height: 14px;
    border-radius: 50%; background: var(--n-gradient); border: 3px solid #fff; box-shadow: 0 0 0 2px var(--n-primary);
  }
  .rapat-card:hover { box-shadow: var(--n-shadow-hover); transform: translateY(-2px); }

  .rapat-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-bottom: .6rem; }
  .rapat-tanggal { font-weight: 700; color: var(--n-primary-dark); font-size: .88rem; display: flex; align-items: center; gap: .4rem; }
  .badge-jenis-rapat {
    background: var(--n-primary-light); color: var(--n-primary-dark); font-weight: 600;
    padding: .25rem .7rem; border-radius: 50px; font-size: .76rem;
  }
  .rapat-card h3 { font-weight: 700; font-size: 1.08rem; color: #1e293b; margin-bottom: .5rem; }
  .pimpinan-peserta { font-size: .84rem; color: #64748b; margin-bottom: .8rem; }
  .pimpinan-peserta i { color: var(--n-primary); }

  .daftar-hadir { margin-bottom: 1rem; }
  .daftar-hadir h6 {
    font-weight: 700; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em;
    color: #94a3b8; margin-bottom: .5rem; display: flex; align-items: center; gap: .4rem;
  }
  .hadir-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip-hadir {
    display: inline-flex; align-items: center; gap: .35rem; background: var(--n-primary-light);
    color: var(--n-primary-dark); font-size: .8rem; font-weight: 600; padding: .35rem .8rem; border-radius: 50px;
  }
  .chip-hadir i { font-size: .85rem; }

  .rapat-detail summary {
    cursor: pointer; font-weight: 600; color: var(--n-primary-dark); font-size: .88rem;
    display: flex; align-items: center; gap: .4rem; list-style: none;
  }
  .rapat-detail summary::-webkit-details-marker { display: none; }
  .rapat-detail summary::after { content: '\\25BE'; margin-left: auto; transition: .2s; }
  .rapat-detail[open] summary::after { transform: rotate(180deg); }

  .detail-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); margin-top: 1rem; }
  .detail-col h6 { font-weight: 700; font-size: .82rem; text-transform: uppercase; letter-spacing: .03em; color: #94a3b8; margin-bottom: .5rem; }
  .detail-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
  .detail-col ul li {
    background: #fafafa; border-left: 3px solid var(--n-primary); border-radius: .6rem; padding: .6rem .8rem;
    font-size: .85rem; color: #334155;
  }

  .rapat-footer { display: flex; justify-content: flex-end; margin-top: 1rem; }
  .btn-notulen {
    background: var(--n-gradient); color: #fff; border: none; padding: .45rem 1.1rem;
    border-radius: 50px; font-weight: 600; font-size: .82rem; text-decoration: none;
    display: inline-flex; align-items: center; gap: .4rem; transition: .2s;
  }
  .btn-notulen:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 8px 16px rgba(124,45,18,0.25); }

  .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
</style>

<div class="not-header">
  <h1><i class="bi bi-journal-richtext me-2"></i>Agenda &amp; Hasil Rapat</h1>
  <p>Notulensi Rapat Program Studi Teknik Elektronika</p>
</div>

<div class="note-box">
  <i class="bi bi-info-circle-fill"></i>
  <div>Halaman ini memuat ringkasan agenda dan hasil/keputusan rapat program studi sebagai bentuk transparansi tata kelola. Dokumen notulen lengkap dapat diunduh melalui tombol pada masing-masing rapat (jika tersedia).</div>
</div>

<div class="filter-bar">
  <input type="text" id="searchNotulensi" placeholder="Cari judul rapat...">
  <select id="filterJenis">
    <option value="">Semua Jenis Rapat</option>
  </select>
</div>

<div class="timeline" id="timelineWrap">
  <% notulensi.forEach(function(r){ %>
    <div class="rapat-card" data-judul="<%= r.judul.toLowerCase() %>" data-jenis="<%= r.jenis %>">
      <div class="rapat-meta">
        <span class="rapat-tanggal"><i class="bi bi-calendar-event"></i><%= r.tanggalTampil %></span>
        <span class="badge-jenis-rapat"><%= r.jenis %></span>
      </div>
      <h3><%= r.judul %></h3>
      <div class="pimpinan-peserta">
        <div><i class="bi bi-person-badge me-1"></i>Pimpinan Rapat: <%= r.pimpinan %></div>
        <div><i class="bi bi-people me-1"></i>Peserta: <%= r.peserta %></div>
      </div>

      <% if (r.daftarHadir && r.daftarHadir.length > 0) { %>
        <div class="daftar-hadir">
          <h6><i class="bi bi-person-check-fill"></i>Dosen yang Hadir (<%= r.daftarHadir.length %>)</h6>
          <div class="hadir-chips">
            <% r.daftarHadir.forEach(function(nama){ %>
              <span class="chip-hadir"><i class="bi bi-check-circle-fill"></i><%= nama %></span>
            <% }) %>
          </div>
        </div>
      <% } %>

      <details class="rapat-detail">
        <summary>Lihat Agenda &amp; Hasil Keputusan</summary>
        <div class="detail-grid">
          <div class="detail-col">
            <h6><i class="bi bi-list-check me-1"></i>Agenda Rapat</h6>
            <ul>
              <% r.agenda.forEach(function(a){ %><li><%= a %></li><% }) %>
            </ul>
          </div>
          <div class="detail-col">
            <h6><i class="bi bi-check2-square me-1"></i>Hasil / Keputusan</h6>
            <ul>
              <% r.hasil.forEach(function(h){ %><li><%= h %></li><% }) %>
            </ul>
          </div>
        </div>
      </details>

      <div class="rapat-footer">
        <a class="btn-notulen" href="<%= r.dokumenUrl || '#' %>" target="_blank" rel="noopener">
          <i class="bi bi-file-earmark-pdf-fill"></i>Unduh Notulen
        </a>
      </div>
    </div>
  <% }) %>

  <% if (!notulensi || notulensi.length === 0) { %>
    <div class="empty-state">
      <i class="bi bi-journal-x" style="font-size:2.5rem;"></i>
      <p class="mt-2">Belum ada data rapat yang tersedia.</p>
    </div>
  <% } %>
</div>

<div id="emptySearchState" class="empty-state" style="display:none;">
  <i class="bi bi-search" style="font-size:2.5rem;"></i>
  <p class="mt-2">Tidak ada rapat yang cocok dengan pencarian/filter.</p>
</div>

<script>
  (function () {
    var cards = Array.prototype.slice.call(document.querySelectorAll('#timelineWrap .rapat-card'));
    var searchInput = document.getElementById('searchNotulensi');
    var filterSelect = document.getElementById('filterJenis');
    var emptyState = document.getElementById('emptySearchState');

    // Isi opsi filter jenis rapat secara dinamis dari data yang tampil
    var jenisSet = {};
    cards.forEach(function (c) { jenisSet[c.dataset.jenis] = true; });
    Object.keys(jenisSet).forEach(function (j) {
      var opt = document.createElement('option');
      opt.value = j;
      opt.textContent = j;
      filterSelect.appendChild(opt);
    });

    function applyFilter() {
      var q = (searchInput.value || '').toLowerCase().trim();
      var jenis = filterSelect.value;
      var visibleCount = 0;

      cards.forEach(function (c) {
        var matchSearch = !q || c.dataset.judul.indexOf(q) !== -1;
        var matchJenis = !jenis || c.dataset.jenis === jenis;
        var show = matchSearch && matchJenis;
        c.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    searchInput.addEventListener('input', applyFilter);
    filterSelect.addEventListener('change', applyFilter);
  })();
</script>

<%- include('../../partials/footer-landing') %>
