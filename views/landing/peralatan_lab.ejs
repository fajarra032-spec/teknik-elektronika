<%- include('../partials/header-landing') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  var _tersediaSekarang = alat.filter(function (a) { return a.tersedia; }).length;
  var _hitungKat = {};
  alat.forEach(function (a) { _hitungKat[a.kategori] = (_hitungKat[a.kategori] || 0) + 1; });
%>
<section class="lab-hero lab-hero--full">
  <div class="lab-inner px-3">
    <h1>Peralatan Laboratorium</h1>
    <p class="lab-sub">Alat ukur, sumber daya, dan perangkat praktik Laboratorium Teknik Elektronika yang dapat dipakai mahasiswa untuk praktikum, tugas, dan penelitian.</p>
    <div class="lab-stats">
      <div class="lab-stat"><b><%= stats.jenis %></b><small>Jenis alat</small></div>
      <div class="lab-stat"><b><%= stats.unit %></b><small>Total unit</small></div>
      <div class="lab-stat"><b><%= _tersediaSekarang %></b><small>Siap dipinjam</small></div>
      <div class="lab-stat"><b><%= stats.kategori %></b><small>Kategori</small></div>
    </div>
  </div>
</section>

<div class="lab-inner px-3 py-4 mb-4">
  <div class="lab-panel mb-4">
    <div class="lab-panel-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
      <div>
        <div class="fw-bold" style="color: var(--lab-ink);"><i class="bi bi-box-arrow-right me-1"></i> Ingin meminjam alat?</div>
        <div class="small text-muted">Mahasiswa mengajukan secara daring. Pengajuan dan pengembalian diverifikasi oleh admin lab.</div>
      </div>
      <a href="/mahasiswa/peminjaman-alat/ajukan" class="btn btn-primary rounded-pill px-4 text-nowrap">Ajukan peminjaman</a>
    </div>
  </div>

  <div class="lab-toolbar">
    <label class="lab-search">
      <i class="bi bi-search"></i>
      <input type="search" id="cariLab" placeholder="Cari nama alat, merk, atau lokasi" aria-label="Cari alat">
    </label>
    <div class="lab-chips" id="chipKat">
      <button type="button" class="lab-chip active" data-kat="">Semua<em><%= alat.length %></em></button>
      <% kategoriList.forEach(function (k) { %><button type="button" class="lab-chip" data-kat="<%= k %>"><%= k %><em><%= _hitungKat[k] %></em></button><% }) %>
    </div>
  </div>

  <% if (alat.length === 0) { %>
    <div class="lab-empty"><i class="bi bi-motherboard"></i>Data peralatan laboratorium belum tersedia. Silakan kembali lagi nanti.</div>
  <% } %>

  <div class="tool-grid" id="gridLab">
    <% alat.forEach(function (a) { %>
      <button type="button" class="tool-card js-item" data-kat="<%= a.kategori %>" data-cari="<%= [a.nama, a.merk, a.lokasi, a.kategori, a.kode].join(' ').toLowerCase() %>"
        data-nama="<%= a.nama %>" data-kat-label="<%= a.kategori %>" data-merk="<%= a.merk %>" data-lokasi="<%= a.lokasi %>"
        data-ket="<%= a.keterangan %>" data-foto="<%= a.fotoUrl %>" data-kode="<%= a.kode %>" data-unit="<%= a.jumlahTotal %>" data-tersedia="<%= a.tersedia ? '1' : '0' %>">
        <span class="tool-photo <%= a.fotoUrl ? '' : 'no-photo' %>">
          <% if (a.fotoUrl) { %><img src="<%= a.fotoUrl %>" alt="<%= a.nama %>" loading="lazy" referrerpolicy="no-referrer"><% } %>
          <% if (a.kode) { %><span class="tool-tag"><%= a.kode %></span><% } %>
        </span>
        <span class="tool-body">
          <span class="tool-name"><%= a.nama %></span>
          <span class="tool-meta"><%= a.kategori %><% if (a.merk) { %> &middot; <%= a.merk %><% } %></span>
          <% if (a.lokasi) { %><span class="tool-meta"><i class="bi bi-geo-alt"></i> <%= a.lokasi %></span><% } %>
          <span class="tool-foot d-flex justify-content-between align-items-center">
            <span class="pill <%= a.tersedia ? 'ok' : 'mute' %>"><%= a.tersedia ? 'Tersedia' : 'Sedang dipakai' %></span>
            <span class="tool-meta"><%= a.jumlahTotal %> unit</span>
          </span>
        </span>
      </button>
    <% }) %>
  </div>
  <div id="kosongLab" class="lab-empty" style="display:none;"><i class="bi bi-search"></i>Tidak ada alat yang cocok. Coba kata kunci atau kategori lain.</div>
</div>

<div class="modal fade" id="modalLab" tabindex="-1" aria-labelledby="mlNama" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:1.1rem;overflow:hidden;">
      <div class="modal-body p-0">
        <div class="row g-0">
          <div class="col-md-6"><div class="tool-photo" id="mlFoto" style="aspect-ratio:auto;min-height:260px;height:100%;"></div></div>
          <div class="col-md-6 p-4">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <h5 class="fw-bold mb-1" id="mlNama" style="color:var(--lab-ink);"></h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="mb-3" id="mlStatus"></div>
            <dl class="lab-dl small mb-3">
              <dt>Kode</dt><dd id="mlKode"></dd>
              <dt>Kategori</dt><dd id="mlKat"></dd>
              <dt>Merk / model</dt><dd id="mlMerk"></dd>
              <dt>Lokasi</dt><dd id="mlLokasi"></dd>
              <dt>Jumlah</dt><dd id="mlUnit"></dd>
            </dl>
            <p class="small text-muted" id="mlKet"></p>
            <a href="/mahasiswa/peminjaman-alat/ajukan" class="btn btn-primary btn-sm rounded-pill px-3">Pinjam alat ini</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var items = document.querySelectorAll('.js-item'), chips = document.querySelectorAll('#chipKat .lab-chip');
    var cari = document.getElementById('cariLab'), kat = '';
    function saring() {
      var q = cari.value.trim().toLowerCase(), tampil = 0;
      items.forEach(function (it) {
        var ok = (!q || it.dataset.cari.indexOf(q) > -1) && (!kat || it.dataset.kat === kat);
        it.style.display = ok ? '' : 'none'; if (ok) tampil++;
      });
      document.getElementById('kosongLab').style.display = (items.length && !tampil) ? '' : 'none';
    }
    cari.addEventListener('input', saring);
    chips.forEach(function (c) { c.addEventListener('click', function () {
      chips.forEach(function (x) { x.classList.remove('active'); }); c.classList.add('active'); kat = c.dataset.kat; saring();
    }); });

    var modalEl = document.getElementById('modalLab');
    items.forEach(function (c) {
      c.addEventListener('click', function () {
        var d = c.dataset, foto = document.getElementById('mlFoto');
        document.getElementById('mlNama').textContent = d.nama;
        document.getElementById('mlKode').textContent = d.kode || '-';
        document.getElementById('mlKat').textContent = d.katLabel || '-';
        document.getElementById('mlMerk').textContent = d.merk || '-';
        document.getElementById('mlLokasi').textContent = d.lokasi || '-';
        document.getElementById('mlUnit').textContent = d.unit + ' unit';
        document.getElementById('mlKet').textContent = d.ket || '';
        document.getElementById('mlStatus').innerHTML = d.tersedia === '1'
          ? '<span class="pill ok">Tersedia</span>' : '<span class="pill mute">Sedang dipakai</span>';
        foto.innerHTML = '';
        foto.className = 'tool-photo' + (d.foto ? '' : ' no-photo');
        if (d.foto) { var im = document.createElement('img'); im.src = d.foto; im.alt = d.nama; im.referrerPolicy = 'no-referrer'; foto.appendChild(im); }
        new bootstrap.Modal(modalEl).show();
      });
    });
  })();
</script>
<%- include('../partials/footer-landing') %>
