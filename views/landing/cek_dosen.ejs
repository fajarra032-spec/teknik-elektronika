<%- include('../partials/header-landing') %>

<style>
  .search-card {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .result-card {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    padding: 1.5rem;
    overflow-x: auto;
  }
  .table-dosen {
    width: 100%;
    border-collapse: collapse;
  }
  .table-dosen th,
  .table-dosen td {
    padding: 1rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid #e9ecef;
  }
  .table-dosen th {
    background: linear-gradient(135deg, #0d6efd, #0dcaf0);
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .table-dosen tr:hover {
    background-color: #f8f9fa;
  }
  .search-box {
    display: flex;
    gap: 0.5rem;
    max-width: 500px;
    margin: 0 auto;
  }
  .search-box input {
    flex: 1;
    border-radius: 50px;
    padding: 0.75rem 1.2rem;
    border: 1px solid #dee2e6;
  }
  .search-box button {
    border-radius: 50px;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #0d6efd, #0dcaf0);
    border: none;
    color: white;
    font-weight: 600;
  }
  .info-jumlah {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #6c757d;
  }
</style>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <h2 class="section-title text-center mb-4">Cek Data <span>Dosen</span></h2>
      
      <div class="search-card">
        <form method="GET" action="/cekdosen" class="search-box">
          <input type="text" name="search" class="form-control" placeholder="Cari berdasarkan NUPTK atau Nama..." value="<%= search %>">
          <button type="submit"><i class="bi bi-search"></i> Cari</button>
        </form>
        <div class="info-jumlah text-center">
          Menampilkan <strong><%= dosen.length %></strong> dosen
        </div>
      </div>

      <div class="result-card">
        <div class="table-responsive">
          <table class="table-dosen">
            <thead>
              <tr>
                <th>NUPTK</th>
                <th>Nama</th>
                <th>Bidang / Keahlian</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody>
              <% if (dosen.length === 0) { %>
                <tr><td colspan="4" class="text-center py-5">Tidak ada data dosen yang ditemukan.</td></tr>
              <% } else { %>
                <% dosen.forEach(d => { %>
                  <tr>
                    <td><strong><%= d.nuptk || '-' %></strong></td>
                    <td><%= d.nama || '-' %></td>
                    <td><%= d.bidang || d.keahlian || '-' %></td>
                    <td><%= d.email || '-' %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer-landing') %>