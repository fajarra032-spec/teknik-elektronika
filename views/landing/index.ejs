    <!-- VIDEO KONTEN - dinamis dari koleksi videoKonten (dikelola admin di
         /admin/video-konten), bukan lagi 4 video tetap hardcode. -->
    <section class="section-wrapper">
        <h2 class="section-title">Video <span>Konten</span></h2>
        <% if (!videoKonten || videoKonten.length === 0) { %>
            <div class="alert alert-info text-center">Belum ada video yang ditambahkan.</div>
        <% } else { %>
            <div id="videoCarousel" class="carousel slide video-carousel">
                <div class="carousel-indicators">
                    <% videoKonten.forEach((v, idx) => { %>
                        <button type="button" data-bs-target="#videoCarousel" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>" <% if (idx === 0) { %>aria-current="true"<% } %> aria-label="Slide <%= idx + 1 %>"></button>
                    <% }) %>
                </div>
                <div class="carousel-inner">
                    <% videoKonten.forEach((v, idx) => { %>
                        <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                            <div class="video-slide">
                                <div class="video-wrapper">
                                    <video controls preload="metadata">
                                        <source src="<%= v.videoUrl %>" type="video/mp4">
                                        Browser Anda tidak mendukung video.
                                    </video>
                                </div>
                                <div class="video-caption">
                                    <h5><%= v.judul %></h5>
                                    <% if (v.deskripsi) { %><p><%= v.deskripsi %></p><% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <% if (videoKonten.length > 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#videoCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#videoCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                <% } %>
            </div>
        <% } %>
    </section>

    <!-- TESTIMONI ALUMNI - dinamis dari koleksi testimoniAlumni (dikelola
         admin di /admin/testimoni), bukan lagi 3 nama tetap hardcode. -->
    <section class="section-wrapper">
        <h2 class="section-title">Apa Kata <span>Alumni?</span></h2>
        <% if (!testimoniAlumni || testimoniAlumni.length === 0) { %>
            <div class="alert alert-info text-center">Belum ada testimoni yang ditambahkan.</div>
        <% } else { %>
            <div id="testimoniCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <% testimoniAlumni.forEach((t, idx) => { %>
                        <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                            <div class="testimonial-card">
                                <i class="bi bi-quote"></i>
                                <% if (t.foto) { %>
                                    <img src="<%= t.foto %>" class="testimonial-img" alt="<%= t.nama %>" onerror="this.src='https://via.placeholder.com/100?text=Alumni'">
                                <% } else { %>
                                    <img src="https://via.placeholder.com/100?text=Alumni" class="testimonial-img" alt="<%= t.nama %>">
                                <% } %>
                                <h5 class="testimonial-name"><%= t.nama %></h5>
                                <p class="testimonial-role">
                                    <%= t.role || 'Alumni' %><% if (t.tahunLulus) { %> (Lulusan <%= t.tahunLulus %>)<% } %>
                                </p>
                                <p class="testimonial-text">"<%= t.testimoni %>"</p>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <% if (testimoniAlumni.length > 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#testimoniCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#testimoniCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                <% } %>
            </div>
        <% } %>
    </section>
</div> <!-- penutup container utama -->



<script>
    // Klik pada gambar carousel untuk membuka modal (gunakan Bootstrap Modal)
    const carouselImages = document.querySelectorAll('#magangCarousel .carousel-item img');
    const modalHtml = `
        <div class="modal fade" id="magangModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content bg-dark text-white">
                    <div class="modal-header border-0">
                        <h5 class="modal-title">Dokumentasi Magang</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img id="modalMagangImg" src="" class="img-fluid rounded" alt="Preview">
                        <p id="modalMagangCaption" class="mt-3"></p>
                    </div>
                </div>
            </div>
        </div>
    `;
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    
    carouselImages.forEach(img => {
        img.style.cursor = 'pointer';
        img.addEventListener('click', function() {
            const src = this.src;
            const captionElem = this.closest('.carousel-item').querySelector('.carousel-caption');
            const captionText = captionElem ? captionElem.innerText : 'Dokumentasi Magang';
            document.getElementById('modalMagangImg').src = src;
            document.getElementById('modalMagangCaption').innerText = captionText;
            const modal = new bootstrap.Modal(document.getElementById('magangModal'));
            modal.show();
        });
    });
</script>

