                <div class="id-card">
                    <div class="id-card-img-wrapper">
                        <img src="https://i.ibb.co.com/5XfTGCqb/GUNAWAN.png" class="id-card-img" alt="Gunawan Tari">
                        <div class="id-card-social">
                            <a href="#"><i class="bi bi-envelope"></i></a>
                            <a href="#"><i class="bi bi-linkedin"></i></a>
