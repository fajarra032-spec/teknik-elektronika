<%- include('../../partials/header-landing') %>

<%
  // Fungsi untuk mengekstrak file ID dari URL Google Drive & bikin URL
  // thumbnail langsung (webViewLink dari Drive itu halaman HTML, BUKAN file
  // gambar - kalau dipakai langsung di <img src> browser gagal muat &
  // fallback ke placeholder berkali-kali, kelihatan seperti flicker).
  // Konvensi yang sama dipakai di views/landing/index.ejs & views/admin/mahasiswa_list.ejs.
  const getFileIdFromUrl = (url) => {
    if (!url) return null;
    let match = url.match(/[?&]id=([^&]+)/);
    if (match) return match[1];
    match = url.match(/\/d\/([^\/]+)/);
    if (match) return match[1];
    return null;
  };
%>

<style>
  .hero-yudisium {
    background: linear-gradient(135deg, #6a3093, #a044ff);
    padding: 4rem 0;
    color: white;
    margin-bottom: 3rem;
  }
  .hero-yudisium h1 {
    font-size: 3rem;
    font-weight: 700;
  }

  .tahun-card {
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    transition: transform 0.3s, box-shadow 0.3s;
    height: 100%;
    text-decoration: none;
    display: block;
    color: inherit;
  }
  .tahun-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 30px rgba(106,48,147,0.15);
    color: inherit;
  }
  .tahun-card .card-img-wrapper {
    height: 220px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, #6a3093, #a044ff);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tahun-card .card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .tahun-card:hover .card-img-wrapper img {
    transform: scale(1.1);
  }
  .tahun-card .card-img-wrapper i {
    font-size: 4rem;
    color: rgba(255,255,255,0.85);
  }
  .tahun-card .card-body {
    padding: 1.5rem;
    text-align: center;
  }
  .tahun-card .tahun-angka {
    font-size: 1.8rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.25rem;
  }
  .tahun-card .jumlah {
    color: #64748b;
    font-weight: 500;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: #f8f9fa;
    border-radius: 1rem;
  }
  .empty-state i {
    font-size: 5rem;
    color: #ced4da;
    margin-bottom: 1rem;
  }
</style>

<section class="hero-yudisium">
  <div class="container text-center">
    <h1><i class="bi bi-mortarboard-fill me-2"></i>Yudisium</h1>
    <p class="lead">Dokumentasi kelulusan mahasiswa Teknik Elektronika Politeknik Dewantara, per tahun angkatan wisuda</p>
  </div>
</section>

<div class="container mb-5">
  <% if (daftarTahun.length === 0) { %>
    <div class="empty-state">
      <i class="bi bi-emoji-frown"></i>
      <h4>Belum Ada Data Yudisium</h4>
      <p class="text-muted">Saat ini belum ada mahasiswa yang ditandai lulus dengan data yudisium.</p>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% daftarTahun.forEach(t => { %>
        <div class="col-lg-4 col-md-6">
          <a href="/yudisium/<%= t.tahun %>" class="tahun-card">
            <div class="card-img-wrapper">
              <% if (t.fotoSampul) {
                   const sampulFileId = getFileIdFromUrl(t.fotoSampul); %>
                <img src="<%= sampulFileId ? `https://drive.google.com/thumbnail?id=${sampulFileId}&sz=w500` : t.fotoSampul %>"
                     alt="Yudisium <%= t.tahun %>"
                     onerror="this.onerror=null; this.src='<%= t.fotoSampul %>';">
              <% } else { %>
                <i class="bi bi-mortarboard-fill"></i>
              <% } %>
            </div>
            <div class="card-body">
              <div class="tahun-angka">Yudisium <%= t.tahun %></div>
              <div class="jumlah"><%= t.jumlah %> lulusan</div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer-landing') %>
