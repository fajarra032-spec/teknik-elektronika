<%
  // ===== DATA PMB (ubah di sini saja bila ada perubahan) =====
  const pmb = {
    gelombang: 'Gelombang II',
    tahunAkademik: '2027/2028',
    biayaPendaftaran: 'Rp200.000',
    kontak: {
      nama: 'Fajar Ramadhan, S.Pd., M.T',
      jabatan: 'Ketua Program Studi Teknik Elektronika',
      tampil: '0852-4245-9746',
      wa: '6285242459746',
      tel: '+6285242459746'
    },
    instagram: [
      { label: '@politeknikdewantara', url: 'https://www.instagram.com/politeknikdewantara' },
      { label: '@pmbpoliteknikdewantara', url: 'https://www.instagram.com/pmbpoliteknikdewantara' }
    ],
    d3: [
      { nama: 'Teknik Sipil', spp: 1200000, icon: 'bi-bricks' },
      { nama: 'Mesin Otomotif', spp: 1200000, icon: 'bi-gear-wide-connected' },
      { nama: 'Teknik Elektronika', spp: 1200000, icon: 'bi-cpu' }
    ],
    d4: [
      { nama: 'Teknologi Rekayasa Multimedia', gelar: 'S.Tr.Kom', spp: 1200000, icon: 'bi-film' },
      { nama: 'Teknologi Rekayasa Pangan', gelar: 'S.Tr.P', spp: 1200000, icon: 'bi-egg-fried' },
      { nama: 'Arsitektur Bangunan Gedung', gelar: 'S.Tr.Ars', spp: 1200000, icon: 'bi-buildings' },
      { nama: 'Teknologi Pertambangan (Metalurgi)', gelar: 'S.Tr.T', spp: 1800000, icon: 'bi-minecart-loaded' }
    ]
  };
  const rp = n => 'Rp' + Number(n).toLocaleString('id-ID');
%>
<%- include('../partials/header-landing') %>

<style>
    :root {
        --pmb-navy: #061a3f;
        --pmb-blue: #0b5ed7;
        --pmb-sky: #38bdf8;
        --pmb-gold: #fbbf24;
        --pmb-ink: #0f172a;
        --pmb-muted: #64748b;
    }

    .pmb-page { background: #f1f5f9; padding-bottom: 4rem; }

    /* ===== HERO ===== */
    .pmb-hero {
        position: relative;
        overflow: hidden;
        color: #fff;
        padding: 4rem 0 6.5rem;
        background:
            radial-gradient(900px 400px at 85% 0%, rgba(56,189,248,.35), transparent 60%),
            radial-gradient(700px 400px at 0% 100%, rgba(11,94,215,.55), transparent 60%),
            linear-gradient(160deg, #061a3f 0%, #0a2e72 55%, #0b5ed7 100%);
    }
    .pmb-hero::after {
        content: '';
        position: absolute; inset: 0;
        background-image: radial-gradient(rgba(255,255,255,.12) 1px, transparent 1px);
        background-size: 26px 26px;
        mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
        pointer-events: none;
    }
    .pmb-hero .container { position: relative; z-index: 2; }
    .pmb-eyebrow {
        display: inline-flex; align-items: center; gap: .5rem;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.25);
        backdrop-filter: blur(8px);
        padding: .4rem 1rem; border-radius: 999px;
        font-size: .85rem; font-weight: 600; letter-spacing: .04em;
    }
    .pmb-hero h1 {
        font-weight: 800;
        font-size: clamp(2rem, 6.5vw, 3.6rem);
        line-height: 1.08;
        margin: 1rem 0 .75rem;
        letter-spacing: -.02em;
    }
    .pmb-hero h1 span { color: var(--pmb-sky); }
    .pmb-gel {
        display: inline-block;
        background: rgba(2, 10, 35, .55);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: .9rem;
        padding: .6rem 1.2rem;
        font-weight: 700;
        font-size: clamp(1rem, 3.2vw, 1.35rem);
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }
    .pmb-hero p.sub { max-width: 560px; color: rgba(255,255,255,.85); margin: 1.25rem 0 1.75rem; }
    .btn-hero {
        border-radius: 999px; font-weight: 700; padding: .8rem 1.6rem;
        transition: transform .2s, box-shadow .2s;
    }
    .btn-hero:hover { transform: translateY(-3px); }
    .btn-hero-main { background: var(--pmb-gold); color: #1e293b; border: 0; box-shadow: 0 10px 25px rgba(251,191,36,.35); }
    .btn-hero-main:hover { color: #1e293b; box-shadow: 0 14px 30px rgba(251,191,36,.5); }
    .btn-hero-ghost { background: rgba(255,255,255,.1); color: #fff; border: 1px solid rgba(255,255,255,.4); }
    .btn-hero-ghost:hover { background: rgba(255,255,255,.2); color: #fff; }

    .hero-flyer {
        position: relative; display: block; max-width: 340px; margin: 0 auto;
        border-radius: 1.2rem; overflow: hidden;
        box-shadow: 0 30px 60px -15px rgba(0,0,0,.55), 0 0 0 6px rgba(255,255,255,.12);
        transform: rotate(2.5deg);
        transition: transform .3s;
        cursor: zoom-in;
    }
    .hero-flyer:hover { transform: rotate(0deg) scale(1.02); }
    .hero-flyer img { width: 100%; display: block; }
    .hero-flyer .zoom-tip {
        position: absolute; right: .6rem; bottom: .6rem;
        background: rgba(2,10,35,.75); color: #fff; font-size: .75rem;
        padding: .25rem .6rem; border-radius: 999px;
    }

    /* ===== STAT STRIP ===== */
    .stat-strip { margin-top: -3.5rem; position: relative; z-index: 5; }
    .stat-card {
        background: #fff; border-radius: 1.1rem; padding: 1.1rem 1.25rem; height: 100%;
        box-shadow: 0 15px 35px -12px rgba(15,23,42,.18);
        display: flex; align-items: center; gap: .9rem;
    }
    .stat-card .ico {
        flex: 0 0 48px; height: 48px; border-radius: 14px;
        display: grid; place-items: center; font-size: 1.4rem; color: #fff;
        background: linear-gradient(135deg, var(--pmb-blue), var(--pmb-sky));
    }
    .stat-card .ico.gold { background: linear-gradient(135deg, #f59e0b, var(--pmb-gold)); }
    .stat-card .ico.green { background: linear-gradient(135deg, #059669, #34d399); }
    .stat-card small { color: var(--pmb-muted); display: block; font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
    .stat-card strong { color: var(--pmb-ink); font-size: 1.15rem; }

    /* ===== SECTION ===== */
    .pmb-section { padding-top: 3.5rem; }
    .sec-head { margin-bottom: 1.5rem; }
    .sec-head .tag {
        color: var(--pmb-blue); font-weight: 700; font-size: .8rem;
        text-transform: uppercase; letter-spacing: .12em;
    }
    .sec-head h2 { font-weight: 800; color: var(--pmb-ink); font-size: clamp(1.4rem, 4.5vw, 2rem); margin: .25rem 0 0; }
    .sec-head p { color: var(--pmb-muted); margin: .4rem 0 0; }

    /* ===== PRODI ===== */
    .jenjang-label {
        display: inline-flex; align-items: center; gap: .6rem;
        background: linear-gradient(135deg, #0a2e72, #0b5ed7);
        color: #fff; font-weight: 700; padding: .55rem 1.2rem;
        border-radius: .8rem; margin-bottom: 1rem;
        box-shadow: 0 8px 20px -6px rgba(11,94,215,.5);
    }
    .prodi-card {
        position: relative; background: #fff; border-radius: 1.1rem;
        padding: 1.25rem; height: 100%;
        border: 1px solid #e2e8f0;
        transition: transform .25s, box-shadow .25s, border-color .25s;
        display: flex; flex-direction: column; gap: .35rem;
    }
    .prodi-card:hover { transform: translateY(-5px); box-shadow: 0 20px 35px -15px rgba(11,94,215,.35); border-color: #93c5fd; }
    .prodi-card .p-ico {
        width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center;
        background: #e0f2fe; color: var(--pmb-blue); font-size: 1.35rem; margin-bottom: .4rem;
    }
    .prodi-card h3 { font-size: 1.02rem; font-weight: 700; color: var(--pmb-ink); margin: 0; }
    .prodi-card .gelar { font-size: .8rem; color: var(--pmb-muted); }
    .prodi-card .spp { margin-top: auto; padding-top: .8rem; border-top: 1px dashed #e2e8f0; }
    .prodi-card .spp small { color: var(--pmb-muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; display: block; }
    .prodi-card .spp b { font-size: 1.2rem; color: var(--pmb-blue); }
    .prodi-card .spp i { color: var(--pmb-muted); font-style: normal; font-size: .8rem; }
    .prodi-card.highlight { border-color: var(--pmb-gold); box-shadow: 0 0 0 3px rgba(251,191,36,.25); }
    .prodi-card .ribbon {
        position: absolute; top: .8rem; right: .8rem;
        background: var(--pmb-gold); color: #1e293b; font-size: .68rem; font-weight: 800;
        padding: .2rem .6rem; border-radius: 999px; letter-spacing: .03em;
    }

    /* ===== BEASISWA BANNER ===== */
    .beasiswa-banner {
        border-radius: 1.3rem; color: #fff; padding: 1.75rem;
        background: linear-gradient(135deg, #061a3f, #0b5ed7);
        display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
        box-shadow: 0 20px 40px -15px rgba(6,26,63,.6);
    }
    .beasiswa-banner .b-ico {
        flex: 0 0 64px; height: 64px; border-radius: 18px; display: grid; place-items: center;
        background: rgba(251,191,36,.18); color: var(--pmb-gold); font-size: 2rem;
    }
    .beasiswa-banner h3 { font-weight: 800; margin: 0 0 .25rem; font-size: 1.3rem; }
    .beasiswa-banner p { margin: 0; color: rgba(255,255,255,.85); }
    .beasiswa-banner .b-txt { flex: 1 1 260px; }

    /* ===== PEMBAYARAN ===== */
    .info-card {
        background: #fff; border-radius: 1.1rem; padding: 1.4rem; height: 100%;
        border: 1px solid #e2e8f0;
    }
    .info-card .i-ico {
        width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center;
        font-size: 1.3rem; color: #fff; margin-bottom: .8rem;
        background: linear-gradient(135deg, var(--pmb-blue), var(--pmb-sky));
    }
    .info-card h4 { font-size: 1.05rem; font-weight: 700; color: var(--pmb-ink); }
    .info-card p { color: #475569; font-size: .92rem; margin-bottom: .5rem; }
    .big-price { font-size: 2rem; font-weight: 800; color: var(--pmb-blue); line-height: 1; }
    .rek-item { padding: .6rem 0; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
    .rek-item:last-child { border-bottom: 0; }
    .rek-item .bank { font-weight: 700; color: var(--pmb-ink); font-size: .9rem; }
    .rek-item .no { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92rem; color: #334155; }
    .btn-copy {
        border: 1px solid #cbd5e1; background: #fff; color: #475569; border-radius: 8px;
        font-size: .75rem; padding: .2rem .55rem; transition: .2s;
    }
    .btn-copy:hover { background: var(--pmb-blue); color: #fff; border-color: var(--pmb-blue); }
    .btn-copy.ok { background: #059669; color: #fff; border-color: #059669; }

    /* ===== LANGKAH ===== */
    .step-card { background: #fff; border-radius: 1.1rem; padding: 1.25rem; height: 100%; border: 1px solid #e2e8f0; position: relative; }
    .step-card .no {
        width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
        background: var(--pmb-navy); color: #fff; font-weight: 800; margin-bottom: .7rem;
    }
    .step-card h5 { font-size: 1rem; font-weight: 700; color: var(--pmb-ink); }
    .step-card p { font-size: .88rem; color: var(--pmb-muted); margin: 0; }

    /* ===== KONTAK ===== */
    .contact-card {
        background: #fff; border-radius: 1.3rem; overflow: hidden;
        box-shadow: 0 20px 40px -18px rgba(15,23,42,.25); border: 1px solid #e2e8f0;
    }
    .contact-card .c-main { padding: 1.75rem; }
    .contact-avatar {
        width: 72px; height: 72px; border-radius: 50%; flex: 0 0 72px;
        display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 1.6rem;
        background: linear-gradient(135deg, var(--pmb-navy), var(--pmb-blue));
        box-shadow: 0 0 0 5px #dbeafe;
    }
    .contact-card h4 { font-weight: 800; margin: 0; color: var(--pmb-ink); font-size: 1.2rem; }
    .contact-card .role { color: var(--pmb-muted); font-size: .92rem; }
    .btn-wa {
        background: #25D366; color: #fff; border: 0; border-radius: 999px; font-weight: 700;
        padding: .7rem 1.4rem; display: inline-flex; align-items: center; gap: .5rem; transition: .2s;
    }
    .btn-wa:hover { background: #128C7E; color: #fff; transform: translateY(-2px); }
    .btn-call {
        background: #fff; color: var(--pmb-blue); border: 1px solid #bfdbfe; border-radius: 999px; font-weight: 700;
        padding: .7rem 1.4rem; display: inline-flex; align-items: center; gap: .5rem; transition: .2s;
    }
    .btn-call:hover { background: #eff6ff; color: var(--pmb-blue); }
    .contact-card .c-foot { background: #f8fafc; padding: 1rem 1.75rem; border-top: 1px solid #e2e8f0; font-size: .9rem; }
    .contact-card .c-foot a { color: var(--pmb-blue); font-weight: 600; text-decoration: none; margin-right: 1.1rem; display: inline-block; }
    .contact-card .c-foot a:hover { text-decoration: underline; }

    /* ===== FORM ===== */
    .form-shell {
        background: #fff; border-radius: 1.3rem; padding: 2rem;
        box-shadow: 0 20px 40px -18px rgba(15,23,42,.2); border: 1px solid #e2e8f0;
    }
    .form-control, .form-select { border-radius: .75rem; padding: .7rem 1rem; border: 1px solid #cbd5e1; }
    .form-control:focus, .form-select:focus { box-shadow: 0 0 0 .25rem rgba(13,110,253,.15); border-color: #0d6efd; }
    .input-group-text { border-radius: .75rem 0 0 .75rem; background: #f8fafc; border: 1px solid #cbd5e1; color: #64748b; }
    .input-group > .form-control, .input-group > .form-select { border-radius: 0 .75rem .75rem 0; }
    .wa-link-group { display: flex; flex-wrap: wrap; gap: .5rem; }
    .wa-link-group a {
        background: #25D366; color: #fff; padding: .4rem 1rem; border-radius: 999px; font-size: .85rem;
        text-decoration: none; display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; transition: .2s;
    }
    .wa-link-group a:hover { background: #128C7E; transform: translateY(-2px); }
    .btn-submit {
        background: linear-gradient(135deg, #0a2e72, #0b5ed7); color: #fff; border: 0; border-radius: 999px;
        padding: .85rem 2.4rem; font-weight: 700; font-size: 1.05rem; transition: .2s;
        box-shadow: 0 12px 25px -8px rgba(11,94,215,.6);
    }
    .btn-submit:hover { transform: translateY(-3px); color: #fff; box-shadow: 0 16px 30px -8px rgba(11,94,215,.75); }
    .biaya-note {
        background: #eff6ff; border: 1px solid #bfdbfe; color: #1e3a8a; border-radius: .9rem;
        padding: .8rem 1rem; font-size: .9rem;
    }

    /* ===== FLOATING WA ===== */
    .wa-float {
        position: fixed; right: 18px; bottom: 18px; z-index: 1040;
        background: #25D366; color: #fff; width: 58px; height: 58px; border-radius: 50%;
        display: grid; place-items: center; font-size: 1.9rem; text-decoration: none;
        box-shadow: 0 12px 28px rgba(37,211,102,.5); animation: pulseWa 2.4s infinite;
    }
    .wa-float:hover { color: #fff; background: #128C7E; }
    @keyframes pulseWa {
        0% { box-shadow: 0 0 0 0 rgba(37,211,102,.55), 0 12px 28px rgba(37,211,102,.5); }
        70% { box-shadow: 0 0 0 16px rgba(37,211,102,0), 0 12px 28px rgba(37,211,102,.5); }
        100% { box-shadow: 0 0 0 0 rgba(37,211,102,0), 0 12px 28px rgba(37,211,102,.5); }
    }

    @media (max-width: 991px) {
        .pmb-hero { padding: 3rem 0 6rem; text-align: center; }
        .pmb-hero p.sub { margin-left: auto; margin-right: auto; }
        .hero-flyer { margin-top: 2rem; max-width: 280px; }
    }
    @media (max-width: 576px) {
        .form-shell { padding: 1.25rem; }
        .contact-card .c-main { padding: 1.25rem; }
        .btn-submit, .btn-reset { width: 100%; }
        .rek-item { flex-wrap: wrap; }
    }
    @media (prefers-reduced-motion: reduce) {
        .wa-float { animation: none; }
        .hero-flyer, .prodi-card, .btn-hero { transition: none; }
    }
</style>

<div class="pmb-page">

    <!-- ===== HERO ===== -->
    <section class="pmb-hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="pmb-eyebrow"><i class="bi bi-mortarboard-fill"></i> Politeknik Dewantara · Palopo</span>
                    <h1>Penerimaan <span>Mahasiswa Baru</span></h1>
                    <div class="pmb-gel"><%= pmb.gelombang %> · Tahun Akademik <%= pmb.tahunAkademik %></div>
                    <p class="sub">Pilih 3 program Diploma Tiga atau 4 program Sarjana Terapan. Tersedia beasiswa bagi yang kurang mampu dan berprestasi.</p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start">
                        <a href="#pendaftaran" class="btn btn-hero btn-hero-main">Daftar Sekarang <i class="bi bi-arrow-down-circle ms-1"></i></a>
                        <a href="#program-studi" class="btn btn-hero btn-hero-ghost">Lihat Program Studi</a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <a class="hero-flyer" href="/images/pmb-gelombang2-2027-2028.jpg" target="_blank" rel="noopener" aria-label="Lihat flyer PMB ukuran penuh">
                        <img src="/images/pmb-gelombang2-2027-2028.jpg" alt="Flyer Penerimaan Mahasiswa Baru Gelombang II Tahun Akademik 2027/2028 Politeknik Dewantara">
                        <span class="zoom-tip"><i class="bi bi-zoom-in"></i> Flyer</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <div class="container">

        <!-- ===== STAT STRIP ===== -->
        <div class="row g-3 stat-strip">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="ico"><i class="bi bi-journal-bookmark-fill"></i></div>
                    <div><small>Program Studi</small><strong><%= pmb.d3.length + pmb.d4.length %> pilihan (D3 &amp; D4)</strong></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="ico gold"><i class="bi bi-ticket-perforated-fill"></i></div>
                    <div><small>Biaya Pendaftaran</small><strong><%= pmb.biayaPendaftaran %></strong></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="ico green"><i class="bi bi-award-fill"></i></div>
                    <div><small>Beasiswa</small><strong>Kurang mampu &amp; berprestasi</strong></div>
                </div>
            </div>
        </div>

        <!-- ===== PROGRAM STUDI & SPP ===== -->
        <section id="program-studi" class="pmb-section">
            <div class="sec-head">
                <div class="tag">Program Studi</div>
                <h2>Pilih jalur kariermu</h2>
                <p>Biaya SPP ditampilkan per semester sesuai ketentuan Gelombang II.</p>
            </div>

            <div class="jenjang-label"><i class="bi bi-diagram-3-fill"></i> Diploma Tiga (A.Md.T)</div>
            <div class="row g-3 mb-4">
                <% pmb.d3.forEach(function(p){ %>
                <div class="col-sm-6 col-lg-4">
                    <div class="prodi-card <%= p.nama === 'Teknik Elektronika' ? 'highlight' : '' %>">
                        <% if (p.nama === 'Teknik Elektronika') { %><span class="ribbon">Kaprodi: Fajar</span><% } %>
                        <div class="p-ico"><i class="bi <%= p.icon %>"></i></div>
                        <h3><%= p.nama %></h3>
                        <span class="gelar">Gelar: A.Md.T</span>
                        <div class="spp"><small>Biaya SPP</small><b><%= rp(p.spp) %></b> <i>/ semester</i></div>
                    </div>
                </div>
                <% }); %>
            </div>

            <div class="jenjang-label"><i class="bi bi-diagram-3-fill"></i> Sarjana Terapan</div>
            <div class="row g-3">
                <% pmb.d4.forEach(function(p){ %>
                <div class="col-sm-6 col-lg-3">
                    <div class="prodi-card">
                        <div class="p-ico"><i class="bi <%= p.icon %>"></i></div>
                        <h3><%= p.nama %></h3>
                        <span class="gelar">Gelar: <%= p.gelar %></span>
                        <div class="spp"><small>Biaya SPP</small><b><%= rp(p.spp) %></b> <i>/ semester</i></div>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>

        <!-- ===== BEASISWA ===== -->
        <section class="pmb-section" style="padding-top:2.5rem;">
            <div class="beasiswa-banner">
                <div class="b-ico"><i class="bi bi-stars"></i></div>
                <div class="b-txt">
                    <h3>Tersedia Beasiswa Bagi yang Kurang Mampu dan Berprestasi</h3>
                    <p>Pilih jalur <strong>Beasiswa</strong> pada formulir pendaftaran, lalu bergabung ke grup WhatsApp sesuai jenis beasiswa.</p>
                </div>
                <a href="#pendaftaran" class="btn btn-hero btn-hero-main">Daftar Jalur Beasiswa</a>
            </div>
        </section>

        <!-- ===== PEMBAYARAN ===== -->
        <section class="pmb-section">
            <div class="sec-head">
                <div class="tag">Pembayaran</div>
                <h2>Biaya pendaftaran &amp; rekening tujuan</h2>
            </div>
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="info-card">
                        <div class="i-ico"><i class="bi bi-receipt-cutoff"></i></div>
                        <h4>Biaya Pendaftaran</h4>
                        <div class="big-price mb-2"><%= pmb.biayaPendaftaran %></div>
                        <p>Dibayarkan sekali di awal. Biaya SPP per program studi tercantum pada bagian Program Studi di atas.</p>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="info-card">
                        <div class="i-ico"><i class="bi bi-bank2"></i></div>
