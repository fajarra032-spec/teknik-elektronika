<%- include('../partials/header-landing') %>

<style>
    /* ===== PMB PAGE STYLES (mempercantik & konsisten) ===== */
    .pmb-page-wrapper {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 2rem 0 4rem;
    }

    /* Hero Section */
    .pmb-hero {
        background: linear-gradient(145deg, #0b5ed7, #0a58ca);
        border-radius: var(--border-radius);
        padding: 4rem 2rem;
        text-align: center;
        color: white !important;
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.2);
    }
    .pmb-hero::before {
        content: '';
        position: absolute;
        top: -30%;
        left: -30%;
        width: 160%;
        height: 160%;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
        z-index: 1;
        animation: slowRotate 20s infinite linear;
    }
    @keyframes slowRotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .pmb-hero-content {
        position: relative;
        z-index: 2;
    }
    .pmb-hero-content h1, 
    .pmb-hero-content p, 
    .pmb-hero-content .lead,
    .pmb-hero-content small {
        color: #ffffff !important;
        text-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    /* Gelombang Badge */
    .gelombang-badge {
        display: inline-block;
        background: linear-gradient(145deg, #ffc107, #ffb300);
        color: #1e293b;
        font-size: 1.8rem;
        font-weight: 800;
        padding: 0.6rem 2rem;
        border-radius: 60px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        letter-spacing: 1px;
        margin-bottom: 1rem;
    }
    .gelombang-badge i {
        margin-right: 0.75rem;
        font-size: 2rem;
        vertical-align: middle;
    }

    /* Countdown Box */
    .countdown-box {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: var(--border-radius);
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        transition: all 0.3s;
    }
    .countdown-box:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: scale(1.02);
    }
    .countdown-number {
        font-size: 2.5rem;
        font-weight: 800;
        font-family: 'Montserrat', sans-serif;
        color: #ffffff !important;
        line-height: 1.2;
        text-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    /* Button Umum */
    .btn-pmb {
        background: linear-gradient(145deg, #ffffff, #f8fafc);
        border: none;
        border-radius: 50px;
        padding: 0.85rem 2rem;
        font-weight: 700;
        color: #0a58ca;
        transition: all 0.3s;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    .btn-pmb:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        color: #084298;
    }

    /* Section Wrapper */
    .section-wrapper {
        background: #ffffff;
        border-radius: 1.5rem;
        padding: 2rem 2rem;
        box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.05);
        margin-bottom: 2.5rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .section-wrapper:hover {
        box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.1);
    }
    .section-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 2rem;
        font-size: 1.85rem;
        position: relative;
        display: inline-block;
    }
    .section-title span {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .section-title:after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #0d6efd, #0dcaf0);
        border-radius: 4px;
    }

    /* Table Biaya */
    .table-pmb {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }
    .table-pmb thead th {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        color: white;
        padding: 1rem;
        font-weight: 600;
        border: none;
    }
    .table-pmb tbody tr {
        transition: background 0.2s;
        border-bottom: 1px solid #e2e8f0;
    }
    .table-pmb tbody tr:hover {
        background: #f8fafc;
    }
    .table-pmb td, .table-pmb th {
        padding: 1rem;
        vertical-align: middle;
    }

    /* Info Card */
    .info-card {
        background: #ffffff;
        border-radius: 1.5rem;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
        border: 1px solid #eef2ff;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.02);
    }
    .info-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 25px -12px rgba(0, 0, 0, 0.1);
        border-color: rgba(13, 110, 253, 0.3);
    }
    .info-card i.main-icon {
        font-size: 2.5rem;
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: 1rem;
    }
    .info-card h4 {
        font-weight: 700;
        margin-bottom: 1rem;
        color: #0f172a;
    }
    .info-card p {
        color: #475569;
        font-size: 0.9rem;
    }

    /* Form styling */
    .form-control, .form-select {
        border: 1px solid #cbd5e1;
        border-radius: 0.75rem;
        padding: 0.7rem 1rem;
        transition: all 0.2s;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.2);
    }
    .input-group-text {
        background-color: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 0.75rem 0 0 0.75rem;
        color: #0d6efd;
    }
    .btn-outline-secondary {
        border-radius: 50px;
        padding: 0.6rem 1.5rem;
    }
    .wa-link-group {
        background: #f1f5f9;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .wa-link-group a {
        background: #25D366;
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        text-decoration: none;
        font-size: 0.85rem;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .wa-link-group a:hover {
        background: #128C7E;
        transform: translateY(-2px);
    }
    .alert-success-custom {
        background: linear-gradient(145deg, #d1e7dd, #b8e0c2);
        border: none;
        border-radius: 1rem;
        padding: 1.2rem;
    }
</style>

