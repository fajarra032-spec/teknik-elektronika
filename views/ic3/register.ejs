  <div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8 text-center border-t border-slate-200 mt-12">
    <p class="text-xs text-slate-500 font-medium">Didukung oleh penyedia layanan sertifikasi resmi:</p>
    <div class="flex justify-center gap-6 mt-2">
      <span class="bg-slate-100 text-slate-700 text-[11px] font-mono px-4 py-1.5 rounded border border-slate-200 font-semibold">CERTI PORT</span>
      <span class="bg-slate-100 text-slate-700 text-[11px] font-mono px-4 py-1.5 rounded border border-slate-200 font-semibold">ITC INDONESIA</span>
    </div>
    
  <!-- ============================================================ -->
  <!-- SCRIPTS (JavaScript tetap sama)                              -->
  <!-- ============================================================ -->
  <script>
    // Inisialisasi icon Lucide
    lucide.createIcons();

    // ------------------------------
    // 1. TAB SWITCHING
    // ------------------------------
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabContents = {
      info: document.getElementById('tab-info'),
      search: document.getElementById('tab-search'),
      admin: document.getElementById('tab-admin'),
    };

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tabButtons.forEach(b => {
          b.classList.remove('bg-white', 'text-dewantara-blue', 'shadow-sm', 'font-semibold');
          b.classList.add('text-slate-600', 'hover:bg-white/40', 'hover:text-slate-900');
        });
        btn.classList.add('bg-white', 'text-dewantara-blue', 'shadow-sm', 'font-semibold');
        btn.classList.remove('text-slate-600', 'hover:bg-white/40', 'hover:text-slate-900');

        Object.values(tabContents).forEach(el => el.classList.add('hidden'));
        const tab = btn.dataset.tab;
        if (tabContents[tab]) tabContents[tab].classList.remove('hidden');
      });
    });

    // ------------------------------
    // 2. REGISTRATION FORM
    // ------------------------------
    const form = document.getElementById('registrationForm');
    const submitBtn = document.getElementById('submitBtn');
    const submitBtnText = document.getElementById('submitBtnText');
    const submitBtnLoading = document.getElementById('submitBtnLoading');
    const submitResult = document.getElementById('submitResult');
    const fileInput = document.getElementById('ktmFileInput');
    const dropzone = document.getElementById('dropzone');
    const uploadPlaceholder = document.getElementById('uploadPlaceholder');
    const uploadPreview = document.getElementById('uploadPreview');
    const ktmPreviewImg = document.getElementById('ktmPreviewImg');
    const fileName = document.getElementById('fileName');
    const removeFileBtn = document.getElementById('removeFileBtn');

    // Pilih level dengan klik pada label
    document.querySelectorAll('.level-option').forEach(label => {
      label.addEventListener('click', function(e) {
        const radio = this.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
        document.querySelectorAll('.level-option').forEach(l => {
          l.classList.remove('border-dewantara-blue', 'bg-blue-50/50', 'shadow-sm');
        });
        this.classList.add('border-dewantara-blue', 'bg-blue-50/50', 'shadow-sm');
      });
    });
    document.querySelector('.level-option input[checked]')?.closest('.level-option')?.classList.add('border-dewantara-blue', 'bg-blue-50/50', 'shadow-sm');

    // Drag & Drop
    dropzone.addEventListener('click', () => fileInput.click());

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('drag-active');
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.classList.remove('drag-active');
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('drag-active');
      if (e.dataTransfer.files.length) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length) {
        handleFile(e.target.files[0]);
      }
    });

    function handleFile(file) {
      if (!file.type.startsWith('image/')) {
        alert('Mohon unggah hanya berkas gambar (JPG/PNG).');
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        alert('Ukuran berkas melebihi 10MB.');
        return;
      }
      const reader = new FileReader();
      reader.onload = (ev) => {
        // Tampilkan preview
        uploadPlaceholder.classList.add('hidden');
        uploadPreview.classList.remove('hidden');
        ktmPreviewImg.src = ev.target.result;
        fileName.textContent = file.name + ' (' + (file.size / 1024).toFixed(0) + ' KB)';
      };
      reader.readAsDataURL(file);
    }

    removeFileBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      resetFileUpload();
    });

    function resetFileUpload() {
      fileInput.value = '';
      uploadPlaceholder.classList.remove('hidden');
      uploadPreview.classList.add('hidden');
      ktmPreviewImg.src = '';
      fileName.textContent = '';
    }

    // ============================================================
    // SUBMIT DENGAN FormData
    // ============================================================
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = document.getElementById('name').value.trim();
      const nim = document.getElementById('nim').value.trim();
      const prodi = document.getElementById('prodi').value;
      const email = document.getElementById('email').value.trim();
      const whatsapp = document.getElementById('whatsapp').value.trim();
      const ic3Level = document.querySelector('input[name="ic3Level"]:checked')?.value;

      if (!name || !nim || !prodi || !email || !whatsapp || !ic3Level) {
        showResult(false, 'Mohon lengkapi semua bidang isian formulir.');
        return;
      }
      if (!fileInput.files || fileInput.files.length === 0) {
        showResult(false, 'Mohon unggah foto Kartu Tanda Mahasiswa (KTM).');
        return;
      }

      const formData = new FormData();
      formData.append('name', name);
      formData.append('nim', nim);
      formData.append('prodi', prodi);
      formData.append('email', email);
      formData.append('whatsapp', whatsapp);
      formData.append('ic3Level', ic3Level);
      formData.append('ktmFile', fileInput.files[0]);

      submitBtnText.classList.add('hidden');
      submitBtnLoading.classList.remove('hidden');
      submitBtn.disabled = true;
      submitResult.classList.add('hidden');

      try {
        const response = await fetch('/ic3/register', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();

        if (response.ok && data.success) {
          showResult(true, data.message, data.registrant);
          form.reset();
          resetFileUpload();
          document.querySelectorAll('.level-option').forEach(l => {
            l.classList.remove('border-dewantara-blue', 'bg-blue-50/50', 'shadow-sm');
          });
          const defaultRadio = document.querySelector('input[name="ic3Level"][value="Level 1"]');
          if (defaultRadio) {
            defaultRadio.checked = true;
            defaultRadio.closest('.level-option')?.classList.add('border-dewantara-blue', 'bg-blue-50/50', 'shadow-sm');
          }
          fetchStats();
        } else {
          showResult(false, data.error || 'Gagal melakukan pendaftaran.');
        }
      } catch (err) {
        console.error('Fetch error:', err);
        showResult(false, 'Terjadi kesalahan koneksi server saat mengirim pendaftaran.');
      } finally {
        submitBtnText.classList.remove('hidden');
        submitBtnLoading.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });

    function showResult(success, message, registrant) {
      submitResult.classList.remove('hidden');
      submitResult.className = `p-4 rounded-xl mb-6 flex items-start gap-3 border ${success ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800'}`;
      let html = `<div class="text-xs">`;
      html += `<h3 class="font-bold">${success ? 'Berhasil Mendaftar!' : 'Gagal Mendaftar'}</h3>`;
      html += `<p class="mt-1 font-light leading-relaxed">${message}</p>`;
      if (success && registrant) {
        html += `<div class="mt-3 pt-3 border-t border-emerald-100 text-[11px] text-emerald-700 font-mono space-y-1">`;
        html += `<div>No Registrasi: #${registrant.registrationNo}</div>`;
        html += `<div>Kelayakan Biaya: ${registrant.fee === 0 ? 'GRATIS (Rp 0)' : 'Biaya Mandiri Rp ' + registrant.fee.toLocaleString()}</div>`;
        html += `<div>Status Verifikasi: <span class="font-bold">${registrant.verificationStatus === 'approved' ? 'Terverifikasi Sangat Layak' : 'Proses Verifikasi'}</span></div>`;
        html += `</div>`;
        html += `<button onclick="document.getElementById('submitResult').classList.add('hidden')" class="mt-3.5 font-bold underline hover:text-slate-900 block cursor-pointer transition-colors">Tutup Notifikasi & Kirim Data Baru</button>`;
      } else {
        html += `<button onclick="document.getElementById('submitResult').classList.add('hidden')" class="mt-3.5 font-bold underline hover:text-slate-900 block cursor-pointer transition-colors">Tutup</button>`;
      }
      html += `</div>`;
      submitResult.innerHTML = html;
      lucide.createIcons();
    }

    // ------------------------------
    // 3. SEARCH
    // ------------------------------
    const searchForm = document.getElementById('searchForm');
    const searchNimInput = document.getElementById('searchNimInput');
    const searchResultDiv = document.getElementById('searchResult');

    searchForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nim = searchNimInput.value.trim();
      if (!nim) return;

      searchResultDiv.classList.remove('hidden');
      searchResultDiv.innerHTML = '<div class="text-center py-4"><i data-lucide="refresh-cw" class="w-5 h-5 animate-spin inline text-dewantara-blue"></i> Mencari...</div>';
      lucide.createIcons();

      try {
        const res = await fetch('/ic3/status/' + encodeURIComponent(nim));
        const data = await res.json();
        if (res.ok && data.success) {
          renderSearchResult(data.data);
        } else {
          searchResultDiv.innerHTML = `
            <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-xl flex items-start gap-2.5 text-xs">
              <i data-lucide="alert-circle" class="w-5 h-5 shrink-0 text-amber-600 mt-0.5"></i>
              <div>
                <p class="font-bold">NIM Tidak Ditemukan</p>
                <p class="mt-1 font-light">NIM <strong>${nim}</strong> tidak terdaftar di sistem. Mohon cek kembali atau silakan mengisi formulir di sebelah kiri.</p>
              </div>
            </div>
          `;
          lucide.createIcons();
        }
      } catch (err) {
        searchResultDiv.innerHTML = `<div class="text-red-500 text-xs">Gagal melakukan pencarian.</div>`;
      }
    });

    function renderSearchResult(r) {
      const isFree = r.registrationNo <= 80;
      const isPaid = r.fee > 0;
      let html = `
        <div class="border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
          <div class="bg-slate-50 border-b border-slate-200 p-4 flex flex-col sm:flex-row items-center justify-between gap-2.5">
            <div>
              <span class="font-mono text-[10px] text-slate-400 uppercase tracking-wide">Nomor Urut Pendaftaran</span>
              <div class="text-lg font-bold text-slate-800">#${r.registrationNo}</div>
            </div>
            <div class="flex gap-1.5">
              <span class="${isFree ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'} border text-xs py-1 px-3 rounded-full font-bold">
                ${isFree ? 'Subsidi Gratis Rp 0' : 'Biaya Mandiri 700k'}
              </span>
            </div>
          </div>
          <div class="p-5 space-y-4 text-xs font-sans">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3.5 gap-x-5">
              <div><span class="text-slate-400 block text-[10px] uppercase">Nama Mahasiswa</span><span class="font-semibold text-slate-800 text-sm mt-0.5 block">${r.name}</span></div>
              <div><span class="text-slate-400 block text-[10px] uppercase">NIM</span><span class="font-mono font-semibold text-slate-800 text-sm mt-0.5 block">${r.nim}</span></div>
              <div><span class="text-slate-400 block text-[10px] uppercase">Program Studi</span><span class="font-semibold text-slate-800 block mt-0.5">${r.prodi}</span></div>
              <div><span class="text-slate-400 block text-[10px] uppercase">Ujian Target IC3</span><span class="font-bold text-slate-800 block mt-0.5 bg-blue-50 text-dewantara-blue px-2 py-0.5 rounded-md inline-block">${r.ic3Level}</span></div>
            </div>

            <div class="bg-slate-50 border border-slate-150 rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700 block">Hasil Pemeriksaan Dokumen KTM</span>
                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full
                  ${r.verificationStatus === 'approved' ? 'bg-emerald-100 text-emerald-800' :
                    r.verificationStatus === 'rejected' ? 'bg-red-100 text-red-800' :
                    'bg-yellow-100 text-yellow-800'}">
                  ${r.verificationStatus === 'approved' ? 'TERVERIFIKASI LANJUT' :
                    r.verificationStatus === 'rejected' ? 'TER TOLAK BUKTI' :
                    'DALAM ANTRIAN'}
                </span>
              </div>
              <p class="text-slate-600 font-light leading-relaxed font-sans text-xs">${r.verificationReason || 'Tidak ada alasan.'}</p>
              ${r.verificationStatus === 'rejected' ? `
                <p class="text-[11px] text-amber-700 bg-amber-50 rounded p-2 border border-amber-100 mt-1">
                  <strong>Saran Perbaikan:</strong> Gambar KTM yang Anda unggah ditolak atau buram. Silakan hubungi admin prodi atau lakukan pendaftaran ulang dengan mengunggah gambar KTM Politeknik Dewantara yang jernih.
                </p>
              ` : ''}
            </div>

            ${isPaid ? `
              <div class="border border-indigo-150 bg-indigo-50/50 rounded-xl p-4 space-y-2">
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <div>
                    <span class="font-bold text-slate-800 block">Biaya Lisensi IC3: Rp 700.000</span>
                    <span class="text-[10px] text-slate-400 block mt-0.5 font-sans font-light">Urutan pendaftar #${r.registrationNo} (melampaui kuota beasiswa gratis 80 prodi)</span>
                  </div>
                  <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded ${r.paymentStatus === 'verified' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">
                    ${r.paymentStatus === 'verified' ? 'LUNAS DIKONFIRMASI' : 'MENUNGGU TRANSFER'}
                  </span>
                </div>
                ${r.paymentStatus !== 'verified' ? `
                  <div class="text-[11px] text-slate-600 space-y-1 bg-white p-2.5 rounded-lg border border-slate-200">
                    <p class="font-bold text-slate-800">Petunjuk Pembayaran:</p>
                    <p>Transfer ke Rekening Resmi Kampus:</p>
                    <p class="font-mono font-bold text-indigo-700">Bank Mandiri: 122-00-987654-3 (a.n. Politeknik Dewantara)</p>
                    <p>Setelah transfer, harap melapor ke Admin Prodi dengan membawa berkas/KTM Anda agar status pembayaran dapat divalidasi dan diubah menjadi <strong>LUNAS</strong>.</p>
                  </div>
                ` : `
                  <p class="text-[11px] text-emerald-700 font-medium">Terima kasih, pembayaran telah divalidasi oleh Program Studi. Silakan ikuti sosialisasi online pada tanggal 23 Juni 2026.</p>
                `}
              </div>
            ` : ''}
          </div>
        </div>
      `;
      searchResultDiv.innerHTML = html;
      lucide.createIcons();
    }

    // ------------------------------
    // 4. ADMIN
    // ------------------------------
    const adminAuthForm = document.getElementById('adminAuthForm');
    const adminPinInput = document.getElementById('adminPinInput');
    const adminAuthError = document.getElementById('adminAuthError');
    const adminAuthDiv = document.getElementById('adminAuth');
    const adminDashboardDiv = document.getElementById('adminDashboard');
    const adminTableBody = document.getElementById('adminTableBody');
    const adminSearchInput = document.getElementById('adminSearchInput');
    const clearAdminSearch = document.getElementById('clearAdminSearch');
    const adminRowCount = document.getElementById('adminRowCount');

    let adminAuthenticated = false;
    let allRegistrants = [];

    adminAuthForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const pin = adminPinInput.value.trim();
      if (pin === 'dewantara' || pin === '101001') {
        adminAuthenticated = true;
        adminAuthError.classList.add('hidden');
        adminAuthDiv.classList.add('hidden');
        adminDashboardDiv.classList.remove('hidden');
        loadAdminData();
      } else {
        adminAuthError.textContent = 'PIN salah';
        adminAuthError.classList.remove('hidden');
      }
    });

    document.getElementById('adminLogoutBtn').addEventListener('click', () => {
      adminAuthenticated = false;
      adminDashboardDiv.classList.add('hidden');
      adminAuthDiv.classList.remove('hidden');
      adminPinInput.value = '';
    });

    document.getElementById('refreshAdminBtn').addEventListener('click', loadAdminData);

    document.getElementById('resetDbBtn').addEventListener('click', async () => {
      if (!confirm('Apakah Anda yakin ingin mereset seluruh database pendaftaran ke data bawaan simulasi prodi?')) return;
      try {
        const res = await fetch('/ic3/api/registrants/reset', { method: 'POST' });
        if (res.ok) {
          loadAdminData();
          fetchStats();
          alert('Database berhasil direset!');
        }
      } catch (err) {
        alert('Gagal reset database.');
      }
    });

    document.getElementById('downloadCsvBtn').addEventListener('click', () => {
      if (allRegistrants.length === 0) return;
      let csv = 'data:text/csv;charset=utf-8,';
      csv += 'No Registrasi,Nama,NIM,Prodi,Email,No WhatsApp,IC3 Level,Biaya (Rp),Status Pembayaran,Verifikasi KTM,Tanggal Pendaftaran\n';
      allRegistrants.forEach(r => {
        const row = [
          r.registrationNo,
          `"${r.name.replace(/"/g, '""')}"`,
          `"${r.nim}"`,
          `"${r.prodi}"`,
          `"${r.email}"`,
          `"${r.whatsapp}"`,
          `"${r.ic3Level}"`,
          r.fee,
          r.paymentStatus === 'not_applicable' ? 'Gratis' : r.paymentStatus,
          r.verificationStatus,
          `"${new Date(r.createdAt).toLocaleString('id-ID')}"`
        ].join(',');
        csv += row + '\n';
      });
      const link = document.createElement('a');
      link.href = encodeURI(csv);
      link.download = `rekap_pendaftar_ic3_dewantara_${Date.now()}.csv`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    adminSearchInput.addEventListener('input', renderAdminTable);
    clearAdminSearch.addEventListener('click', () => {
      adminSearchInput.value = '';
      renderAdminTable();
    });

    async function loadAdminData() {
      try {
        const res = await fetch('/ic3/api/registrants');
        if (res.ok) {
          allRegistrants = await res.json();
          renderAdminTable();
          const statsRes = await fetch('/ic3/stats-summary');
          if (statsRes.ok) {
            const stats = await statsRes.json();
            document.getElementById('adminTotalReg').textContent = stats.totalRegistrants;
            document.getElementById('adminFreeUsed').textContent = stats.freeSlotsUsed + ' / 80';
            document.getElementById('adminPaid').textContent = stats.paidSlotsCount;
            document.getElementById('adminFreeRemain').textContent = stats.freeSlotsRemaining;
          }
        }
      } catch (err) {
        console.error('Gagal memuat data admin:', err);
      }
    }

    function renderAdminTable() {
      const q = adminSearchInput.value.toLowerCase().trim();
      let filtered = allRegistrants;
      if (q) {
        filtered = filtered.filter(r =>
          r.name.toLowerCase().includes(q) ||
          r.nim.includes(q) ||
          r.prodi.toLowerCase().includes(q)
        );
      }
      clearAdminSearch.classList.toggle('hidden', !q);

      if (filtered.length === 0) {
        adminTableBody.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-slate-400">Tidak ada data pendaftar.</td></tr>`;
        adminRowCount.textContent = 'Total Data Tampil: 0 Pendaftar';
        return;
      }

      let html = '';
      filtered.forEach(r => {
        html += `
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="py-2.5 px-3 font-mono font-bold text-slate-500">#${r.registrationNo}</td>
            <td class="py-2.5 px-3">
              <div>
                <p class="font-bold text-slate-800">${r.name}</p>
                <p class="text-[10px] text-slate-500 font-mono mt-0.5">${r.nim}</p>
                <p class="text-[10px] text-slate-400 flex items-center gap-1 font-mono mt-0.2">
                  <i data-lucide="phone" class="w-2.5 h-2.5"></i> ${r.whatsapp}
                </p>
              </div>
            </td>
            <td class="py-2.5 px-3">
              <div class="space-y-0.5">
                <span class="text-slate-600 block">${r.prodi}</span>
                <span class="bg-blue-50 text-dewantara-blue text-[9px] font-mono font-bold px-1.5 py-0.2 rounded-md inline-block">${r.ic3Level}</span>
              </div>
            </td>
            <td class="py-2.5 px-3">
              <div class="space-y-1">
                <select class="admin-verif-select text-[10px] font-semibold py-1 px-1.5 rounded focus:outline-none" data-id="${r.id}">
                  <option value="pending" ${r.verificationStatus === 'pending' ? 'selected' : ''}>🟡 Menunggu</option>
                  <option value="approved" ${r.verificationStatus === 'approved' ? 'selected' : ''}>🟢 Disetujui</option>
                  <option value="rejected" ${r.verificationStatus === 'rejected' ? 'selected' : ''}>🔴 Ditolak</option>
                </select>
                <p class="text-[9px] text-slate-400 leading-tight max-w-[150px] whitespace-normal italic">${r.verificationReason || ''}</p>
              </div>
            </td>
            <td class="py-2.5 px-3">
              <div>
                <p class="font-bold text-slate-700">${r.fee === 0 ? 'Gratis (Rp 0)' : 'Rp 700.000'}</p>
                ${r.fee > 0 ? `
                  <select class="admin-payment-select text-[9px] font-semibold mt-1 py-0.5 px-1 rounded block" data-id="${r.id}">
                    <option value="pending" ${r.paymentStatus === 'pending' ? 'selected' : ''}>Menunggu Transfer</option>
                    <option value="verified" ${r.paymentStatus === 'verified' ? 'selected' : ''}>LUNAS</option>
                  </select>
                ` : `
                  <span class="text-[10px] text-emerald-600 bg-emerald-50 px-1.5 py-0.2 rounded mt-1 inline-block">Beasiswa Subsidi</span>
                `}
              </div>
            </td>
            <td class="py-2.5 px-3 text-center">
              <button class="admin-delete-btn text-red-500 hover:text-red-700 font-medium hover:underline text-[10px] px-2 py-1 cursor-pointer" data-id="${r.id}">Hapus</button>
            </td>
          </tr>
        `;
      });
      adminTableBody.innerHTML = html;
      adminRowCount.textContent = `Total Data Tampil: ${filtered.length} Pendaftar`;
      lucide.createIcons();

      document.querySelectorAll('.admin-verif-select').forEach(sel => {
        sel.addEventListener('change', async (e) => {
          const id = sel.dataset.id;
          const value = sel.value;
          await updateRegistrant(id, { verificationStatus: value });
          loadAdminData();
        });
      });

      document.querySelectorAll('.admin-payment-select').forEach(sel => {
        sel.addEventListener('change', async (e) => {
          const id = sel.dataset.id;
          const value = sel.value;
          await updateRegistrant(id, { paymentStatus: value });
          loadAdminData();
        });
      });

      document.querySelectorAll('.admin-delete-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id;
          if (!confirm('Apakah Anda yakin ingin menghapus pendaftaran ini?')) return;
          try {
            const res = await fetch('/ic3/api/registrants/' + id, { method: 'DELETE' });
            if (res.ok) {
              loadAdminData();
              fetchStats();
            }
          } catch (err) {
            alert('Gagal menghapus.');
          }
        });
      });
    }

    async function updateRegistrant(id, fields) {
      try {
        await fetch('/ic3/api/registrants/update-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, ...fields })
        });
      } catch (err) {
        console.error('Gagal update:', err);
      }
    }

// ------------------------------
// 5. FETCH STATS (realtime)
// ------------------------------
async function fetchStats() {
  try {
    console.log('🔄 Fetching stats...');
    const res = await fetch('/ic3/stats-summary');
    if (!res.ok) {
      console.error('❌ Response not OK:', res.status);
      return;
    }
    const stats = await res.json();
    console.log('📊 Stats updated:', stats);

    // ========== UPDATE PROGRESS BAR ==========
    const used = stats.freeSlotsUsed || 0;
    const pct = Math.min(100, (used / 80) * 100);

    // Update angka slot terisi
    const slotUsedEl = document.getElementById('slotUsed');
    if (slotUsedEl) {
      slotUsedEl.textContent = used;
      console.log('✅ slotUsed updated to:', used);
    } else {
      console.warn('⚠️ slotUsed element not found!');
    }

    // Update lebar progress bar
    const progressBar = document.getElementById('progressBar');
    if (progressBar) {
      progressBar.style.width = pct + '%';
      console.log('📊 Progress bar width set to:', pct + '%');
    } else {
      console.warn('⚠️ Progress bar element not found!');
    }

    // ========== UPDATE ELEMEN LAIN ==========
    // Header stats
    const totalDisplay = document.getElementById('totalRegDisplay');
    if (totalDisplay) totalDisplay.textContent = stats.totalRegistrants;
    const freeDisplay = document.getElementById('freeSlotsDisplay');
    if (freeDisplay) freeDisplay.textContent = stats.freeSlotsRemaining;

    // Elemen standar
    const totalRegEl = document.getElementById('totalRegistrants');
    if (totalRegEl) totalRegEl.textContent = stats.totalRegistrants;
    const freeSlotsEl = document.getElementById('freeSlotsRemaining');
    if (freeSlotsEl) freeSlotsEl.innerHTML = stats.freeSlotsRemaining + ' <span class="text-xs font-sans text-slate-300 font-normal">Sisa</span>';
    const nextRegEl = document.getElementById('nextRegNo');
    if (nextRegEl) nextRegEl.textContent = 'Pendaftar ke-' + (stats.totalRegistrants + 1);

    // ========== UPDATE TOMBOL & STATUS SLOT ==========
    const isFree = stats.totalRegistrants < 80;
    const submitText = document.getElementById('submitBtnText');
    if (submitText) {
      if (isFree) {
        submitText.innerHTML = '<i data-lucide="gift" class="w-5 h-5 inline"></i> Kirim Pendaftaran GRATIS';
        document.getElementById('submitBtn').className = 'w-full py-3 rounded-xl font-medium tracking-wide shadow-sm flex items-center justify-center gap-2 cursor-pointer transition-all bg-gradient-to-r from-emerald-600 to-emerald-500 text-white hover:shadow-md hover:brightness-105';
      } else {
        submitText.innerHTML = '<i data-lucide="credit-card" class="w-5 h-5 inline"></i> Daftar - Bayar Voucher Mandiri Rp 700k';
        document.getElementById('submitBtn').className = 'w-full py-3 rounded-xl font-medium tracking-wide shadow-sm flex items-center justify-center gap-2 cursor-pointer transition-all bg-gradient-to-r from-amber-600 to-amber-500 text-white hover:shadow-md hover:brightness-105';
      }
    }

    // Update slot info di bawah progress
    const slotInfo = document.querySelector('.mt-4.pt-4.border-t.border-slate-100');
    if (slotInfo) {
      if (isFree) {
        slotInfo.innerHTML = `<div class="flex items-center gap-1.5 text-emerald-600 font-medium">
          <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-ping"></span>
          Slot Gratis Aktif: Pendaftar selanjutnya tidak dikenakan biaya apapun!
        </div>`;
      } else {
        slotInfo.innerHTML = `<div class="flex items-center gap-1.5 text-amber-600 font-semibold">
          <span class="w-2.5 h-2.5 bg-amber-500 rounded-full"></span>
          Kuota Gratis Habis: Pendaftar ke-81+ dikenakan biaya voucher prodi Rp 700.000.
        </div>`;
      }
    }

    lucide.createIcons();
  } catch (err) {
    console.error('❌ Gagal fetch stats:', err);
  }
}

// Panggil fetchStats saat halaman dimuat
document.addEventListener('DOMContentLoaded', () => {
  console.log('✅ DOM loaded');
  lucide.createIcons();
  fetchStats(); // <-- KUNCI
});

// Polling setiap 15 detik
setInterval(fetchStats, 15000);
document.addEventListener('DOMContentLoaded', () => {
  lucide.createIcons();
  fetchStats();
});

    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        setTimeout(() => lucide.createIcons(), 100);
      });
    });
  </script>
</body>
</html>
<%- include('../partials/footer-landing') %>