<%- include('../partials/header-landing') %>

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* Custom theme */
    :root {
      --color-dewantara-blue: #0d529f;
      --color-dewantara-navy: #093c75;
      --color-dewantara-gold: #f2a900;
    }
    body {
      font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
    }
    .font-display { font-family: 'Outfit', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
    .bg-dewantara-blue { background-color: var(--color-dewantara-blue); }
    .bg-dewantara-navy { background-color: var(--color-dewantara-navy); }
    .text-dewantara-blue { color: var(--color-dewantara-blue); }
    .text-dewantara-gold { color: var(--color-dewantara-gold); }
    .border-dewantara-blue { border-color: var(--color-dewantara-blue); }
    .from-dewantara-blue { --tw-gradient-from: var(--color-dewantara-blue); }
    .to-dewantara-navy { --tw-gradient-to: var(--color-dewantara-navy); }
    .bg-dewantara-gold { background-color: var(--color-dewantara-gold); }
    .border-dewantara-gold { border-color: var(--color-dewantara-gold); }
    .hover\:bg-dewantara-blue:hover { background-color: var(--color-dewantara-blue); }
    .focus\:ring-dewantara-blue:focus { --tw-ring-color: var(--color-dewantara-blue); }
    .bg-radial-gradient {
      background-image: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
    }
    @keyframes ping {
      75%, 100% { transform: scale(2); opacity: 0; }
    }
    .animate-ping {
      animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    .drag-active {
      border-color: var(--color-dewantara-blue) !important;
      background-color: #eff6ff !important;
    }
  </style>
</head>
<body>
  <!-- ============================================================ -->
  <!-- BANNER IC3 DIGITAL LITERACY (tambahan)                       -->
  <!-- ============================================================ -->
  <div class="max-w-7xl mx-auto px-4 pt-4 sm:px-6 lg:px-8">
    <img 
      src="/images/banneric3.png" 
      alt="Banner IC3 Digital Literacy" 
      class="w-full rounded-xl shadow-md"
    />
  </div>
  <!-- ============================================================ -->
  <!-- CARD BIRU (HEADER + FLASH + STATS)                           -->
  <!-- ============================================================ -->
  <%
    const totalReg = (typeof stats !== 'undefined' && stats.totalRegistrants) || 0;
    const freeSlotsUsed = (typeof stats !== 'undefined' && stats.freeSlotsUsed) || 0;
    const freeSlotsRemaining = (typeof stats !== 'undefined' && stats.freeSlotsRemaining) || 80;
    const paidSlotsCount = (typeof stats !== 'undefined' && stats.paidSlotsCount) || 0;
  %>

<!-- ============================================================ -->
<!-- CARD HEADER (CANTIK + FLASH PROMO)                          -->
<!-- ============================================================ -->
<div class="max-w-7xl mx-auto px-4 pt-6 sm:px-6 lg:px-8">
  <div class="relative bg-gradient-to-r from-blue-600 via-dewantara-blue to-dewantara-navy rounded-2xl shadow-xl overflow-hidden border border-blue-400/20">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI2MCIgaGVpZ2h0PSI2MCIgdmlld0JveD0iMCAwIDYwIDYwIj48cGF0aCBkPSJNMzAgMTBhMjAgMjAgMCAxIDAgMCA0MCAyMCAyMCAwIDAgMCAwLTQweiIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjZmZmIiBzdHJva2Utd2lkdGg9IjIiLz48L3N2Zz4=')]"></div>
    
    <div class="relative z-10 p-6 md:p-8">
      <!-- Baris atas: Judul + Statistik -->
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl md:text-3xl font-display font-bold text-white flex items-center gap-2 drop-shadow-md">
            <span> Pendaftaran IC3 Digital Literacy
          </h1>
          <p class="text-sm text-blue-100 mt-1 drop-shadow-sm">
            Program sertifikasi internasional untuk mahasiswa Politeknik Dewantara
          </p>
        </div>
        <div class="flex items-center gap-6 bg-white/10 backdrop-blur-sm rounded-xl px-5 py-2.5 border border-white/10 shadow-inner">
          <div class="text-center">
            <span class="text-[10px] uppercase tracking-wider text-blue-200">Pendaftar</span>
            <div class="text-2xl font-mono font-bold text-white" id="totalRegDisplay"><%= totalReg %></div>
          </div>
          <div class="w-px h-10 bg-white/20"></div>
          <div class="text-center">
            <span class="text-[10px] uppercase tracking-wider text-blue-200">Sisa Kuota Gratis</span>
            <div class="text-2xl font-mono font-bold text-yellow-300" id="freeSlotsDisplay"><%= freeSlotsRemaining %></div>
          </div>
        </div>
      </div>

      <!-- Flash Promo -->
      <div class="mt-4 bg-white/15 backdrop-blur-sm border border-white/10 rounded-xl p-3.5 text-center text-sm shadow-inner">
        <span class="font-bold text-white drop-shadow">Penawaran Prioritas:</span>
        <span class="text-white drop-shadow">80 pendaftar pertama mendapatkan lisensi sertifikasi senilai <strong class="text-yellow-300">Rp 700.000</strong> secara <strong class="text-emerald-300">GRATIS!</strong></span>
        <span class="inline-block ml-2 bg-yellow-400/30 text-yellow-200 text-[11px] px-3 py-1 rounded-full border border-yellow-400/40 font-medium shadow-sm">
          Urutan Ditentukan Waktu Kirim
        </span>
      </div>
    </div>
  </div>
</div>

  <!-- ============================================================ -->
  <!-- MAIN CONTENT                                                 -->
  <!-- ============================================================ -->
  <main class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8">

    <!-- ROW 1: METRICS (Progress & Tarif) -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8" id="quick-indicators">
      <!-- Progress Card -->
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-slate-200 p-5 col-span-1 md:col-span-2 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Total Pendaftar Sertifikasi IC3 Digital Literacy </span>
            <span class="text-xs font-mono font-bold text-dewantara-blue bg-blue-50 px-2 py-0.5 rounded">
              <%= freeSlotsUsed %> / 80 Slot Terisi
            </span>
          </div>
<div class="w-full bg-slate-100 h-3.5 rounded-full overflow-hidden mt-1 relative">
<div 
  id="progressBar"
  class="bg-gradient-to-r from-dewantara-blue to-blue-500 h-full rounded-full transition-all duration-500"
  style="width: <%= Math.min(100, (freeSlotsUsed / 80) * 100) %>%; min-width: 4px;"
></div>
</div>
          <div class="flex justify-between text-[11px] text-slate-400 font-mono mt-1.5">
<span class="text-xs font-mono font-bold text-dewantara-blue bg-blue-50 px-2 py-0.5 rounded">
  <span id="slotUsed"><%= freeSlotsUsed %></span> / 80
</span>
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap gap-4 items-center justify-between text-xs text-slate-500">
          <% if (totalReg < 80) { %>
            <div class="flex items-center gap-1.5 text-emerald-600 font-medium">
              <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-ping"></span>
              Slot Gratis Aktif: Pendaftar selanjutnya tidak dikenakan biaya apapun!
            </div>
          <% } else { %>
            <div class="flex items-center gap-1.5 text-amber-600 font-semibold">
              <span class="w-2.5 h-2.5 bg-amber-500 rounded-full"></span>
              Kuota Gratis Habis: Pendaftar ke-81+ dikenakan biaya voucher prodi Rp 700.000.
            </div>
          <% } %>
        </div>
      </div>

      <!-- Pricing Card -->
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-slate-200 p-5 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Tarif Registrasi Saat Ini</span>
          <i data-lucide="building" class="w-4 h-4 text-slate-400"></i>
        </div>
        <div class="my-1.5">
          <% if (totalReg < 80) { %>
            <div>
              <div class="text-3xl font-display font-black text-emerald-600 flex items-center gap-1">
                GRATIS
                <span class="text-sm font-sans font-normal text-slate-400 line-through">Rp 700k</span>
              </div>
              <p class="text-xs text-slate-400 mt-1">
                Biaya ditanggung penuh oleh subsidi hibah IC3 Digital Literacy Politeknik Dewantara.
              </p>
            </div>
          <% } else { %>
            <div>
              <div class="text-2xl font-mono font-black text-amber-600">
                Rp 700.000
              </div>
              <p class="text-xs text-slate-400 mt-1">
                Dikenakan biaya mandiri khusus untuk pendaftar di luar kuota 80 pertama subsidi prodi.
              </p>
            </div>
          <% } %>
        </div>
        <div class="bg-slate-50 rounded-lg p-2 flex items-center justify-between text-[11px] text-slate-500">
          <span>Registrasi Terkini:</span>
          <span class="font-mono font-bold text-slate-700" id="nextRegNo">Pendaftar ke-<%= totalReg + 1 %></span>
        </div>
      </div>
    </section>

    <!-- ROW 2: FORM + TABS (INFO / SEARCH / ADMIN) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT: FORM -->
      <section class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 relative">
        <div class="absolute top-4 right-4 text-emerald-500 bg-emerald-50 p-1.5 rounded-lg text-xs flex items-center gap-1 font-mono font-bold">
          <i data-lucide="shield-check" class="w-4 h-4"></i> SSL SECURE
        </div>

        <div class="border-b border-slate-100 pb-4 mb-6">
          <h2 class="text-xl font-display font-semibold text-slate-800 flex items-center gap-2">
            <i data-lucide="file-text" class="w-5 h-5 text-dewantara-blue"></i>
            Formulir Pendaftaran
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Kirimkan formulir minat hari ini. KTM wajib disertakan untuk auto-verifikasi NIM oleh AI.
          </p>
        </div>

        <div id="submitResult" class="hidden p-4 rounded-xl mb-6 flex items-start gap-3 border"></div>

        <form id="registrationForm" enctype="multipart/form-data" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">
              Nama Lengkap Mahasiswa <span class="text-red-500">*</span>
            </label>
            <input type="text" name="name" id="name" required
              placeholder="Contoh:  Fajar Ramadhan"
              class="w-full text-sm px-3.5 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-dewantara-blue focus:border-transparent transition-all" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">
                NIM <span class="text-red-500">*</span>
              </label>
              <input type="text" name="nim" id="nim" required
                placeholder="Contoh: 202401032"
                class="w-full text-sm px-3.5 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-dewantara-blue font-mono" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">
                Program Studi <span class="text-red-500">*</span>
              </label>
              <select name="prodi" id="prodi" required
                class="w-full text-sm px-3.5 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-dewantara-blue">
                <option value="">-- Pilih Prodi --</option>
                <optgroup label="Sarjana Terapan (D4)">
                  <option value="Teknologi Rekayasa Multimedia">Teknologi Rekayasa Multimedia </option>
                  <option value="Teknologi Rekayasa Pangan">Teknologi Rekayasa Pangan </option>
                  <option value="Arsitektur Bangunan Gedung">Arsitektur Bangunan Gedung </option>
                  <option value="Teknologi Pertambangan">Teknologi Pertambangan / Metalurgi</option>
                </optgroup>
                <optgroup label="Diploma Tiga (D3)">
                  <option value="Teknik Sipil">Teknik Sipil</option>
                  <option value="Mesin Otomotif">Mesin Otomotif</option>
                  <option value="Teknik Elektronika">Teknik Elektronika</option>
                </optgroup>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">
                Email Aktif <span class="text-red-500">*</span>
              </label>
              <input type="email" name="email" id="email" required
                placeholder="fajar@student.polidewa.ac.id"
                class="w-full text-sm px-3.5 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-dewantara-blue" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">
                No. WhatsApp <span class="text-red-500">*</span>
              </label>
              <input type="text" name="whatsapp" id="whatsapp" required
                placeholder="08xxxxxxxxxx"
                class="w-full text-sm px-3.5 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-dewantara-blue" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-2">
              Pilihan Tingkatan IC3 Digital Literacy <span class="text-red-500">*</span>
            </label>
            <div class="grid grid-cols-1 gap-2.5" id="ic3LevelGroup">
              <% 
                const levels = [
                  { value: 'Level 1', title: 'Level 1: Knowing (Dasar)', desc: 'Literasi dasar teknologi: Perangkat fisik, sistem operasi, serta pemahaman kewarganegaraan digital pemula.' },
                  { value: 'Level 2', title: 'Level 2: Doing (Menengah)', desc: 'Aplikasi praktis: Pembuatan konten, pengolahan berkas, pemecahan masalah digital serta privasi data dasar.' },
                  { value: 'Level 3', title: 'Level 3: Leading (Mahir)', desc: 'Kapabilitas tingkat lanjut: Komunikasi kolaboratif, jejaring profesional, keamanan tingkat mahir & kerja tim digital.' }
                ];
                levels.forEach(lvl => { 
              %>
                <label 
                  class="block border rounded-xl p-3 cursor-pointer transition-all level-option"
                  data-value="<%= lvl.value %>"
                >
                  <div class="flex items-start gap-2.5">
                    <input type="radio" name="ic3Level" value="<%= lvl.value %>" 
                      <%= lvl.value === 'Level 1' ? 'checked' : '' %>
                      class="mt-1 text-dewantara-blue focus:ring-dewantara-blue" />
                    <div>
                      <span class="text-xs font-bold text-slate-800 block"><%= lvl.title %></span>
                      <span class="text-[11px] text-slate-500 block leading-relaxed mt-0.5"><%= lvl.desc %></span>
                    </div>
                  </div>
                </label>
              <% }); %>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1.5 flex items-center justify-between">
              <span>Unggah KTM <span class="text-red-500">*</span></span>
              <span class="text-[10px] text-dewantara-blue bg-blue-50 px-2 py-0.5 rounded font-mono font-semibold">
                AUTO-VERIFIED BY AI
              </span>
            </label>

            <div id="dropzone" 
                 class="border-2 border-dashed rounded-xl p-5 text-center cursor-pointer transition-all duration-200 border-slate-300 hover:border-slate-400 bg-slate-50">
              <input type="file" id="ktmFileInput" name="ktmFile" accept="image/*" class="hidden" />
              <div id="uploadPlaceholder" class="space-y-2">
                <div class="w-10 h-10 bg-slate-200 text-slate-600 rounded-full mx-auto flex items-center justify-center">
                  <i data-lucide="upload-cloud" class="w-5 h-5"></i>
                </div>
                <div class="text-xs">
                  <p class="font-medium text-slate-700">Klik untuk mencari, atau seret & jatuhkan berkas gambar KTM</p>
                  <p class="text-slate-400 text-[10px] font-light mt-1">Format JPG, PNG, atau WEBP maksimal 10MB</p>
                </div>
              </div>
              <div id="uploadPreview" class="hidden space-y-2">
                <div class="w-16 h-12 bg-emerald-100 text-emerald-700 rounded-lg mx-auto flex items-center justify-center p-1 overflow-hidden">
                  <img id="ktmPreviewImg" src="" alt="KTM Preview" class="object-cover w-full h-full rounded" />
                </div>
                <div class="text-xs">
                  <p class="font-bold text-slate-700">Berkas Terpilih</p>
                  <p id="fileName" class="text-slate-400 text-[10px] font-mono mt-0.5"></p>
                </div>
                <button type="button" id="removeFileBtn" class="text-[10px] font-bold text-red-500 hover:underline inline-block mt-1 cursor-pointer">
                  Ganti Berkas / Hapus
                </button>
              </div>
            </div>

            <div class="mt-2 bg-slate-50 border border-slate-100 p-2.5 rounded-lg flex items-start gap-1.5 text-[10px] text-slate-500">
              <i data-lucide="sparkles" class="w-3.5 h-3.5 text-dewantara-blue shrink-0 mt-0.5"></i>
              <p class="leading-normal">
                <strong>Pemeriksa AI Pintar:</strong> Sistem memindai nama, dan NIM di kartu Anda secara otomatis. KTM harus bertuliskan <strong>Politeknik Dewantara</strong>.
              </p>
            </div>
          </div>

          <!-- Tombol Kirim -->
          <div class="pt-2">
            <button type="submit" id="submitBtn"
              class="w-full py-3 rounded-xl font-medium tracking-wide shadow-sm flex items-center justify-center gap-2 cursor-pointer transition-all 
                <% if (totalReg < 80) { %>
                  bg-gradient-to-r from-emerald-600 to-emerald-500 text-white hover:shadow-md hover:brightness-105
                <% } else { %>
                  bg-gradient-to-r from-amber-600 to-amber-500 text-white hover:shadow-md hover:brightness-105
                <% } %>"
            >
              <span id="submitBtnText">
                <% if (totalReg < 80) { %>
                  <i data-lucide="gift" class="w-5 h-5 inline"></i> Kirim Pendaftaran GRATIS
                <% } else { %>
                  <i data-lucide="credit-card" class="w-5 h-5 inline"></i> Kirim Pendaftaran Rp 700k
                <% } %>
              </span>
              <span id="submitBtnLoading" class="hidden">
                <i data-lucide="refresh-cw" class="w-5 h-5 animate-spin inline"></i> Memverifikasi Berkas...
              </span>
            </button>
          </div>
          <div class="text-center text-[10px] text-slate-400">
            Wajib Upload KTM untuk tujuan  validasi kepesertaan Ujian / Tes IC3 Digital Literacy.
          </div>
        </form>
      </section>

      <!-- RIGHT: TABS -->
      <section class="lg:col-span-7 space-y-6">

        <div class="bg-slate-200 p-1 rounded-xl flex gap-1">
          <button class="tab-btn flex-1 py-2.5 px-3.5 rounded-lg font-medium text-xs sm:text-sm flex items-center justify-center gap-1.5 cursor-pointer transition-all bg-white text-dewantara-blue shadow-sm font-semibold" data-tab="info">
            <i data-lucide="award" class="w-4 h-4"></i> Informasi Program
          </button>
          <button class="tab-btn flex-1 py-2.5 px-3.5 rounded-lg font-medium text-xs sm:text-sm flex items-center justify-center gap-1.5 cursor-pointer transition-all text-slate-600 hover:bg-white/40 hover:text-slate-900" data-tab="search">
            <i data-lucide="search" class="w-4 h-4"></i> Cek Status Saya
          </button>
          <button class="tab-btn flex-1 py-2.5 px-3.5 rounded-lg font-medium text-xs sm:text-sm flex items-center justify-center gap-1.5 cursor-pointer transition-all text-slate-600 hover:bg-white/40 hover:text-slate-900" data-tab="admin">
            <i data-lucide="lock" class="w-4 h-4"></i> Admin Prodi Hub
          </button>
        </div>

        <!-- TAB INFO -->
        <div id="tab-info" class="tab-content bg-white rounded-2xl border border-slate-200 p-6 space-y-6 shadow-sm">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="bg-blue-100 text-blue-800 text-[10px] uppercase font-mono px-2 py-0.5 rounded font-bold">ABOUT CERTIFICATION</span>
              <span class="text-slate-300">|</span>
              <a href="https://www.certiport.com/IC3" target="_blank" rel="noreferrer" class="text-xs text-dewantara-blue hover:underline font-mono">www.certiport.com/IC3</a>
            </div>
            <h3 class="text-lg font-display font-bold text-slate-800">Mengenal IC3 Digital Literacy Global Standard 6</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-light">
              Sertifikasi <strong>IC3 (Internet Computing Core Certification)</strong> dari <strong>Certiport VUE Pearson</strong> diperoleh melalui <strong>Ujian Kompetensi (Tes CBT)</strong> berstandar internasional yang dirancang khusus untuk mengukur kemampuan literasi digital akademisi secara akseptabel global. Ujian berbasis CBT ini berlangsung selama 50 menit dengan skor kelulusan minimal 700 dari 1000.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-center">
              <div class="w-8 h-8 rounded-full bg-blue-100 text-dewantara-blue flex items-center justify-center mx-auto mb-2">
                <i data-lucide="award" class="w-4.5 h-4.5"></i>
              </div>
              <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Sertifikat Digital</h4>
              <p class="text-[10px] text-slate-600 mt-1.5 leading-relaxed">Dikeluarkan langsung oleh Certiport diakui di lebih dari 150 negara bagi peserta yang lulus.</p>
            </div>
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-center">
              <div class="w-8 h-8 rounded-full bg-blue-100 text-dewantara-blue flex items-center justify-center mx-auto mb-2">
                <i data-lucide="file-check" class="w-4.5 h-4.5"></i>
              </div>
              <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Score Report</h4>
