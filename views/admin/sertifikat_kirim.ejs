<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-send me-2"></i><%= title %></h4>
    <a href="/admin/sertifikat" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="info-card">
    <div class="card-body">
      <form method="POST" action="/admin/sertifikat/kirim" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="form-label">Dosen Penerima</label>
          <select name="dosenId" class="form-select" required>
            <option value="">Pilih Dosen</option>
            <% dosenList.forEach(function(d) { %>
              <option value="<%= d.id %>"><%= d.nama %> <%= d.nip ? '(' + d.nip + ')' : '' %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Judul Sertifikat</label>
          <input type="text" name="judul" class="form-control" placeholder="Contoh: Sertifikat Penghargaan Dosen Berprestasi" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Penerbit</label>
          <input type="text" name="penerbit" class="form-control" placeholder="Contoh: Politeknik Dewantara" value="Politeknik Dewantara">
        </div>
        <div class="mb-3">
          <label class="form-label">Tanggal Terbit</label>
          <input type="date" name="tanggalTerbit" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label">File Sertifikat (PDF/Gambar)</label>
          <input type="file" name="file" class="form-control" accept=".pdf,image/*" required>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i> Kirim Sertifikat</button>
          <a href="/admin/sertifikat" class="btn btn-light">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
