<%- include('../partials/header') %>

<style>
  .khs-table th {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    color: white;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    border: none;
  }
  .khs-table td {
    vertical-align: middle;
    padding: 1rem 0.75rem;
  }
  .badge-ip {
    background: #28a745;
    color: white;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: 50px;
  }
  .btn-action {
    margin: 2px;
    border-radius: 8px;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 10px rgba(0,0,0,0.1);
  }
  .avatar-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.2rem;
  }
  .filter-card {
    border-radius: 1rem;
    border: none;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    background: white;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .table-responsive {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  }
  .foto-mahasiswa {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 50%;
  }
  .stat-card {
    background: white;
    border-radius: 1rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    padding: 1.1rem 1.3rem;
    height: 100%;
  }
  .stat-card .stat-value {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .stat-card .stat-label {
    font-size: 0.8rem;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  @media print {
    .filter-card, .btn-action, .no-print { display: none !important; }
  }
</style>

<div class="container-fluid mt-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 no-print">
    <h2 class="fw-bold">Daftar KHS</h2>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
        <i class="bi bi-printer-fill me-1"></i> Cetak
      </button>
      <button type="button" class="btn btn-outline-success" onclick="exportKhsCsv()">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
      </button>
    </div>
  </div>

  <div class="alert alert-light border d-flex align-items-center mb-4 no-print" style="border-radius: 1rem;">
    <i class="bi bi-info-circle-fill me-2" style="color: #2193b0;"></i>
    <span class="small text-muted">
      KHS di sini dihitung otomatis dari nilai akhir yang sudah dikunci di menu
      <a href="/admin/nilai">Input Nilai</a> (nyambung ke Rubrik Penilaian). Tidak ada lagi
      upload file PDF manual — cukup kunci nilai akhir per mata kuliah, KHS mahasiswa akan langsung muncul.
    </span>
  </div>

  <!-- Statistik -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card border-start border-4" style="border-color: #2193b0 !important;">
        <div class="stat-value"><%= khsList.length %></div>
        <div class="stat-label">Jumlah Mahasiswa (baris KHS)</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card border-start border-4 border-warning">
        <div class="stat-value"><%= khsList.filter(k => (k.jumlahBelumNilai || 0) > 0).length %></div>
        <div class="stat-label">Belum Lengkap Nilainya</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card border-start border-4 border-success">
        <div class="stat-value">
          <%
            const validIps = khsList.map(k => parseFloat(k.ips)).filter(n => !isNaN(n));
            const rataIps = validIps.length ? (validIps.reduce((a,b) => a+b, 0) / validIps.length).toFixed(2) : '0.00';
          %>
          <%= rataIps %>
        </div>
        <div class="stat-label">Rata-rata IPS</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card border-start border-4 border-secondary">
        <div class="stat-value"><%= new Set(khsList.map(k => k.userId)).size %></div>
        <div class="stat-label">Mahasiswa Unik</div>
      </div>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="filter-card no-print">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label for="semester" class="form-label fw-semibold">Filter Semester</label>
        <select class="form-select" id="semester" name="semester">
          <option value="">Semua Semester</option>
          <% if (semesterList && semesterList.length) { %>
            <% semesterList.forEach(s => { %>
              <option value="<%= s %>" <%= filters?.semester === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="angkatan" class="form-label fw-semibold">Filter Angkatan</label>
        <select class="form-select" id="angkatan" name="angkatan">
          <option value="">Semua Angkatan</option>
          <% if (angkatanList && angkatanList.length) { %>
            <% angkatanList.forEach(a => { %>
              <option value="<%= a %>" <%= filters?.angkatan === a ? 'selected' : '' %>><%= a %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
      </div>
      <div class="col-md-2">
        <a href="/admin/khs/list" class="btn btn-outline-secondary w-100">Reset</a>
      </div>
    </form>
  </div>

  <!-- Tabel KHS -->
  <div class="table-responsive">
    <table class="table khs-table" id="khsTable">
      <thead>
        <tr>
          <th>No</th>
          <th>Mahasiswa</th>
          <th>Semester</th>
          <th>Jml Matkul</th>
          <th>Total SKS</th>
          <th>IPS</th>
          <th class="no-print">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (khsList.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center py-5">
              <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
              <p class="text-muted">Belum ada nilai akhir yang dikunci untuk semester manapun.</p>
            </td>
          </tr>
        <% } else { %>
          <% khsList.forEach((khs, index) => { %>
          <tr>
            <td class="fw-bold"><%= index + 1 %></td>
            <td>
              <div class="d-flex align-items-center">
                <% if (khs.mahasiswa?.foto) { %>
                  <img src="<%= khs.mahasiswa.foto %>" alt="foto" class="foto-mahasiswa me-2">
                <% } else { %>
                  <div class="avatar-circle me-2"><%= (khs.mahasiswa?.nama || '?').charAt(0).toUpperCase() %></div>
                <% } %>
                <div>
                  <strong><%= khs.mahasiswa?.nama || 'Unknown' %></strong><br>
                  <small class="text-muted"><%= khs.mahasiswa?.nim || '-' %> &middot; Angkatan <%= khs.mahasiswa?.angkatan %></small>
                </div>
              </div>
            </td>
            <td><%= khs.semester || '-' %></td>
            <td>
              <%= khs.jumlahMatkul ?? 0 %>
              <% if (khs.jumlahBelumNilai > 0) { %>
                <span class="badge bg-warning text-dark ms-1" title="<%= khs.jumlahBelumNilai %> matkul belum ada nilai"><%= khs.jumlahBelumNilai %> belum dinilai</span>
              <% } %>
            </td>
            <td><%= khs.totalSKS ?? 0 %> SKS</td>
            <td>
              <span class="badge-ip"><%= khs.ips || '0.00' %></span>
            </td>
            <td class="no-print">
              <a href="/admin/khs/<%= khs.userId %>/<%= encodeURIComponent(khs.semester) %>" class="btn btn-sm btn-outline-primary btn-action" title="Detail / Cetak">
                <i class="bi bi-eye"></i> Detail
              </a>
            </td>
          </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  // Export tabel KHS yang sedang tampil (sesuai filter aktif) ke CSV,
  // langsung dari data yang sudah dirender - tidak perlu endpoint baru.
  function exportKhsCsv() {
    const table = document.getElementById('khsTable');
    if (!table) return;
    const rows = Array.from(table.querySelectorAll('tr'));
    const csv = rows.map(row => {
      const cells = Array.from(row.querySelectorAll('th, td'));
      return cells
        .filter(c => !c.classList.contains('no-print'))
        .map(c => '"' + c.innerText.replace(/\s+/g, ' ').trim().replace(/"/g, '""') + '"')
        .join(',');
    }).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'daftar_khs_' + new Date().toISOString().slice(0,10) + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }
</script>

<%- include('../partials/footer') %>
