<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    @page { size: A4 landscape; margin: 10mm 10mm 12mm; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #e9edf3; font-family: Arial, Helvetica, sans-serif; color: #000; font-size: 9pt; line-height: 1.3; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    /* Toolbar (tidak ikut tercetak) */
    .toolbar { position: sticky; top: 0; z-index: 50; display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; justify-content: space-between; padding: .65rem 1rem; background: #1b2a4a; color: #fff; font-size: 13px; }
    .toolbar a, .toolbar button { font: inherit; font-weight: 600; border: 0; border-radius: 8px; padding: .45rem .9rem; cursor: pointer; text-decoration: none; }
    .toolbar .kembali { background: rgba(255,255,255,.14); color: #fff; }
    .toolbar .cetak { background: #fff; color: #1e3a8a; }
    .toolbar small { opacity: .8; }

    /* Kertas */
    .kertas { width: 297mm; margin: 14px auto; padding: 10mm 12mm; background: #fff; box-shadow: 0 6px 24px rgba(27,42,74,.18); }

    /* Kop surat (sama dengan dokumen lain) */
    .kop-surat { display: flex; align-items: center; gap: 16px; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 3px double #000; }
    .logo-kop { width: 66px; height: auto; flex: 0 0 auto; }
    .teks-kop { flex: 1; line-height: 1.28; padding-left: 4px; }
    .teks-kop .nama-kampus { font-size: 16pt; font-weight: bold; margin: 0 0 3px; color: #2b4d8f; letter-spacing: .5px; text-transform: uppercase; }
    .teks-kop .alamat, .teks-kop .kontak { font-size: 8.5pt; margin: 0; color: #333; }
    .garis-kop { display: none; }

    .judul { text-align: center; margin: 8px 0 10px; }
    .judul h1 { font-size: 12.5pt; margin: 0 0 2px; letter-spacing: .3px; }
    .judul p { margin: 0; font-size: 10pt; }

    .ringkas { display: flex; flex-wrap: wrap; gap: 4px 22px; margin-bottom: 8px; font-size: 9pt; }
    .ringkas b { font-weight: 700; }

    table { width: 100%; border-collapse: collapse; }
    table.mx { font-size: 7.8pt; margin-bottom: 4px; }
    table.mx th, table.mx td { border: 1px solid #000; padding: 2px 3px; text-align: center; }
    table.mx thead th { background: #e5e7eb; font-weight: 700; }
    table.mx thead tr.grp th { background: #1e3a8a; color: #fff; font-size: 7pt; text-transform: uppercase; }
    table.mx td.nm { text-align: left; padding-left: 5px; }
    table.mx tr { break-inside: avoid; page-break-inside: avoid; }
    table.mx thead { display: table-header-group; }
    table.mx tr.rata td { background: #f3f4f6; font-weight: 700; border-top: 2px solid #000; }
    .fin { font-weight: 700; }

    .legend { font-size: 8pt; margin: 4px 0 10px; display: flex; gap: 4px 14px; flex-wrap: wrap; }
    .sw { display: inline-block; width: 9px; height: 9px; border: 1px solid #555; margin-right: 3px; vertical-align: -1px; }

    h2.sub { font-size: 10pt; margin: 12px 0 5px; break-after: avoid; }
    table.ket { font-size: 8.5pt; }
    table.ket th, table.ket td { border: 1px solid #000; padding: 2px 6px; }
    table.ket th { background: #facc15; text-align: center; }
    table.ket td.c { text-align: center; white-space: nowrap; }
    table.ket tr { break-inside: avoid; }

    .ttd-wrap { display: flex; justify-content: flex-end; margin-top: 16px; break-inside: avoid; }
    .tanda-tangan { width: 78mm; font-size: 9.5pt; line-height: 1.45; }
    .tanda-tangan .ruang { height: 54px; }
    .tanda-tangan .nama { font-weight: bold; text-decoration: underline; }
    .catatan { font-size: 7.8pt; color: #444; margin-top: 6px; }

    @media print {
      body { background: #fff; }
      .toolbar { display: none !important; }
      .kertas { width: auto; margin: 0; padding: 0; box-shadow: none; }
    }
  </style>
</head>
<body>

<div class="toolbar">
  <a class="kembali" href="<%= urlKembali %>">&larr; Kembali</a>
  <small>Di dialog cetak pilih &ldquo;Simpan sebagai PDF&rdquo; bila ingin berkas digital. Orientasi sudah diatur landscape.</small>
  <button class="cetak" type="button" onclick="window.print()">Cetak</button>
</div>

<div class="kertas">
  <%- include('../../partials/kop_surat') %>

  <div class="judul">
    <h1>REKAPITULASI HASIL EVALUASI DOSEN OLEH MAHASISWA (EDOM)</h1>
    <p><%= periode.nama %><%= periode.semester ? ' — Semester ' + periode.semester : '' %></p>
    <p style="font-size:9pt">Periode pengisian: <%= periode.tanggalMulai %> s/d <%= periode.tanggalSelesai %></p>
  </div>

  <% const r = rekap.ringkasan; %>
  <div class="ringkas">
    <span>Dosen dievaluasi: <b><%= r.jumlahDosen %></b></span>
    <span>Mahasiswa mengisi: <b><%= r.jumlahMahasiswa %></b></span>
    <span>Total evaluasi: <b><%= r.jumlahRespon %></b></span>
    <span>Rata-rata keseluruhan: <b><%= r.rataSemuaTeks %> (<%= r.pred.label %>)</b></span>
  </div>

  <table class="mx">
    <thead>
      <tr class="grp">
        <th rowspan="2" style="width:22px">No</th>
        <th rowspan="2" style="min-width:120px">Dosen</th>
        <th rowspan="2">Eval.</th>
        <% rekap.kelompok.forEach(k => { %><th colspan="<%= k.jumlah %>"><%= k.nama %></th><% }) %>
        <% if (rekap.indikatorAda.length > 1) { %><th colspan="<%= rekap.indikatorAda.length %>">Rata-rata Indikator</th><% } %>
        <th rowspan="2">Nilai Akhir</th>
        <th rowspan="2">Predikat</th>
      </tr>
      <tr>
        <% rekap.pertanyaan.forEach(p => { %><th>P<%= p.no %></th><% }) %>
        <% if (rekap.indikatorAda.length > 1) { rekap.indikatorAda.forEach(n => { %><th><%= n.substring(0, 5) %>.</th><% }) } %>
      </tr>
    </thead>
    <tbody>
      <% rekap.dosen.forEach((d, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td class="nm"><%= d.dosenNama %></td>
          <td><%= d.count %></td>
          <% d.nilai.forEach(v => { %>
            <% if (v) { %><td style="background:<%= v.pred.bg %>"><%= v.teks %></td><% } else { %><td>-</td><% } %>
          <% }) %>
          <% if (rekap.indikatorAda.length > 1) { rekap.indikatorAda.forEach(n => { const x = d.indikator.find(k => k.nama === n); %><td><%= x ? x.rata.toFixed(2) : '-' %></td><% }) } %>
          <td class="fin" style="background:<%= d.pred.bg %>"><%= d.rataTeks %></td>
          <td><%= d.pred.label %></td>
        </tr>
      <% }) %>
      <tr class="rata">
        <td colspan="3" style="text-align:right;padding-right:6px">Rata-rata semua dosen</td>
        <% rekap.pertanyaan.forEach(p => { %><td><%= p.rataTeks %></td><% }) %>
        <% if (rekap.indikatorAda.length > 1) { rekap.indikatorAda.forEach(n => { const x = rekap.indikatorSemua.find(k => k.nama === n); %><td><%= x ? x.rataTeks : '-' %></td><% }) } %>
        <td><%= r.rataSemuaTeks %></td>
        <td><%= r.pred.label %></td>
      </tr>
    </tbody>
  </table>

  <div class="legend">
    <strong>Skala 1–5:</strong>
    <span><span class="sw" style="background:#dcfce7"></span>4,50–5,00 Sangat Baik</span>
    <span><span class="sw" style="background:#dbeafe"></span>3,50–4,49 Baik</span>
    <span><span class="sw" style="background:#fef3c7"></span>2,50–3,49 Cukup</span>
    <span><span class="sw" style="background:#fee2e2"></span>&lt; 2,50 Kurang</span>
  </div>

  <h2 class="sub">Keterangan Pernyataan EDOM</h2>
  <table class="ket">
    <thead><tr><th style="width:42px">No.</th><th>Pernyataan EDOM</th><th style="width:100px">Indikator</th><th style="width:70px">Rata-rata</th></tr></thead>
    <tbody>
      <% rekap.pertanyaan.forEach(p => { %>
        <tr>
          <td class="c">P<%= p.no %></td>
          <td><%= p.pertanyaan %></td>
          <td class="c"><%= p.indikator || '-' %></td>
          <td class="c" style="background:<%= p.pred.bg %>"><b><%= p.rataTeks %></b></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p class="catatan">Nilai akhir = rata-rata seluruh evaluasi mahasiswa untuk dosen tersebut. Dicetak pada <%= tanggalCetak %>.</p>

  <div class="ttd-wrap">
    <div class="tanda-tangan">
      <div>Palopo, <%= tanggalCetak %></div>
      <div>Ketua Program Studi Teknik Elektronika</div>
      <div class="ruang"></div>
      <div class="nama">( ................................................ )</div>
      <div>NIDN. ........................................</div>
    </div>
  </div>
</div>

</body>
</html>
