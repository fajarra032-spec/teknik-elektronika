<%- include('../partials/header') %>

<style>
  .mk-table th {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    color: white; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; border: none;
  }
  .mk-table td { vertical-align: middle; padding: 1rem 0.75rem; }
  .table-responsive { border-radius: 1rem; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
  .btn-action { margin: 2px; border-radius: 8px; padding: 0.3rem 0.8rem; font-size: 0.85rem; }
  .progress-mini { height: 8px; border-radius: 4px; background: #e9ecef; overflow: hidden; width: 100px; }
  .progress-mini-bar { height: 100%; background: linear-gradient(135deg, #2193b0, #6dd5ed); }
</style>

<div class="container-fluid mt-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-clipboard-data me-2"></i>Rekap Rubrik Penilaian - Semua Mata Kuliah</h2>
    <form method="GET" class="d-flex gap-2">
      <select name="periode" class="form-select form-select-sm" style="min-width:220px;" onchange="this.form.submit()">
        <%
          // Rentang tahun ajaran yang bisa dipilih admin untuk lihat arsip.
          // Sama seperti dropdown semester di /admin/krs, tapi endYear
          // dihitung dinamis dari tahun berjalan supaya tidak perlu
          // diperbarui manual tiap tahun.
          const startYear = 2018;
          const endYear = new Date().getFullYear() + 1;
        %>
        <% for (let year = endYear; year >= startYear; year--) { %>
          <% const genapOpt = `Genap ${year - 1}/${year}`; %>
          <% const ganjilOpt = `Ganjil ${year - 1}/${year}`; %>
          <option value="<%= ganjilOpt %>" <%= periode === ganjilOpt ? 'selected' : '' %>><%= ganjilOpt %></option>
          <option value="<%= genapOpt %>" <%= periode === genapOpt ? 'selected' : '' %>><%= genapOpt %></option>
        <% } %>
      </select>
      <noscript><button class="btn btn-sm btn-outline-primary">Filter</button></noscript>
    </form>
  </div>
  <p class="text-muted small mb-3">
    <i class="bi bi-archive"></i> Pilih periode di atas untuk melihat arsip mata kuliah &amp; nilai semester-semester sebelumnya - data lama tidak dihapus, hanya tidak lagi ditampilkan ke dosen/mahasiswa setelah semester berganti.
  </p>

  <div class="table-responsive">
    <table class="table mk-table">
      <thead>
        <tr>
          <th>Kode</th>
          <th>Nama Mata Kuliah</th>
          <th>Dosen Pengampu</th>
          <th>SKS</th>
          <th>Mahasiswa</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (mkList.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-5">
              <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
              <p class="text-muted">Belum ada mata kuliah.</p>
            </td>
          </tr>
        <% } %>
        <% mkList.forEach(mk => { %>
          <tr>
            <td><span class="badge bg-primary bg-opacity-10 text-primary"><%= mk.kode %></span></td>
            <td><strong><%= mk.nama %></strong></td>
            <td><%= mk.namaDosen || '-' %></td>
            <td class="text-center"><%= mk.sks %></td>
            <td class="text-center"><%= mk.jumlahMahasiswa || 0 %></td>
            <td>
              <a href="/admin/rubrik/<%= mk.id %>?periode=<%= encodeURIComponent(periode) %>" class="btn btn-sm btn-outline-primary btn-action">
                <i class="bi bi-eye"></i> Lihat Rubrik &amp; Kelengkapan
              </a>
              <a href="/admin/rubrik/<%= mk.id %>/cetak?periode=<%= encodeURIComponent(periode) %>" target="_blank" class="btn btn-sm btn-outline-secondary btn-action">
                <i class="bi bi-printer"></i> Cetak
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
