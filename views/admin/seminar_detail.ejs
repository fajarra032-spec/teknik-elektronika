<%- include('../partials/header') %>

<style>
  .detail-header {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    border-radius: 1rem;
    padding: 2rem;
    color: white;
    margin-bottom: 2rem;
  }
  .info-card {
    background: white;
    border-radius: 1rem;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>

<div class="container-fluid mt-4">
  <div class="detail-header d-flex justify-content-between align-items-center">
    <div>
      <h2><i class="bi bi-calendar-event me-2"></i>Detail Seminar</h2>
    </div>
    <a href="/admin/seminar" class="btn btn-light">
      <i class="bi bi-arrow-left me-2"></i>Kembali
    </a>
  </div>

  <!-- Info Mahasiswa -->
  <div class="info-card">
    <h5 class="fw-bold mb-3">Data Mahasiswa</h5>
    <div class="row">
      <div class="col-md-6">
        <p><strong>NIM:</strong> <%= mahasiswa.nim || '-' %></p>
        <p><strong>Nama:</strong> <%= mahasiswa.nama %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Email:</strong> <%= mahasiswa.email || '-' %></p>
        <p><strong>No. HP:</strong> <%= mahasiswa.noHp || '-' %></p>
      </div>
    </div>
  </div>

  <!-- Info Seminar -->
  <div class="info-card">
    <h5 class="fw-bold mb-3">Detail Permohonan</h5>
    <table class="table table-borderless">
      <tr><th style="width: 150px;">Judul</th><td><%= seminar.judul %></td></tr>
      <% if (seminar.lokasiMagang && seminar.lokasiMagang.length) { %>
        <tr><th>Lokasi Magang</th><td>
          <% seminar.lokasiMagang.forEach(l => { if (l.perusahaan) { %><div>Magang <%= l.ke %>: <%= l.perusahaan %></div><% } }) %>
        </td></tr>
      <% } %>
      <% if (seminar.pendampingLapangan) { %><tr><th>Pendamping Lapangan</th><td><%= seminar.pendampingLapangan %></td></tr><% } %>
      <% if (seminar.laporan) { %>
        <tr><th>Laporan Magang</th><td>
          <% [1, 2, 3].forEach(ke => { %>
            <span class="badge <%= seminar.laporan[ke] ? 'bg-success' : 'bg-warning text-dark' %> me-1">Laporan <%= ke %>: <%= seminar.laporan[ke] ? 'sudah' : 'belum' %></span>
          <% }) %>
        </td></tr>
      <% } %>
      <% if (typeof seminar.pembayaranLunas !== 'undefined') { %>
        <tr><th>Bukti Pelunasan</th><td><%= seminar.pembayaranLunas ? 'Mahasiswa menyatakan sudah dari Bagian Keuangan' : 'Belum' %></td></tr>
      <% } %>
      <% if (seminar.catatanMahasiswa) { %><tr><th>Catatan Mahasiswa</th><td><%= seminar.catatanMahasiswa %></td></tr><% } %>
      <tr><th>Tanggal Usulan</th><td><%= seminar.tanggal ? new Date(seminar.tanggal).toLocaleDateString('id-ID') : '-' %></td></tr>
      <tr><th>Waktu</th><td><%= seminar.waktu || '-' %></td></tr>
      <tr><th>Tempat</th><td><%= seminar.tempat || '-' %></td></tr>
      <tr><th>Dosen Pembimbing (PA)</th><td><%= seminar.pembimbing || seminar.pembimbing1 || '-' %></td></tr>
      <tr><th>Penguji</th><td><%= seminar.penguji || '-' %></td></tr>
      <tr><th>Status</th><td>
        <% if (seminar.status === 'pending') { %>
          <span class="badge bg-warning text-dark">Pending</span>
        <% } else if (seminar.status === 'approved') { %>
          <span class="badge bg-success">Disetujui</span>
        <% } else if (seminar.status === 'rejected') { %>
          <span class="badge bg-danger">Ditolak</span>
        <% } else { %>
          <span class="badge bg-secondary"><%= seminar.status %></span>
        <% } %>
      </td></tr>
      <% if (seminar.jadwal) { %>
        <tr><th>Jadwal</th><td>
          <%= seminar.jadwal.tanggal ? new Date(seminar.jadwal.tanggal).toLocaleDateString('id-ID') : '' %>,
          <%= seminar.jadwal.waktu || '' %>, <%= seminar.jadwal.tempat || '' %>
          <%= seminar.jadwal.penguji ? ', Penguji: ' + seminar.jadwal.penguji : '' %>
        </td></tr>
      <% } %>
      <% if (seminar.alasanPenolakan) { %>
        <tr><th>Alasan Penolakan</th><td class="text-danger"><%= seminar.alasanPenolakan %></td></tr>
      <% } %>
    </table>
  </div>

  <!-- Riwayat -->
  <% if (seminar.history && seminar.history.length > 0) { %>
    <div class="info-card">
      <h5 class="fw-bold mb-3">Riwayat</h5>
      <ul class="list-group">
        <% seminar.history.forEach(item => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= item.catatan %>
            <small class="text-muted"><%= new Date(item.timestamp).toLocaleString('id-ID') %></small>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Form Aksi (pending: setujui/tolak; approved: ubah jadwal / batalkan) -->
  <% if (seminar.status === 'pending' || seminar.status === 'approved') { %>
  <% const sudah = seminar.status === 'approved'; const jd = seminar.jadwal || {}; %>
    <div class="row">
      <div class="col-md-6 mb-3">
        <div class="info-card">
          <h5 class="fw-bold mb-3"><%= sudah ? 'Ubah Jadwal Seminar' : 'Setujui & Tentukan Jadwal' %></h5>
          <% if (!sudah) { %><p class="text-muted small">Jadwal yang Anda tetapkan otomatis masuk ke Jadwal Penting dan mahasiswa mendapat notifikasi.</p><% } %>
          <form method="POST" action="/admin/seminar/<%= seminar.id %>/approve">
            <div class="mb-2">
              <label>Tanggal</label>
              <input type="date" name="tanggal" class="form-control" value="<%= jd.tanggal ? String(jd.tanggal).slice(0, 10) : '' %>" required>
            </div>
            <div class="mb-2">
              <label>Waktu</label>
              <input type="text" name="waktu" class="form-control" placeholder="09:00 - 12:00" value="<%= jd.waktu || '' %>" required>
            </div>
            <div class="mb-2">
              <label>Tempat</label>
              <input type="text" name="tempat" class="form-control" placeholder="Ruang Seminar" value="<%= jd.tempat || '' %>" required>
            </div>
            <div class="mb-2">
              <label>Penguji (opsional)</label>
              <input type="text" name="penguji" class="form-control" value="<%= jd.penguji || '' %>">
            </div>
            <div class="mb-2">
              <label>Catatan (opsional)</label>
              <input type="text" name="catatan" class="form-control" value="<%= jd.catatan || '' %>">
            </div>
            <button type="submit" class="btn btn-success"><%= sudah ? 'Simpan Jadwal' : 'Setujui' %></button>
          </form>
        </div>
      </div>
      <div class="col-md-6 mb-3">
        <div class="info-card">
          <h5 class="fw-bold mb-3"><%= sudah ? 'Batalkan Seminar' : 'Tolak Seminar' %></h5>
          <% if (sudah) { %><p class="text-muted small">Agenda di Jadwal Penting ikut dihapus dan mahasiswa diberi tahu.</p><% } %>
          <form method="POST" action="/admin/seminar/<%= seminar.id %>/reject">
            <div class="mb-2">
              <label>Alasan Penolakan</label>
              <textarea name="alasan" class="form-control" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-danger"><%= sudah ? 'Batalkan' : 'Tolak' %></button>
          </form>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>