<%- include('../partials/header') %>

<%
  // webViewLink Drive bukan file gambar; ubah ke URL thumbnail supaya bisa tampil di <img>
  const thumbUrl = u => {
    if (!u) return '';
    if (/drive\.google\.com/.test(u)) {
      const m = u.match(/\/d\/([\w-]+)/) || u.match(/[?&]id=([\w-]+)/);
      if (m) return 'https://drive.google.com/thumbnail?id=' + m[1] + '&sz=w160';
    }
    return u;
  };
  const excerpt = (html, n) => {
    const t = String(html || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
    return t.length > n ? t.slice(0, n).trim() + '…' : t;
  };
  const toTime = v => { const t = new Date(v).getTime(); return isNaN(t) ? 0 : t; };
  const fmtTgl = v => {
    const t = toTime(v);
    return t ? new Date(t).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  };
  const list = Array.isArray(berita) ? berita : [];
  const nGambar = list.filter(b => b.gambar).length;
  const pesan = { ditambahkan: 'ditambahkan', diupdate: 'diperbarui', dihapus: 'dihapus' };
%>

<style>
  .ea {
    --ea-ink: #1b2a4a;
    --ea-muted: #5d6b85;
    --ea-line: #e2e7ef;
    --ea-surface: #ffffff;
    --ea-accent: #1e3a8a;
    --ea-accent-soft: #e8eefc;
    --ea-hover: #f6f8fd;
    color: var(--ea-ink);
    font-feature-settings: "tnum" 1;
  }
  .ea a { text-decoration: none; }
  .ea :focus-visible { outline: 2px solid var(--ea-accent); outline-offset: 2px; border-radius: 6px; }

  /* Judul halaman */
  .ea-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; justify-content: space-between; margin-bottom: 1.25rem; }
  .ea-head h1 { font-size: 1.65rem; font-weight: 700; letter-spacing: -0.015em; margin: 0 0 0.25rem; }
  .ea-head p { margin: 0; color: var(--ea-muted); font-size: 0.95rem; }

  .ea-btn { display: inline-flex; align-items: center; gap: 0.4rem; border: 1px solid transparent; border-radius: 8px; padding: 0.45rem 0.9rem; font-size: 0.875rem; font-weight: 600; line-height: 1.3; cursor: pointer; background: none; transition: background-color .15s, border-color .15s, color .15s; }
  .ea-btn-primary { background: var(--ea-accent); color: #fff; }
  .ea-btn-primary:hover { background: #172f73; color: #fff; }
  .ea-btn-edit { border-color: var(--ea-line); color: var(--ea-ink); padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #fff; }
  .ea-btn-edit:hover { background: var(--ea-hover); color: var(--ea-accent); }
  .ea-btn-icon { border-color: var(--ea-line); color: var(--ea-muted); padding: 0.3rem 0.55rem; background: #fff; }
  .ea-btn-icon:hover { background: var(--ea-hover); color: var(--ea-ink); }

  /* Notifikasi */
  .ea-notice { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; background: #eaf7ef; border: 1px solid #bfe3cd; border-left: 4px solid #1d7a46; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; }
  .ea-notice span { color: #1d6b3f; font-size: 0.95rem; }
  .ea-notice button { border: 0; background: none; color: #1d6b3f; font-weight: 600; font-size: 0.9rem; border-bottom: 1px solid currentColor; padding: 0; }

  /* Toolbar */
  .ea-toolbar { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; }
  .ea-search { position: relative; flex: 1 1 260px; max-width: 420px; }
  .ea-search i { position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%); color: var(--ea-muted); pointer-events: none; }
  .ea-search input { width: 100%; border: 1px solid var(--ea-line); border-radius: 8px; padding: 0.5rem 0.8rem 0.5rem 2.2rem; font-size: 0.9rem; background: #fff; color: var(--ea-ink); }
  .ea-search input:focus { outline: 2px solid var(--ea-accent); outline-offset: 0; border-color: transparent; }
  .ea-seg { display: inline-flex; background: #eef1f6; border-radius: 9px; padding: 3px; gap: 2px; overflow-x: auto; max-width: 100%; }
  .ea-seg button { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.75rem; border: 0; background: none; border-radius: 7px; color: var(--ea-muted); font-size: 0.85rem; font-weight: 600; white-space: nowrap; }
  .ea-seg button:hover { color: var(--ea-ink); }
  .ea-seg button.is-active { background: #fff; color: var(--ea-ink); box-shadow: 0 1px 2px rgba(27, 42, 74, 0.12); }
  .ea-seg small { font-weight: 600; opacity: 0.75; }

  /* Daftar */
  .ea-list { background: var(--ea-surface); border: 1px solid var(--ea-line); border-radius: 12px; overflow: hidden; }
  .ea-cols, .ea-row { display: grid; grid-template-columns: minmax(0, 1fr) 90px 120px 130px; column-gap: 1rem; align-items: center; }
  .ea-cols { padding: 0.6rem 1rem 0.6rem 1.15rem; background: #fafbfd; border-bottom: 1px solid var(--ea-line); color: var(--ea-muted); font-size: 0.8rem; font-weight: 600; }
  .ea-cols > :last-child { text-align: right; }
  .ea-row { position: relative; padding: 0.85rem 1rem 0.85rem 1.15rem; border-bottom: 1px solid var(--ea-line); --c: #2f6fed; }
  .ea-row:last-of-type { border-bottom: 0; }
  .ea-row:hover { background: var(--ea-hover); }
  .ea-row::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c); }
  .ea-row.no-img { --c: #9aa5b8; }

  .ea-main { display: flex; gap: 0.85rem; align-items: center; min-width: 0; }
  .ea-thumb { flex: 0 0 64px; width: 64px; height: 48px; border-radius: 6px; object-fit: cover; background: #eef1f6; border: 1px solid var(--ea-line); display: block; }
  .ea-thumb-empty { flex: 0 0 64px; width: 64px; height: 48px; border-radius: 6px; background: #f3f5f9; border: 1px dashed var(--ea-line); color: #b6bfce; display: grid; place-items: center; }
  .ea-body { min-width: 0; }
  .ea-title { display: block; color: var(--ea-ink); font-weight: 600; font-size: 0.95rem; line-height: 1.4; overflow-wrap: anywhere; }
  .ea-title:hover { color: var(--ea-accent); text-decoration: underline; text-underline-offset: 3px; }
  .ea-excerpt { margin-top: 0.1rem; font-size: 0.83rem; color: var(--ea-muted); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
  .ea-meta { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; margin-top: 0.2rem; font-size: 0.8rem; color: var(--ea-muted); }
  .ea-meta span { display: inline-flex; align-items: center; gap: 0.3rem; }

  .ea-pill { display: inline-flex; align-items: center; gap: 0.3rem; border-radius: 999px; padding: 0.15rem 0.65rem; font-size: 0.78rem; font-weight: 600; background: #eef1f6; color: var(--ea-muted); }
  .ea-date { color: var(--ea-muted); font-size: 0.85rem; }
  .ea-actions { display: flex; gap: 0.4rem; align-items: center; justify-content: flex-end; }
  .ea-actions form { margin: 0; }
  .ea-actions .dropdown-menu { font-size: 0.875rem; border-color: var(--ea-line); border-radius: 10px; box-shadow: 0 8px 24px rgba(27, 42, 74, 0.12); }

  .ea-empty { padding: 3rem 1.5rem; text-align: center; color: var(--ea-muted); }
  .ea-empty i { font-size: 2rem; display: block; margin-bottom: 0.5rem; color: #b6bfce; }
  .ea-empty strong { display: block; color: var(--ea-ink); margin-bottom: 0.25rem; }
  .ea-more { text-align: center; padding: 0.9rem; border-top: 1px solid var(--ea-line); }
  .ea-foot { color: var(--ea-muted); font-size: 0.8rem; margin: 0.6rem 0.25rem 0; }
  [hidden] { display: none !important; }

  /* Ponsel: satu kolom, dilihat dan tanggal di bawah judul */
  @media (max-width: 767.98px) {
    .ea-cols { display: none; }
    .ea-row { grid-template-columns: minmax(0, 1fr) auto; row-gap: 0.55rem; }
    .ea-main { grid-column: 1 / -1; }
    .ea-actions { grid-column: 1 / -1; justify-content: flex-start; }
    .ea-row > .ea-state { grid-column: 1; }
    .ea-row > .ea-date { grid-column: 2; text-align: right; }
    .ea-head h1 { font-size: 1.4rem; }
  }
</style>

<div class="container-xl ea py-4">

  <header class="ea-head">
    <div>
      <h1>Kelola Berita</h1>
      <p>Tulis, rapikan, dan hapus informasi serta pengumuman program studi.</p>
    </div>
    <a href="/admin/berita/create" class="ea-btn ea-btn-primary"><i class="bi bi-plus-lg"></i> Tambah berita</a>
  </header>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="ea-notice" role="status" id="eaNotice">
      <span><strong>Berhasil.</strong> Berita telah <%= pesan[success] || success %>.</span>
      <button type="button" id="eaNoticeTutup">Tutup</button>
    </div>
  <% } %>

  <div class="ea-toolbar">
    <div class="ea-search">
      <i class="bi bi-search"></i>
      <label for="eaCari" class="visually-hidden">Cari judul, penulis, atau isi</label>
      <input type="search" id="eaCari" placeholder="Cari judul atau penulis" autocomplete="off">
    </div>
    <div class="ea-seg" role="group" aria-label="Filter gambar">
      <button type="button" class="is-active" data-g="">Semua <small><%= list.length %></small></button>
      <button type="button" data-g="ada">Dengan gambar <small><%= nGambar %></small></button>
      <button type="button" data-g="tidak">Tanpa gambar <small><%= list.length - nGambar %></small></button>
    </div>
  </div>

  <section class="ea-list" aria-label="Daftar berita">
    <% if (list.length === 0) { %>
      <div class="ea-empty">
        <i class="bi bi-inbox"></i>
        <strong>Belum ada berita</strong>
        Mulai dengan <a href="/admin/berita/create">menulis berita pertama</a>.
      </div>
    <% } else { %>
      <div class="ea-cols" aria-hidden="true">
        <div>Berita</div><div>Dilihat</div><div>Tanggal</div><div>Aksi</div>
      </div>

      <div id="eaRows">
      <% list.forEach(b => {
           const judul = b.judul || '(Tanpa judul)';
           const ringkas = excerpt(b.isi, 140);
           const q = [judul, b.penulis, b.sumber, excerpt(b.isi, 400)].join(' ').toLowerCase();
      %>
        <article class="ea-row <%= b.gambar ? '' : 'no-img' %>" data-q="<%= q %>" data-g="<%= b.gambar ? 'ada' : 'tidak' %>">
          <div class="ea-main">
            <% if (b.gambar) { %>
              <img class="ea-thumb" src="<%= thumbUrl(b.gambar) %>" alt="" loading="lazy" referrerpolicy="no-referrer"
                   onerror="this.outerHTML='<div class=&quot;ea-thumb-empty&quot;><i class=&quot;bi bi-image&quot;></i></div>'">
            <% } else { %>
              <div class="ea-thumb-empty"><i class="bi bi-image"></i></div>
            <% } %>
            <div class="ea-body">
              <a class="ea-title" href="/admin/berita/<%= b.id %>/edit"><%= judul %></a>
              <% if (ringkas) { %><div class="ea-excerpt"><%= ringkas %></div><% } %>
              <div class="ea-meta">
                <span><i class="bi bi-person"></i> <%= b.penulis || '-' %></span>
                <% if (b.sumber) { %><span><i class="bi bi-link-45deg"></i> <%= b.sumber %></span><% } %>
              </div>
            </div>
          </div>
          <div class="ea-state"><span class="ea-pill"><i class="bi bi-eye"></i> <%= b.dilihat || 0 %></span></div>
          <div class="ea-date"><%= fmtTgl(b.tanggal) %></div>
          <div class="ea-actions">
            <a href="/admin/berita/<%= b.id %>/edit" class="ea-btn ea-btn-edit"><i class="bi bi-pencil-square"></i> Edit</a>
            <div class="dropdown">
              <button class="ea-btn ea-btn-icon" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="Menu lainnya untuk <%= judul %>">
                <i class="bi bi-three-dots"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/berita/<%= b.id %>" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-2"></i>Lihat di halaman publik</a></li>
                <li><a class="dropdown-item" href="/admin/berita/<%= b.id %>/edit"><i class="bi bi-pencil-square me-2"></i>Edit</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form method="POST" action="/admin/berita/<%= b.id %>/delete" data-konfirmasi="Hapus &quot;<%= judul %>&quot; secara permanen? Gambar di Drive juga ikut terhapus.">
                    <button class="dropdown-item text-danger" type="submit"><i class="bi bi-trash me-2"></i>Hapus</button>
                  </form>
                </li>
              </ul>
            </div>
          </div>
        </article>
      <% }) %>
      </div>

      <div class="ea-empty" id="eaKosong" hidden>
        <i class="bi bi-search"></i>
        <strong>Tidak ada hasil</strong>
        Coba kata kunci lain, atau ganti filter gambar.
      </div>
      <div class="ea-more" id="eaMore" hidden>
        <button type="button" class="ea-btn ea-btn-icon" id="eaMoreBtn"></button>
      </div>
    <% } %>
  </section>

  <% if (list.length > 0) { %><p class="ea-foot" id="eaFoot" aria-live="polite"></p><% } %>
</div>

<script>
  (function () {
    var STEP = 40;
    var rows = Array.prototype.slice.call(document.querySelectorAll('#eaRows .ea-row'));
    var cari = document.getElementById('eaCari');
    var kosong = document.getElementById('eaKosong');
    var more = document.getElementById('eaMore');
    var moreBtn = document.getElementById('eaMoreBtn');
    var foot = document.getElementById('eaFoot');
    var segs = Array.prototype.slice.call(document.querySelectorAll('.ea-seg button'));
    var gambar = '';
    var limit = STEP;

    // Notifikasi: tutup manual / hilang sendiri, dan bersihkan ?success= dari alamat
    var notice = document.getElementById('eaNotice');
    if (notice) {
      var tutup = function () { notice.remove(); };
      document.getElementById('eaNoticeTutup').addEventListener('click', tutup);
      setTimeout(tutup, 5000);
    }

    // Kata pencarian dibawa lewat ?q= supaya tetap ada setelah kembali dari edit
    var url = new URL(location.href);
    url.searchParams.delete('success');
    if (cari && url.searchParams.get('q')) cari.value = url.searchParams.get('q');

    function terapkan() {
      if (!rows.length) return;
      var kata = (cari.value || '').toLowerCase().trim().split(/\s+/).filter(Boolean);
      var cocok = rows.filter(function (r) {
        if (gambar && r.getAttribute('data-g') !== gambar) return false;
        var q = r.getAttribute('data-q');
        return kata.every(function (k) { return q.indexOf(k) !== -1; });
      });
      rows.forEach(function (r) { r.hidden = true; });
      cocok.slice(0, limit).forEach(function (r) { r.hidden = false; });

      kosong.hidden = cocok.length > 0;
      var sisa = cocok.length - limit;
      more.hidden = sisa <= 0;
      if (sisa > 0) moreBtn.textContent = 'Tampilkan ' + Math.min(STEP, sisa) + ' lagi (sisa ' + sisa + ')';
      foot.textContent = (kata.length || gambar)
        ? cocok.length + ' dari ' + rows.length + ' berita cocok'
        : rows.length + ' berita';

      var u = new URL(location.href);
      u.searchParams.delete('success');
      if (cari.value.trim()) u.searchParams.set('q', cari.value.trim()); else u.searchParams.delete('q');
      history.replaceState(null, '', u.pathname + u.search);
    }

    if (cari) cari.addEventListener('input', function () { limit = STEP; terapkan(); });
    if (moreBtn) moreBtn.addEventListener('click', function () { limit += STEP; terapkan(); });
    segs.forEach(function (b) {
      b.addEventListener('click', function () {
        gambar = b.getAttribute('data-g');
        segs.forEach(function (x) { x.classList.toggle('is-active', x === b); });
        limit = STEP; terapkan();
      });
    });
    terapkan();

    // Konfirmasi hapus
    document.querySelectorAll('form[data-konfirmasi]').forEach(function (f) {
      f.addEventListener('submit', function (e) {
        if (!confirm(f.getAttribute('data-konfirmasi'))) e.preventDefault();
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
