<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-mortarboard me-2"></i><%= title %></h4>
    <div class="d-flex gap-2">
      <a href="/admin/tracklulusan/survey" class="btn btn-outline-primary">
        <i class="bi bi-clipboard-check me-1"></i> Tinjau Survei Mandiri
      </a>
      <a href="/admin/tracklulusan/create" class="btn btn-gradient btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Tambah Lulusan
      </a>
    </div>
  </div>

  <form method="GET" class="row g-2 mb-3">
    <div class="col-auto">
      <select name="tahun" class="form-select" onchange="this.form.submit()">
        <option value="">Semua Tahun</option>
        <% tahunList.forEach(function(t) { %>
          <option value="<%= t %>" <%= String(filterTahun) === String(t) ? 'selected' : '' %>><%= t %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-auto">
      <select name="status" class="form-select" onchange="this.form.submit()">
        <option value="">Semua Status</option>
        <option value="bekerja" <%= filterStatus === 'bekerja' ? 'selected' : '' %>>Bekerja</option>
        <option value="wirausaha" <%= filterStatus === 'wirausaha' ? 'selected' : '' %>>Wirausaha</option>
        <option value="melanjutkan_studi" <%= filterStatus === 'melanjutkan_studi' ? 'selected' : '' %>>Melanjutkan Studi</option>
        <option value="belum_bekerja" <%= filterStatus === 'belum_bekerja' ? 'selected' : '' %>>Belum Bekerja</option>
      </select>
    </div>
    <div class="col-auto">
      <select name="sumber" class="form-select" onchange="this.form.submit()">
        <option value="">Semua Sumber</option>
        <option value="manual" <%= filterSumber === 'manual' ? 'selected' : '' %>>Input Admin</option>
        <option value="survei" <%= filterSumber === 'survei' ? 'selected' : '' %>>Survei Mandiri</option>
      </select>
    </div>
  </form>

  <div class="info-card">
    <div class="card-body">
      <% if (lulusan.length === 0) { %>
        <p class="text-muted mb-0 text-center py-4">Belum ada data lulusan.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Nama</th>
                <th>NIM</th>
                <th>Tahun Lulus</th>
                <th>Status</th>
                <th>Tempat Kerja</th>
                <th>Sumber</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% lulusan.forEach(function(l) { %>
                <tr>
                  <td><%= l.nama %></td>
                  <td><%= l.nim %></td>
                  <td><%= l.tahunLulus || '-' %></td>
                  <td><span class="badge bg-info-subtle text-info-emphasis"><%= l.status %></span></td>
                  <td><%= l.tempatKerja || '-' %></td>
                  <td>
                    <% if (l.sumber === 'manual') { %>
                      <span class="badge bg-secondary">Input Admin</span>
                    <% } else { %>
                      <span class="badge bg-<%= l.isPublic ? 'success' : 'warning' %>">
                        Survei &middot; <%= l.isPublic ? 'Publik' : 'Menunggu' %>
                      </span>
                    <% } %>
                  </td>
                  <td class="text-nowrap">
                    <% if (l.sumber === 'manual') { %>
                      <a href="/admin/tracklulusan/<%= l.rawId %>" class="btn btn-icon-sm btn-detail" title="Detail"><i class="bi bi-eye"></i></a>
                      <a href="/admin/tracklulusan/<%= l.rawId %>/edit" class="btn btn-icon-sm btn-edit" title="Edit"><i class="bi bi-pencil"></i></a>
                    <% } else { %>
                      <form method="POST" action="/admin/tracklulusan/survey/<%= l.rawId %>/toggle" style="display:inline">
                        <button type="submit" class="btn btn-sm <%= l.isPublic ? 'btn-outline-danger' : 'btn-outline-success' %>">
                          <%= l.isPublic ? 'Sembunyikan' : 'Tampilkan' %>
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
