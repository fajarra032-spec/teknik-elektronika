<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>SK Mengajar - <%= namaDosen %></title>
  <style>
    @page {
      size: A4;
      margin: 1.8cm 2cm 1.6cm 2.2cm;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Times New Roman', Times, serif;
      font-size: 11.5pt;
      line-height: 1.5;
      color: #111;
      background: #eef1f6;
      margin: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* ================= KERTAS ================= */
    .lembar {
      background: #fff;
      max-width: 21cm;
      min-height: 29.7cm;
      margin: 24px auto;
      padding: 1.8cm 2cm 1.6cm 2.2cm;
      position: relative;
      box-shadow: 0 6px 24px rgba(15, 23, 42, 0.12);
      border-radius: 2px;
    }

    /* ================= KOP SURAT ================= */
    .kop-surat {
      display: flex;
      align-items: center;
      gap: 18px;
      padding-bottom: 10px;
      margin-bottom: 18px;
      border-bottom: 3px double #000;
    }
    .logo-kop {
      width: 82px;
      height: auto;
      flex: 0 0 auto;
    }
    .teks-kop {
      flex: 1;
      font-family: Arial, Helvetica, sans-serif;
      text-align: left;
      line-height: 1.3;
      padding-left: 4px;
    }
    .teks-kop .nama-kampus {
      font-size: 20pt;
      font-weight: bold;
      margin: 0 0 4px;
      color: #2b4d8f;
      text-transform: uppercase;
      letter-spacing: .5px;
      text-align: left;
    }
    .teks-kop .alamat,
    .teks-kop .kontak {
      font-size: 10pt;
      margin: 0;
      color: #333;
      text-align: left;
    }
    .teks-kop .kontak { margin-top: 2px; }

    /* ================= JUDUL SK ================= */
    .judul-sk {
      text-align: center;
      margin: 20px 0 18px;
    }
    .judul-sk .label-keputusan {
      font-size: 13pt;
      font-weight: bold;
      letter-spacing: 2px;
      margin: 0;
    }
    .judul-sk .nomor {
      font-size: 11.5pt;
      font-weight: bold;
      margin: 3px 0 12px;
    }
    .judul-sk .tentang {
      margin: 10px 0 4px;
      font-size: 11.5pt;
      letter-spacing: 1px;
    }
    .judul-sk .judul-utama {
      font-size: 12.5pt;
      font-weight: bold;
      text-transform: uppercase;
      text-decoration: underline;
      margin: 4px 0;
      line-height: 1.4;
      letter-spacing: .3px;
    }
    .judul-sk .periode {
      font-weight: bold;
      margin: 0;
    }
    .judul-sk .kaprodi-line {
      margin-top: 14px;
      font-size: 11.5pt;
    }

    /* ================= DIKTUM ================= */
    :root {
      --lebar-label: 96px;
      --lebar-titik: 14px;
      --lebar-marker: 24px;
      --jarak-item: 6px;
    }

    .blok-diktum { margin-top: 2px; }

    .baris-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: 10px;
      break-inside: avoid;
    }
    .baris-item .label-item {
      width: var(--lebar-label);
      flex: 0 0 var(--lebar-label);
      font-weight: bold;
    }
    .baris-item .titik-item {
      width: var(--lebar-titik);
      flex: 0 0 var(--lebar-titik);
      font-weight: bold;
      text-align: left;
    }
    .baris-item .isi-item {
      flex: 1 1 auto;
      text-align: justify;
      text-justify: inter-word;
      min-width: 0;
    }

    .diktum-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: var(--jarak-item);
      break-inside: avoid;
    }
    .diktum-item .marker {
      flex: 0 0 var(--lebar-marker);
      width: var(--lebar-marker);
      font-weight: normal;
      text-align: left;
    }
    .diktum-item .teks {
      flex: 1 1 auto;
      text-align: justify;
      text-justify: inter-word;
      min-width: 0;
    }
    .diktum-item:last-child { margin-bottom: 0; }

    .memutuskan {
      text-align: center;
      font-weight: bold;
      letter-spacing: 2px;
      margin: 18px 0 12px;
    }

    /* ================= TANDA TANGAN ================= */
    .tanda-tangan-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-top: 32px;
      break-inside: avoid;
    }
    .tanda-tangan {
      width: 300px;
      text-align: left;
    }
    .tanda-tangan .info-ttd {
      margin: 0;
      position: relative;
      z-index: 1;
      line-height: 1.45;
    }
    .area-ttd {
      position: relative;
      height: 55px;
    }
    .img-ttd {
      position: absolute;
      top: -60px;
      left: -20px;
      height: 185px;
      width: auto;
      z-index: 10;
      mix-blend-mode: multiply;
    }
    .nama-ttd {
      font-weight: bold;
      text-decoration: underline;
      margin: 0;
      position: relative;
      z-index: 1;
      letter-spacing: .3px;
    }
    .nip-ttd {
      margin: 2px 0 0;
    }

    /* ================= TEMBUSAN ================= */
    .tembusan {
      margin-top: 28px;
      font-size: 10.5pt;
    }
    .tembusan p {
      margin: 0 0 4px;
      font-weight: bold;
    }
    .tembusan ol {
      margin: 0;
      padding-left: 22px;
    }
    .tembusan ol li { margin-bottom: 2px; }

    /* ================= LAMPIRAN (HALAMAN 2) ================= */
    .kop-lampiran {
      font-size: 11pt;
      line-height: 1.55;
      margin-bottom: 0;
    }

    /* label "Lampiran" & "Tanggal" sejajar */
    .kop-lampiran .baris-lampiran {
      display: flex;
      align-items: flex-start;
      margin-bottom: 4px;
    }
    .kop-lampiran .label-lampiran {
      flex: 0 0 76px;
      width: 76px;
      font-weight: normal;
    }
    .kop-lampiran .titik-lampiran {
      flex: 0 0 14px;
      width: 14px;
    }
    .kop-lampiran .isi-lampiran {
      flex: 1 1 auto;
      text-align: justify;
      text-justify: inter-word;
      min-width: 0;
    }

    .kop-lampiran .garis {
      border: 0;
      border-top: 1.5px solid #000;
      margin: 12px 0 18px;
    }

    /* Judul lampiran */
    .judul-lampiran {
      text-align: center;
      font-weight: bold;
      text-transform: uppercase;
      margin: 6px 0 4px;
      line-height: 1.5;
      letter-spacing: .5px;
      font-size: 12pt;
    }

    /* Data dosen di lampiran */
    .data-dosen {
      text-align: center;
      margin: 10px 0 18px;
      line-height: 1.5;
    }
    .data-dosen .nama-dosen {
      font-weight: bold;
      text-decoration: underline;
      font-size: 12pt;
      margin: 0 0 2px;
      letter-spacing: .3px;
    }
    .data-dosen .nip-dosen {
      margin: 0 0 6px;
      font-size: 11pt;
    }
    .data-dosen .periode {
      font-weight: bold;
      text-transform: uppercase;
      margin: 0;
      font-size: 11.5pt;
      letter-spacing: .4px;
    }

    /* ================= TABEL LAMPIRAN ================= */
    table.tabel-lampiran {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0 10px;
      font-size: 11pt;
    }
    table.tabel-lampiran th,
    table.tabel-lampiran td {
      border: 1px solid #000;
      padding: 8px 10px;
      vertical-align: top;
    }
    table.tabel-lampiran th {
      background: #dfe7f5;
      font-weight: bold;
      text-align: center;
      letter-spacing: .3px;
    }
    table.tabel-lampiran td.no,
    table.tabel-lampiran td.sks { text-align: center; }
    table.tabel-lampiran tbody tr:nth-child(even) { background: #f7f9fc; }
    table.tabel-lampiran tfoot td {
      font-weight: bold;
      background: #eef2fa;
    }
    .catatan-tim {
      margin-top: 8px;
      font-size: 9.5pt;
      font-family: Arial, sans-serif;
      color: #444;
      font-style: italic;
      line-height: 1.45;
    }

    /* ================= FOOTER & VALIDASI ================= */
    .footer {
      margin-top: 36px;
      font-size: 8pt;
      text-align: left;
      font-family: Arial, sans-serif;
      color: #666;
      border-top: 1px dashed #ccc;
      padding-top: 10px;
      line-height: 1.5;
    }
    .kode-validasi-print {
      position: absolute;
      bottom: 1.2cm;
      right: 1.6cm;
      font-size: 8pt;
      color: #555;
      font-family: Arial, sans-serif;
      letter-spacing: .3px;
    }

    /* ================= TOMBOL (tidak ikut cetak) ================= */
    .bar-aksi {
      max-width: 21cm;
      margin: 16px auto 0;
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
    .bar-aksi button,
    .bar-aksi a {
      font-family: Arial, sans-serif;
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 30px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      background: #1e3a8a;
      color: #fff;
      box-shadow: 0 4px 10px rgba(30, 58, 138, 0.25);
    }
    .bar-aksi a.secondary { background: #64748b; }

    /* ================= PRINT ================= */
    @media print {
      body { background: #fff; }
      .bar-aksi { display: none; }

      .lembar {
        box-shadow: none;
        margin: 0;
        max-width: none;
        min-height: 0;
        padding: 0;
        page-break-after: always;
        border-radius: 0;
      }
      .lembar:last-child { page-break-after: auto; }

      .img-ttd {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      table.tabel-lampiran th {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .kode-validasi-print {
        position: fixed;
        bottom: 0.6cm;
        right: 1cm;
      }
    }
  </style>
</head>
<body>

<div class="bar-aksi">
  <a href="javascript:history.back()" class="secondary">&larr; Kembali</a>
  <button onclick="window.print()">🖨️ Cetak / Simpan PDF</button>
</div>

<!-- ================= HALAMAN 1 : BADAN SK ================= -->
<div class="lembar">

  <div class="kop-surat">
    <img src="/images/logo.png" alt="Logo Politeknik Dewantara" class="logo-kop">
    <div class="teks-kop">
      <h2 class="nama-kampus">POLITEKNIK DEWANTARA</h2>
      <p class="alamat">Jl. KH. Ahmad Razak 2 No. 7, Kota Palopo, Sulawesi Selatan</p>
      <p class="kontak">E-mail: elektronika@polidewa.ac.id &nbsp;|&nbsp; Website: elektronika.polidewa.ac.id</p>
    </div>
  </div>

  <div class="judul-sk">
    <p class="label-keputusan">SURAT KEPUTUSAN</p>
    <p class="nomor">Nomor: <%= nomorSurat %></p>
    <p class="tentang">TENTANG</p>
    <p class="judul-utama">
      PENETAPAN DOSEN PENGAMPU MATA KULIAH<br>
      SEMESTER <%= semester.toUpperCase() %> TAHUN AKADEMIK <%= tahunAkademik %>
    </p>
    <p class="kaprodi-line"><%= kaprodi.jabatan %> Politeknik Dewantara</p>
  </div>

  <div class="blok-diktum">

    <!-- ===== MENIMBANG ===== -->
    <div class="baris-item">
      <span class="label-item">Menimbang</span>
      <span class="titik-item">:</span>
      <div class="isi-item">
        <div class="diktum-item">
          <span class="marker">a.</span>
          <span class="teks">bahwa dalam rangka pelaksanaan tugas pendidikan dan pembelajaran semester <%= semester.toLowerCase() %> Tahun Akademik <%= tahunAkademik %> pada Program Studi Teknik Elektronika Politeknik Dewantara, dipandang perlu menetapkan dosen pengampu mata kuliah;</span>
        </div>
        <div class="diktum-item">
          <span class="marker">b.</span>
          <span class="teks">bahwa sehubungan dengan poin a perlu adanya penetapan keputusannya.</span>
        </div>
      </div>
    </div>

    <!-- ===== MENGINGAT ===== -->
    <div class="baris-item">
      <span class="label-item">Mengingat</span>
      <span class="titik-item">:</span>
      <div class="isi-item">
        <div class="diktum-item">
          <span class="marker">1.</span>
          <span class="teks">Undang-Undang Nomor 20 Tahun 2023 tentang Sistem Pendidikan Nasional;</span>
        </div>
        <div class="diktum-item">
          <span class="marker">2.</span>
          <span class="teks">Undang-Undang Nomor 12 Tahun 2012 tentang Pendidikan Tinggi;</span>
        </div>
        <div class="diktum-item">
          <span class="marker">3.</span>
          <span class="teks">Peraturan Menteri Pendidikan dan Kebudayaan Nomor 3 Tahun 2020 tentang Standar Nasional Pendidikan Tinggi;</span>
        </div>
        <div class="diktum-item">
          <span class="marker">4.</span>
          <span class="teks">Peraturan Menteri Pendidikan, Kebudayaan, Riset, dan Teknologi Nomor 53 Tahun 2023 tentang Penjaminan Mutu Pendidikan Tinggi;</span>
        </div>
        <div class="diktum-item">
          <span class="marker">5.</span>
          <span class="teks">Statuta Politeknik Dewantara Nomor 1 Tahun 2021;</span>
        </div>
        <div class="diktum-item">
          <span class="marker">6.</span>
          <span class="teks">Keputusan Direktur Politeknik Dewantara Nomor 2 Tahun 2024 tentang Peraturan Akademik;</span>
        </div>
        <div class="diktum-item">
          <span class="marker">7.</span>
          <span class="teks">Hasil rapat prodi pada tanggal <%= tanggalRapatTampil %>.</span>
        </div>
      </div>
    </div>

  </div>

  <p class="memutuskan">MEMUTUSKAN</p>

  <div class="blok-diktum">
    <div class="baris-item">
      <span class="label-item">Menetapkan</span><span class="titik-item">:</span><span class="isi-item"></span>
    </div>
    <div class="baris-item">
      <span class="label-item">Pertama</span><span class="titik-item">:</span>
      <span class="isi-item">Mengangkat Saudara/i <strong><%= namaDosen %></strong> sebagai dosen pengampu mata kuliah sebagaimana tercantum pada lampiran keputusan ini.</span>
    </div>
    <div class="baris-item">
      <span class="label-item">Kedua</span><span class="titik-item">:</span>
      <span class="isi-item">Kepada Saudara/i yang diberi tugas dan tanggung jawab: (1) melaksanakan tugas mengajar; (2) melakukan evaluasi proses dan hasil pembelajaran; (3) menyusun rencana pembelajaran semester; (4) mengembangkan model pembelajaran sesuai dengan mata kuliah yang diampu; dan (5) mengumpulkan nilai sesuai dengan jadwal yang telah ditetapkan pada kalender akademik.</span>
    </div>
    <div class="baris-item">
      <span class="label-item">Ketiga</span><span class="titik-item">:</span>
      <span class="isi-item">Melaksanakan pembelajaran dengan ketentuan 1 sks dalam bentuk pembelajaran kuliah/responsi/tutorial dan 2 sks dalam bentuk praktik. Mata kuliah yang diampu bersama dosen lain (tim teaching) dilaksanakan dengan beban SKS dibagi rata sesuai jumlah dosen pengampu.</span>
    </div>
    <div class="baris-item">
      <span class="label-item">Keempat</span><span class="titik-item">:</span>
      <span class="isi-item">Keputusan ini berlaku sejak tanggal ditetapkan dan apabila terdapat kekeliruan di dalam keputusan ini akan diadakan perbaikan sebagaimana mestinya.</span>
    </div>
  </div>

  <div class="tanda-tangan-wrapper">
    <div class="tanda-tangan">
      <p class="info-ttd">
        Ditetapkan&nbsp; : di <%= kota %><br>
        Pada tanggal : <%= tanggalTampil %><br>
        <%= kaprodi.jabatan %>,
      </p>
      <div class="area-ttd">
        <img src="/images/ttd.png" alt="Tanda Tangan Kaprodi" class="img-ttd">
      </div>
      <p class="nama-ttd"><%= kaprodi.nama %></p>
      <p class="nip-ttd">NUPTK. <%= kaprodi.nuptk %></p>
    </div>
  </div>

  <div class="tembusan">
    <p>Tembusan:</p>
    <ol>
      <li>Direktur;</li>
      <li>Wakil Direktur; dan</li>
      <li>Yang bersangkutan.</li>
    </ol>
  </div>

  <div class="footer">
    <p>Dokumen ini dicetak dan disahkan secara digital oleh Sistem Informasi Elektronika Polidewa.<br>
    Periksa keaslian dokumen di: <em>https://elektronika.polidewa.ac.id</em></p>
  </div>
  <div class="kode-validasi-print">Kode Validasi: <strong><%= kodeValidasi %></strong></div>
</div>

<!-- ================= HALAMAN 2 : LAMPIRAN ================= -->
<div class="lembar">

  <!-- ===== KOP LAMPIRAN (label sejajar) ===== -->
  <div class="kop-lampiran">
    <div class="baris-lampiran">
      <span class="label-lampiran">Lampiran</span>
      <span class="titik-lampiran">:</span>
      <span class="isi-lampiran">Surat Keputusan Nomor <%= nomorSurat %> tentang Penetapan Dosen Pengampu Mata Kuliah Semester <%= semester %> Tahun Akademik <%= tahunAkademik %>.</span>
    </div>
    <div class="baris-lampiran">
      <span class="label-lampiran">Tanggal</span>
      <span class="titik-lampiran">:</span>
      <span class="isi-lampiran"><%= tanggalTampil %></span>
    </div>
    <hr class="garis">
  </div>

  <!-- ===== JUDUL LAMPIRAN ===== -->
  <p class="judul-lampiran">DAFTAR MATA KULIAH YANG DIAMPU</p>

  <!-- ===== DATA DOSEN ===== -->
  <div class="data-dosen">
    <p class="nama-dosen"><%= namaDosen %></p>
    <% if (nipDosen && nipDosen !== '-') { %>
      <p class="nip-dosen">NIDN/NUPTK <%= nipDosen %></p>
    <% } %>
    <p class="periode">Semester <%= semester %> Tahun Akademik <%= tahunAkademik %></p>
  </div>

  <!-- ===== TABEL MATA KULIAH ===== -->
  <table class="tabel-lampiran">
    <thead>
      <tr>
        <th style="width:44px;">No.</th>
        <th>Mata Kuliah</th>
        <th style="width:110px;">Jumlah SKS</th>
        <th style="width:110px;">Kelas</th>
      </tr>
    </thead>
    <tbody>
      <% let totalSks = 0; let adaTimTeaching = false; %>
      <% daftarMk.forEach((mk, i) => {
           const sksBersih = Math.round((Number(mk.sks) || 0) * 100) / 100;
           totalSks += sksBersih;
           if (mk.timTeaching) adaTimTeaching = true;
      %>
      <tr>
        <td class="no"><%= i + 1 %></td>
        <td><%= mk.nama %><% if (mk.timTeaching) { %> <sup>*</sup><% } %></td>
        <td class="sks"><%= Number.isInteger(sksBersih) ? sksBersih : sksBersih.toFixed(2).replace(/0$/, '') %></td>
        <td><%= mk.kelas %></td>
      </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="2" style="text-align:right;">Total SKS</td>
        <td class="sks"><%= Math.round(totalSks * 100) / 100 %></td>
        <td></td>
      </tr>
    </tfoot>
  </table>

  <% if (adaTimTeaching) { %>
    <p class="catatan-tim">* Mata kuliah diampu bersama dosen lain (tim teaching) &mdash; jumlah SKS pada tabel ini adalah bagian dosen yang bersangkutan setelah dibagi rata sesuai jumlah pengampu.</p>
  <% } %>

  <!-- ===== TANDA TANGAN ===== -->
  <div class="tanda-tangan-wrapper">
    <div class="tanda-tangan">
      <p class="info-ttd">
        Ditetapkan&nbsp; : di <%= kota %><br>
        Pada tanggal : <%= tanggalTampil %><br>
        <%= kaprodi.jabatan %>,
      </p>
      <div class="area-ttd">
        <img src="/images/ttd.png" alt="Tanda Tangan Kaprodi" class="img-ttd">
      </div>
      <p class="nama-ttd"><%= kaprodi.nama %></p>
      <p class="nip-ttd">NUPTK. <%= kaprodi.nuptk %></p>
    </div>
  </div>

  <div class="footer">
    <p>Dokumen ini dicetak dan disahkan secara digital oleh Sistem Informasi Elektronika Polidewa.<br>
    Periksa keaslian dokumen di: <em>https://elektronika.polidewa.ac.id</em></p>
  </div>
  <div class="kode-validasi-print">Kode Validasi: <strong><%= kodeValidasi %></strong></div>
</div>

</body>
</html>