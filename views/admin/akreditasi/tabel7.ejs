<%- include('../../partials/header') %>
<div class="container mt-4 mb-5">
  <a href="/admin/akreditasi/tabel?periodeId=<%= periodeId %>" class="btn btn-sm btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Kembali ke Daftar Tabel
  </a>

  <h3><%= config.judul %></h3>
  <p class="text-muted"><%= config.deskripsi %></p>

  <form method="POST" action="/admin/akreditasi/tabel/tabel7">
    <input type="hidden" name="periodeId" value="<%= periodeId %>">
    <div class="table-responsive">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th>Tahun Masuk</th>
            <% config.kolom.forEach(k => { %><th><%= k.label %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% config.baris.forEach(namaBaris => {
            const data = dataPerBaris[namaBaris] || {};
          %>
            <tr>
              <td class="fw-bold"><%= namaBaris %></td>
              <% config.kolom.forEach(k => { %>
                <td>
                  <input type="number" step="any" class="form-control form-control-sm"
                         name="<%= namaBaris %>[<%= k.key %>]"
                         value="<%= (data[k.key] === null || data[k.key] === undefined) ? '' : data[k.key] %>">
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
  </form>
</div>
<%- include('../../partials/footer') %>
