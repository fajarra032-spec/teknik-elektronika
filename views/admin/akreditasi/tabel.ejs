<%- include('../../partials/header') %>
<div class="container mt-4 mb-5">
  <a href="/admin/akreditasi/tabel?periodeId=<%= periodeId %>" class="btn btn-sm btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Kembali ke Daftar Tabel
  </a>

  <h3><%= config.judul %></h3>
  <p class="text-muted"><%= config.deskripsi %></p>

  <!-- ============== FORM TAMBAH / EDIT BARIS ============== -->
  <div class="card mb-4">
    <div class="card-header"><%= editRow ? 'Edit Baris' : 'Tambah Baris Baru' %></div>
    <div class="card-body">
      <form method="POST"
            action="<%= editRow ? `/admin/akreditasi/tabel/${config.key}/${editRow.id}/edit` : `/admin/akreditasi/tabel/${config.key}` %>">
        <input type="hidden" name="periodeId" value="<%= periodeId %>">
        <div class="row g-3">
          <% config.kolom.forEach(k => { %>
            <div class="col-md-<%= k.lebar ? 12 : (k.type === 'textarea' ? 12 : 4) %>">
              <label class="form-label small fw-bold"><%= k.label %></label>
              <% const val = editRow ? editRow[k.key] : ''; %>
              <% if (k.type === 'select') { %>
                <select name="<%= k.key %>" class="form-select form-select-sm">
                  <% k.options.forEach(opt => { %>
                    <option value="<%= opt %>" <%= val === opt ? 'selected' : '' %>><%= opt || '(kosong)' %></option>
                  <% }) %>
                </select>
              <% } else if (k.type === 'textarea') { %>
                <textarea name="<%= k.key %>" class="form-control form-control-sm" rows="2"><%= val || '' %></textarea>
              <% } else if (k.type === 'checkbox') { %>
                <div class="form-check mt-2">
                  <input type="checkbox" name="<%= k.key %>" class="form-check-input" <%= val ? 'checked' : '' %>>
                </div>
              <% } else if (k.type === 'number') { %>
                <input type="number" step="any" name="<%= k.key %>" class="form-control form-control-sm" value="<%= (val === null || val === undefined) ? '' : val %>">
              <% } else { %>
                <input type="text" name="<%= k.key %>" class="form-control form-control-sm" value="<%= val || '' %>">
              <% } %>
            </div>
          <% }) %>
        </div>
        <div class="mt-3">
          <button type="submit" class="btn btn-primary btn-sm">
            <%= editRow ? 'Simpan Perubahan' : 'Tambah Baris' %>
          </button>
          <% if (editRow) { %>
            <a href="/admin/akreditasi/tabel/<%= config.key %>?periodeId=<%= periodeId %>" class="btn btn-sm btn-secondary">Batal</a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- ============== DAFTAR BARIS ============== -->
  <div class="table-responsive">
    <table class="table table-bordered table-sm align-middle">
      <thead class="table-light">
        <tr>
          <th style="width:40px;">No</th>
          <% config.kolom.forEach(k => { %><th><%= k.label %></th><% }) %>
          <th style="width:140px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!baris.length) { %>
          <tr><td colspan="<%= config.kolom.length + 2 %>" class="text-center text-muted">Belum ada data</td></tr>
        <% } else { %>
          <% baris.forEach((b, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <% config.kolom.forEach(k => { %>
                <td>
                  <% if (k.type === 'checkbox') { %>
                    <%= b[k.key] ? '\u2713' : '-' %>
                  <% } else { %>
                    <%= (b[k.key] === null || b[k.key] === undefined || b[k.key] === '') ? '-' : b[k.key] %>
                  <% } %>
                </td>
              <% }) %>
              <td class="d-flex gap-1">
                <a href="/admin/akreditasi/tabel/<%= config.key %>?periodeId=<%= periodeId %>&editId=<%= b.id %>" class="btn btn-sm btn-warning">Edit</a>
                <form method="POST" action="/admin/akreditasi/tabel/<%= config.key %>/<%= b.id %>/delete" onsubmit="return confirm('Hapus baris ini?');">
                  <input type="hidden" name="periodeId" value="<%= periodeId %>">
                  <button class="btn btn-sm btn-danger">Hapus</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../../partials/footer') %>
