<%- include('../../partials/header') %>
<div class="container mt-4 mb-5">
  <a href="<%= backUrl %>" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Kembali ke Daftar Kriteria</a>

  <div class="card mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <h4 class="card-title mb-1">Kriteria <%= kriteria.kode %>: <%= kriteria.nama %></h4>
          <% if (kriteria.deskripsi) { %><p class="text-muted mb-1"><%= kriteria.deskripsi %></p><% } %>
          <% if (kriteria.targetTanggal) { %>
            <span class="small <%= kriteria.terlambat ? 'text-danger fw-bold' : 'text-muted' %>">
              <i class="bi bi-calendar-event me-1"></i>Target selesai: <%= kriteria.targetTanggal %>
              <% if (kriteria.terlambat) { %> — <i class="bi bi-exclamation-triangle-fill"></i> Sudah lewat tenggat<% } %>
            </span>
          <% } %>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-6">
          <form method="POST" action="/admin/akreditasi/kriteria/<%= kriteria.id %>/status" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0 fw-bold">Status:</label>
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width:auto;">
              <option value="belum" <%= kriteria.status === 'belum' ? 'selected' : '' %>>Belum Dimulai</option>
              <option value="proses" <%= kriteria.status === 'proses' ? 'selected' : '' %>>Sedang Diproses</option>
              <option value="selesai" <%= kriteria.status === 'selesai' ? 'selected' : '' %>>Selesai</option>
            </select>
          </form>
        </div>
        <div class="col-md-6">
          <form method="POST" action="/admin/akreditasi/kriteria/<%= kriteria.id %>/pic">
            <label class="form-label fw-bold">Dosen Penanggung Jawab (PIC):</label>
            <div class="d-flex gap-2">
              <select name="picDosenIds" class="form-select form-select-sm" multiple style="min-height: 80px;">
                <% dosenList.forEach(d => { %>
                  <option value="<%= d.id %>" <%= (kriteria.picDosenIds || []).includes(d.id) ? 'selected' : '' %>><%= d.nama %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn btn-sm btn-outline-primary align-self-start">Simpan</button>
            </div>
            <div class="form-text">Tahan Ctrl/Cmd untuk memilih lebih dari satu dosen.</div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ============== INDIKATOR LKPS (instrumen resmi LAM Teknik) ============== -->
  <div class="card mb-4" id="indikator">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-journal-check me-1"></i> Indikator LKPS</span>
      <% if (indikatorList.length) {
        const terisi = indikatorList.filter(it => it.status === 'terisi').length;
      %>
        <span class="badge bg-info text-dark"><%= terisi %> / <%= indikatorList.length %> terisi</span>
      <% } %>
    </div>
    <div class="card-body">
      <% if (!indikatorList.length) { %>
        <p class="text-muted small mb-0">Belum ada indikator untuk kriteria ini.</p>
      <% } else { %>
        <div class="accordion" id="accordionIndikator">
          <% indikatorList.forEach((it, idx) => { %>
            <div class="accordion-item" id="indikator-<%= it.id %>">
              <h2 class="accordion-header">
                <button class="accordion-button <%= idx === 0 ? '' : 'collapsed' %>" type="button"
                        data-bs-toggle="collapse" data-bs-target="#collapse-<%= it.id %>">
                  <span class="badge bg-<%= it.status === 'terisi' ? 'success' : 'secondary' %> me-2"><%= it.kode %></span>
                  <%= it.nama %>
                  <% if (it.status === 'terisi') { %><i class="bi bi-check-circle-fill text-success ms-2"></i><% } %>
                </button>
              </h2>
              <div id="collapse-<%= it.id %>" class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>"
                   data-bs-parent="#accordionIndikator">
                <div class="accordion-body">
                  <% if (it.deskripsi) { %>
                    <p class="small"><strong>Indikator:</strong> <%= it.deskripsi %></p>
                  <% } %>
                  <% if (it.instruksi) { %>
                    <details class="small text-muted mb-2">
                      <summary style="cursor:pointer;">Instruksi Pengisian Deskripsi (klik untuk lihat)</summary>
                      <div style="white-space: pre-line;" class="mt-1"><%= it.instruksi %></div>
                    </details>
                  <% } %>
                  <% if (it.keterangan) { %>
                    <p class="small text-muted mb-3"><i class="bi bi-info-circle me-1"></i><%= it.keterangan %></p>
                  <% } %>

                  <form method="POST" action="/admin/akreditasi/indikator/<%= it.id %>/jawaban">
                    <div class="mb-2">
                      <label class="form-label fw-bold small">Uraian Deskripsi (jawaban/narasi)</label>
                      <textarea name="uraianJawaban" class="form-control" rows="6"
                                placeholder="Tulis narasi/uraian untuk indikator ini..."><%= it.uraianJawaban %></textarea>
                    </div>
                    <div class="mb-2">
                      <label class="form-label fw-bold small">Bukti Sahih (link Google Drive / dokumen pendukung)</label>
                      <input type="url" name="buktiSahihUrl" class="form-control form-control-sm"
                             placeholder="https://drive.google.com/..." value="<%= it.buktiSahihUrl %>">
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                      <% if (it.updatedBy) { %>
                        <span class="text-muted" style="font-size:0.75rem;">Terakhir diisi oleh <%= it.updatedBy %></span>
                      <% } else { %><span></span><% } %>
                      <button type="submit" class="btn btn-sm btn-primary">Simpan Jawaban</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="row">
    <!-- ============== CHECKLIST PROSES ============== -->
    <div class="col-lg-4 mb-4" id="checklist">
      <div class="card h-100">
        <div class="card-header"><i class="bi bi-check2-square me-1"></i> Checklist Proses</div>
        <div class="card-body">
          <% const chkTotal = checklistList.length; const chkSelesai = checklistList.filter(c => c.selesai).length; %>
          <% if (chkTotal) { %>
            <div class="progress mb-3" style="height: 18px;">
              <div class="progress-bar bg-info" style="width: <%= Math.round((chkSelesai/chkTotal)*100) %>%;">
                <%= chkSelesai %>/<%= chkTotal %>
              </div>
            </div>
          <% } %>
          <ul class="list-group list-group-flush mb-3">
            <% checklistList.forEach(c => { %>
              <li class="list-group-item px-0 d-flex justify-content-between align-items-start gap-2">
                <form method="POST" action="/admin/akreditasi/checklist/<%= c.id %>/toggle" class="d-flex gap-2 align-items-start flex-grow-1">
                  <input type="checkbox" class="form-check-input mt-1" onchange="this.form.submit()" <%= c.selesai ? 'checked' : '' %>>
                  <button type="submit" class="btn btn-link btn-sm p-0 text-start <%= c.selesai ? 'text-decoration-line-through text-muted' : '' %>" style="border:none;background:none;">
                    <%= c.item %>
                  </button>
                </form>
                <form method="POST" action="/admin/akreditasi/checklist/<%= c.id %>/delete" onsubmit="return confirm('Hapus item checklist ini?');">
                  <button class="btn btn-sm btn-outline-danger py-0 px-1"><i class="bi bi-x"></i></button>
                </form>
              </li>
            <% }) %>
          </ul>
          <form method="POST" action="/admin/akreditasi/kriteria/<%= kriteria.id %>/checklist" class="d-flex gap-2">
            <input type="text" name="item" class="form-control form-control-sm" placeholder="Tambah item checklist...">
            <button type="submit" class="btn btn-sm btn-outline-primary">+</button>
          </form>
        </div>
      </div>
    </div>

    <!-- ============== DOKUMEN ============== -->
    <div class="col-lg-4 mb-4">
      <div class="card h-100">
        <div class="card-header"><i class="bi bi-folder2-open me-1"></i> Pengumpulan Dokumen</div>
        <div class="card-body">
          <form method="POST" action="/admin/akreditasi/kriteria/<%= kriteria.id %>/dokumen" enctype="multipart/form-data" class="mb-3">
            <div class="mb-2">
              <input type="text" name="judul" class="form-control form-control-sm" placeholder="Judul dokumen (contoh: Renstra Prodi 2026-2030)" required>
            </div>
            <div class="d-flex gap-2">
              <input type="file" name="file" class="form-control form-control-sm" required>
              <button type="submit" class="btn btn-sm btn-primary">Unggah</button>
            </div>
          </form>
          <hr>
          <% if (!dokumenList.length) { %>
            <p class="text-muted small mb-0">Belum ada dokumen diunggah untuk kriteria ini.</p>
          <% } else { %>
            <ul class="list-group list-group-flush">
              <% dokumenList.forEach(doc => { %>
                <li class="list-group-item px-0">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <a href="<%= doc.fileUrl %>" target="_blank"><%= doc.judul %></a>
                      <div class="text-muted small">
                        <%= doc.fileName %> &middot; oleh <%= doc.uploadedBy %> (<%= doc.uploadedByRole %>)
                      </div>
                    </div>
                    <form method="POST" action="/admin/akreditasi/dokumen/<%= doc.id %>/delete"
                          onsubmit="return confirm('Hapus dokumen ini?');">
                      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ============== DISKUSI / PEMBAHASAN ============== -->
    <div class="col-lg-4 mb-4" id="diskusi">
      <div class="card h-100">
        <div class="card-header"><i class="bi bi-chat-dots me-1"></i> Tempat Pembahasan</div>
        <div class="card-body d-flex flex-column" style="max-height: 480px;">
          <div class="flex-grow-1 overflow-auto mb-3" style="max-height: 340px;">
            <% if (!diskusiList.length) { %>
              <p class="text-muted small">Belum ada pembahasan. Mulai diskusi di bawah ini.</p>
            <% } else { %>
              <% diskusiList.forEach(d => { %>
                <div class="mb-2 p-2 rounded <%= d.role === 'admin' ? 'bg-light' : 'bg-white border' %>">
                  <div class="small fw-bold">
                    <%= d.userNama %>
                    <span class="badge bg-secondary bg-opacity-50 text-dark"><%= d.role %></span>
                  </div>
                  <div><%= d.pesan %></div>
                  <div class="text-muted" style="font-size: 0.75rem;">
                    <%= new Date(d.createdAt).toLocaleString('id-ID') %>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
          <form method="POST" action="/admin/akreditasi/kriteria/<%= kriteria.id %>/diskusi" class="mt-auto d-flex gap-2">
            <input type="text" name="pesan" class="form-control" placeholder="Tulis pembahasan / catatan..." required>
            <button type="submit" class="btn btn-primary">Kirim</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>
