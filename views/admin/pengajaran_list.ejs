<%- include('../partials/header') %>

<%
  var mkList = typeof mkList !== 'undefined' ? mkList : [];
  var semesterList = typeof semesterList !== 'undefined' ? semesterList : [];
  var selectedSemester = typeof selectedSemester !== 'undefined' ? selectedSemester : '';
  var ringkasPantau = typeof ringkasPantau !== 'undefined' ? ringkasPantau : null;
  var semesterAktifInfo = typeof semesterAktifInfo !== 'undefined' ? semesterAktifInfo : null;
  const status = (mk) => mk.persentase >= 100 ? 'done' : (mk.persentase > 0 ? 'run' : 'none');
  const nDone = mkList.filter(m => status(m) === 'done').length;
  const nRun = mkList.filter(m => status(m) === 'run').length;
  const nNone = mkList.length - nDone - nRun;
  const nWarn = mkList.filter(m => m.pantau && m.pantau.perluPerhatian).length;
  const rata = mkList.length ? Math.round(mkList.reduce((n, m) => n + (m.persentase || 0), 0) / mkList.length) : 0;
  const qsExport = selectedSemester ? '?semester=' + encodeURIComponent(selectedSemester) : '';
  const daftarAktif = semesterAktifInfo && semesterAktifInfo.daftar.length ? ' (semester ' + semesterAktifInfo.daftar.join(', ') + ')' : '';
  const labelFilter = selectedSemester === 'aktif'
    ? ' (semester aktif ' + (semesterAktifInfo ? semesterAktifInfo.label : '') + ')'
    : ((!selectedSemester || selectedSemester === 'semua') ? ' (semua semester)' : ' (Semester ' + selectedSemester + ')');
%>

<style>
  .ea {
    --ea-ink: #1b2a4a;
    --ea-muted: #5d6b85;
    --ea-line: #e2e7ef;
    --ea-surface: #ffffff;
    --ea-accent: #1e3a8a;
    --ea-accent-soft: #e8eefc;
    --ea-hover: #f6f8fd;
    color: var(--ea-ink);
    font-feature-settings: "tnum" 1;
  }
  .ea a { text-decoration: none; }
  .ea :focus-visible { outline: 2px solid var(--ea-accent); outline-offset: 2px; border-radius: 6px; }

  /* Judul halaman */
  .ea-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; justify-content: space-between; margin-bottom: 1.25rem; }
  .ea-head h1 { font-size: 1.65rem; font-weight: 700; letter-spacing: -0.015em; margin: 0 0 0.25rem; }
  .ea-head p { margin: 0; color: var(--ea-muted); font-size: 0.95rem; }

  .ea-btn { display: inline-flex; align-items: center; gap: 0.4rem; border: 1px solid transparent; border-radius: 8px; padding: 0.45rem 0.9rem; font-size: 0.875rem; font-weight: 600; line-height: 1.3; cursor: pointer; background: none; transition: background-color .15s, border-color .15s, color .15s; }
  .ea-btn-primary { background: var(--ea-accent); color: #fff; }
  .ea-btn-primary:hover { background: #172f73; color: #fff; }
  .ea-btn-edit { border-color: var(--ea-line); color: var(--ea-ink); padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #fff; }
  .ea-btn-edit:hover { background: var(--ea-hover); color: var(--ea-accent); }
  .ea-btn-set { background: var(--ea-accent); color: #fff; padding: 0.3rem 0.7rem; font-size: 0.8rem; }
  .ea-btn-set:hover { background: #172f73; color: #fff; }
  .ea-btn-icon { border-color: var(--ea-line); color: var(--ea-muted); padding: 0.3rem 0.55rem; background: #fff; }
  .ea-btn-icon:hover { background: var(--ea-hover); color: var(--ea-ink); }

  /* Info & peringatan */
  .ea-info { background: var(--ea-accent-soft); border: 1px solid #cfdaf7; border-left: 4px solid var(--ea-accent); border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1rem; color: var(--ea-ink); font-size: 0.92rem; line-height: 1.5; }
  .ea-info a { color: var(--ea-accent); font-weight: 600; border-bottom: 1px solid currentColor; }
  .ea-queue { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; background: #fff8e8; border: 1px solid #f0dcaa; border-left: 4px solid #d99a14; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; }
  .ea-queue strong { font-weight: 700; }
  .ea-queue span { color: #6f5200; font-size: 0.95rem; }
  .ea-queue button { border: 0; background: none; padding: 0; color: #6f5200; font-weight: 600; font-size: 0.9rem; border-bottom: 1px solid currentColor; }

  /* Toolbar */
  .ea-toolbar { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; }
  .ea-search { position: relative; flex: 1 1 260px; max-width: 420px; }
  .ea-search i { position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%); color: var(--ea-muted); pointer-events: none; }
  .ea-search input { width: 100%; border: 1px solid var(--ea-line); border-radius: 8px; padding: 0.5rem 0.8rem 0.5rem 2.2rem; font-size: 0.9rem; background: #fff; color: var(--ea-ink); }
  .ea-search input:focus { outline: 2px solid var(--ea-accent); outline-offset: 0; border-color: transparent; }
  .ea-seg { display: inline-flex; background: #eef1f6; border-radius: 9px; padding: 3px; gap: 2px; overflow-x: auto; max-width: 100%; }
  .ea-seg button { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.75rem; border: 0; background: none; border-radius: 7px; color: var(--ea-muted); font-size: 0.85rem; font-weight: 600; white-space: nowrap; }
  .ea-seg button:hover { color: var(--ea-ink); }
  .ea-seg button.is-active { background: #fff; color: var(--ea-ink); box-shadow: 0 1px 2px rgba(27, 42, 74, 0.12); }
  .ea-seg small { font-weight: 600; opacity: 0.75; }

  /* Daftar */
  .ea-list { background: var(--ea-surface); border: 1px solid var(--ea-line); border-radius: 12px; overflow: hidden; }
  .ea-cols, .ea-row { display: grid; grid-template-columns: minmax(0, 1fr) 130px minmax(0, 1fr) 170px; column-gap: 1rem; align-items: center; }
  .ea-cols { padding: 0.6rem 1rem 0.6rem 1.15rem; background: #fafbfd; border-bottom: 1px solid var(--ea-line); color: var(--ea-muted); font-size: 0.8rem; font-weight: 600; }
  .ea-cols > :last-child { text-align: right; }
  .ea-row { position: relative; padding: 0.85rem 1rem 0.85rem 1.15rem; border-bottom: 1px solid var(--ea-line); --c: #1d7a46; }
  .ea-row:last-of-type { border-bottom: 0; }
  .ea-row:hover { background: var(--ea-hover); }
  .ea-row::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c); }
  .ea-row.belum { --c: #d99a14; }

  .ea-title { display: block; color: var(--ea-ink); font-weight: 600; font-size: 0.95rem; line-height: 1.4; overflow-wrap: anywhere; }
  .ea-meta { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; margin-top: 0.2rem; font-size: 0.8rem; color: var(--ea-muted); }
  .ea-meta span { display: inline-flex; align-items: center; gap: 0.3rem; }

  .ea-pill { display: inline-block; border-radius: 999px; padding: 0.15rem 0.65rem; font-size: 0.78rem; font-weight: 600; }
  .s-ok { background: #dff3e7; color: #1d6b3f; }
  .s-belum { background: #fdf0d5; color: #8a5a00; }
  .ea-pa { font-size: 0.9rem; color: var(--ea-ink); overflow-wrap: anywhere; }
  .ea-pa.kosong { color: var(--ea-muted); font-style: italic; }
  .ea-actions { display: flex; gap: 0.4rem; align-items: center; justify-content: flex-end; }

  .ea-empty { padding: 3rem 1.5rem; text-align: center; color: var(--ea-muted); }
  .ea-empty i { font-size: 2rem; display: block; margin-bottom: 0.5rem; color: #b6bfce; }
  .ea-empty strong { display: block; color: var(--ea-ink); margin-bottom: 0.25rem; }
  .ea-more { text-align: center; padding: 0.9rem; border-top: 1px solid var(--ea-line); }
  .ea-foot { color: var(--ea-muted); font-size: 0.8rem; margin: 0.6rem 0.25rem 0; }
  [hidden] { display: none !important; }

  /* Ponsel: satu kolom, status di bawah nama */
  @media (max-width: 767.98px) {
    .ea-cols { display: none; }
    .ea-row { grid-template-columns: minmax(0, 1fr) auto; row-gap: 0.55rem; }
    .ea-main { grid-column: 1 / -1; }
    .ea-row > .ea-pa { grid-column: 1; }
    .ea-row > .ea-state { grid-column: 2; grid-row: 2; text-align: right; }
    .ea-actions { grid-column: 1 / -1; justify-content: flex-start; }
    .ea-head h1 { font-size: 1.4rem; }
  }

  /* ===== Bersama: halaman Informasi Pengajaran ===== */
  .ea-filters { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin-bottom: .9rem; }
  .ea-filters .ea-search { flex: 1 1 240px; max-width: 360px; }
  .ea-filters select { border: 1px solid var(--ea-line); border-radius: 8px; padding: .5rem .8rem; font-size: .88rem; background: #fff; color: var(--ea-ink); max-width: 230px; }
  .ea-filters select:focus { outline: 2px solid var(--ea-accent); outline-offset: 0; border-color: transparent; }
  .ea-reset { color: var(--ea-muted); font-size: .88rem; font-weight: 600; padding: .45rem .6rem; border-radius: 8px; }
  .ea-reset:hover { background: var(--ea-hover); color: var(--ea-ink); }
  .ea-count { color: var(--ea-muted); font-size: .85rem; margin: 0 .25rem .6rem; }
  .ea-row { cursor: default; --c: #9aa5b8; }
  .ea-row.done { --c: #1d7a46; } .ea-row.run { --c: #2f6fed; } .ea-row.none { --c: #9aa5b8; }
  .ea-cols > :last-child { text-align: right; }
  .ea-title { display: inline; font-weight: 600; font-size: .94rem; line-height: 1.4; color: var(--ea-ink); overflow-wrap: anywhere; }
  a.ea-title:hover { color: var(--ea-accent); text-decoration: underline; text-underline-offset: 3px; }
  .ea-kode { display: inline-block; background: var(--ea-accent-soft); color: var(--ea-accent); border-radius: 6px; padding: .05rem .5rem; font-size: .76rem; font-weight: 700; letter-spacing: .02em; margin-right: .4rem; vertical-align: 1px; }
  .ea-meta { font-size: .8rem; color: var(--ea-muted); margin-top: .2rem; overflow-wrap: anywhere; }
  .ea-num { font-size: .88rem; line-height: 1.5; } .ea-num small { color: var(--ea-muted); display: block; font-size: .78rem; }
  .ea-prog { display: flex; align-items: center; gap: .6rem; }
  .ea-prog .txt { font-size: .8rem; color: var(--ea-muted); white-space: nowrap; min-width: 46px; }
  .ea-track { flex: 1; height: 8px; border-radius: 999px; background: #e6ebf3; overflow: hidden; min-width: 70px; }
  .ea-fill { height: 100%; border-radius: 999px; background: #2f6fed; }
  .ea-fill.done { background: #1d7a46; } .ea-fill.none { background: #9aa5b8; }
  .ea-prog b { font-size: .82rem; min-width: 38px; text-align: right; }
  .ea-pill { display: inline-block; border-radius: 999px; padding: .12rem .6rem; font-size: .75rem; font-weight: 600; background: #eef1f6; color: var(--ea-muted); white-space: nowrap; }
  .p-done { background: #dff3e7; color: #1d6b3f; } .p-run { background: var(--ea-accent-soft); color: var(--ea-accent); } .p-warn { background: #fdf0d5; color: #8a5a00; }
  .ea-actions { display: flex; gap: .4rem; align-items: center; justify-content: flex-end; }
  .ea-panel2 { background: var(--ea-surface); border: 1px solid var(--ea-line); border-radius: 12px; padding: 1rem 1.15rem; }
  .ea-panel2 h2 { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--ea-muted); margin: 0 0 .7rem; }

  .ea-cols, .ea-row { grid-template-columns: minmax(0, 1.6fr) 110px minmax(0, 1fr) 110px; }
  @media (max-width: 991.98px) {
    .ea-cols { display: none; }
    .ea-row { grid-template-columns: minmax(0, 1fr); row-gap: .45rem; }
    .ea-actions { justify-content: flex-start; }
  }
</style>


<div class="container-fluid container-xl ea py-4">

  <header class="ea-head">
    <div>
      <h1>Monitoring Pengajaran</h1>
      <p>Pantau progres perkuliahan dan pertemuan setiap mata kuliah.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/pengajaran/rekap/semester" class="ea-btn ea-btn-edit"><i class="bi bi-calendar2-range"></i> Rekap semester</a>
      <a href="/admin/pengajaran/rekap/dosen" class="ea-btn ea-btn-edit"><i class="bi bi-person-badge"></i> Rekap dosen</a>
      <button type="button" class="ea-btn ea-btn-edit" id="btnSinkron" title="Isi topik pertemuan yang masih kosong dari RPS"><i class="bi bi-arrow-repeat"></i> Isi topik dari RPS</button>
      <a href="/admin/pengajaran/export<%= qsExport %>" target="_blank" class="ea-btn ea-btn-primary"><i class="bi bi-printer"></i> Export / cetak</a>
    </div>
  </header>

  <div class="ea-info" role="note">
    Rata-rata progres <strong><%= rata %>%</strong> dari <strong><%= mkList.length %></strong> mata kuliah<%= labelFilter %>:
    <%= nDone %> selesai, <%= nRun %> berjalan, <%= nNone %> belum mulai. Progres dihitung dari 16 pertemuan standar.
    <% if (ringkasPantau) { %>
      <br>Pemantauan: <strong><%= ringkasPantau.perluPerhatian %></strong> mata kuliah perlu perhatian (pertemuan lewat tanggal belum ditandai selesai, atau selesai tanpa absensi),
      <strong><%= ringkasPantau.topikBelumLengkap %></strong> belum lengkap topiknya, <strong><%= ringkasPantau.tanpaDosen %></strong> belum punya dosen pengampu.
    <% } %>
  </div>

  <form method="GET" action="/admin/pengajaran" class="ea-filters">
    <div class="ea-search">
      <i class="bi bi-search"></i>
      <label for="eaCari" class="visually-hidden">Cari kode, nama, atau dosen</label>
      <input type="search" id="eaCari" placeholder="Cari kode, nama MK, atau dosen" autocomplete="off">
    </div>
    <select name="semester" aria-label="Semester" onchange="this.form.submit()">
      <option value="aktif" <%= selectedSemester === 'aktif' ? 'selected' : '' %>>Semester aktif<%= semesterAktifInfo ? ' - ' + semesterAktifInfo.label : '' %><%= daftarAktif %></option>
      <option value="semua" <%= selectedSemester === 'semua' ? 'selected' : '' %>>Semua semester</option>
      <% semesterList.forEach(s => { %><option value="<%= s %>" <%= String(s) === String(selectedSemester) ? 'selected' : '' %>>Semester <%= s %></option><% }) %>
    </select>
    <div class="ea-seg" role="group" aria-label="Status progres">
      <button type="button" class="is-active" data-s="">Semua <small><%= mkList.length %></small></button>
      <button type="button" data-s="run">Berjalan <small><%= nRun %></small></button>
      <button type="button" data-s="done">Selesai <small><%= nDone %></small></button>
      <button type="button" data-s="none">Belum mulai <small><%= nNone %></small></button>
      <button type="button" data-s="warn">Perlu perhatian <small><%= nWarn %></small></button>
    </div>
    <% if (selectedSemester && selectedSemester !== 'aktif') { %><a href="/admin/pengajaran" class="ea-reset"><i class="bi bi-x-lg"></i> Reset</a><% } %>
  </form>

  <div class="ea-count" id="eaInfo" aria-live="polite">Menampilkan <strong><%= mkList.length %></strong> mata kuliah</div>

  <section class="ea-list" aria-label="Progres mata kuliah">
    <% if (mkList.length === 0) { %>
      <div class="ea-empty"><i class="bi bi-inbox"></i><strong>Belum ada data</strong>Tidak ada mata kuliah yang ditemukan.</div>
    <% } else { %>
      <div class="ea-cols" aria-hidden="true"><div>Mata kuliah</div><div>SKS &amp; semester</div><div>Progres</div><div>Aksi</div></div>
      <div id="eaRows">
      <% mkList.forEach(mk => { const st = status(mk); %>
        <article class="ea-row <%= st %>" data-s="<%= st %>" data-w="<%= (mk.pantau && mk.pantau.perluPerhatian) ? '1' : '0' %>" data-q="<%= ((mk.kode || '') + ' ' + (mk.nama || '') + ' ' + (mk.dosen || '')).toLowerCase() %>">
          <div>
            <span class="ea-kode"><%= mk.kode %></span><a class="ea-title" href="/admin/pengajaran/<%= mk.id %>"><%= mk.nama %></a>
            <div class="ea-meta"><i class="bi bi-people"></i> <%= mk.dosen || 'Belum ada dosen pengampu' %></div>
            <% if (mk.pantau) { %>
              <% if (mk.pantau.rekomIni) { %>
                <div class="ea-meta" style="color:#1d4ed8"><span><i class="bi bi-lightbulb"></i> Pertemuan berikutnya #<%= mk.pantau.rekomIni.pertemuan %>: <%= mk.pantau.rekomIni.topik %><% if (mk.pantau.sumberRencana === 'usulan') { %> (draft)<% } %></span></div>
              <% } %>
              <div class="ea-meta" style="gap:.35rem">
                <% if (mk.pantau.adaRencana) { %><span class="ea-pill <%= mk.pantau.topikTerisi >= 16 ? 'p-done' : 'p-run' %>" title="Pertemuan yang topiknya sudah diisi">Topik <%= mk.pantau.topikTerisi %>/16</span><% } %>
                <% if (mk.pantau.terlambat > 0) { %><span class="ea-pill p-warn" title="Sudah lewat tanggal tapi belum ditandai selesai"><%= mk.pantau.terlambat %> terlambat ditandai</span><% } %>
                <% if (mk.pantau.selesaiTanpaAbsensi > 0) { %><span class="ea-pill p-warn" title="Ditandai selesai tapi absensi belum diambil"><%= mk.pantau.selesaiTanpaAbsensi %> selesai tanpa absensi</span><% } %>
              </div>
            <% } %>
          </div>
          <div class="ea-num"><%= mk.sks %> SKS<small>Semester <%= mk.semester || '-' %></small></div>
          <div class="ea-prog" title="<%= mk.terlaksana %> dari <%= mk.totalPertemuan %> pertemuan terlaksana">
            <span class="txt"><%= mk.terlaksana %>/<%= mk.totalPertemuan %></span>
            <div class="ea-track"><div class="ea-fill <%= st %>" style="width: <%= mk.persentase %>%"></div></div>
            <b><%= mk.persentase %>%</b>
          </div>
          <div class="ea-actions"><a href="/admin/pengajaran/<%= mk.id %>" class="ea-btn ea-btn-edit"><i class="bi bi-eye"></i> Detail</a></div>
        </article>
      <% }) %>
      </div>
      <div class="ea-empty" id="eaKosong" hidden><i class="bi bi-search"></i><strong>Tidak ada hasil</strong>Coba kata kunci atau filter lain.</div>
      <div class="ea-more" id="eaMore" hidden><button type="button" class="ea-btn ea-btn-icon" id="eaMoreBtn"></button></div>
    <% } %>
  </section>
</div>

<script>
  (function () {
    var STEP = 50;
    var rows = Array.prototype.slice.call(document.querySelectorAll('#eaRows .ea-row'));
    if (!rows.length) return;
    var cari = document.getElementById('eaCari'), kosong = document.getElementById('eaKosong');
    var more = document.getElementById('eaMore'), moreBtn = document.getElementById('eaMoreBtn'), info = document.getElementById('eaInfo');
    var segs = Array.prototype.slice.call(document.querySelectorAll('.ea-seg button'));
    var status = '', limit = STEP;
    function terapkan() {
      var kata = (cari.value || '').toLowerCase().trim().split(/\s+/).filter(Boolean);
      var cocok = rows.filter(function (r) {
        if (status === 'warn') { if (r.getAttribute('data-w') !== '1') return false; }
        else if (status && r.getAttribute('data-s') !== status) return false;
        var q = r.getAttribute('data-q');
        return kata.every(function (k) { return q.indexOf(k) !== -1; });
      });
      rows.forEach(function (r) { r.hidden = true; });
      cocok.slice(0, limit).forEach(function (r) { r.hidden = false; });
      kosong.hidden = cocok.length > 0;
      var sisa = cocok.length - limit;
      more.hidden = sisa <= 0;
      if (sisa > 0) moreBtn.textContent = 'Tampilkan ' + Math.min(STEP, sisa) + ' lagi (sisa ' + sisa + ')';
      info.innerHTML = (kata.length || status) ? 'Menampilkan <strong>' + cocok.length + '</strong> dari ' + rows.length + ' mata kuliah' : 'Menampilkan <strong>' + rows.length + '</strong> mata kuliah';
    }
    cari.addEventListener('input', function () { limit = STEP; terapkan(); });
    cari.closest('form').addEventListener('submit', function (e) { e.preventDefault(); });
    segs.forEach(function (b) { b.addEventListener('click', function () {
      status = b.getAttribute('data-s'); limit = STEP;
      segs.forEach(function (x) { x.classList.toggle('is-active', x === b); });
      terapkan();
    }); });
    if (moreBtn) moreBtn.addEventListener('click', function () { limit += STEP; terapkan(); });
    terapkan();
  })();

  // ---- Isi topik kosong semua MK dari RPS (cek dulu, baru simpan) ----
  (function () {
    var btn = document.getElementById('btnSinkron');
    if (!btn) return;
    function kirim(dryRun) {
      return fetch('/admin/pengajaran/sinkron-topik', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ dryRun: dryRun })
      }).then(function (r) { return r.json(); });
    }
    btn.addEventListener('click', function () {
      btn.disabled = true;
      kirim(true).then(function (h) {
        if (!h.ok) throw new Error(h.message || 'gagal');
        if (h.topikDiisi === 0) { alert('Semua topik sudah terisi. Tidak ada yang perlu disinkronkan.'); return null; }
        var msg = 'Akan mengisi ' + h.topikDiisi + ' topik kosong di ' + h.mkDiperbarui + ' mata kuliah dari RPS.\n' +
          'Topik yang sudah diisi tidak akan ditimpa.' +
          (h.mkDraftDilewati ? '\n' + h.mkDraftDilewati + ' mata kuliah draft dilewati.' : '') + '\n\nLanjutkan?';
        return confirm(msg) ? kirim(false) : null;
      }).then(function (h) {
        if (h && h.ok) { alert('Selesai. ' + h.topikDiisi + ' topik diisi di ' + h.mkDiperbarui + ' mata kuliah.'); location.reload(); }
      }).catch(function (e) { alert('Terjadi kesalahan: ' + e.message); })
        .then(function () { btn.disabled = false; });
    });
  })();
</script>

<%- include('../partials/footer') %>
