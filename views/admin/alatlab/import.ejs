<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<div class="container mt-4 mb-5" style="max-width: 860px;">
  <div class="lab-hero">
    <a href="/admin/alat-lab" class="btn btn-sm btn-outline-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Inventaris</a>
    <h2>Import alat dari Excel / CSV</h2>
    <p class="lab-sub">Daftarkan banyak alat sekaligus. Baris pertama harus berisi nama kolom. Foto dipasang setelahnya lewat tombol edit.</p>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <% if (hasil) { %>
    <div class="alert alert-<%= hasil.gagal.length ? 'warning' : 'success' %>">
      <strong><%= hasil.berhasil %></strong> alat berhasil ditambahkan,
      <strong><%= hasil.dilewati.length %></strong> dilewati (kode sudah ada),
      <strong><%= hasil.gagal.length %></strong> gagal.
      <% if (hasil.dilewati.length || hasil.gagal.length) { %>
        <details class="mt-2"><summary>Lihat detail</summary>
          <ul class="small mb-0 mt-1">
            <% hasil.dilewati.forEach(m => { %><li><%= m %></li><% }) %>
            <% hasil.gagal.forEach(m => { %><li class="text-danger"><%= m %></li><% }) %>
          </ul></details>
      <% } %>
    </div>
  <% } %>

  <div class="lab-panel mb-3"><div class="lab-panel-body">
    <div class="lab-sec"><i class="bi bi-table"></i> Format kolom</div>
    <div class="lab-table-wrap"><div class="table-responsive">
      <table class="lab-table">
        <thead><tr><th>Kolom</th><th>Wajib</th><th>Keterangan</th></tr></thead>
        <tbody>
          <tr><td><span class="lab-code">nama</span></td><td>Ya</td><td>Nama alat</td></tr>
          <tr><td><span class="lab-code">jumlah</span></td><td>Ya</td><td>Jumlah total unit (default 1)</td></tr>
          <tr><td><span class="lab-code">kode</span></td><td>Tidak</td><td>Kosong = dibuat otomatis (LAB-0001, dst.). Kode yang sudah ada dilewati</td></tr>
          <tr><td><span class="lab-code">kategori</span></td><td>Tidak</td><td>Contoh: Alat Ukur</td></tr>
          <tr><td><span class="lab-code">merk</span></td><td>Tidak</td><td>Merk / model</td></tr>
          <tr><td><span class="lab-code">lokasi</span></td><td>Tidak</td><td>Tempat penyimpanan</td></tr>
          <tr><td><span class="lab-code">rusak</span></td><td>Tidak</td><td>Jumlah unit rusak (default 0)</td></tr>
          <tr><td><span class="lab-code">keterangan</span></td><td>Tidak</td><td>Catatan bebas</td></tr>
        </tbody>
      </table>
    </div></div>
  </div></div>

  <div class="lab-panel"><div class="lab-panel-body lab-form">
    <form method="POST" action="/admin/alat-lab/import" enctype="multipart/form-data" class="d-flex flex-column flex-md-row gap-2">
      <input type="file" name="file" class="form-control" accept=".xlsx,.xls,.csv" required aria-label="File Excel atau CSV">
      <button type="submit" class="btn btn-primary rounded-pill px-4 text-nowrap"><i class="bi bi-upload me-1"></i> Import</button>
    </form>
  </div></div>
</div>
<%- include('../../partials/footer') %>
