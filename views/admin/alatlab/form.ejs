<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<% const edit = !!alat; const v = (k, d) => (alat && alat[k] !== undefined ? alat[k] : (d === undefined ? '' : d)); %>
<div class="container mt-4 mb-5" style="max-width: 860px;">
  <div class="lab-hero">
    <a href="/admin/alat-lab" class="btn btn-sm btn-outline-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Inventaris</a>
    <h2><%= edit ? 'Edit alat lab' : 'Tambah alat lab' %></h2>
    <p class="lab-sub"><%= edit ? 'Perbarui data, foto, dan jumlah unit alat ini.' : 'Lengkapi data alat agar dapat dipinjam mahasiswa.' %></p>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <form method="POST" enctype="multipart/form-data" class="lab-form" action="<%= edit ? '/admin/alat-lab/update/' + alat.id : '/admin/alat-lab' %>">
    <div class="lab-panel mb-3"><div class="lab-panel-body">
      <div class="lab-sec"><i class="bi bi-image"></i> Foto alat</div>
      <div class="lab-drop">
        <div class="preview" id="fotoBox"><% if (edit && alat.fotoUrl) { %><img id="fotoPreview" src="<%= alat.fotoUrl %>" alt="<%= alat.nama %>" referrerpolicy="no-referrer"><% } else { %><img id="fotoPreview" alt="" style="display:none"><% } %></div>
        <div class="flex-grow-1" style="min-width:220px;">
          <input type="file" name="foto" id="fotoInput" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif">
          <div class="form-text">JPG, PNG, atau WEBP, maksimal 8 MB. Foto dikompres otomatis. <%= edit && alat.fotoUrl ? 'Pilih file baru untuk mengganti.' : 'Boleh dikosongkan.' %></div>
          <% if (edit && alat.fotoUrl) { %>
            <div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="hapusFoto" id="hapusFoto"><label class="form-check-label small text-danger" for="hapusFoto">Hapus foto saat ini</label></div>
          <% } %>
        </div>
      </div>
    </div></div>

    <div class="lab-panel mb-3"><div class="lab-panel-body">
      <div class="lab-sec"><i class="bi bi-tag"></i> Identitas alat</div>
      <div class="row g-3">
        <div class="col-md-4"><label class="form-label">Kode alat</label>
          <input type="text" name="kode" class="form-control" value="<%= v('kode') %>" maxlength="30" <%= edit ? 'required' : '' %> placeholder="<%= edit ? '' : 'Kosongkan untuk otomatis' %>">
          <% if (!edit) { %><div class="form-text">Contoh hasil otomatis: LAB-0001</div><% } %></div>
        <div class="col-md-8"><label class="form-label">Nama alat <span class="text-danger">*</span></label>
          <input type="text" name="nama" class="form-control" value="<%= v('nama') %>" required maxlength="120" placeholder="Contoh: Multimeter Digital"></div>
        <div class="col-md-4"><label class="form-label">Kategori</label>
          <select name="kategori" class="form-select"><% kategori.forEach(k => { %><option value="<%= k %>" <%= v('kategori', 'Lainnya') === k ? 'selected' : '' %>><%= k %></option><% }) %></select></div>
        <div class="col-md-4"><label class="form-label">Merk / model</label><input type="text" name="merk" class="form-control" value="<%= v('merk') %>" maxlength="120"></div>
        <div class="col-md-4"><label class="form-label">Lokasi penyimpanan</label><input type="text" name="lokasi" class="form-control" value="<%= v('lokasi') %>" maxlength="120" placeholder="Contoh: Lemari A, Lab Dasar"></div>
        <div class="col-12"><label class="form-label">Keterangan</label><textarea name="keterangan" class="form-control" rows="2" maxlength="500"><%= v('keterangan') %></textarea></div>
      </div>
    </div></div>

    <div class="lab-panel mb-3"><div class="lab-panel-body">
      <div class="lab-sec"><i class="bi bi-boxes"></i> Stok</div>
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Jumlah total (unit) <span class="text-danger">*</span></label>
          <input type="number" name="jumlahTotal" class="form-control" min="1" value="<%= v('jumlahTotal', 1) %>" required></div>
        <div class="col-md-6"><label class="form-label">Unit rusak</label>
          <input type="number" name="jumlahRusak" class="form-control" min="0" value="<%= v('jumlahRusak', 0) %>"><div class="form-text">Unit rusak tidak bisa dipinjam.</div></div>
        <% if (edit) { %>
          <div class="col-12"><div class="lab-note">Saat ini <strong><%= v('jumlahTersedia', 0) %></strong> unit tersedia dan <strong><%= dipinjam %></strong> unit sedang dipinjam. Stok tersedia dihitung otomatis: total &minus; rusak &minus; sedang dipinjam.</div></div>
        <% } %>
        <div class="col-12"><div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" role="switch" name="aktif" id="aktif" <%= (!edit || alat.aktif !== false) ? 'checked' : '' %>>
          <label class="form-check-label" for="aktif">Aktif: tampil di katalog dan bisa dipinjam</label></div></div>
      </div>
    </div></div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary rounded-pill px-4"><%= edit ? 'Simpan perubahan' : 'Simpan alat' %></button>
      <a href="/admin/alat-lab" class="btn btn-outline-secondary rounded-pill px-4">Batal</a>
    </div>
  </form>
</div>
<script>
  document.getElementById('fotoInput').addEventListener('change', function () {
    var f = this.files[0], img = document.getElementById('fotoPreview');
    if (!f) return;
    if (f.size > 8 * 1024 * 1024) { alert('Ukuran foto maksimal 8 MB.'); this.value = ''; return; }
    img.src = URL.createObjectURL(f); img.style.display = 'block';
    var h = document.getElementById('hapusFoto'); if (h) h.checked = false;
  });
</script>
<%- include('../../partials/footer') %>
