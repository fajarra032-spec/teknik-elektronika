<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<div class="container mt-4 mb-5">
  <div class="lab-hero">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h2>Inventaris Alat Lab</h2>
        <p class="lab-sub">Semua alat harus terdata di sini sebelum dapat dipinjam mahasiswa.</p>
      </div>
      <div class="lab-actions">
        <a href="/admin/peminjaman-alat" class="btn btn-outline-light btn-sm rounded-pill px-3">Peminjaman</a>
        <a href="/admin/alat-lab/import" class="btn btn-outline-light btn-sm rounded-pill px-3"><i class="bi bi-file-earmark-excel me-1"></i> Import Excel</a>
        <a href="/admin/alat-lab/tambah" class="btn btn-light btn-sm rounded-pill px-3"><i class="bi bi-plus-lg me-1"></i> Tambah alat</a>
      </div>
    </div>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <div class="lab-stats">
    <div class="lab-stat"><b><%= stat.jenis %></b><small>Jenis alat</small></div>
    <div class="lab-stat"><b><%= stat.total %></b><small>Total unit</small></div>
    <div class="lab-stat ok"><b><%= stat.tersedia %></b><small>Tersedia</small></div>
    <div class="lab-stat"><b><%= stat.dipinjam %></b><small>Dipinjam</small></div>
    <div class="lab-stat <%= stat.rusak ? 'bad' : '' %>"><b><%= stat.rusak %></b><small>Rusak</small></div>
  </div>

  <div class="lab-toolbar">
    <label class="lab-search"><i class="bi bi-search"></i><input type="search" id="cari" placeholder="Cari kode, nama, merk, atau lokasi" aria-label="Cari alat"></label>
    <select id="filterKategori" class="form-select rounded-pill" style="max-width:240px;" aria-label="Filter kategori">
      <option value="">Semua kategori</option>
      <% kategori.forEach(k => { %><option value="<%= k %>"><%= k %></option><% }) %>
    </select>
  </div>

  <div class="lab-table-wrap"><div class="table-responsive">
    <table class="lab-table" id="tabelAlat">
      <thead>
        <tr><th>Alat</th><th>Kategori</th><th>Lokasi</th><th style="min-width:150px">Stok</th><th class="text-center">Rusak</th><th>Status</th><th>Aksi</th></tr>
      </thead>
      <tbody>
        <% data.forEach(a => {
             const total = a.jumlahTotal || 0, ada = a.jumlahTersedia || 0;
             const persen = total ? Math.round(ada / total * 100) : 0;
             const kelas = ada < 1 ? 'none' : (persen < 50 ? 'low' : ''); %>
        <tr data-kategori="<%= a.kategori || '' %>" data-cari="<%= [a.kode, a.nama, a.merk, a.lokasi].join(' ').toLowerCase() %>">
          <td>
            <div class="d-flex align-items-center gap-3">
              <% if (a.fotoUrl) { %><img class="lab-thumb" src="<%= a.fotoUrl %>" alt="<%= a.nama %>" loading="lazy" referrerpolicy="no-referrer"><% } else { %><span class="lab-thumb no-photo"></span><% } %>
              <div><div class="fw-semibold" style="color:var(--lab-ink)"><%= a.nama %></div>
                <div class="small text-muted"><span class="lab-code"><%= a.kode %></span><% if (a.merk) { %> <%= a.merk %><% } %></div></div>
            </div>
          </td>
          <td class="small"><%= a.kategori || '-' %></td>
          <td class="small"><%= a.lokasi || '-' %></td>
          <td>
            <div class="small"><b class="<%= ada < 1 ? 'text-danger' : '' %>"><%= ada %></b> tersedia <span class="text-muted">dari <%= total %></span></div>
            <div class="gauge mt-1 <%= kelas %>" style="--v: <%= persen %>%"><i></i></div>
            <% if (a.jumlahDipinjam > 0) { %><div class="small text-muted mt-1"><%= a.jumlahDipinjam %> sedang dipinjam</div><% } %>
          </td>
          <td class="text-center">
            <%= a.jumlahRusak || 0 %>
            <% if ((a.jumlahRusak || 0) > 0) { %>
              <form method="POST" action="/admin/alat-lab/perbaikan/<%= a.id %>" class="d-flex gap-1 mt-1 justify-content-center">
                <input type="number" name="jumlah" min="1" max="<%= a.jumlahRusak %>" value="<%= a.jumlahRusak %>" class="form-control form-control-sm" style="width:58px" aria-label="Unit selesai diperbaiki">
                <button class="btn btn-sm btn-outline-success" title="Tandai selesai diperbaiki" aria-label="Tandai selesai diperbaiki"><i class="bi bi-wrench"></i></button>
              </form>
            <% } %>
          </td>
          <td><span class="pill <%= a.aktif === false ? 'mute' : 'ok' %>"><%= a.aktif === false ? 'Nonaktif' : 'Aktif' %></span></td>
          <td class="text-nowrap">
            <a href="/admin/alat-lab/edit/<%= a.id %>" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit <%= a.nama %>"><i class="bi bi-pencil"></i></a>
            <form method="POST" action="/admin/alat-lab/hapus/<%= a.id %>" class="d-inline" onsubmit="return confirm('Hapus alat ini dari inventaris?')">
              <button class="btn btn-sm btn-outline-danger" title="Hapus" aria-label="Hapus <%= a.nama %>"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (data.length === 0) { %>
          <tr><td colspan="7"><div class="lab-empty"><i class="bi bi-motherboard"></i>Belum ada alat terdata.<div class="mt-3 d-flex gap-2 justify-content-center flex-wrap"><a href="/admin/alat-lab/tambah" class="btn btn-primary btn-sm rounded-pill px-3">Tambah alat</a><a href="/admin/alat-lab/import" class="btn btn-outline-primary btn-sm rounded-pill px-3">Import dari Excel</a></div></div></td></tr>
        <% } %>
      </tbody>
    </table>
  </div></div>
</div>
<script>
  (function () {
    var cari = document.getElementById('cari'), kat = document.getElementById('filterKategori');
    var rows = document.querySelectorAll('#tabelAlat tbody tr[data-cari]');
    function saring() {
      var q = cari.value.trim().toLowerCase(), k = kat.value;
      rows.forEach(function (r) { r.style.display = ((!q || r.dataset.cari.indexOf(q) > -1) && (!k || r.dataset.kategori === k)) ? '' : 'none'; });
    }
    cari.addEventListener('input', saring); kat.addEventListener('change', saring);
  })();
</script>
<%- include('../../partials/footer') %>
