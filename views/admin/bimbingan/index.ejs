<%- include('../../partials/header') %>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
  }
  
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 2rem;
    color: white;
    margin-bottom: 2rem;
  }
  
  .card-bimbingan {
    border: none;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden;
  }
  
  .card-header-custom {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    padding: 1rem 1.5rem;
    font-weight: 600;
  }
  
  .table-bimbingan th {
    background: #f8f9fa;
    font-weight: 600;
    white-space: nowrap;
  }
  
  .badge-pembimbing1 {
    background: #d1fae5;
    color: #065f46;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.8rem;
  }
  
  
  .btn-set {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border: none;
    color: white;
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
  }
  
  .btn-set:hover {
    transform: translateY(-2px);
    color: white;
  }
  
  .btn-delete {
    background: #dc3545;
    border: none;
    color: white;
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
  }
  
  .btn-delete:hover {
    background: #c82333;
    color: white;
  }
  
  .modal-header-custom {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
  }
</style>

<div class="container-fluid mt-4">
  <!-- Header -->
  <div class="page-header d-flex justify-content-between align-items-center">
    <div>
      <h2><i class="bi bi-people-fill me-2"></i>Pembimbing Magang (Dosen PA)</h2>
      <p class="mb-0 opacity-75">Pembimbing magang adalah Dosen Pembimbing Akademik (PA) masing-masing mahasiswa</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-light">
      <i class="bi bi-arrow-left me-2"></i>Kembali
    </a>
  </div>

  <div class="alert alert-info mb-4">
    <i class="bi bi-info-circle-fill me-2"></i>
    Pembimbing magang kini hanya satu, yaitu Dosen PA mahasiswa. Dosen PA otomatis
    menjadi pembimbing magang: menyetujui logbook, meninjau laporan, dan mengisi Nilai Laporan &amp; Nilai Logbook.
    Untuk mengganti pembimbing, ubah <strong>Dosen PA</strong> mahasiswa di
    <a href="/admin/mahasiswa" class="alert-link">menu Mahasiswa</a>
    (Edit Mahasiswa, atau pilih beberapa mahasiswa lalu "Tetapkan Dosen PA").
  </div>

  <% if (totalBelumPa > 0) { %>
    <div class="alert alert-warning mb-4">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <strong><%= totalBelumPa %> dari <%= totalMahasiswa %></strong> mahasiswa aktif belum memiliki Dosen PA.
      Mahasiswa tersebut <strong>belum bisa</strong> mengisi logbook atau mengunggah laporan magang.
    </div>
  <% } %>

  <div class="card-bimbingan">
    <div class="card-header-custom d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span><i class="bi bi-table me-2"></i> Mahasiswa Aktif &amp; Dosen Pembimbing (PA)</span>
      <input type="text" id="cariMahasiswa" class="form-control form-control-sm" style="max-width: 260px;"
             placeholder="Cari NIM / nama / dosen..." value="<%= search %>">
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-bimbingan mb-0" id="tabelPembimbing">
          <thead>
            <tr>
              <th>No</th>
              <th>NIM</th>
              <th>Nama Mahasiswa</th>
              <th>Kelas</th>
              <th>Dosen Pembimbing (Dosen PA)</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (mahasiswaList.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center py-5">
                  <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                  <p class="text-muted">Belum ada mahasiswa aktif.</p>
                </td>
              </tr>
            <% } else { %>
              <% mahasiswaList.forEach((m, index) => { %>
                <tr data-cari="<%= (m.nim + ' ' + m.nama + ' ' + (m.dosenPaNama || '')).toLowerCase() %>">
                  <td class="text-center"><%= index + 1 %></td>
                  <td><%= m.nim %></td>
                  <td><%= m.nama %></td>
                  <td><%= m.kelas %></td>
                  <td>
                    <% if (m.dosenPaNama) { %>
                      <span class="badge-pembimbing1">
                        <i class="bi bi-person-check-fill me-1"></i> <%= m.dosenPaNama %>
                      </span>
                    <% } else { %>
                      <span class="text-warning fw-semibold">
                        <i class="bi bi-hourglass-split me-1"></i> Belum ditetapkan
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/admin/mahasiswa/<%= m.id %>/edit" class="btn-set text-decoration-none">
                      <i class="bi bi-pencil me-1"></i> <%= m.dosenPaNama ? 'Ganti Dosen PA' : 'Tetapkan Dosen PA' %>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const input = document.getElementById('cariMahasiswa');
    const rows = document.querySelectorAll('#tabelPembimbing tbody tr[data-cari]');
    function saring() {
      const q = input.value.toLowerCase().trim();
      rows.forEach(r => { r.style.display = r.getAttribute('data-cari').includes(q) ? '' : 'none'; });
    }
    input.addEventListener('input', saring);
    if (input.value) saring();
  })();
</script>


<%- include('../../partials/footer') %>