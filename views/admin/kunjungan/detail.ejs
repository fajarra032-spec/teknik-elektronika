<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  const kelas = { diajukan: 'wait', disetujui: 'ok', ditolak: 'bad' };
  const waktu = (s) => s ? new Date(s).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
%>
<div class="container mt-4 mb-5" style="max-width: 960px;">
  <div class="lab-hero">
    <a href="/admin/kunjungan-industri" class="btn btn-sm btn-outline-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Daftar pengajuan</a>
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div><h2><%= p.namaPerusahaan %></h2><p class="lab-sub">Kode <%= p.kode %> &middot; diajukan <%= waktu(p.createdAt) %></p></div>
      <span class="pill <%= kelas[p.status] || 'mute' %> fs-6"><%= statusLabel[p.status] || p.status %></span>
    </div>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <div class="lab-panel mb-3"><div class="lab-panel-body pb-3"><%- include('../../partials/kunjungan_stepper', { status: p.status }) %></div></div>

  <div class="lab-panel mb-3"><div class="lab-panel-body">
    <div class="lab-sec"><i class="bi bi-card-text"></i> Ringkasan pengajuan</div>
    <dl class="lab-dl">
      <dt>Pengaju</dt><dd><%= p.namaPengaju %><% if (p.jabatanPengaju) { %> (<%= p.jabatanPengaju %>)<% } %></dd>
      <dt>Kontak</dt><dd><%= p.noHp %><% if (p.email) { %> &middot; <%= p.email %><% } %>
        <a class="ms-2 small" target="_blank" rel="noopener" href="https://wa.me/<%= String(p.noHp).replace(/[^0-9]/g, '').replace(/^0/, '62') %>"><i class="bi bi-whatsapp"></i> WhatsApp</a></dd>
      <dt>Alamat perusahaan</dt><dd><%= p.alamatPerusahaan %></dd>
      <dt>Waktu</dt><dd><%= rentangHari(p.tanggalKunjungan, p.tanggalSelesai) %><br><span class="text-muted"><%= rentangWaktu(p.waktuMulai, p.waktuSelesai) %></span></dd>
      <dt>Peserta</dt><dd><%= p.jumlahMahasiswa %> mahasiswa, <%= p.jumlahPendamping || 0 %> dosen pendamping</dd>
      <dt>Mata kuliah terkait</dt><dd><% (p.mataKuliah || []).forEach(m => { %><span class="mk-tag"><%= m.nama %></span><% }) %></dd>
      <dt>Keterkaitan</dt><dd style="white-space:pre-line"><%= p.keterkaitan %></dd>
      <% if (p.tujuan) { %><dt>Tujuan</dt><dd style="white-space:pre-line"><%= p.tujuan %></dd><% } %>
      <% if (p.status === 'ditolak') { %><dt>Alasan penolakan</dt><dd class="text-danger"><%= p.alasanPenolakan %></dd><% } %>
    </dl>
  </div></div>

  <% if (p.status === 'diajukan') { %>
    <div class="lab-panel mb-3"><div class="lab-panel-body lab-form">
      <div class="lab-sec"><i class="bi bi-patch-check"></i> Verifikasi</div>
      <div class="row g-3">
        <div class="col-md-7">
          <form method="POST" action="/admin/kunjungan-industri/<%= p.id %>/setujui" class="border rounded-3 p-3 h-100" style="border-color: var(--lab-line) !important;">
            <label class="form-label text-success"><i class="bi bi-check-circle"></i> Setujui dan terbitkan surat</label>
            <input type="text" name="nomorSurat" class="form-control mb-2" maxlength="100" required placeholder="Nomor permohonan, mis. 012/ELK-PD/KI/XI/2026">
            <label class="form-label small mb-1">Tanggal surat</label>
            <input type="date" name="tanggalSurat" class="form-control mb-3" value="<%= hariIni %>">
            <button class="btn btn-success rounded-pill w-100" onclick="return confirm('Terbitkan surat dengan nomor ini? Surat langsung tampil di halaman publik.')">Setujui dan terbitkan surat</button>
            <div class="form-text">Surat dan PDF dibuat otomatis begitu nomor disimpan.</div>
          </form>
        </div>
        <div class="col-md-5">
          <form method="POST" action="/admin/kunjungan-industri/<%= p.id %>/tolak" class="border rounded-3 p-3 h-100" style="border-color: var(--lab-line) !important;">
            <label class="form-label text-danger"><i class="bi bi-x-circle"></i> Tolak</label>
            <textarea name="alasan" class="form-control mb-3" rows="3" maxlength="500" required placeholder="Alasan (wajib, tampil ke pengaju)"></textarea>
            <button class="btn btn-outline-danger rounded-pill w-100">Tolak pengajuan</button>
          </form>
        </div>
      </div>
    </div></div>
  <% } %>

  <% if (p.status === 'disetujui') { %>
    <div class="lab-panel mb-3" style="border-color:#9fdcc2;"><div class="lab-panel-body">
      <div class="lab-sec"><i class="bi bi-file-earmark-check"></i> Surat terbit</div>
      <dl class="lab-dl mb-3">
        <dt>Nomor surat</dt><dd><strong><%= p.nomorSurat %></strong></dd>
        <dt>Tanggal surat</dt><dd><%= tanggalPanjang(p.tanggalSurat) %></dd>
        <dt>Kode validasi</dt><dd><span class="lab-code"><%= p.kodeValidasi %></span></dd>
        <dt>Disetujui oleh</dt><dd><%= p.disetujuiOleh %> &middot; <%= waktu(p.disetujuiAt) %></dd>
      </dl>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/dokumen/kunjungan-industri/surat/<%= p.id %>" target="_blank" rel="noopener" class="btn btn-primary rounded-pill px-3"><i class="bi bi-printer me-1"></i> Lihat / cetak surat</a>
        <% if (p.pdfUrl) { %><a href="<%= p.pdfUrl %>" class="btn btn-outline-success rounded-pill px-3"><i class="bi bi-download me-1"></i> Unduh PDF</a>
        <% } else { %><span class="pill wait align-self-center">PDF belum tersedia</span><% } %>
        <form method="POST" action="/admin/kunjungan-industri/<%= p.id %>/buat-ulang-pdf"><button class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-repeat me-1"></i> Buat ulang PDF</button></form>
        <form method="POST" action="/admin/kunjungan-industri/<%= p.id %>/tarik" onsubmit="return confirm('Tarik surat dari halaman publik? Nomor surat dan PDF akan dihapus.')"><button class="btn btn-outline-danger rounded-pill px-3"><i class="bi bi-arrow-counterclockwise me-1"></i> Tarik surat</button></form>
      </div>
    </div></div>
  <% } %>

  <div class="lab-panel mb-3"><div class="lab-panel-body lab-form">
    <details>
      <summary class="fw-bold" style="cursor:pointer;color:var(--lab-ink);"><i class="bi bi-pencil-square me-1"></i> Edit data pengajuan<% if (p.status === 'disetujui') { %> <span class="small text-muted fw-normal">(PDF dibuat ulang otomatis)</span><% } %></summary>
      <form method="POST" action="/admin/kunjungan-industri/<%= p.id %>/update" class="mt-3">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Nama pengaju</label><input name="namaPengaju" class="form-control" required maxlength="100" value="<%= p.namaPengaju %>"></div>
          <div class="col-md-6"><label class="form-label">Jabatan / asal</label><input name="jabatanPengaju" class="form-control" maxlength="100" value="<%= p.jabatanPengaju || '' %>"></div>
          <div class="col-md-6"><label class="form-label">No. HP</label><input name="noHp" class="form-control" required maxlength="20" value="<%= p.noHp %>"></div>
          <div class="col-md-6"><label class="form-label">Email</label><input name="email" class="form-control" maxlength="100" value="<%= p.email || '' %>"></div>
          <div class="col-12"><label class="form-label">Nama perusahaan</label><input name="namaPerusahaan" class="form-control" required maxlength="150" value="<%= p.namaPerusahaan %>"></div>
          <div class="col-12"><label class="form-label">Alamat perusahaan</label><textarea name="alamatPerusahaan" class="form-control" rows="2" required maxlength="300"><%= p.alamatPerusahaan %></textarea></div>
          <div class="col-md-3"><label class="form-label">Tanggal kunjungan</label><input type="date" name="tanggalKunjungan" class="form-control" required value="<%= p.tanggalKunjungan %>"></div>
          <div class="col-md-3"><label class="form-label">Sampai tanggal</label><input type="date" name="tanggalSelesai" class="form-control" value="<%= p.tanggalSelesai || '' %>"></div>
          <div class="col-md-3"><label class="form-label">Jam mulai</label><input type="time" name="waktuMulai" class="form-control" value="<%= p.waktuMulai || '' %>"></div>
          <div class="col-md-3"><label class="form-label">Jam selesai</label><input type="time" name="waktuSelesai" class="form-control" value="<%= p.waktuSelesai || '' %>"></div>
          <div class="col-md-6"><label class="form-label">Jumlah mahasiswa</label><input type="number" name="jumlahMahasiswa" class="form-control" min="1" max="500" required value="<%= p.jumlahMahasiswa %>"></div>
          <div class="col-md-6"><label class="form-label">Dosen pendamping</label><input type="number" name="jumlahPendamping" class="form-control" min="0" max="50" value="<%= p.jumlahPendamping || 0 %>"></div>
          <div class="col-12"><label class="form-label">Mata kuliah terkait</label>
            <div class="border rounded-3 p-2" style="max-height:200px;overflow-y:auto;border-color:var(--lab-line)!important;">
              <% mkList.forEach(m => { %>
                <div class="form-check"><input class="form-check-input" type="checkbox" name="mkIds" value="<%= m.id %>" id="mk_<%= m.id %>" <%= terpilih.has(m.id) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="mk_<%= m.id %>"><%= m.kode ? m.kode + ' - ' : '' %><%= m.nama %><% if (m.semester) { %> <span class="text-muted">(Smt <%= m.semester %>)</span><% } %></label></div>
              <% }) %>
            </div></div>
          <div class="col-12"><label class="form-label">Keterkaitan</label><textarea name="keterkaitan" class="form-control" rows="3" required minlength="20" maxlength="1500"><%= p.keterkaitan %></textarea></div>
          <div class="col-12"><label class="form-label">Tujuan</label><textarea name="tujuan" class="form-control" rows="2" maxlength="1000"><%= p.tujuan || '' %></textarea></div>
        </div>
        <button class="btn btn-primary rounded-pill px-4 mt-3">Simpan perubahan</button>
      </form>
    </details>
  </div></div>

  <div class="lab-panel mb-3"><div class="lab-panel-body">
    <div class="lab-sec"><i class="bi bi-clock-history"></i> Riwayat</div>
    <ul class="lab-timeline">
      <% (p.riwayat || []).forEach(r => { %>
        <li><div class="fw-semibold"><%= statusLabel[r.status] || r.status %></div><div class="who"><%= r.oleh %> &middot; <%= waktu(r.waktu) %></div>
          <% if (r.catatan) { %><div class="note"><%= r.catatan %></div><% } %></li>
      <% }) %>
    </ul>
  </div></div>

  <form method="POST" action="/admin/kunjungan-industri/<%= p.id %>/hapus" onsubmit="return confirm('Hapus pengajuan ini secara permanen?')">
    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-trash me-1"></i> Hapus pengajuan</button>
  </form>
</div>
<%- include('../../partials/footer') %>
