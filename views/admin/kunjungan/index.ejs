<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  const tabs = [['diajukan', 'Menunggu verifikasi', hitung.diajukan, true], ['disetujui', 'Disetujui', hitung.disetujui, false], ['ditolak', 'Ditolak', hitung.ditolak, false], ['semua', 'Semua', hitung.semua, false]];
  const kelas = { diajukan: 'wait', disetujui: 'ok', ditolak: 'bad' };
%>
<div class="container mt-4 mb-5">
  <div class="lab-hero">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div><h2>Pengajuan Kunjungan Industri</h2><p class="lab-sub">Pengajuan dari publik. Isi nomor permohonan untuk menerbitkan surat otomatis.</p></div>
      <a href="/dokumen/kunjungan-industri" target="_blank" rel="noopener" class="btn btn-light btn-sm rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i> Halaman publik</a>
    </div>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <nav class="lab-tabs" aria-label="Filter status">
    <% tabs.forEach(t => { %>
      <a class="lab-tab <%= filter === t[0] ? 'active' : '' %>" href="/admin/kunjungan-industri?status=<%= t[0] %>"><%= t[1] %> <span class="n <%= (t[3] && t[2] > 0 && filter !== t[0]) ? 'alert' : '' %>"><%= t[2] %></span></a>
    <% }) %>
  </nav>

  <div class="lab-table-wrap"><div class="table-responsive">
    <table class="lab-table">
      <thead><tr><th>Kode</th><th>Perusahaan</th><th>Pengaju</th><th>Tanggal kunjungan</th><th>Mata kuliah</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% data.forEach(p => { %>
          <tr>
            <td><span class="lab-code"><%= p.kode %></span><div class="small text-muted mt-1"><%= new Date(p.createdAt).toLocaleDateString('id-ID') %></div></td>
            <td><div class="fw-semibold"><%= p.namaPerusahaan %></div><% if (p.nomorSurat) { %><div class="small text-success">No. <%= p.nomorSurat %></div><% } %></td>
            <td><%= p.namaPengaju %><div class="small text-muted"><%= p.noHp %></div></td>
            <td class="small"><%= tanggalPanjang(p.tanggalKunjungan) %></td>
            <td class="small"><% (p.mataKuliah || []).forEach(m => { %><span class="mk-tag"><%= m.nama %></span><% }) %></td>
            <td><span class="pill <%= kelas[p.status] || 'mute' %>"><%= statusLabel[p.status] || p.status %></span></td>
            <td><a href="/admin/kunjungan-industri/<%= p.id %>" class="btn btn-sm rounded-pill px-3 btn-<%= p.status === 'diajukan' ? 'primary' : 'outline-primary' %>"><%= p.status === 'diajukan' ? 'Verifikasi' : 'Detail' %></a></td>
          </tr>
        <% }) %>
        <% if (data.length === 0) { %><tr><td colspan="7"><div class="lab-empty"><i class="bi bi-inbox"></i>Tidak ada data pada kategori ini.</div></td></tr><% } %>
      </tbody>
    </table>
  </div></div>
</div>
<%- include('../../partials/footer') %>
