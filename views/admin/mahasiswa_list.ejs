<%- include('../partials/header') %>

<%
  // Fungsi untuk mengekstrak ID file dari URL Google Drive
  const getFileIdFromUrl = (url) => {
    if (!url) return null;
    let match = url.match(/[?&]id=([^&]+)/);
    if (match) return match[1];
    match = url.match(/\/d\/([^\/]+)/);
    if (match) return match[1];
    return null;
  };

  // Pastikan semua variabel filter ada (mencegah error "is not defined")
  var filterAngkatan = typeof filterAngkatan !== 'undefined' ? filterAngkatan : '';
  var filterSemester = typeof filterSemester !== 'undefined' ? filterSemester : '';
  var filterStatusMagang = typeof filterStatusMagang !== 'undefined' ? filterStatusMagang : '';
  var filterStatusMahasiswa = typeof filterStatusMahasiswa !== 'undefined' ? filterStatusMahasiswa : '';
  var filterKelas = typeof filterKelas !== 'undefined' ? filterKelas : '';
  var kelasList = typeof kelasList !== 'undefined' ? kelasList : [];
  var search = typeof search !== 'undefined' ? search : '';
  var angkatanList = typeof angkatanList !== 'undefined' ? angkatanList : [];
  var mahasiswa = typeof mahasiswa !== 'undefined' ? mahasiswa : [];
  var importResult = typeof importResult !== 'undefined' ? importResult : null;
  var importError = typeof importError !== 'undefined' ? importError : null;
  var success = typeof success !== 'undefined' ? success : null;
%>

<style>
  :root {
    --primary-start: #2193b0;
    --primary-end: #6dd5ed;
    --primary-light: rgba(33,147,176,0.1);
    --primary-dark: #1a7a8f;
  }
  .filter-card {
    border-radius: 1.2rem;
    border: 1px solid rgba(33,147,176,0.1);
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    background: white;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .filter-card .form-label { font-weight: 600; color: #1e293b; }
  .filter-card .form-select, .filter-card .form-control {
    border-radius: 50px;
    border: 1px solid #dee2e6;
    padding: 0.6rem 1rem;
  }
  .btn-filter {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border: none;
    color: white;
    font-weight: 500;
    padding: 0.6rem 1.5rem;
    border-radius: 50px;
    transition: all 0.3s;
    width: 100%;
  }
  .btn-filter:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(33,147,176,0.4);
    color: white;
  }
  .btn-gradient {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border: none;
    color: white;
    font-weight: 500;
    padding: 0.6rem 1.5rem;
    border-radius: 50px;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-gradient:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(33,147,176,0.4);
    color: white;
  }
  .btn-outline {
    background: transparent;
    border: 2px solid var(--primary-start);
    color: var(--primary-start);
    border-radius: 50px;
    padding: 0.5rem 1.2rem;
    transition: all 0.3s;
  }
  .btn-outline:hover {
    background: var(--primary-start);
    color: white;
  }
  .table-container {
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .mahasiswa-table thead th {
    background: linear-gradient(135deg, var(--primary-light), rgba(109,213,237,0.1));
    color: var(--primary-dark);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    border-bottom: 2px solid var(--primary-start);
    padding: 1rem 0.75rem;
  }
  .mahasiswa-table tbody tr:hover {
    background-color: var(--primary-light);
    transform: scale(1.01);
  }
  .mahasiswa-table td {
    padding: 1rem 0.75rem;
    vertical-align: middle;
  }
  .btn-icon-sm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    transition: all 0.2s;
    color: white;
    margin: 0 2px;
  }
  .btn-detail { background: var(--primary-start); }
  .btn-edit { background: #ffc107; }
  .btn-krs { background: #198754; }
  .btn-reset { background: #6c757d; }
  .btn-delete { background: #dc3545; }
  .avatar-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.2rem;
  }
  .foto-mahasiswa {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--primary-start);
  }
  .badge-semester { background: #cfe2ff; color: #084298; }
  .badge-magang { background: #cff4fc; color: #055160; }
  .badge-aktif { background: #d4edda; color: #155724; }
  .badge-lulus { background: #d1ecf1; color: #0c5460; }
  .badge-cuti { background: #fff3cd; color: #856404; }
  .badge-keluar { background: #f8d7da; color: #842029; }
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    background: #f8f9fa;
    border-radius: 1.5rem;
  }
  .empty-state i { font-size: 4rem; color: #adb5bd; margin-bottom: 1.5rem; }
</style>

<div class="container-fluid mt-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-mortarboard-fill me-2" style="color: var(--primary-start);"></i>Kelola Mahasiswa</h2>
    <div>
      <a href="/admin/mahasiswa/template" class="btn-outline me-2" style="text-decoration: none;">
        <i class="bi bi-download"></i> Template CSV
      </a>
      <button class="btn-outline me-2" data-bs-toggle="modal" data-bs-target="#importModal">
        <i class="bi bi-upload"></i> Import CSV
      </button>
      <a href="/admin/mahasiswa/export/csv<%= (filterAngkatan || filterSemester || filterStatusMagang || filterStatusMahasiswa || filterKelas || search) ? '?' + new URLSearchParams({angkatan: filterAngkatan, semester: filterSemester, statusMagang: filterStatusMagang, statusMahasiswa: filterStatusMahasiswa, kelas: filterKelas, search: search}).toString() : '' %>" 
         class="btn-outline me-2" style="text-decoration: none;">
        <i class="bi bi-download"></i> Download CSV
      </a>
      <a href="/admin/mahasiswa/print<%= (filterAngkatan || filterSemester || filterStatusMagang || filterStatusMahasiswa || filterKelas || search) ? '?' + new URLSearchParams({angkatan: filterAngkatan, semester: filterSemester, statusMagang: filterStatusMagang, statusMahasiswa: filterStatusMahasiswa, kelas: filterKelas, search: search}).toString() : '' %>"
         class="btn-outline me-2" style="text-decoration: none;" target="_blank">
        <i class="bi bi-printer"></i> Cetak Daftar
      </a>
      <a href="/admin/mahasiswa/create" class="btn-gradient">
        <i class="bi bi-plus-circle"></i> Tambah Mahasiswa
      </a>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="filter-card">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-2">
        <label for="angkatan" class="form-label fw-semibold">Angkatan</label>
        <select class="form-select" id="angkatan" name="angkatan">
          <option value="">Semua Angkatan</option>
          <% if (angkatanList && angkatanList.length) { %>
            <% angkatanList.forEach(a => { %>
              <option value="<%= a %>" <%= a === filterAngkatan ? 'selected' : '' %>><%= a %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-2">
        <label for="semester" class="form-label fw-semibold">Semester (1-12)</label>
        <select class="form-select" id="semester" name="semester">
          <option value="">Semua Semester</option>
          <% for(let i=1; i<=12; i++) { %>
            <option value="Semester <%= i %>" <%= filterSemester === ('Semester '+i) ? 'selected' : '' %>>Semester <%= i %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-2">
        <label for="statusMagang" class="form-label fw-semibold">Status Magang</label>
        <select class="form-select" id="statusMagang" name="statusMagang">
          <option value="">Semua</option>
          <option value="Magang 1" <%= filterStatusMagang === 'Magang 1' ? 'selected' : '' %>>Magang 1</option>
          <option value="Magang 2" <%= filterStatusMagang === 'Magang 2' ? 'selected' : '' %>>Magang 2</option>
          <option value="Magang 3" <%= filterStatusMagang === 'Magang 3' ? 'selected' : '' %>>Magang 3</option>
          <option value="Selesai Magang" <%= filterStatusMagang === 'Selesai Magang' ? 'selected' : '' %>>Selesai Magang</option>
        </select>
      </div>
      <div class="col-md-2">
        <label for="statusMahasiswa" class="form-label fw-semibold">Status Mahasiswa</label>
        <select class="form-select" id="statusMahasiswa" name="statusMahasiswa">
          <option value="">Semua</option>
          <option value="Aktif" <%= filterStatusMahasiswa === 'Aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="Lulus" <%= filterStatusMahasiswa === 'Lulus' ? 'selected' : '' %>>Lulus</option>
          <option value="Cuti" <%= filterStatusMahasiswa === 'Cuti' ? 'selected' : '' %>>Cuti</option>
          <option value="Keluar" <%= filterStatusMahasiswa === 'Keluar' ? 'selected' : '' %>>Keluar</option>
        </select>
      </div>
      <div class="col-md-2">
        <label for="kelas" class="form-label fw-semibold">Kelas</label>
        <select class="form-select" id="kelas" name="kelas">
          <option value="">Semua Kelas</option>
          <% if (kelasList && kelasList.length) { %>
            <% kelasList.forEach(k => { %>
              <option value="<%= k %>" <%= k === filterKelas ? 'selected' : '' %>><%= k %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="search" class="form-label fw-semibold">Cari (Nama/NIM)</label>
        <input type="text" class="form-control" id="search" name="search" placeholder="Nama atau NIM" value="<%= search %>">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn-filter">Filter</button>
      </div>
    </form>
  </div>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i>Data mahasiswa berhasil <%= success %>.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Notifikasi hasil import / bulk assign kelas -->
  <% if (importResult) { %>
    <div class="alert alert-info alert-dismissible fade show mb-4">
      <% if (importResult.pesan) { %>
        <i class="bi bi-check-circle"></i> <%= importResult.pesan %>.
      <% } else { %>
        <i class="bi bi-info-circle"></i> Import selesai: <strong><%= importResult.success %></strong> berhasil, <strong><%= importResult.failed %></strong> gagal.
      <% } %>
      <% if (importResult.errors && importResult.errors.length) { %>
        <details>
          <summary>Detail error (<%= importResult.errors.length %>)</summary>
          <ul>
            <% importResult.errors.forEach(e => { %>
              <li><%= e %></li>
            <% }) %>
          </ul>
        </details>
      <% } %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (importError) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4">
      <i class="bi bi-exclamation-triangle"></i> <%= importError %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <p class="mb-0">Menampilkan <strong><%= mahasiswa.length %></strong> mahasiswa</p>
  </div>

  <!-- Toolbar assign kelas massal - muncul setelah pilih minimal 1 checkbox -->
  <div id="bulkKelasBar" class="filter-card mb-3" style="display:none;">
    <form method="POST" action="/admin/mahasiswa/bulk-kelas" id="bulkKelasForm" class="d-flex flex-wrap gap-2 align-items-end">
      <div id="bulkKelasIdsContainer"></div>
      <div>
        <label class="form-label fw-semibold mb-1"><span id="bulkKelasCount">0</span> mahasiswa dipilih - masukkan ke kelas:</label>
        <input type="text" name="kelas" class="form-control form-control-sm" list="kelasDatalist" placeholder="mis. ELK1A" required style="min-width:180px;">
        <datalist id="kelasDatalist">
          <% kelasList.forEach(k => { %><option value="<%= k %>"><% }) %>
        </datalist>
      </div>
      <button type="submit" class="btn-filter btn-sm">Terapkan</button>
      <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearBulkKelasSelection()">Batal Pilih</button>
    </form>
  </div>

  <!-- Toolbar assign Dosen PA massal - toolbar terpisah, pakai checkbox yang sama -->
  <div id="bulkDosenPaBar" class="filter-card mb-3" style="display:none;">
    <form method="POST" action="/admin/mahasiswa/bulk-dosen-pa" id="bulkDosenPaForm" class="d-flex flex-wrap gap-2 align-items-end">
      <div id="bulkDosenPaIdsContainer"></div>
      <div>
        <label class="form-label fw-semibold mb-1"><span id="bulkDosenPaCount">0</span> mahasiswa dipilih - tetapkan Dosen PA:</label>
        <select name="dosenPaId" class="form-select form-select-sm" required style="min-width:220px;">
          <option value="">- Pilih Dosen PA -</option>
          <% dosenPaList.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.nama %><%= d.nidn ? ' (NIDN ' + d.nidn + ')' : '' %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn-filter btn-sm">Terapkan</button>
      <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearBulkKelasSelection()">Batal Pilih</button>
    </form>
  </div>


  <div class="table-container">
    <div class="table-responsive">
      <table class="table mahasiswa-table">
        <thead>
          <tr>
            <th><input type="checkbox" id="selectAllMahasiswa" onchange="toggleAllMahasiswaCheckbox(this)"></th>
            <th>Foto</th>
            <th>NIM</th>
            <th>Nama</th>
            <th>Email</th>
            <th>Angkatan</th>
            <th>Kelas</th>
            <th>Semester</th>
            <th>Status Magang</th>
            <th>Status Mahasiswa</th>
            <th>Biodata</th>
            <th>Dosen PA</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (mahasiswa.length === 0) { %>
            <tr>
              <td colspan="12" class="text-center py-5">
                <div class="empty-state">
                  <i class="bi bi-inbox"></i>
                  <h4>Belum Ada Data Mahasiswa</h4>
                  <p class="text-muted">Silakan tambahkan mahasiswa pertama.</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% mahasiswa.forEach(m => { 
              let angkatan = (m.nim && m.nim.length >= 2) ? '20' + m.nim.substring(0,2) : '-';
              let semesterText = m.semester || '-';
              let magangText = m.statusMagang || '-';
              let mahasiswaStatus = m.statusMahasiswa || '-';
              let badgeMahasiswa = '';
              if (mahasiswaStatus === 'Aktif') badgeMahasiswa = 'badge-aktif';
              else if (mahasiswaStatus === 'Lulus') badgeMahasiswa = 'badge-lulus';
              else if (mahasiswaStatus === 'Cuti') badgeMahasiswa = 'badge-cuti';
              else if (mahasiswaStatus === 'Keluar') badgeMahasiswa = 'badge-keluar';
              else badgeMahasiswa = 'badge-default';
            %>
            <tr>
              <td><input type="checkbox" class="mahasiswaCheckbox" value="<%= m.id %>" onchange="updateBulkKelasBar()"></td>
              <td>
                <% if (m.foto) { 
                  const fileId = getFileIdFromUrl(m.foto);
                  if (fileId) { %>
                    <img src="https://drive.google.com/thumbnail?id=<%= fileId %>&sz=w100" 
                         class="foto-mahasiswa"
                         onerror="this.onerror=null; this.src='<%= m.foto %>';">
                  <% } else { %>
                    <img src="<%= m.foto %>" class="foto-mahasiswa"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/40?text=<%= (m.nama || '?').charAt(0).toUpperCase() %>';">
                  <% } %>
                <% } else { %>
                  <div class="avatar-circle"><%= (m.nama || '?').charAt(0).toUpperCase() %></div>
                <% } %>
              </td>
              <td><%= m.nim || '-' %></td>
              <td><strong><%= m.nama %></strong></td>
              <td><%= m.email %></td>
              <td><%= angkatan %></td>
              <td><% if (m.kelas) { %><span class="badge bg-secondary"><%= m.kelas %></span><% } else { %><span class="text-muted">-</span><% } %></td>
              <td><span class="badge badge-semester"><%= semesterText %></span></td>
              <td><span class="badge badge-magang"><%= magangText %></span></td>
              <td><span class="badge <%= badgeMahasiswa %>"><%= mahasiswaStatus %></span></td>
              <td>
                <% if (m.biodataLengkap) { %>
                  <span class="badge bg-success"><i class="bi bi-check-circle"></i> Lengkap</span>
                <% } else { %>
                  <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Belum</span>
                <% } %>
              </td>
              <td>
                <% if (m.dosenPaNama) { %>
                  <span class="badge bg-info text-dark"><%= m.dosenPaNama %></span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/admin/mahasiswa/<%= m.id %>" class="btn-icon-sm btn-detail" title="Detail">
                    <i class="bi bi-eye"></i>
                  </a>
                  <a href="/admin/krs/buat/<%= m.id %>" class="btn-icon-sm btn-krs" title="Buat KRS">
                    <i class="bi bi-journal-plus"></i>
                  </a>
                  <a href="/admin/nilai/mahasiswa/<%= m.id %>/tambah" class="btn-icon-sm btn-detail" title="Kelola Nilai">
                    <i class="bi bi-bar-chart-line"></i>
                  </a>
                  <a href="/admin/mahasiswa/<%= m.id %>/edit" class="btn-icon-sm btn-edit" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <button class="btn-icon-sm btn-reset" title="Reset Password" onclick="resetPassword('<%= m.id %>', '<%= m.email %>')">
                    <i class="bi bi-key"></i>
                  </button>
                  <form method="POST" action="/admin/mahasiswa/<%= m.id %>/delete" style="display:inline;" onsubmit="return confirm('Yakin hapus mahasiswa ini? Semua data terkait akan hilang.')">
                    <button type="submit" class="btn-icon-sm btn-delete" title="Hapus">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Import CSV -->
<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-file-earmark-spreadsheet"></i> Import Mahasiswa (CSV)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/mahasiswa/import" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Format CSV: <strong>nim,nama,email,password,semester,statusMagang,statusMahasiswa,noHp</strong><br>
            Gunakan tombol <strong>Template CSV</strong> untuk contoh.
          </div>
          <div class="mb-3">
            <label for="csvFile" class="form-label">Pilih file CSV</label>
            <input type="file" class="form-control" id="csvFile" name="file" accept=".csv" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-primary">Import</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function resetPassword(id, email) {
    if (confirm(`Kirim email reset password ke ${email}?`)) {
      fetch(`/admin/mahasiswa/${id}/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      }).then(res => {
        if (res.ok) alert('Email reset telah dikirim.');
        else alert('Gagal mengirim email.');
      }).catch(() => alert('Terjadi kesalahan.'));
    }
  }

  // ===== Assign kelas / Dosen PA massal (checkbox pilih + toolbar) =====
  function toggleAllMahasiswaCheckbox(source) {
    document.querySelectorAll('.mahasiswaCheckbox').forEach(cb => { cb.checked = source.checked; });
    updateBulkKelasBar();
  }

  function updateBulkKelasBar() {
    const checked = document.querySelectorAll('.mahasiswaCheckbox:checked');

    const bar = document.getElementById('bulkKelasBar');
    const countEl = document.getElementById('bulkKelasCount');
    const container = document.getElementById('bulkKelasIdsContainer');
    container.innerHTML = '';

    const paBar = document.getElementById('bulkDosenPaBar');
    const paCountEl = document.getElementById('bulkDosenPaCount');
    const paContainer = document.getElementById('bulkDosenPaIdsContainer');
    paContainer.innerHTML = '';

    checked.forEach(cb => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'mahasiswaIds';
      input.value = cb.value;
      container.appendChild(input);

      const input2 = document.createElement('input');
      input2.type = 'hidden';
      input2.name = 'mahasiswaIds';
      input2.value = cb.value;
      paContainer.appendChild(input2);
    });

    countEl.textContent = checked.length;
    bar.style.display = checked.length > 0 ? 'block' : 'none';
    paCountEl.textContent = checked.length;
    paBar.style.display = checked.length > 0 ? 'block' : 'none';
  }

  function clearBulkKelasSelection() {
    document.querySelectorAll('.mahasiswaCheckbox').forEach(cb => { cb.checked = false; });
    const selectAll = document.getElementById('selectAllMahasiswa');
    if (selectAll) selectAll.checked = false;
    updateBulkKelasBar();
  }

  document.getElementById('bulkKelasForm').addEventListener('submit', function(e) {
    const count = document.querySelectorAll('.mahasiswaCheckbox:checked').length;
    const kelasVal = this.querySelector('input[name="kelas"]').value.trim();
    if (!confirm(`Masukkan ${count} mahasiswa ke kelas "${kelasVal}"?`)) {
      e.preventDefault();
    }
  });

  document.getElementById('bulkDosenPaForm').addEventListener('submit', function(e) {
    const count = document.querySelectorAll('.mahasiswaCheckbox:checked').length;
    const select = this.querySelector('select[name="dosenPaId"]');
    const dosenNama = select.options[select.selectedIndex].text;
    if (!confirm(`Tetapkan Dosen PA "${dosenNama}" untuk ${count} mahasiswa terpilih?`)) {
      e.preventDefault();
    }
  });
</script>

