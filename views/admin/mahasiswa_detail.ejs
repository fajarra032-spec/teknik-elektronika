<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-badge me-2"></i><%= title %></h4>
    <a href="/admin/mahasiswa" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card shadow-sm border-0 text-center">
        <div class="card-body">
          <% if (mahasiswa.foto) { %>
            <img src="<%= mahasiswa.foto %>" class="rounded-circle mb-3" width="120" height="120" style="object-fit:cover;">
          <% } else { %>
            <div class="rounded-circle bg-primary bg-opacity-10 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:120px;height:120px;">
              <i class="bi bi-person fs-1 text-primary"></i>
            </div>
          <% } %>
          <h5 class="mb-0"><%= mahasiswa.nama || '-' %></h5>
          <p class="text-muted mb-2"><%= mahasiswa.nim || '-' %></p>
          <span class="badge bg-<%= mahasiswa.statusMahasiswa === 'aktif' ? 'success' : 'secondary' %>">
            <%= mahasiswa.statusMahasiswa || 'Tidak diketahui' %>
          </span>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header">Data Diri</div>
        <div class="card-body">
          <div class="row mb-2">
            <div class="col-sm-4 text-muted">Email</div>
            <div class="col-sm-8"><%= mahasiswa.email || '-' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-sm-4 text-muted">Angkatan</div>
            <div class="col-sm-8"><%= mahasiswa.angkatan || '-' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-sm-4 text-muted">Kelas</div>
            <div class="col-sm-8"><%= mahasiswa.kelas || '-' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-sm-4 text-muted">Semester</div>
            <div class="col-sm-8"><%= mahasiswa.semester || '-' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-sm-4 text-muted">No. HP</div>
            <div class="col-sm-8"><%= mahasiswa.noHp || mahasiswa.telepon || '-' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-sm-4 text-muted">Status Magang</div>
            <div class="col-sm-8"><%= mahasiswa.statusMagang || '-' %></div>
          </div>
        </div>
      </div>

      <div class="info-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          Tagihan
          <a href="/admin/mahasiswa/<%= mahasiswa.id %>/tagihan/tambah" class="btn btn-sm btn-light">
            <i class="bi bi-plus-lg"></i> Tambah
          </a>
        </div>
        <div class="card-body">
          <% if (typeof tagihan !== 'undefined' && tagihan.semester && tagihan.semester.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th>Semester</th>
                    <th>Jumlah</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% tagihan.semester.forEach(function(t) { %>
                    <tr>
                      <td><%= t.semester || t.label || '-' %></td>
                      <td><%= t.jumlah != null ? 'Rp ' + Number(t.jumlah).toLocaleString('id-ID') : '-' %></td>
                      <td>
                        <span class="badge bg-<%= t.status === 'lunas' ? 'success' : 'warning' %>">
                          <%= t.status || 'belum bayar' %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">Belum ada data tagihan.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <a href="/admin/nilai/mahasiswa/<%= mahasiswa.id %>/tambah" class="btn btn-outline-primary">
      <i class="bi bi-bar-chart-line me-1"></i> Kelola Nilai
    </a>
    <a href="/admin/mahasiswa/<%= mahasiswa.id %>/edit" class="btn btn-outline-secondary">
      <i class="bi bi-pencil me-1"></i> Edit Data
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
