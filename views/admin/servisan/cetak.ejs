<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Laporan Servisan Alat Listrik</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    @page { size: A4 landscape; margin: 1.5cm; }
    body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 10pt; }
    .kop-surat {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 3px solid #1e3a8a;
      padding-bottom: 10px;
    }
    .logo-kop { width: 70px; margin-right: 20px; }
    .teks-kop .nama-kampus {
      font-size: 18pt;
      font-weight: 800;
      color: #1e3a8a;
      text-transform: uppercase;
    }
    .judul { text-align: center; margin-bottom: 20px; }
    .judul h3 { font-size: 14pt; font-weight: 700; text-transform: uppercase; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    th, td { border: 1px solid #cbd5e1; padding: 6px; vertical-align: top; }
    th { background: #e2e8f0; text-align: center; }
    .badge { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 8pt; font-weight: 600; }
    .badge-success { background: #22c55e; color: white; }
    .badge-danger { background: #ef4444; color: white; }
    .badge-secondary { background: #64748b; color: white; }
    .footer { margin-top: 30px; font-size: 8pt; text-align: center; border-top: 1px dashed #cbd5e1; padding-top: 8px; }
    @media print { body { margin: 0; } .no-print { display: none; } }
  </style>
</head>
<body>

<div class="kop-surat">
  <img src="/images/logo.png" alt="Logo" class="logo-kop">
  <div class="teks-kop">
    <h2 class="nama-kampus">POLITEKNIK DEWANTARA</h2>
    <p class="alamat">Program Studi Teknik Elektronika – Jl. KH. Ahmad Razak 2 No. 7, Kota Palopo</p>
  </div>
</div>

<div class="judul">
  <h3>LAPORAN MONITORING SERVISAN ALAT LISTRIK</h3>
  <p>Dicetak: <%= new Date().toLocaleString('id-ID') %></p>
</div>

<% if (data && data.length > 0) { %>
<table>
  <thead>
    <tr><th>No</th><th>No. Kupon</th><th>Tgl Servis</th><th>Pemilik</th><th>Jenis Alat</th><th>Kelompok PJ</th><th>Teknisi</th><th>Hasil</th></tr>
  </thead>
  <tbody>
    <% data.forEach((item, idx) => { 
      let jenisAlatText = '-';
      if (item.jenisAlat) {
        let alat = [];
        if (item.jenisAlat.riceCooker) alat.push('RC');
        if (item.jenisAlat.kipasAngin) alat.push('Kipas');
        if (item.jenisAlat.dispenser) alat.push('Dispenser');
        if (item.jenisAlat.mesinCuci) alat.push('Cuci');
        if (item.jenisAlat.lainnya) alat.push(item.jenisAlat.lainnya);
        jenisAlatText = alat.join(', ') || '-';
      }
    %>
    <tr>
      <td style="text-align:center"><%= idx+1 %></td>
      <td><%= item.noKupon %></td>
      <td style="text-align:center"><%= item.tanggalServis ? new Date(item.tanggalServis).toLocaleDateString('id-ID') : '-' %></td>
      <td><%= item.namaPemilik %></td>
      <td><%= jenisAlatText %></td>
      <td><%= item.kelompokPenanggungJawab || '-' %></td>
      <td><%= item.namaMahasiswa %> (<%= item.nim || '' %>)</td>
      <td style="text-align:center">
        <span class="badge <%= item.hasilPerbaikan === 'Berhasil' ? 'badge-success' : (item.hasilPerbaikan === 'Tidak berhasil' ? 'badge-danger' : 'badge-secondary') %>">
          <%= item.hasilPerbaikan || 'Belum' %>
        </span>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
<% } else { %>
  <div style="text-align: center; padding: 40px; color: #dc2626;">
    <strong>⚠️ Tidak ada data servisan yang tersedia.</strong>
  </div>
<% } %>

<div class="footer">
  <p>Laporan ini dicetak secara otomatis dari Sistem Informasi Elektronika Polidewa</p>
</div>

<div class="no-print" style="text-align:center; margin-top:20px;">
  <button onclick="window.print();" style="padding:8px 16px; background:#1e3a8a; color:white; border:none; border-radius:5px;">🖨️ Cetak PDF</button>
  <button onclick="window.close();" style="padding:8px 16px; background:#64748b; color:white; border:none; border-radius:5px;">Tutup</button>
</div>

</body>
</html>