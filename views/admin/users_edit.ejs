<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i><%= title %></h4>
    <a href="/admin/users" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="info-card">
    <div class="card-body">
      <form method="POST" action="/admin/users/edit/<%= user.id %>" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="form-label">Nama</label>
          <input type="text" name="nama" class="form-control" value="<%= user.nama || '' %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= user.email || '' %>" required>
        </div>

        <% if (role === 'mahasiswa') { %>
          <div class="mb-3">
            <label class="form-label">NIM</label>
            <input type="text" name="nim" class="form-control" value="<%= user.nim || '' %>">
          </div>
        <% } else if (role === 'dosen') { %>
          <div class="mb-3">
            <label class="form-label">NIP</label>
            <input type="text" name="nip" class="form-control" value="<%= user.nip || '' %>">
          </div>
        <% } %>

        <div class="mb-3">
          <label class="form-label">Peran</label>
          <input type="text" class="form-control" value="<%= role %>" disabled>
        </div>

        <div class="mb-3">
          <label class="form-label">Foto</label>
          <% if (user.foto) { %>
            <div class="mb-2">
              <img src="<%= user.foto %>" width="80" height="80" class="rounded-circle" style="object-fit:cover;">
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" name="hapusFoto" value="true" id="hapusFoto">
              <label class="form-check-label" for="hapusFoto">Hapus foto saat ini</label>
            </div>
          <% } %>
          <input type="file" name="foto" class="form-control" accept="image/*">
          <div class="form-text">Maks. 2MB, format gambar.</div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Simpan</button>
          <a href="/admin/users" class="btn btn-light">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
