<%- include('../partials/header') %>

<style>
  .form-card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    overflow: hidden;
    max-width: 800px;
    margin: 0 auto;
  }
  .form-header {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    padding: 1.5rem;
    color: white;
  }
  .form-header h3 { margin: 0; font-weight: 600; }
  .form-body { padding: 2rem; }
  .btn-gradient {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    border: none; color: white; font-weight: 500;
    padding: 0.6rem 2rem; border-radius: 50px; transition: all 0.3s;
  }
  .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(33,147,176,0.3); color: white; }
  .btn-outline-gradient {
    background: transparent; border: 2px solid #2193b0; color: #2193b0;
    font-weight: 500; padding: 0.6rem 2rem; border-radius: 50px; transition: all 0.3s; text-decoration: none;
  }
  .btn-outline-gradient:hover { background: linear-gradient(135deg, #2193b0, #6dd5ed); border-color: transparent; color: white; }
  .form-label { font-weight: 600; color: #1e293b; }
  .form-control, .form-select {
    border-radius: 0.75rem; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; transition: all 0.3s;
  }
  .form-control:focus, .form-select:focus {
    border-color: #2193b0; box-shadow: 0 0 0 0.2rem rgba(33,147,176,0.25);
  }
  .preview-image {
    max-width: 100px; max-height: 100px; object-fit: cover;
    border-radius: 50%; margin-bottom: 1rem; display: block;
  }
</style>

<div class="container mt-4">
  <div class="form-card">
    <div class="form-header">
      <h3><i class="bi bi-chat-quote me-2"></i><%= testimoni ? 'Edit Testimoni' : 'Tambah Testimoni' %></h3>
    </div>
    <div class="form-body">
      <form method="POST" action="<%= testimoni ? '/admin/testimoni/' + testimoni.id + '/update' : '/admin/testimoni' %>">
        <% if (testimoni && testimoni.foto) { %>
          <img src="<%= testimoni.foto %>" alt="Foto saat ini" class="preview-image" onerror="this.style.display='none'">
        <% } %>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="nama" class="form-label">Nama <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="nama" name="nama" value="<%= testimoni ? testimoni.nama : '' %>" required>
          </div>
          <div class="col-md-6 mb-3">
            <label for="tahunLulus" class="form-label">Tahun Lulus</label>
            <input type="text" class="form-control" id="tahunLulus" name="tahunLulus" value="<%= testimoni ? testimoni.tahunLulus : '' %>" placeholder="Contoh: 2022">
          </div>
        </div>
        <div class="mb-3">
          <label for="role" class="form-label">Peran / Pekerjaan Saat Ini</label>
          <input type="text" class="form-control" id="role" name="role" value="<%= testimoni ? testimoni.role : '' %>" placeholder="Contoh: Engineer di PT. Sari Roti">
        </div>
        <div class="mb-3">
          <label for="testimoniText" class="form-label">Isi Testimoni <span class="text-danger">*</span></label>
          <textarea class="form-control" id="testimoniText" name="testimoniText" rows="4" required><%= testimoni ? testimoni.testimoni : '' %></textarea>
        </div>
        <div class="mb-3">
          <label for="foto" class="form-label">URL Foto (opsional)</label>
          <input type="url" class="form-control" id="foto" name="foto" value="<%= testimoni ? testimoni.foto : '' %>" placeholder="https://i.ibb.co.com/xxx/xxx.jpg">
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="urutan" class="form-label">Urutan Tampil</label>
            <input type="number" class="form-control" id="urutan" name="urutan" min="0" value="<%= testimoni ? testimoni.urutan : urutanBerikutnya %>">
            <small class="text-muted">Angka lebih kecil tampil lebih dulu</small>
          </div>
          <div class="col-md-6 mb-3 d-flex align-items-end">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="aktif" name="aktif" <%= (!testimoni || testimoni.aktif) ? 'checked' : '' %>>
              <label class="form-check-label" for="aktif">Tampilkan di landing page</label>
            </div>
          </div>
        </div>
        <div class="d-flex justify-content-between mt-4">
          <a href="/admin/testimoni" class="btn-outline-gradient">
            <i class="bi bi-arrow-left me-2"></i>Kembali
          </a>
          <button type="submit" class="btn-gradient">
            <i class="bi bi-save me-2"></i>Simpan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
