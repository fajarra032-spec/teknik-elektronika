<%- include('../partials/header') %>

<%
  if (typeof mk === 'undefined') mk = { kode: '', nama: '', sks: '' };
  if (typeof bobot === 'undefined') bobot = {};
  if (typeof data === 'undefined') data = [];
%>

<style>
  .detail-header {
    background: linear-gradient(135deg, #2193b0, #6dd5ed); border-radius: 1.2rem; padding: 1.5rem 2rem;
    color: white; margin-bottom: 1.5rem;
  }
  .detail-header h2 { font-weight: 700; margin: 0; font-size: 1.6rem; }
  .table-responsive { border-radius: 1rem; overflow-x: auto; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
  .rubrik-table { width: 100%; border-collapse: collapse; min-width: 1200px; }
  .rubrik-table thead th {
    background: linear-gradient(135deg, #2193b0, #6dd5ed); color: white; font-weight: 600; text-transform: uppercase;
    font-size: 0.72rem; letter-spacing: 0.3px; padding: 0.7rem 0.5rem; text-align: center; position: sticky; top: 0;
  }
  .rubrik-table tbody td { vertical-align: middle; padding: 0.6rem 0.4rem; border-bottom: 1px solid #e9ecef; font-size: 0.85rem; text-align: center; }
  .rubrik-table tbody tr:nth-child(even) { background: #f8fafc; }
  .name-cell { text-align: left !important; white-space: nowrap; }
  .huruf-badge { font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 50px; font-size: 0.8rem; background: #eef2ff; }
  .lulus { color: #15803d; font-weight: 600; } .tidak-lulus { color: #b91c1c; font-weight: 600; }
  .btn-kunci { border-radius: 50px; padding: 0.25rem 0.7rem; font-size: 0.75rem; }
  .btn-kunci-semua { border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.85rem; font-weight: 600; background: #16a34a; border: none; color: white; }
  .btn-kunci-semua:hover { background: #15803d; color: white; }
  .btn-kunci-semua:disabled { background: #94a3b8; }
  .bobot-note { font-size: 0.85rem; color: #475569; background: #f1f5f9; border-radius: 0.8rem; padding: 0.8rem 1.2rem; margin-bottom: 1.2rem; }
  .badge-terkunci { background: #d1fae5; color: #065f46; font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 50px; display: inline-flex; align-items: center; gap: 0.25rem; }
  .badge-berubah { background: #fef3c7; color: #92400e; font-size: 0.68rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 50px; display: block; margin-top: 3px; }
</style>

<%
  const perluDikunci = data.filter(d => d.hasil.nilaiAkhir !== null && (!d.kunci.terkunci || d.kunci.berbeda)).length;
%>

<div class="container-fluid mt-4">
  <div class="detail-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h2><i class="bi bi-clipboard-data me-2"></i><%= mk.kode %> - <%= mk.nama %></h2>
    <div class="d-flex gap-2">
      <button type="button" class="btn-kunci-semua" id="btnKunciSemua"
              onclick="kunciSemua()" <%= perluDikunci === 0 ? 'disabled' : '' %>>
        <i class="bi bi-lock-fill"></i> Kunci Semua ke Transkrip (<%= perluDikunci %> perlu dikunci/diperbarui)
      </button>
      <a href="/admin/rubrik/<%= mk.id %>/cetak?periode=<%= encodeURIComponent(periode) %>" target="_blank" class="btn btn-light btn-sm">
        <i class="bi bi-printer"></i> Cetak
      </a>
      <a href="/admin/rubrik" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <% if (typeof mkDuplikat !== 'undefined' && mkDuplikat.length > 0) { %>
    <div class="alert alert-danger" style="border-radius: 0.8rem;">
      <i class="bi bi-exclamation-triangle-fill me-1"></i>
      <strong>Ditemukan kemungkinan penyebab nilai tidak tersimpan!</strong>
      Ada <strong><%= mkDuplikat.length %></strong> data Mata Kuliah lain dengan kode sama
      persis (<strong><%= mk.kode %></strong>) tapi ID Firestore berbeda:
      <ul class="mb-0 mt-2">
        <% mkDuplikat.forEach(m => { %>
          <li><code><%= m.id %></code> - <%= m.nama || '(tanpa nama)' %>
            <a href="/admin/rubrik/<%= m.id %>?periode=<%= encodeURIComponent(periode) %>" target="_blank">buka rubrik MK ini</a>
          </li>
        <% }) %>
      </ul>
      <div class="mt-2">Perlu digabungkan/dibersihkan langsung di data MK (Firestore).</div>
    </div>
  <% } %>

  <div class="d-flex align-items-center gap-2 mb-3">
    <label for="periodeSelect" class="mb-0 small text-muted">Periode:</label>
    <select id="periodeSelect" class="form-select form-select-sm" style="width: auto;"
      onchange="window.location.href = '/admin/rubrik/<%= mk.id %>?periode=' + encodeURIComponent(this.value)">
      <option value="<%= periode %>" selected><%= periode %> (sedang dibuka)</option>
      <% if (typeof periodeLain !== 'undefined') { %>
        <% periodeLain.forEach(p => { %>
          <option value="<%= p %>"><%= p %></option>
        <% }) %>
      <% } %>
    </select>
  </div>

  <% if (typeof periodeLain !== 'undefined' && periodeLain.length > 0) { %>
    <div class="alert alert-warning" style="border-radius: 0.8rem;">
      <i class="bi bi-calendar-x me-1"></i>
      Ada tugas untuk MK ini yang tercatat di periode lain: <strong><%= periodeLain.join(', ') %></strong>
      - bukan di periode <strong><%= periode %></strong> yang sedang dibuka.
    </div>
  <% } %>

  <% if (typeof jumlahNilaiTugasTanpaTugas !== 'undefined' && jumlahNilaiTugasTanpaTugas > 0) { %>
    <div class="alert alert-warning" style="border-radius: 0.8rem;">
      <i class="bi bi-exclamation-triangle-fill me-1"></i>
      Ditemukan <strong><%= jumlahNilaiTugasTanpaTugas %></strong> nilai tugas tersimpan untuk MK
      ini yang dokumen tugasnya sudah tidak ada - tidak akan pernah muncul di Rata Tugas
      sampai ditangani manual di database.
    </div>
  <% } %>

  <div class="bobot-note">
    <strong>Dosen Pengampu:</strong> <%= mk.namaDosen || '-' %> &nbsp;|&nbsp;
    <strong>Periode:</strong> <%= periode %> &nbsp;|&nbsp;
    <strong>Bobot:</strong> Kehadiran <%= bobot.kehadiran %>% (%Hadir <%= bobot.persenHadir %>%, Sikap <%= bobot.sikap %>%, Keaktifan <%= bobot.keaktifan %>%),
    Tugas <%= bobot.tugas %>%, Kuis <%= bobot.kuis %>%, UTS <%= bobot.uts %>%, UAS <%= bobot.uas %>%
  </div>

  <%
    const pakaiSikap = (bobot.sikap || 0) > 0;
    const pakaiKeaktifan = (bobot.keaktifan || 0) > 0;
    const pakaiKuis = (bobot.kuis || 0) > 0;
    const kehadiranColspan = 1 + (pakaiSikap ? 1 : 0) + (pakaiKeaktifan ? 1 : 0);
    const totalKolom = 3 + kehadiranColspan + 1 + (pakaiKuis ? 1 : 0) + 2 + 4;
  %>

  <div class="table-responsive">
    <table class="rubrik-table">
      <thead>
        <tr>
          <th rowspan="2">No</th>
          <th rowspan="2">NIM</th>
          <th rowspan="2">Nama Mahasiswa</th>
          <th colspan="<%= kehadiranColspan %>">Kehadiran<% if (pakaiSikap || pakaiKeaktifan) { %>, Sikap &amp; Keaktifan<% } %></th>
          <th rowspan="2">Tugas</th>
          <% if (pakaiKuis) { %><th rowspan="2">Kuis</th><% } %>
          <th rowspan="2">UTS</th>
          <th rowspan="2">UAS</th>
          <th rowspan="2">Nilai<br>Akhir</th>
          <th rowspan="2">Huruf</th>
          <th rowspan="2">Ket.</th>
          <th rowspan="2">Aksi</th>
        </tr>
        <tr>
          <th>% Hadir</th>
          <% if (pakaiSikap) { %><th>Sikap</th><% } %>
          <% if (pakaiKeaktifan) { %><th>Keaktifan</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% if (data.length === 0) { %>
          <tr><td colspan="<%= totalKolom %>" class="text-center py-5 text-muted">Belum ada mahasiswa aktif di MK ini.</td></tr>
        <% } %>
        <% data.forEach((item, idx) => { const h = item.hasil; const mid = item.mahasiswa.id; %>
          <tr>
            <td><%= idx + 1 %></td>
            <td><%= item.mahasiswa.nim %></td>
            <td class="name-cell"><%= item.mahasiswa.nama %></td>
            <td><%= h.persenHadir !== null ? h.persenHadir.toFixed(1) : '-' %></td>
            <% if (pakaiSikap) { %><td><%= h.sikap ?? '-' %></td><% } %>
            <% if (pakaiKeaktifan) { %><td><%= h.keaktifan ?? '-' %></td><% } %>
            <td><%= h.rataTugas !== null ? h.rataTugas.toFixed(2) : '-' %></td>
            <% if (pakaiKuis) { %><td><%= h.kuis ?? '-' %></td><% } %>
            <td><%= h.uts ?? '-' %></td>
            <td><%= h.uas ?? '-' %></td>
            <td>
              <strong><%= h.nilaiAkhir !== null ? h.nilaiAkhir.toFixed(2) : '-' %></strong>
              <% if (h.nilaiAkhir === null && h.belumLengkap && h.belumLengkap.length > 0) { %>
                <div class="text-muted" style="font-size:0.68rem;">Belum: <%= h.belumLengkap.join(', ') %></div>
              <% } %>
            </td>
            <td><span class="huruf-badge"><%= h.huruf || '-' %></span></td>
            <td class="<%= h.keterangan === 'LULUS' ? 'lulus' : (h.keterangan === 'TIDAK LULUS' ? 'tidak-lulus' : '') %>">
              <%= h.keterangan || '-' %>
            </td>
            <td>
              <% if (h.nilaiAkhir !== null) { %>
                <% if (item.kunci.terkunci && !item.kunci.berbeda) { %>
                  <span class="badge-terkunci"><i class="bi bi-lock-fill"></i> Terkunci</span>
                <% } else if (item.kunci.terkunci && item.kunci.berbeda) { %>
                  <button class="btn btn-sm btn-warning btn-kunci" onclick="kunciNilai('<%= mid %>', this)">
                    <i class="bi bi-arrow-repeat"></i> Kunci Ulang
                  </button>
                  <span class="badge-berubah" title="Nilai di KHS masih <%= item.kunci.nilaiTerkunci %>, beda dari nilai rubrik saat ini">
                    <i class="bi bi-exclamation-triangle"></i> Nilai berubah sejak dikunci
                  </span>
                <% } else { %>
                  <button class="btn btn-sm btn-success btn-kunci" onclick="kunciNilai('<%= mid %>', this)">
                    <i class="bi bi-lock"></i> Kunci ke Transkrip
                  </button>
                <% } %>
              <% } else if (item.kunci.terkunci) { %>
                <span class="badge-berubah"><i class="bi bi-exclamation-triangle"></i> Rubrik belum lengkap, tapi KHS masih <%= item.kunci.nilaiTerkunci %> (lama)</span>
              <% } else { %>
                <span class="text-muted small">Belum lengkap</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
async function kunciNilai(mahasiswaId, btn) {
  if (!confirm('Kunci nilai akhir mahasiswa ini ke transkrip resmi (koleksi grades)? Nilai yang sudah dikunci akan menimpa nilai sebelumnya untuk MK & periode ini.')) return;
  btn.disabled = true;
  try {
    const body = new URLSearchParams({ periode: '<%= periode %>' });
    const res = await fetch('/admin/rubrik/<%= mk.id %>/kunci/' + mahasiswaId, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body
    });
    const json = await res.json();
    if (json.success) {
      window.location.reload();
    } else {
      alert('Gagal: ' + json.message);
      btn.disabled = false;
    }
  } catch (err) {
    alert('Gagal mengunci nilai: ' + err.message);
    btn.disabled = false;
  }
}

async function kunciSemua() {
  const jumlah = <%= perluDikunci %>;
  if (!confirm('Kunci SEMUA (' + jumlah + ') nilai akhir yang sudah lengkap di MK ini ke transkrip resmi (koleksi grades) sekaligus? Ini langsung tersinkron ke KHS mahasiswa. Nilai yang sudah pernah dikunci sebelumnya akan diperbarui, bukan diduplikasi.')) return;

  const btn = document.getElementById('btnKunciSemua');
  btn.disabled = true;
  const teksAsli = btn.innerHTML;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Memproses...';

  try {
    const body = new URLSearchParams({ periode: '<%= periode %>' });
    const res = await fetch('/admin/rubrik/<%= mk.id %>/kunci-semua', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body
    });
    const json = await res.json();
    if (json.success) {
      alert(json.pesan);
      // Reload halaman supaya semua badge status (Terkunci / Berubah / dst)
      // benar-benar mencerminkan data terbaru dari server, bukan ditebak di JS.
      window.location.reload();
    } else {
      alert('Gagal: ' + json.message);
      btn.innerHTML = teksAsli;
      btn.disabled = false;
    }
  } catch (err) {
    alert('Gagal mengunci nilai sekelas: ' + err.message);
    btn.innerHTML = teksAsli;
    btn.disabled = false;
  }
}
</script>

<%- include('../partials/footer') %>
