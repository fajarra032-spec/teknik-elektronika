<%- include('../partials/header') %>

<div class="container mt-4" style="max-width: 720px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2"></i><%= title %></h4>
    <a href="/admin/khs/list" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="info-card">
    <div class="card-body">
      <div class="row mb-2">
        <div class="col-sm-4 text-muted">Mahasiswa</div>
        <div class="col-sm-8"><%= mahasiswa.nama || '-' %> (<%= mahasiswa.nim || '-' %>)</div>
      </div>
      <div class="row mb-2">
        <div class="col-sm-4 text-muted">Semester</div>
        <div class="col-sm-8"><%= khs.semester || '-' %></div>
      </div>
      <div class="row mb-2">
        <div class="col-sm-4 text-muted">Indeks Prestasi (IP)</div>
        <div class="col-sm-8"><%= khs.ip != null ? khs.ip : '-' %></div>
      </div>
      <div class="row mb-2">
        <div class="col-sm-4 text-muted">Nama File</div>
        <div class="col-sm-8"><%= khs.fileName || '-' %></div>
      </div>
      <div class="row mb-3">
        <div class="col-sm-4 text-muted">Diunggah</div>
        <div class="col-sm-8"><%= khs.createdAt ? new Date(khs.createdAt).toLocaleString('id-ID') : '-' %></div>
      </div>

      <% if (khs.fileUrl) { %>
        <a href="<%= khs.fileUrl %>" target="_blank" class="btn btn-primary">
          <i class="bi bi-box-arrow-up-right me-1"></i> Buka File KHS
        </a>
      <% } else { %>
        <p class="text-muted mb-0">File tidak tersedia.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
