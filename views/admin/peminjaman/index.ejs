<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  const tabs = [['perlu', 'Perlu tindakan', hitung.perlu, true], ['diajukan', 'Pengajuan baru', hitung.diajukan, false], ['dipinjam', 'Sedang dipinjam', hitung.dipinjam, false], ['terlambat', 'Terlambat', hitung.terlambat, true], ['dikembalikan', 'Selesai', hitung.dikembalikan, false], ['semua', 'Semua', hitung.semua, false]];
  const tgl = (s) => s ? new Date(s).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
%>
<div class="container mt-4 mb-5">
  <div class="lab-hero">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div><h2>Peminjaman Alat Lab</h2><p class="lab-sub">Verifikasi pengajuan peminjaman dan pengembalian alat oleh mahasiswa.</p></div>
      <a href="/admin/alat-lab" class="btn btn-light btn-sm rounded-pill px-3"><i class="bi bi-motherboard me-1"></i> Inventaris alat</a>
    </div>
  </div>

  <%- include('../../partials/pesan_flash') %>

  <nav class="lab-tabs" aria-label="Filter status">
    <% tabs.forEach(t => { %>
      <a class="lab-tab <%= filter === t[0] ? 'active' : '' %>" href="/admin/peminjaman-alat?status=<%= t[0] %>"><%= t[1] %> <span class="n <%= (t[3] && t[2] > 0 && filter !== t[0]) ? 'alert' : '' %>"><%= t[2] %></span></a>
    <% }) %>
  </nav>

  <div class="lab-table-wrap"><div class="table-responsive">
    <table class="lab-table">
      <thead><tr><th>Kode</th><th>Peminjam</th><th>Alat</th><th>Pinjam</th><th>Rencana kembali</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% data.forEach(p => { const perlu = (p.status === 'diajukan' || p.status === 'menunggu_verifikasi_kembali'); %>
        <tr>
          <td><span class="lab-code"><%= p.kode %></span><div class="small text-muted mt-1"><%= tgl(p.createdAt) %></div></td>
          <td><div class="fw-semibold"><%= p.namaMahasiswa %></div><div class="small text-muted"><%= p.nim %></div></td>
          <td class="small">
            <% p.items.slice(0, 3).forEach(it => { %><div><%= it.nama %> <span class="text-muted">×<%= it.jumlah %></span></div><% }) %>
            <% if (p.items.length > 3) { %><div class="text-muted">+<%= p.items.length - 3 %> lainnya</div><% } %>
          </td>
          <td class="small"><%= tgl(p.tanggalPinjam) %></td>
          <td class="small <%= p.terlambat ? 'text-danger fw-semibold' : '' %>"><%= tgl(p.tanggalRencanaKembali) %></td>
          <td><%- include('../../partials/peminjaman_status', { status: p.status, terlambat: p.terlambat }) %></td>
          <td><a href="/admin/peminjaman-alat/<%= p.id %>" class="btn btn-sm rounded-pill px-3 btn-<%= perlu ? 'primary' : 'outline-primary' %>"><%= perlu ? 'Verifikasi' : 'Detail' %></a></td>
        </tr>
        <% }) %>
        <% if (data.length === 0) { %><tr><td colspan="7"><div class="lab-empty"><i class="bi bi-inbox"></i>Tidak ada data pada kategori ini.</div></td></tr><% } %>
      </tbody>
    </table>
  </div></div>
</div>
<%- include('../../partials/footer') %>
