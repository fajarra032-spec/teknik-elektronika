<%- include('../partials/header') %>

<style>
  .form-card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    overflow: hidden;
    max-width: 800px;
    margin: 0 auto;
  }
  .form-header {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    padding: 1.5rem;
    color: white;
  }
  .form-header h3 {
    margin: 0;
    font-weight: 600;
  }
  .form-body {
    padding: 2rem;
  }
  .btn-gradient {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    border: none;
    color: white;
    font-weight: 500;
    padding: 0.6rem 2rem;
    border-radius: 50px;
    transition: all 0.3s;
  }
  .btn-gradient:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(33,147,176,0.3);
    color: white;
  }
  .btn-outline-gradient {
    background: transparent;
    border: 2px solid #2193b0;
    color: #2193b0;
    font-weight: 500;
    padding: 0.6rem 2rem;
    border-radius: 50px;
    transition: all 0.3s;
  }
  .btn-outline-gradient:hover {
    background: linear-gradient(135deg, #2193b0, #6dd5ed);
    border-color: transparent;
    color: white;
  }
  .form-label {
    font-weight: 600;
    color: #1e293b;
  }
  .form-control, .form-select {
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid #cbd5e1;
    transition: all 0.3s;
  }
  .form-control:focus, .form-select:focus {
    border-color: #2193b0;
    box-shadow: 0 0 0 0.2rem rgba(33,147,176,0.25);
  }
  .avatar-preview {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #2193b0;
    margin-bottom: 1rem;
  }
</style>

<div class="container mt-4">
  <div class="form-card">
    <div class="form-header">
      <h3><i class="bi bi-person-lines-fill me-2"></i><%= mahasiswa ? 'Edit Mahasiswa' : 'Tambah Mahasiswa' %></h3>
    </div>
    <div class="form-body">
      <form method="POST" action="<%= mahasiswa ? '/admin/mahasiswa/' + mahasiswa.id + '/update' : '/admin/mahasiswa' %>" enctype="multipart/form-data">
        <% if (mahasiswa && mahasiswa.foto) { %>
          <div class="text-center mb-3">
            <img src="<%= mahasiswa.foto %>" alt="foto" class="avatar-preview">
          </div>
        <% } %>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="nim" class="form-label">NIM <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="nim" name="nim" value="<%= mahasiswa ? mahasiswa.nim : '' %>" required>
            <small class="text-muted">2 digit pertama = angkatan</small>
          </div>
          <div class="col-md-6 mb-3">
            <label for="nama" class="form-label">Nama Lengkap <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="nama" name="nama" value="<%= mahasiswa ? mahasiswa.nama : '' %>" required>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="email" name="email" value="<%= mahasiswa ? mahasiswa.email : '' %>" required>
          </div>
          <div class="col-md-6 mb-3">
            <label for="noHp" class="form-label">Nomor HP</label>
            <input type="text" class="form-control" id="noHp" name="noHp" value="<%= mahasiswa ? mahasiswa.noHp : '' %>">
          </div>
        </div>

        <% if (!mahasiswa) { %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="password" name="password" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="confirmPassword" class="form-label">Konfirmasi Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
            </div>
          </div>
        <% } %>

        <!-- Tiga Status Terpisah -->
        <% if (mahasiswa) { %>
        <div class="alert alert-info small mb-3">
          <i class="bi bi-info-circle"></i> Kalau <strong>Semester</strong> atau <strong>Status Mahasiswa</strong> diubah dan hasilnya "Aktif", paket KRS semester tersebut akan <strong>otomatis diaktifkan</strong> (lihat <code>helpers/paketKurikulumHelper.js</code>). Mulai Semester 3, isi <strong>Konsentrasi</strong> dulu supaya paket yang benar bisa ditentukan. Untuk Semester 1, mata kuliah <strong>Pendidikan Agama</strong> otomatis dipilih sesuai field <strong>Agama</strong> di bawah.
        </div>
        <% } %>
        <div class="row">
          <div class="col-md-3 mb-3">
            <label for="kelas" class="form-label">Kelas <span class="text-muted small">(rombel, mis. ELK1A)</span></label>
            <input type="text" class="form-control" id="kelas" name="kelas" placeholder="mis. ELK1A"
                   value="<%= mahasiswa && mahasiswa.kelas ? mahasiswa.kelas : '' %>" style="text-transform:uppercase;">
          </div>
          <div class="col-md-3 mb-3">
            <label for="konsentrasi" class="form-label">Konsentrasi <span class="text-muted small">(mulai smt 3)</span></label>
            <select class="form-select" id="konsentrasi" name="konsentrasi">
              <option value="">- Belum ditentukan -</option>
              <% (typeof konsentrasiOptions !== 'undefined' ? konsentrasiOptions : []).forEach(k => { %>
                <option value="<%= k %>" <%= mahasiswa && mahasiswa.konsentrasi === k ? 'selected' : '' %>><%= k %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3 mb-3">
            <label for="semester" class="form-label">Semester (1-12)</label>
            <select class="form-select" id="semester" name="semester">
              <option value="">Pilih Semester</option>
              <% for(let i=1; i<=12; i++) { %>
                <option value="Semester <%= i %>" <%= mahasiswa && mahasiswa.semester === ('Semester '+i) ? 'selected' : '' %>>Semester <%= i %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-3 mb-3">
            <label for="statusMagang" class="form-label">Status Magang</label>
            <select class="form-select" id="statusMagang" name="statusMagang">
              <option value="">Pilih Status Magang</option>
              <option value="Magang 1" <%= mahasiswa && mahasiswa.statusMagang === 'Magang 1' ? 'selected' : '' %>>Magang 1</option>
              <option value="Magang 2" <%= mahasiswa && mahasiswa.statusMagang === 'Magang 2' ? 'selected' : '' %>>Magang 2</option>
              <option value="Magang 3" <%= mahasiswa && mahasiswa.statusMagang === 'Magang 3' ? 'selected' : '' %>>Magang 3</option>
              <option value="Selesai Magang" <%= mahasiswa && mahasiswa.statusMagang === 'Selesai Magang' ? 'selected' : '' %>>Selesai Magang</option>
            </select>
          </div>
          <div class="col-md-3 mb-3">
            <label for="statusMahasiswa" class="form-label">Status Mahasiswa</label>
            <select class="form-select" id="statusMahasiswa" name="statusMahasiswa">
              <option value="">Pilih Status</option>
              <option value="Aktif" <%= mahasiswa && mahasiswa.statusMahasiswa === 'Aktif' ? 'selected' : '' %>>Aktif</option>
              <option value="Lulus" <%= mahasiswa && mahasiswa.statusMahasiswa === 'Lulus' ? 'selected' : '' %>>Lulus</option>
              <option value="Cuti" <%= mahasiswa && mahasiswa.statusMahasiswa === 'Cuti' ? 'selected' : '' %>>Cuti</option>
              <option value="Keluar" <%= mahasiswa && mahasiswa.statusMahasiswa === 'Keluar' ? 'selected' : '' %>>Keluar</option>
            </select>
          </div>
          <div class="col-md-3 mb-3">
            <label for="agama" class="form-label">Agama</label>
            <select class="form-select" id="agama" name="agama">
              <% const agamaTerpilih = mahasiswa && mahasiswa.agama ? mahasiswa.agama : (typeof defaultAgama !== 'undefined' ? defaultAgama : 'Islam'); %>
              <% (typeof agamaOptions !== 'undefined' ? agamaOptions : []).forEach(a => { %>
                <option value="<%= a %>" <%= agamaTerpilih === a ? 'selected' : '' %>><%= a %></option>
              <% }) %>
            </select>
            <small class="text-muted">Menentukan mata kuliah Pendidikan Agama semester 1 otomatis</small>
          </div>
          <div class="col-md-3 mb-3">
            <label for="dosenPaId" class="form-label">Dosen PA (Pembimbing Akademik)</label>
            <select class="form-select" id="dosenPaId" name="dosenPaId">
              <option value="">- Belum ditentukan -</option>
              <% (typeof dosenPaList !== 'undefined' ? dosenPaList : []).forEach(d => { %>
                <option value="<%= d.id %>" <%= mahasiswa && mahasiswa.dosenPaId === d.id ? 'selected' : '' %>><%= d.nama %><%= d.nidn ? ' (NIDN ' + d.nidn + ')' : '' %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="foto" class="form-label">Foto Profil</label>
            <input type="file" class="form-control" id="foto" name="foto" accept="image/*">
            <small class="text-muted">Kosongkan jika tidak ingin mengubah foto</small>
          </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
          <a href="/admin/mahasiswa" class="btn-outline-gradient">
            <i class="bi bi-arrow-left me-2"></i>Kembali
          </a>
          <button type="submit" class="btn-gradient">
            <i class="bi bi-save me-2"></i>Simpan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<% if (!mahasiswa) { %>
<script>
  document.querySelector('form').addEventListener('submit', function(e) {
    const password = document.getElementById('password').value;
    const confirm = document.getElementById('confirmPassword').value;
    if (password !== confirm) {
      e.preventDefault();
      alert('Password dan konfirmasi tidak sama!');
    }
  });
</script>
<% } %>

<%- include('../partials/footer') %>