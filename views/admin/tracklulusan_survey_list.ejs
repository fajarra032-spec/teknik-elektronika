<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-clipboard-check me-2"></i><%= title %></h4>
    <a href="/admin/tracklulusan" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali ke Track Lulusan
    </a>
  </div>

  <p class="text-muted">
    Ini adalah isian tracer study yang diisi mandiri oleh mahasiswa/lulusan lewat akun mereka.
    Nyalakan "Tampil Publik" untuk memunculkan data ini di halaman publik <code>/lulusan</code>.
  </p>

  <div class="mb-3">
    <a href="/admin/tracklulusan/survey" class="btn btn-sm <%= filterStatus === '' ? 'btn-primary' : 'btn-outline-primary' %>">Semua</a>
    <a href="/admin/tracklulusan/survey?status=pending" class="btn btn-sm <%= filterStatus === 'pending' ? 'btn-primary' : 'btn-outline-primary' %>">Menunggu Tinjauan</a>
    <a href="/admin/tracklulusan/survey?status=public" class="btn btn-sm <%= filterStatus === 'public' ? 'btn-primary' : 'btn-outline-primary' %>">Sudah Publik</a>
  </div>

  <div class="info-card">
    <div class="card-body">
      <% if (survei.length === 0) { %>
        <p class="text-muted mb-0 text-center py-4">Belum ada isian survei.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Nama</th>
                <th>NIM</th>
                <th>Tahun Lulus</th>
                <th>Status Pekerjaan</th>
                <th>Tempat Kerja</th>
                <th>Tampil Publik</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% survei.forEach(function(s) { %>
                <tr>
                  <td><%= s.nama || '-' %></td>
                  <td><%= s.nim || '-' %></td>
                  <td><%= s.tahunLulus || '-' %></td>
                  <td><span class="badge bg-info-subtle text-info-emphasis"><%= s.statusPekerjaan || '-' %></span></td>
                  <td><%= s.namaPerusahaan || s.tempatKerja || '-' %></td>
                  <td>
                    <span class="badge bg-<%= s.isPublic ? 'success' : 'warning' %>">
                      <%= s.isPublic ? 'Publik' : 'Menunggu' %>
                    </span>
                  </td>
                  <td>
                    <form method="POST" action="/admin/tracklulusan/survey/<%= s.id %>/toggle">
                      <button type="submit" class="btn btn-sm <%= s.isPublic ? 'btn-outline-danger' : 'btn-outline-success' %>">
                        <%= s.isPublic ? 'Sembunyikan' : 'Tampilkan' %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
