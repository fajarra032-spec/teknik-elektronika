<%- include('../../partials/header') %>

<div class="container-fluid" style="max-width:1200px;margin:1.5rem auto;">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-clock-history me-2"></i>Riwayat Pengiriman WhatsApp</h2>
      <div class="text-muted small">100 pengiriman terakhir dari dashboard (siapa, ke mana, kapan, status)</div>
    </div>
    <a href="/admin/whatsapp" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Kembali ke Inbox</a>
  </div>

  <% var waTab = 'riwayat'; %>
  <%- include('_tabs', { waTab: waTab }) %>

  <% if (error) { %><div class="alert alert-warning"><%= error %></div><% } %>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr><th>Waktu</th><th>Admin</th><th>Ke</th><th>Pesan</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% if (!logs.length) { %>
            <tr><td colspan="5" class="text-center text-muted py-4">Belum ada riwayat.</td></tr>
          <% } %>
          <% logs.forEach(function(l) { %>
            <tr>
              <td class="text-nowrap small"><%= new Date(l.createdAt).toLocaleString('id-ID', {dateStyle:'short', timeStyle:'short'}) %></td>
              <td><%= l.adminNama %></td>
              <td class="text-nowrap">+<%= l.to %></td>
              <td style="max-width:420px" class="text-truncate" title="<%= l.textPreview %>"><%= l.textPreview %></td>
              <td>
                <% if (l.status === 'terkirim') { %><span class="badge text-bg-success">Terkirim</span>
                <% } else if (l.status === 'gagal') { %><span class="badge text-bg-danger" title="<%= l.error || '' %>">Gagal</span>
                <% } else { %><span class="badge text-bg-secondary" title="<%= l.error || '' %>">Ditolak</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
