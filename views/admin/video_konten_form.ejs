<%- include('../partials/header') %>

<style>
  .form-card {
    border: none; border-radius: 1rem; box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    overflow: hidden; max-width: 800px; margin: 0 auto;
  }
  .form-header { background: linear-gradient(135deg, #2193b0, #6dd5ed); padding: 1.5rem; color: white; }
  .form-header h3 { margin: 0; font-weight: 600; }
  .form-body { padding: 2rem; }
  .btn-gradient {
    background: linear-gradient(135deg, #2193b0, #6dd5ed); border: none; color: white;
    font-weight: 500; padding: 0.6rem 2rem; border-radius: 50px; transition: all 0.3s;
  }
  .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(33,147,176,0.3); color: white; }
  .btn-outline-gradient {
    background: transparent; border: 2px solid #2193b0; color: #2193b0; font-weight: 500;
    padding: 0.6rem 2rem; border-radius: 50px; transition: all 0.3s; text-decoration: none;
  }
  .btn-outline-gradient:hover { background: linear-gradient(135deg, #2193b0, #6dd5ed); border-color: transparent; color: white; }
  .form-label { font-weight: 600; color: #1e293b; }
  .form-control { border-radius: 0.75rem; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; transition: all 0.3s; }
  .form-control:focus { border-color: #2193b0; box-shadow: 0 0 0 0.2rem rgba(33,147,176,0.25); }
  .preview-video { max-width: 100%; border-radius: 0.75rem; margin-bottom: 1rem; background: #000; }
</style>

<div class="container mt-4">
  <div class="form-card">
    <div class="form-header">
      <h3><i class="bi bi-camera-reels me-2"></i><%= video ? 'Edit Video' : 'Tambah Video' %></h3>
    </div>
    <div class="form-body">
      <form method="POST" action="<%= video ? '/admin/video-konten/' + video.id + '/update' : '/admin/video-konten' %>">
        <% if (video && video.videoUrl) { %>
          <video src="<%= video.videoUrl %>" class="preview-video" controls preload="metadata"></video>
        <% } %>
        <div class="mb-3">
          <label for="judul" class="form-label">Judul <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="judul" name="judul" value="<%= video ? video.judul : '' %>" required placeholder="Contoh: Testimoni Mahasiswa Elektronika">
        </div>
        <div class="mb-3">
          <label for="deskripsi" class="form-label">Deskripsi</label>
          <input type="text" class="form-control" id="deskripsi" name="deskripsi" value="<%= video ? video.deskripsi : '' %>" placeholder="Contoh: Ibnu Muarif Mahasiswa ELK-2023 bekerja di PT.GNI">
        </div>
        <div class="mb-3">
          <label for="videoUrl" class="form-label">URL / Path Video <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="videoUrl" name="videoUrl" value="<%= video ? video.videoUrl : '' %>" required placeholder="/videos/video1.mp4 atau https://...">
          <small class="text-muted">Bisa path file lokal di folder public/videos, atau URL video langsung (mp4)</small>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="urutan" class="form-label">Urutan Tampil</label>
            <input type="number" class="form-control" id="urutan" name="urutan" min="0" value="<%= video ? video.urutan : urutanBerikutnya %>">
            <small class="text-muted">Angka lebih kecil tampil lebih dulu</small>
          </div>
          <div class="col-md-6 mb-3 d-flex align-items-end">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="aktif" name="aktif" <%= (!video || video.aktif) ? 'checked' : '' %>>
              <label class="form-check-label" for="aktif">Tampilkan di landing page</label>
            </div>
          </div>
        </div>
        <div class="d-flex justify-content-between mt-4">
          <a href="/admin/video-konten" class="btn-outline-gradient">
            <i class="bi bi-arrow-left me-2"></i>Kembali
          </a>
          <button type="submit" class="btn-gradient">
            <i class="bi bi-save me-2"></i>Simpan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
