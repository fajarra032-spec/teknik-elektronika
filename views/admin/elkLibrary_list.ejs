<%- include('../partials/header') %>

<%
  const JENIS = [
    { key: 'laporan',    label: 'Laporan magang', icon: 'bi-file-earmark-pdf' },
    { key: 'artikel',    label: 'Artikel dosen',  icon: 'bi-file-text' },
    { key: 'penelitian', label: 'Penelitian',     icon: 'bi-mortarboard' },
    { key: 'pengabdian', label: 'Pengabdian',     icon: 'bi-people' },
    { key: 'buku',       label: 'Buku',           icon: 'bi-book' }
  ];
  const jenisMap = {}; JENIS.forEach(j => { jenisMap[j.key] = j; });
  const STATUS = [
    { key: 'all',      label: 'Semua' },
    { key: 'pending',  label: 'Menunggu' },
    { key: 'approved', label: 'Disetujui' },
    { key: 'rejected', label: 'Ditolak' }
  ];
  const statusLabel = { pending: 'Menunggu', approved: 'Disetujui', rejected: 'Ditolak' };
  const fmtTgl = v => {
    if (!v) return '-';
    const d = new Date(v);
    return isNaN(d) ? '-' : d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  };
  const href = (t, s) => '/admin/elk-library?type=' + t + '&status=' + s;
  const menunggu = counts.all.pending;
%>

<style>
  .ea {
    --ea-ink: #1b2a4a;
    --ea-muted: #5d6b85;
    --ea-line: #e2e7ef;
    --ea-surface: #ffffff;
    --ea-accent: #1e3a8a;
    --ea-accent-soft: #e8eefc;
    --ea-hover: #f6f8fd;
    color: var(--ea-ink);
    font-feature-settings: "tnum" 1;
  }
  .ea a { text-decoration: none; }
  .ea :focus-visible { outline: 2px solid var(--ea-accent); outline-offset: 2px; border-radius: 6px; }

  /* Judul halaman */
  .ea-head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; justify-content: space-between; margin-bottom: 1.25rem; }
  .ea-head h1 { font-size: 1.65rem; font-weight: 700; letter-spacing: -0.015em; margin: 0 0 0.25rem; }
  .ea-head p { margin: 0; color: var(--ea-muted); font-size: 0.95rem; }

  .ea-btn { display: inline-flex; align-items: center; gap: 0.4rem; border: 1px solid transparent; border-radius: 8px; padding: 0.45rem 0.9rem; font-size: 0.875rem; font-weight: 600; line-height: 1.3; cursor: pointer; background: none; transition: background-color .15s, border-color .15s, color .15s; }
  .ea-btn-primary { background: var(--ea-accent); color: #fff; }
  .ea-btn-primary:hover { background: #172f73; color: #fff; }
  .ea-btn-ok { background: #1d7a46; color: #fff; padding: 0.3rem 0.7rem; font-size: 0.8rem; }
  .ea-btn-ok:hover { background: #165f37; }
  .ea-btn-no { border-color: #e7b4b8; color: #a12a35; padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #fff; }
  .ea-btn-no:hover { background: #fbe3e4; }
  .ea-btn-icon { border-color: var(--ea-line); color: var(--ea-muted); padding: 0.3rem 0.55rem; background: #fff; }
  .ea-btn-icon:hover { background: var(--ea-hover); color: var(--ea-ink); }

  /* Antrian verifikasi */
  .ea-queue { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; background: #fff8e8; border: 1px solid #f0dcaa; border-left: 4px solid #d99a14; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; }
  .ea-queue strong { font-weight: 700; }
  .ea-queue span { color: #6f5200; font-size: 0.95rem; }
  .ea-queue a { color: #6f5200; font-weight: 600; font-size: 0.9rem; border-bottom: 1px solid currentColor; }

  /* Tab jenis */
  .ea-tabs { display: flex; gap: 0.25rem; overflow-x: auto; border-bottom: 1px solid var(--ea-line); margin-bottom: 1rem; scrollbar-width: thin; }
  .ea-tab { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.65rem 0.9rem; color: var(--ea-muted); font-weight: 600; font-size: 0.9rem; white-space: nowrap; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .ea-tab:hover { color: var(--ea-ink); }
  .ea-tab.is-active { color: var(--ea-accent); border-bottom-color: var(--ea-accent); }
  .ea-count { font-size: 0.75rem; font-weight: 600; background: #eef1f6; color: var(--ea-muted); border-radius: 999px; padding: 0.05rem 0.5rem; }
  .ea-tab.is-active .ea-count { background: var(--ea-accent-soft); color: var(--ea-accent); }

  /* Toolbar */
  .ea-toolbar { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; }
  .ea-search { position: relative; flex: 1 1 260px; max-width: 420px; }
  .ea-search i { position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%); color: var(--ea-muted); pointer-events: none; }
  .ea-search input { width: 100%; border: 1px solid var(--ea-line); border-radius: 8px; padding: 0.5rem 0.8rem 0.5rem 2.2rem; font-size: 0.9rem; background: #fff; color: var(--ea-ink); }
  .ea-search input:focus { outline: 2px solid var(--ea-accent); outline-offset: 0; border-color: transparent; }
  .ea-seg { display: inline-flex; background: #eef1f6; border-radius: 9px; padding: 3px; gap: 2px; overflow-x: auto; max-width: 100%; }
  .ea-seg a { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.75rem; border-radius: 7px; color: var(--ea-muted); font-size: 0.85rem; font-weight: 600; white-space: nowrap; }
  .ea-seg a:hover { color: var(--ea-ink); }
  .ea-seg a.is-active { background: #fff; color: var(--ea-ink); box-shadow: 0 1px 2px rgba(27, 42, 74, 0.12); }
  .ea-seg small { font-weight: 600; opacity: 0.75; }

  /* Daftar */
  .ea-list { background: var(--ea-surface); border: 1px solid var(--ea-line); border-radius: 12px; overflow: hidden; }
  .ea-cols, .ea-row { display: grid; grid-template-columns: minmax(0, 1fr) 110px 110px 215px; column-gap: 1rem; align-items: center; }
  .ea-cols { padding: 0.6rem 1rem 0.6rem 1.15rem; background: #fafbfd; border-bottom: 1px solid var(--ea-line); color: var(--ea-muted); font-size: 0.8rem; font-weight: 600; }
  .ea-cols > :last-child { text-align: right; }
  .ea-row { position: relative; padding: 0.85rem 1rem 0.85rem 1.15rem; border-bottom: 1px solid var(--ea-line); }
  .ea-row:last-of-type { border-bottom: 0; }
  .ea-row:hover { background: var(--ea-hover); }
  .ea-row::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c, #9aa5b8); }
  .t-laporan { --c: #0f8b8d; } .t-artikel { --c: #2f6fed; } .t-penelitian { --c: #7c4dcc; } .t-pengabdian { --c: #d9731a; } .t-buku { --c: #b8860b; }

  .ea-title { display: block; color: var(--ea-ink); font-weight: 600; font-size: 0.95rem; line-height: 1.4; overflow-wrap: anywhere; }
  .ea-title:hover { color: var(--ea-accent); text-decoration: underline; text-underline-offset: 3px; }
  .ea-meta { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; margin-top: 0.2rem; font-size: 0.8rem; color: var(--ea-muted); }
  .ea-meta span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .ea-meta .ea-jenis { color: var(--c); font-weight: 600; }

  .ea-pill { display: inline-block; border-radius: 999px; padding: 0.15rem 0.65rem; font-size: 0.78rem; font-weight: 600; }
  .s-pending { background: #fdf0d5; color: #8a5a00; }
  .s-approved { background: #dff3e7; color: #1d6b3f; }
  .s-rejected { background: #fbe3e4; color: #a12a35; }
  .ea-date { color: var(--ea-muted); font-size: 0.85rem; }
  .ea-actions { display: flex; gap: 0.4rem; align-items: center; justify-content: flex-end; }
  .ea-actions form { margin: 0; }
  .ea-actions .dropdown-menu { font-size: 0.875rem; border-color: var(--ea-line); border-radius: 10px; box-shadow: 0 8px 24px rgba(27, 42, 74, 0.12); }

  .ea-empty { padding: 3rem 1.5rem; text-align: center; color: var(--ea-muted); }
  .ea-empty i { font-size: 2rem; display: block; margin-bottom: 0.5rem; color: #b6bfce; }
  .ea-empty strong { display: block; color: var(--ea-ink); margin-bottom: 0.25rem; }
  .ea-more { text-align: center; padding: 0.9rem; border-top: 1px solid var(--ea-line); }
  .ea-foot { color: var(--ea-muted); font-size: 0.8rem; margin: 0.6rem 0.25rem 0; }
  [hidden] { display: none !important; }

  /* Ponsel: satu kolom, status dan tanggal di bawah judul */
  @media (max-width: 767.98px) {
    .ea-cols { display: none; }
    .ea-row { grid-template-columns: minmax(0, 1fr) auto; row-gap: 0.55rem; }
    .ea-main { grid-column: 1 / -1; }
    .ea-actions { grid-column: 1 / -1; justify-content: flex-start; }
    .ea-row > .ea-state { grid-column: 1; }
    .ea-row > .ea-date { grid-column: 2; text-align: right; }
    .ea-head h1 { font-size: 1.4rem; }
  }
</style>

<div class="container-xl ea py-4">

  <header class="ea-head">
    <div>
      <h1>ELK Library</h1>
      <p>Periksa kiriman yang masuk, lalu rapikan koleksi yang sudah terbit.</p>
    </div>
    <a href="/admin/elk-library/buku/tambah" class="ea-btn ea-btn-primary"><i class="bi bi-plus-lg"></i> Tambah buku</a>
  </header>

  <% if (menunggu > 0 && currentStatus !== 'pending') { %>
    <div class="ea-queue" role="status">
      <span><strong><%= menunggu %> kiriman</strong> menunggu verifikasi Anda.</span>
      <a href="<%= href('all', 'pending') %>">Periksa sekarang</a>
    </div>
  <% } %>

  <nav class="ea-tabs" aria-label="Jenis karya">
    <a class="ea-tab <%= currentType === 'all' ? 'is-active' : '' %>" href="<%= href('all', currentStatus) %>">
      Semua <span class="ea-count"><%= counts.all[currentStatus] %></span>
    </a>
    <% JENIS.forEach(j => { %>
      <a class="ea-tab <%= currentType === j.key ? 'is-active' : '' %>" href="<%= href(j.key, currentStatus) %>">
        <i class="bi <%= j.icon %>"></i> <%= j.label %> <span class="ea-count"><%= counts[j.key][currentStatus] %></span>
      </a>
    <% }) %>
  </nav>

  <div class="ea-toolbar">
    <div class="ea-search">
      <i class="bi bi-search"></i>
      <label for="eaCari" class="visually-hidden">Cari judul, penulis, atau penerbit</label>
      <input type="search" id="eaCari" placeholder="Cari judul atau penulis" autocomplete="off">
    </div>
    <div class="ea-seg" role="group" aria-label="Status">
      <% STATUS.forEach(st => { %>
        <a href="<%= href(currentType, st.key) %>" class="<%= currentStatus === st.key ? 'is-active' : '' %>" <%- currentStatus === st.key ? 'aria-current="true"' : '' %>>
          <%= st.label %> <small><%= counts[currentType][st.key] %></small>
        </a>
      <% }) %>
    </div>
  </div>

  <section class="ea-list" aria-label="Daftar karya">
    <% if (items.length === 0) { %>
      <div class="ea-empty">
        <i class="bi bi-inbox"></i>
        <% if (currentStatus === 'pending') { %>
          <strong>Tidak ada kiriman yang menunggu</strong>
          Semua kiriman sudah diperiksa. <a href="<%= href(currentType, 'all') %>">Lihat semua status</a>
        <% } else { %>
          <strong>Belum ada data</strong>
          Tidak ada karya yang cocok dengan pilihan ini. <a href="<%= href('all', 'all') %>">Tampilkan semua</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="ea-cols" aria-hidden="true">
        <div>Judul</div><div>Status</div><div>Dikirim</div><div>Aksi</div>
      </div>

      <div id="eaRows">
      <% items.forEach(it => {
           const j = jenisMap[it._type];
           const detail = '/admin/elk-library/' + it._type + '/' + it.id;
           const q = [it.judul, it.penulis, it.penulisSub, it.info, j.label].join(' ').toLowerCase();
      %>
        <article class="ea-row t-<%= it._type %>" data-q="<%= q %>">
          <div class="ea-main">
            <a class="ea-title" href="<%= detail %>"><%= it.judul %></a>
            <div class="ea-meta">
              <span class="ea-jenis"><i class="bi <%= j.icon %>"></i> <%= j.label %><% if (it._type === 'buku' && it.sumber) { %> (<%= it.sumber %>)<% } %></span>
              <span><i class="bi bi-person"></i> <%= it.penulis %><% if (it.penulisSub) { %> (<%= it.penulisSub %>)<% } %></span>
              <% if (it.tahun) { %><span><i class="bi bi-calendar3"></i> <%= it.tahun %></span><% } %>
              <% if (it.info) { %><span><%= it.info %></span><% } %>
            </div>
          </div>
          <div class="ea-state"><span class="ea-pill s-<%= it.status %>"><%= statusLabel[it.status] %></span></div>
          <div class="ea-date"><%= fmtTgl(it.createdAt) %></div>
          <div class="ea-actions">
            <% if (it.status === 'pending') { %>
              <form method="POST" action="<%= detail %>/approve" data-konfirmasi="Setujui &quot;<%= it.judul %>&quot; dan tampilkan di perpustakaan publik?">
                <input type="hidden" name="next" value="<%= listUrl %>">
                <button class="ea-btn ea-btn-ok" type="submit"><i class="bi bi-check-lg"></i> Setujui</button>
              </form>
              <form method="POST" action="<%= detail %>/reject" data-konfirmasi="Tolak &quot;<%= it.judul %>&quot;?">
                <input type="hidden" name="next" value="<%= listUrl %>">
                <button class="ea-btn ea-btn-no" type="submit">Tolak</button>
              </form>
            <% } %>
            <div class="dropdown">
              <button class="ea-btn ea-btn-icon" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="Menu lainnya untuk <%= it.judul %>">
                <i class="bi bi-three-dots"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="<%= detail %>"><i class="bi bi-eye me-2"></i>Lihat detail</a></li>
                <li><a class="dropdown-item" href="<%= detail %>/edit"><i class="bi bi-pencil-square me-2"></i>Edit</a></li>
                <% if (it.fileUrl) { %><li><a class="dropdown-item" href="<%= it.fileUrl %>" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf me-2"></i>Buka file</a></li><% } %>
                <% if (it.status === 'approved') { %><li><a class="dropdown-item" href="/elk-library/<%= it.id %>" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-2"></i>Lihat di halaman publik</a></li><% } %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form method="POST" action="<%= detail %>/delete" data-konfirmasi="Hapus &quot;<%= it.judul %>&quot; secara permanen? File di Drive juga ikut terhapus.">
                    <input type="hidden" name="next" value="<%= listUrl %>">
                    <button class="dropdown-item text-danger" type="submit"><i class="bi bi-trash me-2"></i>Hapus</button>
                  </form>
                </li>
              </ul>
            </div>
          </div>
        </article>
      <% }) %>
      </div>

      <div class="ea-empty" id="eaKosong" hidden>
        <i class="bi bi-search"></i>
        <strong>Tidak ada hasil</strong>
        <span id="eaKosongTeks"></span>
      </div>
      <div class="ea-more" id="eaMore" hidden>
        <button type="button" class="ea-btn ea-btn-icon" id="eaMoreBtn"></button>
      </div>
    <% } %>
  </section>

  <% if (items.length > 0) { %><p class="ea-foot" id="eaFoot" aria-live="polite"></p><% } %>
</div>

<script>
  (function () {
    var STEP = 40;
    var rows = Array.prototype.slice.call(document.querySelectorAll('#eaRows .ea-row'));
    var cari = document.getElementById('eaCari');
    var kosong = document.getElementById('eaKosong');
    var kosongTeks = document.getElementById('eaKosongTeks');
    var more = document.getElementById('eaMore');
    var moreBtn = document.getElementById('eaMoreBtn');
    var foot = document.getElementById('eaFoot');
    var limit = STEP;

    // Kata pencarian dibawa lewat ?q= supaya tetap ada setelah kembali dari detail
    var url = new URL(location.href);
    if (cari && url.searchParams.get('q')) cari.value = url.searchParams.get('q');

    function terapkan() {
      if (!rows.length) return;
      var kata = (cari.value || '').toLowerCase().trim().split(/\s+/).filter(Boolean);
      var cocok = rows.filter(function (r) {
        var q = r.getAttribute('data-q');
        return kata.every(function (k) { return q.indexOf(k) !== -1; });
      });
      rows.forEach(function (r) { r.hidden = true; });
      cocok.slice(0, limit).forEach(function (r) { r.hidden = false; });

      kosong.hidden = cocok.length > 0;
      if (!cocok.length) kosongTeks.textContent = 'Coba kata kunci lain, atau hapus pencarian.';
      var sisa = cocok.length - limit;
      more.hidden = sisa <= 0;
      if (sisa > 0) moreBtn.textContent = 'Tampilkan ' + Math.min(STEP, sisa) + ' lagi (sisa ' + sisa + ')';
      foot.textContent = kata.length
        ? cocok.length + ' dari ' + rows.length + ' karya cocok dengan pencarian'
        : rows.length + ' karya';

      var u = new URL(location.href);
      if (cari.value.trim()) u.searchParams.set('q', cari.value.trim()); else u.searchParams.delete('q');
      history.replaceState(null, '', u.pathname + u.search);
    }

    if (cari) cari.addEventListener('input', function () { limit = STEP; terapkan(); });
    if (moreBtn) moreBtn.addEventListener('click', function () { limit += STEP; terapkan(); });
    terapkan();

    // Konfirmasi aksi; alamat daftar saat ini (termasuk pencarian) ikut dikirim
    document.querySelectorAll('form[data-konfirmasi]').forEach(function (f) {
      f.addEventListener('submit', function (e) {
        if (!confirm(f.getAttribute('data-konfirmasi'))) { e.preventDefault(); return; }
        var next = f.querySelector('input[name="next"]');
        if (next) next.value = location.pathname + location.search;
      });
    });

    // Ingat posisi daftar saat membuka detail/edit, pulihkan saat kembali
    var KEY_URL = 'elkAdminListUrl', KEY_SCROLL = 'elkAdminListScroll', KEY_FLAG = 'elkAdminRestore';
    document.querySelectorAll('a[href^="/admin/elk-library/"]').forEach(function (a) {
      a.addEventListener('click', function () {
        try {
          sessionStorage.setItem(KEY_URL, location.pathname + location.search);
          sessionStorage.setItem(KEY_SCROLL, String(window.scrollY || window.pageYOffset || 0));
        } catch (e) {}
      });
    });
    try {
      if (sessionStorage.getItem(KEY_FLAG) === '1' && sessionStorage.getItem(KEY_URL) === location.pathname + location.search) {
        var y = parseInt(sessionStorage.getItem(KEY_SCROLL) || '0', 10) || 0;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var pulihkan = function () { window.scrollTo(0, y); };
        pulihkan();
        window.addEventListener('load', pulihkan);
        setTimeout(pulihkan, 150);
      }
      sessionStorage.removeItem(KEY_FLAG);
    } catch (e) {}
  })();
</script>

<%- include('../partials/footer') %>
