<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/lab-ui.css?v=2">
<%
  const tabs = [['pending', 'Menunggu verifikasi', hitung.pending, true], ['verified', 'Terverifikasi', hitung.verified, false], ['rejected', 'Ditolak', hitung.rejected, false], ['semua', 'Semua', hitung.semua, false]];
  const pil = { pending: ['wait', 'Menunggu'], verified: ['ok', 'Terverifikasi'], rejected: ['bad', 'Ditolak'] };
  const tgl = (s) => s ? new Date(s).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const jam = (s) => s ? new Date(s).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '';
  const wa = (n) => { const d = String(n || '').replace(/\D/g, ''); return d ? 'https://wa.me/' + d.replace(/^0/, '62') : ''; };
  const href = (page) => { const q = new URLSearchParams(); q.set('status', filterStatus); if (search) q.set('search', search); if (page > 1) q.set('page', page); return '/admin/pmb?' + q.toString(); };
%>
<div class="container-fluid mt-4 mb-5" style="max-width: 1180px;">
  <div class="lab-hero">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h2>Pendaftar PMB</h2>
        <p class="lab-sub">Verifikasi pendaftar mahasiswa baru dan pantau pembayaran pendaftaran dari formulir publik.</p>
      </div>
      <div class="lab-actions">
        <a href="/pmb" target="_blank" rel="noopener" class="btn btn-outline-light btn-sm rounded-pill px-3"><i class="bi bi-box-arrow-up-right me-1"></i> Halaman pendaftaran</a>
        <a href="/admin/pmb/export" class="btn btn-light btn-sm rounded-pill px-3"><i class="bi bi-file-earmark-excel me-1"></i> Export Excel</a>
      </div>
    </div>
  </div>

  <div class="lab-stats">
    <div class="lab-stat"><b><%= hitung.semua %></b><small>Total pendaftar</small></div>
    <div class="lab-stat warn"><b><%= hitung.pending %></b><small>Menunggu verifikasi</small></div>
    <div class="lab-stat ok"><b><%= hitung.verified %></b><small>Terverifikasi</small></div>
    <div class="lab-stat <%= hitung.rejected ? 'bad' : '' %>"><b><%= hitung.rejected %></b><small>Ditolak</small></div>
    <div class="lab-stat"><b><%= hitung.baru7 %></b><small>Daftar 7 hari terakhir</small></div>
  </div>

  <div class="lab-toolbar">
    <nav class="lab-tabs mb-0" aria-label="Filter status">
      <% tabs.forEach(t => { %>
        <a class="lab-tab <%= filterStatus === t[0] ? 'active' : '' %>" href="/admin/pmb?status=<%= t[0] %>"><%= t[1] %> <span class="n <%= (t[3] && t[2] > 0 && filterStatus !== t[0]) ? 'alert' : '' %>"><%= t[2] %></span></a>
      <% }) %>
    </nav>
    <form method="GET" action="/admin/pmb" class="lab-search ms-md-auto" role="search">
      <input type="hidden" name="status" value="<%= filterStatus %>">
      <i class="bi bi-search"></i>
      <input type="search" name="search" value="<%= search %>" placeholder="Cari nama, NIS, sekolah, atau WA" aria-label="Cari pendaftar">
    </form>
  </div>

  <div class="lab-table-wrap"><div class="table-responsive">
    <table class="lab-table">
      <thead><tr><th>Pendaftar</th><th>Asal sekolah</th><th>Jurusan &amp; jalur</th><th>WhatsApp</th><th>Status</th><th>Aksi</th></tr></thead>
      <tbody>
        <% pendaftar.forEach(p => { const st = pil[p.status || 'pending'] || ['mute', p.status]; const link = wa(p.wa); %>
          <tr>
            <td>
              <div class="fw-semibold" style="color:var(--lab-ink)"><%= p.nama %></div>
              <div class="small text-muted"><%= p.jenis_kelamin || '-' %> &middot; daftar <%= tgl(p.createdAt) %>, <%= jam(p.createdAt) %></div>
            </td>
            <td><div><%= p.asal_sekolah || '-' %></div><span class="lab-code">NIS <%= p.nis || '-' %></span></td>
            <td><div class="fw-semibold small"><%= p.jurusan || '-' %></div><div class="small text-muted"><%= p.jalur || '-' %></div></td>
            <td class="small"><% if (link) { %><a href="<%= link %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> <%= p.wa %></a><% } else { %>-<% } %></td>
            <td><span class="pill <%= st[0] %>"><%= st[1] %></span></td>
            <td class="text-nowrap">
              <button type="button" class="btn btn-sm btn-outline-primary aksi-detail" data-id="<%= p.id %>" title="Detail" aria-label="Detail <%= p.nama %>"><i class="bi bi-eye"></i></button>
              <% if ((p.status || 'pending') === 'pending') { %>
                <button type="button" class="btn btn-sm btn-success aksi-status" data-id="<%= p.id %>" data-status="verified" title="Verifikasi" aria-label="Verifikasi <%= p.nama %>"><i class="bi bi-check-lg"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger aksi-status" data-id="<%= p.id %>" data-status="rejected" title="Tolak" aria-label="Tolak <%= p.nama %>"><i class="bi bi-x-lg"></i></button>
              <% } %>
              <button type="button" class="btn btn-sm btn-outline-secondary aksi-hapus" data-id="<%= p.id %>" title="Hapus" aria-label="Hapus <%= p.nama %>"><i class="bi bi-trash"></i></button>
            </td>
          </tr>
        <% }) %>
        <% if (pendaftar.length === 0) { %>
          <tr><td colspan="6"><div class="lab-empty"><i class="bi bi-people"></i><%= search ? 'Tidak ada pendaftar yang cocok dengan pencarian.' : 'Belum ada pendaftar pada kategori ini.' %></div></td></tr>
        <% } %>
      </tbody>
    </table>
  </div></div>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
    <div class="small text-muted">Menampilkan <strong><%= pendaftar.length %></strong> dari <strong><%= total %></strong> pendaftar</div>
    <% if (totalPages > 1) { %>
      <nav class="lab-tabs mb-0" aria-label="Halaman">
        <% if (currentPage > 1) { %><a class="lab-tab" href="<%= href(currentPage - 1) %>" aria-label="Halaman sebelumnya">&lsaquo;</a><% } %>
        <% for (let i = 1; i <= totalPages; i++) { %><a class="lab-tab <%= currentPage === i ? 'active' : '' %>" href="<%= href(i) %>"><%= i %></a><% } %>
        <% if (currentPage < totalPages) { %><a class="lab-tab" href="<%= href(currentPage + 1) %>" aria-label="Halaman berikutnya">&rsaquo;</a><% } %>
      </nav>
    <% } %>
  </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailJudul" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:1.1rem;overflow:hidden;">
      <div class="modal-header" style="background:linear-gradient(135deg,var(--lab-ink),var(--lab-navy));color:#fff;">
        <h5 class="modal-title" id="detailJudul"><i class="bi bi-person-badge me-2"></i>Detail pendaftar</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body" id="detailContent"><div class="text-center py-4 text-muted">Memuat data...</div></div>
    </div>
  </div>
</div>

<script>
  (function () {
    var STATUS = { pending: ['wait', 'Menunggu'], verified: ['ok', 'Terverifikasi'], rejected: ['bad', 'Ditolak'] };

    // Semua data pendaftar berasal dari formulir PUBLIK, jadi hanya dimasukkan
    // sebagai teks (textContent) - tidak pernah sebagai HTML.
    function el(tag, teks, kelas) { var e = document.createElement(tag); if (teks !== undefined) e.textContent = teks; if (kelas) e.className = kelas; return e; }
    function baris(label, isi) {
      var row = el('div', undefined, 'col-md-6'); row.appendChild(el('div', label, 'small text-muted'));
      var v = el('div', undefined, 'fw-semibold'); if (typeof isi === 'string') v.textContent = isi || '-'; else v.appendChild(isi);
      row.appendChild(v); return row;
    }
    function tampilkan(p) {
      var box = document.getElementById('detailContent'); box.textContent = '';
      var row = el('div', undefined, 'row g-3');
      row.appendChild(baris('Nama', p.nama)); row.appendChild(baris('Jenis kelamin', p.jenis_kelamin));
      row.appendChild(baris('NIS', p.nis)); row.appendChild(baris('Asal sekolah', p.asal_sekolah));
      row.appendChild(baris('No. WhatsApp', p.wa)); row.appendChild(baris('Jurusan', p.jurusan));
      row.appendChild(baris('Jalur', p.jalur));
      var st = STATUS[p.status || 'pending'] || ['mute', String(p.status)];
      row.appendChild(baris('Status', el('span', st[1], 'pill ' + st[0])));
      row.appendChild(baris('Tanggal daftar', p.createdAt ? new Date(p.createdAt).toLocaleString('id-ID') : '-'));
      if (p.diprosesOleh) row.appendChild(baris('Diproses oleh', p.diprosesOleh));

      var bukti = el('div', undefined, 'col-12'); bukti.appendChild(el('div', 'Bukti pembayaran', 'small text-muted'));
      var path = typeof p.bukti_pembayaran === 'string' && p.bukti_pembayaran.indexOf('/uploads/pmb/') === 0 ? p.bukti_pembayaran : '';
      if (!path) bukti.appendChild(el('div', '-', 'fw-semibold'));
      else {
        if (/\.(jpe?g|png|webp|gif)$/i.test(path)) {
          var img = document.createElement('img'); img.src = path; img.alt = 'Bukti pembayaran'; img.loading = 'lazy';
          img.style.cssText = 'max-width:100%;max-height:320px;border-radius:.7rem;border:1px solid var(--lab-line);margin:.4rem 0;display:block;';
          bukti.appendChild(img);
        }
        var a = el('a', 'Buka berkas bukti', 'btn btn-sm btn-outline-primary rounded-pill'); a.href = path; a.target = '_blank'; a.rel = 'noopener';
        bukti.appendChild(a);
      }
      row.appendChild(bukti);
      var tek = el('div', undefined, 'col-12'); tek.appendChild(el('div', 'Perangkat / IP', 'small text-muted'));
      tek.appendChild(el('div', (p.ip || '-') + ' \u00b7 ' + (p.userAgent || '-'), 'small text-muted'));
      row.appendChild(tek);
      box.appendChild(row);
    }
    function kirim(url, opsi, ok) {
      fetch(url, opsi).then(function (r) { return r.json().catch(function () { return { success: false }; }); })
        .then(function (d) { if (d.success) ok(d); else alert(d.message || 'Gagal memproses permintaan.'); })
        .catch(function () { alert('Terjadi kesalahan jaringan.'); });
    }
    document.addEventListener('click', function (e) {
      var b = e.target.closest('button[data-id]'); if (!b) return;
      var id = b.dataset.id;
      if (b.classList.contains('aksi-detail')) {
        document.getElementById('detailContent').innerHTML = '<div class="text-center py-4 text-muted">Memuat data...</div>';
        kirim('/admin/pmb/detail/' + encodeURIComponent(id), {}, function (d) { tampilkan(d.data); new bootstrap.Modal(document.getElementById('detailModal')).show(); });
      } else if (b.classList.contains('aksi-status')) {
        var s = b.dataset.status;
        if (!confirm(s === 'verified' ? 'Verifikasi pendaftar ini?' : 'Tolak pendaftar ini?')) return;
        kirim('/admin/pmb/status/' + encodeURIComponent(id), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: s }) }, function () { location.reload(); });
      } else if (b.classList.contains('aksi-hapus')) {
        if (!confirm('Yakin hapus pendaftar ini? Data dan berkas bukti pembayarannya akan hilang permanen.')) return;
        kirim('/admin/pmb/hapus/' + encodeURIComponent(id), { method: 'DELETE' }, function () { location.reload(); });
      }
    });
  })();
</script>
<%- include('../partials/footer') %>
