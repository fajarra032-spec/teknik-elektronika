<%- include('../partials/header') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-journal-bookmark me-2"></i><%= title %></h4>
    <a href="/admin/matakuliah" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="info-card">
        <div class="card-header">Informasi MK</div>
        <div class="card-body">
          <div class="row mb-2">
            <div class="col-5 text-muted">Kode</div>
            <div class="col-7"><%= mk.kode %></div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">Kelas</div>
            <div class="col-7"><%= mk.kelas || 'Semua kelas (tidak dipisah)' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">Nama</div>
            <div class="col-7"><%= mk.nama %></div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">SKS</div>
            <div class="col-7"><%= mk.sks %></div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">Semester</div>
            <div class="col-7"><%= mk.semester %></div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">Konsentrasi</div>
            <div class="col-7">
              <span class="badge-konsentrasi <%= mk.konsentrasiLabel.toLowerCase() %>"><%= mk.konsentrasiLabel %></span>
            </div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">Jadwal</div>
            <div class="col-7"><%= mk.jadwal || '-' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">PDK</div>
            <div class="col-7"><%= mk.isPDK ? 'Ya' : 'Tidak' %></div>
          </div>
          <div class="row mb-2">
            <div class="col-5 text-muted">Dosen Pengampu</div>
            <div class="col-7">
              <% if (mk.dosenIds && mk.dosenIds.length > 0) { %>
                <% mk.dosenIds.forEach(function(id) { %>
                  <span class="badge bg-primary bg-opacity-10 text-primary mb-1"><%= dosenMap[id] || id %></span><br>
                <% }); %>
              <% } else { %>
                <span class="text-muted">Belum ditentukan</span>
              <% } %>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <a href="/admin/matakuliah/<%= mk.id %>/edit" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-pencil me-1"></i> Edit Mata Kuliah
          </a>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <div class="info-card mb-4">
        <div class="card-header">Riwayat Dosen Pengampu per Periode</div>
        <div class="card-body">
          <% if (pengampuHistori && pengampuHistori.length) { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th>Periode</th>
                    <th>Dosen Pengampu</th>
                  </tr>
                </thead>
                <tbody>
                  <% pengampuHistori.forEach(function(h) { %>
                    <tr>
                      <td><%= h.label %></td>
                      <td>
                        <% if (h.dosenNames && h.dosenNames.length) { %>
                          <%= h.dosenNames.join(', ') %>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">Belum ada riwayat pengampu tercatat.</p>
          <% } %>
        </div>
      </div>

      <div class="info-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span>Modul Pembelajaran</span>
          <span class="text-muted small fw-normal">Dibuat &amp; dikustomisasi bebas oleh dosen</span>
        </div>
        <div class="card-body">
          <% if (modulList && modulList.length > 0) { %>
            <% modulList.forEach(function(m) { %>
              <div class="border rounded-3 p-3 mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                  <strong><span class="badge bg-secondary me-2"><%= m.urutan %></span><%= m.judul %></strong>
                  <% if (m.updatedAt) { %>
                    <span class="text-muted small">Diperbarui: <%= new Date(m.updatedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                  <% } %>
                </div>
                <% if (m.fileId) { %>
                  <div class="d-flex justify-content-between align-items-center mb-1 small">
                    <span><i class="bi bi-file-earmark-pdf text-danger me-1"></i><%= m.fileNama || 'Modul.pdf' %></span>
                    <a href="<%= m.fileUrl %>" target="_blank" class="btn btn-sm btn-outline-secondary">Buka Penuh</a>
                  </div>
                  <iframe src="https://drive.google.com/file/d/<%= m.fileId %>/preview" style="width:100%; height:380px; border:1px solid #e2e8f0; border-radius:0.5rem;" allow="autoplay"></iframe>
                <% } else if (m.fileUrl) { %>
                  <div class="small mb-1"><a href="<%= m.fileUrl %>" target="_blank"><i class="bi bi-paperclip me-1"></i><%= m.fileNama || 'Lampiran' %></a></div>
                <% } %>
                <% if (m.konten) { %>
                  <div class="mt-2 small text-muted" style="max-height:150px; overflow:auto;"><%- m.konten %></div>
                <% } %>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-muted mb-0">Dosen pengampu belum membuat modul untuk mata kuliah ini.</p>
          <% } %>
        </div>
      </div>

      <div class="info-card">
        <div class="card-header">Materi Per Pertemuan</div>
        <div class="card-body">
          <% if (mk.materi && mk.materi.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th style="width:100px;">Pertemuan</th>
                    <th>Topik</th>
                  </tr>
                </thead>
                <tbody>
                  <% mk.materi.forEach(function(m) { %>
                    <tr>
                      <td><%= m.pertemuan %></td>
                      <td><%= m.topik || '-' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">Belum ada materi.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
