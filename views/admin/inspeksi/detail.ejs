<%- include('../../partials/header') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  .section-card { background: white; border-radius: 1rem; padding: 1.5rem; margin-bottom: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
  .section-title { font-weight: 700; margin-bottom: 1rem; border-left: 5px solid #1e3a8a; padding-left: 1rem; color: #1e3a8a; text-transform: uppercase; font-size: 1.2rem; }
  .beban-table { width: 100%; border-collapse: collapse; }
  .beban-table th, .beban-table td { border: 1px solid #dee2e6; padding: 8px; vertical-align: top; }
  .beban-table th { background: #f8f9fa; }
  .badge { font-size: 0.85rem; }
  @media print {
    .no-print { display: none; }
    .section-card { box-shadow: none; border: 1px solid #ccc; }
  }
</style>

<div class="container mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detail Hasil Inspeksi Listrik</h2>
    <div class="no-print">
      <a href="/admin/inspeksi" class="btn btn-secondary">Kembali</a>
      <button onclick="window.print()" class="btn btn-primary ms-2">Cetak</button>
    </div>
  </div>

  <!-- IDENTITAS -->
  <div class="section-card">
    <div class="section-title">A. Identitas Rumah Tangga</div>
    <div class="row">
      <div class="col-md-6"><strong>Kelompok:</strong> <%= data.kelompok %></div>
      <div class="col-md-6"><strong>Tanggal Inspeksi:</strong> <%= new Date(data.tanggal).toLocaleDateString('id-ID') %></div>
      <div class="col-md-6"><strong>Desa:</strong> <%= data.desa %></div>
      <div class="col-md-6"><strong>Dusun/RT:</strong> <%= data.dusunRt %></div>
      <div class="col-md-6"><strong>Pemilik Rumah:</strong> <%= data.pemilikRumah %></div>
      <div class="col-md-6"><strong>Alamat:</strong> <%= data.alamat %></div>
    </div>
  </div>

  <!-- INFORMASI AWAL & PENGUKURAN -->
  <div class="section-card">
    <div class="section-title">B. Informasi Awal & Pengukuran</div>
    <div class="row">
      <div class="col-md-3"><strong>Daya Terpasang:</strong> <%= data.dayaTerpasang %> VA</div>
      <div class="col-md-3"><strong>Jumlah Penghuni:</strong> <%= data.jumlahPenghuni %> orang</div>
      <div class="col-md-3"><strong>Pernah Korsleting:</strong> <%= data.pernahKorsleting ? 'Ya' : 'Tidak' %></div>
      <% if(data.pernahKorsleting) { %>
        <div class="col-md-3"><strong>Keterangan:</strong> <%= data.keteranganKorsleting || '-' %></div>
      <% } %>
    </div>
    <hr>
    <div class="row">
      <div class="col-md-4"><strong>Tegangan (Volt):</strong> <%= data.tegangan %></div>
      <div class="col-md-4"><strong>Arus Total (Ampere):</strong> <%= data.arusTotal ? data.arusTotal : '-' %></div>
      <div class="col-md-4"><strong>Beban Terukur (Watt):</strong> <%= data.bebanTerpasang ? data.bebanTerpasang : '-' %></div>
    </div>
  </div>

  <!-- DAFTAR BEBAN LISTRIK -->
  <div class="section-card">
    <div class="section-title">C. Daftar Beban Listrik Terpasang</div>
    <div class="table-responsive">
      <table class="beban-table">
        <thead>
          <tr><th>No</th><th>Jenis Peralatan</th><th>Jml</th><th>Daya (W)</th><th>Total Daya (W)</th><th>Mulai</th><th>Selesai</th><th>Durasi (jam)</th><th>Energi/hari (Wh)</th><th>Keterangan</th></tr>
        </thead>
        <tbody>
          <% 
            let totalDaya = 0;
            let totalEnergi = 0;
            const bebanList = data.bebanList || [];
            bebanList.forEach((b, idx) => {
              const jml = b.jml || 0;
              const daya = b.daya || 0;
              const totalDayaBaris = jml * daya;
              totalDaya += totalDayaBaris;
              // hitung durasi
              let durasi = 0;
              if (b.mulai && b.selesai) {
                const toMin = (t) => { let [h,m] = t.split(':').map(Number); return h*60 + (m||0); };
                let start = toMin(b.mulai);
                let end = toMin(b.selesai);
                if (end < start) end += 24*60;
                durasi = (end - start)/60;
              }
              const energi = totalDayaBaris * durasi;
              totalEnergi += energi;
          %>
          <tr>
            <td><%= idx+1 %></td>
            <td><%= b.jenis || '-' %></td>
            <td><%= jml %></td>
            <td><%= daya %></td>
            <td><%= totalDayaBaris %></td>
            <td><%= b.mulai || '-' %></td>
            <td><%= b.selesai || '-' %></td>
            <td><%= durasi.toFixed(1) %></td>
            <td><%= Math.round(energi) %></td>
            <td><%= b.ket || '-' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="mt-3">
      <strong>Total Daya Terpasang (semua aktif):</strong> <%= totalDaya.toLocaleString() %> Watt<br>
      <strong>Estimasi Energi per Hari:</strong> <%= totalEnergi.toLocaleString() %> Wh (<%= (totalEnergi/1000).toFixed(1) %> kWh/hari)
    </div>
  </div>

  <!-- GRAFIK BEBAN PUNCAK -->
  <div class="section-card">
    <div class="section-title">D. Analisis Beban Puncak (Per Jam)</div>
    <canvas id="bebanChart" width="400" height="200" style="max-height: 300px; width: 100%;"></canvas>
    <div class="row mt-3">
      <div class="col-md-6">
        <div class="alert alert-info">
          <strong>🏆 Jam Puncak:</strong> <span id="jamPuncak">-</span><br>
          <strong>Beban Puncak:</strong> <span id="bebanPuncak">0</span> Watt
        </div>
      </div>
      <div class="col-md-6">
        <div class="alert alert-warning">
          <strong>💡 Rekomendasi (Otomatis):</strong> <span id="rekomendasiBeban">-</span>
        </div>
      </div>
    </div>
  </div>

  <!-- PEMERIKSAAN MCB -->
  <div class="section-card">
    <div class="section-title">E. Pemeriksaan MCB</div>
    <div class="row">
      <div class="col-md-6"><strong>MCB Utama Ada:</strong> <%= data.mcbUtamaAda === 'Y' ? 'Ya' : 'Tidak' %></div>
      <div class="col-md-6"><strong>Ukuran MCB Utama (A):</strong> <%= data.mcbUtamaUkuran || '-' %></div>
      <div class="col-md-6"><strong>Ukuran Sesuai?:</strong> <%= data.mcbUtamaSesuai === 'Y' ? 'Ya' : 'Tidak' %></div>
      <div class="col-md-6"><strong>Rekomendasi MCB Utama:</strong> <%= data.mcbUtamaRekomendasi || '-' %></div>
      <div class="col-md-6"><strong>MCB Cabang Ada:</strong> <%= data.mcbCabangAda === 'Y' ? 'Ya' : 'Tidak' %></div>
      <div class="col-md-6"><strong>Ukuran MCB Cabang (A):</strong> <%= data.mcbCabangUkuran || '-' %></div>
      <div class="col-md-6"><strong>Ukuran Sesuai?:</strong> <%= data.mcbCabangSesuai === 'Y' ? 'Ya' : 'Tidak' %></div>
      <div class="col-md-6"><strong>Rekomendasi MCB Cabang:</strong> <%= data.mcbCabangRekomendasi || '-' %></div>
      <div class="col-md-6"><strong>Pernah MCB trip?</strong> <%= data.mcbPernahTrip %></div>
    </div>
  </div>

  <!-- PEMERIKSAAN INSTALASI -->
  <div class="section-card">
    <div class="section-title">F. Pemeriksaan Kabel & Instalasi</div>
    <div class="row">
      <div class="col-md-4"><strong>Ukuran Kabel Utama (mm²):</strong> <%= data.kabelUtamaUkuran || '-' %></div>
      <div class="col-md-4"><strong>Sesuai?:</strong> <%= data.kabelUtamaSesuai === 'Y' ? 'Ya' : 'Tidak' %></div>
      <div class="col-md-4"><strong>Ukuran Kabel Cabang (mm²):</strong> <%= data.kabelCabangUkuran || '-' %></div>
      <div class="col-md-4"><strong>Sesuai?:</strong> <%= data.kabelCabangSesuai === 'Y' ? 'Ya' : 'Tidak' %></div>
      <div class="col-md-4"><strong>Kondisi kabel terkelupas?:</strong> <%= data.kabelTerbuka %></div>
      <div class="col-md-4"><strong>Sambungan rapi?:</strong> <%= data.sambunganRapi %></div>
      <div class="col-md-4"><strong>Stop kontak longgar?:</strong> <%= data.stopKontakLonggar %></div>
      <div class="col-md-4"><strong>Ada Grounding?:</strong> <%= data.adaGrounding %></div>
      <div class="col-md-4"><strong>Lingkungan lembab?:</strong> <%= data.lembab %></div>
    </div>
  </div>

  <!-- REKOMENDASI & KESIMPULAN -->
  <div class="section-card">
    <div class="section-title">G. Rekomendasi & Kesimpulan</div>
    <div><strong>Rekomendasi Perbaikan:</strong></div>
    <ul>
      <% const rekomList = data.rekomendasiList || []; %>
      <% if(rekomList.length) { %>
        <% rekomList.forEach(r => { %>
          <li><strong><%= r.prioritas %>:</strong> <%= r.deskripsi %></li>
        <% }) %>
      <% } else { %>
        <li>Tidak ada rekomendasi khusus.</li>
      <% } %>
    </ul>
    <div><strong>Kesimpulan Umum:</strong> <%= data.kesimpulan %></div>
  </div>

  <!-- TANDA TANGAN -->
  <div class="section-card">
    <div class="section-title">H. Tanda Tangan</div>
    <div class="row">
      <div class="col-md-6 text-center"><strong>Petugas Inspeksi</strong><br><%= data.petugasNama %></div>
      <div class="col-md-6 text-center"><strong>Pemilik Rumah</strong><br><%= data.pemilikNama %></div>
    </div>
    <div class="mt-3 text-muted small">Data tersimpan pada: <%= new Date(data.createdAt).toLocaleString() %></div>
  </div>
</div>

<script>
  // Data beban dari server (array of objects)
  const bebanList = <%- JSON.stringify(data.bebanList || []) %>;

  function timeToMinutes(timeStr) {
    if (!timeStr || typeof timeStr !== 'string') return 0;
    const parts = timeStr.split(':');
    if (parts.length < 2) return 0;
    let h = parseInt(parts[0], 10);
    let m = parseInt(parts[1], 10);
    if (isNaN(h)) h = 0;
    if (isNaN(m)) m = 0;
    return h * 60 + m;
  }

  function hitungBebanPerJam() {
    let bebanPerJam = new Array(24).fill(0);
    for (let b of bebanList) {
      if (!b.mulai || !b.selesai) continue;
      if ((b.jml || 0) === 0 || (b.daya || 0) === 0) continue;
      const totalDayaBaris = (b.jml || 0) * (b.daya || 0);
      let start = timeToMinutes(b.mulai);
      let end = timeToMinutes(b.selesai);
      if (end < start) end += 24 * 60;
      let startHour = Math.floor(start / 60);
      let endHour = Math.floor(end / 60);
      for (let h = startHour; h <= endHour; h++) {
        let hourMod = h % 24;
        bebanPerJam[hourMod] += totalDayaBaris;
      }
    }
    return bebanPerJam;
  }

  const bebanPerJam = hitungBebanPerJam();
  const maxBeban = Math.max(...bebanPerJam);
  let jamPuncak = [];
  for (let i = 0; i < 24; i++) {
    if (bebanPerJam[i] === maxBeban && maxBeban > 0) jamPuncak.push(i);
  }
  document.getElementById('jamPuncak').innerText = jamPuncak.length ? jamPuncak.map(j => j.toString().padStart(2,'0')+':00').join(', ') : '-';
  document.getElementById('bebanPuncak').innerText = maxBeban;
  
  let rekomTeks = '';
  if (maxBeban > 0) {
    if (maxBeban > 900) rekomTeks = '⚠️ Beban puncak cukup tinggi (>900W). Sebarkan penggunaan alat berat.';
    else if (maxBeban > 450) rekomTeks = '📊 Beban puncak sedang. Hindari menyalakan banyak alat bersamaan.';
    else rekomTeks = '✅ Beban puncak aman.';
  } else {
    rekomTeks = 'Tidak ada data beban yang aktif.';
  }
  document.getElementById('rekomendasiBeban').innerText = rekomTeks;

  // Grafik
  const ctx = document.getElementById('bebanChart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: Array.from({length: 24}, (_, i) => i.toString().padStart(2,'0') + ':00'),
      datasets: [{
        label: 'Beban (Watt)',
        data: bebanPerJam,
        backgroundColor: 'rgba(54, 162, 235, 0.6)',
        borderColor: 'rgba(54, 162, 235, 1)',
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      scales: { 
        y: { beginAtZero: true, title: { display: true, text: 'Watt' } },
        x: { title: { display: true, text: 'Jam' }, ticks: { stepSize: 1, autoSkip: true, maxRotation: 45 } }
      }
    }
  });
</script>
<%- include('../../partials/footer') %>