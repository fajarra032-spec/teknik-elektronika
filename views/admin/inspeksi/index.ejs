<%- include('../../partials/header') %>
<div class="container mt-4">
  <h2>Rekap Inspeksi Listrik Rumah Tangga</h2>
  <table class="table table-bordered">
    <thead><tr><th>No</th><th>Tanggal</th><th>Kelompok</th><th>Pemilik</th><th>Desa</th><th>Petugas</th><th>Aksi</th></tr></thead>
    <tbody>
      <% data.forEach((item, idx) => { %>
      <tr>
        <td><%= idx+1 %></td>
        <td><%= new Date(item.tanggal).toLocaleDateString() %></td>
        <td><%= item.kelompok %></td>
        <td><%= item.pemilikRumah %></td>
        <td><%= item.desa %></td>
        <td><%= item.petugasNama %></td>
        <td><a href="/admin/inspeksi/<%= item.id %>" class="btn btn-sm btn-info">Detail</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../../partials/footer') %>