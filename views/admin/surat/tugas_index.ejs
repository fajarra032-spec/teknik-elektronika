<%- include('../../partials/header') %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📄 Surat Tugas Dosen</h2>
    <a href="/admin/surat/create-tugas" class="btn btn-primary">+ Buat Surat Tugas Baru</a>
  </div>
  <div class="card">
    <div class="card-body">
      <table class="table table-bordered">
        <thead class="table-light">
          <tr><th>Dosen</th><th>Kegiatan</th><th>Penyelenggara</th><th>Status</th><th>Aksi</th></tr>
        </thead>
        <tbody>
          <% if (tugasList && tugasList.length) { %>
            <% tugasList.forEach(t => { %>
              <tr>
                <td><strong><%= t.dosenNama %></strong><br><small><%= t.nip %></small></td>
                <td><%= t.namaKegiatan %></td>
                <td><%= t.penyelenggara %></td>
                <td>
                  <span class="badge <%= t.status === 'pending' ? 'bg-warning' : 'bg-success' %>">
                    <%= t.status === 'pending' ? 'Menunggu' : 'Selesai' %>
                  </span>
                </td>
                <td>
                  <a href="/admin/surat/tugas/<%= t.id %>" class="btn btn-sm btn-info">Detail</a>
                  <% if (t.status === 'completed') { %>
                    <a href="<%= t.fileUrl %>" target="_blank" class="btn btn-sm btn-success">Unduh PDF</a>
                  <% } %>
                  <form method="POST" action="/admin/surat/tugas/<%= t.id %>/delete" style="display:inline;" onsubmit="return confirm('Yakin hapus surat tugas ini?')">
                    <button class="btn btn-sm btn-danger">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="text-center">Belum ada surat tugas.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>