<%- include('../../partials/header') %>

<style>
  :root {
    --primary-gradient: linear-gradient(135deg, #1e3a8a, #3b82f6);
    --input-focus-shadow: rgba(59, 130, 246, 0.15);
  }

  body {
    background-color: #f8fafc;
  }

  .form-card {
    max-width: 750px;
    margin: 2rem auto;
    background: white;
    border-radius: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .form-header {
    background: var(--primary-gradient);
    padding: 2.5rem 2rem;
    color: white;
    text-align: center;
    position: relative;
  }

  .form-header h3 {
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .form-header p {
    margin-top: 0.5rem;
    opacity: 0.8;
    font-size: 0.95rem;
  }

  .form-body {
    padding: 2.5rem 3rem;
  }

  .form-label {
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-label i {
    color: #3b82f6;
  }

  .form-control, .form-select {
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1.5px solid #e2e8f0;
    background-color: #fcfcfd;
    transition: all 0.2s ease-in-out;
  }

  .form-control:focus, .form-select:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px var(--input-focus-shadow);
    background-color: #fff;
  }

  .file-upload-wrapper {
    position: relative;
    border: 2px dashed #cbd5e1;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    background-color: #f8fafc;
    transition: all 0.2s;
  }

  .file-upload-wrapper:hover {
    border-color: #3b82f6;
    background-color: #eff6ff;
  }

  .btn-submit {
    background: var(--primary-gradient);
    border: none;
    color: white;
    padding: 0.8rem 2.5rem;
    border-radius: 50px;
    font-weight: 700;
    transition: all 0.3s;
    box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2);
  }

  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(30, 58, 138, 0.3);
    color: white;
  }

  .btn-cancel {
    border-radius: 50px;
    padding: 0.8rem 2rem;
    font-weight: 600;
    color: #64748b;
    border: 1.5px solid #e2e8f0;
    transition: all 0.2s;
  }

  .btn-cancel:hover {
    background-color: #f1f5f9;
    color: #1e293b;
  }

  @media (max-width: 768px) {
    .form-body { padding: 1.5rem; }
  }
</style>

<div class="container py-4">
  <div class="form-card">
    <div class="form-header">
      <div class="mb-2">
        <i class="bi bi-send-check-fill fs-1"></i>
      </div>
      <h3>Kirim Surat ke Mahasiswa</h3>
      <p>Kirim dokumen langsung ke satu mahasiswa tanpa perlu ada pengajuan terlebih dahulu</p>
    </div>

    <div class="form-body">
      <form method="POST" action="/admin/surat/kirim-mahasiswa" enctype="multipart/form-data">

        <!-- Mahasiswa Selection -->
        <div class="mb-4">
          <label class="form-label">
            <i class="bi bi-person-badge"></i> Pilih Mahasiswa Penerima <span class="text-danger">*</span>
          </label>
          <select name="mahasiswaId" class="form-select" required>
            <option value="">Cari dan pilih nama mahasiswa...</option>
            <% if (daftarMahasiswa && daftarMahasiswa.length) { %>
              <% daftarMahasiswa.forEach(m => { %>
                <option value="<%= m.id %>"><%= m.nama %> — NIM: <%= m.nim || 'N/A' %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div class="row">
          <!-- Jenis Surat -->
          <div class="col-md-6 mb-4">
            <label class="form-label">
              <i class="bi bi-tag"></i> Jenis Surat <span class="text-danger">*</span>
            </label>
            <select name="jenisSurat" id="jenisSurat" class="form-select" required onchange="toggleJenisLainnya()">
              <option value="">Pilih kategori...</option>
              <option value="Aktif Kuliah">Surat Aktif Kuliah</option>
              <option value="Keterangan Lulus Sementara">Keterangan Lulus Sementara</option>
              <option value="Keterangan Berkelakuan Baik">Keterangan Berkelakuan Baik</option>
              <option value="Rekomendasi">Rekomendasi</option>
              <option value="Keterangan Cuti/Aktif Kembali">Keterangan Cuti/Aktif Kembali</option>
              <option value="Keterangan Dosen PA">Keterangan Dosen PA</option>
              <option value="Pengantar Magang/PKL">Pengantar Magang/PKL</option>
              <option value="Undangan Seminar Magang">Undangan Seminar Magang</option>
              <option value="Peringatan Akademik">Peringatan Akademik</option>
              <option value="Pemberitahuan">Pemberitahuan</option>
              <option value="Lainnya">Lainnya (isi manual)</option>
            </select>
          </div>

          <!-- Nomor Surat -->
          <div class="col-md-6 mb-4">
            <label class="form-label">
              <i class="bi bi-hash"></i> Nomor Surat <span class="text-muted small">(Opsional)</span>
            </label>
            <input type="text" name="nomorSurat" class="form-control" placeholder="Contoh: 001/ELK/PDW/IX/2026">
          </div>
        </div>

        <div class="mb-4" id="wrapperJenisLainnya" style="display:none;">
          <label class="form-label">
            <i class="bi bi-pencil"></i> Nama Jenis Surat <span class="text-danger">*</span>
          </label>
          <input type="text" name="jenisSuratLainnya" class="form-control" placeholder="Contoh: Surat Panggilan Orang Tua">
        </div>

        <!-- Keperluan -->
        <div class="mb-4">
          <label class="form-label">
            <i class="bi bi-bookmark-star"></i> Perihal / Keperluan <span class="text-danger">*</span>
          </label>
          <input type="text" name="keperluan" class="form-control" placeholder="Contoh: Pemberitahuan jadwal her-registrasi semester genap" required>
        </div>

        <!-- Keterangan -->
        <div class="mb-4">
          <label class="form-label">
            <i class="bi bi-chat-left-text"></i> Catatan Tambahan <span class="text-muted small">(Opsional)</span>
          </label>
          <textarea name="isiLain" class="form-control" rows="3" placeholder="Tambahkan informasi pendukung jika diperlukan..."></textarea>
        </div>

        <!-- File Upload -->
        <div class="mb-4">
          <label class="form-label">
            <i class="bi bi-file-earmark-pdf"></i> Unggah Dokumen PDF <span class="text-danger">*</span>
          </label>
          <div class="file-upload-wrapper">
            <input type="file" name="file" class="form-control" accept=".pdf" required>
            <div class="mt-2 text-muted small">
              <i class="bi bi-info-circle me-1"></i> Pastikan file dalam format <strong>.pdf</strong> dengan ukuran maksimal 5MB.
            </div>
          </div>
        </div>

        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i> Surat akan langsung berstatus <strong>selesai</strong> dan muncul di halaman "Daftar Surat" mahasiswa yang dipilih, tanpa perlu mahasiswa mengajukan lebih dulu.
        </div>

        <!-- Form Actions -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-5 gap-3 border-top pt-4">
          <a href="/admin/surat" class="btn btn-cancel order-2 order-md-1 w-100 w-md-auto">
            <i class="bi bi-x-lg me-2"></i>Batalkan
          </a>
          <button type="submit" class="btn btn-submit order-1 order-md-2 w-100 w-md-auto">
            <i class="bi bi-send-fill me-2"></i>Kirim Surat Sekarang
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

<script>
  function toggleJenisLainnya() {
    const sel = document.getElementById('jenisSurat');
    const wrap = document.getElementById('wrapperJenisLainnya');
    wrap.style.display = (sel.value === 'Lainnya') ? 'block' : 'none';
  }
</script>

<%- include('../../partials/footer') %>
