<%- include('../../partials/header') %>

<div class="container mt-4" style="max-width: 720px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-file-earmark-medical me-2"></i><%= title %></h4>
    <a href="/admin/surat" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>

  <div class="info-card">
    <div class="card-body">
      <form method="POST" action="/admin/surat/dosen/create-izin">
        <div class="mb-3">
          <label class="form-label">Dosen</label>
          <select name="dosenId" class="form-select" required>
            <option value="">Pilih Dosen</option>
            <% dosenList.forEach(function(d) { %>
              <option value="<%= d.id %>"><%= d.nama %> <%= d.nip ? '(' + d.nip + ')' : '' %></option>
            <% }); %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label">No. HP</label>
          <input type="text" name="noHp" class="form-control">
        </div>

        <div class="mb-3">
          <label class="form-label">Jenis Izin</label>
          <% const jenisIzinOpt = ['Acara Keluarga (Menikah/Aqiqah/Wisuda)', 'Mendampingi Keluarga Berobat', 'Kedukaan']; %>
          <% jenisIzinOpt.forEach(function(j, idx) { %>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="jenisIzin" value="<%= j %>" id="jenisIzin<%= idx %>">
              <label class="form-check-label" for="jenisIzin<%= idx %>"><%= j %></label>
            </div>
          <% }); %>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label class="form-label">Tanggal Mulai</label>
            <input type="date" name="tanggalMulai" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Tanggal Selesai</label>
            <input type="date" name="tanggalSelesai" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Jumlah Hari</label>
            <input type="number" name="jumlahHari" class="form-control" min="1" required>
          </div>
        </div>

        <hr>
        <h6 class="fw-semibold">Pengalihan Tugas Selama Izin</h6>
        <div class="mb-3">
          <label class="form-label">Nama Pengganti</label>
          <input type="text" name="namaPengganti" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label">Tugas yang Dialihkan</label>
          <input type="text" name="tugasPengganti" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label">Bentuk Pengalihan</label>
          <% const bentukOpt = ['Team Teaching', 'Pengganti Sementara', 'Penjadwalan Ulang']; %>
          <% bentukOpt.forEach(function(b, idx) { %>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="checkbox" name="bentukPengalihan" value="<%= b %>" id="bentuk<%= idx %>">
              <label class="form-check-label" for="bentuk<%= idx %>"><%= b %></label>
            </div>
          <% }); %>
        </div>

        <hr>
        <h6 class="fw-semibold">Persetujuan</h6>
        <div class="mb-3">
          <select name="persetujuan" class="form-select">
            <option value="Disetujui">Disetujui</option>
            <option value="Tidak Disetujui">Tidak Disetujui</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Catatan Atasan</label>
          <textarea name="catatanPersetujuan" class="form-control" rows="2"></textarea>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Buat Surat Izin</button>
          <a href="/admin/surat" class="btn btn-light">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
