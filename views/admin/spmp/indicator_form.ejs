<%- include('../../partials/header') %>
<div class="container mt-4" style="max-width: 640px;">
  <h2><%= title %></h2>
  <form method="POST" action="<%= indicator ? '/admin/spmp/indicators/' + indicator.id + '/edit' : '/admin/spmp/indicators' %>" class="mt-3">
    <div class="mb-3">
      <label class="form-label">Periode</label>
      <select name="periodeId" class="form-select" required>
        <% periods.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= indicator && indicator.periodeId === p.id ? 'selected' : '' %>><%= p.nama %></option>
        <% }); %>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">Nama Indikator</label>
      <input type="text" name="nama" class="form-control" value="<%= indicator ? indicator.nama : '' %>" required>
    </div>
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label">Target</label>
        <input type="number" step="any" name="target" class="form-control" value="<%= indicator ? indicator.target : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Satuan</label>
        <input type="text" name="satuan" class="form-control" value="<%= indicator ? indicator.satuan : '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Bobot</label>
        <input type="number" step="any" name="bobot" class="form-control" value="<%= indicator ? indicator.bobot : '' %>" required>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Urutan</label>
      <input type="number" name="urutan" class="form-control" value="<%= indicator ? indicator.urutan : '' %>" required>
    </div>
    <div class="d-flex gap-2 mt-4">
      <button type="submit" class="btn btn-primary">Simpan</button>
      <a href="/admin/spmp/indicators<%= indicator ? '?periodeId=' + indicator.periodeId : '' %>" class="btn btn-light">Batal</a>
    </div>
  </form>
</div>
<%- include('../../partials/footer') %>
