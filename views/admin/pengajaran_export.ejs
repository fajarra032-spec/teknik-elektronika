<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rekap Pengajaran - <%= typeof filterInfo !== 'undefined' ? filterInfo : '' %></title>
  <style>
    @page { size: A4 landscape; margin: 14mm 12mm; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #e9edf3; font-family: Arial, Helvetica, sans-serif; color: #000; font-size: 10pt; line-height: 1.35; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .toolbar { position: sticky; top: 0; z-index: 50; display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; justify-content: space-between; padding: .65rem 1rem; background: #1b2a4a; color: #fff; font-size: 13px; }
    .toolbar a, .toolbar button { font: inherit; font-weight: 600; border: 0; border-radius: 8px; padding: .45rem .9rem; cursor: pointer; text-decoration: none; }
    .toolbar .kembali { background: rgba(255,255,255,.14); color: #fff; } .toolbar .cetak { background: #fff; color: #1e3a8a; } .toolbar small { opacity: .8; }
    .kertas { width: 297mm; min-height: 210mm; margin: 14px auto; padding: 14mm 12mm; background: #fff; box-shadow: 0 6px 24px rgba(27,42,74,.18); }

    /* Kop surat (sama dengan transkrip/KHS) */
    .kop-surat { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 3px double #000; }
    .logo-kop { width: 74px; height: auto; flex: 0 0 auto; }
    .teks-kop { flex: 1; text-align: left; line-height: 1.28; padding-left: 4px; }
    .teks-kop .nama-kampus { font-size: 17pt; font-weight: bold; margin: 0 0 3px; color: #2b4d8f; letter-spacing: .5px; text-transform: uppercase; }
    .teks-kop .alamat, .teks-kop .kontak { font-size: 9pt; margin: 0; color: #333; } .teks-kop .kontak { margin-top: 2px; }
    .garis-kop { display: none; }

    h1 { font-size: 12.5pt; text-align: center; margin: 4px 0 2px; }
    .sub { text-align: center; margin: 0 0 10px; font-size: 9.5pt; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 9.5pt; }
    th, td { border: 1px solid #000; padding: 3px 6px; vertical-align: top; overflow-wrap: anywhere; }
    th { background: #f2f2f2; text-align: center; }
    td.c { text-align: center; }
    thead { display: table-header-group; } tr { page-break-inside: avoid; }
    .ttd-info { margin-top: 10px; font-size: 9pt; color: #444; }
    @media print { body { background: #fff; } .toolbar { display: none !important; } .kertas { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; } }
  </style>
</head>
<body>
<%
  var data = typeof data !== 'undefined' ? data : [];
  var filterInfo = typeof filterInfo !== 'undefined' ? filterInfo : 'Semua Semester';
  var generatedAt = typeof generatedAt !== 'undefined' ? generatedAt : '';
%>
<div class="toolbar">
  <a class="kembali" href="/admin/pengajaran">&larr; Kembali</a>
  <small><%= data.length %> mata kuliah &middot; Pilih &ldquo;Simpan sebagai PDF&rdquo; di dialog cetak untuk berkas digital</small>
  <button class="cetak" type="button" onclick="window.print()">Cetak / Simpan PDF</button>
</div>

<div class="kertas">
  <%- include('../partials/kop_surat') %>

  <h1>LAPORAN REKAP PENGAJARAN</h1>
  <p class="sub">Program Studi Teknik Elektronika &ndash; Politeknik Dewantara<br><%= filterInfo %></p>

  <table>
    <colgroup><col style="width:4%"><col style="width:8%"><col style="width:25%"><col style="width:5%"><col style="width:8%"><col style="width:22%"><col style="width:14%"><col style="width:14%"></colgroup>
    <thead>
      <tr><th>No</th><th>Kode MK</th><th>Nama MK</th><th>SKS</th><th>Semester</th><th>Dosen pengampu</th><th>Jadwal</th><th>Pertemuan terlaksana</th></tr>
    </thead>
    <tbody>
      <% if (data.length === 0) { %>
        <tr><td colspan="8" class="c">Tidak ada data</td></tr>
      <% } %>
      <% data.forEach((item, i) => { %>
        <tr>
          <td class="c"><%= i + 1 %></td>
          <td class="c"><%= item.kode %></td>
          <td><%= item.nama %></td>
          <td class="c"><%= item.sks %></td>
          <td class="c"><%= item.semester || '-' %></td>
          <td><%= item.dosen || '-' %></td>
          <td><%= item.jadwal || '-' %></td>
          <td class="c"><%= item.terlaksana %> / <%= item.totalPertemuan %> (<%= item.persentase %>%)</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p class="ttd-info">Dicetak pada <%= generatedAt %></p>
</div>
</body>
</html>
