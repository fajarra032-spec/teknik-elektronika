<%- include('../partials/header') %>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --gradient: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    --card-radius: 1.25rem;
    --shadow-sm: 0 5px 20px rgba(0,0,0,0.05);
    --shadow-hover: 0 15px 30px rgba(0,0,0,0.1);
  }
  .stat-card {
    background: white;
    border-radius: var(--card-radius);
    padding: 1.2rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.03);
  }
  .stat-number {
    font-size: 2rem;
    font-weight: 800;
    background: var(--gradient);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    line-height: 1.2;
  }
  .stat-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #64748b;
  }
  .table-wrapper {
    background: white;
    border-radius: var(--card-radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .item-table thead th {
    background: #f8fafc;
    color: #1e293b;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 1rem;
    border-bottom: 2px solid #e2e8f0;
  }
  .item-table tbody tr:hover { background: #fefce8; }
  .item-table td { padding: 1rem; vertical-align: middle; }
  .thumbnail {
    width: 56px; height: 56px; object-fit: cover; border-radius: 50%;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  }
  .btn-action { margin: 0 3px; border-radius: 50px; padding: 0.3rem 0.9rem; font-size: 0.75rem; font-weight: 500; }
  .empty-state { text-align: center; padding: 3rem; }
  .empty-state i { font-size: 3.5rem; color: #cbd5e1; }
  .testi-cell { max-width: 320px; color: #475569; }
  .badge-nonaktif { background: #f1f5f9; color: #94a3b8; }
  @media (max-width: 768px) {
    .item-table thead { display: none; }
    .item-table tbody tr { display: block; margin-bottom: 1rem; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 0.5rem; }
    .item-table td { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem; border-bottom: 1px dashed #e2e8f0; }
    .item-table td:last-child { border-bottom: none; }
    .item-table td::before { content: attr(data-label); font-weight: 700; width: 35%; color: #475569; }
  }
</style>

<div class="container-fluid mt-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold"><i class="bi bi-chat-quote-fill me-2" style="background: var(--gradient); background-clip: text; -webkit-background-clip: text; color: transparent;"></i>Kelola Testimoni Alumni</h2>
      <p class="text-muted mb-0">Tampil di landing page pada section "Apa Kata Alumni?"</p>
    </div>
    <a href="/admin/testimoni/create" class="btn btn-primary rounded-pill px-4 shadow-sm">
      <i class="bi bi-plus-circle me-2"></i>Tambah Testimoni
    </a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4 col-6">
      <div class="stat-card">
        <div class="stat-number"><%= testimoni ? testimoni.length : 0 %></div>
        <div class="stat-label">Total Testimoni</div>
      </div>
    </div>
    <div class="col-md-4 col-6">
      <div class="stat-card">
        <div class="stat-number"><%= testimoni ? testimoni.filter(t => t.aktif).length : 0 %></div>
        <div class="stat-label">Tampil di Landing</div>
      </div>
    </div>
    <div class="col-md-4 col-6">
      <div class="stat-card">
        <div class="stat-number"><%= testimoni ? testimoni.filter(t => !t.aktif).length : 0 %></div>
        <div class="stat-label">Nonaktif</div>
      </div>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i>Testimoni berhasil <strong><%= success %></strong>.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="table-wrapper">
    <div class="table-responsive">
      <table class="table item-table mb-0">
        <thead>
          <tr>
            <th>Foto</th>
            <th>Nama</th>
            <th>Peran / Lulusan</th>
            <th>Testimoni</th>
            <th>Urutan</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!testimoni || testimoni.length === 0) { %>
            <tr>
              <td colspan="7" class="empty-state">
                <i class="bi bi-chat-square-quote"></i>
                <p class="mt-2 text-muted">Belum ada testimoni. Klik "Tambah Testimoni" untuk membuat.</p>
              </td>
            </tr>
          <% } else { %>
            <% testimoni.forEach(t => { %>
              <tr>
                <td data-label="Foto">
                  <% if (t.foto) { %>
                    <img src="<%= t.foto %>" alt="<%= t.nama %>" class="thumbnail" onerror="this.style.display='none'">
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td data-label="Nama"><strong><%= t.nama %></strong></td>
                <td data-label="Peran"><%= t.role || '-' %><% if (t.tahunLulus) { %> (Lulusan <%= t.tahunLulus %>)<% } %></td>
                <td data-label="Testimoni" class="testi-cell">"<%= (t.testimoni || '').substring(0, 90) %><%= (t.testimoni || '').length > 90 ? '...' : '' %>"</td>
                <td data-label="Urutan"><%= t.urutan || 0 %></td>
                <td data-label="Status">
                  <% if (t.aktif) { %>
                    <span class="badge bg-success">Tampil</span>
                  <% } else { %>
                    <span class="badge badge-nonaktif">Nonaktif</span>
                  <% } %>
                </td>
                <td data-label="Aksi">
                  <div class="d-flex flex-wrap gap-1">
                    <a href="/admin/testimoni/<%= t.id %>/edit" class="btn btn-sm btn-warning btn-action">
                      <i class="bi bi-pencil"></i> Edit
                    </a>
                    <form method="POST" action="/admin/testimoni/<%= t.id %>/delete" style="display:inline;" onsubmit="return confirm('Yakin hapus testimoni ini?')">
                      <button type="submit" class="btn btn-sm btn-danger btn-action">
                        <i class="bi bi-trash"></i> Hapus
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
