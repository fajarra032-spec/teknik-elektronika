<%- include('../partials/header-landing') %>
<style>
  .sop-hero{background:linear-gradient(135deg,#0d6efd,#0dcaf0);color:#fff;border-radius:1.5rem;padding:2.2rem 1.5rem;margin:1.5rem 0 2rem;text-align:center}
  .sop-hero h1{font-weight:800;font-size:clamp(1.6rem,4vw,2.4rem);margin-bottom:.4rem}
  .sop-card{background:#fff;border:1px solid rgba(13,110,253,.12);border-radius:1rem;padding:1rem 1.2rem;margin-bottom:.8rem;display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;justify-content:space-between;box-shadow:0 5px 15px rgba(0,0,0,.04)}
  .sop-card .kode{font-size:.78rem;font-weight:700;color:#0d6efd}
  .sop-card .judul{font-weight:700;color:#1e293b}
  .sop-card .meta{font-size:.8rem;color:#64748b}
</style>
<div class="container pb-5">
  <div class="sop-hero"><h1>SOP Program Studi</h1><p class="mb-0">Standar Operasional Prosedur Prodi D3 Teknik Elektronika &middot; <%= total %> dokumen tersedia</p></div>
  <% if (!total) { %><div class="alert alert-info">Belum ada SOP yang dipublikasikan.</div><% } %>
  <% Object.keys(perKelompok).sort().forEach(function(k){ %>
    <h5 class="mt-4 mb-3" style="font-weight:700;color:#1e293b;"><%= k %></h5>
    <% perKelompok[k].forEach(function(s){ var judul = s.isi ? s.isi.judul : s.judul; %>
      <div class="sop-card">
        <div>
          <div class="kode"><%= s.kode %><% if (s.akses === 'internal') { %> &middot; <i class="bi bi-lock-fill"></i> Internal<% } %></div>
          <div class="judul"><%= s.judul %></div>
          <div class="meta">Penanggung jawab: <%= s.pj %><% if (s.st && s.st.status) { %> &middot; Status: <%= s.st.status %><% } else if (!s.urlEksternal) { %> &middot; Status: Draf<% } %></div>
        </div>
        <div>
          <% if (s.urlEksternal) { %>
            <a class="btn btn-sm btn-outline-primary" href="<%= s.urlEksternal %>"><i class="bi bi-eye me-1"></i>Lihat</a>
          <% } else { %>
            <a class="btn btn-sm btn-outline-primary" href="/sop/<%= s.kode %>"><i class="bi bi-eye me-1"></i>Lihat</a>
            <a class="btn btn-sm btn-primary" href="/sop/<%= s.kode %>/docx"><i class="bi bi-download me-1"></i>Unduh .docx</a>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% }) %>
</div>
<%- include('../partials/footer-landing') %>
