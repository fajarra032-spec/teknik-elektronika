<%- include('../../partials/header') %>

<style>
  :root {
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
  }
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.5rem;
    padding: 1.5rem 2rem;
    color: white;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .page-header h2 {
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .form-card {
    background: white;
    border-radius: 1.2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border: 1px solid rgba(30,58,138,0.1);
    overflow: hidden;
  }
  .form-card .card-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    padding: 1rem 1.5rem;
    font-weight: 600;
  }
  .btn-primary-custom {
    background: linear-gradient(105deg, var(--primary-start), var(--primary-end));
    border: none;
    border-radius: 60px;
    padding: 0.5rem 1.5rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .btn-primary-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(30,58,138,0.25);
  }
  .required:after {
    content: " *";
    color: red;
  }
</style>

<div class="container mt-4">
  <div class="page-header">
    <h2><i class="bi bi-file-text me-2"></i>Ajukan Surat Izin</h2>
    <p>Isi formulir berikut untuk mengajukan izin (acara keluarga, berobat, dll). Admin akan memproses dan menerbitkan surat izin.</p>
  </div>

  <div class="form-card">
    <div class="card-header">
      <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Form Pengajuan Izin</h5>
    </div>
    <div class="card-body p-4">
      <form method="POST" action="/dosen/surat/ajukan-izin">
        <!-- Nomor HP -->
        <div class="mb-3">
          <label class="form-label">Nomor HP</label>
          <input type="text" name="noHp" class="form-control" placeholder="Contoh: 0812xxxxxxx" value="<%= dosen.noHp || '' %>">
          <div class="form-text">Nomor telepon yang dapat dihubungi selama izin.</div>
        </div>

        <!-- Jenis Izin (checkbox) -->
        <div class="mb-3">
          <label class="form-label required fw-semibold">Jenis Izin</label><br>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="jenisIzin" value="Acara Keluarga (Menikah/Aqiqah/Wisuda)" id="izin1">
            <label class="form-check-label" for="izin1">Acara Keluarga (Menikah/Aqiqah/Wisuda)</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="jenisIzin" value="Mendampingi Keluarga Berobat" id="izin2">
            <label class="form-check-label" for="izin2">Mendampingi Keluarga Berobat</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="jenisIzin" value="Kedukaan" id="izin3">
            <label class="form-check-label" for="izin3">Kedukaan</label>
          </div>
        </div>

        <!-- Waktu Izin -->
        <div class="row mb-3">
          <div class="col-md-4">
            <label class="form-label required fw-semibold">Tanggal Mulai</label>
            <input type="date" name="tanggalMulai" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label required fw-semibold">Tanggal Selesai</label>
            <input type="date" name="tanggalSelesai" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label required fw-semibold">Jumlah Hari</label>
            <input type="number" name="jumlahHari" class="form-control" placeholder="Jumlah hari" required>
          </div>
        </div>

        <!-- Pengalihan Tugas -->
        <div class="mb-3">
          <label class="form-label fw-semibold">Pengalihan Tugas Selama Izin</label>
          <input type="text" name="namaPengganti" class="form-control mb-2" placeholder="Nama Pengganti">
          <textarea name="tugasPengganti" class="form-control mb-2" rows="2" placeholder="Tugas yang dialihkan (misal: mengajar mata kuliah X)"></textarea>
          <label class="form-label">Bentuk Pengalihan:</label><br>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="bentukPengalihan" value="Team Teaching" id="bentuk1">
            <label class="form-check-label" for="bentuk1">Team Teaching</label>
          </div>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="bentukPengalihan" value="Pengganti Sementara" id="bentuk2">
            <label class="form-check-label" for="bentuk2">Pengganti Sementara</label>
          </div>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="bentukPengalihan" value="Penjadwalan Ulang" id="bentuk3">
            <label class="form-check-label" for="bentuk3">Penjadwalan Ulang</label>
          </div>
        </div>

        <!-- Catatan Tambahan -->
        <div class="mb-3">
          <label class="form-label">Catatan Tambahan (opsional)</label>
          <textarea name="catatanTambahan" class="form-control" rows="2" placeholder="Informasi lain yang perlu diketahui admin"></textarea>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary-custom"><i class="bi bi-send me-2"></i>Kirim Pengajuan</button>
          <a href="/dosen/surat" class="btn btn-secondary">Batal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>