  const stopKontakSelect = document.getElementById('stopKontakLonggar');
  const jumlahDiv = document.getElementById('jumlahStopKontakLonggarDiv');
  function toggleJumlahStopKontak() {
    if (stopKontakSelect.value === 'Ya') {
