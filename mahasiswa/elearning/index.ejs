<%- include('../../partials/header') %>

<%
  // Fungsi untuk mengekstrak ID file dari URL Google Drive (jika diperlukan nanti)
  const getFileIdFromUrl = (url) => {
    if (!url) return null;
    let match = url.match(/[?&]id=([^&]+)/);
    if (match) return match[1];
    match = url.match(/\/d\/([^\/]+)/);
    if (match) return match[1];
    return null;
  };
%>

<style>
  /* ===== VARIABEL DARI LANDING + GAYA ASLI ===== */
  :root {
    /* Tambahan dari landing */
    --primary: #0d6efd;
    --primary-dark: #0b5ed7;
    --secondary: #0dcaf0;
    --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    --shadow-sm: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
    --shadow-hover: 0 1rem 2rem rgba(13, 110, 253, 0.12);
    --transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    
    /* Variabel asli */
    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30,58,138,0.1);
    --primary-dark: #0f2b5c;
  }

  /* ===== BASE FLUID FONT (SAMA PERSIS DENGAN LANDING) ===== */
  html {
    font-size: clamp(14px, 1vw + 10px, 16px);
  }

  body {
    font-family: var(--font-sans);
    background-color: #f8fafc;
  }

  /* ===== HEADER ===== */
  .page-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: 1.2rem;
    padding: clamp(0.8rem, 3vw, 1.2rem);
    color: white;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 20px rgba(30,58,138,0.2);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
  }
  .page-header h2 {
    font-weight: 700;
    font-size: clamp(1.1rem, 4vw, 1.4rem);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .page-header p {
    font-size: clamp(0.7rem, 2.5vw, 0.8rem);
    opacity: 0.9;
    margin: 0.2rem 0 0;
  }
  .btn-back {
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(4px);
    border-radius: 50px;
    padding: clamp(0.3rem, 2vw, 0.4rem) clamp(0.6rem, 2.5vw, 1rem);
    font-weight: 500;
    color: white;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: clamp(0.7rem, 2.5vw, 0.8rem);
    transition: var(--transition);
  }
  .btn-back:hover {
    background: rgba(255,255,255,0.3);
    transform: translateY(-2px);
    color: white;
  }

  /* ===== TABEL RESPONSIF ===== */
  .table-wrapper {
    background: white;
    border-radius: 1.2rem;
    box-shadow: var(--shadow-sm);
    overflow-x: auto;
    border: 1px solid rgba(30,58,138,0.1);
    -webkit-overflow-scrolling: touch;
  }
  .table-mk {
    width: 100%;
    min-width: 480px; /* Agar tabel tidak terlalu sempit di hp, bisa di-scroll */
    margin-bottom: 0;
  }
  .table-mk th {
    background: #f8fafc;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(0.6rem, 2vw, 0.7rem);
    padding: clamp(0.4rem, 2vw, 0.7rem) clamp(0.3rem, 1.5vw, 0.5rem);
    border-bottom: 2px solid #e2e8f0;
    text-align: center;
  }
  .table-mk td {
    padding: clamp(0.4rem, 2vw, 0.7rem) clamp(0.3rem, 1.5vw, 0.5rem);
    vertical-align: middle;
    border-bottom: 1px solid #f0f2f5;
    font-size: clamp(0.7rem, 2.5vw, 0.8rem);
    text-align: center;
  }
  .table-mk td:first-child {
    text-align: left;
    font-weight: 500;
  }
  .table-mk tr {
    transition: var(--transition);
  }
  .table-mk tr:hover {
    background: #fefce8;
    transform: scale(1.01);
    box-shadow: var(--shadow-sm);
  }
  .progress-bar-bg {
    background: #e2e8f0;
    height: 6px;
    border-radius: 3px;
    width: 100%;
    overflow: hidden;
    margin-top: 4px;
  }
  .progress-bar-fill {
    background: linear-gradient(90deg, var(--primary-start), var(--primary-end));
    height: 100%;
    border-radius: 3px;
  }
  .progress-text {
    font-size: clamp(0.6rem, 2vw, 0.7rem);
    display: flex;
    justify-content: space-between;
    margin-bottom: 2px;
  }
  .badge-tugas {
    background: #d1fae5;
    color: #065f46;
    padding: clamp(0.15rem, 1.5vw, 0.2rem) clamp(0.3rem, 1.5vw, 0.5rem);
    border-radius: 50px;
    font-size: clamp(0.55rem, 2vw, 0.65rem);
    font-weight: 600;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }
  .badge-tidak {
    background: #fef3c7;
    color: #92400e;
  }
  .btn-detail {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border: none;
    color: white;
    padding: clamp(0.2rem, 1.5vw, 0.25rem) clamp(0.5rem, 2vw, 0.7rem);
    border-radius: 50px;
    font-size: clamp(0.6rem, 2vw, 0.7rem);
    transition: var(--transition);
    text-decoration: none;
    display: inline-block;
    white-space: nowrap;
  }
  .btn-detail:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(30,58,138,0.3);
    color: white;
  }

  /* ===== EMPTY STATE ===== */
  .empty-state {
    text-align: center;
    padding: clamp(1rem, 5vw, 2rem);
  }
  .empty-state i {
    font-size: clamp(1.8rem, 6vw, 2.5rem);
    color: #cbd5e1;
  }
  .empty-state h5 {
    font-size: clamp(0.9rem, 4vw, 1.1rem);
    margin-top: 0.5rem;
  }
  .empty-state p {
    font-size: clamp(0.75rem, 2.5vw, 0.85rem);
  }

  /* ===== RESPONSIVE LENGKAP (SESUAI LANDING) ===== */
  @media (max-width: 768px) {
    .table-mk {
      min-width: 500px;
    }
  }

  @media (max-width: 480px) {
    .table-mk {
      min-width: 450px;
    }
    .table-mk th {
      font-size: 0.6rem;
      padding: 0.4rem 0.3rem;
    }
    .table-mk td {
      font-size: 0.7rem;
      padding: 0.4rem 0.3rem;
    }
    .badge-tugas {
      font-size: 0.55rem;
    }
    .btn-detail {
      font-size: 0.6rem;
      padding: 0.2rem 0.5rem;
    }
  }

  @media (max-width: 400px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .btn-back {
      align-self: flex-start;
    }
    .table-mk {
      min-width: 400px;
    }
    .table-mk th, .table-mk td {
      padding: 0.35rem 0.25rem;
    }
    .progress-text {
      font-size: 0.55rem;
    }
  }
</style>

<div class="container mt-3">
  <!-- Header responsif -->
  <div class="page-header">
    <div>
      <h2><i class="bi bi-laptop"></i> ELK‑Learning</h2>
      <p>Mata kuliah Anda dengan progres & tugas</p>
    </div>
    <a href="/mahasiswa/dashboard" class="btn-back">
      <i class="bi bi-arrow-left"></i> Kembali
    </a>
  </div>

  <!-- Tabel Mata Kuliah -->
  <div class="table-wrapper">
    <div class="table-responsive">
      <table class="table table-mk">
        <thead>
          <tr>
            <th>Mata Kuliah</th>
            <th>Jml Mhs</th>
            <th>Progress</th>
            <th>Status Tugas</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (mkList.length === 0) { %>
            <tr>
              <td colspan="5" class="empty-state">
                <i class="bi bi-inbox"></i>
                <h5>Belum Ada Mata Kuliah</h5>
                <p class="text-muted small">Anda belum terdaftar di mata kuliah manapun.</p>
                <a href="/mahasiswa/akademik/krs" class="btn-detail mt-2">Buat KRS</a>
              </td>
            </tr>
          <% } else { %>
            <% mkList.forEach(mk => { %>
              <tr>
                <td class="fw-semibold text-start"><%= mk.kode %> - <%= mk.nama %></td>
                <td><%= mk.jumlahMahasiswa || 0 %></td>
                <td>
                  <div class="progress-text">
                    <span><%= mk.progressPertemuan.terlaksana %>/16</span>
                    <span><%= mk.progressPertemuan.persen %>%</span>
                  </div>
                  <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: <%= mk.progressPertemuan.persen %>%;"></div>
                  </div>
                </td>
                <td>
                  <% if (mk.adaTugasAktif) { %>
                    <span class="badge-tugas"><i class="bi bi-check-circle-fill"></i> Ada</span>
                  <% } else { %>
                    <span class="badge-tugas badge-tidak"><i class="bi bi-clock-history"></i> Tidak</span>
                  <% } %>
                </td>
                <td>
                  <a href="/mahasiswa/elearning/mk/<%= mk.id %>" class="btn-detail">
                    <i class="bi bi-eye"></i> Detail
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>