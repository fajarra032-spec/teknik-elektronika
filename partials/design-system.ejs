<%#
  views/partials/design-system.ejs

  Sistem desain adaptif bersama untuk seluruh aplikasi (bukan cuma dashboard).
  Disatukan dari gaya yang sebelumnya terduplikasi dan mulai "drift" (beda
  nilai clamp/border-radius/shadow) antara views/dosen/dashboard.ejs dan
  views/mahasiswa/dashboard.ejs. Sertakan sekali di partials/header.ejs supaya
  semua halaman (admin, dosen, mahasiswa, landing) otomatis konsisten dan
  adaptif di semua ukuran layar, tanpa perlu menyalin ulang <style> di setiap
  file.

  Kelas siap pakai:
    .info-card              kartu konten standar (pengganti "card shadow-sm border-0")
    .stat-row / .stat-item / .stat-icon / .stat-content / .stat-label / .stat-number
                             baris ringkasan angka (dipakai di dashboard)
    .quick-card / .quick-icon  kartu menu/aksi cepat
    .profile-card / .profile-avatar / .profile-stats-vertical  kartu profil hero
%>
<style>
  :root {
    --primary: #0d6efd;
    --primary-dark: #0b5ed7;
    --secondary: #0dcaf0;
    --gradient: linear-gradient(135deg, var(--primary), var(--secondary));
    --shadow-sm: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
    --shadow-hover: 0 1rem 2rem rgba(13, 110, 253, 0.12);
    --transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;

    --primary-start: #1e3a8a;
    --primary-end: #3b82f6;
    --primary-light: rgba(30, 58, 138, 0.1);
    --warning-bg: #fef3c7;
    --warning-text: #92400e;
    --success-bg: #d1fae5;
    --success-text: #065f46;
    --danger-bg: #fee2e2;
    --danger-text: #991b1b;
  }

  /* Tipografi fluid: menyesuaikan ukuran layar, dipakai di seluruh app
     (sebelumnya hanya ada di dashboard dosen/mahasiswa; halaman lain memakai
     ukuran tetap 14px dari header.ejs, jadi tidak ikut menyesuaikan layar). */
  html {
    font-size: clamp(14px, 1vw + 10px, 16px);
  }

  /* ===== KARTU KONTEN STANDAR ===== */
  .info-card {
    background: white;
    border-radius: 1.2rem;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid rgba(30, 58, 138, 0.1);
  }
  .info-card .card-header {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    padding: clamp(0.8rem, 3vw, 1rem) clamp(1rem, 4vw, 1.5rem);
    border-bottom: none;
  }
  .info-card .card-header h5,
  .info-card .card-header h6 {
    font-size: clamp(0.95rem, 3vw, 1.1rem);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: white;
  }
  .info-card .card-body {
    padding: clamp(1rem, 4vw, 1.5rem);
  }
  .info-card .card-footer {
    background: white;
    padding: clamp(0.8rem, 3vw, 1rem) clamp(1rem, 4vw, 1.5rem);
  }

  /* ===== PROFILE / HERO CARD ===== */
  .profile-card {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    border-radius: clamp(1.5rem, 5vw, 2.25rem);
    padding: clamp(1rem, 4vw, 2rem);
    margin-bottom: clamp(1rem, 4vw, 2rem);
    color: white;
    box-shadow: 0 20px 40px rgba(30, 58, 138, 0.3);
    position: relative;
    overflow: hidden;
  }
  .profile-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: clamp(200px, 50vw, 400px);
    height: clamp(200px, 50vw, 400px);
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    transform: rotate(25deg);
  }
  .profile-card h2, .profile-card h4 {
    font-size: clamp(1.2rem, 5vw, 1.5rem);
    font-weight: 700;
    margin-bottom: clamp(0.25rem, 2vw, 0.375rem);
    position: relative;
    z-index: 1;
  }
  .profile-avatar {
    width: clamp(60px, 15vw, 100px) !important;
    height: clamp(60px, 15vw, 100px) !important;
    min-width: clamp(60px, 15vw, 100px);
    border-radius: 50%;
    border: clamp(3px, 1vw, 5px) solid rgba(255, 255, 255, 0.5);
    object-fit: cover;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }
  .profile-stats-vertical {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    border-radius: clamp(0.8rem, 3vw, 1.25rem);
    padding: clamp(0.4rem, 2vw, 0.6rem) clamp(0.6rem, 2vw, 1rem);
    margin-top: 0.5rem;
  }

  /* ===== RINGKASAN ANGKA (STAT ROW) ===== */
  .stat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: clamp(0.8rem, 3vw, 1rem);
  }
  .stat-item {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    flex: 1 1 auto;
  }
  .stat-icon {
    width: clamp(40px, 10vw, 48px);
    height: clamp(40px, 10vw, 48px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    background: var(--primary-light);
    color: var(--primary-start);
    flex-shrink: 0;
  }
  .stat-content { flex: 1; min-width: 0; }
  .stat-label {
    font-size: clamp(0.65rem, 2vw, 0.8rem);
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .stat-number {
    font-size: clamp(1.2rem, 5vw, 1.8rem);
    font-weight: 700;
    color: #1e293b;
    line-height: 1.2;
  }

  /* ===== KARTU AKSI CEPAT (MENU) ===== */
  .quick-card {
    background: white;
    border-radius: 1.2rem;
    padding: clamp(0.8rem, 3vw, 1.2rem) clamp(0.5rem, 2vw, 1rem);
    text-align: center;
    text-decoration: none;
    transition: var(--transition);
    border: 1px solid rgba(30, 58, 138, 0.1);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
    display: block;
    height: 100%;
  }
  .quick-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
    border-color: transparent;
  }
  .quick-icon {
    width: clamp(45px, 12vw, 60px);
    height: clamp(45px, 12vw, 60px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(1.5rem, 5vw, 2rem);
    margin: 0 auto clamp(0.5rem, 2vw, 0.8rem);
    background: var(--primary-light);
    color: var(--primary-start);
    transition: var(--transition);
  }
  .quick-card:hover .quick-icon {
    transform: scale(1.1);
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
  }
  .quick-card h6 {
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.3rem;
    font-size: clamp(0.8rem, 2.5vw, 0.95rem);
  }
  .quick-card p {
    color: #64748b;
    font-size: clamp(0.65rem, 2vw, 0.75rem);
    margin-bottom: 0;
  }

  /* ===== TOMBOL GRADIEN STANDAR ===== */
  .btn-gradient {
    background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
    color: white;
    border: none;
    border-radius: 50px;
    padding: clamp(0.4rem, 1.5vw, 0.5rem) clamp(1rem, 3vw, 1.5rem);
    font-weight: 600;
    transition: var(--transition);
    font-size: clamp(0.8rem, 2vw, 0.9rem);
  }
  .btn-gradient:hover {
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(30, 58, 138, 0.3);
  }

  /* Progress bar custom (dipakai di beberapa dashboard) */
  .progress { background-color: #e2e8f0; border-radius: 10px; height: 8px; }
  .progress-bar { background: linear-gradient(90deg, var(--primary-start), var(--primary-end)); border-radius: 10px; }
  .progress-bar.bg-success { background: #10b981 !important; }

  /* ===== RESPONSIF: memastikan tabel & kartu tidak overflow di HP kecil ===== */
  @media (max-width: 768px) {
    .stat-row { flex-direction: column; align-items: stretch; }
    .table-responsive { border-radius: 0.8rem; }
  }
  @media (max-width: 576px) {
    .quick-icon { width: 50px; height: 50px; font-size: 1.5rem; }
    .profile-card h2, .profile-card h4 { font-size: 1.2rem; }
    .container, .container-fluid { padding-left: 12px; padding-right: 12px; }
  }
  @media (max-width: 400px) {
    .profile-card { padding: 1rem; }
    .profile-avatar { width: 50px !important; height: 50px !important; min-width: 50px; }
    .stat-number { font-size: 1.2rem; }
    .stat-icon { width: 35px; height: 35px; font-size: 1rem; }
  }
</style>
